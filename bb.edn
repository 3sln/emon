;; emon is a LIBRARY in four languages, generated from one source tree, and
;; this file mirrors nome's (D026). kin is on the PATH rather than in `:deps`
;; for nome's reason: nothing in the generation path needs a JVM, so the
;; generator must not either. `deps.edn` carries the Clojure-consumer form.
{:paths ["kin/src" "../kin/src" "tools" "tools/lib"]
 :tasks
 {gen   {:doc "Print what a source generates.   bb gen kin/hello.kin"
         :task (apply shell "kin/scripts/gen" *command-line-args*)}
  emit  {:doc "Write every source's modules into gen/."
         :task (shell "kin/scripts/emit")}
  lang-test {:doc "Generation-time refusals of emit-ascii and defenum."
             :task (shell "kin/scripts/lang-test")}
  check {:doc "Generate, compile and run every target; require one answer."
         :task (shell "kin/scripts/check")}
  unit  {:doc "Do the laws hold as native tests on every target?  bb unit [go|rust|java|csharp|red [ARM]]"
         :task (apply shell "kin/scripts/unit" *command-line-args*)}
  plan {:doc "The plan/fulfil protocol: a transcript recorded on Rust, replayed on Go, identical evidence (P2.5)."
        :task (shell "kin/scripts/plan")}
  slice {:doc "The first vertical slice on the Rust host AND the Go host (P2.1): the Engine API's native tests, then born-digital PDFs through the driver to JSON and HTML, in memory and from a 512-byte async source, against the goldens (P1.10).  bb slice [--update]"
         :task (apply shell "bb" "kin/scripts/slice" *command-line-args*)}
  identity {:doc "Every driver arm over the corpus of (input, transcript) pairs gives byte-identical JSON, HTML, evidence and refusals: Rust and Go, four byte-source adapters each, a 512-byte async source, and the transcript recorded on one host replayed on the other (P2.2, SPEC 14.1.5).  bb identity [--full] [--only S] [--corpus [--limit N] [--sample K]]"
            :task (apply shell "bb" "kin/scripts/identity" *command-line-args*)}
  image {:doc "The ImageDecode port (P6.1, D187-D190): every image fixture of test/image decoded by Rust and Go, PNG and TIFF to exactly the pixels ImageMagick says, JPEG within a stated tolerance, refusals by name, the same through a source that misses.  bb image [--corpus]"
         :task (apply shell "bb" "kin/scripts/image" *command-line-args*)}
  embedders {:doc "The Rust and Go public API surfaces (names, arities) compared with each other and with SPEC 3.9/13, and no filesystem in any host library or generated module (P2.3, D058)."
             :task (shell "bb" "kin/scripts/embedders")}
  repeat {:doc "Run vs run, serial vs eight conversions at once, and the document with its objects in reverse file order: byte-identical, on Rust and Go (P2.4, SPEC 12.2).  bb repeat [--full] [--only S] [--corpus [--limit N] [--sample K]]"
          :task (apply shell "bb" "kin/scripts/repeat" *command-line-args*)}
  fuzz {:doc "Mutate the PDF fixtures (truncation, byte flips, corrupt xref/Length/headers/stream boundaries), run every mutant through Rust and Go (memory and a 512-byte async source): no panic, no hang, hosts agree, async = memory (P2.12). No args: the fixed-seed smoke subset (a gate).  bb fuzz [--long N] [--seed S] [--cases N] [--hosts all] [--only I --dump F] [--replay FILE...]"
        :task (apply shell "bb" "tools/fuzz/fuzz.clj" *command-line-args*)}
  ocr  {:doc "Real Tesseract transcripts replayed on Rust and Go (P2.6, P6.5): the spike's page to one evidence dump and a CER, and the committed scans (test/ocr/scan/) through the whole Engine to one Model, JSON and HTML, with the accuracy ratchet of `emon-replay`; no engine runs. Recording is tools/ocr/record.clj and record-scan.clj (live, not gates)."
        :task (shell "kin/scripts/ocr")}
  ocr-live {:doc "LIVE Tesseract over the 55 synthetic scans (the scoreboard's emon-live, ratcheted) and a sample of FUNSD, SROIE and CORD gold: NOT a gate (needs Tesseract, takes minutes; P6.5, D216).  bb ocr-live [--update] [--no-gold] [--gold-n N]"
            :task (apply shell "bb" "tools/ocr/live.clj" *command-line-args*)}
  render {:doc "A real pdfium transcript (pages, layers, crops, failures) replayed on Rust and Go: identical dump and pixels; layers and crops held to what they are (P6.2, D127). Recording it is `bb render-record` (live, not a gate)."
          :task (shell "kin/scripts/render")}
  render-record {:doc "Record the render cases LIVE with the pinned pdfium and measure: --go (Rust vs Go pixels), --compare-build (a year-older pdfium), --scratch (do not overwrite the committed transcript). NOT a gate (P6.2, D127).  bb render-record [--go] [--compare-build] [--scratch]"
                 :task (apply shell "bb" "tools/render/record.clj" *command-line-args*)}
  pdfium-fetch {:doc "Download the pinned pdfium (tools/pdfium/pdfium.edn) into .cache/pdfium/, checksum-verified. NOT a gate (P6.2, D127).  bb pdfium-fetch [--platform P] [--previous] [--force]"
                :task (apply shell "bb" "tools/pdfium/fetch.clj" *command-line-args*)}
  png-check {:doc "Do independent decoders (ImageMagick, java.util.zip) read emon's canonical PNGs to the same pixels; size against zlib level 6 (P3.11, D117).  bb png-check [--update-digests]"
             :task (apply shell "kin/scripts/png-check" *command-line-args*)}
  ink {:doc "How well do kin's ink layers separate body ink from stamps, seals, signatures and watermarks, and how close is the deskew, on P6.6's colour and overlay scans of known truth (P6.3, D197). NOT a gate; needs poppler, ImageMagick and corpus/.  bb ink [--go] [--limit N] [--rebuild]"
       :task (apply shell "bb" "kin/scripts/ink" *command-line-args*)}
  trace {:doc "How well does kin's tracer find rules, tints, text lines (watermarks too), rings and rects: against the vector paths of the no-text renders, the text layer's lines, the PDF's own watermark matrix, and (live) mapo80's labelled stamps; counts and time per page, Rust and Go (P6.4, D252-D258). NOT a gate; needs poppler, ghostscript, qpdf, ImageMagick.  bb trace [--go] [--limit N] [--only STEM] [--rebuild] [--mapo N]"
         :task (apply shell "bb" "kin/scripts/trace" *command-line-args*)}
  asset {:doc "Are the opt-in assets (assets=images) right, by what is not kin: both drivers over P3.12's fixtures give the same JSON, HTML in three modes and asset files; every sha256 and byte count is its file's; every PNG decodes (ImageMagick) to the generator's pixels, every JPEG is poppler's extraction; the goldens (P3.13, D117).  bb asset"
         :task (shell "kin/scripts/asset-check")}
  png-bench {:doc "ms per target to write a real scanned page and a photo as PNG, and whether the four write the same file (NOT a gate; needs corpus/).  bb png-bench [N]"
             :task (apply shell "kin/scripts/png-bench" *command-line-args*)}
  drift {:doc "Is the committed generated code what the sources say?"
         :task (shell "kin/scripts/drift")}
  hosts {:doc "Do the four host trees agree, and do the call sites match?"
         :task (shell "kin/scripts/hosts")}
  accuracy {:doc "Score predictions against the synthetic gold and ratchet test/scoreboard.edn (a gate since P1.10, D145).  bb accuracy [--predictor emon|oracle|degraded|fixtures] [--update] [--only ID]"
            :task (apply shell "bb" "tools/accuracy/accuracy.clj" *command-line-args*)}
  baselines {:doc "The field's numbers (P2.10, SPEC 14.4, D500-D503): pinned pdfplumber, pymupdf4llm, docling and Tesseract run offline over the scored corpus, scored by the same scorer, recorded as reference lines under test/scoreboard.edn :references. NOT a gate, never in bb gates (needs the Python environments of tools/oracle/; minutes to an hour).  bb baselines [--setup | --extract | --score | --report] [--force] [TOOL...]"
             :task (apply shell "bb" "tools/accuracy/baselines.clj" *command-line-args*)}
  fusion {:doc "Fusion on real renders and a real OCR engine's reading of BORN-DIGITAL pages, replayed from transcripts: recorded on Rust (pdfium and Tesseract) through the whole Engine with the hidden setting ocr-born-digital, replayed on Rust and Go to the identical bundle; the born-digital contract (a healthy font is never replaced by OCR), per-document CER no worse than the no-engine run's, the broken-mapping documents where OCR now wins, win rates (P7.3, D285-D290). Recording is `bb fusion-record` (live, not a gate)."
          :task (shell "bb" "kin/scripts/fusion")}
  fusion-record {:doc "Record the fusion replay set LIVE: the whole Engine with pdfium and Tesseract and the hidden setting ocr-born-digital, into test/fusion/replay/. NOT a gate (needs the pinned pdfium and Tesseract; P7.3).  bb fusion-record [--artifacts | --digests] [ID...]   (--artifacts: the watermark fixtures of test/artifacts, P7.5; --digests: replay the committed transcripts and rewrite DIGESTS.edn, no live engine)"
                 :task (apply shell "bb" "tools/fusion/record-replay.clj" *command-line-args*)}
  artifacts {:doc "Watermarks and their OCR ghosts (P7.5, SPEC 9.5, D204, D307-D313): born-digital documents with a raster watermark under the text, read by a real OCR engine, replayed from transcripts on Rust and Go to the identical bundle; the watermark is in no body, the dump names the defence that took it out (recurrence, geometry), the ledger holds it as `watermark`, no body word is lost. Recording is `bb fusion-record --artifacts` (live, not a gate)."
             :task (shell "bb" "kin/scripts/artifacts")}
  seals {:doc "Seals, stamps and signatures (P7.7, SPEC 9.5 defence 5, 10.7, D314-D319): born-digital pages with a seal, a stamp or a signature drawn as vector paths, read by a real OCR engine, replayed from transcripts on Rust and Go to the identical bundle; each is a `seal` node of its subkind and colour, its words are out of the body, no body word is lost, nothing else is one (block-seal P/R at least 0.9, seal-leak 0). Recording is `bb fusion-record --seals` (live, not a gate)."
         :task (shell "bb" "kin/scripts/seals")}
  align {:doc "Cross-source alignment (P7.1, D278-D280): six fusion documents rendered at 300 dpi with their text and read by Tesseract, replayed on Rust and Go to identical correspondence groups; coverage, precision, the broken-mapping signature and the time held. Recording is `bb align-record` (live, not a gate)."
         :task (shell "bb" "kin/scripts/align")}
  align-record {:doc "Record the alignment fixtures LIVE: pdfium renders and Tesseract's reading, on the Rust host, into test/fusion/align/. NOT a gate (needs the pinned pdfium and Tesseract; P7.1).  bb align-record [ID...]"
                :task (apply shell "bb" "tools/fusion/record-align.clj" *command-line-args*)}
  align-report {:doc "Alignment coverage, precision, splits, merges and mismatch rates from the alignment dumps, per document and pooled (P7.1). NOT a gate.  bb align-report [DUMP...] | --self-test"
                :task (apply shell "bb" "-cp" "tools" "tools/fusion/align_report.clj" *command-line-args*)}
  fusion-report {:doc "What fusion did, from evidence dumps (version 2): per-source win rates, per-rule and per-defence counts, per document and pooled (P6.6, D206). NOT a gate.  bb fusion-report DUMP... | --self-test"
                 :task (apply shell "bb" "-cp" "tools:tools/lib" "tools/accuracy/fusion_report.clj" *command-line-args*)}
  fusion-live {:doc "The live fusion sets (SROIE derived, mapo80 val; never committed, tools/fusion/live-sets.edn): `stamp-ghost` from evidence dumps (P6.6, D209). NOT a gate.  bb fusion-live --stamps [--dumps DIR] | --self-test"
               :task (apply shell "bb" "-cp" "tools:tools/lib" "tools/fusion/fusion_live.clj" *command-line-args*)}
  ghost-health {:doc "Do the OCR blocks over a watermark, seal, signature or blank paper score under the blocks of the page's text? On P6.6's overlay scans of known truth, kin's own ink layers and `hl-page` (P7.2, D282). NOT a gate; needs Tesseract, rustc, poppler, ImageMagick and the rasters `bb ink` builds.  bb ghost-health [--limit N] [--reocr] [--verbose]"
                :task (apply shell "bb" "tools/fusion/ghost_health.clj" *command-line-args*)}
  import {:doc "Run every public-dataset importer into corpus/_gold/, validate, report counts (NOT a gate: the corpus is not in git).  bb import [--limit N] [name ...]"
          :task (apply shell "bb" "tools/import/import_all.clj" *command-line-args*)}
  gates {:doc "Run every gate; fail if one exits non-zero or prints no score.  bb gates [GATE...] runs only those (CI shards, D266)."
         :task (apply shell "kin/scripts/gates" *command-line-args*)}
  corpus-push {:doc "Zip each corpus category and push to S3-compatible storage (.env).  bb corpus-push [--dry-run] [category...]"
               :task (apply shell "bb" "tools/corpus.clj" "push" *command-line-args*)}
  corpus-pull {:doc "Pull changed archives from S3-compatible storage into corpus/.  bb corpus-pull [--dry-run] [--force] [category...]"
               :task (apply shell "bb" "tools/corpus.clj" "pull" *command-line-args*)}
  corpus-index-sha {:doc "Print the SHA-256 of the remote index.json (the CI corpus cache key, D266). NOT a gate."
                    :task (shell "bb" "tools/corpus.clj" "index-sha")}
  ci {:doc "CI helpers: bb ci coverage (every gate is in a gates.yml job) | laws-record ARM LOG DIR | laws-compare DIR (D266). NOT a gate."
      :task (apply shell "bb" "tools/ci.clj" *command-line-args*)}
  corpus-test {:doc "SigV4 vectors, then a push/pull round trip against a local MinIO. NOT a gate."
               :task (do (shell "bb" "-cp" "tools" "tools/corpus_test.clj")
                         (shell "bb" "-cp" "tools" "tools/corpus_roundtrip.clj"))}}}
