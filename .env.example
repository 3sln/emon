# Copy to .env (gitignored) and fill in. Used by `bb corpus-push` / `bb corpus-pull`.
# Any S3-compatible store: AWS S3, Cloudflare R2, MinIO, Backblaze B2.
EMON_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
EMON_S3_REGION=auto
EMON_S3_BUCKET=emon-corpus
# Optional key prefix inside the bucket (no leading/trailing slash).
EMON_S3_PREFIX=corpus
EMON_S3_ACCESS_KEY_ID=
EMON_S3_SECRET_ACCESS_KEY=
# Optional. Default true (https://host/bucket/key). false = https://bucket.host/key.
EMON_S3_PATH_STYLE=true
