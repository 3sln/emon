[{:id "cli" :name "CLI" :command "emon convert report.pdf -o report.html" :quickstart "emon convert report.pdf -o report.html\nemon convert report.pdf --format json -o report.json" :requirement "Download the archive for your platform from GitHub Releases." :docs "/docs/cli/"}
