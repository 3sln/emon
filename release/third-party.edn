;; The third-party inventory of a release (P11.3, D1410). Read by `bb release-audit`, which fails when it is out of step with
;; host/rust/Cargo.lock, host/js/package-lock.json, the build scripts or the host sources; THIRD_PARTY_NOTICES.md is generated from it
;; (`bb release-audit --write`). A component is a Rust crate (:crate), an npm package (:npm), a native library or file a bundle will carry
;; (:native), or data the generated code embeds (:data). :licence is an SPDX expression; :elected the arm used when it is an OR.
;; :carried-by lists the artifacts that contain or statically link it, :loaded-by those that only load it at run time. :status is
;; :shipped (in an artifact today), :planned (in an artifact P11.4b-P11.5 build), :optional, or :dev-only (in none).
;; :text is a vector of files in release/licenses/ (a crate's is cargo-NAME-VERSION.txt by convention), :todo or :not-shipped.
{:schema 1
 :artifacts {:rust-crate "the Rust crate `emon` (crates.io)"
             :go-module "the Go module"
             :java-jar "the Java library (Maven Central, com.3sln)"
             :nuget "the NuGet package Emon"
             :npm "the npm package @3sln/emon (WASM and JS SDK)"
             :c-library "the C library and emon.h"
             :pod "the babashka pod"
             :cli "the per-platform CLI (P11.4b)"
             :browser-demo "the browser demo page (P11.4c)"}
 :no-bundled {:fonts "none: no font file is tracked or shipped (pdfium draws with the fonts a document embeds or the host has)"
