;; Laws for `emon.bytes` (P0.4). The inputs are hex literals chosen at the
;; edges: a high bit in each width, both byte orders, and reads that run off
;; the end.
(ns emon.bytestest
  (:require [emon.lang :refer [I32]]
            [emon.test :refer [deftest assert-eq assert-eq64 assert-that
                               hex-blob text-blob]]
            [emon.port :refer [blob-len]]
            [emon.bytes :refer [by-in by-i8 by-i16 by-i16le by-u24 by-u24le
                                by-u32-64 by-u32le-64 by-u8-or by-u16-or
                                by-u32-or by-match-at by-find by-find-back]]
            [kin.lang :refer [defn return let set while comment + - < ==]]))

(deftest test-signed-reads-take-the-high-bit-as-a-sign
  (assert-eq (by-i8 (hex-blob "7f 80 ff") 0) 127 "0x7f")
  (assert-eq (by-i8 (hex-blob "7f 80 ff") 1) -128 "0x80")
  (assert-eq (by-i8 (hex-blob "7f 80 ff") 2) -1 "0xff")
  (assert-eq (by-i16 (hex-blob "7f ff 80 00 ff fe") 0) 32767 "be 7fff")
  (assert-eq (by-i16 (hex-blob "7f ff 80 00 ff fe") 2) -32768 "be 8000")
  (assert-eq (by-i16 (hex-blob "7f ff 80 00 ff fe") 4) -2 "be fffe")
  (assert-eq (by-i16le (hex-blob "ff 7f 00 80 fe ff") 0) 32767 "le 7fff")
  (assert-eq (by-i16le (hex-blob "ff 7f 00 80 fe ff") 2) -32768 "le 8000")
  (assert-eq (by-i16le (hex-blob "ff 7f 00 80 fe ff") 4) -2 "le fffe"))

(deftest test-24-bit-reads-are-unsigned-in-both-orders
  (assert-eq (by-u24 (hex-blob "01 02 03 ff ff ff") 0) 66051 "be 010203")
  (assert-eq (by-u24 (hex-blob "01 02 03 ff ff ff") 3) 16777215 "be ffffff")
  (assert-eq (by-u24le (hex-blob "03 02 01 ff ff ff") 0) 66051 "le 010203")
  (assert-eq (by-u24le (hex-blob "03 02 01 ff ff ff") 3) 16777215 "le ffffff"))

(deftest test-unsigned-32-bit-widens-without-going-negative
  (assert-eq64 (by-u32-64 (hex-blob "ff ff ff ff") 0) 4294967295 "be ffffffff")
  (assert-eq64 (by-u32-64 (hex-blob "80 00 00 00") 0) 2147483648 "be 80000000")
  (assert-eq64 (by-u32-64 (hex-blob "00 00 01 00") 0) 256 "be 00000100")
  (assert-eq64 (by-u32le-64 (hex-blob "ff ff ff ff") 0) 4294967295 "le ffffffff")
  (assert-eq64 (by-u32le-64 (hex-blob "00 00 00 80") 0) 2147483648 "le 80000000")
  (assert-eq64 (by-u32le-64 (hex-blob "00 01 00 00") 0) 256 "le 00000100"))

(deftest test-bounds-questions-do-not-read-out-of-range
  (assert-eq (by-in (hex-blob "00 01 02") 0 3) 1 "the whole blob")
  (assert-eq (by-in (hex-blob "00 01 02") 1 3) 0 "one past the end")
  (assert-eq (by-in (hex-blob "00 01 02") 3 0) 1 "an empty read at the end")
  (assert-eq (by-in (hex-blob "00 01 02") 4 0) 0 "an empty read past the end")
  (assert-eq (by-in (hex-blob "00 01 02") -1 1) 0 "a negative index")
  (assert-eq (by-in (hex-blob "00 01 02") 1 -1) 0 "a negative count")
  (assert-eq (by-in (hex-blob "00 01 02") 1 2147483647) 0 "a count that would wrap i + n"))

(deftest test-reads-with-a-default-answer-it-off-the-end
  (assert-eq (by-u8-or (hex-blob "0a") 0 -1) 10 "in range")
  (assert-eq (by-u8-or (hex-blob "0a") 1 -1) -1 "one past")
  (assert-eq (by-u16-or (hex-blob "01 02") 0 -1) 258 "u16 in range")
  (assert-eq (by-u16-or (hex-blob "01 02") 1 -1) -1 "u16 straddling the end")
  (assert-eq (by-u32-or (hex-blob "ff ff ff ff") 0 7) -1 "u32 pattern")
  (assert-eq (by-u32-or (hex-blob "ff ff ff") 0 7) 7 "u32 short"))

(deftest test-searching-forwards-and-backwards
  (assert-eq (by-find (text-blob "abcabcab") 0 (text-blob "abc")) 0 "first")
  (assert-eq (by-find (text-blob "abcabcab") 1 (text-blob "abc")) 3 "from 1")
  (assert-eq (by-find (text-blob "abcabcab") 4 (text-blob "abc")) -1 "none after 4")
  (assert-eq (by-find (text-blob "abcabcab") -5 (text-blob "cab")) 2 "negative from is 0")
  (assert-eq (by-find (text-blob "abc") 0 (text-blob "abcd")) -1 "needle longer than hay")
  (assert-eq (by-find (text-blob "abc") 3 (text-blob "")) 3 "empty needle at end")
  (assert-eq (by-find-back (text-blob "abcabcab") 100 (text-blob "abc")) 3 "last")
  (assert-eq (by-find-back (text-blob "abcabcab") 2 (text-blob "abc")) 0 "last at or before 2")
  (assert-eq (by-find-back (text-blob "abcabcab") 100 (text-blob "zz")) -1 "absent")
  (assert-eq (by-match-at (text-blob "abcabc") 3 (text-blob "abc")) 1 "match at")
  (assert-eq (by-match-at (text-blob "abcabc") 4 (text-blob "abc")) 0 "match runs off the end"))
