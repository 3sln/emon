;; Document-space seams between raster pages. The page units have already
;; withheld clipped OCR lines. Evidence uses original source page numbers.
(ns emon.seams
  (:require [emon.scan :refer [sc-cp-class sc-count-class]]
            [emon.ofmt :refer [fmt-digit]]
            [emon.lang :refer [I32 I64 Cells Text Bitmap emit-ascii i64 i32 mul64]]
            [emon.port :refer [cells-at cells-set cells-push cells-drop cells-len cells-swap text-i32
                               bitmap-w bitmap-h bitmap-channels bitmap-u8]]
            [emon.evidence :refer [ln-count ln-get wd-get ol-count ol-get olf-conf lf-order
                                   ow-get owf-flags oe-clipped ev-clipped-conf
                                   ev-sin ev-cos hd-rot hd-page hd-tstart hd-tlen hd-conf lh-first lh-count lh-x0 lh-x1 lh-y0 lh-y1]]
            [emon.model :refer [page-h page-px-h ledger-add ledger-set-text text-append-cp sr-ocr dr-seam-duplicate]]
            [emon.player :refer [fw-count fw-copy-word fl-copy-line]]
            [kin.lang :refer [defn return let set while if do comment + - * quot rem < > <= >= == != and or bit-and]]))

(defn ^I32 ms-band [] (return 16))

(defn ^I32 ms-rule-cp [^I32 cp]
  (if (or (== cp 45) (== cp 42) (== cp 61) (== cp 95) (== cp 46) (== cp 8212)) (return 1))
  (return 0))

(defn ^I32 ms-stride [] (return 9))

(defn ^I32 ms-key [^Cells keys ^I32 line ^I32 field]
  (return (cells-at keys (+ (* line (ms-stride)) field))))

(defn ^I32 ms-set-key [^:mut ^Cells keys ^I32 line ^I32 field ^I32 value]
  (cells-set keys (+ (* line (ms-stride)) field) value)
  (return 0))

(defn ^I32 ms-height [^Cells fl ^I32 line]
  (return (- (ln-get fl line (lh-y1)) (ln-get fl line (lh-y0)))))

(defn ^I32 ms-rectified-y [^I32 x ^I32 y ^I64 sine ^I64 cosine]
  (return (i32 (quot (+ (mul64 (i64 y) cosine) (mul64 (i64 x) sine)) (i64 65536)))))

(defn ^I32 ms-page-angle [^Cells fw ^I32 page ^I32 first ^I32 end]
  (comment "Word angles use a y-up convention. Find the signed median without sorting the words.")
  (let [^:mut ^I32 lo -2500 ^:mut ^I32 hi 2500 ^:mut ^I32 mid 0
        ^:mut ^I32 word 0 ^:mut ^I32 rot 0 ^:mut ^I32 below 0 ^:mut ^I32 count 0]
    (if (>= first end) (return 0))
    (while (< lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2))) (set word first) (set below 0) (set count 0)
          (while (< word end)
            (do (if (== (wd-get fw word (hd-page)) page)
                  (do (set rot (rem (+ (wd-get fw word (hd-rot)) 18000) 36000))
                      (set rot (- rot 18000))
                      (if (or (< rot -2500) (> rot 2500)) (set rot 0))
                      (if (<= rot mid) (set below (+ below 1)))
                      (set count (+ count 1))))
                (set word (+ word 1))))
          (if (== count 0) (return 0))
          (if (> (* below 2) (- count 1)) (set hi mid) (set lo (+ mid 1)))))
    (return lo)))

(defn ^I32 ms-row-text [^Cells fl ^Cells fw ^Cells et ^I32 line ^:mut ^Cells keys ^:mut ^Cells codepoints]
  (let [^I32 start (cells-len codepoints)
        ^:mut ^I32 segment line ^:mut ^I32 word 0 ^:mut ^I32 stop 0
        ^:mut ^I32 pos 0 ^:mut ^I32 end 0 ^:mut ^I32 cp 0 ^:mut ^I32 kind 0]
    (while (>= segment 0)
      (do (set word (ln-get fl segment (lh-first)))
          (set stop (+ word (ln-get fl segment (lh-count))))
          (while (< word stop)
            (do (set pos (wd-get fw word (hd-tstart)))
                (set end (+ pos (wd-get fw word (hd-tlen))))
                (if (> (cells-len codepoints) start) (cells-push codepoints 32))
                (while (< pos end)
                  (do (set cp (cells-at et pos))
                      (if (and (>= cp 65) (<= cp 90)) (set cp (+ cp 32)))
                      (if (and (> cp 32) (!= cp 160))
                        (do (cells-push codepoints cp)
                            (if (!= (ms-rule-cp cp) 1) (set kind 2))
                            (if (== kind 0) (set kind 1))))
                      (set pos (+ pos 1))))
                (set word (+ word 1))))
          (set segment (ms-key keys segment 3))))
    (ms-set-key keys line 0 start)
    (ms-set-key keys line 1 (- (cells-len codepoints) start))
    (ms-set-key keys line 2 kind)
    (return 0)))

(defn ^I32 ms-row-page [^Cells fl ^Cells fw ^I32 page ^I32 first ^I32 end ^:mut ^Cells keys ^:mut ^Cells sorted]
  (comment "Match visual rows, retaining each segment's original line and words for the ledger and rebuild.")
  (let [^I32 w0 (ln-get fl first (lh-first))
        ^I32 w1 (+ (ln-get fl (- end 1) (lh-first)) (ln-get fl (- end 1) (lh-count)))
        ^I32 angle (ms-page-angle fw page w0 w1)
        ^I64 sine (i64 (ev-sin angle)) ^I64 cosine (i64 (ev-cos angle))
        ^:mut ^I32 line first ^:mut ^I32 j 0 ^:mut ^I32 other 0
        ^:mut ^I32 x 0 ^:mut ^I32 y 0 ^:mut ^I32 h 0
        ^:mut ^I32 parent 0 ^:mut ^I32 tail 0 ^:mut ^I32 best 0
        ^:mut ^I32 delta 0 ^:mut ^I32 quality 0]
    (cells-drop sorted 0)
    (while (< line end)
      (do (if (== (ln-get fl line (hd-page)) page)
            (do (set x (+ (ln-get fl line (lh-x0)) (ln-get fl line (lh-x1))))
                (set y (+ (ln-get fl line (lh-y0)) (ln-get fl line (lh-y1))))
                (ms-set-key keys line 4 (ms-rectified-y x y sine cosine))
                (set j (cells-len sorted))
                (cells-push sorted line)
                (if (<= (- end first) 1500)
                  (while (and (> j 0) (> (ln-get fl (cells-at sorted (- j 1)) (lh-x0))
                                         (ln-get fl line (lh-x0))))
                    (do (cells-set sorted j (cells-at sorted (- j 1))) (set j (- j 1)))))
                (cells-set sorted j line)))
          (set line (+ line 1))))
    (set j 0)
    (while (< j (cells-len sorted))
      (do (set line (cells-at sorted j))
          (set y (ms-key keys line 4))
          (set x (ln-get fl line (lh-x0)))
          (set h (ms-height fl line))
          (set best -1) (set quality 2147483647) (set other 0)
          (if (and (<= (- end first) 1500) (> h 0) (> (ln-get fl line (lh-count)) 0))
            (while (< other j)
              (do (set parent (cells-at sorted other))
                  (set tail (ms-key keys parent 6))
                  (if (and (>= tail 0) (> (ln-get fl parent (lh-count)) 0)
                           (>= x (ln-get fl tail (lh-x1))))
                    (do (set delta (- y (ms-key keys parent 4)))
                        (if (< delta 0) (set delta (- 0 delta)))
                        (if (and (< delta quality) (< (* 10 delta) (* 11 h))
                                 (< (* 10 delta) (* 11 (ms-height fl parent))))
                          (do (set best parent) (set quality delta)))))
                  (set other (+ other 1)))))
          (if (>= best 0)
            (do (set tail (ms-key keys best 6))
                (ms-set-key keys tail 3 line)
                (ms-set-key keys best 6 line)
                (ms-set-key keys line 5 best))
            (ms-set-key keys line 6 line))
          (set j (+ j 1))))
    (return 0)))

(defn ^I32 ms-line-confidence [^Cells fl ^Cells fw ^I32 line]
  (let [^I32 first (ln-get fl line (lh-first)) ^I32 count (ln-get fl line (lh-count))
        ^:mut ^I32 word first ^:mut ^I32 conf 0 ^:mut ^I32 p 0]
    (while (< word (+ first count))
      (do (set p (wd-get fw word (hd-conf)))
          (if (> p 0) (set conf (+ conf p)))
          (set word (+ word 1))))
    (if (== count 0) (return 0))
    (return (quot conf count))))

(defn ^I32 ms-page-median [^Cells fl ^Cells fw ^Cells keys ^I32 page ^I32 first ^I32 end ^I32 confidence]
  (let [^:mut ^I32 lo 1 ^:mut ^I32 hi 1 ^:mut ^I32 mid 0 ^:mut ^I32 n 0
        ^:mut ^I32 i first ^:mut ^I32 value 0 ^:mut ^I32 count 0]
    (while (< i end)
      (do (if (and (== (ln-get fl i (hd-page)) page) (== (ms-key keys i 2) 2))
            (do (set value (ms-height fl i))
                (if (== confidence 1) (set value (ms-line-confidence fl fw i)))
                (if (> value 0) (set n (+ n 1)))
                (if (> value hi) (set hi value))))
          (set i (+ i 1))))
    (if (== n 0) (return 0))
    (while (< lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2))) (set count 0) (set i first)
          (while (< i end)
            (do (if (and (== (ln-get fl i (hd-page)) page) (== (ms-key keys i 2) 2))
                  (do (set value (ms-height fl i))
                      (if (== confidence 1) (set value (ms-line-confidence fl fw i)))
                      (if (and (> value 0) (<= value mid)) (set count (+ count 1)))))
                (set i (+ i 1))))
          (if (> (* count 2) (- n 1)) (set hi mid) (set lo (+ mid 1)))))
    (return lo)))

(defn ^I32 ms-row-noise [^Cells fl ^Cells fw ^Cells keys ^Cells codepoints
                         ^I32 line ^I32 typical ^I32 conf]
  (let [^I32 first (ms-key keys line 0) ^I32 size (ms-key keys line 1)
        ^I32 current (ms-line-confidence fl fw line)
        ^:mut ^I32 at first ^:mut ^I32 chars 0]
    (if (< (* 2 (ms-height fl line)) typical) (return 1))
    (if (and (> current 0) (< (* 5 current) (* 3 conf))) (return 1))
    (while (< at (+ first size))
      (do (if (!= (cells-at codepoints at) 32) (set chars (+ chars 1)))
          (set at (+ at 1))))
    (if (> (* 100 (sc-count-class codepoints first size 2)) (* 12 chars)) (return 1))
    (return 0)))

(defn ^I32 ms-page-noise [^Cells fl ^Cells fw ^Cells text ^:mut ^Cells keys ^I32 page ^I32 first ^I32 end]
  (let [^I32 typical (ms-page-median fl fw keys page first end 0)
        ^I32 conf (ms-page-median fl fw keys page first end 1)
        ^:mut ^I32 line first]
    (while (< line end)
      (do (if (and (== (ln-get fl line (hd-page)) page) (== (ms-key keys line 2) 2))
            (let [^I32 noise (ms-row-noise fl fw keys text line typical conf)]
              (ms-set-key keys line 7 noise)))
          (set line (+ line 1))))
    (return 0)))

(defn ^I32 ms-page-siblings [^Cells fl ^Cells fw ^Cells ol ^:mut ^Cells keys ^I32 page ^I32 first ^I32 end]
  (comment "A short surviving segment beside clipped text can be the remainder of that same row.")
  (let [^I32 w0 (ln-get fl first (lh-first))
        ^I32 w1 (+ (ln-get fl (- end 1) (lh-first)) (ln-get fl (- end 1) (lh-count)))
        ^I32 angle (ms-page-angle fw page w0 w1)
        ^I64 sine (i64 (ev-sin angle)) ^I64 cosine (i64 (ev-cos angle))
        ^:mut ^I32 clip 0 ^:mut ^I32 x0 0 ^:mut ^I32 x1 0 ^:mut ^I32 y 0
        ^:mut ^I32 line first ^:mut ^I32 distance 0]
    (while (< clip (ol-count ol))
      (do (if (and (== (ol-get ol clip (hd-page)) page)
                   (== (ol-get ol clip (olf-conf)) (ev-clipped-conf))
                   (> (ol-get ol clip (lh-count)) 0))
            (do (set x0 (ol-get ol clip (lh-x0))) (set x1 (ol-get ol clip (lh-x1)))
                (set y (ms-rectified-y (+ x0 x1)
                                       (+ (ol-get ol clip (lh-y0)) (ol-get ol clip (lh-y1))) sine cosine))
                (set line first)
                (while (< line end)
                  (do (if (and (== (ln-get fl line (hd-page)) page)
                               (== (ms-key keys line 2) 2) (== (ms-key keys line 3) -1)
                               (>= (ms-key keys line 1) 4) (<= (ms-key keys line 1) 24)
                               (or (<= (ln-get fl line (lh-x1)) x0) (>= (ln-get fl line (lh-x0)) x1)))
                        (do (set distance (- (ms-key keys line 4) y))
                            (if (< distance 0) (set distance (- 0 distance)))
                            (if (<= distance (ms-height fl line)) (ms-set-key keys line 8 1))))
                      (set line (+ line 1))))))
          (set clip (+ clip 1))))
    (return 0)))

(defn ^I32 ms-index [^Cells fl ^Cells fw ^Cells ol ^Cells et ^I32 np ^:mut ^Cells keys ^:mut ^Cells codepoints ^:mut ^Cells sorted]
  (comment "A row key stores text offset, size, kind, next segment, corrected y, parent, tail, edge noise, and clipped sibling.")
  (let [^I32 n (ln-count fl) ^I32 base (* n (ms-stride))
        ^:mut ^I32 line 0 ^:mut ^I32 page 1
        ^:mut ^I32 start 0 ^:mut ^I32 end 0 ^:mut ^I32 at 0]
    (while (< line n)
      (do (cells-push keys 0) (cells-push keys 0) (cells-push keys 0)
          (cells-push keys -1) (cells-push keys 0) (cells-push keys -1) (cells-push keys -1) (cells-push keys 0) (cells-push keys 0)
          (set line (+ line 1))))
    (while (<= page np)
      (do (cells-push keys 0) (cells-push keys 0) (set page (+ page 1))))
    (set line 0)
    (while (< line n)
      (do (set at (+ base (* (- (ln-get fl line (hd-page)) 1) 2)))
          (if (== (cells-at keys (+ at 1)) 0) (cells-set keys at line))
          (cells-set keys (+ at 1) (+ line 1))
          (set line (+ line 1))))
    (set page 1)
    (while (<= page np)
      (do (set at (+ base (* (- page 1) 2)))
          (set start (cells-at keys at))
          (set end (cells-at keys (+ at 1)))
          (if (> end start)
            (do (ms-row-page fl fw page start end keys sorted)
                (set at start)
                (while (< at end)
                  (do (if (and (== (ln-get fl at (hd-page)) page) (< (ms-key keys at 5) 0))
                        (ms-row-text fl fw et at keys codepoints))
                      (set at (+ at 1))))
                (ms-page-noise fl fw codepoints keys page start end)
                (ms-page-siblings fl fw ol keys page start end)))
          (set page (+ page 1))))
    (return 0)))

(defn ^I32 ms-equal [^Cells keys ^Cells codepoints ^I32 a ^I32 b]
  (let [^I32 na (ms-key keys a 1) ^I32 sa (ms-key keys a 0) ^I32 sb (ms-key keys b 0)
        ^I32 ka (ms-key keys a 2) ^I32 kb (ms-key keys b 2) ^:mut ^I32 i 0]
    (if (!= ka kb) (return 0))
    (if (== ka 1) (return 1))
    (if (!= na (ms-key keys b 1)) (return 0))
    (while (< i na)
      (do (if (!= (cells-at codepoints (+ sa i)) (cells-at codepoints (+ sb i))) (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 ms-fold [^I32 cp]
  (if (and (>= cp 65) (<= cp 90)) (return (+ cp 32)))
  (return cp))

(defn ^I32 ms-one-edit [^Cells codepoints ^I32 sa ^I32 na ^I32 sb ^I32 nb ^I32 min-size]
  (let [^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 edits 0]
    (if (or (< na min-size) (< nb min-size) (> na (+ nb 1)) (> nb (+ na 1))) (return 0))
    (while (and (< i na) (< j nb))
      (do (if (== (ms-fold (cells-at codepoints (+ sa i))) (ms-fold (cells-at codepoints (+ sb j))))
            (do (set i (+ i 1)) (set j (+ j 1)))
            (do (if (> edits 0) (return 0))
                (set edits 1)
                (if (>= na nb) (set i (+ i 1)))
                (if (>= nb na) (set j (+ j 1)))))))
    (if (> (+ edits (- na i) (- nb j)) 1) (return 0))
    (return 1)))

(defn ^I32 ms-min [^I32 a ^I32 b]
  (if (< a b) (return a))
  (return b))

(defn ^I32 ms-max [^I32 a ^I32 b]
  (if (> a b) (return a))
  (return b))

(defn ^:pub ^I32 ms-similarity [^Cells text ^I32 a ^I32 na ^I32 b ^I32 nb ^:mut ^Cells row]
  (comment "Levenshtein similarity in per mille. Bound the work for exceptionally long OCR lines.")
  (let [^I32 size (ms-max na nb) ^:mut ^I32 i 0 ^:mut ^I32 j 0
        ^:mut ^I32 prev 0 ^:mut ^I32 up 0 ^:mut ^I32 cost 0 ^:mut ^I32 cp 0]
    (if (or (== na 0) (== nb 0)) (return 0))
    (if (== na nb)
      (do (while (and (< i na) (== (cells-at text (+ a i)) (cells-at text (+ b i))))
            (set i (+ i 1)))
          (if (== i na) (return 1000))))
    (if (or (> size 256) (< (* 100 (ms-min na nb)) (* 45 size))) (return 0))
    (cells-drop row 0)
    (while (<= j nb)
      (do (cells-push row j) (set j (+ j 1))))
    (set i 0)
    (while (< i na)
      (do (set cp (cells-at text (+ a i)))
          (set prev i)
          (cells-set row 0 (+ i 1))
          (set j 0)
          (while (< j nb)
            (do (set up (cells-at row (+ j 1)))
                (set cost prev)
                (if (!= cp (cells-at text (+ b j))) (set cost (+ cost 1)))
                (cells-set row (+ j 1)
                           (ms-min cost (+ 1 (ms-min up (cells-at row j)))))
                (set prev up)
                (set j (+ j 1))))
          (set i (+ i 1))))
    (return (quot (* 1000 (- size (cells-at row nb))) size))))

(defn ^I32 ms-word-limit [] (return 160))
(defn ^I32 ms-word-candidate [] (return 32768))
(defn ^I32 ms-word-open [] (return 65536))
(defn ^I32 ms-quality-code [^I32 quality] (return (quot (- quality 18) 32)))
(defn ^I32 ms-left-factor [] (return 131072))
(defn ^I32 ms-trimmed-factor [] (return 4194304))

(defn ^I32 ms-match-kind [^I32 match]
  (return (rem match (ms-left-factor))))

(defn ^I32 ms-match-left [^I32 match]
  (if (>= (ms-match-kind match) (ms-word-candidate))
    (return (rem (quot match (ms-left-factor)) 32)))
  (return (rem match 32)))

(defn ^I32 ms-word-stream [^Cells keys ^Cells codepoints ^Cells edge ^I32 bottom ^:mut ^Cells words]
  (comment "Retain the OCR word boundaries, including numeric punctuation. Each word records its edge")
  (comment "line and its position in that line. The bottom band is traversed in reading order.")
  (cells-drop words 0)
  (let [^I32 count (cells-len edge)
        ^:mut ^I32 i 0 ^:mut ^I32 rank 0 ^:mut ^I32 line 0
        ^:mut ^I32 pos 0 ^:mut ^I32 end 0 ^:mut ^I32 first 0 ^:mut ^I32 index 0]
    (while (< i count)
      (do (set rank i)
          (if (== bottom 1) (set rank (- count i 1)))
          (set line (cells-at edge rank))
          (set pos (ms-key keys line 0))
          (set end (+ pos (ms-key keys line 1)))
          (set index 0)
          (if (== (ms-key keys line 2) 1)
            (do (cells-push words pos) (cells-push words 0)
                (cells-push words rank) (cells-push words 0))
            (while (< pos end)
              (do (if (== (cells-at codepoints pos) 32)
                    (set pos (+ pos 1))
                    (do (set first pos)
                        (while (and (< pos end) (!= (cells-at codepoints pos) 32))
                          (set pos (+ pos 1)))
                        (cells-push words first) (cells-push words (- pos first))
                        (cells-push words rank) (cells-push words index)
                        (set index (+ index 1))))
                  (if (> (cells-len words) (* 4 (ms-word-limit))) (return 0)))))
          (set i (+ i 1))))
    (return (quot (cells-len words) 4))))

(defn ^I32 ms-word-score [^Cells codepoints ^Cells a ^Cells b ^I32 i ^I32 j]
  (let [^I32 sa (cells-at a (* i 4)) ^I32 sb (cells-at b (* j 4))
        ^:mut ^I32 na (cells-at a (+ (* i 4) 1)) ^:mut ^I32 nb (cells-at b (+ (* j 4) 1))
        ^:mut ^I32 k 0]
    (if (and (> na 1) (<= (sc-cp-class (cells-at codepoints sa)) 1))
      (while (and (> na 1) (>= (sc-cp-class (cells-at codepoints (+ sa na -1))) 2))
        (set na (- na 1))))
    (if (and (> nb 1) (<= (sc-cp-class (cells-at codepoints sb)) 1))
      (while (and (> nb 1) (>= (sc-cp-class (cells-at codepoints (+ sb nb -1))) 2))
        (set nb (- nb 1))))
    (if (== na nb)
      (do (while (and (< k na) (== (cells-at codepoints (+ sa k)) (cells-at codepoints (+ sb k))))
            (set k (+ k 1)))
          (if (== k na) (return 4))))
    (if (== (ms-one-edit codepoints sa na sb nb 4) 1) (return 3))
    (return 0)))

(defn ^I32 ms-word-end [^Cells words ^I32 n ^I32 at]
  (comment "An imperfect edge word may be omitted. No complete edge line may be skipped.")
  (let [^I32 next (+ at 1)]
    (if (or (== next n) (== (cells-at words (+ (* next 4) 3)) 0)) (return next))
    (if (or (== (+ next 1) n) (== (cells-at words (+ (* (+ next 1) 4) 3)) 0))
      (return (+ next 1)))
    (return 0)))

(defn ^I32 ms-content-lines [^Cells keys ^Cells codepoints ^Cells edge ^I32 n]
  (let [^:mut ^I32 i 0 ^:mut ^I32 line 0 ^:mut ^I32 previous -1 ^:mut ^I32 count 0]
    (while (< i n)
      (do (set line (cells-at edge i))
          (if (and (== (ms-key keys line 2) 2)
                   (or (< previous 0) (== (ms-equal keys codepoints previous line) 0)))
            (do (set count (+ count 1)) (set previous line)))
          (set i (+ i 1))))
    (return count)))

(defn ^I32 ms-word-align [^Cells keys ^Cells codepoints ^Cells a ^Cells b
                          ^:mut ^Cells aw ^:mut ^Cells bw ^:mut ^Cells row]
  (comment "Align a suffix and prefix of the edge word streams. A rolling edit-distance row carries")
  (comment "the score and the starting word of the earlier photo. Cuts can change the OCR line breaks.")
  (let [^I32 na (ms-word-stream keys codepoints a 1 aw)
        ^I32 nb (ms-word-stream keys codepoints b 0 bw)
        ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 prev 0 ^:mut ^I32 up 0 ^:mut ^I32 left 0
        ^:mut ^I32 word 0 ^:mut ^I32 diag 0 ^:mut ^I32 score 0
        ^:mut ^I32 start 0 ^:mut ^I32 end 0 ^:mut ^I32 before 0
        ^:mut ^I32 quality 0 ^:mut ^I32 open 0 ^:mut ^I32 dice 0 ^:mut ^I32 rank 0 ^:mut ^I32 best 0 ^:mut ^I32 best-rank 0
        ^:mut ^I32 an 0 ^:mut ^I32 bn 0 ^:mut ^I32 lines 0 ^:mut ^I32 other 0]
    (if (or (== na 0) (== nb 0)) (return 0))
    (cells-drop row 0)
    (while (<= j nb) (do (cells-push row 0) (set j (+ j 1))))
    (while (< i na)
      (do (set prev 0) (set j 0)
          (set before (cells-at aw (+ (* i 4) 3)))
          (while (< j nb)
            (do (set up (cells-at row (+ j 1)))
                (set left (cells-at row j))
                (set word (ms-word-score codepoints aw bw i j))
                (set diag 0)
                (if (and (> prev 0) (>= (+ prev (* word 512)) 512))
                  (set diag (+ prev (* word 512))))
                (if (and (> word 0) (<= before 1) (<= j 1)
                         (== (cells-at bw (+ (* j 4) 3)) j))
                  (do (set score (+ (* word 512) (* 2 (- i before)) (ms-min 1 (+ before j))))
                      (if (> score diag) (set diag score))))
                (set score diag)
                (if (> up score) (set score up))
                (if (> left score) (set score left))
                (cells-set row (+ j 1) score)
                (set prev up)
                (if (and (> word 0) (> diag 0) (== (ms-word-end aw na i) na))
                  (do (set quality (quot diag 512))
                      (set start (quot (rem diag 512) 2))
                      (set open (rem diag 2))
                      (set end (ms-word-end bw nb j))
                      (if (or (< (+ i 1) na) (< (+ j 1) end)) (set open 1))
                      (if (>= end 2)
                        (do (set dice (quot (* quality 500) (+ end (- na start))))
                            (if (>= dice 720)
                              (do (set an (+ (cells-at aw (+ (* start 4) 2)) 1))
                                  (set bn (+ (cells-at bw (+ (* (- end 1) 4) 2)) 1))
                                  (set lines (ms-content-lines keys codepoints a an))
                                  (set other (ms-content-lines keys codepoints b bn))
                                  (set lines (ms-min lines other))
                                  (set rank (+ (* lines 1024) dice))
                                  (if (and (> lines 0) (> rank best-rank))
                                    (do (set best-rank rank)
                                        (set best (+ (* an (ms-left-factor)) (ms-word-candidate)
                                                     (* lines 1024) (* (ms-quality-code dice) 32) bn
                                                     (* open (ms-word-open))))))))))))
                (set j (+ j 1))))
          (set i (+ i 1))))
    (return best)))

(defn ^I32 ms-y [^Cells fl ^I32 line]
  (return (+ (ln-get fl line (lh-y0)) (ln-get fl line (lh-y1)))))

(defn ^I32 ms-pixel [^I32 coordinate ^I32 pixels ^I32 extent]
  (let [^I32 p (i32 (quot (* (i64 coordinate) (i64 pixels)) (i64 extent)))]
    (if (< p 0) (return 0))
    (if (>= p pixels) (return (- pixels 1)))
    (return p)))

(defn ^I32 ms-grey [^Bitmap bitmap ^I32 x ^I32 y ^I32 channels]
  (let [^I32 red (bitmap-u8 bitmap x y 0)]
    (if (< channels 3) (return red))
    (return (quot (+ (* 77 red) (* 150 (bitmap-u8 bitmap x y 1))
                     (* 29 (bitmap-u8 bitmap x y 2))) 256))))

(defn ^I32 ms-dark-edge [^Bitmap bitmap ^I32 x ^I32 y ^I32 channels]
  (let [^I32 grey (ms-grey bitmap x y channels)]
    (if (and (>= (- (ms-grey bitmap (- x 5) y channels) grey) 24)
             (>= (- (ms-grey bitmap (+ x 5) y channels) grey) 24))
      (return 1))
    (return 0)))

(defn ^I32 ms-cut-ink [^Bitmap bitmap ^I32 y ^I32 inward ^I32 left ^I32 right ^I32 depth]
  (comment "Narrow dark strokes crossing the outermost rows corroborate a physical cut, even when OCR omits")
  (comment "the fragment. For page-wide evidence, require the strokes to extend beyond thin printed rules.")
  (let [^I32 w (bitmap-w bitmap) ^I32 channels (bitmap-channels bitmap)
        ^:mut ^I32 x left ^:mut ^I32 last -2 ^:mut ^I32 strokes 0
        ^:mut ^I32 inside 0 ^:mut ^I32 last-inside -2]
    (if (< x 5) (set x 5))
    (while (and (< x (- w 5)) (< x right))
      (do (if (== (ms-dark-edge bitmap x (+ y inward) channels) 1)
            (do (if (> (- x last-inside) 1) (set inside (+ inside 1)))
                (set last-inside x)
                (if (and (== (ms-dark-edge bitmap x y channels) 1)
                         (or (== depth 1)
                             (and (== (ms-dark-edge bitmap x (+ y (* 2 inward)) channels) 1)
                                  (== (ms-dark-edge bitmap x (+ y (* depth inward)) channels) 1))))
                  (do (if (> (- x last) 1) (set strokes (+ strokes 1)))
                      (set last x)))))
          (if (and (>= strokes 2) (>= inside 3)) (return 1))
          (set x (+ x 1))))
    (return 0)))

(defn ^I32 ms-bitmap-cut [^Bitmap bitmap ^I32 y ^I32 inward ^I32 w]
  (if (== (ms-cut-ink bitmap y inward 0 w 4) 1) (return 1))
  (if (== (ms-cut-ink bitmap y inward 0 w 1) 1) (return -1))
  (return 0))

(defn ^:pub ^I32 ms-sample-cut [^Bitmap bitmap ^I32 page ^:mut ^Cells cuts]
  (let [^I32 h (bitmap-h bitmap) ^I32 w (bitmap-w bitmap)]
    (while (< (cells-len cuts) (* page 2)) (cells-push cuts 0))
    (if (< h 5) (return 0))
    (cells-set cuts (- (* page 2) 2) (ms-bitmap-cut bitmap 0 1 w))
    (cells-set cuts (- (* page 2) 1) (ms-bitmap-cut bitmap (- h 1) -1 w))
    (return 0)))

(defn ^:pub ^I32 ms-line-cuts [^Bitmap bitmap ^Cells lines ^Cells selection ^I32 start ^I32 count
                              ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 fourpx ^:mut ^Cells cuts]
  (comment "Corroborate an OCR box only with strokes in the same horizontal span of its own bitmap edge.")
  (cells-drop cuts 0)
  (let [^I32 w (bitmap-w bitmap) ^I32 h (bitmap-h bitmap)
        ^:mut ^I32 i 0 ^:mut ^I32 line 0 ^:mut ^I32 top 0 ^:mut ^I32 bottom 0
        ^:mut ^I32 left 0 ^:mut ^I32 right 0 ^:mut ^I32 cut 0]
    (if (or (< h 3) (<= x1 x0)) (return 0))
    (while (< i count)
      (do (set line (cells-at selection (+ start i)))
          (set top (- (ol-get lines line (lh-y0)) y0))
          (set bottom (- y1 (ol-get lines line (lh-y1))))
          (set cut 0)
          (if (or (and (<= top fourpx) (>= top (- 0 fourpx)))
                  (and (<= bottom fourpx) (>= bottom (- 0 fourpx))))
            (do (set left (ms-pixel (- (ol-get lines line (lh-x0)) x0) w (- x1 x0)))
                (set right (ms-pixel (- (ol-get lines line (lh-x1)) x0) w (- x1 x0)))
                (if (<= top bottom)
                    (set cut (ms-cut-ink bitmap 0 1 left right 1))
                    (set cut (ms-cut-ink bitmap (- h 1) -1 left right 1)))))
          (cells-push cuts cut)
          (set i (+ i 1))))
    (return count)))

(defn ^I32 ms-patch [^Bitmap bitmap ^Cells lines ^I32 line ^I32 width ^I32 height ^:mut ^Cells pixels]
  (let [^I32 w (bitmap-w bitmap) ^I32 h (bitmap-h bitmap)
        ^I32 x0 (ln-get lines line (lh-x0)) ^I32 y0 (ln-get lines line (lh-y0))
        ^I32 dx (- (ln-get lines line (lh-x1)) x0)
        ^I32 dy (- (ln-get lines line (lh-y1)) y0)
        ^I32 channels (bitmap-channels bitmap)
        ^:mut ^I32 u 0 ^:mut ^I32 v 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0]
    (while (< v 12)
      (do (set y (ms-pixel (+ y0 (quot (* (- v 2) dy) 8)) h height))
          (set u 0)
          (while (< u 32)
            (do (set x (ms-pixel (+ x0 (quot (* (+ (* u 2) 1) dx) 64)) w width))
                (cells-push pixels (ms-grey bitmap x y channels))
                (set u (+ u 1))))
          (set v (+ v 1))))
    (return 0)))

(defn ^:pub ^I32 ms-ncc [^Cells pixels ^I32 a ^I32 b ^I32 count]
  (comment "Scaled integer Pearson correlation. Require r >= 0.60 and reject near-flat crops.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0
        ^:mut ^I64 sx (i64 0) ^:mut ^I64 sy (i64 0) ^:mut ^I64 xx (i64 0)
        ^:mut ^I64 yy (i64 0) ^:mut ^I64 xy (i64 0)
        ^:mut ^I64 vx (i64 0) ^:mut ^I64 vy (i64 0) ^:mut ^I64 covariance (i64 0)]
    (while (< i count)
      (do (set x (cells-at pixels (+ a i))) (set y (cells-at pixels (+ b i)))
          (set sx (+ sx (i64 x))) (set sy (+ sy (i64 y)))
          (set xx (+ xx (i64 (* x x)))) (set yy (+ yy (i64 (* y y))))
          (set xy (+ xy (i64 (* x y))))
          (set i (+ i 1))))
    (set vx (quot (- (* (i64 count) xx) (* sx sx)) (i64 count)))
    (set vy (quot (- (* (i64 count) yy) (* sy sy)) (i64 count)))
    (set covariance (quot (- (* (i64 count) xy) (* sx sy)) (i64 count)))
    (if (and (> covariance (i64 0)) (> vx (i64 count)) (> vy (i64 count)))
      (if (>= (* (* covariance covariance) (i64 100)) (* (* vx vy) (i64 36))) (return 1)))
    (return 0)))

(defn ^I32 ms-edge-add [^Cells fl ^:mut ^Cells edge ^I32 line ^I32 bottom]
  (comment "Insert from the physical edge inward. Bound the band even on very long pages.")
  (let [^I32 y (ms-y fl line) ^:mut ^I32 i 0 ^:mut ^I32 j (cells-len edge)
        ^:mut ^I32 side 0]
    (while (< i j)
      (do (set side (- y (ms-y fl (cells-at edge i))))
          (if (== bottom 0) (set side (- 0 side)))
          (if (> side 0) (set j i) (set i (+ i 1)))))
    (if (>= i (ms-band)) (return 0))
    (set j (- (cells-len edge) 1))
    (if (< (cells-len edge) (ms-band)) (do (cells-push edge 0) (set j (+ j 1))))
    (while (> j i)
      (do (cells-set edge j (cells-at edge (- j 1))) (set j (- j 1))))
    (cells-set edge i line)
    (return 0)))

(defn ^I32 ms-row-edge-add [^Cells keys ^:mut ^Cells edge ^I32 line ^I32 bottom]
  (comment "Insert from the physical edge inward. Bound the band even on very long pages.")
  (let [^I32 y (ms-key keys line 4) ^:mut ^I32 i 0 ^:mut ^I32 j (cells-len edge)
        ^:mut ^I32 side 0]
    (while (< i j)
      (do (set side (- y (ms-key keys (cells-at edge i) 4)))
          (if (== bottom 0) (set side (- 0 side)))
          (if (> side 0) (set j i) (set i (+ i 1)))))
    (if (>= i (ms-band)) (return 0))
    (set j (- (cells-len edge) 1))
    (if (< (cells-len edge) (ms-band)) (do (cells-push edge 0) (set j (+ j 1))))
    (while (> j i)
      (do (cells-set edge j (cells-at edge (- j 1))) (set j (- j 1))))
    (cells-set edge i line)
    (return 0)))

(defn ^:pub ^I32 ms-sample [^Bitmap bitmap ^Cells lines ^I32 first ^I32 width ^I32 height
                          ^:mut ^Cells offsets ^:mut ^Cells pixels ^:mut ^Cells top ^:mut ^Cells bottom]
  (comment "The page unit may release its bitmap after this call. Retain only fixed-size edge-line samples.")
  (if (or (<= width 0) (<= height 0) (<= (bitmap-w bitmap) 0) (<= (bitmap-h bitmap) 0)
          (> (cells-len pixels) 4000000)) (return 0))
  (cells-drop top 0) (cells-drop bottom 0)
  (let [^:mut ^I32 i first ^:mut ^I32 line 0 ^:mut ^I32 j 0]
    (while (< (cells-len offsets) (ln-count lines)) (cells-push offsets -1))
    (while (< i (ln-count lines))
      (do (if (> (ln-get lines i (lh-count)) 0)
            (do (ms-edge-add lines top i 0) (ms-edge-add lines bottom i 1)))
          (set i (+ i 1))))
    (while (< j (+ (cells-len top) (cells-len bottom)))
      (do (if (< j (cells-len top))
            (set line (cells-at top j))
            (set line (cells-at bottom (- j (cells-len top)))))
          (if (< (cells-at offsets line) 0)
            (do (cells-set offsets line (cells-len pixels))
                (ms-patch bitmap lines line width height pixels)))
          (set j (+ j 1))))
    (return 0)))

(defn ^I32 ms-pixel-pair [^Cells fl ^Cells offsets ^Cells pixels ^I32 la ^I32 lb]
  (let [^I32 a (ln-get fl la (lf-order)) ^I32 b (ln-get fl lb (lf-order))]
    (if (or (< a 0) (>= a (cells-len offsets)) (< b 0) (>= b (cells-len offsets))) (return 0))
    (let [^I32 va (cells-at offsets a) ^I32 vb (cells-at offsets b)]
      (if (or (< va 0) (< vb 0)) (return 0))
      (if (or (== (ms-ncc pixels va vb 384) 1)
              (== (ms-ncc pixels (+ va 32) vb 352) 1)
              (== (ms-ncc pixels va (+ vb 32) 352) 1))
        (return 1)))
    (return 0)))

(defn ^I32 ms-pixel-votes [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells offsets ^Cells pixels ^I32 n]
  (let [^:mut ^I32 i 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0 ^:mut ^I32 votes 0]
    (while (< i n)
      (do (set la (cells-at a (- n 1 i))) (set lb (cells-at b i))
          (if (and (== (ms-key keys la 2) 2) (== (ms-key keys la 3) -1) (== (ms-key keys lb 3) -1))
            (set votes (+ votes (ms-pixel-pair fl offsets pixels la lb))))
          (set i (+ i 1))))
    (return votes)))

(defn ^I32 ms-run-score [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells codepoints ^I32 n ^:mut ^Cells row]
  (comment "Separator matches carry no content votes. A long run can bridge one noisy OCR reading.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0 ^:mut ^I32 prev-a -1
        ^:mut ^I32 prev-b -1 ^:mut ^I32 total 0 ^:mut ^I32 rows 0 ^:mut ^I32 bad 0
        ^:mut ^I32 delta-a 0 ^:mut ^I32 delta-b 0 ^:mut ^I32 ha 0 ^:mut ^I32 hb 0 ^:mut ^I32 sim 0]
    (while (< i n)
      (do (set la (cells-at a (- n 1 i)))
          (set lb (cells-at b i))
          (if (!= (ms-key keys la 2) (ms-key keys lb 2)) (return 0))
          (if (== (ms-key keys la 2) 2)
            (do (set sim (ms-similarity codepoints (ms-key keys la 0) (ms-key keys la 1)
                                       (ms-key keys lb 0) (ms-key keys lb 1) row))
                (if (or (< sim 450)
                        (and (== n 1) (< sim 850)
                             (or (< sim 780) (< (ms-min (ms-key keys la 1) (ms-key keys lb 1)) 8))))
                  (return 0))
                (if (< sim 780) (set bad (+ bad 1)))
                (if (or (< prev-a 0) (== (ms-equal keys codepoints la prev-a) 0)
                                     (== (ms-equal keys codepoints lb prev-b) 0))
                  (do (set total (+ total sim)) (set rows (+ rows 1))))
                (if (>= prev-a 0)
                  (do (set delta-a (- (ms-key keys la 4) (ms-key keys prev-a 4)))
                      (set delta-b (- (ms-key keys lb 4) (ms-key keys prev-b 4)))
                      (set ha (ms-max (ms-height fl la) (ms-height fl prev-a)))
                      (set hb (ms-max (ms-height fl lb) (ms-height fl prev-b)))
                      (if (and (> ha 0) (> hb 0))
                        (if (or (> (quot delta-a ha) (+ 2 (quot delta-b hb)))
                                (> (quot delta-b hb) (+ 2 (quot delta-a ha))))
                          (return 0)))))
                (set prev-a la) (set prev-b lb)))
          (set i (+ i 1))))
    (if (or (== rows 0) (> bad 1) (and (< rows 3) (> bad 0))) (return 0))
    (return (+ (* rows 32) (ms-quality-code (quot total rows))))))

(defn ^I32 ms-cut [^Cells cuts ^I32 page ^I32 bottom]
  (let [^I32 index (+ (* (- page 1) 2) bottom)]
    (if (< index (cells-len cuts)) (return (cells-at cuts index)))
    (return 0)))

(defn ^I32 ms-fragment-matches [^Cells et ^Cells ow ^I32 first ^I32 count
                                ^Cells fl ^Cells fw ^I32 line]
  (let [^I32 full (ln-get fl line (lh-first)) ^I32 n (ln-get fl line (lh-count))
        ^:mut ^I32 offset 0 ^:mut ^I32 words 0 ^:mut ^I32 chars 0
        ^:mut ^I32 a 0 ^:mut ^I32 b 0 ^:mut ^I32 size 0 ^:mut ^I32 i 0]
    (if (< count 2) (return 0))
    (while (<= (+ offset count) n)
      (do (set words 0) (set chars 0)
          (while (< words count)
            (do (set a (ow-get ow (+ first words) (hd-tstart)))
                (set b (wd-get fw (+ full offset words) (hd-tstart)))
                (set size (ow-get ow (+ first words) (hd-tlen)))
                (if (== size (wd-get fw (+ full offset words) (hd-tlen)))
                  (do (set i 0)
                      (while (and (< i size) (== (ms-fold (cells-at et (+ a i))) (ms-fold (cells-at et (+ b i)))))
                        (set i (+ i 1)))
                      (if (== i size)
                        (do (set chars (+ chars size)) (set words (+ words 1)))
                        (set words (+ count 1))))
                  (set words (+ count 1)))))
          (if (and (== words count) (>= chars 8)) (return 1))
          (set offset (+ offset 1))))
    (return 0)))

(defn ^I32 ms-fragment-word [^Cells et ^Cells ow ^Cells fw ^I32 fragment ^I32 full]
  (let [^I32 a (ow-get ow fragment (hd-tstart)) ^I32 na (ow-get ow fragment (hd-tlen))
        ^I32 b (wd-get fw full (hd-tstart)) ^I32 nb (wd-get fw full (hd-tlen))
        ^:mut ^I32 i 0]
    (if (== na nb)
      (do (while (and (< i na) (== (ms-fold (cells-at et (+ a i))) (ms-fold (cells-at et (+ b i)))))
            (set i (+ i 1)))
          (if (== i na) (return (* 10 na)))))
    (if (== (ms-one-edit et a na b nb 4) 1) (return (- (* 10 na) 10)))
    (return 0)))

(defn ^I32 ms-fragment-covered [^Cells et ^Cells ow ^I32 first ^I32 count
                                ^Cells fl ^Cells fw ^Cells keys ^I32 line]
  (comment "Find the fragment's words in order across all segments of the other visual row.")
  (let [^:mut ^I32 start 0 ^:mut ^I32 chars 0 ^:mut ^I32 score 0 ^:mut ^I32 hits 0
        ^:mut ^I32 next 0 ^:mut ^I32 weight 0 ^:mut ^I32 segment 0
        ^:mut ^I32 word 0 ^:mut ^I32 end 0]
    (if (or (< count 1) (> count 32)) (return 0))
    (while (< start count)
      (do (set chars (+ chars (ow-get ow (+ first start) (hd-tlen))))
          (set start (+ start 1))))
    (if (< chars 4) (return 0))
    (set start 0)
    (while (< start count)
      (do (set next start) (set score 0) (set hits 0) (set segment line)
          (while (and (>= segment 0) (< next count))
            (do (set word (ln-get fl segment (lh-first)))
                (set end (+ word (ln-get fl segment (lh-count))))
                (while (and (< word end) (< next count))
                  (do (set weight (ms-fragment-word et ow fw (+ first next) word))
                      (if (> weight 0)
                        (do (set hits (+ hits 1)) (set score (+ score weight)) (set next (+ next 1))))
                      (set word (+ word 1))))
                (set segment (ms-key keys segment 3))))
          (if (and (>= score (* 7 chars))
                   (or (>= hits 2) (and (== count 1) (>= chars 4))))
            (return 1))
          (set start (+ start 1))))
    (return 0)))

(defn ^I32 ms-gap-edge [^Cells ol ^Cells ow ^Cells et ^Cells fl ^Cells fw ^Cells keys ^Cells pages
                       ^Cells cuts ^I32 page ^I32 bottom ^Cells neighbor ^I32 first-neighbor ^I32 last-neighbor ^Cells dropped ^I32 context]
  (comment "Thin rule ink can make the OCR line box touch the frame while leaving its words intact. An engine can also pad")
  (comment "a complete line's box to the frame, so ink that is only a thin rule at the frame edge (a negative cut) never corroborates a clipped reading.")
  (let [^I32 height (page-h pages (- page 1)) ^I32 pixels (page-px-h pages (- page 1))
        ^I32 cut (ms-cut cuts page bottom)
        ^:mut ^I32 i 0 ^:mut ^I32 edge 0 ^:mut ^I32 covered 0 ^:mut ^I32 uncovered 0
        ^:mut ^I32 first 0 ^:mut ^I32 count 0 ^:mut ^I32 j 0 ^:mut ^I32 matches 0]
    (while (< i (ol-count ol))
      (do (if (and (== page (ol-get ol i (hd-page))) (== (ol-get ol i (olf-conf)) (ev-clipped-conf)))
            (do (if (== bottom 1)
                  (set edge (- height (ol-get ol i (lh-y1))))
                  (set edge (ol-get ol i (lh-y0))))
                (set first (ol-get ol i (lh-first)))
                (set count (ol-get ol i (lh-count)))
                (if (and (or (== edge 0)
                             (and (> pixels 0) (<= (mul64 (i64 edge) (i64 pixels)) (mul64 (i64 height) (i64 4)))
                                  (>= (mul64 (i64 edge) (i64 pixels)) (mul64 (i64 height) (i64 -4)))))
                         (or (== count 0)
                             (and (>= first 0) (!= (bit-and (ow-get ow first (owf-flags)) (oe-clipped)) 0)))
                         (>= cut 0))
                  (do (set matches 0) (set j first-neighbor)
                      (while (and (< j last-neighbor) (< j (cells-len neighbor)))
                        (do (if (== (cells-at dropped (cells-at neighbor j)) 0)
                              (do (if (== context 1)
                                    (set matches (+ matches (ms-fragment-matches et ow first count
                                                                                 fl fw (cells-at neighbor j))))
                                    (set matches (+ matches (ms-fragment-covered et ow first count
                                                                                 fl fw keys (cells-at neighbor j)))))))
                            (set j (+ j 1))))
                      (if (> matches 0) (set covered 2) (set uncovered 1))))))
          (set i (+ i 1))))
    (if (> (+ covered uncovered) 0) (return (+ covered uncovered)))
    (return (ms-max 0 cut))))

(defn ^I32 ms-join-gap [^Cells ol ^Cells ow ^Cells et ^Cells fl ^Cells fw ^Cells keys ^Cells pages
                       ^Cells cuts ^Cells dropped ^I32 left ^I32 right ^Cells a ^Cells b ^I32 overlap]
  (let [^I32 na (ms-match-left overlap) ^I32 nb (rem overlap 32)
        ^:mut ^I32 end-a (cells-len a) ^:mut ^I32 end-b (cells-len b)]
    (if (> overlap 0)
      (do (set end-a (+ na 2)) (set end-b (+ nb 2))))
    (if (or (!= (bit-and (ms-gap-edge ol ow et fl fw keys pages cuts left 1 b
                                      (ms-max 0 (- nb 1)) end-b dropped 0) 1) 0)
            (!= (bit-and (ms-gap-edge ol ow et fl fw keys pages cuts right 0 a
                                      (ms-max 0 (- na 1)) end-a dropped 0) 1) 0))
      (return 1))
    (return 0)))

(defn ^I32 ms-drop-line [^Cells fl ^Cells fw ^Cells et ^I32 line ^:mut ^Cells ledger ^:mut ^Cells model-text]
  (let [^I32 record (ledger-add ledger (dr-seam-duplicate) (ln-get fl line (hd-page))
                                 (ln-get fl line (lh-x0)) (ln-get fl line (lh-y0))
                                 (ln-get fl line (lh-x1)) (ln-get fl line (lh-y1)) 900 (sr-ocr))
        ^I32 text-start (cells-len model-text)
        ^I32 first (ln-get fl line (lh-first))
        ^I32 stop (+ first (ln-get fl line (lh-count)))
        ^:mut ^I32 word first ^:mut ^I32 pos 0 ^:mut ^I32 end 0]
    (while (< word stop)
      (do (if (> word first) (text-append-cp model-text 32))
          (set pos (wd-get fw word (hd-tstart)))
          (set end (+ pos (wd-get fw word (hd-tlen))))
          (while (< pos end)
            (do (text-append-cp model-text (cells-at et pos)) (set pos (+ pos 1))))
          (set word (+ word 1))))
    (ledger-set-text ledger record text-start (- (cells-len model-text) text-start))
    (return 0)))

(defn ^I32 ms-row-live [^Cells keys ^Cells dropped ^I32 line]
  (let [^:mut ^I32 segment line]
    (while (>= segment 0)
      (do (if (== (cells-at dropped segment) 1) (return 0))
          (set segment (ms-key keys segment 3))))
    (return 1)))

(defn ^I32 ms-drop-row [^Cells fl ^Cells fw ^Cells et ^Cells keys ^I32 line
                        ^:mut ^Cells dropped ^:mut ^Cells ledger ^:mut ^Cells model-text]
  (let [^:mut ^I32 segment line ^:mut ^I32 count 0]
    (while (>= segment 0)
      (do (ms-drop-line fl fw et segment ledger model-text)
          (cells-set dropped segment 1)
          (set count (+ count 1))
          (set segment (ms-key keys segment 3))))
    (return count)))

(defn ^I32 ms-rebuild [^:mut ^Cells fl ^:mut ^Cells fw ^Cells dropped ^:mut ^Cells new-lines ^:mut ^Cells new-words]
  (let [^:mut ^I32 i 0 ^:mut ^I32 word 0 ^:mut ^I32 stop 0 ^:mut ^I32 first 0]
    (while (< i (ln-count fl))
      (do (if (== (cells-at dropped i) 0)
            (do (set word (ln-get fl i (lh-first)))
                (set stop (+ word (ln-get fl i (lh-count))))
                (set first (fw-count new-words))
                (while (< word stop)
                  (do (fw-copy-word new-words fw word (ln-count new-lines))
                      (set word (+ word 1))))
                (let [^I32 count (ln-get fl i (lh-count))]
                  (fl-copy-line new-lines fl i first count))))
          (set i (+ i 1))))
    (cells-swap fl new-lines)
    (cells-swap fw new-words)
    (return 0)))

(defn ^I32 ms-raster [^Cells mask ^I32 page]
  (return (rem (cells-at mask (- page 1)) 4)))

(defn ^I32 ms-page-edge [^Cells fl ^Cells keys ^I32 page ^I32 bottom ^:mut ^Cells band]
  (let [^I32 at (+ (* (ln-count fl) (ms-stride)) (* (- page 1) 2))
        ^I32 end (cells-at keys (+ at 1))
        ^:mut ^I32 i (cells-at keys at)]
    (cells-drop band 0)
    (while (< i end)
      (do (if (and (== (ln-get fl i (hd-page)) page) (> (ms-key keys i 2) 0))
            (ms-row-edge-add keys band i bottom))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 ms-trim-edge [^Cells keys ^:mut ^Cells edge]
  (comment "Only an outer prefix of non-content may be transparent. Keep interior rows in the run.")
  (let [^I32 n (cells-len edge) ^:mut ^I32 i 0 ^:mut ^I32 j 0]
    (while (and (< i n) (or (== (ms-key keys (cells-at edge i) 2) 1)
                            (== (ms-key keys (cells-at edge i) 7) 1)))
      (set i (+ i 1)))
    (if (== i 0) (return 0))
    (while (< i n)
      (do (cells-set edge j (cells-at edge i)) (set i (+ i 1)) (set j (+ j 1))))
    (cells-drop edge j)
    (return (- n j))))

(defn ^I32 ms-match-rows [^I32 match]
  (return (rem (quot match 1024) 32)))

(defn ^I32 ms-match-quality [^I32 match]
  (return (rem (quot match 32) 32)))

(defn ^I32 ms-link-score [^I32 match]
  (comment "A direct anchor wins equally strong evidence that skipped an edge reading.")
  (return (- (+ (* 32 (ms-match-rows match)) (ms-match-quality match))
             (quot match (ms-trimmed-factor)))))

(defn ^I32 ms-pair-match [^Cells fl ^Cells keys ^Cells codepoints ^Cells a ^Cells b ^:mut ^Cells aw ^:mut ^Cells bw ^:mut ^Cells word-row]
  (let [^:mut ^I32 n 1 ^:mut ^I32 score 0 ^:mut ^I32 best 0]
    (while (and (<= n (cells-len a)) (<= n (cells-len b)))
      (do (set score (ms-run-score fl a b keys codepoints n word-row))
          (if (and (> score 0) (> (+ (* score 32) n) best))
            (set best (+ (* score 32) n)))
          (set n (+ n 1))))
    (let [^I32 band (ms-word-align keys codepoints a b aw bw word-row)]
      (comment "Prefer identifiable row pairs when both matchers cover the same number of content rows.")
      (if (or (== best 0) (> (ms-match-rows band) (ms-match-rows best)))
        (return band))
      (return best))))

(defn ^I32 ms-row-subset [^Cells keys ^Cells codepoints ^I32 fragment ^I32 full]
  (comment "Look for the complete short segment on word boundaries in the other reading.")
  (let [^I32 a (ms-key keys fragment 0) ^I32 na (ms-key keys fragment 1)
        ^I32 b (ms-key keys full 0) ^I32 nb (ms-key keys full 1)
        ^:mut ^I32 start 0 ^:mut ^I32 i 0]
    (if (>= na nb) (return 0))
    (while (<= (+ start na) nb)
      (do (if (and (or (== start 0) (== (cells-at codepoints (+ b start -1)) 32))
                   (or (== (+ start na) nb) (== (cells-at codepoints (+ b start na)) 32)))
            (do (set i 0)
                (while (and (< i na) (== (cells-at codepoints (+ a i)) (cells-at codepoints (+ b start i))))
                  (set i (+ i 1)))
                (if (== i na) (return 1))))
          (set start (+ start 1))))
    (return 0)))

(defn ^I32 ms-without-edge-row [^:mut ^Cells edge]
  (let [^I32 n (cells-len edge) ^:mut ^I32 i 1]
    (while (< i n)
      (do (cells-set edge (- i 1) (cells-at edge i))
          (set i (+ i 1))))
    (cells-drop edge (- n 1))
    (return 0)))

(defn ^I32 ms-restore-edge-row [^:mut ^Cells edge ^I32 line]
  (let [^:mut ^I32 i (cells-len edge)]
    (cells-push edge 0)
    (while (> i 0)
      (do (cells-set edge i (cells-at edge (- i 1)))
          (set i (- i 1))))
    (cells-set edge 0 line)
    (return 0)))

(defn ^I32 ms-pair [^Cells fl ^Cells keys ^Cells codepoints ^I32 left ^I32 right
                    ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells aw ^:mut ^Cells bw ^:mut ^Cells word-row]
  (ms-page-edge fl keys left 1 a)
  (ms-page-edge fl keys right 0 b)
  (let [^I32 raw (ms-pair-match fl keys codepoints a b aw bw word-row)
        ^I32 trim-left (ms-trim-edge keys a) ^I32 trim-right (ms-trim-edge keys b)
        ^:mut ^I32 match raw
        ^:mut ^I32 edge -1 ^:mut ^I32 candidate 0 ^:mut ^I32 count 0]
    (if (> (+ trim-left trim-right) 0)
      (do (set candidate (ms-pair-match fl keys codepoints a b aw bw word-row))
          (if (> (ms-link-score candidate) (ms-link-score raw))
            (set match (+ candidate (ms-trimmed-factor)))
            (do (ms-page-edge fl keys left 1 a)
                (ms-page-edge fl keys right 0 b)))))
    (if (< (ms-match-rows match) 3)
      (do (if (and (> (cells-len a) 1) (== (ms-key keys (cells-at a 0) 8) 1))
            (do (set edge (cells-at a 0))
                (ms-without-edge-row a)
                (set candidate (ms-pair-match fl keys codepoints a b aw bw word-row))
                (set count (rem candidate 32))
                (if (and (> (ms-link-score candidate) (ms-link-score match)) (< count (cells-len b))
                         (== (ms-row-subset keys codepoints edge (cells-at b count)) 1))
                  (return (+ candidate (ms-trimmed-factor))))
                (ms-restore-edge-row a edge)))
          (if (and (> (cells-len b) 1) (== (ms-key keys (cells-at b 0) 8) 1))
            (do (set edge (cells-at b 0))
                (ms-without-edge-row b)
                (set candidate (ms-pair-match fl keys codepoints a b aw bw word-row))
                (set count (ms-match-left candidate))
                (if (and (> (ms-link-score candidate) (ms-link-score match)) (< count (cells-len a))
                         (== (ms-row-subset keys codepoints edge (cells-at a count)) 1))
                  (return (+ candidate (ms-trimmed-factor))))
                (ms-restore-edge-row b edge)))))
    (return match)))

(defn ^I32 ms-band-confidence [^Cells fl ^Cells fw ^Cells band ^I32 n]
  (let [^:mut ^I32 i 0 ^:mut ^I32 sum 0]
    (while (< i n)
      (do (set sum (+ sum (ms-line-confidence fl fw (cells-at band i))))
          (set i (+ i 1))))
    (return (quot sum n))))

(defn ^I32 ms-copy-split [^Cells fl ^Cells fw ^Cells a ^Cells b ^I32 match]
  (comment "Keep an earlier-photo prefix and a later-photo suffix. An arbitrary per-line choice can")
  (comment "reverse rows at the page break. A word-band match can have different line boundaries.")
  (let [^I32 na (ms-match-left match) ^I32 nb (rem match 32)
        ^:mut ^I32 i 0 ^:mut ^I32 split 0 ^:mut ^I32 advantage 0 ^:mut ^I32 best 0]
    (if (>= (ms-match-kind match) (ms-word-candidate))
      (do (if (>= (ms-band-confidence fl fw a na) (ms-band-confidence fl fw b nb)) (return na))
          (return 0)))
    (while (< i na)
      (do (set advantage (+ advantage
                            (- (ms-line-confidence fl fw (cells-at a (- na i 1)))
                               (ms-line-confidence fl fw (cells-at b i)))))
          (set i (+ i 1))
          (if (>= advantage best) (do (set best advantage) (set split i)))))
    (return split)))

(defn ^I32 ms-same-word-band [^Cells keys ^Cells codepoints ^Cells a ^Cells b ^I32 na ^I32 nb
                              ^:mut ^Cells aw ^:mut ^Cells bw]
  (comment "Fuzzy alignment discovers the seam. Deletion across different line breaks requires")
  (comment "the same entire word stream, including words omitted by the alignment.")
  (let [^I32 an (* 4 (ms-word-stream keys codepoints a 1 aw))
        ^I32 bn (* 4 (ms-word-stream keys codepoints b 0 bw))
        ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 end 0 ^:mut ^I32 k 0
        ^:mut ^I32 size 0 ^:mut ^I32 sa 0 ^:mut ^I32 sb 0]
    (while (and (< i an) (>= (cells-at aw (+ i 2)) na)) (set i (+ i 4)))
    (while (and (< end bn) (< (cells-at bw (+ end 2)) nb)) (set end (+ end 4)))
    (if (or (== end 0) (!= (- an i) end)) (return 0))
    (while (< j end)
      (do (set size (cells-at aw (+ i 1)))
          (if (!= size (cells-at bw (+ j 1))) (return 0))
          (set sa (cells-at aw i)) (set sb (cells-at bw j)) (set k 0)
          (while (< k size)
            (do (if (!= (cells-at codepoints (+ sa k)) (cells-at codepoints (+ sb k))) (return 0))
                (set k (+ k 1))))
          (set i (+ i 4)) (set j (+ j 4))))
    (return 1)))

(defn ^I32 ms-band-live [^Cells keys ^Cells band ^I32 n ^Cells dropped]
  (let [^:mut ^I32 i 0]
    (while (< i n)
      (do (if (== (ms-row-live keys dropped (cells-at band i)) 0) (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 ms-remove-band [^Cells fl ^Cells fw ^Cells et ^Cells keys ^Cells band ^I32 n
                           ^:mut ^Cells dropped ^:mut ^Cells ledger ^:mut ^Cells model-text]
  (let [^:mut ^I32 i 0 ^:mut ^I32 count 0]
    (while (< i n)
      (do (set count (+ count (ms-drop-row fl fw et keys (cells-at band i) dropped ledger model-text)))
          (set i (+ i 1))))
    (return count)))

(defn ^I32 ms-next-number [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i start ^:mut ^I32 cp 0]
    (while (< i end)
      (do (set cp (cells-at text i))
          (if (or (== (fmt-digit cp) 1)
                  (and (or (== cp 43) (== cp 45) (== cp 46) (== cp 44) (== cp 8722))
                       (< (+ i 1) end) (== (fmt-digit (cells-at text (+ i 1))) 1)))
            (return i))
          (set i (+ i 1))))
    (return end)))

(defn ^I32 ms-number-end [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i (+ start 1) ^:mut ^I32 cp 0]
    (while (< i end)
      (do (set cp (cells-at text i))
          (if (and (== (fmt-digit cp) 0)
                   (or (and (!= cp 46) (!= cp 44) (!= cp 47) (!= cp 45))
                       (>= (+ i 1) end) (== (fmt-digit (cells-at text (+ i 1))) 0)))
            (return i))
          (set i (+ i 1))))
    (return end)))

(defn ^I32 ms-numbers-agree [^Cells keys ^Cells text ^I32 a ^I32 b]
  (comment "Preserve the sequence of prices, quantities and other numbers on this visual row.")
  (let [^:mut ^I32 i (ms-key keys a 0) ^:mut ^I32 j (ms-key keys b 0)
        ^I32 end-a (+ i (ms-key keys a 1)) ^I32 end-b (+ j (ms-key keys b 1))
        ^:mut ^I32 stop-a 0 ^:mut ^I32 stop-b 0]
    (while (or (< i end-a) (< j end-b))
      (do (set i (ms-next-number text i end-a))
          (set j (ms-next-number text j end-b))
          (if (or (== i end-a) (== j end-b))
            (do (if (and (== i end-a) (== j end-b)) (return 1))
                (return 0)))
          (set stop-a (ms-number-end text i end-a))
          (set stop-b (ms-number-end text j end-b))
          (if (!= (- stop-a i) (- stop-b j)) (return 0))
          (while (< i stop-a)
            (do (if (!= (cells-at text i) (cells-at text j)) (return 0))
                (set i (+ i 1)) (set j (+ j 1))))))
    (return 1)))

(defn ^I32 ms-row-words-equal [^Cells keys ^Cells text ^I32 a ^I32 b]
  (comment "Ignore punctuation while comparing the sequence of letter and digit runs.")
  (let [^:mut ^I32 i (ms-key keys a 0) ^:mut ^I32 j (ms-key keys b 0)
        ^I32 end-a (+ i (ms-key keys a 1)) ^I32 end-b (+ j (ms-key keys b 1))]
    (while (or (< i end-a) (< j end-b))
      (do (while (and (< i end-a) (>= (sc-cp-class (cells-at text i)) 2)) (set i (+ i 1)))
          (while (and (< j end-b) (>= (sc-cp-class (cells-at text j)) 2)) (set j (+ j 1)))
          (if (or (== i end-a) (== j end-b))
            (do (if (and (== i end-a) (== j end-b)) (return 1))
                (return 0)))
          (while (and (< i end-a) (< j end-b)
                      (< (sc-cp-class (cells-at text i)) 2) (< (sc-cp-class (cells-at text j)) 2))
            (do (if (!= (cells-at text i) (cells-at text j)) (return 0))
                (set i (+ i 1)) (set j (+ j 1))))
          (if (or (and (< i end-a) (< (sc-cp-class (cells-at text i)) 2))
                  (and (< j end-b) (< (sc-cp-class (cells-at text j)) 2))) (return 0))))
    (return 1)))

(defn ^I32 ms-row-similarity [^Cells keys ^Cells text ^I32 a ^I32 b ^:mut ^Cells row]
  (return (ms-similarity text (ms-key keys a 0) (ms-key keys a 1)
                         (ms-key keys b 0) (ms-key keys b 1) row)))

(defn ^I32 ms-neighbor-support [^Cells fl ^Cells keys ^Cells text ^Cells offsets ^Cells pixels
                               ^I32 la ^I32 lb ^I32 near-a ^I32 near-b ^I32 corroborated ^:mut ^Cells row]
  (if (or (!= (ms-key keys near-a 2) 2) (!= (ms-key keys near-b 2) 2)
          (== (ms-equal keys text la near-a) 1) (== (ms-equal keys text lb near-b) 1))
    (return 0))
  (if (== (ms-equal keys text near-a near-b) 1) (return 2))
  (if (and (== (ms-numbers-agree keys text near-a near-b) 1)
           (>= (ms-row-similarity keys text near-a near-b row) 780)
           (or (== corroborated 1) (== (ms-pixel-pair fl offsets pixels near-a near-b) 1)))
    (return 1))
  (return 0))

(defn ^I32 ms-row-support [^Cells fl ^Cells keys ^Cells text ^Cells offsets ^Cells pixels
                          ^Cells a ^Cells b ^I32 n ^I32 i ^I32 corroborated ^:mut ^Cells row]
  (let [^I32 la (cells-at a (- n i 1)) ^I32 lb (cells-at b i)
        ^:mut ^I32 before (- i 1) ^:mut ^I32 after (+ i 1)
        ^:mut ^I32 above 0 ^:mut ^I32 below 0]
    (while (and (>= before 0) (== (ms-key keys (cells-at b before) 2) 1))
      (set before (- before 1)))
    (while (and (< after n) (== (ms-key keys (cells-at b after) 2) 1))
      (set after (+ after 1)))
    (if (>= before 0)
      (set above (ms-neighbor-support fl keys text offsets pixels la lb (cells-at a (- n before 1))
                                      (cells-at b before) corroborated row)))
    (if (< after n)
      (set below (ms-neighbor-support fl keys text offsets pixels la lb (cells-at a (- n after 1))
                                      (cells-at b after) corroborated row)))
    (if (== (ms-key keys la 2) 1)
      (do (if (and (== above 2) (== below 2) (== (ms-equal keys text (cells-at b before) (cells-at b after)) 0))
            (return 1))
          (return 0)))
    (if (> (+ above below) 0) (return 1))
    (return 0)))

(defn ^I32 ms-deduplicate [^Cells fl ^Cells fw ^Cells et ^Cells keys ^Cells codepoints
                           ^Cells offsets ^Cells pixels ^Cells a ^Cells b ^I32 match ^I32 fragment
                           ^:mut ^Cells dropped ^:mut ^Cells ledger ^:mut ^Cells model-text
                           ^:mut ^Cells aw ^:mut ^Cells bw ^:mut ^Cells row]
  (comment "Remove only supported row pairs. A negative count denotes an incomplete reduction.")
  (let [^I32 na (ms-match-left match) ^I32 nb (rem match 32)
        ^I32 split (ms-copy-split fl fw a b match)
        ^:mut ^I32 i 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0 ^:mut ^I32 pixel 0
        ^:mut ^I32 removed 0 ^:mut ^I32 ambiguous 0]
    (if (>= (ms-match-kind match) (ms-word-candidate))
      (do (if (and (== (ms-band-live keys a na dropped) 1) (== (ms-band-live keys b nb dropped) 1)
                   (== (ms-same-word-band keys codepoints a b na nb aw bw) 1))
            (do (if (> split 0) (return (ms-remove-band fl fw et keys b nb dropped ledger model-text)))
                (return (ms-remove-band fl fw et keys a na dropped ledger model-text))))
          (if (!= na nb) (return 0))))
    (while (< i na)
      (do (set la (cells-at a (- na i 1)))
          (set lb (cells-at b i))
          (set pixel (ms-pixel-pair fl offsets pixels la lb))
          (if (and (== (ms-row-live keys dropped la) 1) (== (ms-row-live keys dropped lb) 1)
                   (or (== (ms-equal keys codepoints la lb) 1)
                       (and (== (ms-key keys la 2) 2) (== (ms-key keys lb 2) 2)
                            (== (ms-numbers-agree keys codepoints la lb) 1)
                            (or (== (ms-row-words-equal keys codepoints la lb) 1)
                                (and (== pixel 1) (>= (ms-row-similarity keys codepoints la lb row) 900)))))
                   (or (== na 1)
                       (== (ms-row-support fl keys codepoints offsets pixels a b na i (ms-max pixel fragment) row) 1)))
            (do (if (< i split)
                  (set removed (+ removed (ms-drop-row fl fw et keys lb dropped ledger model-text)))
                  (set removed (+ removed (ms-drop-row fl fw et keys la dropped ledger model-text)))))
            (set ambiguous 1))
          (set i (+ i 1))))
    (if (== ambiguous 1) (return (- 0 removed)))
    (return removed)))

(defn ^I32 ms-word-pixels [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells codepoints
                            ^Cells offsets ^Cells pixels ^I32 na ^I32 nb]
  (comment "A word band can cross different OCR line boundaries. Compare only identifiable whole row pairs.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0]
    (while (< i na)
      (do (set la (cells-at a i))
          (set j 0)
          (while (< j nb)
            (do (set lb (cells-at b j))
                (if (and (== (ms-key keys la 2) 2) (== (ms-equal keys codepoints la lb) 1)
                         (== (ms-pixel-pair fl offsets pixels la lb) 1))
                  (return 1))
                (set j (+ j 1))))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 ms-continuity [^Cells fl ^Cells fw ^Cells keys ^Cells ol ^Cells ow ^Cells et ^Cells pages
                         ^Cells cuts ^Cells dropped ^I32 left ^I32 right ^Cells a ^Cells b ^I32 match]
  (let [^I32 na (ms-match-left match) ^I32 nb (rem match 32)]
    (if (or (== (ms-gap-edge ol ow et fl fw keys pages cuts left 1 b nb (+ nb 1) dropped 1) 2)
            (== (ms-gap-edge ol ow et fl fw keys pages cuts right 0 a na (+ na 1) dropped 1) 2))
      (return 1))
    (return 0)))

(defn ^I32 ms-confirm-pair [^Cells fl ^Cells fw ^Cells keys ^Cells codepoints ^Cells offsets ^Cells pixels
                            ^Cells ol ^Cells ow ^Cells et ^Cells pages ^Cells cuts ^Cells dropped
                            ^I32 left ^I32 right ^Cells a ^Cells b ^I32 match]
  (let [^I32 kind (ms-match-kind match) ^I32 rows (ms-match-rows match)
        ^I32 na (ms-match-left match) ^I32 nb (rem match 32)]
    (if (== rows 0) (return 0))
    (if (and (== rows 1)
             (or (!= na 1) (!= nb 1) (>= match (ms-trimmed-factor))
                 (== (ms-equal keys codepoints (cells-at a 0) (cells-at b 0)) 0)))
      (return 0))
    (if (and (>= rows 3) (>= (ms-match-quality match) (ms-quality-code 850))
             (< kind (ms-word-open)))
      (return 1))
    (if (and (>= rows 2) (< kind (ms-word-open)))
      (do (if (< kind (ms-word-candidate))
            (if (> (ms-pixel-votes fl a b keys offsets pixels na) 0) (return 1)))
          (if (and (>= kind (ms-word-candidate))
                   (== (ms-word-pixels fl a b keys codepoints offsets pixels na nb) 1))
            (return 1))))
    (return (ms-continuity fl fw keys ol ow et pages cuts dropped left right a b match))))

(defn ^I32 ms-mark [^:mut ^Cells seams ^I32 left ^I32 right ^I32 kind ^I32 match]
  (cells-push seams left) (cells-push seams right) (cells-push seams kind)
  (cells-push seams (rem match 32))
  (cells-push seams (+ (rem (quot match 1024) 32) 0))
  (return 0))

(defn ^:pub ^I32 ms-run [^I32 np ^I32 capture ^Cells mask ^Cells pages ^Cells ol ^Cells ow ^Cells et ^:mut ^Cells fl ^:mut ^Cells fw
                        ^Cells offsets ^Cells pixels ^Cells cuts
                        ^:mut ^Cells ledger ^:mut ^Cells model-text ^:mut ^Cells seams
                        ^:mut ^Cells keys ^:mut ^Cells codepoints ^:mut ^Cells a ^:mut ^Cells b
                        ^:mut ^Cells dropped ^:mut ^Cells new-lines ^:mut ^Cells new-words
                        ^:mut ^Cells aw ^:mut ^Cells bw ^:mut ^Cells word-row]
  (comment "The upload order is authoritative: the only seam pairs are consecutive raster inputs.")
  (cells-drop seams 0) (cells-drop keys 0) (cells-drop codepoints 0) (cells-drop dropped 0)
  (if (or (< np 2) (== capture 1)) (return 0))
  (let [^:mut ^I32 first-pair 1]
    (while (and (< first-pair np)
                (or (== (ms-raster mask first-pair) 0) (== (ms-raster mask (+ first-pair 1)) 0)))
      (set first-pair (+ first-pair 1)))
    (if (>= first-pair np) (return 0)))
  (ms-index fl fw ol et np keys codepoints aw)
  (let [^:mut ^I32 page 1 ^:mut ^I32 end 1 ^:mut ^I32 i 0
        ^:mut ^I32 changes 0 ^:mut ^I32 forward 0 ^:mut ^I32 accepted 0 ^:mut ^I32 removed 0]
    (while (< i (ln-count fl))
      (do (cells-push dropped 0) (set i (+ i 1))))
    (set page 1)
    (while (<= page np)
      (do (set end (+ page 1))
          (if (> (ms-raster mask page) 0)
            (while (and (<= end np) (> (ms-raster mask end) 0))
              (set end (+ end 1))))
          (while (< (+ page 1) end)
            (do (set forward (ms-pair fl keys codepoints page (+ page 1) a b aw bw word-row))
                (set accepted
                     (ms-confirm-pair fl fw keys codepoints offsets pixels ol ow et pages cuts dropped page (+ page 1) a b forward))
                (if (== accepted 1)
                  (do (if (== (ms-join-gap ol ow et fl fw keys pages cuts dropped page (+ page 1) a b forward) 1)
                        (ms-mark seams page (+ page 1) 3 0))
                      (let [^I32 fragment (ms-continuity fl fw keys ol ow et pages cuts dropped page (+ page 1) a b forward)]
                        (set removed (ms-deduplicate fl fw et keys codepoints offsets pixels a b forward fragment
                                                     dropped ledger model-text aw bw word-row)))
                      (if (or (<= removed 0) (>= forward (ms-trimmed-factor)))
                        (ms-mark seams page (+ page 1) 2 forward))
                      (if (!= removed 0)
                        (do (ms-mark seams page (+ page 1) 1 forward)
                            (if (< removed 0) (set removed (- 0 removed)))
                            (set changes (+ changes removed)))))
                  (do (if (> forward 0) (ms-mark seams page (+ page 1) 2 forward))
                      (if (== (ms-join-gap ol ow et fl fw keys pages cuts dropped page (+ page 1) a b 0) 1)
                        (ms-mark seams page (+ page 1) 3 0))))
                (set page (+ page 1))))
          (set page end)))
    (if (> changes 0)
      (do (cells-drop new-lines 0) (cells-drop new-words 0)
          (ms-rebuild fl fw dropped new-lines new-words)))
    (return changes)))

(defn ^I32 ms-photo-page [^Cells seams ^Cells cuts ^I32 page]
  (comment "A bitmap edge with cut text or a corroborated overlap classifies this raster page as a partial photo.")
  (comment "The overlap can supply that evidence even when the photo has clean margins.")
  (if (or (> (ms-cut cuts page 0) 0) (> (ms-cut cuts page 1) 0))
    (return 1))
  (let [^:mut ^I32 i 0]
    (while (< i (cells-len seams))
      (do (if (and (== (cells-at seams (+ i 2)) 1)
                   (or (== (cells-at seams i) page) (== (cells-at seams (+ i 1)) page)))
            (return 1))
          (set i (+ i 5)))))
  (return 0))

(defn ^:pub ^I32 ms-evidence [^:mut ^Text out ^Cells seams ^Cells mask ^Cells cuts ^I32 capture]
  (let [^:mut ^I32 page 1 ^:mut ^I32 count 0]
    (if (and (!= capture 1) (> (cells-len mask) 1))
      (while (<= page (cells-len mask))
        (do (if (and (> (ms-raster mask page) 0)
                     (or (== capture 2) (== (ms-photo-page seams cuts page) 1)))
              (do (if (== count 0) (emit-ascii out ",\"photoPages\":[") (emit-ascii out ","))
                  (text-i32 out page)
                  (set count (+ count 1))))
            (set page (+ page 1)))))
    (if (> count 0) (emit-ascii out "]")))
  (let [^:mut ^I32 i 0 ^:mut ^I32 kind 0]
    (if (== (cells-len seams) 0) (return 0))
    (set i 0)
    (emit-ascii out ",\"seams\":[")
    (while (< i (cells-len seams))
      (do (if (> i 0) (emit-ascii out ","))
          (emit-ascii out "{\"left\":") (text-i32 out (cells-at seams i))
          (emit-ascii out ",\"right\":") (text-i32 out (cells-at seams (+ i 1)))
          (emit-ascii out ",\"kind\":\"")
          (set kind (cells-at seams (+ i 2)))
          (if (== kind 1) (emit-ascii out "overlap"))
          (if (== kind 2) (emit-ascii out "possible-duplicate"))
          (if (== kind 3) (emit-ascii out "possible-gap"))
          (emit-ascii out "\",\"lines\":") (text-i32 out (cells-at seams (+ i 3)))
          (emit-ascii out ",\"content\":") (text-i32 out (cells-at seams (+ i 4)))
          (emit-ascii out "}")
          (set i (+ i 5))))
    (emit-ascii out "]")
    (return 0)))
