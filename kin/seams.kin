;; Document-space seams between raster pages. The page units have already
;; withheld clipped OCR lines. Evidence uses original source page numbers.
(ns emon.seams
  (:require [emon.lang :refer [I32 I64 Cells Text Bitmap emit-ascii i64 i32 mul64]]
            [emon.port :refer [cells-at cells-set cells-push cells-drop cells-len cells-swap text-i32
                               bitmap-w bitmap-h bitmap-channels bitmap-u8]]
            [emon.evidence :refer [ln-count ln-get wd-get ol-count ol-get olf-conf lf-order
                                   hd-page hd-tstart hd-tlen lh-first lh-count lh-x0 lh-x1 lh-y0 lh-y1]]
            [emon.model :refer [page-h page-px-h ledger-add ledger-set-text text-append-cp sr-ocr dr-seam-duplicate]]
            [emon.player :refer [fw-count fw-copy-word fl-copy-line]]
            [kin.lang :refer [defn return let set while if do comment + - * quot rem < > <= >= == != and or]]))

(defn ^I32 ms-band [] (return 16))

(defn ^I32 ms-rule-cp [^I32 cp]
  (if (or (== cp 45) (== cp 42) (== cp 61) (== cp 95) (== cp 46) (== cp 8212)) (return 1))
  (return 0))

(defn ^I32 ms-index [^Cells fl ^Cells fw ^Cells et ^I32 np ^:mut ^Cells keys ^:mut ^Cells codepoints]
  (comment "Each flow line has a normalized text span and a kind: blank 0, separator 1, or content 2.")
  (let [^:mut ^I32 line 0 ^:mut ^I32 word 0 ^:mut ^I32 stop 0
        ^:mut ^I32 start 0 ^:mut ^I32 pos 0 ^:mut ^I32 end 0
        ^:mut ^I32 cp 0 ^:mut ^I32 kind 0 ^:mut ^I32 at 0]
    (while (< line (ln-count fl))
      (do (set start (cells-len codepoints))
          (set kind 0)
          (set word (ln-get fl line (lh-first)))
          (set stop (+ word (ln-get fl line (lh-count))))
          (while (< word stop)
            (do (set pos (wd-get fw word (hd-tstart)))
                (set end (+ pos (wd-get fw word (hd-tlen))))
                (if (> (cells-len codepoints) start) (cells-push codepoints 32))
                (while (< pos end)
                  (do (set cp (cells-at et pos))
                      (if (and (>= cp 65) (<= cp 90)) (set cp (+ cp 32)))
                      (if (and (> cp 32) (!= cp 160))
                        (do (cells-push codepoints cp)
                            (if (!= (ms-rule-cp cp) 1) (set kind 2))
                            (if (== kind 0) (set kind 1))))
                      (set pos (+ pos 1))))
                (set word (+ word 1))))
          (cells-push keys start)
          (cells-push keys (- (cells-len codepoints) start))
          (cells-push keys kind)
          (set line (+ line 1))))
    (while (< at np)
      (do (cells-push keys line) (cells-push keys 0) (set at (+ at 1))))
    (set line 0)
    (while (< line (ln-count fl))
      (do (set at (+ (* (ln-count fl) 3) (* (- (ln-get fl line (hd-page)) 1) 2)))
          (if (== (cells-at keys (+ at 1)) 0) (cells-set keys at line))
          (cells-set keys (+ at 1) (+ line 1))
          (set line (+ line 1))))
    (return line)))

(defn ^I32 ms-key [^Cells keys ^I32 line ^I32 field]
  (return (cells-at keys (+ (* line 3) field))))

(defn ^I32 ms-equal [^Cells keys ^Cells codepoints ^I32 a ^I32 b]
  (let [^I32 na (ms-key keys a 1) ^I32 sa (ms-key keys a 0) ^I32 sb (ms-key keys b 0)
        ^I32 ka (ms-key keys a 2) ^I32 kb (ms-key keys b 2) ^:mut ^I32 i 0]
    (if (!= ka kb) (return 0))
    (if (== ka 1) (return 1))
    (if (!= na (ms-key keys b 1)) (return 0))
    (while (< i na)
      (do (if (!= (cells-at codepoints (+ sa i)) (cells-at codepoints (+ sb i))) (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 ms-one-edit [^Cells keys ^Cells codepoints ^I32 a ^I32 b]
  (comment "Allow one OCR edit on a substantial line.")
  (let [^I32 na (ms-key keys a 1) ^I32 nb (ms-key keys b 1)
        ^I32 sa (ms-key keys a 0) ^I32 sb (ms-key keys b 0)
        ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 edits 0]
    (if (or (< na 8) (< nb 8) (> na (+ nb 1)) (> nb (+ na 1))) (return 0))
    (while (and (< i na) (< j nb))
      (do (if (== (cells-at codepoints (+ sa i)) (cells-at codepoints (+ sb j)))
            (do (set i (+ i 1)) (set j (+ j 1)))
            (do (if (> edits 0) (return 0))
                (set edits 1)
                (if (>= na nb) (set i (+ i 1)))
                (if (>= nb na) (set j (+ j 1)))))))
    (if (> (+ edits (- na i) (- nb j)) 1) (return 0))
    (return 1)))

(defn ^I32 ms-next-token-char [^Cells text ^I32 at ^I32 end]
  (let [^:mut ^I32 i at ^:mut ^I32 cp 0]
    (while (< i end)
      (do (set cp (cells-at text i))
          (if (or (== cp 32) (and (>= cp 48) (<= cp 57)) (and (>= cp 97) (<= cp 122)) (>= cp 128))
            (return i))
          (set i (+ i 1))))
    (return i)))

(defn ^I32 ms-token-band [^Cells keys ^Cells codepoints ^I32 a ^I32 b]
  (comment "A substantially identical word band may have punctuation variants or one extra final token.")
  (let [^:mut ^I32 i (ms-key keys a 0) ^:mut ^I32 j (ms-key keys b 0)
        ^I32 ea (+ i (ms-key keys a 1)) ^I32 eb (+ j (ms-key keys b 1))
        ^:mut ^I32 words 0 ^:mut ^I32 chars 0]
    (set i (ms-next-token-char codepoints i ea))
    (set j (ms-next-token-char codepoints j eb))
    (while (and (< i ea) (< j eb) (== (cells-at codepoints i) (cells-at codepoints j)))
      (do (if (== (cells-at codepoints i) 32)
            (do (if (> chars 0) (set words (+ words 1))) (set chars 0))
            (set chars (+ chars 1)))
          (set i (ms-next-token-char codepoints (+ i 1) ea))
          (set j (ms-next-token-char codepoints (+ j 1) eb))))
    (if (and (< i ea) (< j eb)) (return 0))
    (if (> chars 0) (set words (+ words 1)))
    (if (< words 3) (return 0))
    (if (< i ea)
      (do (if (!= (cells-at codepoints i) 32) (return 0))
          (set i (+ i 1))
          (while (< i ea)
            (do (if (== (cells-at codepoints i) 32) (return 0))
                (set i (+ i 1))))))
    (if (< j eb)
      (do (if (!= (cells-at codepoints j) 32) (return 0))
          (set j (+ j 1))
          (while (< j eb)
            (do (if (== (cells-at codepoints j) 32) (return 0))
                (set j (+ j 1))))))
    (return 1)))

(defn ^I32 ms-variant [^Cells keys ^Cells codepoints ^I32 a ^I32 b]
  (if (or (!= (ms-key keys a 2) 2) (!= (ms-key keys b 2) 2)) (return 0))
  (if (== (ms-one-edit keys codepoints a b) 1) (return 1))
  (return (ms-token-band keys codepoints a b)))

(defn ^I32 ms-y [^Cells fl ^I32 line]
  (return (+ (ln-get fl line (lh-y0)) (ln-get fl line (lh-y1)))))

(defn ^I32 ms-pixel [^I32 coordinate ^I32 pixels ^I32 extent]
  (let [^I32 p (i32 (quot (* (i64 coordinate) (i64 pixels)) (i64 extent)))]
    (if (< p 0) (return 0))
    (if (>= p pixels) (return (- pixels 1)))
    (return p)))

(defn ^I32 ms-grey [^Bitmap bitmap ^I32 x ^I32 y ^I32 channels]
  (let [^I32 red (bitmap-u8 bitmap x y 0)]
    (if (< channels 3) (return red))
    (return (quot (+ (* 77 red) (* 150 (bitmap-u8 bitmap x y 1))
                     (* 29 (bitmap-u8 bitmap x y 2))) 256))))

(defn ^I32 ms-dark-edge [^Bitmap bitmap ^I32 x ^I32 y ^I32 channels]
  (let [^I32 grey (ms-grey bitmap x y channels)]
    (if (and (>= (- (ms-grey bitmap (- x 5) y channels) grey) 24)
             (>= (- (ms-grey bitmap (+ x 5) y channels) grey) 24))
      (return 1))
    (return 0)))

(defn ^I32 ms-cut-ink [^Bitmap bitmap ^I32 y ^I32 inward ^I32 left ^I32 right]
  (comment "Narrow dark strokes crossing the outermost rows corroborate a physical cut, even when OCR omits")
  (comment "the fragment. Require several separate strokes to reject page borders and isolated noise.")
  (let [^I32 w (bitmap-w bitmap) ^I32 channels (bitmap-channels bitmap)
        ^:mut ^I32 x left ^:mut ^I32 last -2 ^:mut ^I32 strokes 0
        ^:mut ^I32 inside 0 ^:mut ^I32 last-inside -2]
    (if (< x 5) (set x 5))
    (while (and (< x (- w 5)) (< x right))
      (do (if (== (ms-dark-edge bitmap x (+ y inward) channels) 1)
            (do (if (> (- x last-inside) 1) (set inside (+ inside 1)))
                (set last-inside x)
                (if (== (ms-dark-edge bitmap x y channels) 1)
                  (do (if (> (- x last) 1) (set strokes (+ strokes 1)))
                      (set last x)))))
          (if (and (>= strokes 2) (>= inside 3)) (return 1))
          (set x (+ x 1))))
    (return 0)))

(defn ^:pub ^I32 ms-sample-cut [^Bitmap bitmap ^I32 page ^:mut ^Cells cuts]
  (let [^I32 h (bitmap-h bitmap) ^I32 w (bitmap-w bitmap)]
    (while (< (cells-len cuts) (* page 2)) (cells-push cuts 0))
    (if (< h 3) (return 0))
    (cells-set cuts (- (* page 2) 2) (ms-cut-ink bitmap 0 1 0 w))
    (cells-set cuts (- (* page 2) 1) (ms-cut-ink bitmap (- h 1) -1 0 w))
    (return 0)))

(defn ^:pub ^I32 ms-line-cuts [^Bitmap bitmap ^Cells lines ^Cells selection ^I32 start ^I32 count
                              ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 fourpx ^:mut ^Cells cuts]
  (comment "Corroborate an OCR box only with strokes in the same horizontal span of its own bitmap edge.")
  (cells-drop cuts 0)
  (let [^I32 w (bitmap-w bitmap) ^I32 h (bitmap-h bitmap)
        ^:mut ^I32 i 0 ^:mut ^I32 line 0 ^:mut ^I32 top 0 ^:mut ^I32 bottom 0
        ^:mut ^I32 left 0 ^:mut ^I32 right 0 ^:mut ^I32 cut 0]
    (if (or (< h 3) (<= x1 x0)) (return 0))
    (while (< i count)
      (do (set line (cells-at selection (+ start i)))
          (set top (- (ol-get lines line (lh-y0)) y0))
          (set bottom (- y1 (ol-get lines line (lh-y1))))
          (set cut 0)
          (if (or (and (<= top fourpx) (>= top (- 0 fourpx)))
                  (and (<= bottom fourpx) (>= bottom (- 0 fourpx))))
            (do (set left (ms-pixel (- (ol-get lines line (lh-x0)) x0) w (- x1 x0)))
                (set right (ms-pixel (- (ol-get lines line (lh-x1)) x0) w (- x1 x0)))
                (if (<= top bottom)
                  (set cut (ms-cut-ink bitmap 0 1 left right))
                  (set cut (ms-cut-ink bitmap (- h 1) -1 left right)))))
          (cells-push cuts cut)
          (set i (+ i 1))))
    (return count)))

(defn ^I32 ms-patch [^Bitmap bitmap ^Cells lines ^I32 line ^I32 width ^I32 height ^:mut ^Cells pixels]
  (let [^I32 w (bitmap-w bitmap) ^I32 h (bitmap-h bitmap)
        ^I32 x0 (ln-get lines line (lh-x0)) ^I32 y0 (ln-get lines line (lh-y0))
        ^I32 dx (- (ln-get lines line (lh-x1)) x0)
        ^I32 dy (- (ln-get lines line (lh-y1)) y0)
        ^I32 channels (bitmap-channels bitmap)
        ^:mut ^I32 u 0 ^:mut ^I32 v 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0]
    (while (< v 12)
      (do (set y (ms-pixel (+ y0 (quot (* (- v 2) dy) 8)) h height))
          (set u 0)
          (while (< u 32)
            (do (set x (ms-pixel (+ x0 (quot (* (+ (* u 2) 1) dx) 64)) w width))
                (cells-push pixels (ms-grey bitmap x y channels))
                (set u (+ u 1))))
          (set v (+ v 1))))
    (return 0)))

(defn ^:pub ^I32 ms-ncc [^Cells pixels ^I32 a ^I32 b ^I32 count]
  (comment "Scaled integer Pearson correlation. Require positive covariance and reject near-flat crops.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0
        ^:mut ^I64 sx (i64 0) ^:mut ^I64 sy (i64 0) ^:mut ^I64 xx (i64 0)
        ^:mut ^I64 yy (i64 0) ^:mut ^I64 xy (i64 0)
        ^:mut ^I64 vx (i64 0) ^:mut ^I64 vy (i64 0) ^:mut ^I64 covariance (i64 0)]
    (while (< i count)
      (do (set x (cells-at pixels (+ a i))) (set y (cells-at pixels (+ b i)))
          (set sx (+ sx (i64 x))) (set sy (+ sy (i64 y)))
          (set xx (+ xx (i64 (* x x)))) (set yy (+ yy (i64 (* y y))))
          (set xy (+ xy (i64 (* x y))))
          (set i (+ i 1))))
    (set vx (quot (- (* (i64 count) xx) (* sx sx)) (i64 count)))
    (set vy (quot (- (* (i64 count) yy) (* sy sy)) (i64 count)))
    (set covariance (quot (- (* (i64 count) xy) (* sx sy)) (i64 count)))
    (if (and (> covariance (i64 0)) (> vx (i64 count)) (> vy (i64 count)))
      (if (>= (* (* covariance covariance) (i64 100)) (* (* vx vy) (i64 81))) (return 1)))
    (return 0)))

(defn ^I32 ms-edge-add [^Cells fl ^:mut ^Cells edge ^I32 line ^I32 bottom]
  (comment "Insert from the physical edge inward. Bound the band even on very long pages.")
  (let [^I32 y (ms-y fl line) ^:mut ^I32 i 0 ^:mut ^I32 j (cells-len edge)
        ^:mut ^I32 side 0]
    (while (< i j)
      (do (set side (- y (ms-y fl (cells-at edge i))))
          (if (== bottom 0) (set side (- 0 side)))
          (if (> side 0) (set j i) (set i (+ i 1)))))
    (if (>= i (ms-band)) (return 0))
    (set j (- (cells-len edge) 1))
    (if (< (cells-len edge) (ms-band)) (do (cells-push edge 0) (set j (+ j 1))))
    (while (> j i)
      (do (cells-set edge j (cells-at edge (- j 1))) (set j (- j 1))))
    (cells-set edge i line)
    (return 0)))

(defn ^:pub ^I32 ms-sample [^Bitmap bitmap ^Cells lines ^I32 first ^I32 width ^I32 height
                          ^:mut ^Cells offsets ^:mut ^Cells pixels ^:mut ^Cells top ^:mut ^Cells bottom]
  (comment "The page unit may release its bitmap after this call. Retain only fixed-size edge-line samples.")
  (if (or (<= width 0) (<= height 0) (<= (bitmap-w bitmap) 0) (<= (bitmap-h bitmap) 0)
          (> (cells-len pixels) 4000000)) (return 0))
  (cells-drop top 0) (cells-drop bottom 0)
  (let [^:mut ^I32 i first ^:mut ^I32 line 0 ^:mut ^I32 j 0]
    (while (< (cells-len offsets) (ln-count lines)) (cells-push offsets -1))
    (while (< i (ln-count lines))
      (do (if (> (ln-get lines i (lh-count)) 0)
            (do (ms-edge-add lines top i 0) (ms-edge-add lines bottom i 1)))
          (set i (+ i 1))))
    (while (< j (+ (cells-len top) (cells-len bottom)))
      (do (if (< j (cells-len top))
            (set line (cells-at top j))
            (set line (cells-at bottom (- j (cells-len top)))))
          (if (< (cells-at offsets line) 0)
            (do (cells-set offsets line (cells-len pixels))
                (ms-patch bitmap lines line width height pixels)))
          (set j (+ j 1))))
    (return 0)))

(defn ^I32 ms-pixel-votes [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells offsets ^Cells pixels ^I32 n]
  (let [^:mut ^I32 i 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0 ^:mut ^I32 va 0 ^:mut ^I32 vb 0 ^:mut ^I32 votes 0]
    (while (< i n)
      (do (set la (cells-at a (- (- n 1) i))) (set lb (cells-at b i))
          (if (and (== (ms-key keys la 2) 2)
                   (< (ln-get fl la (lf-order)) (cells-len offsets)) (< (ln-get fl lb (lf-order)) (cells-len offsets))
                   (>= (ln-get fl la (lf-order)) 0) (>= (ln-get fl lb (lf-order)) 0))
            (do (set va (cells-at offsets (ln-get fl la (lf-order))))
                (set vb (cells-at offsets (ln-get fl lb (lf-order))))
                (if (and (>= va 0) (>= vb 0))
                  (set votes (+ votes (ms-ncc pixels va vb 384))))))
          (set i (+ i 1))))
    (return votes)))

(defn ^I32 ms-run-score [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells codepoints ^I32 n]
  (comment "Compare a suffix of a with a prefix of b. Separator matches carry no content votes.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 la 0 ^:mut ^I32 lb 0 ^:mut ^I32 prev-a -1
        ^:mut ^I32 prev-b -1 ^:mut ^I32 votes 0 ^:mut ^I32 delta-a 0 ^:mut ^I32 delta-b 0
        ^:mut ^I32 ha 0 ^:mut ^I32 hb 0 ^:mut ^I32 exact 0]
    (while (< i n)
      (do (set la (cells-at a (- (- n 1) i)))
          (set lb (cells-at b i))
          (set exact (ms-equal keys codepoints la lb))
          (if (and (== exact 0) (== (ms-variant keys codepoints la lb) 0)) (return 0))
          (if (>= prev-a 0)
            (do (set delta-a (- (ms-y fl la) (ms-y fl prev-a)))
                (set delta-b (- (ms-y fl lb) (ms-y fl prev-b)))
                (set ha (- (ln-get fl la (lh-y1)) (ln-get fl la (lh-y0))))
                (set hb (- (ln-get fl lb (lh-y1)) (ln-get fl lb (lh-y0))))
                (if (and (> ha 0) (> hb 0))
                  (if (or (> (quot delta-a ha) (+ 2 (quot delta-b hb)))
                          (> (quot delta-b hb) (+ 2 (quot delta-a ha))))
                    (return 0)))))
          (if (== (ms-key keys la 2) 2)
            (if (or (< prev-a 0) (== (ms-equal keys codepoints la prev-a) 0))
              (if (== exact 1) (set votes (+ votes 32)) (set votes (+ votes 1)))))
          (set prev-a la) (set prev-b lb)
          (set i (+ i 1))))
    (return votes)))

(defn ^I32 ms-gap [^Cells ol ^Cells pages ^Cells cuts ^I32 left ^I32 right]
  (if (or (and (< (- (* left 2) 1) (cells-len cuts)) (== (cells-at cuts (- (* left 2) 1)) 1))
          (and (< (- (* right 2) 2) (cells-len cuts)) (== (cells-at cuts (- (* right 2) 2)) 1)))
    (return 1))
  (let [^:mut ^I32 i 0 ^:mut ^I32 edge 0 ^:mut ^I32 page 0 ^:mut ^I32 height 0 ^:mut ^I32 pixels 0]
    (while (< i (ol-count ol))
      (do (set page (ol-get ol i (hd-page)))
          (if (and (>= (ol-get ol i (olf-conf)) 0) (or (== page left) (== page right)))
            (do (set height (page-h pages (- page 1)))
                (set pixels (page-px-h pages (- page 1)))
                (if (== page left)
                  (set edge (- height (ol-get ol i (lh-y1))))
                  (set edge (ol-get ol i (lh-y0))))
                (if (and (>= edge 0)
                         (or (== edge 0) (and (> pixels 0) (<= (mul64 (i64 edge) (i64 pixels)) (i64 height)))))
                  (return 1))))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 ms-drop-line [^Cells fl ^Cells fw ^Cells et ^I32 line ^:mut ^Cells ledger ^:mut ^Cells model-text]
  (let [^I32 record (ledger-add ledger (dr-seam-duplicate) (ln-get fl line (hd-page))
                                 (ln-get fl line (lh-x0)) (ln-get fl line (lh-y0))
                                 (ln-get fl line (lh-x1)) (ln-get fl line (lh-y1)) 900 (sr-ocr))
        ^I32 text-start (cells-len model-text)
        ^I32 first (ln-get fl line (lh-first))
        ^I32 stop (+ first (ln-get fl line (lh-count)))
        ^:mut ^I32 word first ^:mut ^I32 pos 0 ^:mut ^I32 end 0]
    (while (< word stop)
      (do (if (> word first) (text-append-cp model-text 32))
          (set pos (wd-get fw word (hd-tstart)))
          (set end (+ pos (wd-get fw word (hd-tlen))))
          (while (< pos end)
            (do (text-append-cp model-text (cells-at et pos)) (set pos (+ pos 1))))
          (set word (+ word 1))))
    (ledger-set-text ledger record text-start (- (cells-len model-text) text-start))
    (return 0)))

(defn ^I32 ms-rebuild [^:mut ^Cells fl ^:mut ^Cells fw ^Cells dropped ^:mut ^Cells new-lines ^:mut ^Cells new-words]
  (let [^:mut ^I32 i 0 ^:mut ^I32 word 0 ^:mut ^I32 stop 0 ^:mut ^I32 first 0]
    (while (< i (ln-count fl))
      (do (if (== (cells-at dropped i) 0)
            (do (set word (ln-get fl i (lh-first)))
                (set stop (+ word (ln-get fl i (lh-count))))
                (set first (fw-count new-words))
                (while (< word stop)
                  (do (fw-copy-word new-words fw word (ln-count new-lines))
                      (set word (+ word 1))))
                (let [^I32 count (ln-get fl i (lh-count))]
                  (fl-copy-line new-lines fl i first count))))
          (set i (+ i 1))))
    (cells-swap fl new-lines)
    (cells-swap fw new-words)
    (return 0)))

(defn ^I32 ms-raster [^Cells mask ^I32 page]
  (return (rem (cells-at mask (- page 1)) 4)))

(defn ^I32 ms-page-edge [^Cells fl ^Cells keys ^I32 page ^I32 bottom ^:mut ^Cells band]
  (let [^I32 at (+ (* (ln-count fl) 3) (* (- page 1) 2))
        ^I32 end (cells-at keys (+ at 1))
        ^:mut ^I32 i (cells-at keys at)]
    (cells-drop band 0)
    (while (< i end)
      (do (if (and (== (ln-get fl i (hd-page)) page) (> (ms-key keys i 2) 0))
            (ms-edge-add fl band i bottom))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 ms-pair [^Cells fl ^Cells keys ^Cells codepoints ^I32 left ^I32 right
                    ^:mut ^Cells a ^:mut ^Cells b]
  (ms-page-edge fl keys left 1 a)
  (ms-page-edge fl keys right 0 b)
  (let [^:mut ^I32 n 1 ^:mut ^I32 score 0 ^:mut ^I32 best 0]
    (while (and (<= n (cells-len a)) (<= n (cells-len b)))
      (do (set score (ms-run-score fl a b keys codepoints n))
          (if (and (> score 0) (> (+ (* score 32) n) best))
            (set best (+ (* score 32) n)))
          (set n (+ n 1))))
    (return best)))

(defn ^I32 ms-accepted [^Cells fl ^Cells a ^Cells b ^Cells keys ^Cells offsets ^Cells pixels ^I32 match]
  (let [^I32 score (quot match 32) ^I32 n (rem match 32)
        ^I32 exact (quot score 32) ^I32 variant (rem score 32)]
    (if (or (>= exact 4)
            (and (>= exact 3) (> variant 0) (>= exact variant))
            (and (>= (+ exact variant) 2) (>= (ms-pixel-votes fl a b keys offsets pixels n) 2)))
      (return 1))
    (return 0)))

(defn ^I32 ms-order [^Cells fl ^Cells keys ^Cells codepoints ^Cells offsets ^Cells pixels
                     ^I32 first ^I32 end ^:mut ^Cells order ^:mut ^Cells incoming
                     ^:mut ^Cells outgoing ^:mut ^Cells a ^:mut ^Cells b]
  (comment "Recover a unique complete chain of corroborated, directional joins. Preserve upload order if")
  (comment "the evidence leaves a missing link, branching chain, or cycle. Limit all-pairs work per run.")
  (if (or (< (- end first) 2) (> (- end first) 16)) (return 0))
  (cells-drop incoming 0) (cells-drop outgoing 0)
  (let [^:mut ^I32 left first ^:mut ^I32 right first ^:mut ^I32 match 0
        ^:mut ^I32 start 0 ^:mut ^I32 cur 0 ^:mut ^I32 i first]
    (while (< i end)
      (do (cells-push incoming 0) (cells-push outgoing 0) (set i (+ i 1))))
    (while (< left end)
      (do (set right first)
          (while (< right end)
            (do (if (!= left right)
                  (do (set match (ms-pair fl keys codepoints left right a b))
                      (if (== (ms-accepted fl a b keys offsets pixels match) 1)
                        (do (if (!= (cells-at outgoing (- left first)) 0) (return 0))
                            (if (!= (cells-at incoming (- right first)) 0) (return 0))
                            (cells-set outgoing (- left first) right)
                            (cells-set incoming (- right first) left)))))
                (set right (+ right 1))))
          (set left (+ left 1))))
    (set i first)
    (while (< i end)
      (do (if (== (cells-at incoming (- i first)) 0)
            (do (if (> start 0) (return 0)) (set start i)))
          (set i (+ i 1))))
    (set cur start) (set i first)
    (while (and (> cur 0) (< i end))
      (do (set cur (cells-at outgoing (- cur first))) (set i (+ i 1))))
    (if (or (< i end) (> cur 0)) (return 0))
    (set cur start) (set i first)
    (while (< i end)
      (do (cells-set order (- i 1) cur)
          (set cur (cells-at outgoing (- cur first)))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 ms-mark [^:mut ^Cells seams ^I32 left ^I32 right ^I32 kind ^I32 match]
  (cells-push seams left) (cells-push seams right) (cells-push seams kind)
  (cells-push seams (rem match 32))
  (cells-push seams (+ (quot match 1024) (rem (quot match 32) 32)))
  (return 0))

(defn ^I32 ms-ambiguous-skips [^Cells fl ^Cells keys ^Cells codepoints ^I32 first ^I32 end
                                ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells seams]
  (comment "Report nonadjacent candidates when multiple photos were uploaded but no full order is supported.")
  (if (> (- end first) 16) (return 0))
  (let [^:mut ^I32 left first ^:mut ^I32 right 0 ^:mut ^I32 match 0]
    (while (< (+ left 2) end)
      (do (set right (+ left 2))
          (while (< right end)
            (do (set match (ms-pair fl keys codepoints left right a b))
                (if (> match 0) (ms-mark seams left right 2 match))
                (set match (ms-pair fl keys codepoints right left a b))
                (if (> match 0) (ms-mark seams right left 2 match))
                (set right (+ right 1))))
          (set left (+ left 1))))
    (return 0)))

(defn ^:pub ^I32 ms-run [^I32 np ^I32 capture ^Cells mask ^Cells pages ^Cells ol ^Cells et ^:mut ^Cells fl ^:mut ^Cells fw
                        ^Cells offsets ^Cells pixels ^Cells cuts
                        ^:mut ^Cells ledger ^:mut ^Cells model-text ^:mut ^Cells seams
                        ^:mut ^Cells keys ^:mut ^Cells codepoints ^:mut ^Cells a ^:mut ^Cells b
                        ^:mut ^Cells dropped ^:mut ^Cells new-lines ^:mut ^Cells new-words
                        ^:mut ^Cells order ^:mut ^Cells incoming ^:mut ^Cells outgoing]
  (cells-drop seams 0) (cells-drop keys 0) (cells-drop codepoints 0) (cells-drop dropped 0)
  (cells-drop order 0)
  (if (or (< np 2) (== capture 1)) (return 0))
  (let [^:mut ^I32 first-pair 1]
    (while (and (< first-pair np)
                (or (== (ms-raster mask first-pair) 0) (== (ms-raster mask (+ first-pair 1)) 0)))
      (set first-pair (+ first-pair 1)))
    (if (>= first-pair np) (return 0)))
  (ms-index fl fw et np keys codepoints)
  (let [^:mut ^I32 page 1 ^:mut ^I32 end 1 ^:mut ^I32 i 0
        ^:mut ^I32 line 0 ^:mut ^I32 changes 0 ^:mut ^I32 left 0 ^:mut ^I32 right 0
        ^:mut ^I32 forward 0 ^:mut ^I32 reverse 0 ^:mut ^I32 accepted 0
        ^:mut ^I32 reverse-accepted 0 ^:mut ^I32 ordered 0]
    (while (<= page np)
      (do (cells-push order page) (set page (+ page 1))))
    (while (< i (ln-count fl))
      (do (cells-push dropped 0) (set i (+ i 1))))
    (set page 1)
    (while (<= page np)
      (do (set end (+ page 1))
          (if (> (ms-raster mask page) 0)
            (while (and (<= end np) (> (ms-raster mask end) 0))
              (set end (+ end 1))))
          (set ordered (ms-order fl keys codepoints offsets pixels page end order incoming outgoing a b))
          (if (== ordered 0) (ms-ambiguous-skips fl keys codepoints page end a b seams))
          (while (< (+ page 1) end)
            (do (set left (cells-at order (- page 1)))
                (set right (cells-at order page))
                (set reverse (ms-pair fl keys codepoints right left a b))
                (set reverse-accepted (ms-accepted fl a b keys offsets pixels reverse))
                (set forward (ms-pair fl keys codepoints left right a b))
                (set accepted (ms-accepted fl a b keys offsets pixels forward))
                (if (and (== accepted 1) (== reverse-accepted 0))
                  (do (set i 0)
                      (while (< i (rem forward 32))
                        (do (set line (cells-at b i))
                            (if (== (cells-at dropped line) 0)
                              (do (ms-drop-line fl fw et line ledger model-text)
                                  (cells-set dropped line 1)
                                  (set changes (+ changes 1))))
                            (set i (+ i 1))))
                      (ms-mark seams left right 1 forward))
                  (do (if (> forward 0) (ms-mark seams left right 2 forward))
                      (if (and (== ordered 0) (> reverse 0)) (ms-mark seams right left 2 reverse))
                      (if (and (== forward 0) (== (ms-gap ol pages cuts left right) 1))
                        (ms-mark seams left right 3 0))))
                (set page (+ page 1))))
          (set page end)))
    (if (> changes 0)
      (do (cells-drop new-lines 0) (cells-drop new-words 0)
          (ms-rebuild fl fw dropped new-lines new-words)))
    (set i 0)
    (while (and (< i np) (== (cells-at order i) (+ i 1))) (set i (+ i 1)))
    (if (== i np) (cells-drop order 0))
    (return changes)))

(defn ^I32 ms-photo-page [^Cells seams ^Cells cuts ^I32 page]
  (comment "A bitmap edge with cut text or a corroborated overlap classifies this raster page as a partial photo.")
  (comment "The overlap can supply that evidence even when the photo has clean margins.")
  (if (and (<= (* page 2) (cells-len cuts))
           (> (+ (cells-at cuts (- (* page 2) 2)) (cells-at cuts (- (* page 2) 1))) 0))
    (return 1))
  (let [^:mut ^I32 i 0]
    (while (< i (cells-len seams))
      (do (if (and (== (cells-at seams (+ i 2)) 1)
                   (or (== (cells-at seams i) page) (== (cells-at seams (+ i 1)) page)))
            (return 1))
          (set i (+ i 5)))))
  (return 0))

(defn ^:pub ^I32 ms-evidence [^:mut ^Text out ^Cells seams ^Cells order ^Cells mask ^Cells cuts ^I32 capture]
  (let [^:mut ^I32 page 1 ^:mut ^I32 count 0]
    (if (and (!= capture 1) (> (cells-len mask) 1))
      (while (<= page (cells-len mask))
        (do (if (and (> (ms-raster mask page) 0)
                     (or (== capture 2) (== (ms-photo-page seams cuts page) 1)))
              (do (if (== count 0) (emit-ascii out ",\"photoPages\":[") (emit-ascii out ","))
                  (text-i32 out page)
                  (set count (+ count 1))))
            (set page (+ page 1)))))
    (if (> count 0) (emit-ascii out "]")))
  (let [^:mut ^I32 i 0 ^:mut ^I32 kind 0]
    (if (> (cells-len order) 0)
      (do (emit-ascii out ",\"photoOrder\":[")
          (while (< i (cells-len order))
            (do (if (> i 0) (emit-ascii out ","))
                (text-i32 out (cells-at order i))
                (set i (+ i 1))))
          (emit-ascii out "]")))
    (if (== (cells-len seams) 0) (return 0))
    (set i 0)
    (emit-ascii out ",\"seams\":[")
    (while (< i (cells-len seams))
      (do (if (> i 0) (emit-ascii out ","))
          (emit-ascii out "{\"left\":") (text-i32 out (cells-at seams i))
          (emit-ascii out ",\"right\":") (text-i32 out (cells-at seams (+ i 1)))
          (emit-ascii out ",\"kind\":\"")
          (set kind (cells-at seams (+ i 2)))
          (if (== kind 1) (emit-ascii out "overlap"))
          (if (== kind 2) (emit-ascii out "possible-duplicate"))
          (if (== kind 3) (emit-ascii out "possible-gap"))
          (emit-ascii out "\",\"lines\":") (text-i32 out (cells-at seams (+ i 3)))
          (emit-ascii out ",\"content\":") (text-i32 out (cells-at seams (+ i 4)))
          (emit-ascii out "}")
          (set i (+ i 5))))
    (emit-ascii out "]")
    (return 0)))
