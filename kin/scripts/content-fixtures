;; ---------------------------------------------------------------------------------- fonts.pdf

(def fonts-lines
  (for [i (range 18)] [(keyword (str "F" (inc (mod i 6)))) (str (char (+ 65 i)) "x" i)]))

(def fonts-ops
  (concat [[:BT] [:TL 14] [:Td 10 280]]
          (mapcat (fn [[f s]] [[:Tf f 10] [:Tj s] [:T*]]) fonts-lines)
          [[:Tf :T0 12] [:Tj "\u0000\u0001\u0000\u0002\u0000\u0010\u0000\u0011\u0000\u0012\u0000\u0003"] [:T*]
           [:Tf :T3 10] [:Tj "abab"] [:ET]]))

(def fonts-text
  (str (apply str (map second fonts-lines)) "A" "BC" "abc" "�" "abab"))

(defn fonts-pdf []
  (let [tu (str "/CIDInit /ProcSet findresource begin 12 dict begin begincmap\n"
                "/CMapName /Adobe-Identity-UCS def /CMapType 2 def\n"
                "1 begincodespacerange <0000> <FFFF> endcodespacerange\n"
                "2 beginbfchar <0001> <0041> <0002> <00420043> endbfchar\n"
                "1 beginbfrange <0010> <0012> <0061> endbfrange\n"
                "endcmap CMapName currentdict /CMap defineresource pop end end")]
    (build-pdf
     (merge
      {1 "<< /Type /Catalog /Pages 2 0 R >>"
       2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
       3 (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 300 300] /Resources << /Font << "
              (str/join " " (for [i (range 1 7)] (str "/F" i " " (+ 10 i) " 0 R")))
              " /T0 20 0 R /T3 24 0 R >> >> /Contents 4 0 R >>")
       4 (stream "" (content fonts-ops))
       20 "<< /Type /Font /Subtype /Type0 /BaseFont /Test /Encoding /Identity-H /DescendantFonts [21 0 R] /ToUnicode 23 0 R >>"
       21 "<< /Type /Font /Subtype /CIDFontType2 /BaseFont /Test /CIDSystemInfo << /Registry (Adobe) /Ordering (Identity) /Supplement 0 >> /FontDescriptor 22 0 R /DW 500 /W [1 [600 700] 16 18 400] >>"
       22 "<< /Type /FontDescriptor /FontName /Test /Flags 4 /FontBBox [0 -200 1000 800] /Ascent 800 /Descent -200 /ItalicAngle 0 /StemV 80 >>"
       23 (stream "" tu)
       24 (str "<< /Type /Font /Subtype /Type3 /FontBBox [0 -20 60 80] /FontMatrix [0.01 0 0 0.01 0 0] /CharProcs << /a 25 0 R /b 25 0 R >> "
               "/Encoding << /Type /Encoding /Differences [97 /a /b] >> /FirstChar 97 /LastChar 98 /Widths [50 60] >>")
       25 (stream "" "50 0 0 0 50 80 d1 0 0 50 80 re f")}
      (std-font-objs)))))

;; --------------------------------------------------------------------------------- inline.pdf

(defn inline-pdf []
  (build-pdf
   (merge
    {1 "<< /Type /Catalog /Pages 2 0 R >>"
     2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
     3 "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Resources << /Font << /F1 11 0 R >> >> /Contents 4 0 R >>"
     4 (stream "" (str "BT /F1 10 Tf 10 150 Td (before) Tj ET\n"
                       "q 50 0 0 50 10 50 cm BI /W 4 /H 2 /CS /G /BPC 8 ID \u0001 EI \u0002\u0003\u0004\u0005\u0006\u0007 EI\nQ\n"
                       "BT /F1 10 Tf 10 20 Td (after) Tj ET\n"))}
    {11 (font-obj "Helvetica")})))

;; -------------------------------------------------------------------------------- damaged.pdf

;; ----------------------------------------------------------------------------------- deep.pdf
;; limits: 300 nested marked-content sequences (256 are kept), 300 q (256 kept), a chain of 40
;; Form XObjects (32 run)

(defn deep-pdf []
  (build-pdf
   (merge
    {1 "<< /Type /Catalog /Pages 2 0 R >>"
     2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
     3 (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Resources << /Font << /F1 11 0 R >> /XObject << /X1 20 0 R >> >> /Contents 4 0 R >>")
     4 (stream "" (str (apply str (repeat 300 "/A BMC ")) "BT /F1 10 Tf 10 100 Td (x) Tj ET " (apply str (repeat 300 "EMC "))
                       "\n" (apply str (repeat 300 "q ")) (apply str (repeat 300 "Q "))
                       "\nBT /F1 10 Tf 10 50 Td (y) Tj ET /X1 Do\n"))
     11 (font-obj "Helvetica")}
    (into {} (for [i (range 1 41)]
               [(+ 19 i) (stream (str "/Type /XObject /Subtype /Form /BBox [0 0 10 10] /Resources << /Font << /F1 11 0 R >>"
                                      (when (< i 40) (str " /XObject << /X" (inc i) " " (+ 20 i) " 0 R >>")) " >>")
                                 (str "BT /F1 4 Tf 1 1 Td (f) Tj ET" (when (< i 40) (str " /X" (inc i) " Do"))))])))))

(defn damaged-pdf []
  (build-pdf
   {1 "<< /Type /Catalog /Pages 2 0 R >>"
    2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
    3 "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 200] /Resources << /Font << /F1 11 0 R >> >> /Contents 4 0 R >>"
    4 (stream "" (str "BT /F1 10 Tf 10 180 Td (ok) Tj\n"
                      "(a(b)c) Tj\n"
                      "[(a) 50 (b) TJ\n"
                      "Tj\n"
                      "/Nope 9 Tf (nofont) Tj\n"
                      "/F1 10 Tf <4142 4> Tj\n"
                      "<< /A [1 2 << /B (x) >> >> BDC\n"
                      "99999999999999999999 99999999999999999999 Td (big) Tj\n"
                      "-- 5 - . .5. 5.. Td 1 2 3 4 5 6 7 8 9 Tm (junk) Tj\n"
                      "ET q q q Q Q Q Q Q\n"
                      "BT (tail"))
    11 (font-obj "Helvetica")}))

;; ---------------------------------------------------------------------------------- the rows

(defn round-half-up [x] (long (Math/floor (+ (double x) 0.5))))
(defn row-g [g]
  (str/join "\t" ["G" (if (:cp g) (format "%04X" (:cp g)) "-")
                  (round-half-up (:x0 g)) (round-half-up (:y0 g)) (round-half-up (:x1 g)) (round-half-up (:y1 g))
                  (round-half-up (:base g)) (round-half-up (:size g)) (:rot g) (:mode g)]))

(defn g-section [file gs & extra]
  (str "F\tcontent/" file "\n" (str/join "" (map #(str (row-g %) "\n") gs)) (str/join "" (map #(str % "\n") extra))))

(defn tabs [& xs] (str/join "\t" xs))

(defn generate []
  (let [media [0 0 200 300]
        ops-g (glyph-rows ops-ops {:fonts fonts :crop media :rot 0})
        rot-g (mapcat (fn [r] (glyph-rows rotate-ops {:fonts fonts :crop [10 20 190 280] :rot r})) [0 90 180 270])
        forms-g (glyph-rows forms-page-ops
                            {:fonts fonts :crop media :rot 0
                             :forms {:Fm1 (:Fm1 forms-spec) :Fm2 (:Fm2 forms-spec) :Fm3 (:Fm3 forms-spec)}})
        fonts-g (glyph-rows fonts-ops {:fonts fonts :crop [0 0 300 300] :rot 0})
        files {"ops.pdf" (simple-pdf media ops-ops)
               "rotate.pdf" (rotate-pdf)
               "deep.pdf" (deep-pdf)
               "forms.pdf" (forms-pdf)
               "marked.pdf" (marked-pdf)
               "fonts.pdf" (fonts-pdf)
               "inline.pdf" (inline-pdf)
               "damaged.pdf" (damaged-pdf)}
        rows (str "# emon P1.7: what the content interpreter must make of test/content/*.pdf.\n"
                  "# Written by kin/scripts/content-fixtures (bb); do not edit.\n"
                  "# F file: the rows after it are about that file.\n"
                  "# G: code point (hex, - none), box, baseline, size (centipoints), rotation (centi-degrees), render mode.\n"
                  "#    Computed by the script's exact-rational evaluator; kin holds the interpreter to them within 1.\n"
                  "# N: glyphs, words, spans, warning bits.   W: a word's text.   C: the glyphs' text, in order.\n"
                  "# S: span index, tag, MCID, artifact, type, subtype, ActualText, Alt, E, Lang, first glyph, glyphs, flags, stm, parent.\n"
                  (g-section "ops.pdf" ops-g
                             (tabs "N" (count ops-g) (count ops-words) 0 0)
                             (str/join "" (map #(str (tabs "W" %) "\n") ops-words)))
                  (g-section "rotate.pdf" rot-g (tabs "N" (count rot-g) "-" 0 0))
                  (g-section "forms.pdf" forms-g
                             (tabs "N" (count forms-g) "-" 0 16)
                             (tabs "C" (str/join "" (map #(String. (Character/toChars (:cp %))) forms-g))))
                  (g-section "fonts.pdf" fonts-g
                             (tabs "N" (count fonts-g) "-" 0 0)
                             (tabs "C" fonts-text))
                  (str "F\tcontent/marked.pdf\n"
                       (tabs "N" 64 "-" 17 576) "\n"
                       (tabs "C" "HelloAbCHeadDRAFTrulebackFootedgefiglostMrafteropencafeinformunt") "\n"
                       (str/join "" (map #(str (apply tabs "S" %) "\n") marked-spans)))
                  (str "F\tcontent/deep.pdf\n" (tabs "N" 34 "-" 256 112) "\n")
                  (str "F\tcontent/inline.pdf\n" (tabs "N" 11 "-" 0 0) "\n" (tabs "C" "beforeafter") "\n")
                  (str "F\tcontent/damaged.pdf\n" (tabs "N" 25 "-" 1 996) "\n"
                       (tabs "C" (str "oka(b)cab" (apply str (repeat 6 "�")) "AB@bigjunk")) "\n"))]
    {:files files :rows rows}))

(defn -main [args]
  (let [{:keys [files rows]} (generate)
        check? (some #{"--check"} args)
        outs (assoc (into {} files) "rows.txt" (.getBytes ^String rows "UTF-8"))]
    (.mkdirs (io/file out-dir))
    (if check?
      (let [bad (for [[k v] outs :let [f (io/file out-dir k)]
                      :when (not (and (.exists f) (java.util.Arrays/equals ^bytes v ^bytes (java.nio.file.Files/readAllBytes (.toPath f)))))]
                  k)]
        (if (seq bad)
          (do (println "  FAIL content-fixtures: stale" (str/join " " bad) "-- run kin/scripts/content-fixtures") (System/exit 1))
          (println "  ok   content-fixtures:" (count files) "PDFs and rows.txt are what the script writes")))
      (doseq [[k v] outs]
        (with-open [o (io/output-stream (io/file out-dir k))] (.write o ^bytes v))
        (println "wrote" (str "test/content/" k))))))

(-main *command-line-args*)
