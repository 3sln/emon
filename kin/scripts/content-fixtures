;; -------------------------------------------------------------------------------- rotate.pdf

(def rotate-ops [[:BT] [:Tf :F1 12] [:Td 50 100] [:Tj "Ab"] [:Td 0 20] [:Tf :F2 9] [:Tj "Turned"] [:ET]])

(defn rotate-pdf []
  (build-pdf
   (merge
    {1 "<< /Type /Catalog /Pages 2 0 R >>"
     2 "<< /Type /Pages /Kids [3 0 R 5 0 R 6 0 R 7 0 R] /Count 4 >>"
     4 (stream "" (content rotate-ops))}
    (into {} (for [[n r] [[3 0] [5 90] [6 180] [7 270]]]
               [n (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 300] /CropBox [10 20 190 280] "
                       (when (pos? r) (str "/Rotate " r " "))
                       "/Resources " fonts-res " /Contents 4 0 R >>")]))
    (std-font-objs))))

;; ---------------------------------------------------------------------------------- forms.pdf

(def forms-spec
  {:Fm1 {:matrix [1 0 0 1 3 4] :ops [[:BT] [:Tf :F2 10] [:Td 0 0] [:Tj "Fm"] [:ET] [:Do :Fm2] [:Do :Fm3]]}
   :Fm2 {:matrix [2 0 0 2 0 20] :ops [[:BT] [:Tf :F1 6] [:Td 0 0] [:Tj "N"] [:ET]]}
   :Fm3 {:matrix [1 0 0 1 0 40] :ops [[:BT] [:Tf :F3 6] [:Tj "C"] [:ET] [:Do :Fm3]]}})

(def forms-page-ops
  [[:q] [:cm 2 0 0 2 10 10] [:Do :Fm1] [:Q] [:Do :Fm1] [:Do :Im1]
   [:BT] [:Tf :F1 10] [:Td 5 5] [:Tj "P"] [:ET]])

(defn forms-pdf []
  (build-pdf
   (merge
    {1 "<< /Type /Catalog /Pages 2 0 R >>"
     2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
     3 (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 200 300] /Resources << /Font << /F1 11 0 R /F2 12 0 R /F3 13 0 R >> "
            "/XObject << /Fm1 5 0 R /Im1 8 0 R >> >> /Contents 4 0 R >>")
     4 (stream "" (content forms-page-ops))
     5 (stream (str "/Type /XObject /Subtype /Form /BBox [0 0 100 100] /Matrix [1 0 0 1 3 4] /Resources << /Font << /F2 12 0 R /F1 11 0 R /F3 13 0 R >> "
                    "/XObject << /Fm2 6 0 R /Fm3 7 0 R >> >>")
               (content (:ops (:Fm1 forms-spec))))
     6 (stream "/Type /XObject /Subtype /Form /BBox [0 0 100 100] /Matrix [2 0 0 2 0 20]"
               (content (:ops (:Fm2 forms-spec))))
     7 (stream "/Type /XObject /Subtype /Form /BBox [0 0 100 100] /Matrix [1 0 0 1 0 40] /Resources << /Font << /F3 13 0 R >> /XObject << /Fm3 7 0 R >> >>"
               (content (:ops (:Fm3 forms-spec))))
     8 (stream "/Type /XObject /Subtype /Image /Width 1 /Height 1 /ColorSpace /DeviceGray /BitsPerComponent 8" "\u0000")}
    (std-font-objs))))

