(defn marked-pdf []
  (build-pdf
   {1 "<< /Type /Catalog /Pages 2 0 R >>"
    2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
    3 (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 300 300] /Resources << /Font << /F1 11 0 R >> "
           "/Properties << /MC0 5 0 R >> /XObject << /Fm1 6 0 R >> >> /Contents 4 0 R >>")
    4 (stream "" marked-page)
    5 "<< /MCID 5 /Alt (A picture) /E (expanded) /Lang (de) >>"
    6 (stream "/Type /XObject /Subtype /Form /BBox [0 0 100 100] /Resources << /Font << /F1 11 0 R >> >>"
              "BT /F1 10 Tf /Span <</MCID 3>> BDC (inform) Tj EMC /Artifact BMC (unt) Tj ET")
    11 (font-obj "Helvetica")}))

