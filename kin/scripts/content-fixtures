  (str/join "\n"
    ["BT /F1 10 Tf 20 280 Td"
     "/P <</MCID 0>> BDC (Hello) Tj EMC"
     "/Span <</MCID 1 /Lang (en-US) /ActualText (\\376\\377\\000f\\000i\\000 \\000t\\000e\\000x\\000t)>> BDC (A)Tj"
     "/Artifact BMC (b) Tj EMC (C) Tj EMC"
     "/Artifact <</Type /Pagination /Subtype /Header>> BDC (Head) Tj EMC"
     "/Artifact <</Type /Pagination /Subtype /Watermark>> BDC (DRAFT) Tj EMC"
     "/Artifact <</Type /Layout>> BDC (rule) Tj EMC"
     "/Artifact <</Type /Background>> BDC (back) Tj EMC"
     "/Artifact <</Type /Pagination /Subtype /Footer>> BDC (Foot) Tj EMC"
     "/Artifact <</Type /Page>> BDC (edge) Tj EMC"
     "/Figure /MC0 BDC (fig) Tj EMC"
     "/Span /MC9 BDC (lost) Tj EMC"
     "/Span <</MCID 7 /Alt (\\200 bullet) /E (Mister) /Lang (fr)>> BDC (Mr) Tj EMC"
     "EMC (after) Tj"
     "/H1 <</MCID 8>> BDC (open) Tj EMC"
