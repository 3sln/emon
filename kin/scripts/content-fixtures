   [:quote "third line"] [:dquote 2 1 "fourth"] [:ET]
   [:BT] [:Tf :F3 8] [:Tc 0.5] [:Td 20 170] [:Tj "char spaced"] [:Tw 10] [:Td 0 -12] [:Tj "word spaced out"] [:Tc 0] [:Tw 0] [:ET]
   [:BT] [:Tf :F1 10] [:Tz 50] [:Td 20 140] [:Tj "squeezed"] [:Tz 200] [:Td 0 -12] [:Tj "wide"] [:Tz 100] [:ET]
   [:BT] [:Tf :F1 10] [:Td 20 100] [:Tj "rise"] [:Ts 4] [:Tj "up"] [:Ts -3] [:Tj "down"] [:Ts 0] [:ET]
   [:BT] [:Tf :F2 11] [:Td 20 80] [:TJ ["Kern" -120 "ed" -300 "text"]] [:ET]
