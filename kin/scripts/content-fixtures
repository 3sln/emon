#!/usr/bin/env bb
;; Write the content-interpreter fixtures and their expectations (DEVLOG P1.7).
;;
;;     kin/scripts/content-fixtures            write test/content/*.pdf and rows.txt
;;     kin/scripts/content-fixtures --check    fail if the committed files are not what this writes
;;
;; A DEVELOPMENT SCRIPT that `bb unit` also runs with --check, like the other fixture writers.
;; Nothing here is emon: it is a SECOND, INDEPENDENT READER OF THE CONTENT STREAMS.
;;
;;   * A tiny PDF writer (objects, a classic cross-reference table) makes seven small files.
;;   * `glyph-rows` is a reference evaluator of the text operators in EXACT RATIONAL arithmetic
;;     (Clojure ratios, no fixed point), written from ISO 32000-1 9.3-9.4, with the page turned a
;;     QUARTER AT A TIME (emon composes one base matrix instead). It knows the AFM widths of the
;;     standard fonts, read from test/fonts/*.afm.
;;   * What it computes becomes the G rows of test/content/rows.txt (one per glyph: code point,
;;     box, baseline, size, rotation: centipoints and centi-degrees); kin/pdfcontenttest.kin
;;     holds the generated interpreter to them within one centipoint (the fixed point's own
;;     rounding).
;;   * The S (span), W (word), C (text) and N (count) rows are written out below BY HAND, from what
;;     each operator says; no evaluator made them.
;;
;; THE FIXTURES (test/content/):
;;   ops.pdf       every text operator: Tc Tw Tz Ts TL Td TD T* ' " TJ Tm, q Q cm, render modes
;;   rotate.pdf    the same text on four pages /Rotate 0 90 180 270 with a crop box off the origin
;;   forms.pdf     Form XObjects: /Matrix, /Resources, nesting, a cycle, an image skipped
;;   marked.pdf    every marked-content shape D076 asks for, balanced and not
;;   fonts.pdf     a composite font with a ToUnicode and /W, a Type 3 font, six simple fonts in
;;                 rotation (so the four font slots are replaced)
;;   inline.pdf    an inline image between two lines of text
;;   damaged.pdf   odd strings, arrays and dictionaries, junk, a missing font, stray Q and EMC
(require '[clojure.string :as str]
         '[clojure.java.io :as io])

(def root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getParentFile .getPath))
(def out-dir (str root "/test/content"))

;; ------------------------------------------------------------------ the PDF writer

(defn latin1 ^bytes [^String s] (.getBytes s "ISO-8859-1"))

(defn build-pdf
  "objs: {num body}. A body is a string (an object) or [:stream dict-string data-string]."
  [objs]
  (let [buf (java.io.ByteArrayOutputStream.)
        offs (atom {})
        w (fn [s] (.write buf (latin1 s)))]
    (w "%PDF-1.7\n%âãÏÓ\n")
    (doseq [n (sort (keys objs))]
      (swap! offs assoc n (.size buf))
      (let [b (objs n)]
        (w (str n " 0 obj\n"))
        (if (vector? b)
          (let [[_ dict data] b]
            (w (str "<< " dict " /Length " (count (latin1 data)) " >>\nstream\n"))
            (w data)
            (w "\nendstream"))
          (w b))
        (w "\nendobj\n")))
    (let [xref (.size buf)
          n (inc (apply max (keys objs)))]
      (w (str "xref\n0 " n "\n0000000000 65535 f \n"))
      (doseq [i (range 1 n)]
        (w (if-let [o (@offs i)] (format "%010d 00000 n \n" o) "0000000000 65535 f \n")))
      (w (str "trailer\n<< /Size " n " /Root 1 0 R >>\nstartxref\n" xref "\n%%EOF\n")))
    (.toByteArray buf)))

(defn stream [dict data] [:stream dict data])

;; ------------------------------------------------------------ the fonts' metrics

(defn afm [font]
  (let [lines (str/split-lines (slurp (str root "/test/fonts/" font ".afm")))
        widths (into {} (for [l lines :when (str/starts-with? l "C ")
                              :let [m (re-find #"^C (-?\d+) ; WX (\d+) ;" l)]
                              :when (and m (>= (parse-long (m 1)) 0))]
                          [(parse-long (m 1)) (parse-long (m 2))]))
        num (fn [k] (some (fn [l] (when-let [m (re-find (re-pattern (str "^" k " (-?\\d+)")) l)] (parse-long (m 1)))) lines))]
    {:widths widths :asc (num "Ascender") :desc (num "Descender")}))

(def fonts
  {:F1 (assoc (afm "Helvetica") :base "Helvetica")
   :F2 (assoc (afm "Times-Roman") :base "Times-Roman")
   :F3 (assoc (afm "Courier") :base "Courier")
   :F4 (assoc (afm "Helvetica-Bold") :base "Helvetica-Bold")
   :F5 (assoc (afm "Times-Bold") :base "Times-Bold")
   :F6 (assoc (afm "Courier-Bold") :base "Courier-Bold")
   ;; the composite font of fonts.pdf: 2-byte codes, widths from /W, else /DW; ToUnicode's values
   :T0 {:bytes 2 :dw 500 :widths {1 600, 2 700, 16 400, 17 400, 18 400} :asc 800 :desc -200
        :cps {1 0x41, 2 0x42, 16 0x61, 17 0x62, 18 0x63}}
   ;; the Type 3 font: widths times the FontMatrix's 0.01, the cell from /FontBBox times it
   :T3 {:widths {97 500, 98 600} :asc 800 :desc -200}})

;; ------------------------------------------------------------ matrices, exactly

(defn mm [[a b c d e f] [a2 b2 c2 d2 e2 f2]]
  [(+ (* a a2) (* b c2)) (+ (* a b2) (* b d2))
   (+ (* c a2) (* d c2)) (+ (* c b2) (* d d2))
   (+ (* e a2) (* f c2) e2) (+ (* e b2) (* f d2) f2)])

(defn pt [[a b c d e f] x y] [(+ (* a x) (* c y) e) (+ (* b x) (* d y) f)])

(def ident [1 0 0 1 0 0])

(defn page-point
  "User space (points) to page space (centipoints, y down) for a crop box and a rotation: the crop
  box's corner to the origin, then a quarter turn clockwise at a time, then y flipped."
  [[cx0 cy0 cx1 cy1] rot [x y]]
  (loop [px (- x cx0) py (- y cy0) w (- cx1 cx0) h (- cy1 cy0) k (quot rot 90)]
    (if (zero? k)
      [(* 100 px) (* 100 (- h py))]
      ;; a quarter turn clockwise about the origin of a y-up page w x h: (x y) -> (y, w - x), size h x w
      (recur py (- w px) h w (dec k)))))

;; --------------------------------------------------------- the reference evaluator

(defn glyph-rows
  "Run a vector of [op & operands] and answer the glyphs as maps."
  [ops {:keys [crop rot fonts forms]}]
  (let [glyphs (atom [])
        active (atom #{})
        o (page-point crop rot [0 0]) px (page-point crop rot [1 0]) py (page-point crop rot [0 1])
        base-m [(- (px 0) (o 0)) (- (px 1) (o 1)) (- (py 0) (o 0)) (- (py 1) (o 1)) (o 0) (o 1)]
        init {:ctm base-m :tc 0 :tw 0 :th 1 :tl 0 :rise 0 :fs 0 :font nil :mode 0 :tm ident :tlm ident}]
    (letfn [(show-code [st fdef code]
              (let [w (/ (get (:widths fdef) code (or (:dw fdef) 0)) 1000)
                    {:keys [fs th tc tw rise tm ctm]} st
                    m (mm tm ctm)
                    x1 (* w fs th)
                    y0 (+ (* (/ (:desc fdef) 1000) fs) rise)
                    y1 (+ (* (/ (:asc fdef) 1000) fs) rise)
                    pts (map (fn [[x y]] (pt m x y)) [[0 y0] [x1 y0] [0 y1] [x1 y1]])
                    xs (map first pts) ys (map second pts)
                    [ma mb mc md] m
                    size (* (Math/abs (double fs)) (Math/sqrt (double (+ (* mc mc) (* md md)))))
                    rotd (mod (Math/round (* 100 (Math/toDegrees (Math/atan2 (double (- mb)) (double ma))))) 36000)
                    adv (+ (* w fs) tc (if (and (= code 32) (not (:bytes fdef))) tw 0))]
                (swap! glyphs conj {:cp (if (:cps fdef) (get (:cps fdef) code) code)
                                    :x0 (apply min xs) :y0 (apply min ys) :x1 (apply max xs) :y1 (apply max ys)
                                    :base (second (pt m 0 rise)) :size size :rot rotd :mode (:mode st)})
                (update st :tm #(mm [1 0 0 1 (* adv th) 0] %))))
            (show-str [st s]
              (let [fdef (get fonts (:font st))
                    n (or (:bytes fdef) 1)]
                (reduce (fn [st chunk] (show-code st fdef (reduce (fn [a c] (+ (* a 256) (int c))) 0 chunk)))
                        st (partition n s))))
            (show-arr [st xs]
              (reduce (fn [st x]
                        (if (number? x)
                          (update st :tm #(mm [1 0 0 1 (* (- (/ x 1000)) (:fs st) (:th st)) 0] %))
                          (show-str st x)))
                      st xs))
            (td [st tx ty]
              (let [tlm (mm [1 0 0 1 tx ty] (:tlm st))] (assoc st :tlm tlm :tm tlm)))
            (run [st ops]
              (reduce
               (fn [{:keys [stack] :as st} [op & a]]
                 (case op
                   :q (assoc st :stack (conj (or stack []) (dissoc st :stack)))
                   :Q (if (seq stack) (assoc (peek stack) :stack (pop stack)) st)
                   :cm (assoc st :ctm (mm (vec a) (:ctm st)))
                   :BT (assoc st :tm ident :tlm ident)
                   :ET st
                   :Tf (assoc st :font (first a) :fs (second a))
                   :Tc (assoc st :tc (first a))
                   :Tw (assoc st :tw (first a))
                   :Tz (assoc st :th (/ (first a) 100))
                   :TL (assoc st :tl (first a))
                   :Ts (assoc st :rise (first a))
                   :Tr (assoc st :mode (first a))
                   :Td (td st (first a) (second a))
                   :TD (td (assoc st :tl (- (second a))) (first a) (second a))
                   :Tm (assoc st :tm (vec a) :tlm (vec a))
                   :T* (td st 0 (- (:tl st)))
                   :Tj (show-str st (first a))
                   :TJ (show-arr st (first a))
                   :quote (show-str (td st 0 (- (:tl st))) (first a))
                   :dquote (show-str (td (assoc st :tw (first a) :tc (second a)) 0 (- (:tl st))) (nth a 2))
                   :Do (let [f (get forms (first a))]
                         (when (and f (not (@active (first a))))
                           (swap! active conj (first a))
                           (run (assoc st :stack [] :ctm (mm (:matrix f) (:ctm st))) (:ops f))
                           (swap! active disj (first a)))
                         st)
                   st))
               st ops))]
      (run init ops)
      @glyphs)))

;; ----------------------------------------------------------------------- writing content

(defn printable? [s] (every? #(<= 32 (int %) 126) s))
(defn lit [s] (if (printable? s)
                (str "(" (-> s (str/replace "\\" "\\\\") (str/replace "(" "\\(") (str/replace ")" "\\)")) ")")
                (str "<" (apply str (map #(format "%02X" (int %)) s)) ">")))
(defn num* [x] (if (integer? x) (str x) (str/replace (format "%.6f" (double x)) #"\.?0+$" "")))

(defn op->text [[op & a]]
  (let [opn (get {:quote "'" :dquote "\"" :T* "T*"} op (name op))
        arg (fn [x] (cond (string? x) (lit x)
                          (keyword? x) (str "/" (name x))
                          (vector? x) (str "[" (str/join " " (map #(if (string? %) (lit %) (num* %)) x)) "]")
                          :else (num* x)))]
    (str (str/join " " (map arg a)) (when (seq a) " ") opn)))

(defn content [ops] (str/join "\n" (map op->text ops)))

(defn font-obj [base]
  (str "<< /Type /Font /Subtype /Type1 /BaseFont /" base " /Encoding /WinAnsiEncoding >>"))

(defn std-font-objs [] (into {} (for [i (range 1 7)] [(+ 10 i) (font-obj (:base (fonts (keyword (str "F" i)))))])))

(def fonts-res
  (str "<< /Font << " (str/join " " (for [i (range 1 7)] (str "/F" i " " (+ 10 i) " 0 R"))) " >> >>"))

(defn simple-pdf [media ops]
  (build-pdf
   (merge
    {1 "<< /Type /Catalog /Pages 2 0 R >>"
     2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
     3 (str "<< /Type /Page /Parent 2 0 R /MediaBox [" (str/join " " media) "] /Resources " fonts-res " /Contents 4 0 R >>")
     4 (stream "" (content ops))}
    (std-font-objs))))

