#!/usr/bin/env bb
;; Write the paragraph stage's goldens from the generated Rust (DEVLOG P1.8).
;;
;;     kin/scripts/para-goldens            write test/para/NAME.json (pretty canonical JSON) for each document below
;;
;; A DEVELOPMENT SCRIPT, run by a person after the stage changed on purpose; no gate runs it. The laws in
;; `kin/paratest.kin` hold every target to what this wrote (PDF -> content -> paragraphs -> Model -> JSON,
;; byte for byte), and `kin/scripts/para-check` holds the goldens to the source HTML: what makes a golden of
;; kin's own output worth anything. The driver is the Engine's, `emon-rs` (`test/driver/rust/main.rs`, built by
;; `kin/scripts/emon-rs-build`; the temporary `predict-naive.sh` it replaced is retired, D144).
;;
;; THE DOCUMENTS are the Chrome-printed synthetic ones whose paragraphs and headings are all there is on the
;; page (single column or columns, no list or table the naive stage would have to guess at): the paragraphs the
;; stage writes are exactly the HTML's `<h1>`..`<h6>` and `<p>`, in order. The initials documents are here since P4.10
;; (D167): an initial is joined to its first word, so the paragraph's text is still the HTML's; `initial-firstletter` is
;; not (`A long` and `Along` are the same page, SPEC 10.9: without a locale the join is `Along`).
(require '[clojure.java.io :as io]
         '[clojure.java.shell :as sh]
         '[clojure.string :as str])

(def root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getParentFile .getPath))

(def docs ["h-plain" "h-keyword" "h-inverted-numbered" "h-numbered" "initial-image" "initial-vector"
           "initial-raised" "initial-firstword" "initial-columns" "initial-rtl" "furn-informative"])

(defn run [& args]
  (let [r (apply sh/sh (concat args [:dir root]))]
    (when-not (zero? (:exit r)) (println (:err r)) (System/exit 1))
    (:out r)))

;; builds the driver when gen/ or host/ changed (predict-emon.sh's stamp), by asking it for a document
(run "sh" "tools/accuracy/predict-emon.sh" "x" "pdf" "test/corpus/synth/pdf/h-plain.pdf" "x")

(.mkdirs (io/file root "test" "para"))
(doseq [d docs]
  (let [out (run ".cache/emon-rs/target/release/emon-rs" "--pretty" (str "test/corpus/synth/pdf/" d ".pdf"))]
    (spit (io/file root "test" "para" (str d ".json")) (str out "\n") :encoding "UTF-8")
    (println "  wrote test/para/" (str d ".json") (count out) "bytes")))

;; THE ONE LITERAL (D470's open item, closed by D488): `paratest`'s "a paragraph on two pages, in JSON" holds the whole JSON as a string, with the
;; paragraph's calibrated `conf`. That conf is set here to the one `h-plain` has on its paragraphs (just written above; the same raw confidence, the same
;; calibdata row), so a refit needs no hand edit. On a tree that is consistent this changes nothing.
(let [h (slurp (io/file root "test" "para" "h-plain.json") :encoding "UTF-8")
      ;; pretty JSON: a node's `kind` precedes its `conf`, at the same indent
      confs (loop [ls (str/split-lines h) kinds {} acc #{}]
              (if-let [l (first ls)]
                (if-let [[_ ind k] (re-matches #"(\s*)\"kind\": \"(\w+)\",?" l)]
                  (recur (rest ls) (assoc kinds (count ind) k) acc)
                  (if-let [[_ ind n] (re-matches #"(\s*)\"conf\": (\d+),?" l)]
                    (recur (rest ls) kinds (if (= "paragraph" (get kinds (count ind))) (conj acc n) acc))
                    (recur (rest ls) kinds acc)))
                acc))
      f (io/file root "kin" "paratest.kin")
      src (slurp f :encoding "UTF-8")
      lit #"(\\\"src\\\":\[\\\"text\\\",\\\"infer\\\"\],\\\"conf\\\":)\d+(\}\]\},\\\"furniture\\\":\[\],\\\"dropped\\\":\[\]\}\" \"a paragraph on two pages, in JSON\")"]
  (when-not (= 1 (count confs)) (println "FAIL h-plain has paragraphs of the confidences" (pr-str confs)) (System/exit 1))
  (when-not (re-find lit src) (println "FAIL kin/paratest.kin: the literal of `a paragraph on two pages, in JSON` is not where para-goldens looks for it") (System/exit 1))
  (let [new (str/replace src lit (str "$1" (first confs) "$2"))]
    (spit f new :encoding "UTF-8")
    (println "  paratest literal conf" (first confs))))
