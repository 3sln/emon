#!/bin/sh
# Build the REPLAY driver of a plan gate for the Java or the C# host; print its path.   kin/scripts/emon-plandrv-build java|csharp render|align
#
# `bb render` and `bb align` replay a transcript through a small test driver of each host (test/render/<host>, test/fusion/align/<host>): the unit
# asks for the gate's requests (renders and crops; or the `emon.alignprobe` unit) and the driver prints one dump, which the gate compares across hosts
# (DEVLOG P6.2, P7.1; the Java and C# drivers are P9.5, D1240). They are built over the host's own library tree, the one `emon-java-build` and
# `emon-cs-build` assemble (those scripts are run first), plus the driver and, for `align`, the generated `Alignprobe` (a probe, which the library
# tree leaves out):
#
#     java    .cache/emon-java-plan/TOOL/{*.class,drv}      javac against .cache/emon-java/classes; `drv` is the launcher
#     csharp  .cache/emon-cs-plan-TOOL/{drv.csproj,out/,drv} the project includes .cache/emon-cs/src/{gen,host} by path; `drv` is the launcher
#
# WITHOUT THE TOOLCHAIN THIS SKIPS LOUDLY exactly as the host's own build script does (its `SKIP ... -- why` on stderr, exit 3); a build failure is exit 1.
set -e
cd "$(dirname "$0")/../.."
host=$1
tool=$2
case "$tool" in
  render) srcdir=test/render ;;
  align) srcdir=test/fusion/align ;;
  *) echo "usage: emon-plandrv-build java|csharp render|align" >&2; exit 2 ;;
esac
root=$(pwd)
case "$host" in
  java)
    kin/scripts/emon-java-build > /dev/null || exit $?
    JDK="${EMON_JDK:-/opt/homebrew/opt/openjdk}"
    [ -x "$JDK/bin/javac" ] || JDK=$(/usr/libexec/java_home 2>/dev/null || true)
    out=.cache/emon-java-plan/$tool
    rm -rf "$out"
    mkdir -p "$out"
    extra=""
    [ "$tool" = align ] && extra="gen/java/emon/Alignprobe.java"
    msg=$("$JDK/bin/javac" -encoding UTF-8 -nowarn -cp .cache/emon-java/classes -d "$out" $extra "$srcdir/java/Main.java" 2>&1) || { echo "$msg" | head -60 >&2; echo "emon-plandrv-build: the Java $tool driver did not compile" >&2; exit 1; }
    cat > "$out/drv" <<LAUNCHER
#!/bin/sh
# Generated by kin/scripts/emon-plandrv-build: the Java $tool replay driver.
exec "$JDK/bin/java" -XX:+UseSerialGC -Djava.awt.headless=true -cp "$root/$out:$root/.cache/emon-java/classes" Main "\$@"
LAUNCHER
    chmod +x "$out/drv"
    echo "$out/drv"
    ;;
  csharp)
    kin/scripts/emon-cs-build > /dev/null || exit $?
    sdk=$(kin/scripts/dotnet-sdk)
    DOTNET=${sdk% *}
    major=${sdk##* }
    export DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 DOTNET_GENERATE_ASPNET_CERTIFICATE=false
    out=.cache/emon-cs-plan-$tool
    mkdir -p "$out"
    extra=""
    [ "$tool" = align ] && extra="<Compile Include=\"$root/gen/csharp/Emon/Alignprobe.cs\" />"
    cat > "$out/drv.csproj" <<PROJ
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net${major}.0</TargetFramework>
    <AssemblyName>drv</AssemblyName>
    <RootNamespace>emon</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <UseAppHost>false</UseAppHost>
    <NoWarn>\$(NoWarn);CS1717;CS0164;CS0162;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$root/.cache/emon-cs/src/gen/**/*.cs" />
    <Compile Include="$root/.cache/emon-cs/src/host/**/*.cs" />
    <Compile Include="$root/$srcdir/csharp/Program.cs" />
    $extra
  </ItemGroup>
</Project>
PROJ
    msg=$("$DOTNET" build "$out/drv.csproj" -c Release -o "$out/out" --nologo -v q -clp:NoSummary -p:UseSharedCompilation=true 2>&1) || { echo "$msg" | head -60 >&2; echo "emon-plandrv-build: the C# $tool driver did not build" >&2; exit 1; }
    cat > "$out/drv" <<LAUNCHER
#!/bin/sh
# Generated by kin/scripts/emon-plandrv-build: the C# $tool replay driver.
export DOTNET_TieredPGO=0 DOTNET_gcServer=0 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
exec "$DOTNET" "$root/$out/out/drv.dll" "\$@"
LAUNCHER
    chmod +x "$out/drv"
    echo "$out/drv"
    ;;
  *) echo "usage: emon-plandrv-build java|csharp render|align" >&2; exit 2 ;;
esac
