#!/usr/bin/env bb
;; Generate kin/trig.kin: the tables behind `ev-angle`, `ev-sin` and `ev-cos`
;; (DEVLOG P1.12, D096; SPEC 8.4.1).   kin/scripts/trigdata [--check]
;;
;; TWO TABLES, both from the double value rounded half away from zero (Math, the double
;; values of the JVM; a value within 1e-9 of a half would make two JVMs disagree, and none is):
;;   ev-atan      1025 rows, `atan(i / 1024)` in CENTI-DEGREES, i = 0..1024
;;   ev-sin-tab   9001 rows, `sin(c / 100 degrees)` in 16.16, c = 0..9000 centi-degrees
;; `emon.evidence` reduces any angle to these by octant and symmetry and adds nothing but
;; integer arithmetic, so the four targets agree. `bb drift` runs this with --check: nothing
;; is written, and a stale kin/trig.kin exits 1.
(require '[clojure.string :as str]
         '[clojure.java.io :as io])

(def root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getParentFile .getPath))
(def out-file (io/file root "kin" "trig.kin"))

(defn round-away [x]
  (long (if (neg? x) (- (Math/floor (+ (- x) 0.5))) (Math/floor (+ x 0.5)))))

(def atan-rows
  (vec (for [i (range 1025)]
         (round-away (* (Math/atan (/ i 1024.0)) (/ 18000.0 Math/PI))))))

(def sin-rows
  (vec (for [c (range 9001)]
         (round-away (* (Math/sin (* (/ c 100.0) (/ Math/PI 180.0))) 65536.0)))))

(defn block [xs per]
  (str/join "\n         " (map #(str/join " " %) (partition-all per xs))))

(def text
  (str ";; GENERATED by kin/scripts/trigdata -- do not edit.\n"
       ";;\n"
       ";; The tables behind `emon.evidence`'s `ev-angle`, `ev-sin` and `ev-cos` (P1.12, D096, SPEC 8.4.1):\n"
       ";; integer trigonometry that every target reads the same. Each value is the double result rounded\n"
       ";; half away from zero.\n"
       "(ns emon.trig\n"
       "  (:require [emon.lang :refer [I32]]\n"
       "            [kin.lang :refer [defdata]]))\n"
       "\n"
       ";; atan(i / 1024) in centi-degrees, i = 0..1024\n"
       "(defdata ^:pub ev-atan\n"
       "  :emitter kin.lang/flat-array\n"
       "  :data [" (block atan-rows 16) "]\n"
       "  :accessors {^I32 ev-atan-len [^I32 ignored]\n"
       "              ^I32 ev-atan-at [^I32 ignored ^I32 i]})\n"
       "\n"
       ";; sin(c / 100 degrees) in 16.16, c = 0..9000 centi-degrees\n"
       "(defdata ^:pub ev-sin-tab\n"
       "  :emitter kin.lang/flat-array\n"
       "  :data [" (block sin-rows 16) "]\n"
       "  :accessors {^I32 ev-sin-len [^I32 ignored]\n"
       "              ^I32 ev-sin-at [^I32 ignored ^I32 i]})\n"))

(if (some #{"--check"} *command-line-args*)
  (if (= text (slurp out-file))
    (println "  ok   kin/trig.kin is what kin/scripts/trigdata says")
    (do (println "  FAIL kin/trig.kin is not what kin/scripts/trigdata generates (re-run it and commit)")
        (System/exit 1)))
  (do (spit out-file text)
      (println "wrote kin/trig.kin:" (count atan-rows) "atan rows," (count sin-rows) "sin rows")))
