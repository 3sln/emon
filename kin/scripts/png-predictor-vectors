#!/usr/bin/env bb
;; The PNG predictor streams of the P10.3a law `test-png-predictors-for-each-pixel-size` in kin/pdffiltertest.kin
;; (D424): known pixels filtered by an implementation of RFC 2083 6 (every filter type in turn, for 1, 3 and 4 bytes a
;; pixel and a 1-bit image; a fixed java.util.Random seed, so the output is the hex in the law), unfiltered again by a second, row-at-a-time one as a check.
(defn paeth [a b c]
  (let [p (- (+ a b) c) pa (abs (- p a)) pb (abs (- p b)) pc (abs (- p c))]
    (cond (and (<= pa pb) (<= pa pc)) a (<= pb pc) b :else c)))

(defn predictor [t a b c] (case (int t) 0 0 1 a 2 b 3 (quot (+ a b) 2) 4 (paeth a b c)))

(defn filter-rows [img bpp types]
  (loop [rows img ts types prev (vec (repeat (count (first img)) 0)) out []]
    (if (empty? rows) out
        (let [row (vec (first rows)) t (first ts)]
          (recur (rest rows) (rest ts) row
                 (into (conj out t)
                       (for [i (range (count row))]
                         (bit-and 255 (- (row i) (predictor t (if (>= i bpp) (row (- i bpp)) 0) (prev i) (if (>= i bpp) (prev (- i bpp)) 0)))))))))))

(defn unfilter-rows [data rowb bpp]
  (loop [pos 0 prev (vec (repeat rowb 0)) out []]
    (if (>= pos (count data)) out
        (let [t (data pos)
              row (reduce (fn [row i]
                            (conj row (bit-and 255 (+ (data (+ pos 1 i))
                                                      (predictor t (if (>= i bpp) (row (- i bpp)) 0) (prev i) (if (>= i bpp) (prev (- i bpp)) 0))))))
                          [] (range rowb))]
          (recur (+ pos 1 rowb) row (into out row))))))

(defn hex [bs] (apply str (map #(format "%02x" (bit-and % 255)) bs)))

(let [rnd (java.util.Random. 11)]
  (doseq [[name rowb bpp cols types] [["gray 8-bit" 9 1 9 [0 1 2 3 4 4 3 2 1 0]]
                                      ["rgb 8-bit" 12 3 4 [4 3 2 1 0 1 4 3 2]]
                                      ["rgba 8-bit, 2 px" 8 4 2 [1 2 3 4 0]]
                                      ["1-bit, 12 columns" 2 1 12 [3 4 2 1 4 0]]]]
    (let [img (vec (for [_ types] (vec (for [_ (range rowb)] (if (.nextBoolean rnd) (.nextInt rnd 256) (+ 128 (.nextInt rnd 4)))))))
          f (filter-rows img bpp types)]
      (assert (= (vec (apply concat img)) (unfilter-rows f rowb bpp)) name)
      (println name "rowb" rowb "bpp" bpp "columns" cols "rows" (count types))
      (println "  in :" (hex f))
      (println "  out:" (hex (apply concat img))))))
