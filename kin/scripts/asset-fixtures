        spec {:w S :h T :bpc 8 :cs :cmyk :rows rows}]
    (image-pdf "cmyk8.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceCMYK/BitsPerComponent 8/Filter/FlateDecode") (deflate bs))
    (d-row! "cmyk8" "cmyk8.pdf" 5 spec))
  (let [rows (gen-rows 52 S T 3 8) bs (pack rows 8)
        spec {:w S :h T :bpc 8 :cs :rgb :rows rows}]
    ;; the profile is not a profile: kin reads /N and nothing else
    (image-pdf "icc-rgb.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/ICCBased 8 0 R]/BitsPerComponent 8/Filter/FlateDecode") (deflate bs)
               :extra {8 {:dict "/N 3" :stream (bytes-of "not a profile")}})
    (d-row! "icc-rgb" "icc-rgb.pdf" 5 spec)
    (image-pdf "cal-rgb.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/CalRGB<</WhitePoint[0.95 1 1.09]>>]/BitsPerComponent 8/Filter/FlateDecode") (deflate bs))
    (d-row! "cal-rgb" "cal-rgb.pdf" 5 spec))
  (let [rows (gen-rows 53 S T 1 8) bs (pack rows 8)
        spec {:w S :h T :bpc 8 :cs :gray :rows rows}]
    (image-pdf "icc-gray.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/ICCBased 8 0 R]/BitsPerComponent 8/Filter/FlateDecode") (deflate bs)
               :extra {8 {:dict "/N 1" :stream (bytes-of "not a profile")}})
