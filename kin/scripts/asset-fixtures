#!/usr/bin/env bb
;; Write P3.12's fixtures: PDFs whose image XObjects and inline images cover every case SPEC 10.11 and the P3.12 brief
;; list, and the rows that say what kin must make of each.   bb kin/scripts/asset-fixtures
;;
;; A DEVELOPMENT TOOL (babashka; needs ImageMagick 7 (`magick`), `pdfimages` (poppler) and `qpdf`), run by a person,
;; not a gate. The fixtures are COMMITTED so a test run needs none of them:
;;
;;   test/assets/*.pdf          one file a case (the encrypted copy is qpdf's)
;;   test/assets/src/*          the source JPEGs (ImageMagick's), the CCITT G4 strip (ImageMagick's TIFF) and the
;;                              JPEG 2000 codestream (ImageMagick's), as embedded
;;   test/assets/png/*.png      what each decoded case must look like, for eyes (ImageMagick writes them from the
;;                              expected RGBA; the committed rows hold the SHA-256 of that RGBA)
;;   test/assets/rows.txt       the rows kin/pdfimagetest.kin reads
;;   test/assets/version.txt    the tool versions
;;
;; EXPECTED PIXELS ARE THE GENERATOR'S, NOT kin'S. They are computed here from the source samples by the rules of
;; SPEC 10.11 in Clojure ratios (exact arithmetic, no integer shortcut shared with kin/pdfimage.kin): unpacking, 16 -> 8,
;; /Decode, the colour space, masks, /Matte, orientation and cut. A kin result is a SHA-256 of the RGBA8 row-major bytes
;; (gray as r = g = b; alpha 255 when the image has none). Poppler is the second opinion: every case whose rules poppler
;; shares (not CMYK, not /Matte, not masks: poppler does not apply them to `pdfimages` output) is extracted with
;; `pdfimages -png` and compared to the expectation (`magick compare -metric AE`, 0); every JPEG that passes through is
;; extracted with `pdfimages -all` and compared BYTE FOR BYTE with the file embedded.
;;
;;   rows (tab separated; # a comment)
;;   P name file obj pv-code                                the JPEG passthrough verdict (`pv`)
;;   D name file obj orient crop fill w h channels alpha sha the decoded pixels (crop: `-` or bx0,by0,bx1,by1,cx0,cy0,cx1,cy1,whole)
;;   R name file obj filter w h comps bpc k cols rows cflags where off len gwhere goff glen sha gsha   the decode-img request
;;   O a b c d code                                         a placement matrix (x1000, integers) and its orientation
;;   X name file obj class                                  an image whose colour space kin does not read (class 9)
;;   M name file n obj,x0,y0,x1,y1,skewed ...               the placements pc-document finds
;;   I name file obj n                                      an inline image: the n-th BI of content stream obj, as a D row
(require '[babashka.process :as p]
         '[babashka.fs :as fs]
         '[clojure.string :as str])
(import '[java.security MessageDigest]
        '[java.util.zip Deflater])

(def root (-> *file* java.io.File. .getCanonicalFile .getParentFile .getParentFile .getParent))
(def check? (boolean (some #{"--check"} *command-line-args*)))
(def committed (str root "/test/assets"))
(def out-dir (if check? (str (fs/create-temp-dir {:prefix "assetcheck"})) committed))
(when check?
  ;; --check regenerates into a temporary directory and compares every file with the committed one. The corpus was
  ;; written with one ImageMagick (its JPEG and PNG encoders are part of the bytes), so another version is a skip, said
  ;; aloud: a gate may skip a missing input, not pass quietly.
  (let [want (second (re-find #"ImageMagick (ImageMagick [^\s]+)" (str (slurp (str committed "/version.txt")))))
        have (second (re-find #"Version: (ImageMagick [^\s]+)" (str (:out (p/shell {:out :string :continue true} "magick" "-version")))))]
    (when (not= want have)
      (println (str "  SKIP asset-fixtures --check: the corpus was written with " want ", this machine has " (or have "no ImageMagick")))
      (System/exit 0))))
(fs/create-dirs (str out-dir "/src"))
(fs/create-dirs (str out-dir "/png"))
(defn path [& xs] (apply str out-dir "/" xs))

(defn sh [& args] (apply p/shell {:out :string :err :string :continue true :dir root} args))
(defn sh! [& args]
  (let [r (apply sh args)]
    (when-not (zero? (:exit r)) (throw (ex-info (str "failed: " (pr-str args) "\n" (:err r)) {})))
    r))
(defn bytes-of [s] (.getBytes ^String s "ISO-8859-1"))
(defn cat-bytes [& xs]
  (let [bo (java.io.ByteArrayOutputStream.)]
    (doseq [x xs] (.write bo ^bytes (if (string? x) (bytes-of x) x)))
    (.toByteArray bo)))
(defn ubytes [coll] (byte-array (map #(unchecked-byte (long %)) coll)))
(defn sha256-hex [^bytes bs]
  (apply str (map #(format "%02x" (bit-and 0xff %)) (.digest (MessageDigest/getInstance "SHA-256") bs))))
(defn hex [^bytes bs] (apply str (map #(format "%02x" (bit-and 0xff %)) bs)))

;; ------------------------------------------------------------------ source samples

(defn mix64 [z0]
  (let [z (unchecked-add z0 (unchecked-long 0x9E3779B97F4A7C15))
        z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 30)) (unchecked-long 0xBF58476D1CE4E5B9))
        z (unchecked-multiply (bit-xor z (unsigned-bit-shift-right z 27)) (unchecked-long 0x94D049BB133111EB))]
    (bit-xor z (unsigned-bit-shift-right z 31))))

(defn sample [seed x y c bpc]
  ;; deterministic, with the extremes (0 and the maximum) common enough to matter
  (let [m (dec (bit-shift-left 1 bpc))
        r (bit-and (mix64 (+ (* seed 1000003) (* x 7919) (* y 104729) (* c 15485863))) 0x7fffffff)
        k (mod r 11)]
    (cond (= k 0) 0 (= k 1) m :else (mod (quot r 11) (inc m)))))

(defn gen-rows [seed w h nc bpc]
  (vec (for [y (range h)] (vec (for [x (range w) c (range nc)] (sample seed x y c bpc))))))

(defn pack-row [row bpc]
  (case (long bpc)
    8 (ubytes row)
    16 (ubytes (mapcat (fn [v] [(bit-shift-right v 8) (bit-and v 255)]) row))
    (let [per (quot 8 bpc)]
      (ubytes (for [chunk (partition-all per row)]
                (reduce (fn [acc [i v]] (bit-or acc (bit-shift-left v (- 8 bpc (* i bpc)))))
                        0 (map-indexed vector chunk)))))))

(defn pack [rows bpc] (apply cat-bytes (map #(pack-row % bpc) rows)))

;; ------------------------------------------------------------------ encoders

(defn deflate ^bytes [^bytes bs]
  (let [d (Deflater. 6) out (java.io.ByteArrayOutputStream.) buf (byte-array 4096)]
    (.setInput d bs) (.finish d)
    (while (not (.finished d)) (.write out buf 0 (.deflate d buf)))
    (.toByteArray out)))

(defn png-filter-rows
  "PNG-predict `bs` (rows of `rowb` bytes, `bpp` bytes a pixel): row y uses filter (mod y 5), each written independently."
  [^bytes bs rowb bpp]
  (let [rows (partition rowb (map #(bit-and 0xff %) bs))
        zero (vec (repeat rowb 0))]
    (ubytes
     (loop [rows rows prev zero y 0 acc []]
       (if-let [row (first rows)]
         (let [row (vec row) f (mod y 5)
               a (fn [i] (if (>= i bpp) (row (- i bpp)) 0))
               b (fn [i] (prev i))
               c (fn [i] (if (>= i bpp) (prev (- i bpp)) 0))
               paeth (fn [i] (let [A (a i) B (b i) C (c i) p (- (+ A B) C)
                                   pa (Math/abs (- p A)) pb (Math/abs (- p B)) pc (Math/abs (- p C))]
                               (cond (and (<= pa pb) (<= pa pc)) A (<= pb pc) B :else C)))
               out (for [i (range rowb)]
                     (bit-and 255 (- (row i) (case f 0 0 1 (a i) 2 (b i) 3 (quot (+ (a i) (b i)) 2) 4 (paeth i)))))]
           (recur (rest rows) row (inc y) (into acc (cons f out))))
         acc)))))

(defn lzw-encode
  "ISO 32000-1 7.4.4 LZWDecode with /EarlyChange 1: clear code first, codes 9..12 bits, width up one code early."
  [^bytes bs]
  (let [bits (java.io.ByteArrayOutputStream.) acc (atom 0) nacc (atom 0)
        put (fn [code width]
              (reset! acc (bit-or (bit-shift-left @acc width) code))
              (swap! nacc + width)
              (while (>= @nacc 8)
                (.write bits (bit-and 255 (bit-shift-right @acc (- @nacc 8))))
                (swap! nacc - 8)
                (swap! acc bit-and (dec (bit-shift-left 1 @nacc)))))
        fresh (fn [] (into {} (map (fn [i] [[i] i]) (range 256))))]
    (loop [table (fresh) next-code 258 width 9 s [] in (map #(bit-and 0xff %) bs) started false]
      (when-not started (put 256 9))
      (cond
        (empty? in)
        (do (when (seq s) (put (table s) width))
            ;; the width the decoder will have after this entry
            (put 257 (cond (>= (inc next-code) 2048) 12 (>= (inc next-code) 1024) 11 (>= (inc next-code) 512) 10 :else 9))
            (when (pos? @nacc) (.write bits (bit-shift-left @acc (- 8 @nacc))))
            (.toByteArray bits))
        :else
        (let [c (first in) sc (conj s c)]
          (if (contains? table sc)
            (recur table next-code width sc (rest in) true)
            (let [_ (put (table s) width)
                  table (assoc table sc next-code)
                  next-code (inc next-code)
                  ;; after adding entry n the decoder is one entry behind: it widens when (next-code + 1 - 1)... see below
                  width (cond (>= next-code 2047) 12 (>= next-code 1023) 11 (>= next-code 511) 10 :else 9)]
              (if (>= next-code 4094)
                (do (put 256 width)
                    (recur (fresh) 258 9 [c] (rest in) true))
                (recur table next-code width [c] (rest in) true)))))))))

(defn rl-encode [^bytes bs]
  ;; runs of 2+ equal bytes as repeats, the rest literal in groups of up to 128
  (let [v (mapv #(bit-and 0xff %) bs) out (java.io.ByteArrayOutputStream.)]
    (loop [i 0 lit []]
      (let [flush! (fn [] (when (seq lit) (.write out (dec (count lit))) (doseq [b lit] (.write out b))))]
        (cond
          (>= i (count v)) (do (flush!) (.write out 128))
          :else
          (let [b (v i) run (loop [j i] (if (and (< j (count v)) (= (v j) b) (< (- j i) 128)) (recur (inc j)) (- j i)))]
            (if (>= run 2)
              (do (flush!) (.write out (- 257 run)) (.write out b) (recur (+ i run) []))
              (if (= (count lit) 127)
                (do (.write out 127) (doseq [x (conj lit b)] (.write out x)) (recur (inc i) []))
                (recur (inc i) (conj lit b))))))))
    (.toByteArray out)))

(defn ahx-encode [^bytes bs] (bytes-of (str (hex bs) ">")))

(defn a85-encode [^bytes bs]
  (let [v (mapv #(bit-and 0xff %) bs) sb (StringBuilder.)]
    (doseq [g (partition-all 4 v)]
      (let [n (count g) padded (vec (concat g (repeat (- 4 n) 0)))
            val (reduce (fn [a b] (+ (* a 256) b)) 0 padded)]
        (if (and (= n 4) (zero? val))
          (.append sb "z")
          (let [digs (loop [x val k 5 acc '()] (if (zero? k) acc (recur (quot x 85) (dec k) (cons (rem x 85) acc))))]
            (doseq [d (take (inc n) digs)] (.append sb (char (+ d 33))))))))
    (bytes-of (str sb "~>"))))

;; ------------------------------------------------------------------ the PDF writer

(defn build-pdf
  "objs: {num {:dict \"...\" :stream bytes-or-nil}}. Answers {:bytes :stream-at {num offset}}."
  [objs trailer-extra]
  (let [bo (java.io.ByteArrayOutputStream.) offs (atom {}) sat (atom {})
        pos (fn [] (.size bo))]
    (.write bo (bytes-of "%PDF-1.7\n%âãÏÓ\n"))
    (doseq [[num {:keys [dict stream]}] (sort-by key objs)]
      (swap! offs assoc num (pos))
      (.write bo (bytes-of (str num " 0 obj\n")))
      (if stream
        (do (.write bo (bytes-of (str "<<" dict "/Length " (alength ^bytes stream) ">>\nstream\n")))
            (swap! sat assoc num (pos))
            (.write bo ^bytes stream)
            (.write bo (bytes-of "\nendstream\n")))
        (.write bo (bytes-of (str dict "\n"))))
      (.write bo (bytes-of "endobj\n")))
    (let [xr (pos) size (inc (apply max (keys @offs)))]
      (.write bo (bytes-of (str "xref\n0 " size "\n0000000000 65535 f \n")))
      (doseq [i (range 1 size)]
        (.write bo (bytes-of (if-let [o (@offs i)] (format "%010d 00000 n \n" o) "0000000000 00000 f \n"))))
      (.write bo (bytes-of (str "trailer\n<</Size " size "/Root 1 0 R" trailer-extra ">>\nstartxref\n" xr "\n%%EOF\n"))))
    {:bytes (.toByteArray bo) :stream-at @sat}))

(def rows-out (atom []))
(defn row!
  "A row; a file name (as the laws read them: relative to test/) gets its directory."
  [& fields]
  (swap! rows-out conj (str/join "\t" (map (fn [f] (let [f (str f)] (if (str/ends-with? f ".pdf") (str "assets/" f) f))) fields))))
(defn comment! [s] (swap! rows-out conj (str "# " s)))

(def page-w 200)
(def page-h 160)

(defn image-pdf
  "A one-page file: the image object 5 (dict, stream) placed by `cm`, extra objects as {num obj}."
  [file img-dict img-stream & {:keys [cm extra content res trailer] :or {cm "120 0 0 80 20 40"}}]
  (let [content (or content (str "q " cm " cm /Im Do Q\n"))
        objs (merge {1 {:dict "<</Type/Catalog/Pages 2 0 R>>"}
                     2 {:dict "<</Type/Pages/Kids[3 0 R]/Count 1>>"}
                     3 {:dict (str "<</Type/Page/Parent 2 0 R/MediaBox[0 0 " page-w " " page-h "]/Contents 4 0 R/Resources<</XObject<</Im 5 0 R>>"
                                   (or res "") ">>>>")}
                     4 {:dict "" :stream (bytes-of content)}
                     5 {:dict img-dict :stream img-stream}}
                    extra)
        {:keys [bytes stream-at]} (build-pdf objs (or trailer ""))]
    (fs/write-bytes (path file) bytes)
    stream-at))

;; ------------------------------------------------------------------ the expected pixels

(defn rnd-half-up
  "floor(x + 1/2), exactly (x a long or a ratio)."
  [x] (let [r (+ (rationalize x) 1/2)] (Math/floorDiv (long (numerator r)) (long (denominator r)))))

(defn reduce-sample [v bpc] (if (= bpc 16) (quot (+ (* v 255) 32767) 65535) v))
(defn maxv [bpc] (if (= bpc 16) 255 (dec (bit-shift-left 1 bpc))))

(defn decode-value
  "The decoded value of reduced sample v: d0 + v (d1 - d0) / M."
  [v m d0 d1] (+ d0 (/ (* v (- d1 d0)) m)))

(defn to255 [x] (max 0 (min 255 (rnd-half-up (* x 255)))))

(defn cmyk->rgb [[c m y k]] [(- 255 (min 255 (+ c k))) (- 255 (min 255 (+ m k))) (- 255 (min 255 (+ y k)))])

(defn pixel-rgb
  "The colour of the source pixel from its raw samples. cs: :gray :rgb :cmyk or [:indexed base hival palette]."
  [{:keys [bpc cs decode]} samples]
  (let [m (maxv bpc)
        vs (mapv #(reduce-sample % bpc) samples)
        idxd (vector? cs)
        n (cond idxd 1 (= cs :gray) 1 (= cs :rgb) 3 :else 4)]
    (let [dec-of (fn [i] (let [[a b] (if decode [(nth decode (* 2 i)) (nth decode (inc (* 2 i)))] (if idxd [0 m] [0 1]))]
                           (decode-value (vs i) m a b)))]
      (if idxd
        (let [[_ base hival pal] cs
              idx (max 0 (min hival (rnd-half-up (dec-of 0))))
              nb (case base :gray 1 :rgb 3 :cmyk 4)
              ent (mapv #(bit-and 0xff %) (take nb (drop (* idx nb) pal)))
              ent (vec (concat ent (repeat (- nb (count ent)) 0)))]
          (case base :gray [(ent 0) (ent 0) (ent 0)] :rgb ent :cmyk (cmyk->rgb ent)))
        (let [cs8 (mapv (fn [i] (to255 (dec-of i))) (range n))]
          (case cs :gray [(cs8 0) (cs8 0) (cs8 0)] :rgb cs8 :cmyk (cmyk->rgb cs8)))))))

(defn expected-rgba
  "Rows of [r g b a] for an image spec: {:w :h :bpc :cs :decode :rows :fill :imask? :key :mask {:img :smask? :matte}}."
  [{:keys [w h bpc rows fill imask? decode mask key] :as spec}]
  (let [m (maxv bpc)]
    (vec
     (for [y (range h)]
       (vec
        (for [x (range w)]
          (let [nc (cond imask? 1 (vector? (:cs spec)) 1 (= (:cs spec) :gray) 1 (= (:cs spec) :rgb) 3 :else 4)
                smp (subvec (rows y) (* x nc) (* (inc x) nc))
                [r g b] (if imask? fill (pixel-rgb spec smp))
                alpha (cond
                        imask? (let [v (reduce-sample (smp 0) 1)
                                     [d0 d1] (if decode decode [0 1])]
                                 (if (zero? (rnd-half-up (* 255 (decode-value v 1 d0 d1)))) 255 0))
                        key (if (every? true? (map (fn [s i] (<= (nth key (* 2 i)) (reduce-sample s bpc) (nth key (inc (* 2 i)))))
                                                   smp (range nc))) 0 255)
                        mask (let [{mw :w mh :h mrows :rows mbpc :bpc kind :kind mdecode :decode} mask
                                   mx (quot (* x mw) w) my (quot (* y mh) h)
                                   mv (reduce-sample ((mrows my) mx) mbpc)
                                   mm (maxv mbpc)
                                   [d0 d1] (if mdecode mdecode [0 1])
                                   dv (to255 (decode-value mv mm d0 d1))]
                               (if (= kind :stencil) (if (zero? dv) 255 0) dv))
                        :else 255)
                matte (:matte mask)
                [r g b] (if (and matte mask)
                          (let [unm (fn [c mt] (if (zero? alpha) 0
                                                   (let [n (* (- c mt) 255) q (quot (+ (Math/abs (long n)) (quot alpha 2)) alpha)]
                                                     (max 0 (min 255 (+ mt (if (neg? n) (- q) q)))))))]
                            [(unm r (matte 0)) (unm g (matte 1)) (unm b (matte 2))])
                          [r g b])]
            [r g b alpha])))))))

(defn orient-pixels
  "The oriented image of rows of pixels, `code` 0..7 as kin/pdfimage.kin names them, written here from the pictures:
  0 as is, 1 mirrored left-right, 2 half a turn, 3 mirrored top-bottom, 4 a quarter turn clockwise, 5 counter-clockwise,
  6 transposed, 7 anti-transposed."
  [px code]
  (let [h (count px) w (count (first px))
        at (fn [x y] ((px y) x))]
    (case (long code)
      0 px
      1 (vec (for [y (range h)] (vec (for [x (range w)] (at (- w 1 x) y)))))
      2 (vec (for [y (range h)] (vec (for [x (range w)] (at (- w 1 x) (- h 1 y))))))
      3 (vec (for [y (range h)] (vec (for [x (range w)] (at x (- h 1 y))))))
      4 (vec (for [Y (range w)] (vec (for [X (range h)] (at Y (- h 1 X))))))
      5 (vec (for [Y (range w)] (vec (for [X (range h)] (at (- w 1 Y) X)))))
      6 (vec (for [Y (range w)] (vec (for [X (range h)] (at Y X)))))
      7 (vec (for [Y (range w)] (vec (for [X (range h)] (at (- w 1 Y) (- h 1 X)))))))))

(defn rgba-bytes [px] (ubytes (mapcat (fn [row] (mapcat identity row)) px)))

(defn corner-orient
  "The orientation of the matrix [a b c d] (PDF user space, y up) by where the image's top-left and top-right corners
  land on the page (display y is -y), found independently of kin's signs-and-zeros rule. nil: not rectilinear."
  [a b c d]
  (let [tl [(* c 1) (* d 1)] tr [(+ a c) (+ b d)] bl [0 0] br [a b]
        pts {:tl tl :tr tr :bl bl :br br}
        disp (fn [[x y]] [x (- y)])
        d* (update-vals pts disp)
        xs (map first (vals d*)) ys (map second (vals d*))
        minx (apply min xs) maxx (apply max xs) miny (apply min ys) maxy (apply max ys)
        where (fn [[x y]] (cond (and (= x minx) (= y miny)) :tl (and (= x maxx) (= y miny)) :tr
                                (and (= x minx) (= y maxy)) :bl (and (= x maxx) (= y maxy)) :br))
        wtl (where (d* :tl)) wtr (where (d* :tr))
        rectilinear (and (or (and (zero? b) (zero? c)) (and (zero? a) (zero? d)))
                         (not (and (zero? a) (zero? b))) (not (and (zero? c) (zero? d))))]
    (when (and rectilinear wtl wtr)
      ({[:tl :tr] 0 [:tr :tl] 1 [:br :bl] 2 [:bl :br] 3 [:tr :br] 4 [:bl :tl] 5 [:tl :bl] 6 [:br :tr] 7} [wtl wtr]))))

;; ------------------------------------------------------------------ cases: decoded

(def tool-versions (atom {}))

(defn d-row!
  "A decoded-pixels row: the expected oriented, cut pixels hashed; also a PNG for eyes. `crop` is nil or
  {:box :clip :whole}; `fill` the stencil colour."
  [name file obj spec & {:keys [orient crop view]}]
  (let [px (expected-rgba spec)
        orient (or orient 0)
        oriented (orient-pixels px orient)
        ow (count (first oriented)) oh (count oriented)
        [vx0 vy0 vx1 vy1] (or view [0 0 ow oh])
        cut (vec (for [y (range vy0 vy1)] (subvec (oriented y) vx0 vx1)))
        bs (rgba-bytes cut)
        has-alpha (boolean (or (:imask? spec) (:key spec) (:mask spec)))
        chs (cond (:imask? spec) 3 (= (:cs spec) :gray) 1 (and (vector? (:cs spec)) (= (second (:cs spec)) :gray)) 1 :else 3)
        fill (:fill spec)]
    (let [raw (path "png/" name ".raw")]
      (fs/write-bytes raw bs)
      (sh! "magick" "-size" (str (count (first cut)) "x" (count cut)) "-depth" "8" (str "rgba:" raw) "-strip" (path "png/" name ".png"))
      (fs/delete raw))
    (row! "D" name file obj orient
          (if crop (str/join "," (concat (:box crop) (:clip crop) [(:whole crop)])) "-")
          (if fill (+ (* 65536 (fill 0)) (* 256 (fill 1)) (fill 2)) 0)
          (count (first cut)) (count cut) chs (if has-alpha 1 0) (sha256-hex bs))
    px))

(defn poppler-check!
  "pdfimages -png of the file's image must equal the expected colour (alpha ignored: poppler writes masks beside)."
  [file expect-px & {:keys [fuzz]}]
  (let [dir (str (fs/create-temp-dir {:prefix "assetfix"}))
        r (sh "pdfimages" "-png" (path file) (str dir "/x"))]
    (when-not (zero? (:exit r)) (throw (ex-info (str "pdfimages failed on " file ": " (:err r)) {})))
    (let [got (first (sort (map str (fs/glob dir "x-*.png"))))
          h (count expect-px) w (count (first expect-px))
          raw (str dir "/e.rgb")]
      (fs/write-bytes raw (ubytes (mapcat (fn [row] (mapcat (fn [[r g b _]] [r g b]) row)) expect-px)))
      (sh! "magick" "-size" (str w "x" h) "-depth" "8" (str "rgb:" raw) (str dir "/e.png"))
      (let [r (sh "magick" "compare" "-metric" "AE" "-fuzz" (or fuzz "0") got (str dir "/e.png") "null:")
            ae (try (Long/parseLong (re-find #"^\d+" (str/trim (:err r)))) (catch Exception _ -1))]
        (fs/delete-tree dir)
        (when-not (zero? ae)
          (throw (ex-info (str "poppler's pixels differ from the expectation for " file ": AE " ae) {})))))))

(def S 17) ;; image width
(def T 11) ;; image height

(defn case-flate-rgb8 []
  (let [rows (gen-rows 1 S T 3 8) bs (pack rows 8)
        spec {:w S :h T :bpc 8 :cs :rgb :rows rows}]
    (image-pdf "flate-rgb8.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/FlateDecode") (deflate bs))
    (let [px (d-row! "flate-rgb8" "flate-rgb8.pdf" 5 spec)]
      (poppler-check! "flate-rgb8.pdf" px))
    (doseq [o (range 1 8)]
      (d-row! (str "flate-rgb8-o" o) "flate-rgb8.pdf" 5 spec :orient o))
    ;; a cut: the placement box 120 x 80 pt at (20, 40); clip box on the page's own scale, centipoints, y down
    (let [box [2000 4000 14000 12000] clip [5000 4000 14000 9000]]
      ;; kin's rule: visible = box ∩ clip; cut in oriented pixels, floor low edge, ceiling high edge
      (let [bw (- (box 2) (box 0)) bh (- (box 3) (box 1))
            vx0 (max (box 0) (clip 0)) vy0 (max (box 1) (clip 1)) vx1 (min (box 2) (clip 2)) vy1 (min (box 3) (clip 3))
            px0 (long (Math/floor (/ (* (- vx0 (box 0)) S) bw))) py0 (long (Math/floor (/ (* (- vy0 (box 1)) T) bh)))
            px1 (long (Math/ceil (/ (* (- vx1 (box 0)) S) bw))) py1 (long (Math/ceil (/ (* (- vy1 (box 1)) T) bh)))]
        (d-row! "flate-rgb8-cut" "flate-rgb8.pdf" 5 spec
                :crop {:box box :clip clip :whole 980} :view [px0 py0 px1 py1])
        ;; the same cut after a quarter turn: the display grid is T wide and S high
        (let [dw T dh S
              qx0 (long (Math/floor (/ (* (- vx0 (box 0)) dw) bw))) qy0 (long (Math/floor (/ (* (- vy0 (box 1)) dh) bh)))
              qx1 (long (Math/ceil (/ (* (- vx1 (box 0)) dw) bw))) qy1 (long (Math/ceil (/ (* (- vy1 (box 1)) dh) bh)))]
          (d-row! "flate-rgb8-o4-cut" "flate-rgb8.pdf" 5 spec :orient 4
                  :crop {:box box :clip clip :whole 980} :view [qx0 qy0 qx1 qy1]))))
    ;; whole enough: a clip that leaves 99 per cent keeps the whole image
    (let [box [2000 4000 14000 12000]]
      (d-row! "flate-rgb8-whole" "flate-rgb8.pdf" 5 spec
              :crop {:box box :clip [2000 4000 13900 12000] :whole 980}))))

(defn case-flate-rgb8-predictor []
  (let [rows (gen-rows 2 S T 3 8) bs (pack rows 8)
        spec {:w S :h T :bpc 8 :cs :rgb :rows rows}]
    (image-pdf "flate-rgb8-png.pdf"
               (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter/FlateDecode/DecodeParms<</Predictor 15/Colors 3/BitsPerComponent 8/Columns " S ">>")
               (deflate (png-filter-rows bs (* S 3) 3)))
    (let [px (d-row! "flate-rgb8-png" "flate-rgb8-png.pdf" 5 spec)]
      (poppler-check! "flate-rgb8-png.pdf" px))))

(defn case-flate-rgb16 []
  (let [rows (gen-rows 3 S T 3 16) bs (pack rows 16)
        spec {:w S :h T :bpc 16 :cs :rgb :rows rows}]
    (image-pdf "flate-rgb16.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 16/Filter/FlateDecode") (deflate bs))
    (d-row! "flate-rgb16" "flate-rgb16.pdf" 5 spec))
  ;; poppler turns a 16-bit sample of 65535 (and 65534) into 0 (checked: its own 16-bit PNG), so the file it is held to has none
  (let [rows (mapv (fn [r] (mapv #(min % 60000) r)) (gen-rows 3 S T 3 16)) bs (pack rows 16)
        spec {:w S :h T :bpc 16 :cs :rgb :rows rows}]
    (image-pdf "flate-rgb16-b.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 16/Filter/FlateDecode") (deflate bs))
    (let [px (d-row! "flate-rgb16-b" "flate-rgb16-b.pdf" 5 spec)]
      (poppler-check! "flate-rgb16-b.pdf" px :fuzz "1%"))))

(defn case-gray [bpc seed]
  (let [rows (gen-rows seed S T 1 bpc) bs (pack rows bpc)
        spec {:w S :h T :bpc bpc :cs :gray :rows rows}
        file (str "gray" bpc ".pdf")]
    (image-pdf file (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceGray/BitsPerComponent " bpc "/Filter/FlateDecode") (deflate bs))
    (let [px (d-row! (str "gray" bpc) file 5 spec)]
      (poppler-check! file px))))

(defn case-decode-gray []
