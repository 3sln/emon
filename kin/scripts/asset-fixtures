        spec {:w S :h T :bpc 8 :cs :gray :rows rows :decode [1 0]}]
    (image-pdf "gray8-decode.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceGray/BitsPerComponent 8/Decode[1 0]/Filter/FlateDecode") (deflate bs))
    (let [px (d-row! "gray8-decode" "gray8-decode.pdf" 5 spec)]
      (poppler-check! "gray8-decode.pdf" px))
    ;; a fractional decode on 4-bit gray: [0.25 0.75]
    (let [rows (gen-rows 22 S T 1 4) bs (pack rows 4)
          spec {:w S :h T :bpc 4 :cs :gray :rows rows :decode [1/4 3/4]}]
      (image-pdf "gray4-decode.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceGray/BitsPerComponent 4/Decode[0.25 0.75]/Filter/FlateDecode") (deflate bs))
      (d-row! "gray4-decode" "gray4-decode.pdf" 5 spec))
    (let [rows (gen-rows 23 S T 3 8) bs (pack rows 8)
          spec {:w S :h T :bpc 8 :cs :rgb :rows rows :decode [1 0 0 1 1 0]}]
      (image-pdf "rgb8-decode.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 8/Decode[1 0 0 1 1 0]/Filter/FlateDecode") (deflate bs))
      (d-row! "rgb8-decode" "rgb8-decode.pdf" 5 spec))))

(defn case-filters []
  (doseq [[nm flt enc seed] [["lzw" "/LZWDecode" lzw-encode 31] ["runlength" "/RunLengthDecode" rl-encode 32]
                             ["asciihex" "/ASCIIHexDecode" ahx-encode 33]]]
    (let [rows (gen-rows seed S T 3 8) bs (pack rows 8)
          rows2 (vec (map (fn [r] (vec (map-indexed (fn [i v] (if (< (mod i 9) 6) 40 v)) r))) rows)) ; runs for run length
          bs2 (pack rows2 8)
          spec {:w S :h T :bpc 8 :cs :rgb :rows rows2}
          file (str nm "-rgb8.pdf")]
      (image-pdf file (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter " flt) (enc bs2))
      (let [px (d-row! (str nm "-rgb8") file 5 spec)]
        (poppler-check! file px))))
  ;; LZW with the TIFF predictor, two filters in a chain (A85 then Flate)
  (let [rows (gen-rows 34 S T 3 8) bs (pack rows 8)
        spec {:w S :h T :bpc 8 :cs :rgb :rows rows}]
    (image-pdf "a85-flate-rgb8.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace/DeviceRGB/BitsPerComponent 8/Filter[/ASCII85Decode/FlateDecode]") (a85-encode (deflate bs)))
    (let [px (d-row! "a85-flate-rgb8" "a85-flate-rgb8.pdf" 5 spec)]
      (poppler-check! "a85-flate-rgb8.pdf" px))))

(defn case-indexed []
  (let [pal (ubytes (mapcat identity (for [i (range 16)] [(* i 17) (mod (* i 53) 256) (- 255 (* i 13))])))
        rows (gen-rows 41 S T 1 4) bs (pack rows 4)
        spec {:w S :h T :bpc 4 :cs [:indexed :rgb 15 pal] :rows rows}
        hexpal (hex pal)]
    (image-pdf "indexed16.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/Indexed/DeviceRGB 15<" hexpal ">]/BitsPerComponent 4/Filter/FlateDecode") (deflate bs))
    (let [px (d-row! "indexed16" "indexed16.pdf" 5 spec)]
      (poppler-check! "indexed16.pdf" px))
    ;; the palette in a stream, the colours gray
    (let [gpal (ubytes (map #(* % 17) (range 16)))
          spec {:w S :h T :bpc 4 :cs [:indexed :gray 15 gpal] :rows rows}]
      (image-pdf "indexed16-stream.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/Indexed/DeviceGray 15 8 0 R]/BitsPerComponent 4/Filter/FlateDecode") (deflate bs)
                 :extra {8 {:dict "" :stream gpal}})
      (let [px (d-row! "indexed16-stream" "indexed16-stream.pdf" 5 spec)]
        (poppler-check! "indexed16-stream.pdf" px)))
    ;; Indexed over CMYK, and a /Decode on an Indexed image
    (let [cpal (ubytes (mapcat identity (for [i (range 4)] [(* i 60) (* i 20) 10 (* i 30)])))
          rows (gen-rows 42 S T 1 2) bs (pack rows 2)
          spec {:w S :h T :bpc 2 :cs [:indexed :cmyk 3 cpal] :rows rows}]
      (image-pdf "indexed4-cmyk.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/Indexed/DeviceCMYK 3<" (hex cpal) ">]/BitsPerComponent 2/Filter/FlateDecode") (deflate bs))
      (d-row! "indexed4-cmyk" "indexed4-cmyk.pdf" 5 spec))
    (let [spec {:w S :h T :bpc 4 :cs [:indexed :rgb 15 pal] :rows rows :decode [15 0]}]
      (image-pdf "indexed16-decode.pdf" (str "/Type/XObject/Subtype/Image/Width " S "/Height " T "/ColorSpace[/Indexed/DeviceRGB 15<" hexpal ">]/BitsPerComponent 4/Decode[15 0]/Filter/FlateDecode") (deflate bs))
      (let [px (d-row! "indexed16-decode" "indexed16-decode.pdf" 5 spec)]
        (poppler-check! "indexed16-decode.pdf" px)))))

(defn case-cmyk-icc-cal []
