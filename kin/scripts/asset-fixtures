      (str "ImageMagick " (:imagemagick @tool-versions) "\npdfimages " (first (str/split-lines (str/trim (str (:err (sh "pdfimages" "-v")))))) "\nqpdf " (first (str/split-lines (:out (sh "qpdf" "--version")))) "\n"))
(if check?
  (let [rel (fn [d] (into (sorted-set) (map #(str (fs/relativize d %)) (filter fs/regular-file? (file-seq (fs/file d))))))
        a (rel out-dir) b (rel committed)
        diff (vec (concat (map #(str "missing from the corpus: " %) (remove b a))
                     (map #(str "not written by the generator: " %) (remove a b))
                     (for [f (filter b a) :when (not (java.util.Arrays/equals ^bytes (fs/read-all-bytes (str out-dir "/" f))
                                                                              ^bytes (fs/read-all-bytes (str committed "/" f))))]
                       (str "differs: " f))))]
    (fs/delete-tree out-dir)
    (if (seq diff)
      (do (println "  FAIL test/assets is not what kin/scripts/asset-fixtures writes:") (doseq [d (take 20 diff)] (println "   " d)) (System/exit 1))
      (println (str "  ok   test/assets is what kin/scripts/asset-fixtures writes (" (count a) " files)"))))
  (println "wrote" (count @rows-out) "rows,"
           (count (fs/glob out-dir "*.pdf")) "files in test/assets"))
