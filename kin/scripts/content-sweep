#!/bin/sh
# Run the GENERATED RUST content interpreter (DEVLOG P1.7) over the PDFs named on stdin.
#
#     find corpus -name '*.pdf' | kin/scripts/content-sweep [json|glyphs|text|stats]
#
# A DEVELOPMENT TOOL, run by a person and by `tools/oracle/content-corpus.py`;
# no gate runs it. Builds with overflow and bounds checks ON, so a fault in the
# interpreter is a `PANIC` row rather than a crash (and the next file is read).
#
#   rows    `P page text` per page and `S ...` per span: the goldens of test/content/synth.txt and tagged.txt
#   digest  `D page digest glyphs` per page (`emon.contentrows`'s digest, what the oracle's ratchet holds)
#   json    one row `J path <TAB> the compact emon-evidence dump` per file
#   glyphs  `G page cp[+cp] how font size x0 y0 x1 y1 baseline rot mode mcid word artifact` per glyph
#   text    `T page y0 x0 line-text` per emon line, words joined by a space
#   vis     `V page glyph mode vis vby vchk x0 y0 x1 y1 fill stroke size cs cp` per glyph (P3.6, D134), then `I page vis vby vchk box`
#           per image and `Q page kind flags fill stroke box z clip` per path row
#   stats   (default) `F path open-status pages glyphs words lines spans warn fonts ms`
set -e
cd "$(dirname "$0")/../.."
mode="${1:-stats}"
./kin/scripts/emit > /dev/null
work=$(mktemp -d "${TMPDIR:-/tmp}/emon-csweep.XXXXXX")
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/emon"
cp gen/rust/emon/*.rs "$work/emon/"
cp host/rust/src/port.rs host/rust/src/testport.rs "$work/"
( for f in gen/rust/emon/*.rs; do echo "pub mod $(basename "$f" .rs);"; done ) > "$work/emon.rs"
cat > "$work/main.rs" <<'MAIN'
#![allow(dead_code, unused_mut, unused_variables, unused_imports)]
mod emon;
mod port;
mod testport;
use emon::pdfdoc::*;
use emon::pdfcontent::*;
use emon::evidence::*;
use emon::contentrows::*;
use std::io::BufRead;

fn cps_str(et: &port::Cells, s: i32, n: i32) -> String {
    let mut o = String::new();
    for k in 0..n {
        let c = port::cells_at(et, s + k);
        o.push(char::from_u32(c as u32).unwrap_or('\u{FFFD}'));
    }
    o
}

fn main() {
    let mode = std::env::args().nth(1).unwrap_or("stats".to_string());
    let stdin = std::io::stdin();
    for line in stdin.lock().lines() {
        let path = line.unwrap();
        let data = match std::fs::read(&path) {
            Ok(d) => d,
            Err(_) => { println!("F\t{}\tioerror\t0\t0\t0\t0\t0\t0\t0\t0", path); continue; }
        };
        let t0 = std::time::Instant::now();
        let src = port::Src::of_bytes(data);
        let res = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
            let mut ar = port::Cells::new(); let mut dc = port::Cells::new();
            let mut a = port::Cells::new(); let mut b = port::Cells::new();
            let mut st = port::Cells::new(); let mut pg = port::Cells::new();
            let mut cx = port::Cells::new(); let mut ox = port::Cells::new();
            let mut cs = port::Cells::new(); let mut out = port::Cells::new();
            let mut f0 = port::Cells::new(); let mut f1 = port::Cells::new();
            let mut f2 = port::Cells::new(); let mut f3 = port::Cells::new();
            let mut epages = port::Cells::new();
            let mut views = port::Cells::new();
            let mut pts = port::Cells::new();
            let mut refs = port::Cells::new();
            let mut et = port::Cells::new();
            let mut feats = port::Cells::new();
            let mut gl = port::Cells::new();
            let mut wd = port::Cells::new();
            let mut ln = port::Cells::new();
            let mut mk = port::Cells::new();
            let mut fnt = port::Cells::new();
            let mut paths = port::Cells::new();
            let mut images = port::Cells::new();
            let mut oruns = port::Cells::new();
            let mut oblocks = port::Cells::new();
            let mut olines = port::Cells::new();
            let mut owords = port::Cells::new();
            let mut osyms = port::Cells::new();
            let mut oalts = port::Cells::new();
            let mut inks = port::Cells::new();
            let mut comps = port::Cells::new();
            let mut rules = port::Cells::new();
            let mut prims = port::Cells::new();
            let mut tlines = port::Cells::new();
            let mut gx = port::Cells::new();
            let mut rows: Vec<String> = vec![];
            let ostatus = pd_open(&src, &mut ar, &mut dc, &mut a, &mut b, &mut st);
            if ostatus != 0 {
                rows.push(format!("F\t{}\topen{}\t0\t0\t0\t0\t0\t0\t0\t0", path, ostatus));
                return rows;
            }
            let status = pc_document(&src, &mut ar, &mut dc, &mut a, &mut b, &mut st, &mut cx, &mut ox,
                                     &mut cs, &mut out, &mut f0, &mut f1, &mut f2, &mut f3,
                                     &mut gl, &mut et, &mut mk, &mut fnt, &mut pg, &mut wd, &mut ln,
                                     &mut paths, &mut images, &mut pts, &mut gx);
            let npages = pd_pg_count(&mut pg);
            if mode == "json" {
                let mut t = String::new();
                ev_emit(&mut t, 0, &mut epages, &mut views, &mut pts, &mut refs, &mut et, &mut feats, &mut gl, &mut wd, &mut ln, &mut mk, &mut fnt, &mut paths, &mut images, &mut oruns, &mut oblocks, &mut olines, &mut owords, &mut osyms, &mut oalts, &mut inks, &mut comps, &mut rules, &mut prims, &mut tlines);
                rows.push(format!("J\t{}\t{}", path, t));
            }
            if mode == "rows" || mode == "digest" {
                for p in 1..=npages {
                    if mode == "rows" {
                        let mut t = String::new();
                        cr_page_text(&mut t, &mut gl, &mut et, p);
                        rows.push(format!("P\t{}\t{}", p, t));
                        let mut tl = String::new();
                        cr_page_lines(&mut tl, &mut wd, &mut ln, &mut et, p);
                        rows.push(format!("T\t{}\t{}", p, tl));
                    } else {
                        let mut n = 0;
                        for g in 0..gl_count(&mut gl) { if gl_get(&mut gl, g, ch_page()) == p { n += 1; } }
                        rows.push(format!("D\t{}\t{}\t{}", p, cr_digest(&mut gl, &mut et, p), n));
                    }
                }
                if mode == "rows" {
                    for i in 0..mk_count(&mut mk) {
                        let mut t = String::new();
                        cr_span(&mut t, &mut mk, &mut et, i);
                        rows.push(format!("S\t{}", t));
                    }
                }
            }
            if mode == "vis" {
                for g in 0..gl_count(&mut gl) {
                    let ts = gl_get(&mut gl, g, ch_tstart());
                    let cp = if ts >= 0 { cps_str(&et, ts, gl_get(&mut gl, g, ch_tlen())) }
                             else if gl_get(&mut gl, g, ch_cp()) < 0 { "?".to_string() }
                             else { char::from_u32(gl_get(&mut gl, g, ch_cp()) as u32).unwrap_or('?').to_string() };
                    rows.push(format!("V\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", gl_get(&mut gl, g, ch_page()), g, gl_get(&mut gl, g, gf_mode()),
                        gl_get(&mut gl, g, gf_vis()), gl_get(&mut gl, g, gf_vby()), gl_get(&mut gl, g, gf_vchk()),
                        gl_get(&mut gl, g, ch_x0()), gl_get(&mut gl, g, ch_y0()), gl_get(&mut gl, g, ch_x1()), gl_get(&mut gl, g, ch_y1()),
                        gl_get(&mut gl, g, gf_fill()), gl_get(&mut gl, g, gf_stroke()), gl_get(&mut gl, g, gf_size()), gl_get(&mut gl, g, gf_cs()), cp));
                }
                for r in 0..im_count(&mut images) {
                    rows.push(format!("I\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", im_get(&mut images, r, mf_page()), im_get(&mut images, r, mf_vis()), im_get(&mut images, r, mf_vby()),
                        im_get(&mut images, r, mf_vchk()), im_get(&mut images, r, mf_x0()), im_get(&mut images, r, mf_y0()), im_get(&mut images, r, mf_x1()), im_get(&mut images, r, mf_y1()), im_get(&mut images, r, mf_z())));
                }
                for r in 0..pa_count(&mut paths) {
                    rows.push(format!("Q\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", pa_get(&mut paths, r, pf_page()), pa_get(&mut paths, r, pf_kind()), pa_get(&mut paths, r, pf_flags()),
                        pa_get(&mut paths, r, pf_fill()), pa_get(&mut paths, r, pf_stroke()), pa_get(&mut paths, r, pf_x0()), pa_get(&mut paths, r, pf_y0()),
                        pa_get(&mut paths, r, pf_x1()), pa_get(&mut paths, r, pf_y1()), pa_get(&mut paths, r, pf_z()), pa_get(&mut paths, r, pf_clip())));
                }
            }
            if mode == "glyphs" || mode == "all" {
                for g in 0..gl_count(&mut gl) {
                    let mut v: Vec<i32> = vec![];
                    for f in 0..32 { v.push(gl_get(&mut gl, g, f)); }
                    let ts = v[ch_tstart() as usize];
                    let cp = if ts >= 0 { cps_str(&et, ts, v[ch_tlen() as usize]).chars().map(|c| format!("{:04X}", c as u32)).collect::<Vec<_>>().join("+") }
                             else if v[ch_cp() as usize] < 0 { "-".to_string() } else { format!("{:04X}", v[ch_cp() as usize]) };
                    let mcid = cr_mark_mcid(&mut mk, v[gf_mark() as usize]);
                    let art = cr_mark_class(&mut mk, v[gf_mark() as usize]);
                    rows.push(format!("G\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", v[0], cp, v[gf_how() as usize], v[gf_font() as usize], v[gf_size() as usize],
                        v[1], v[2], v[3], v[4], v[gf_by0() as usize], v[gf_rot() as usize], v[gf_mode() as usize], mcid, v[8], art));
                }
            }
            if mode == "text" || mode == "all" {
                for l in 0..ln_count(&mut ln) {
                    let mut s = String::new();
                    let w0 = ln_get(&mut ln, l, lh_first());
                    let wn = ln_get(&mut ln, l, lh_count());
                    for w in w0..w0 + wn {
                        if w > w0 { s.push(' '); }
                        s.push_str(&cps_str(&et, wd_get(&mut wd, w, hd_tstart()), wd_get(&mut wd, w, hd_tlen())));
                    }
                    rows.push(format!("T\t{}\t{}\t{}\t{}", ln_get(&mut ln, l, lh_page()), ln_get(&mut ln, l, lh_y0()), ln_get(&mut ln, l, lh_x0()), s));
                }
                for w in 0..wd_count(&mut wd) {
                    rows.push(format!("W\t{}\t{}\t{}\t{}\t{}\t{}", wd_get(&mut wd, w, hd_page()), wd_get(&mut wd, w, hd_x0()), wd_get(&mut wd, w, hd_y0()),
                        wd_get(&mut wd, w, hd_x1()), wd_get(&mut wd, w, hd_y1()),
                        cps_str(&et, wd_get(&mut wd, w, hd_tstart()), wd_get(&mut wd, w, hd_tlen()))));
                }
            }
            rows.push(format!("F\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", path, if pd_encrypted(&mut dc) != 0 { "encrypted".to_string() } else if status == 0 { "ok".to_string() } else { format!("pc{}", status) }, npages,
                gl_count(&mut gl), wd_count(&mut wd), ln_count(&mut ln), mk_count(&mut mk), pc_warn(&mut cx), pc_fonts(&mut cx), pc_stream_status(&mut cx),
                t0.elapsed().as_millis(), port::cells_len(&cs)));
            rows
        }));
        match res {
            Ok(rows) => for r in rows { println!("{}", r); },
            Err(p) => {
                let m = if let Some(s) = p.downcast_ref::<String>() { s.clone() }
                        else if let Some(s) = p.downcast_ref::<&str>() { s.to_string() }
                        else { "?".to_string() };
                println!("F\t{}\tPANIC {}\t0\t0\t0\t0\t0\t0\t0\t0", path, m.replace('\n', " ").replace('\t', " "));
            }
        }
    }
}
MAIN
( cd "$work" && rustc -O -C debug-assertions=on -C overflow-checks=on -o csweep main.rs 2>&1 | grep -E '^error' -A14 | head -200 || true )
[ -x "$work/csweep" ] && "$work/csweep" "$mode"
