#!/usr/bin/env bb
;; The small LZW streams of the P10.3a laws in kin/pdffiltertest.kin (D881): KwKwK (a code that is the entry being
;; added), packed here and read back by an independent decoder written from ISO 32000-1 7.4.4 (no JDK or other
;; library has a PDF/TIFF LZW; kin/scripts/pdf-fixtures.py's encoder is the other implementation that agrees with
;; emon on the corpus).     bb kin/scripts/lzw-vectors
(defn width [nxt early] (+ 9 (if (>= (+ nxt early) 512) 1 0) (if (>= (+ nxt early) 1024) 1 0) (if (>= (+ nxt early) 2048) 1 0)))

(defn pack [codes early]
  (let [[bits _ _]
        (reduce (fn [[bits nxt have] c]
                  (let [w (width nxt early)
                        bits (into bits (for [i (range (dec w) -1 -1)] (bit-and (bit-shift-right c i) 1)))]
                    (cond (= c 256) [bits 258 false]
                          (= c 257) [bits nxt have]
                          (not have) [bits nxt true]
                          :else [bits (min (inc nxt) 4096) have])))
                [[] 258 false] codes)
        b (vec (concat bits (repeat (mod (- (count bits)) 8) 0)))]
    (byte-array (for [i (range 0 (count b) 8)] (unchecked-byte (reduce + (for [j (range 8)] (bit-shift-left (nth b (+ i j)) (- 7 j)))))))))

(defn decode [data early]
  (let [bit (fn [p] (bit-and (bit-shift-right (bit-and 255 (aget data (quot p 8))) (- 7 (mod p 8))) 1))
        lit (into {} (for [i (range 256)] [i [i]]))]
    (loop [pos 0 table lit nxt 258 prev nil out []]
      (let [w (width nxt early)]
        (if (> (+ pos w) (* 8 (alength data))) out
            (let [code (reduce (fn [a i] (+ (* 2 a) (bit (+ pos i)))) 0 (range w))
                  pos (+ pos w)]
              (cond (= code 256) (recur pos lit 258 nil out)
                    (= code 257) out
                    (nil? prev) (recur pos table nxt (table code) (into out (table code)))
                    :else
                    (let [s (cond (contains? table code) (table code)
                                  (= code nxt) (conj prev (first prev))
                                  :else (throw (ex-info "bad code" {:code code})))
                          table (if (< nxt 4096) (assoc table nxt (conj prev (first s))) table)]
                      (recur pos table (if (< nxt 4096) (inc nxt) nxt) s (into out s))))))))))

(defn hex [bs] (apply str (map #(format "%02x" (bit-and % 255)) bs)))

(doseq [[name codes want] [["kwkwk aaa" [256 97 258 257] (vec (repeat 3 97))]
                           ["kwkwk chain" [256 97 258 259 260 261 257] (vec (repeat 15 97))]
                           ["kwkwk ab" [256 65 66 258 260 257] (mapv int "ABABABA")]]]
  (let [d (pack codes 1)]
    (assert (= want (decode d 1)) name)
    (println name (hex d) (apply str (map char want)))))

(doseq [early [1 0]]
  (let [d (pack (concat [256] (repeat 300 97) [257]) early)]
    (assert (= (vec (repeat 300 97)) (decode d early)))
    (println "early" early "300 literal codes across the 9 -> 10 bit switch:" (alength d) "bytes")))
