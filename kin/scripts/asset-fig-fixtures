#!/usr/bin/env bb
;; Write P8.5's fixtures: small hand-made PDFs whose figures are vector art, a logo on every page, and images with something over them
;; (SPEC 10.11 `rendered`), with no tool but this file.   bb kin/scripts/asset-fig-fixtures [--check]
;;
;; A DEVELOPMENT TOOL (babashka), run by a person; the fixtures are COMMITTED (test/assets/fig/*.pdf) so a test run needs none of it.
;; `--check` regenerates in memory and compares with the committed files (they are a pure function of this file: no clock, no
;; random numbers). The pages are Letter (612 x 792 pt), Helvetica from the standard 14 (no font file), images are raw 8-bit RGB
;; samples (no filter), so every byte is here.
;;
;;   fig-vector-chart.pdf   a bar chart (axes and four bars) and a box-and-arrow diagram, each with its caption: two vector figures
;;   fig-logo-pages.pdf     three pages, the same two-path logo in the same place on each: three uses of one rendered asset
;;   fig-over-image.pdf     five pictures of one image: left alone (the control: its own pixels), a rectangle drawn over it, text
;;                          drawn over it, rotated 10 degrees by its matrix, and clipped by a circle: the last four are rendered
(require '[babashka.fs :as fs] '[clojure.string :as str])
(import '(java.io ByteArrayOutputStream))

(def root (-> *file* java.io.File. .getCanonicalFile .getParentFile .getParentFile .getParent))
(def check? (boolean (some #{"--check"} *command-line-args*)))
(def out (str root "/test/assets/fig"))

(defn latin1 [^String s] (.getBytes s "ISO-8859-1"))
(defn join-bytes [parts]
  (let [o (ByteArrayOutputStream.)] (doseq [p parts] (.write o ^bytes p)) (.toByteArray o)))

(defn pdf
  "A PDF from `objs`, a vector of byte arrays (object n is objs[n-1], its body without `n 0 obj`/`endobj`); the catalogue is object 1."
  [objs]
  (let [header (latin1 "%PDF-1.4\n%âãÏÓ\n")
        parts (atom [header]) offsets (atom []) pos (atom (alength header))]
    (doseq [[i body] (map-indexed vector objs)]
      (let [b (join-bytes [(latin1 (str (inc i) " 0 obj\n")) body (latin1 "\nendobj\n")])]
        (swap! offsets conj @pos) (swap! pos + (alength b)) (swap! parts conj b)))
    (let [xref-at @pos n (inc (count objs))
          xref (str "xref\n0 " n "\n0000000000 65535 f \n"
                    (apply str (for [o @offsets] (format "%010d 00000 n \n" o)))
                    "trailer\n<< /Size " n " /Root 1 0 R >>\nstartxref\n" xref-at "\n%%EOF\n")]
      (join-bytes (conj @parts (latin1 xref))))))

(defn stream [dict ^bytes data]
  (join-bytes [(latin1 (str "<< " dict " /Length " (alength data) " >>\nstream\n")) data (latin1 "\nendstream")]))

(defn text-stream [s] (stream "" (latin1 s)))

(defn t
  "A line of text: font size, position, string."
  [size x y s] (format "BT /F1 %d Tf %d %d Td (%s) Tj ET\n" size x y s))

(defn page-objs
  "Objects for pages: object 1 the catalogue, 2 the page tree, 3 the font, then per page its dict, its content and its resources'
  extras in `extra` (a string of `/XObject << ... >>` or empty), with image objects `images` appended after."
  [contents extras images]
  (let [np (count contents) first-page 4
        kids (str/join " " (for [i (range np)] (str (+ first-page (* 2 i)) " 0 R")))
        img-base (+ first-page (* 2 np))]
    (vec (concat
          [(latin1 "<< /Type /Catalog /Pages 2 0 R >>")
           (latin1 (str "<< /Type /Pages /Count " np " /Kids [" kids "] >>"))
           (latin1 "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>")]
          (mapcat (fn [i c]
                    [(latin1 (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents " (+ first-page (* 2 i) 1) " 0 R "
                                  "/Resources << /Font << /F1 3 0 R >> " (str/replace (get extras i "") #"IMG(\d*)" (fn [[_ n]] (str (+ img-base (if (str/blank? n) 0 (parse-long n)))))) " >> >>"))
                     (text-stream c)])
                  (range) contents)
          images))))

;; ------------------------------------------------------------------------------------------------ the chart and the diagram

(def chart-page
  (str (t 14 72 740 "Quarterly units sold")
       (t 11 72 718 "The chart below shows units per quarter and the diagram how a request travels.")
       ;; the chart: two axes and four bars
       "0.75 w 0 G 100 450 m 100 650 l S 100 450 m 300 450 l S\n"
       "0.20 0.40 0.70 rg 110 451 30 90 re f 150 451 30 130 re f 190 451 30 110 re f 230 451 30 160 re f\n"
       (t 10 72 432 "Figure 1. Units per quarter")
       ;; the diagram: three boxes joined by arrows
       "0.75 w 0 G 100 300 70 40 re S 230 300 70 40 re S 360 300 70 40 re S\n"
       "170 320 m 230 320 l S 300 320 m 360 320 l S 222 316 m 230 320 l 222 324 l S 352 316 m 360 320 l 352 324 l S\n"
       (t 9 112 316 "Client") (t 9 240 316 "Gateway") (t 9 376 316 "Service")
       (t 10 72 282 "Figure 2. Request path")
       (t 11 72 250 "Closing paragraph after the figures.")))

(def chart-pdf (pdf (page-objs [chart-page] [""] [])))

;; --------------------------------------------------------------------------------------------------- the logo, every page

(defn logo-page [n]
  (str "0.10 0.60 0.40 rg 72 720 m 72 735 80 750 96 750 c 112 750 120 735 120 720 c 120 705 112 690 96 690 c 80 690 72 705 72 720 c f\n"
       "1 g 86 710 20 20 re f\n"
       (t 12 128 714 "NorthWind")
       (t 11 72 640 (str "Page " n " of the report. The logo above is the same drawing on every page."))
       (t 11 72 620 "A second paragraph so that there is body text under it.")))

(def logo-pdf (pdf (page-objs [(logo-page 1) (logo-page 2) (logo-page 3)] ["" "" ""] [])))

;; ------------------------------------------------------------------------------------------------- pictures with things over them

(def image-data
  "An 8 x 8 RGB image: a horizontal blue ramp over a vertical red ramp."
  (byte-array (for [y (range 8) x (range 8) c (range 3)]
                (unchecked-byte (case c 0 (* y 32) 1 80 2 (* x 32))))))

(defn image-obj [] (stream "/Type /XObject /Subtype /Image /Width 8 /Height 8 /ColorSpace /DeviceRGB /BitsPerComponent 8" image-data))

(def over-page
  (str (t 12 72 750 "Five pictures of one image")
       ;; 1: the control, left alone
       "q 120 0 0 90 72 620 cm /Im1 Do Q\n"
       ;; 2: a white rectangle over its middle
       "q 120 0 0 90 232 620 cm /Im1 Do Q\n"
       "1 g 262 640 60 50 re f\n"
       ;; 3: text over it
       "q 120 0 0 90 392 620 cm /Im1 Do Q\n"
       "1 g BT /F1 14 Tf 400 660 Td (Over the picture) Tj ET\n0 g\n"
       ;; 4: rotated 10 degrees (cos 0.9848, sin 0.1736)
       (str "q " (format "%.4f %.4f %.4f %.4f" (* 120 0.9848) (* 120 0.1736) (* -90 0.1736) (* 90 0.9848)) " 80 450 cm /Im1 Do Q\n")
       ;; 5: clipped by a circle
       "q 262 520 m 262 540 280 560 300 560 c 320 560 338 540 338 520 c 338 500 320 480 300 480 c 280 480 262 500 262 520 c W n 120 0 0 90 232 470 cm /Im1 Do Q\n"
       (t 11 72 400 "Closing paragraph after the pictures.")))

(def over-pdf (pdf (page-objs [over-page] ["/XObject << /Im1 IMG 0 R >>"] [(image-obj)])))

;; ----------------------------------------------------------------------------------------------------------------- go

;; --------------------------------------------------------------------------------------------------- the kinds (P8.1, SPEC 10.6)
;; Ten pages, one figure each, of the kinds the classifier tells apart by geometry, ink and bytes a pixel; and a page of things that are
;; NO figure. `test/assets/fig/kinds.edn` is the gold: the `kind`s of the figures, in order, of each fixture. Everything is deterministic.

(defn lcg [seed] (iterate #(mod (+ (* % 1103515245) 12345) 2147483648) seed))
(defn f2 [x] (format "%.2f" (double x)))
(defn gray-g [g] (format "%.2f g\n" (double g)))

(defn pie-page []
  (let [cx 200 cy 600 r 80
        wedge (fn [a0 a1 col]
                (str col " rg " (f2 cx) " " (f2 cy) " m "
                     (str/join " " (for [a (range a0 (inc a1) 10)]
                                     (str (f2 (+ cx (* r (Math/cos (Math/toRadians a))))) " " (f2 (+ cy (* r (Math/sin (Math/toRadians a))))) " l")))
                     " h f\n"))]
    (str (t 14 72 740 "Market share by region")
         (wedge 0 100 "0.20 0.40 0.70") (wedge 100 190 "0.85 0.45 0.15") (wedge 190 290 "0.30 0.65 0.35") (wedge 290 360 "0.70 0.25 0.55")
         (t 9 300 640 "North") (t 9 300 620 "South") (t 9 300 600 "East") (t 9 300 580 "West")
         (t 10 72 490 "Figure 1. Share of sales")
         (t 11 72 460 "Closing paragraph after the pie."))))

(defn line-page []
  (str (t 14 72 740 "Monthly trend")
       "0.75 w 0 G 100 450 m 100 650 l S 100 450 m 400 450 l S\n"
       (apply str (for [i (range 5)] (let [y (+ 450 (* 50 i))] (str "96 " y " m 100 " y " l S\n" (t 9 78 (- y 3) (str (* 50 i)))))))
       "0.80 0.20 0.20 RG 1.5 w 100 470 m 160 500 l 220 490 l 280 560 l 340 600 l 400 640 l S\n"
       (apply str (for [[i m] (map-indexed vector ["Jan" "Feb" "Mar" "Apr" "May" "Jun"])] (t 9 (+ 94 (* 60 i)) 436 m)))
       (t 10 72 410 "Figure 2. Monthly trend")
       (t 11 72 380 "Closing paragraph after the chart.")))

(defn barcode-page []
  (let [ws [1 2 1 3 1 1 2 1 3 2 1 1 3 1 2 1 1 2 3 1 1 2 1 2]]
    (str (t 14 72 740 "Shipping label")
         "0 g\n"
         (loop [x 100.0 ws ws out ""]
           (if (empty? ws) out
               (recur (+ x (first ws) 1.4) (rest ws) (str out (f2 x) " 600 " (f2 (first ws)) " 40 re f\n"))))
         (t 10 72 570 "Figure 3. Parcel code")
         (t 11 72 540 "Closing paragraph after the label."))))

(defn qr-page []
  (let [n 21 cell 3.5 bits (vec (take (* n n) (map #(bit-and (bit-shift-right % 16) 1) (lcg 7))))
        finder? (fn [x y] (or (and (< x 7) (< y 7)) (and (>= x (- n 7)) (< y 7)) (and (< x 7) (>= y (- n 7)))))
        on? (fn [x y] (if (finder? x y)
                        (let [fx (mod x (- n 7)) fy (mod y (- n 7))
                              lx (if (>= x (- n 7)) (- x (- n 7)) x) ly (if (>= y (- n 7)) (- y (- n 7)) y)]
                          (or (#{0 6} lx) (#{0 6} ly) (and (<= 2 lx 4) (<= 2 ly 4))))
                        (= 1 (nth bits (+ (* y n) x)))))]
    (str (t 14 72 740 "Link")
         "0 g\n"
         (apply str (for [y (range n) x (range n) :when (on? x y)]
                      (str (f2 (+ 100 (* x cell))) " " (f2 (+ 600 (* (- (dec n) y) cell))) " " (f2 cell) " " (f2 cell) " re f\n")))
         (t 10 72 570 "Figure 4. Page address")
         (t 11 72 540 "Closing paragraph after the code."))))

(defn map-page []
  (let [rnd (vec (take 4000 (map #(- (mod (quot % 65536) 15) 7) (lcg 11))))
        pt (fn [k] (nth rnd k))
        segs (for [j (range 9) i (range 10)]
               (let [x (+ 100 (* 30 i)) y (+ 440 (* 30 j)) k (* 6 (+ i (* 10 j)))]
                 (str (f2 x) " " (f2 y) " m " (f2 (+ x 10 (pt k))) " " (f2 (+ y (pt (+ k 1)))) " " (f2 (+ x 20 (pt (+ k 2)))) " " (f2 (+ y (pt (+ k 3)))) " " (f2 (+ x 30)) " " (f2 y) " c S\n")))
        vsegs (for [j (range 8) i (range 10)]
                (let [x (+ 100 (* 30 i)) y (+ 440 (* 30 j)) k (+ 400 (* 6 (+ i (* 10 j))))]
                  (str (f2 x) " " (f2 y) " m " (f2 (+ x (pt k))) " " (f2 (+ y 10 (pt (+ k 1)))) " " (f2 (+ x (pt (+ k 2)))) " " (f2 (+ y 20 (pt (+ k 3)))) " " (f2 x) " " (f2 (+ y 30)) " c S\n")))]
    (str (t 14 72 740 "Survey area")
         "0.35 0.25 0.15 RG 0.5 w\n"
         (apply str segs) (apply str vsegs)
         "0 g\n"
         (apply str (for [[k [x y n]] (map-indexed vector [[120 470 "Alder"] [200 500 "Brook"] [280 460 "Cairn"] [150 560 "Dale"] [240 600 "Elm"] [330 530 "Ford"] [180 650 "Glen"] [300 660 "Heath"]])]
                      (t 8 x y n)))
         (t 10 72 410 "Figure 5. Survey area")
         (t 11 72 380 "Closing paragraph after the map."))))

(defn illus-page []
  (let [circle (fn [cx cy r]
                 (let [k (* 0.5523 r)]
                   (str (f2 (+ cx r)) " " (f2 cy) " m "
                        (f2 (+ cx r)) " " (f2 (+ cy k)) " " (f2 (+ cx k)) " " (f2 (+ cy r)) " " (f2 cx) " " (f2 (+ cy r)) " c "
                        (f2 (- cx k)) " " (f2 (+ cy r)) " " (f2 (- cx r)) " " (f2 (+ cy k)) " " (f2 (- cx r)) " " (f2 cy) " c "
                        (f2 (- cx r)) " " (f2 (- cy k)) " " (f2 (- cx k)) " " (f2 (- cy r)) " " (f2 cx) " " (f2 (- cy r)) " c "
                        (f2 (+ cx k)) " " (f2 (- cy r)) " " (f2 (+ cx r)) " " (f2 (- cy k)) " " (f2 (+ cx r)) " " (f2 cy) " c h S\n")))]
    (str (t 14 72 740 "Ornament")
         "0.3 0.1 0.4 RG 1 w\n"
         (apply str (for [a (range 0 360 36)]
                      (circle (+ 300 (* 30 (Math/cos (Math/toRadians a)))) (+ 560 (* 30 (Math/sin (Math/toRadians a)))) 30)))
         (t 11 72 460 "Closing paragraph after the ornament."))))

(defn screenshot-page []
  (str (t 14 72 740 "Settings")
       "0.95 g 100 450 300 150 re f\n0.20 G 2 w 100 450 300 150 re S\n"
       "0 g BT /F1 12 Tf 110 578 Td (Preferences) Tj ET\n"
       "0.80 g 300 460 80 24 re f\n0 G 1 w 300 460 80 24 re S\n0 g BT /F1 10 Tf 326 468 Td (OK) Tj ET\n"
       (t 10 72 420 "Figure 7. Settings dialog")
       (t 11 72 390 "Closing paragraph after the dialog.")))

(def photo-data (byte-array (take (* 64 64 3) (map #(unchecked-byte (bit-and (bit-shift-right % 16) 255)) (lcg 3)))))
(def qrbits-data
  (byte-array (for [y (range 21) b (range 3)]
                (unchecked-byte (reduce (fn [acc k] (let [x (+ (* b 8) k)] (if (and (< x 21) (= 1 (bit-and (bit-shift-right (nth (lcg (+ 5 (* y 21) x)) 3) 16) 1))) (bit-or acc (bit-shift-right 128 k)) acc))) 0 (range 8))))))
(def barbits-data
  (byte-array (for [y (range 20) b (range 15)]
                (unchecked-byte (reduce (fn [acc k] (let [x (+ (* b 8) k)] (if (odd? (+ (quot x 2) (quot x 7))) (bit-or acc (bit-shift-right 128 k)) acc))) 0 (range 8))))))
(defn img-obj [w h cs bpc data] (stream (str "/Type /XObject /Subtype /Image /Width " w " /Height " h " /ColorSpace /" cs " /BitsPerComponent " bpc) data))

(def kinds-pages
  [(pie-page) (line-page) (barcode-page) (qr-page) (map-page) (illus-page) (screenshot-page)
   (str (t 14 72 740 "Photograph") "q 150 0 0 150 100 520 cm /Im1 Do Q\n" (t 10 72 490 "Figure 8. Site photograph") (t 11 72 460 "Closing paragraph after the photograph."))
   (str (t 14 72 740 "Code") "q 100 0 0 100 100 600 cm /Im1 Do Q\n" (t 10 72 570 "Figure 9. Scanned code") (t 11 72 540 "Closing paragraph after the code."))
   (str (t 14 72 740 "Label") "q 180 0 0 33 100 650 cm /Im1 Do Q\n" (t 10 72 620 "Figure 10. Scanned label") (t 11 72 590 "Closing paragraph after the label."))])

(def kinds-pdf
  (pdf (page-objs kinds-pages (vec (concat (repeat 7 "") ["/XObject << /Im1 IMG0 0 R >>" "/XObject << /Im1 IMG1 0 R >>" "/XObject << /Im1 IMG2 0 R >>"]))
                  [(img-obj 64 64 "DeviceRGB" 8 photo-data) (img-obj 21 21 "DeviceGray" 1 qrbits-data) (img-obj 120 20 "DeviceGray" 1 barbits-data)])))

;; what is NO figure: a sidebar of prose, a seal (two rings and a word) and a rule
(def notfig-page
  (let [circle (fn [cx cy r]
                 (let [k (* 0.5523 r)]
                   (str (f2 (+ cx r)) " " (f2 cy) " m "
                        (f2 (+ cx r)) " " (f2 (+ cy k)) " " (f2 (+ cx k)) " " (f2 (+ cy r)) " " (f2 cx) " " (f2 (+ cy r)) " c "
                        (f2 (- cx k)) " " (f2 (+ cy r)) " " (f2 (- cx r)) " " (f2 (+ cy k)) " " (f2 (- cx r)) " " (f2 cy) " c "
                        (f2 (- cx r)) " " (f2 (- cy k)) " " (f2 (- cx k)) " " (f2 (- cy r)) " " (f2 cx) " " (f2 (- cy r)) " c "
                        (f2 (+ cx k)) " " (f2 (- cy r)) " " (f2 (+ cx r)) " " (f2 (- cy k)) " " (f2 (+ cx r)) " " (f2 cy) " c h S\n")))]
    (str (t 14 72 740 "Things that are not figures")
         "0.93 g 100 560 300 110 re f\n0.4 G 1 w 100 560 300 110 re S\n0 g\n"
         (t 9 108 650 "A sidebar sets out a short note in a box beside the text of the page.")
         (t 9 108 636 "It holds whole sentences of prose and so it is read as text and not drawn.")
         (t 9 108 622 "Each of its lines has many words, which no label of a chart ever has.")
         (t 9 108 608 "A reader would take the box for a callout and the lines for body text.")
         "0.75 0.10 0.10 RG 2 w\n" (circle 480 400 60) (circle 480 400 45)
         "0.75 0.10 0.10 rg BT /F1 14 Tf 462 396 Td (PAID) Tj ET\n"
         "0 G 0.75 w 100 300 m 500 300 l S\n"
         (t 11 72 260 "Closing paragraph after a rule."))))
(def notfig-pdf (pdf (page-objs [notfig-page] [""] [])))

(def files {"fig-vector-chart.pdf" chart-pdf "fig-logo-pages.pdf" logo-pdf "fig-over-image.pdf" over-pdf
            "fig-kinds.pdf" kinds-pdf "fig-notfigures.pdf" notfig-pdf})

(if check?
  (let [bad (for [[n b] files :when (not (and (fs/exists? (str out "/" n)) (java.util.Arrays/equals ^bytes b ^bytes (fs/read-all-bytes (str out "/" n)))))] n)]
    (if (seq bad)
      (do (println "  FAIL asset-fig-fixtures --check: these differ from what this file writes:" (str/join " " bad)) (System/exit 1))
      (println "  ok   asset-fig-fixtures --check: the three figures fixtures are what this file writes")))
  (do (fs/create-dirs out)
      (doseq [[n b] files] (fs/write-bytes (str out "/" n) b) (println "  wrote" (str "test/assets/fig/" n) (alength ^bytes b) "bytes"))))
