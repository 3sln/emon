#!/bin/sh
# Do emon's LAWS hold, as a native test suite on every target?
#
#     kin/scripts/unit               all four arms
#     kin/scripts/unit go            one arm (go rust java csharp): the fast loop
#     kin/scripts/unit red [ARM]     the NEGATIVE CHECK: every law inverted,
#                                    and every arm must FAIL
#
# A gate: non-zero on any failure. DEVLOG P0.5, D044.
#
# A LAW is a kin function fed literal inputs (or a corpus file under `test/`)
# and checked against literal answers, in a source whose namespace requires
# `emon.test`. Written in kin it runs in FOUR languages, and a failure names a
# LAW and a sentence (and, for a corpus, a row) rather than an offset.
#
# FOUR ARMS. Go has `go test`, Rust `cargo test`, C# xunit. JAVA HAS A JDK HERE
# AND NO JUNIT, so its arm compiles the generated laws with a ~25-line
# reflection runner (below) that calls every public static no-argument
# `test*` method and counts the ones that do not throw (D044).
#
# THE FRAMEWORK DECIDES WHERE THE FILE LIVES AND kin DOES NOT: a test namespace
# emits an ordinary module and this puts it where each framework wants it (Go
# wants `_test.go`; emitting that directly would leave a Go package with no
# non-test file in it). WHICH NAMESPACES ARE LAWS IS DERIVED, not listed: a
# `kin/*.kin` whose `ns` form requires `emon.test`. `porttest` (a probe, D035)
# does not, so it is not one; adding a law file is adding a file.
#
# THE COUNT IS OF LAWS, and prints the same number in every arm; a differing
# count is a failure of its own (an arm that silently skipped a law).
#
# `unit red` sets EMON_TEST_INVERT=1, which every assertion honours by flipping
# its verdict: it proves a broken law FAILS on every target without editing a
# source (P0.5's "fails when the law is broken").
set -e
cd "$(dirname "$0")/../.."
repo=$(pwd)
emon_cap="$repo/kin/scripts/cap"

mode=normal
arms=all
case "${1:-all}" in
  all) ;;
  red) mode=red
       case "${2:-all}" in
         all) ;;
         go|rust|java|csharp) arms=$2 ;;   # one arm's negative check: the CI shards (D266)
         *) echo "unit: unknown arm $2 (go rust java csharp)"; exit 2 ;;
       esac ;;
  go|rust|java|csharp) arms=$1 ;;
  *) echo "unit: unknown arm $1 (go rust java csharp red)"; exit 2 ;;
esac
[ "$arms" = all ] && arms="go rust java csharp"

work=$(mktemp -d "${TMPDIR:-/tmp}/emon-unit.XXXXXX")
trap 'rm -rf "$work"' EXIT

./kin/scripts/emit > /dev/null

# THE NORMALIZATION TABLE IS GENERATED from the vendored UCD files, and a
# table that no longer says what its generator says is a law failing for a
# reason nobody would find: check it first. (The inflate corpus has no such
# check -- zlib's output differs between zlib versions, so the committed
# file is authoritative and the script only regenerates it, D046.)
command -v python3 > /dev/null && python3 kin/scripts/ucd.py --check
# THE PDF NAME TABLE (P1.4) is generated too, and checked the same way.
command -v python3 > /dev/null && python3 kin/scripts/pdfnames.py --check
# THE CATALOGUE READERS' NAME TABLE (P3.8, P3.9) is generated too, in babashka (D094), and checked the same way.
bb tools/pdfxnames.clj --check
# THE TAG-TREE READER'S NAME TABLE (P3.7, D148) likewise, and the synthetic tagged pairs it is tested on (a correctly
# tagged document and mis-tagged twins, written byte for byte by babashka, D150).
bb tools/pdfsnames.clj --check
bb tools/synth/tagged_pair.clj --check
# THE TRANSCRIPTS UNDER test/ (P10.9, D920): `kin/transcripttest.kin` reads every one the list names and writes it again through
# `emon.transcript`, to the same bytes, on all four targets. kin lists no directory, so the list is a file, held here to the tree.
bb tools/transcript_manifest.clj --check
# THE FONT TABLES (P1.6): the Adobe Glyph List, the encodings and the
# standard-14 metrics are generated from test/fonts/; the glyph-name and CMap
# row corpora are written by scripts (each cross-checked against pdfminer.six
# by hand, not here).
command -v python3 > /dev/null && python3 kin/scripts/fontdata.py --check
command -v python3 > /dev/null && python3 kin/scripts/font-names.py --check
command -v python3 > /dev/null && python3 kin/scripts/font-cmaps.py --check

# THE FONT LONG TAIL (P3.4, D140-D142; all babashka). The Adobe CMap resources and pdf.js's CFF and
# Macintosh glyph tables are FETCHED into .cache/ (not committed) and held to the checksums of
# test/fonts/cjk-sources.edn; the CJK tables (kin/cmap*.kin), the CFF/TrueType glyph tables
# (kin/fontextra.kin) and the program-font fixtures must be what those bytes make. Without the network
# (and without the cache) the checks that need them SKIP, loudly: a gate may skip a missing input, not
# fail quietly. The radical fold is made from vendored UCD files and always runs.
bb kin/scripts/radicals.clj --check
if bb kin/scripts/cjkfetch.clj; then
  bb kin/scripts/cjkdata.clj --check
  bb kin/scripts/fontextra.clj --check
  bb kin/scripts/font-prog-fixtures.clj --check
else
  echo "  SKIP cjkdata, fontextra, font-prog-fixtures -- the Adobe/pdf.js sources could not be fetched (kin/scripts/cjkfetch.clj)"
fi

# THE JSON GOLDENS' SECOND OPINION (P1.2): an independent serializer must
# reproduce every test/json golden, and each must validate against
# schema/emon-1.json. Tooling, not runtime (D054, D055).
command -v python3 > /dev/null && python3 kin/scripts/json-check.py

# THE HTML GOLDENS' SECOND OPINION (P1.9): an independent renderer reads the
# JSON goldens and must reproduce every test/html golden; each golden must
# parse with html5lib in strict mode (zero errors) and match the JSON's
# structure. Tooling, not runtime (D067).
command -v python3 > /dev/null && python3 kin/scripts/html-check.py

# THE ASSET GOLDENS (P3.13, D117): `test/asset/assets.{model,assets}`, its JSON and its HTML in four modes are what
# `kin/scripts/asset-golden` writes: the Model's scripts and the bytes the SPEC says they give, by an implementation
# that shares no code with kin (babashka). `kin/assettest.kin` holds js-emit and html-emit to those bytes.
bb kin/scripts/asset-golden --check

# THE SYNTHETIC GOLD (P2.8, D041, D063): the committed gold files validate
# against schema/emon-gold-1.json, equal what tools/synth/html2gold.clj says of
# the committed HTML, and MANIFEST.json matches the committed PDFs. No PDF
# producer and no PDF tool is invoked. Tooling, not runtime.
command -v python3 > /dev/null && python3 kin/scripts/gold-check.py

# THE ACCURACY SCORER'S OWN LAWS (P2.9, D077): hand-computed CER/WER, P/R/F1,
# heading-level, boundary and ledger cases; the ratchet's comparison rules;
# and the oracle predictor scoring perfect on real gold while the degraded
# fixture does not. `bb accuracy` itself is NOT a gate (D078).
bb -cp tools:tools/lib tools/accuracy/test_score.clj
# THE CALIBRATION'S OWN LAWS (P10.1, D370-D375): the reliability arithmetic (bins, ECE, Brier), the isotonic fit and its
# held-out selection, the lookup, the kin table, and what 'right' means per node kind, all by hand on hand-made Models.
bb -cp tools:tools/lib tools/accuracy/test_calib.clj
# THE FUSION TOOLS' OWN WITNESSES (P6.6, D206, D209): `bb fusion-report` on a hand-made evidence dump (win rates, rule and
# defence counts, pooled) and `bb fusion-live`'s stamp-ghost on hand-made words and boxes. Neither reads a corpus.
bb -cp tools:tools/lib tools/accuracy/fusion_report.clj --self-test
bb -cp tools:tools/lib tools/fusion/fusion_live.clj --self-test
# THE FUSION CORPUS (P6.6, D209; babashka, reads only committed files): the six hand-edited PDFs are what wm_pdf.clj makes of
# their sources, and every overlay scan's gold is what the document's gold plus scan-ovl/FACTS.json say.
bb -cp tools:tools/lib tools/synth/wm_pdf.clj check
# P7.6's hidden-text fixtures (agreeing and disagreeing older OCR layers under the same scan) are what hidden_pdf.clj makes.
bb -cp tools:tools/lib tools/synth/hidden_pdf.clj check
bb -cp tools:tools/lib -m synth.degrade-fusion --check
# THE GRAPHICS CORPUS (P6.8, D227; babashka, reads only committed files): the seven hand-made gfx-* PDFs, the sixteen tagged-table
# PDFs (and their verdicts) and the three mixed documents' HTML and generator rules are what their generators write, the scan
# twins' facts are what the seeds say, and the graphics metrics' own laws hold (hand-computed, then the oracle perfect on every
# document of the GRAPHICS set).
bb -cp tools:tools/lib tools/synth/gfx_pdf.clj --check
bb -cp tools:tools/lib tools/synth/tagged_tables.clj --check
bb -cp tools:tools/lib tools/synth/mixed.clj --check
bb -cp tools:tools/lib -m synth.degrade-graphics --check
bb -cp tools:tools/lib tools/accuracy/test_graphics.clj
# The rule truth is an ORACLE's (pdfplumber filtered by poppler's render, tools/oracle/rules.py): re-derived and compared when both
# are installed, skipped loudly when not (a gate may skip a missing input, not pass quietly).
if command -v pdftoppm > /dev/null && python3 -c 'import sys, os; sys.path.insert(0, os.path.expanduser("~/.cache/emon/pylib")); import pdfplumber' 2> /dev/null; then
  python3 tools/oracle/rules.py --check
else
  echo "  SKIP rules.py --check: pdfplumber (pip install --target ~/.cache/emon/pylib pdfplumber) or poppler is missing"
fi

# THE BIDI TABLES (D162) are generated from the vendored UCD files (class, brackets, mirroring), and the committed
# conformance rows are checked against them; the hand-written samples are what their script writes.
bb kin/scripts/bididata.clj --check
bb kin/scripts/bidi-samples.clj --check

# THE CONTENT INTERPRETER'S INDEPENDENT WITNESSES (P1.7, D101-D104; both babashka, both read only
# committed files): the hand-made PDFs and their exact-rational expectations are what the script writes,
# and the synthetic documents' glyph text is held to the text of the HTML they were printed from (and the
# fixtures' word boxes to poppler's, when `pdftotext` is installed).
kin/scripts/content-fixtures --check
kin/scripts/content-check

# THE PARAGRAPH STAGE'S INDEPENDENT WITNESS (P1.8, D134-D139; babashka, reads only committed files): the
# paragraphs of each golden Model in test/para are, in order, the text of the <h1>-<h6> and <p> of the HTML the
# document was printed from, with every page's milestone.
kin/scripts/para-check

# THE VISIBILITY FIXTURES (P3.5, P3.6, D152-D157): the PDFs and the by-hand expectation rows are what the babashka script writes
# (the colours of the colour-space fixture come from its second evaluator). The laws of kin/pdfvistest.kin are the gate.
kin/scripts/vis-fixtures --check

# THE ASSET FIXTURES (P3.12, D291-D293; babashka): the PDFs, source images and expectation rows of test/assets are what
# kin/scripts/asset-fixtures writes. It needs ImageMagick, pdfimages (poppler) and qpdf, and the ImageMagick that wrote the
# corpus (its encoders are in the bytes): without them it SKIPS, loudly. The laws of kin/pdfimagetest.kin are the gate.
if command -v magick > /dev/null && command -v pdfimages > /dev/null && command -v qpdf > /dev/null; then
  kin/scripts/asset-fixtures --check
else
  echo "  SKIP asset-fixtures --check: magick, pdfimages and qpdf are all needed (test/assets is read as committed)"
fi

# THE HEADING STAGE'S INDEPENDENT WITNESS (P4.2, P4.4, D167-D171; babashka, reads only committed files): the
# headings of each golden Model in test/heading are, in order, the headings of the synthetic gold (the HTML's
# own): text, level, number and numbering scheme; each is the first child of a section of its own level, and
# the sections nest by level.
kin/scripts/heading-check

tests=""
for f in kin/*.kin; do
  if grep -q '^ *(:require.*\[emon\.test\|^ *\[emon\.test ' "$f"; then
    tests="$tests $(basename "$f" .kin)"
  fi
done
if [ -z "$tests" ]; then
  echo "  FAIL no kin/*.kin requires emon.test"
  exit 1
fi

export EMON_TEST_DIR="$repo/test"
[ "$mode" = red ] && export EMON_TEST_INVERT=1

fails=0
counts=""

# finish <arm> <rc> <count> <output>
finish() {
  arm=$1; rc=$2; count=$3; out=$4
  if [ "$mode" = red ]; then
    if [ "$rc" -eq 124 ]; then
      echo "  FAIL $arm    timed out (a hang is not a failing law)"
      fails=$((fails+1))
    elif [ "$rc" -ne 0 ]; then
      echo "  ok   $arm    broken laws fail ($count laws inverted)"
    else
      echo "  FAIL $arm    every law was inverted and the arm still passed"
      fails=$((fails+1))
    fi
  elif [ "$rc" -eq 0 ]; then
    echo "  ok   $arm    $count laws"
    counts="$counts $count"
  elif [ "$rc" -eq 124 ]; then
    # kin/scripts/cap reports a watchdog kill as 124: say so, rather than a bare FAIL with no count.
    echo "  FAIL $arm    timed out (killed by kin/scripts/cap)"
    printf '%s\n' "$out" | sed 's/^/    /' | tail -10
    fails=$((fails+1))
  else
    echo "  FAIL $arm"
    printf '%s\n' "$out" | sed 's/^/    /' | head -40
    fails=$((fails+1))
  fi
}

# --- Go ---------------------------------------------------------------------
case "$arms" in *go*)
  if command -v go > /dev/null; then
    mkdir -p "$work/go"
    for m in $(ls gen/go); do
      mkdir -p "$work/go/$m"
      cp "gen/go/$m/$m.go" "$work/go/$m/"
    done
    mkdir -p "$work/go/port"
    cp host/go/port/*.go "$work/go/port/"
    printf 'module emon\n\ngo 1.21\n' > "$work/go/go.mod"
    pkgs=""
    for tns in $tests; do
      mv "$work/go/$tns/$tns.go" "$work/go/$tns/${tns}_test.go"
      pkgs="$pkgs ./$tns"
    done
    rc=0; out=$(cd "$work/go" && go test -v $pkgs 2>&1) || rc=$?
    n=$(printf '%s\n' "$out" | grep -c '^--- \(PASS\|FAIL\)' || true)
    finish go "$rc" "$n" "$out"
  else
    echo "  SKIP go     -- go not on PATH"
  fi ;;
esac

# --- Rust -------------------------------------------------------------------
# A CARGO CRATE, thrown away: `cargo test` is the harness, not rustc's.
case "$arms" in *rust*)
  if command -v cargo > /dev/null; then
    mkdir -p "$work/rust/src/emon"
    cp gen/rust/emon/*.rs "$work/rust/src/emon/"
    cp host/rust/src/port.rs host/rust/src/testport.rs "$work/rust/src/"
    ( for f in gen/rust/emon/*.rs; do echo "pub mod $(basename "$f" .rs);"; done
    ) > "$work/rust/src/emon.rs"
    printf 'pub mod emon;\npub mod port;\npub mod testport;\n' > "$work/rust/src/lib.rs"
    cat > "$work/rust/Cargo.toml" <<'TOML'
[package]
name = "emon"
version = "0.0.0"
edition = "2021"

[lib]
path = "src/lib.rs"
TOML
    # WARNINGS OFF so a failure is the first thing in the excerpt: a generator
    # that emits one shape for four languages leaves unused imports and
    # needless `mut`s, and forty lines of them in front of a panic hide it.
    rc=0; out=$(cd "$work/rust" && RUSTFLAGS="-A warnings" cargo test --offline -q -- --test-threads=1 2>&1) || rc=$?
    n=$(printf '%s\n' "$out" | sed -n 's/^test result: [a-zA-Z]*\. \([0-9]*\) passed; \([0-9]*\) failed.*/\1 \2/p' | awk '{n+=$1+$2} END {print n+0}')
    finish rust "$rc" "$n" "$out"
  else
    echo "  SKIP rust   -- cargo not on PATH"
  fi ;;
esac

# --- Java -------------------------------------------------------------------
# macOS's /usr/bin/javac is a STUB, so the test is that it RUNS (see check).
case "$arms" in *java*)
  JDK="${EMON_JDK:-/opt/homebrew/opt/openjdk}"
  [ -x "$JDK/bin/javac" ] || JDK=$(/usr/libexec/java_home 2>/dev/null || true)
  if [ -x "$JDK/bin/javac" ] && "$JDK/bin/javac" -version > /dev/null 2>&1; then
    mkdir -p "$work/java/emon"
    cp gen/java/emon/*.java host/java/emon/*.java "$work/java/emon/"
    cat > "$work/java/Runner.java" <<'RUNNER'
import java.lang.reflect.InvocationTargetException;
import java.lang.reflect.Method;
import java.lang.reflect.Modifier;
import java.util.Arrays;
import java.util.Comparator;

public class Runner {
    public static void main(String[] classes) throws Exception {
        int pass = 0, fail = 0;
        for (String name : classes) {
            Method[] ms = Class.forName("emon." + name).getDeclaredMethods();
            Arrays.sort(ms, Comparator.comparing(Method::getName));
            for (Method m : ms) {
                if (!Modifier.isPublic(m.getModifiers()) || !Modifier.isStatic(m.getModifiers())
                    || m.getParameterCount() != 0 || !m.getName().startsWith("test")) {
                    continue;
                }
                try {
                    m.invoke(null);
                    pass++;
                } catch (InvocationTargetException e) {
                    fail++;
                    System.out.println("FAIL " + name + "." + m.getName() + ": " + e.getCause());
                }
            }
        }
        System.out.println("laws: " + (pass + fail) + " passed: " + pass + " failed: " + fail);
        System.exit(fail == 0 ? 0 : 1);
    }
}
RUNNER
    cls=""
    for tns in $tests; do
      cls="$cls $(printf '%s' "$tns" | awk '{print toupper(substr($0,1,1)) substr($0,2)}')"
    done
    rc=0
    out=$(cd "$work/java" && "$JDK/bin/javac" -encoding UTF-8 -d . emon/*.java Runner.java 2>&1 \
          && "$JDK/bin/java" -cp . Runner $cls 2>&1) || rc=$?
    n=$(printf '%s\n' "$out" | sed -n 's/^laws: \([0-9]*\) .*/\1/p')
    finish java "$rc" "${n:-0}" "$out"
  else
    echo "  SKIP java   -- no working JDK found (set EMON_JDK)"
  fi ;;
esac

# --- C# ---------------------------------------------------------------------
case "$arms" in *csharp*)
  if command -v dotnet > /dev/null; then
    mkdir -p "$work/cs"
    cp gen/csharp/Emon/*.cs "$work/cs/"
    cp gen/csharp/Tests/*.cs "$work/cs/"
    cp host/csharp/Emon/*.cs "$work/cs/"
    cat > "$work/cs/cs.csproj" <<'PROJ'
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1717;CS0164;CS0162;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Include="xunit" Version="2.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.*" />
  </ItemGroup>
</Project>
PROJ
    # RELEASE, NOT DEBUG: the arm is 379 laws and two of them (the 512-byte async source over the real PDFs, and the
    # glyph streams pdfminer agreed with) are tight loops over megabytes of PDF. Unoptimised (Debug) they took 9.5 and 3.2
    # minutes of a 13.5-minute arm (measured, D217): the whole arm sat near the 900 s cap and, on a loaded machine
    # with the other arms before it, went over it. Optimised, the same two take under 50 s together and the arm
    # about 1.5 minutes. The cap stays at 900 s: it is now a hang detector with ten times the headroom.
    rc=0; out=$(cd "$work/cs" && "$emon_cap" 900 dotnet test -c Release -v q --nologo 2>&1) || rc=$?
    n=$(printf '%s\n' "$out" | grep -o '\(Passed\|Failed\): *[0-9]*' | grep -o '[0-9]*$' | awk '{n+=$1} END {print n+0}')
    finish csharp "$rc" "$n" "$out"
  else
    echo "  SKIP csharp -- dotnet not on PATH"
  fi ;;
esac

[ "$fails" -eq 0 ] || exit 1
if [ "$mode" != red ]; then
  distinct=$(printf '%s\n' $counts | sort -u | wc -l | tr -d ' ')
  if [ "$distinct" -gt 1 ]; then
    echo "  FAIL the arms ran different numbers of laws:$counts"
    exit 1
  fi
  echo "  ok   one law set, every arm, one count"
fi
