#!/bin/sh
# Build the Go Engine and its driver; print the driver's path.   kin/scripts/emon-go-build
#
# The Go twin of `emon-rs-build` (DEVLOG P2.1). The module is ASSEMBLED, not committed:
#
#     .cache/emon-go/<ns>/*.go        gen/go/<ns>/, every package that is NOT a law or a probe (names ending
#                                     `test` or `probe`)
#     .cache/emon-go/port/            host/go/port/ without `testport.go` (test support is not the library)
#     .cache/emon-go/pngenc/          host/go/pngenc/ (links the canonical PNG encoder in; the driver's
#                                     transcript writer needs it, the Engine does not)
#     .cache/emon-go/*.go             host/go/*.go: the root package `emon` (source, model, engine)
#     .cache/emon-go/cmd/emon-go/     test/driver/go/main.go, the `emon-go` binary
#
# `.cache/` is gitignored. A file is copied only when it differs; a package no longer generated is removed.
# `bb emit` is NOT run here: callers that must be current run it first.
set -e
cd "$(dirname "$0")/../.."
mod=.cache/emon-go
mkdir -p "$mod/port" "$mod/pngenc" "$mod/cmd/emon-go"

put() { cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"; }

keep=""
for d in gen/go/*/; do
  m=$(basename "$d")
  case "$m" in *test|*probe) continue ;; esac
  keep="$keep $m"
  mkdir -p "$mod/$m"
  for f in "$d"*.go; do put "$f" "$mod/$m/$(basename "$f")"; done
done
for d in "$mod"/*/; do
  m=$(basename "$d")
  case "$m" in port|pngenc|cmd) continue ;; esac
  case " $keep " in *" $m "*) ;; *) rm -rf "$d" ;; esac
done
for f in host/go/port/*.go; do
  case "$f" in */testport.go) continue ;; esac
  put "$f" "$mod/port/$(basename "$f")"
done
put host/go/pngenc/pngenc.go "$mod/pngenc/pngenc.go"
for f in host/go/*.go; do put "$f" "$mod/$(basename "$f")"; done
put test/driver/go/main.go "$mod/cmd/emon-go/main.go"
printf 'module emon\n\ngo 1.21\n' > "$mod/go.mod.new"
put "$mod/go.mod.new" "$mod/go.mod"
rm -f "$mod/go.mod.new"

out=$(cd "$mod" && go build -o emon-go ./cmd/emon-go 2>&1) || { echo "$out" | head -80 >&2; echo "emon-go: build failed" >&2; exit 1; }
[ -z "$out" ] || echo "$out" >&2
echo "$mod/emon-go"
