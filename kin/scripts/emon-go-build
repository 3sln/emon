#!/bin/sh
# Build the Go Engine and its driver; print the driver's path.   kin/scripts/emon-go-build
#
# The Go twin of `emon-rs-build` (DEVLOG P2.1). The module is ASSEMBLED, not committed:
#
#     .cache/emon-go/<ns>/*.go        gen/go/<ns>/, every package that is NOT a law or a probe (names ending
#                                     `test` or `probe`)
#     .cache/emon-go/port/            host/go/port/ without `testport.go` (test support is not the library)
#     .cache/emon-go/pngenc/          host/go/pngenc/ (links the canonical PNG encoder in; the driver's
#                                     transcript writer needs it, the Engine does not)
#     .cache/emon-go/planrun/         host/go/planrun/ (the driver of kin's plan machine: not in `port`, whose package the generated
#                                     `planloop` imports)
#     .cache/emon-go/*.go             host/go/*.go: the root package `emon` (source, model, engine, imgdec)
#     .cache/emon-go/cmd/emon-go/     test/driver/go/main.go, the `emon-go` binary
#
# `.cache/` is gitignored. A file is copied only when it differs; a package no longer generated is removed.
# `bb emit` is NOT run here: callers that must be current run it first.
set -e
cd "$(dirname "$0")/../.."
# LIVE (D211): EMON_GO_LIVE=1 builds the same module with the `tesseract` build tag (the cgo adapter of the Ocr port, linked to
# libtesseract and libleptonica) into .cache/emon-go-live; it is NOT a gate's (a gate replays a transcript). EMON_TESS_LIB is the
# directory of the libraries (default /opt/homebrew/lib).
mod=.cache/emon-go
tags=""
if [ "${EMON_GO_LIVE:-}" = 1 ]; then mod=.cache/emon-go-live; tags="-tags tesseract"; fi
mkdir -p "$mod/port" "$mod/pngenc" "$mod/planrun" "$mod/cmd/emon-go"

put() { cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"; }

keep=""
for d in gen/go/*/; do
  m=$(basename "$d")
  case "$m" in *test|*probe) continue ;; esac
  keep="$keep $m"
  mkdir -p "$mod/$m"
  for f in "$d"*.go; do put "$f" "$mod/$m/$(basename "$f")"; done
done
for d in "$mod"/*/; do
  m=$(basename "$d")
  case "$m" in port|pngenc|planrun|cmd) continue ;; esac
  case " $keep " in *" $m "*) ;; *) rm -rf "$d" ;; esac
done
for f in host/go/port/*.go; do
  case "$f" in */testport.go) continue ;; esac
  put "$f" "$mod/port/$(basename "$f")"
done
put host/go/pngenc/pngenc.go "$mod/pngenc/pngenc.go"
put host/go/planrun/planrun.go "$mod/planrun/planrun.go"
for f in host/go/*.go; do put "$f" "$mod/$(basename "$f")"; done
put test/driver/go/main.go "$mod/cmd/emon-go/main.go"
printf 'module emon\n\ngo 1.21\n' > "$mod/go.mod.new"
put "$mod/go.mod.new" "$mod/go.mod"
rm -f "$mod/go.mod.new" "$mod/go.sum"

if [ -n "$tags" ]; then export CGO_ENABLED=1 CGO_LDFLAGS="-L${EMON_TESS_LIB:-/opt/homebrew/lib} ${CGO_LDFLAGS:-}"; fi
out=$(cd "$mod" && go build $tags -o emon-go ./cmd/emon-go 2>&1) || { echo "$out" | head -80 >&2; echo "emon-go: build failed" >&2; exit 1; }
[ -z "$out" ] || echo "$out" >&2
# a cgo binary the external linker signed on macOS can fail its own signature check (SIGKILL at launch): sign it again
if [ -n "$tags" ] && [ "$(uname)" = Darwin ]; then codesign -s - -f "$mod/emon-go" > /dev/null 2>&1 || true; fi
echo "$mod/emon-go"
