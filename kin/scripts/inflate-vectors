#!/usr/bin/env bb
;; The streams of the P10.3a laws in kin/inflatetest.kin (D880), rebuilt and CHECKED against the JDK's zlib
;; (java.util.zip.Inflater, the reference): a hand-built dynamic block with a code of length 15, the stored + fixed +
;; dynamic stream, the longest match, the tail that copies from the maximum distance, and two streams that end in
;; an unassigned distance code. The dynamic zlib stream of the first law came from CPython's zlib.compress(level 9)
;; and is checked here as it stands in the law file.     bb kin/scripts/inflate-vectors
(require '[clojure.string :as str])
(import '(java.util.zip Inflater))

(defn hex [bs] (apply str (map #(format "%02x" (bit-and % 255)) bs)))
(defn unhex [s] (byte-array (map #(unchecked-byte (Integer/parseInt (apply str %) 16)) (partition 2 s))))

(defn inflate [bs nowrap]
  (let [inf (Inflater. nowrap) out (java.io.ByteArrayOutputStream.) buf (byte-array 65536)]
    (.setInput inf bs)
    (loop []
      (let [n (.inflate inf buf)]
        (.write out buf 0 n)
        (when (and (pos? n) (not (.finished inf))) (recur))))
    (when-not (.finished inf) (throw (ex-info "stream did not finish" {})))
    (.toByteArray out)))

;; DEFLATE bit writer: numbers LSB first, Huffman codes MSB first
(defn bw [] (atom []))
(defn num! [w v n] (swap! w into (for [i (range n)] (bit-and (bit-shift-right v i) 1))))
(defn code! [w v n] (swap! w into (for [i (range (dec n) -1 -1)] (bit-and (bit-shift-right v i) 1))))
(defn bytes! [w]
  (let [b (vec (concat @w (repeat (mod (- (count @w)) 8) 0)))]
    (byte-array (for [i (range 0 (count b) 8)] (unchecked-byte (reduce + (for [j (range 8)] (bit-shift-left (nth b (+ i j)) j))))))))

(def law-file (slurp "kin/inflatetest.kin"))

;; A. the dynamic zlib stream in the law file
(let [h (second (re-find #"hex-blob \"(78da[0-9a-f]+)\"" law-file))
      out (inflate (unhex h) false)]
  (assert (= 729 (count out)))
  (println "A dynamic zlib" (/ (count h) 2) "bytes ->" (count out) "bytes, first" (hex (take 12 out)) "(Adler-32 checked)"))

;; B. dynamic block, literal/length lengths 1..14 for bytes 0..13, 15 for 256 and 257, one distance code of length 1
(def lens (vec (concat (map inc (range 14)) (repeat (- 256 14) 0) [15 15 1])))
(def nlen 258)
(def cl-syms (vec (sort (concat (range 1 16) [18]))))
(def cl-code (zipmap cl-syms (range)))
(def order [16 17 18 0 8 7 9 6 10 5 11 4 12 3 13 2 14 1 15])
(defn dyn-header []
  (let [w (bw)]
    (num! w 1 1) (num! w 2 2) (num! w (- nlen 257) 5) (num! w 0 5) (num! w (- 19 4) 4)
    (doseq [s order] (num! w (if (contains? cl-code s) 4 0) 3))
    (loop [i 0]
      (when (< i (count lens))
        (let [l (nth lens i)]
          (if (zero? l)
            (let [run (min 138 (count (take-while zero? (drop i lens))))]
              (code! w (cl-code 18) 4) (num! w (- run 11) 7) (recur (+ i run)))
            (do (code! w (cl-code l) 4) (recur (inc i)))))))
    w))
(def codes
  (let [by-len (group-by lens (filter #(pos? (lens %)) (range nlen)))]
    (loop [l 1 code 0 m {}]
      (if (> l 15) m
          (let [syms (get by-len l [])]
            (recur (inc l) (* 2 (+ code (count syms)))
                   (into m (map-indexed (fn [i s] [s [(+ code i) l]]) syms))))))))
(defn emit-sym! [w s] (let [[c l] (codes s)] (code! w c l)))
(def dB-msg [0 1 2 13 5 13 13 0 7 12 3])
(def dB
  (let [w (dyn-header)]
    (doseq [s dB-msg] (emit-sym! w s))
    (emit-sym! w 256)
    (bytes! w)))
(assert (= (seq (map byte dB-msg)) (seq (inflate dB true))))
(println "B len-15 dynamic raw" (count dB) "bytes; codes of 13 and 256:" (codes 13) (codes 256))
(println "  stream:" (hex dB))
(println "  output:" (hex (byte-array dB-msg)))

;; F. the same code, a match symbol, then the unassigned distance code '1'
(doseq [[name pad] [["F1 padded" 20] ["F2 short" 2]]]
  (let [w (dyn-header)]
    (doseq [s [0 1 2 257]] (emit-sym! w s))
    (code! w 1 1) (num! w 0 pad)
    (println name "stream:" (hex (bytes! w)) "(raw; zlib refuses it too)"
             (try (inflate (bytes! w) true) "NOT REFUSED" (catch Exception _ "refused")))))

;; C. stored (flushed) + fixed (flushed) + B, from the law file, checked as it stands
(let [h (second (re-find #"hex-blob \"(001600e9ff[0-9a-f]+)\"" law-file))
      out (inflate (unhex h) true)]
  (println "C mixed raw" (/ (count h) 2) "bytes ->" (count out) "bytes:" (hex out)))

;; D. the maximum distance: 32768 stored bytes, then a fixed block copying 3 bytes from distance 32768
(def tail-d
  (let [w (bw)]
    (num! w 1 1) (num! w 1 2) (code! w 1 7) (code! w 29 5) (num! w (- 32768 24577) 13) (code! w 0 7)
    (bytes! w)))
(let [data (byte-array (for [i (range 32768)] (unchecked-byte (+ (* i 7) (quot i 256)))))
      stored (byte-array (concat [0x00 0x00 0x80 0xff 0x7f] data tail-d))
      out (inflate stored true)]
  (assert (= (+ 32768 3) (count out)))
  (assert (= (seq (take 3 data)) (seq (drop 32768 out))))
  (println "D max distance tail:" (hex tail-d)))
(let [data (byte-array (for [i (range 32767)] (unchecked-byte (+ (* i 7) (quot i 256)))))
      stored (byte-array (concat [0x00 0xff 0x7f 0x00 0x80] data tail-d))]
  (println "D2 one byte of history short:" (try (inflate stored true) "NOT REFUSED" (catch Exception _ "refused (distance too far back)"))))

;; E. 'x' then the longest match (symbol 285, no extra bits) at distance 1
(let [w (bw)]
  (num! w 1 1) (num! w 1 2) (code! w (+ 0x30 (int \x)) 8) (code! w 2r11000101 8) (code! w 0 5) (code! w 0 7)
  (let [d (bytes! w)]
    (assert (= 259 (count (inflate d true))))
    (println "E longest match raw:" (hex d))))
