#!/usr/bin/env bb
;; FUSION on born-digital pages, replayed from transcripts: recorded on Rust (pdfium and Tesseract), replayed on Rust and Go through the
;; whole Engine.   kin/scripts/fusion     (DEVLOG P7.3, D285-D290; P7.S, D200, D201, D222, D363-D369)
;;
;; THE LIVE ENGINES ARE NOT HERE. `tools/fusion/record-replay.clj` converted each document of the fusion set with the Engine's DEFAULT settings
;; (`ocr: always`: since P7.S the born-digital pages are OCR'd), pdfium rendering every page and Tesseract reading it, and committed what they
;; answered (test/fusion/replay/ID/transcript.edn, slim: no bitmap; recorded `--no-retarget`, so that a replay, which reads no pixel, asks what
;; the recording asked) with the SHA-256 of the replay's bundle (test/fusion/replay/DIGESTS.edn). This gate only REPLAYS, so it tests emon and
;; never whose pdfium or Tesseract is installed (SPEC 7.3). It holds:
;;
;;   1. IDENTITY: the Rust Engine and the Go Engine replay every transcript to the identical bundle (JSON, HTML, evidence dump version
;;      "2": the correspondence groups, the verdicts and the rules that made them), and it is the bundle the recording made; so do the Java
;;      Engine, the C# Engine and (P9.5, D1240) the C binding when their toolchains are there (each is left out LOUDLY without one; the pod has no
;;      transcript to replay);
;;   2. A REPLAY NEVER GUESSES: a changed OCR request is `transcript-miss` on both;
;;   3. NO ENGINE, NO CHANGE: the default policy with no transcript and no port (every `render` and `ocr` answered `unsupported`) converts
;;      to exactly the bundle of a `--ocr=never` run, on both Engines (the fusion stages do nothing when no answer came: G1, D201);
;;   4. THE BORN-DIGITAL CONTRACT (SPEC 9.4, D201): every verdict that gave a group to OCR is one of the rules that may (a bad glyph of
;;      the word's own, an unhealthy font, an admitted OCR-only word), and `tl-override` (the share of body characters under
;;      `text-layer-suspect`) is zero on every document that has no broken encoding;
;;   5. ACCURACY: per document, the CER of the fused Model is no worse than the no-engine Model's plus 0.0005 (D201 G2), the documents whose
;;      encoding is broken (`tl-broken-shift`, `tl-broken-unmapped`) drop sharply, THE GRAPHICS CONTRACT (D222: the tables of an image-free
;;      document are the no-engine run's, cell for cell, text, scope, spans and boxes), and the scoreboard's `emon-fusion` entry holds.
;;      The per-source win rates and per-rule counts of the dumps are printed (`bb fusion-report`'s analysis; they describe, they do not gate).
(require '[babashka.fs :as fs]
         '[babashka.classpath :as cp]
         '[babashka.process :refer [process]]
         '[cheshire.core :as json]
         '[clojure.string :as str])
(cp/add-classpath "tools")
(cp/add-classpath "tools/lib")
(require '[accuracy.accuracy :as A]
         '[accuracy.fusion-report :as FR])

(def fails (atom 0))
(defn ok [& xs] (println (str "  ok   " (apply str xs))))
(defn bad [& xs] (swap! fails inc) (println (str "  FAIL " (apply str xs))))
(defn check [pass? & msg] (if pass? (apply ok msg) (apply bad msg)))

(def abs #(str (fs/absolutize %)))
(def replay-dir "test/fusion/replay")
(def ids (when (fs/exists? replay-dir)
           (vec (sort (map fs/file-name (filter #(fs/exists? (str % "/transcript.edn")) (fs/list-dir replay-dir)))))))
(def digests (let [f (str replay-dir "/DIGESTS.edn")] (if (fs/exists? f) (read-string (slurp f)) {})))
(def broken #{"tl-broken-shift" "tl-broken-unmapped"})

(defn sha256 [s]
  (let [md (java.security.MessageDigest/getInstance "SHA-256")]
    (apply str (map #(format "%02x" (bit-and % 0xff)) (.digest md (.getBytes ^String s "UTF-8"))))))

(defn build-driver [script env what]
  (let [r @(process {:out :string :err :string :extra-env env} script)]
    (if (zero? (:exit r))
      (str/trim (:out r))
      (do (bad "the " what " Engine driver did not build:\n" (:err r)) nil))))

(def work (str (fs/create-temp-dir {:prefix "emon-fusion."})))
(.addShutdownHook (Runtime/getRuntime) (Thread. (fn [] (fs/delete-tree work))))

(def rdrv (when (fs/which "cargo") (build-driver "kin/scripts/emon-rs-build" {} "Rust")))
(def gdrv (when (fs/which "go") (build-driver "kin/scripts/emon-go-build" {} "Go")))
(when-not rdrv (println "  SKIP rust engine -- cargo not on PATH"))
(when-not gdrv (println "  SKIP go engine   -- go not on PATH"))
;; THE JAVA ENGINE (P9.1, D449) replays the same transcripts: optional, left out LOUDLY without a JDK 22+ (`emon-java-build` exits 3);
;; EMON_SKIP_JAVA=1 leaves it out on purpose
(def jdrv
  (if (System/getenv "EMON_SKIP_JAVA")
    (do (println "  SKIP java engine -- EMON_SKIP_JAVA is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-java-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the Java arm is left out)")) nil)
        (do (bad "the Java Engine driver did not build:\n" (:err r)) nil)))))
;; THE C# ENGINE (P9.2, D457) replays the same transcripts: optional, left out LOUDLY without a .NET 8+ SDK (`emon-cs-build` exits 3);
;; EMON_SKIP_CSHARP=1 leaves it out on purpose
(def cdrv
  (if (System/getenv "EMON_SKIP_CSHARP")
    (do (println "  SKIP csharp engine -- EMON_SKIP_CSHARP is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-cs-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the C# arm is left out)")) nil)
        (do (bad "the C# Engine driver did not build:\n" (:err r)) nil)))))

;; THE C BINDING (P9.5, D1240) replays them as well (the step API with a replayed transcript): optional, left out LOUDLY without a C compiler (EMON_SKIP_C=1 on purpose);
;; the pod has no transcript to replay
(cp/add-classpath "tools/lib")
(require '[extra-hosts :as xh])
(def cbind (first (xh/engines {:hosts [:c] :on-fail bad})))

(defn drive [drv & a]
  (let [r @(apply process {:out :string :err :string} (abs drv) (map str a))]
    {:exit (:exit r) :out (:out r) :err (:err r)}))
(defn same? [a b] (and (= (:exit a) (:exit b)) (= (:out a) (:out b)) (= (:err a) (:err b))))

(when (and rdrv gdrv (seq ids))
  (let [pdf #(abs (str "test/corpus/synth/pdf/" % ".pdf"))
        dir #(abs (str replay-dir "/" %))
        flag "--ocr=always"]
    ;; 1-3: identity, no guessing, no engine --------------------------------------------------------------------------------------
    (doseq [id ids]
      (let [rr (drive rdrv flag "--out=bundle" (str "--replay=" (dir id)) (pdf id))
            rg (drive gdrv flag "--out=bundle" (str "--replay=" (dir id)) (pdf id))
            want (get digests id)]
        (check (and (zero? (:exit rr)) (same? rr rg))
               id ": the Rust Engine and the Go Engine replay the committed transcript to the IDENTICAL bundle (" (count (:out rr))
               " bytes: JSON, HTML, evidence version 2)")
        (when jdrv
          (let [rj (drive jdrv flag "--out=bundle" (str "--replay=" (dir id)) (pdf id))]
            (check (same? rr rj)
                   id ": THE JAVA ENGINE replays it to the identical bundle too (fusion over real pdfium and Tesseract answers)")))
        (when cdrv
          (let [rc (drive cdrv flag "--out=bundle" (str "--replay=" (dir id)) (pdf id))]
            (check (same? rr rc)
                   id ": THE C# ENGINE replays it to the identical bundle too (fusion over real pdfium and Tesseract answers)")))
        (when cbind
          (let [rc (drive (:drv cbind) flag "--out=bundle" (str "--replay=" (dir id)) (pdf id))]
            (check (same? rr rc)
                   id ": THE C BINDING replays it to the identical bundle too (the step API over a transcript of real pdfium and Tesseract answers)")))
        (check (and want (= want (sha256 (:out rr))))
               id ": and it is the bundle the live recording made (SHA-256 " (when want (subs want 0 12)) ")")
        (let [edn (slurp (str (dir id) "/transcript.edn"))
              tam (str work "/tamper-" id)]
          (fs/create-dirs tam)
          (spit (str tam "/transcript.edn") (str/replace edn #"(:kind :ocr :req \[\d+ 3 \d+ \d+ )3 " (fn [[_ p]] (str p "4 "))))
          (let [tr (drive rdrv flag "--out=bundle" (str "--replay=" tam) (pdf id))
                tg (drive gdrv flag "--out=bundle" (str "--replay=" tam) (pdf id))
                tx (for [d [jdrv cdrv (:drv cbind)] :when d] (drive d flag "--out=bundle" (str "--replay=" tam) (pdf id)))]
            (check (and (not= edn (slurp (str tam "/transcript.edn")))
                        (= 4 (:exit tr)) (= 4 (:exit tg))
                        (str/includes? (:err tr) "error: transcript-miss") (str/includes? (:err tg) "error: transcript-miss")
                        (every? #(and (= 4 (:exit %)) (str/includes? (:err %) "error: transcript-miss")) tx))
                   id ": a changed request (psm 3 -> 4) is transcript-miss on both Engines" (when (seq tx) " and on every other host that is here") ", nothing guessed")))
        (let [nr (drive rdrv flag "--out=bundle" (pdf id))
              ng (drive gdrv flag "--out=bundle" (pdf id))
              pr (drive rdrv "--ocr=never" "--out=bundle" (pdf id))
              pg (drive gdrv "--ocr=never" "--out=bundle" (pdf id))]
            (check (and (zero? (:exit nr)) (same? nr ng) (same? nr pr) (same? ng pg))
                 id ": with no engine the policy changes nothing: the default run's bundle is the `--ocr=never` run's (G1, D201), the same on both")
          ;; and on the other hosts, and on the pod, which has no transcript but converts: the default run is theirs too
          (doseq [{:keys [label drv]} (concat (when jdrv [{:label "Java" :drv jdrv}]) (when cdrv [{:label "C#" :drv cdrv}]) (when cbind [cbind]))]
            (check (and (same? nr (drive drv flag "--out=bundle" (pdf id))) (same? pr (drive drv "--ocr=never" "--out=bundle" (pdf id))))
                   id ": and the " label " host gives the same bundle with no engine, under the default policy and under `--ocr=never`")))))
    ;; 4-5: the contract and the accuracy ------------------------------------------------------------------------------------------
    (let [idset (set ids)
          _ (alter-var-root #'A/*variants* (constantly #{"pdf"}))
          _ (alter-var-root #'A/*ids* (constantly idset))
          [_ base] (A/evaluate (A/PREDICTORS "emon"))
          [_ fused] (A/evaluate (A/PREDICTORS "emon-fusion"))
          m (fn [per id k] (get (get per (str "pdf/" id)) k))
          tol 0.0005]
      (doseq [id ids]
        (let [b (m base id "cer")
              f (m fused id "cer")]
          (check (and b f (<= f (+ b tol)))
                 (format "%s: CER %.4f fused against %.4f with no engine (no worse than +%.4f)" id (double (or f -1)) (double (or b -1)) tol))))
      (doseq [id (remove broken ids)]
        (let [t (m fused id "tl-override")]
          (check (or (nil? t) (zero? t))
                 id ": tl-override " (if t (format "%.4f" (double t)) "absent") " (no text-layer word was overridden: its encoding is sound)")))
      (doseq [id (filter broken ids)]
        (let [b (m base id "cer") f (m fused id "cer")]
          (check (and b f (< f (* 0.5 b)))
                 (format "%s: OCR now wins where the encoding is broken: CER %.4f -> %.4f" id (double b) (double f)))))
      ;; P7.6: the older OCR layer under a scan (D320): the fused CER is under 0.02 and under the hidden layer alone's (the no-engine run's)
      (when (contains? idset "hidden-older-ocr")
        (let [b (m base "hidden-older-ocr" "cer") f (m fused "hidden-older-ocr" "cer")]
          (check (and b f (<= f 0.02) (< f b))
                 (format "hidden-older-ocr: CER %.4f fused, at most 0.02 and below the hidden layer alone's %.4f" (double (or f -1)) (double (or b -1))))))
      ;; win rates and rule counts, from the dumps (descriptions)
      (let [an (for [id ids
                     :let [r (drive rdrv flag "--out=evidence" (str "--replay=" (dir id)) (pdf id))]
                     :when (zero? (:exit r))]
                 [id (FR/analyse (FR/parse-dump (:out r)))])
            pooled (FR/pool (map second an))]
        (ok (format "%d groups with both candidates over %d documents; win rates %s"
                    (:both pooled) (count an)
                    (str/join " " (for [[s r] (FR/win-rates pooled)] (format "%s %.4f" s r)))))
        (ok "rules (fv): " (str/join " " (for [[k v] (sort-by (comp str key) (:rules pooled))] (str k "=" v))))
        (ok "defences (fa, P7.5): " (if (seq (:defences pooled))
                                      (str/join " " (for [[k v] (sort-by (comp str key) (:defences pooled))] (str "defence-" k "=" v " rows")))
                                      "none")
            "; reasons: " (str/join " " (for [[k v] (sort-by (comp str key) (:reasons pooled))] (str k "=" v))))
        (let [ocr-rules (set (for [[id a] an] [id (set (keys (select-keys (:rules a) [120 130 140 141])))]))]
          (check (every? (fn [[_ a]] (every? #{101 102 110 111 112 120 130 140 141 145 150 170 175 176 177 178 190 201 202 203 205 211 221 222 231 232 251 252 301 310 311 315 316 321 322 323 330 331 332 401 402} (keys (:rules a)))) an)
                 "every verdict of every dump is a rule of the table"))
        (doseq [[id a] an]
          (let [w (FR/win-rates a)]
            (when (and w (get w "ocr"))
              (ok (format "%s: OCR won %.4f of %d decided groups with both candidates" id (double (get w "ocr")) (:decided a)))))))
      ;; THE GRAPHICS CONTRACT (D222, P7.G): on a born-digital page without images every table is the one the vector source alone gives, i.e. the one the
      ;; no-engine run makes: every table of the fused Model equals the plain run's, cell for cell (text, header scope, spans, box), with only the ids and
      ;; the provenance and confidence left out.
      (letfn [(strip [n] (cond (map? n) (into {} (for [[k v] n :when (not (#{"id" "src" "conf"} k))] [k (strip v)]))
                               (sequential? n) (mapv strip n)
                               :else n))
              (tables [n] (cond (map? n) (concat (when (= "table" (get n "kind")) [(strip n)]) (mapcat tables (vals n)))
                                (sequential? n) (mapcat tables n)))]
        (doseq [id ids]
          (let [plain (drive rdrv "--ocr=never" "--out=json" (pdf id))
                fusedm (drive rdrv "--out=json" (str "--replay=" (dir id)) (pdf id))
                ev (drive rdrv "--ocr=never" "--out=evidence" (pdf id))
                nimg (count (get (json/parse-string (:out ev)) "images"))
                tp (tables (json/parse-string (:out plain)))
                tf (tables (json/parse-string (:out fusedm)))]
            (when (and (zero? nimg) (seq tp))
              (check (= tp tf)
                     id ": graphics contract: the " (count tp) " table(s) of an image-free born-digital document are the vector source's, cell for cell, under fusion")))))
      ;; the ratchet
      (let [r @(process {:out :string :err :string} "bb" "tools/accuracy/accuracy.clj" "--predictor" "emon-fusion" "--variants" "pdf"
                        "--ids" (str/join "," ids))]
        (check (and (zero? (:exit r)) (str/includes? (:out r) "accuracy[emon-fusion]") (not (str/includes? (:out r) "FAIL")))
               "accuracy[emon-fusion]: the committed transcripts, replayed, hold their scoreboard entry"
               (when-let [l (some #(when (str/includes? % "accuracy[emon-fusion]") (str/trim %)) (str/split-lines (:out r)))]
                 (str " (" (str/replace l #"^ok +accuracy\[emon-fusion\]: " "") ")")))))))

;; THE HIDDEN-TEXT FIXTURES (P7.6, D320-D323): a scan with an older OCR layer under it (render mode 3), the layer agreeing with a new OCR's reading
;; (`hidden-exact-ocr`) and disagreeing with it (`hidden-noisy-ocr`), test/fusion/hidden/NAME/{doc.pdf,gold.txt,transcript.edn} (tools/synth/hidden_pdf.clj
;; makes them and `bb unit` checks it). Held on both Engines: one bundle; the fused text's character error rate against the layer's own words below the
;; hidden layer alone's, within 0.005 of the new OCR's alone (the words of the evidence dump) and under 0.02; and the rules say what happened: an agreeing layer is
;; decided by rows 310 and 311 (the hidden text, or the engine's segmentation of it), a disagreeing one by 322 (the engine's words) in the main.
(defn lev [a b]
  (let [a (vec a) b (vec b)]
    (peek (reduce (fn [prev ca]
                    (reduce (fn [cur j]
                              (conj cur (min (inc (prev j)) (inc (peek cur)) (+ (prev (dec j)) (if (= ca (b (dec j))) 0 1)))))
                            [(inc (first prev))]
                            (range 1 (inc (count b)))))
                  (vec (range (inc (count b))))
                  a))))
(defn norm-text [s] (str/join " " (str/split (str/trim s) #"\s+")))
(defn cer [gold got] (/ (double (lev gold got)) (max 1 (count gold))))
(defn model-text [json-str]
  (let [out (atom [])]
    (letfn [(walk [n] (cond (map? n) (do (when (string? (get n "text")) (swap! out conj (get n "text"))) (run! walk (vals n)))
                            (sequential? n) (run! walk n)))]
      (walk (get (json/parse-string json-str) "body")))
    (norm-text (str/join " " @out))))

(let [hdir "test/fusion/hidden"
      hids (when (fs/exists? hdir) (vec (sort (map fs/file-name (filter #(fs/exists? (str % "/doc.pdf")) (fs/list-dir hdir))))))]
  (when (and rdrv gdrv (seq hids))
    (doseq [id hids]
      (let [d (abs (str hdir "/" id)) pdf (str d "/doc.pdf")
            flag "--ocr=always"
            gold (norm-text (slurp (str d "/gold.txt")))
            rr (drive rdrv flag "--out=bundle" (str "--replay=" d) pdf)
            rg (drive gdrv flag "--out=bundle" (str "--replay=" d) pdf)
            fr (drive rdrv flag "--out=json" (str "--replay=" d) pdf)
            pr (drive rdrv "--out=json" pdf)
            ev (drive rdrv flag "--out=evidence" (str "--replay=" d) pdf)
            dump (when (zero? (:exit ev)) (json/parse-string (:out ev)))
            fused (cer gold (model-text (:out fr)))
            plain (cer gold (model-text (:out pr)))
            ocr-only (cer gold (norm-text (str/join " " (map #(get % "text") (get dump "owords")))))
            rules (frequencies (map #(get % "rule") (get dump "fv")))
            n (reduce + (vals rules))
            agree (+ (get rules 310 0) (get rules 311 0))]
        (check (and (zero? (:exit rr)) (same? rr rg))
               id ": the Rust Engine and the Go Engine replay the derived transcript to the IDENTICAL bundle")
        (doseq [{:keys [label drv]} (concat (when jdrv [{:label "Java" :drv jdrv}]) (when cdrv [{:label "C#" :drv cdrv}]) (when cbind [cbind]))]
          (check (same? rr (drive drv flag "--out=bundle" (str "--replay=" d) pdf))
                 id ": and the " label " host replays it to the identical bundle"))
        (check (and (zero? (:exit fr)) (zero? (:exit pr)) dump (< fused plain) (<= fused (+ ocr-only 0.005)) (< fused 0.02))
               (format "%s: CER of the fused text %.4f: below the hidden layer alone's %.4f, within 0.005 of the new OCR's alone %.4f, under 0.02"
                       id fused plain ocr-only))
        (if (= id "hidden-exact-ocr")
          (check (> (/ agree (max 1 n)) 0.8) (format "%s: the layers agree: rows 310 and 311 decide %d of %d words (%s)" id agree n (pr-str (into (sorted-map) rules))))
          (check (> (get rules 322 0) (* 0.3 n)) (format "%s: the layers disagree: row 322 decides %d of %d words (%s)" id (get rules 322 0) n (pr-str (into (sorted-map) rules)))))))))

(when (empty? ids) (println "  SKIP no fusion transcripts committed (bb fusion-record)"))
(when (pos? @fails) (System/exit 1))
(when (and rdrv gdrv (seq ids) (zero? @fails))
  (ok "the whole Engine, fusing born-digital pages from recorded pdfium and Tesseract answers: one bundle on Rust and Go"))
