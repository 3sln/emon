#!/usr/bin/env bb
;; Write the visibility fixtures and their expectations (DEVLOG P3.5, P3.6; D152-D157).
;;
;;     kin/scripts/vis-fixtures            write test/vis/*.pdf and test/vis/rows.txt
;;     kin/scripts/vis-fixtures --check    fail if the committed files are not what this writes
;;
;; A DEVELOPMENT SCRIPT that `bb unit` also runs with --check, like the other fixture writers. Nothing here is
;; emon: it WRITES small PDFs, one per visibility class and one per hidden-text trick a crawler is fed, and it
;; says by hand, string by string, what each glyph must be classified as. Every expectation is from what the
;; operators MEAN (ISO 32000-1 8, 9, 11), not from what emon answers; `kin/scripts/vis-check` holds the same
;; expectations to an independent witness, the poppler renderer (`pdftoppm`): an item expected to be seen must
;; leave ink in its box and an item expected to be hidden must leave none.
;;
;; THE EXPECTATION FILE (test/vis/rows.txt), tab-separated, read by kin/pdfvistest.kin:
;;   F  path                       run the file
;;   G  vis vby src ncp text       the next ncp glyphs have this `vis` (the evidence's `vz` code; 0 none) and `vby`
;;                                 (-1 none, else the `z` of the occluder), and their words this `src` (1 text,
;;                                 2 hidden-text); `text` is for a person
;;   C  rgb cls vis ncp text       the next ncp glyphs are filled with this colour (rrggbb, or -1 unknown) within two levels a
;;                                 channel, are of this colour-space class (`cs`; 0 none) and have this `vis`
;;   O  ocgdef ncp                 the innermost optional-content span of the ncp glyphs just given has this `ocgdef` (1 on,
;;                                 0 off, 2 on in the configuration but off by the group's /Usage /View /ViewState)
;;   I  vis vby                    the next image placement
;;   N  glyphs images              the page(s) made this many glyph rows and image rows
;;   P  vis vby backdrop chk tr n  the next painted path (not a clip, not a shading: P3.6a, D219): its `vis`, `vby`, the
;;                                 backdrop the white check found (rrggbb, -1 none), the `vchk` bits that must be set (a
;;                                 mask), whether it is `truncated` (1) or not (0), and how many points of geometry it keeps
;;                                 (-1: not asked); then the text, for a person
;;
;; THE LINES. A text item sits on a line k of a page: baseline 740 - 36 k, x 50, 14 pt Helvetica (a glyph's cell
;; is its baseline - 2.9 to + 10.1). A `rect` covers a line (x 40..580, baseline - 8 .. + 16) or part of it.
;; Paint numbers (`z`) count every glyph, path and image in the order painted, from 0 on each page.
(require '[clojure.string :as str]
         '[clojure.java.io :as io])

(def root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getParentFile .getPath))
(def out-dir (str root "/test/vis"))

;; ------------------------------------------------------------------ the PDF writer

(defn latin1 ^bytes [^String s] (.getBytes s "ISO-8859-1"))

(defn build-pdf [objs]
  (let [buf (java.io.ByteArrayOutputStream.)
        offs (atom {})
        w (fn [s] (.write buf (latin1 s)))]
    (w "%PDF-1.7\n%âãÏÓ\n")
    (doseq [n (sort (keys objs))]
      (swap! offs assoc n (.size buf))
      (let [b (objs n)]
        (w (str n " 0 obj\n"))
        (if (vector? b)
          (let [[_ dict data] b]
            (w (str "<< " dict " /Length " (count (latin1 data)) " >>\nstream\n"))
            (w data)
            (w "\nendstream"))
          (w b))
        (w "\nendobj\n")))
    (let [xref (.size buf)
          n (inc (apply max (keys objs)))]
      (w (str "xref\n0 " n "\n0000000000 65535 f \n"))
      (doseq [i (range 1 n)]
        (w (if-let [o (@offs i)] (format "%010d 00000 n \n" o) "0000000000 65535 f \n")))
      (w (str "trailer\n<< /Size " n " /Root 1 0 R >>\nstartxref\n" xref "\n%%EOF\n")))
    (.toByteArray buf)))

(defn stream [dict data] [:stream dict data])

;; ------------------------------------------------------------------- the items

(defn base-y [k] (- 740 (* 30 k)))

(defn fmt [x] (if (integer? x) (str x) (let [s (format "%.2f" (double x))] (str/replace (str/replace s #"0+$" "") #"\.$" ""))))

(defn text-item
  "A text item on line k, in its own q/Q. opts: :pre (operators before BT), :post (after ET), :size, :x, :y, :mode,
  :vis, :by (the name of the paint that covers it), :src (1 text, 2 hidden-text), :font, :name."
  [k s {:keys [pre post size x y mode vis by src font name ocgdef] :or {pre "" post "" size 14 x 50 vis 0 font "F1"}}]
  {:kind :text :text s :name name :by by :vis vis :ocgdef ocgdef
   :src (or src (if (#{3 7} mode) 2 1))
   :ops (str "q " pre (when (seq pre) " ")
             "BT " (when mode (str mode " Tr "))
             "/" font " " (fmt size) " Tf " (fmt x) " " (fmt (or y (base-y k))) " Td (" s ") Tj"
             (when mode " 0 Tr") " ET" (when (seq post) (str " " post)) " Q")
   :z (count s)})

(defn ghost
  "Glyphs a Form XObject shows: expected, but written by the form, not by the page's own content."
  [s vis] {:kind :text :text s :vis vis :by nil :src 1 :ops "" :z (count s)})

(defn paint [name ops & [{:keys [n] :or {n 1}}]] {:kind :paint :name name :ops ops :z n})
(defn raw [ops] {:kind :raw :ops ops :z 0})
(defn path-item
  "A path painted by `ops` (one paint operator: z 1). opts: :vis, :by (the name of what covers it), :backdrop (rrggbb or
  \"-1\"), :chk (bits of `vchk` that must be set), :tr (1 when truncated), :pcount (points kept), :name."
  [text ops {:keys [vis by backdrop chk tr pcount name] :or {vis 0 chk 0 tr 0 pcount -1}}]
  {:kind :path :text text :ops ops :z 1 :name name :by by :vis vis
   ;; the white check runs unless the path was clipped away or is off the page; on a page with nothing behind it finds the paper
   :backdrop (or backdrop (if (#{1 2} vis) "-1" "FFFFFF")) :chk chk :tr tr :pcount pcount})
(defn image-item [name ops {:keys [vis by] :or {vis 0}}] {:kind :image :name name :ops ops :vis vis :by by :z 1})

(defn line-rect
  "A filled rectangle over line k (the whole line, or from x0 to x1) in the colour operators `col`, with the
  graphics-state operators `gs` first, all in a q/Q."
  ([name k col] (line-rect name k col 40 580 ""))
  ([name k col x0 x1] (line-rect name k col x0 x1 ""))
  ([name k col x0 x1 gs]
   (paint name (str "q " gs (when (seq gs) " ") col " " x0 " " (- (base-y k) 8) " " (- x1 x0) " 24 re f Q"))))

(defn img-over
  "A picture (the XObject /imname) exactly over line k."
  [name k imname opts]
  (image-item name (str "q 540 0 0 24 40 " (- (base-y k) 8) " cm /" imname " Do Q") opts))

(defn assemble
  "A page's items to [content-stream rows], resolving names to paint numbers."
  [items]
  (let [zs (reduce (fn [{:keys [z m]} it]
                     {:z (+ z (:z it)) :m (cond-> m (:name it) (assoc (:name it) z))})
                   {:z 0 :m {}} items)
        names (:m zs)
        rows (keep (fn [it]
                     (case (:kind it)
                       :text (str "G\t" (:vis it) "\t" (if (:by it) (get names (:by it)) -1) "\t" (:src it) "\t"
                                  (count (:text it)) "\t" (:text it)
                                  (when (:ocgdef it) (str "\nO\t" (:ocgdef it) "\t" (count (:text it)))))
                       :ctext (:crow it)
                       :path (str "P\t" (:vis it) "\t" (if (:by it) (get names (:by it)) -1) "\t" (:backdrop it) "\t" (:chk it) "\t"
                                  (:tr it) "\t" (:pcount it) "\t" (:text it))
                       :image (str "I\t" (:vis it) "\t" (if (:by it) (get names (:by it)) -1))
                       nil))
                   items)]
    (when-let [bad (first (remove (fn [it] (or (nil? (:by it)) (contains? names (:by it)))) items))]
      (throw (ex-info "unknown occluder" {:by (:by bad)})))
    [(str/join "\n" (remove empty? (map :ops items))) (vec rows)]))

;; ------------------------------------------------------------------- the files

(def font-obj "<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica /Encoding /WinAnsiEncoding >>")

(defn img-rgb [w h hex]
  (stream (str "/Type /XObject /Subtype /Image /Width " w " /Height " h
               " /ColorSpace /DeviceRGB /BitsPerComponent 8 /Filter /ASCIIHexDecode") (str hex ">")))

(def img-uniform ;; 2x2, every pixel 0x808080
  (img-rgb 2 2 "808080808080808080808080"))

(defn simple-doc
  "One-page documents: a map of objects built from resources and a content string."
  [{:keys [content resources media crop rotate extra catalog-extra]
    :or {resources "" media "[0 0 612 792]"}}]
  (merge
   {1 (str "<< /Type /Catalog /Pages 2 0 R" catalog-extra " >>")
    2 "<< /Type /Pages /Kids [3 0 R] /Count 1 >>"
    3 (str "<< /Type /Page /Parent 2 0 R /MediaBox " media (when crop (str " /CropBox " crop))
           (when rotate (str " /Rotate " rotate))
           " /Resources << /Font << /F1 10 0 R >> " resources " >> /Contents 4 0 R >>")
    4 (stream "" content)
    10 font-obj}
   extra))

(def fixtures (atom []))   ;; [file-name objs rows glyphs images]
(defn counts [items]
  [(reduce + (map #(if (#{:text :ctext} (:kind %)) (count (:text %)) 0) items))
   (count (filter #(= :image (:kind %)) items))])

(defn counts-all [page-items]
  (reduce (fn [[g i] items] (let [[a b] (counts items)] [(+ g a) (+ i b)])) [0 0] page-items))

(defn fixture! [file doc-map items]
  (let [[content rows] (assemble items)
        [ng ni] (counts items)]
    (swap! fixtures conj [file (simple-doc (assoc doc-map :content content)) rows ng ni])))

(defn fixture-pages! [file objs-fn page-items]
  (let [assembled (mapv assemble page-items)
        cs (counts-all page-items)]
    (swap! fixtures conj [file (objs-fn (mapv first assembled)) (vec (mapcat second assembled)) (first cs) (second cs)])))

