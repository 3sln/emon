(def oc-resources "/Properties << /On 20 0 R /Off 21 0 R /M1 22 0 R /M2 23 0 R /M3 24 0 R /M4 25 0 R /Pr 26 0 R >> /XObject << /Fm0 11 0 R /Im0 12 0 R >>")
