(fixture-pages! "pages.pdf"
  (fn [contents]
    (merge {1 "<< /Type /Catalog /Pages 2 0 R >>"
            2 (str "<< /Type /Pages /Kids [" (str/join " " (map #(str (+ 3 %) " 0 R") (range (count contents)))) "] /Count " (count contents) " >>")
            10 font-obj}
           (into {} (map-indexed (fn [i c] [(+ 3 i) (str "<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Resources << /Font << /F1 10 0 R >> >> /Contents " (+ 30 i) " 0 R >>")]) contents))
           (into {} (map-indexed (fn [i c] [(+ 30 i) (stream "" c)]) contents))))
  [[(text-item 0 "Page one is plain" {})
    (text-item 1 "white on page one" {:pre "1 g" :vis 3})]
   [(text-item 0 "Page two starts again at paint number zero" {:vis 5 :by :wall})
    (paint :wall "q 1 g 0 0 612 792 re f Q")
    (text-item 1 "drawn after the wall" {:pre "0 g"})]])

;; ---------------------------------------------------------------- the writer

(defn files []
  (let [fs @fixtures]
    (mapv (fn [[f objs rows ng ni]]
            {:file f
             :bytes (build-pdf objs)
             :rows (str "F\tvis/" f "\n" (str/join "\n" rows) "\nN\t" ng "\t" ni "\n")})
          fs)))

(defn run []
  (let [fs (files)
        rows (str "# GENERATED by kin/scripts/vis-fixtures -- do not edit. See that script for what the rows mean.\n"
                  (str/join "" (map :rows fs)))
        check? (some #{"--check"} *command-line-args*)
        bad (atom [])]
    (when-not check? (.mkdirs (io/file out-dir)))
    (doseq [{:keys [file bytes]} fs]
      (let [f (io/file out-dir file)]
        (if check?
          (when-not (and (.exists f) (java.util.Arrays/equals ^bytes (java.nio.file.Files/readAllBytes (.toPath f)) ^bytes bytes))
            (swap! bad conj file))
          (with-open [o (io/output-stream f)] (.write o ^bytes bytes)))))
    (let [f (io/file out-dir "rows.txt")]
      (if check?
        (when-not (and (.exists f) (= rows (slurp f))) (swap! bad conj "rows.txt"))
        (spit f rows)))
    (if check?
      (if (empty? @bad)
        (println (str "  ok   vis-fixtures: " (count fs) " PDFs and rows.txt are what the script writes"))
        (do (println (str "  FAIL vis-fixtures: stale " (str/join ", " @bad) " (run kin/scripts/vis-fixtures)"))
            (System/exit 1)))
      (println (str "wrote " (count fs) " PDFs to test/vis")))))

(run)
