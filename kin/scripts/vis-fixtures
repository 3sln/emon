;; 8. alpha ---------------------------------------------------------------------------------------------
(fixture! "alpha.pdf" {:resources "/ExtGState << /A0 << /ca 0 /CA 1 >> /S0 << /ca 1 /CA 0 >> /B0 << /ca 0 /CA 0 >> /A5 << /ca 0.5 /CA 0.5 >> /A1 << /ca 1 /CA 1 >> >>"}
  [(text-item 0 "Fill alpha zero" {:pre "/A0 gs" :vis 7})
   (text-item 1 "Fill alpha half" {:pre "/A5 gs"})
