;; 11. colour spaces: the colour each one gives a glyph, from an independent evaluator ---------------------
;;
;; The expected colours are computed HERE, in double precision, from the same numbers the PDF holds: the
;; transfer function of sRGB written out, Lab through XYZ with the published D50 and D65 matrices, and PDF
;; functions of types 0, 2, 3 and 4 by a second small interpreter. kin/pdfvistest.kin holds emon's integer
;; arithmetic to them within two levels a channel.

(defn clamp01 [x] (max 0.0 (min 1.0 (double x))))
(defn byte-of [x] (long (Math/floor (+ (* 255.0 (clamp01 x)) 0.5))))
(defn rgb-hex [[r g b]] (format "%02X%02X%02X" (byte-of r) (byte-of g) (byte-of b)))
(defn compand [c] (let [c (clamp01 c)] (if (<= c 0.0031308) (* 12.92 c) (- (* 1.055 (Math/pow c (/ 1.0 2.4))) 0.055))))

(defn lab->rgb [[l a b] [xw yw zw]]
  (let [fy (/ (+ l 16.0) 116.0) fx (+ fy (/ a 500.0)) fz (- fy (/ b 200.0))
        finv (fn [t] (if (> t (/ 6.0 29.0)) (* t t t) (* (/ 108.0 841.0) (- t (/ 4.0 29.0)))))
        x (* xw (finv fx)) y (* yw (finv fy)) z (* zw (finv fz))
        m (if (> xw 0.957)
            [[3.1338561 -1.6168667 -0.4906146] [-0.9787684 1.9161415 0.0334540] [0.0719453 -0.2289914 1.4052427]]
            [[3.2404542 -1.5371385 -0.4985314] [-0.9692660 1.8760108 0.0415560] [0.0556434 -0.2040259 1.0572252]])]
    (mapv (fn [[p q r]] (compand (+ (* p x) (* q y) (* r z)))) m)))

(defn cmyk->rgb [[c m y k]] [(* (- 1 c) (- 1 k)) (* (- 1 m) (- 1 k)) (* (- 1 y) (- 1 k))])

;; PDF functions, as data, evaluated on a vector of inputs
(defn fn-eval [f xs]
  (case (:type f)
    2 (let [x (Math/pow (first xs) (:n f))] (mapv (fn [c0 c1] (+ c0 (* x (- c1 c0)))) (:c0 f) (:c1 f)))
    0 (let [{:keys [size samples nout]} f
            [d0 d1] (:domain f)
            x (first xs)
            e (max 0.0 (min (double (dec size)) (* (/ (- x d0) (- d1 d0)) (dec size))))
            i0 (long (Math/floor e)) i1 (min (dec size) (inc i0)) fr (- e i0)]
        (mapv (fn [j] (let [s0 (nth samples (+ (* i0 nout) j)) s1 (nth samples (+ (* i1 nout) j))]
                        (/ (+ s0 (* fr (- s1 s0))) 255.0)))
              (range nout)))
    3 (let [x (first xs) [d0 d1] (:domain f) bounds (:bounds f)
            i (count (take-while #(>= x %) bounds))
            lo (if (zero? i) d0 (nth bounds (dec i))) hi (if (< i (count bounds)) (nth bounds i) d1)
            [e0 e1] (nth (:encode f) i)
            x' (if (= hi lo) e0 (+ e0 (* (- x lo) (/ (- e1 e0) (- hi lo)))))]
        (fn-eval (nth (:fns f) i) [x']))
    4 (let [run (fn run [prog stack]
                  (reduce (fn [st t]
                            (cond
                              (number? t) (conj st t)
                              (vector? t) (conj st t)   ;; a block, consumed by if/ifelse below
                              :else
                              (case t
                                add (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (+ a b)))
                                sub (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (- a b)))
                                mul (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (* a b)))
                                div (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (/ a b)))
                                dup (conj st (peek st))
                                exch (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) b a))
                                pop (pop st)
                                gt (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (> a b)))
                                lt (let [[a b] (take-last 2 st)] (conj (vec (drop-last 2 st)) (< a b)))
                                sin (conj (pop st) (Math/sin (Math/toRadians (peek st))))
                                cos (conj (pop st) (Math/cos (Math/toRadians (peek st))))
                                abs (conj (pop st) (Math/abs (double (peek st))))
                                neg (conj (pop st) (- (peek st)))
                                roll (let [[n j] (take-last 2 st) st (vec (drop-last 2 st))
                                           top (vec (take-last (long n) st)) rest' (vec (drop-last (long n) st))
                                           j (mod (long j) (long n))
                                           rolled (vec (concat (take-last j top) (drop-last j top)))]
                                       (into rest' rolled))
                                if (let [[b blk] (take-last 2 st)] (let [st' (vec (drop-last 2 st))] (if b (run blk st') st')))
                                ifelse (let [[b b1 b2] (take-last 3 st) st' (vec (drop-last 3 st))] (run (if b b1 b2) st')))))
                          stack prog))
            out (run (:prog f) (vec xs))]
        (vec (take-last (:nout f) out)))))

(defn model-rgb [model comps lab-params]
  (case model
    :gray (let [g (first comps)] [g g g])
    :rgb (vec (take 3 comps))
    :cmyk (cmyk->rgb comps)
    :lab (lab->rgb comps lab-params)))

(def d50 [0.9642 1.0 0.8249])
(def d65 [0.9505 1.0 1.089])

(def spaces-fns
  {31 {:type 0 :domain [0 1] :size 3 :nout 3 :samples [255 255 255 128 0 0 0 0 0]
       :obj (stream "/FunctionType 0 /Domain [0 1] /Range [0 1 0 1 0 1] /Size [3] /BitsPerSample 8 /Filter /ASCIIHexDecode" "FFFFFF 800000 000000>")}
   32 {:type 3 :domain [0 1] :bounds [0.5] :encode [[0 1] [0 1]]
       :fns [{:type 2 :c0 [0 0 0 0] :c1 [1 0 0 0] :n 1.0} {:type 2 :c0 [1 0 0 0] :c1 [1 1 1 1] :n 2.0}]
       :obj "<< /FunctionType 3 /Domain [0 1] /Functions [<< /FunctionType 2 /Domain [0 1] /C0 [0 0 0 0] /C1 [1 0 0 0] /N 1 >> << /FunctionType 2 /Domain [0 1] /C0 [1 0 0 0] /C1 [1 1 1 1] /N 2 >>] /Bounds [0.5] /Encode [0 1 0 1] >>"}
   33 {:type 4 :nout 3 :prog '[add add 3 div dup 0.5 gt [pop 1 0.25 0] [0.75 mul dup dup] ifelse]
       :obj (stream "/FunctionType 4 /Domain [0 1 0 1 0 1] /Range [0 1 0 1 0 1]" "{ add add 3 div dup 0.5 gt { pop 1 0.25 0 } { 0.75 mul dup dup } ifelse }")}
   37 {:type 4 :nout 3 :prog '[dup 0.5 mul exch 1 exch sub 1 3 1 roll]
       :obj (stream "/FunctionType 4 /Domain [0 1] /Range [0 1 0 1 0 1]" "{ dup 0.5 mul exch 1 exch sub 1 3 1 roll }")}
   38 {:type 4 :nout 3 :prog '[180 mul cos 1 add 2 div dup dup]
       :obj (stream "/FunctionType 4 /Domain [0 1] /Range [0 1 0 1 0 1]" "{ 180 mul cos 1 add 2 div dup dup }")}
   39 {:type 2 :c0 [1 1 1] :c1 [0 0.5 1] :n 2.2
       :obj "<< /FunctionType 2 /Domain [0 1] /C0 [1 1 1] /C1 [0 0.5 1] /N 2.2 >>"}
   40 {:type 2 :c0 [100 0 0] :c1 [30 60 40] :n 1.0 ;; a Lab alternate's tint: a ramp in Lab
       :obj "<< /FunctionType 2 /Domain [0 1] /C0 [100 0 0] /C1 [30 60 40] /N 1 >>"}})

(defn color-item
  "A three-letter label shown in the colour the operators `pre` set, expected to be `rgb` (a [r g b] in 0..1, or nil
  for unknown) of colour-space class `cls` (1 gray, 2 rgb, 3 cmyk, 4 spot, 5 pattern, 6 other)."
  [k label pre rgb cls]
  (assoc (text-item (mod k 22) label {:pre pre :x (if (< k 22) 50 330)})
         :kind :ctext
         :crow (str "C\t" (if rgb (rgb-hex rgb) "-1") "\t" cls "\t"
                    (if (and rgb (every? #(>= (byte-of %) 251) rgb)) 3 0) "\t" (count label) "\t" label)))

