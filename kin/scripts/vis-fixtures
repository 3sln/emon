;; 12. paths: the same checks on rules, thin rectangles and grids (P3.6a, D219) ---------------------------------
;;
;; Item k sits in column (quot k 22) at x = 40 + 290 col, y = 770 - 30 (rem k 22); a rule runs 240 pt right of x, a thin
;; rectangle is 1 pt high. The grids are at the foot of the page. `chk` 127 is every check from `clip` to `transparent`.
(def pk (atom -1))
(defn pos [k] {:x (+ 40 (* 290 (quot k 22))) :y (- 770 (* 30 (rem k 22)))})
(defn pitem
  "A path item on the next position (or the last one with :same): `f` makes the operators from x and y."
  [text f {:keys [same] :as opts}]
  (let [k (if same @pk (swap! pk inc)) {:keys [x y]} (pos k)]
    (path-item text (f x y) opts)))
(defn rule [pre & [extra]]
  (fn [x y] (str "q " (or extra "") " " pre " 1 w " x " " y " m " (+ x 240) " " y " l S Q")))
(defn thin [pre & [extra]]
  (fn [x y] (str "q " (or extra "") " " pre " " x " " (- y 0.5) " 240 1 re f Q")))
(defn under-clip [f clip] (fn [x y] (str "q " (clip x y) " re W n " (f x y) " Q")))
(defn wall [color & [gs]]
  (fn [x y] (str "q " (or gs "") " " color " " (- x 10) " " (- y 6) " 260 12 re f Q")))
(defn half-wall [color] (fn [x y] (str "q " color " " (- x 10) " " (- y 6) " 130 12 re f Q")))
(defn grid [n cols w h x0 y0]
  (str "q 0 G 0.5 w "
       (str/join " " (for [i (range n)] (str (+ x0 (* w (rem i cols))) " " (+ y0 (* h (quot i cols))) " " w " " h " re")))
       " S Q"))

