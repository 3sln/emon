#!/bin/sh
# Build the Rust Engine and its driver; print the driver's path.   kin/scripts/emon-rs-build
#
# The crate is ASSEMBLED, not committed (the generated code lives in gen/, the host in host/rust/src/):
#
#     .cache/emon-rs/src/emon/*.rs     gen/rust/emon/*.rs, every module that is NOT a law (`emon.test`) or
#                                      a probe/test namespace (names ending `test` or `probe`)
#     .cache/emon-rs/src/emon.rs       the module list, written here
#     .cache/emon-rs/src/{lib,port,plan,source,engine,render,pdfium}.rs   host/rust/src/
#     .cache/emon-rs/src/driver.rs     test/driver/rust/main.rs, the `emon-rs` binary
#     .cache/emon-rs/tests/engine.rs   host/rust/tests/engine.rs, the Engine API's native tests (`bb slice` runs them)
#
# `.cache/` is gitignored. A file is copied only when it differs (cargo rebuilds by mtime), and a module
# that is no longer generated is removed. `bb emit` is NOT run here: callers that must be current
# (`bb slice`) run it first. Warnings are off (generated code is noisy); the host files are held clean
# by `bb slice`, which builds them once with warnings on.
#
#   EMON_RS_WARN=1   build with warnings on (for the host files)
set -e
cd "$(dirname "$0")/../.."
# LIVE (D211): EMON_RS_LIVE=1 builds the same crate with the `tesseract` feature (the Tesseract adapter of the Ocr port,
# linked to libtesseract and libleptonica) into .cache/emon-rs-live; it is NOT a gate's (a gate replays a transcript).
# EMON_TESS_LIB is the directory of the libraries (default /opt/homebrew/lib).
crate=.cache/emon-rs
live=0
if [ "${EMON_RS_LIVE:-}" = 1 ]; then crate=.cache/emon-rs-live; live=1; fi
# FUSION RECORDING (P7.3, D285-D290): EMON_RS_PDFIUM=DIR (the pinned pdfium's lib directory, `bb pdfium-fetch`) builds the same crate with
# `--cfg pdfium` linked to it (the `--pdfium` flag of the driver) into .cache/emon-rs-fusion, with Tesseract too; it is NOT a gate's.
pdfium_lib="${EMON_RS_PDFIUM:-}"
if [ -n "$pdfium_lib" ]; then crate=.cache/emon-rs-fusion; live=1; fi
# THE PDF IMAGE CODECS (P6.1a, D336): EMON_RS_CODECS=DIR (the directory of libopenjp2 and libjbig2dec, e.g. /opt/homebrew/lib) builds the same
# crate with `--cfg codecs` linked to them (the `--codecs` flag of the driver) into .cache/emon-rs-codecs; LIVE only, never a gate's (a gate
# replays the transcript `bb asset-record` made with it). Combined with EMON_RS_PDFIUM the fusion crate has both.
codecs_lib="${EMON_RS_CODECS:-}"
if [ -n "$codecs_lib" ] && [ -z "$pdfium_lib" ]; then crate=.cache/emon-rs-codecs; fi
mkdir -p "$crate/src/emon"

put() { cmp -s "$1" "$2" 2>/dev/null || cp "$1" "$2"; }

keep=""
for f in gen/rust/emon/*.rs; do
  m=$(basename "$f" .rs)
  case "$m" in *test|*probe) continue ;; esac
  keep="$keep $m"
  put "$f" "$crate/src/emon/$m.rs"
done
for f in "$crate"/src/emon/*.rs; do
  [ -e "$f" ] || continue
  m=$(basename "$f" .rs)
  case " $keep " in *" $m "*) ;; *) rm -f "$f" ;; esac
done
for m in $keep; do echo "pub mod $m;"; done > "$crate/src/emon.rs.new"
put "$crate/src/emon.rs.new" "$crate/src/emon.rs"
rm -f "$crate/src/emon.rs.new"

for f in lib port plan source engine imgdec tess render pdfium pdfimg pdfcodecs; do put "host/rust/src/$f.rs" "$crate/src/$f.rs"; done
put test/driver/rust/main.rs "$crate/src/driver.rs"
mkdir -p "$crate/tests"
put host/rust/tests/engine.rs "$crate/tests/engine.rs"
cat > "$crate/Cargo.toml.new" <<'TOML'
[package]
name = "emon"
version = "0.0.0"
edition = "2021"

[lib]
path = "src/lib.rs"

[[bin]]
name = "emon-rs"
path = "src/driver.rs"

[features]
tesseract = []

[dependencies]
# the ImageDecode port's codecs (D189): PNG and JPEG pixels, CCITT, and the TIFF Deflate stream. Pinned; the
# lock file is host/rust/Cargo.lock.
image = { version = "=0.25.10", default-features = false, features = ["png", "jpeg"] }
fax = "=0.2.7"
miniz_oxide = "=0.8.9"
# the `decode-img` request's DCT decoder (P6.1a, D334): the very library `image` already uses for JPEG, used directly for the Adobe
# CMYK and YCCK samples `image` does not give; both are already in the lock file
zune-jpeg = "=0.5.15"
zune-core = "=0.5.3"

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ["cfg(pdfium)", "cfg(codecs)"] }

[profile.release]
opt-level = 3
overflow-checks = true
debug = false
TOML
put "$crate/Cargo.toml.new" "$crate/Cargo.toml"
rm -f "$crate/Cargo.toml.new"

flags="-A warnings"
[ "${EMON_RS_WARN:-}" = 1 ] && flags=""
cargo_features=""
if [ "$live" = 1 ]; then
  flags="$flags -L native=${EMON_TESS_LIB:-/opt/homebrew/lib}"
  cargo_features="--features tesseract"
fi
if [ -n "$pdfium_lib" ]; then
  flags="$flags --cfg pdfium -L native=$pdfium_lib -C link-arg=-Wl,-rpath,$pdfium_lib"
fi
if [ -n "$codecs_lib" ]; then
  flags="$flags --cfg codecs -L native=$codecs_lib -C link-arg=-Wl,-rpath,$codecs_lib"
fi
# the lock file is committed (host/rust/Cargo.lock); the registry is reached only when a crate is not cached
put host/rust/Cargo.lock "$crate/Cargo.lock"
out=$(cd "$crate" && { RUSTFLAGS="$flags" cargo build --release --offline -q $cargo_features 2>&1 || RUSTFLAGS="$flags" cargo build --release -q $cargo_features 2>&1; }) || { echo "$out" | head -80 >&2; echo "emon-rs: build failed" >&2; exit 1; }
[ -z "$out" ] || echo "$out" >&2
echo "$crate/target/release/emon-rs"
