#!/usr/bin/env bb
;; THE FIRST VERTICAL SLICE, end to end on the Rust host (DEVLOG P1.10) AND the Go host (P2.1).   kin/scripts/slice [--update]
;;
;; A born-digital PDF -> text layer -> paragraphs -> Model -> JSON and HTML, through the Engine API's
;; driver (`test/driver/rust/main.rs`, binary `emon-rs`), whose STDOUT is all this reads:
;;
;;   1. the Engine's native tests (`host/rust/tests/engine.rs`): the three byte-source adapters give
;;      identical JSON, a 512-byte async source equals memory over the slice's fixtures AND every PDF
;;      fixture, D040's errors, limits, record/replay, the walkable Model, and no filesystem in the library;
;;   2. for each fixture (test/para's six documents): the driver's pretty JSON is `test/para/NAME.json`
;;      (which `kin/scripts/para-check` holds to the HTML the document was printed from); its HTML is
;;      `test/slice/NAME.html` (default options) and `NAME.full.html` (ids, geometry, confidence, ledger,
;;      pretty), whose paragraphs are, in order, the JSON's (an independent reading of the HTML);
;;   3. `--chunk=512 --async` and `--source=seek|spool` give the SAME JSON and HTML as memory, and the
;;      async run missed (more than one attempt) and says so on stderr;
;;   4. the text layer's evidence dump of `test/pdf/minimal.pdf` is the P1.7 golden;
;;   5. the driver's named errors and their exit codes.
;;
;; AND ON THE JAVA HOST (P9.1, D449) when a JDK 22+ is there (`emon-java`, `host/java/emon/api/`): its native tests (`EngineTest`, the Go file's
;; twin) and the same sections through its driver; without a JDK the arm is left out, loudly.
;;
;; AND ON THE C# HOST (P9.2, D457) when a .NET 8+ SDK is there (`emon-cs`, `host/csharp/Emon/Api/`): its native tests (`EngineTest`, the Java
;; file's twin) and the same sections through its driver; without an SDK the arm is left out, loudly (EMON_SKIP_CSHARP=1 leaves it out).
;;
;; AND THE C BINDING (P9.4, D473) when a C compiler is there (`emon-c`, host/c/include/emon.h over libemon): the C test program (host/c/test/emon_test.c) against the
;; shared and the static library, then the same sections through the C driver (one-shot, lazy source, step API, 512-byte async); AND THE BABASHKA POD (P9.4,
;; D475): babashka loads the pod and converts the fixtures (`kin/scripts/pod`), then the same sections through the pod driver (it has no async source, so
;; `--chunk=512` stands in). EMON_SKIP_C=1 and EMON_SKIP_POD=1 leave them out, loudly.
;;
;; Every section below runs on EVERY host: the Go Engine (`host/go/{source,engine,model}.go`, driver `emon-go`)
;; has its own native tests (`host/go/engine_test.go`, `go test`: the eleven laws of the Rust file and one more, concurrent reads) and the
;; same fixtures, goldens, async runs and errors, from the same driver flags; `bb identity` holds the two to
;; each other across the whole corpus.
;;
;; AND IN THE BROWSER (P9.3, D356) when the WASM toolchain is there (section 6 below): the Rust host built for wasm32 and driven by the JS
;; SDK in a headless Chrome, the fixtures through each of SPEC 13.1's byte-source adapters to the same goldens; without it the arm is left
;; out, loudly.
;;
;; Timings (ms, driver wall time per fixture, in memory) are printed: a baseline, not a target.
;; `--update` writes the HTML goldens from the driver (a development act; a person reviews the diff).
(require '[babashka.fs :as fs]
         '[babashka.process :refer [shell process]]
         '[cheshire.core :as json]
         '[clojure.string :as str])

(def ^:dynamic *exe* nil)      ; the driver being exercised: `emon-rs`, then `emon-go`
(def ^:dynamic *label* "")     ; "[rust] " or "[go] "
(def fails (atom 0))
(defn ok [& xs] (println (str "  ok   " *label* (apply str xs))))
(defn bad [& xs] (swap! fails inc) (println (str "  FAIL " *label* (apply str xs))))
(defn check [pass? & msg] (if pass? (apply ok msg) (apply bad msg)))

(def update? (some #{"--update"} *command-line-args*))
(def docs ["h-plain" "h-keyword" "h-inverted-numbered" "h-numbered" "initial-image" "initial-vector" "furn-informative"])

(shell {:out :string :err :string} "kin/scripts/emit")

(defn build-driver [script what]
  (let [r @(process {:out :string :err :string} script)]
    (when-not (zero? (:exit r))
      (println "  FAIL the" what "driver did not build:\n" (:err r))
      (System/exit 1))
    (str/trim (:out r))))
;; THE JAVA ARM (P9.1, D449): `emon-java-build` exits 3 with `SKIP java -- why` on stderr when there is no JDK 22+ (EMON_JDK,
;; /opt/homebrew/opt/openjdk, java_home); the arm is then left out, LOUDLY, and nothing fails. EMON_SKIP_JAVA=1 leaves it out on purpose.
(def java-exe
  (if (System/getenv "EMON_SKIP_JAVA")
    (do (println "  SKIP java arm -- EMON_SKIP_JAVA is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-java-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the Java arm is left out)")) nil)
        (do (println "  FAIL the Java driver did not build:\n" (:err r)) (System/exit 1))))))
;; THE C# ARM (P9.2, D457): `emon-cs-build` exits 3 with `SKIP csharp -- why` on stderr when there is no .NET 8+ SDK (EMON_DOTNET, dotnet on the
;; PATH, /opt/homebrew/bin, ~/.dotnet); the arm is then left out, LOUDLY, and nothing fails. EMON_SKIP_CSHARP=1 leaves it out on purpose.
(def cs-exe
  (if (System/getenv "EMON_SKIP_CSHARP")
    (do (println "  SKIP csharp arm -- EMON_SKIP_CSHARP is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-cs-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the C# arm is left out)")) nil)
        (do (println "  FAIL the C# driver did not build:\n" (:err r)) (System/exit 1))))))
;; THE C ARM (P9.4, D473): `emon-c-build` exits 3 with `SKIP c -- why` on stderr when there is no C compiler; the arm is then left out, LOUDLY, and
;; nothing fails. EMON_SKIP_C=1 leaves it out on purpose. THE POD ARM (P9.4, D475): `emon-pod-build` likewise (EMON_SKIP_POD=1).
(def c-exe
  (let [r @(process {:out :string :err :string} "kin/scripts/emon-c-build")]
    (case (:exit r)
      0 (str/trim (:out r))
      3 (do (println (str "  " (str/trim (:err r)) " (the C arm is left out)")) nil)
      (do (println "  FAIL the C driver did not build:\n" (:err r)) (System/exit 1)))))
(def pod-exe
  (let [r @(process {:out :string :err :string} "kin/scripts/emon-pod-build")]
    (case (:exit r)
      0 (str/trim (:out r))
      3 (do (println (str "  " (str/trim (:err r)) " (the pod arm is left out)")) nil)
      (do (println "  FAIL the pod did not build:\n" (:err r)) (System/exit 1)))))
(def hosts (cond-> [["rust" (build-driver "kin/scripts/emon-rs-build" "Rust")]
                    ["go" (build-driver "kin/scripts/emon-go-build" "Go")]]
             java-exe (conj ["java" java-exe])
             cs-exe (conj ["csharp" cs-exe])
             c-exe (conj ["c" c-exe])
             pod-exe (conj ["pod" pod-exe])))

(defn drive [& args]
  (let [t0 (System/nanoTime)
        r @(apply process {:out :string :err :string} *exe* args)]
    (assoc r :ms (/ (- (System/nanoTime) t0) 1e6))))

;; ------------------------------------------------------ 1. the native tests

(let [r @(process {:dir ".cache/emon-rs" :out :string :err :string :extra-env {"RUSTFLAGS" "-A warnings"}}
                  "cargo" "test" "--release" "--offline" "-q" "--test" "engine")
      n (some->> (re-find #"test result: ok\. (\d+) passed; 0 failed" (:out r)) second)]
  (if (and (zero? (:exit r)) n)
    (ok "the Engine API's native tests: " n " passed (adapters identical; async 512 = memory over every PDF fixture; D040; limits; record/replay; the Model walks; no filesystem in the library)")
    (bad "the Engine API's native tests failed:\n" (str/join "\n" (take 40 (str/split-lines (str (:out r) (:err r))))))))

;; The Go host files are held clean: `go vet` over the Engine, the ports and the driver.
(let [r @(process {:dir ".cache/emon-go" :out :string :err :string} "go" "vet" "." "./port" "./cmd/emon-go")]
  (if (zero? (:exit r))
    (ok "[go] go vet is clean over host/go and the driver")
    (bad "[go] go vet:\n" (str (:out r) (:err r)))))

;; The Go Engine's native tests: the assembled module, `go test` (host/go/engine_test.go).
(let [r @(process {:dir ".cache/emon-go" :out :string :err :string :extra-env {"EMON_ROOT" (str (fs/canonicalize "."))}}
                  "go" "test" "-count=1" "-v" "-run" "Test" ".")
      out (str (:out r) (:err r))
      n (count (re-seq #"(?m)^--- PASS" out))]
  (if (and (zero? (:exit r)) (>= n 11) (not (re-find #"--- FAIL" out)))
    (ok "[go] the Engine API's native tests: " n " passed (adapters identical; async 512 = memory over every PDF fixture; D040; limits; record/replay; the Model walks and reads from many goroutines; no filesystem in the library)")
    (bad "[go] the Engine API's native tests failed:\n" (str/join "\n" (take 60 (str/split-lines out))))))

;; The Java host files are held clean, as Go's are by `go vet`: `javac -Xlint:all` over the ports' driver, the Engine layer, the bindings and the drivers.
(when java-exe
  (let [r @(process {:out :string :err :string :extra-env {"EMON_JAVA_LINT" "1"}} "kin/scripts/emon-java-build")]
    (binding [*label* "[java] "]
      (if (zero? (:exit r))
        (ok "javac -Xlint:all is clean over host/java and the drivers")
        (bad "javac -Xlint:all:\n" (str (:out r) (:err r)))))))

;; The Java Engine's native tests: the assembled tree, `EngineTest` (test/driver/java/EngineTest.java; no JUnit, D044), the Go tests' twins.
(when java-exe
  (let [launcher (str (fs/parent java-exe) "/emon-java-test")
        r @(process {:out :string :err :string :extra-env {"EMON_ROOT" (str (fs/canonicalize "."))}} launcher)
        out (str (:out r) (:err r))
        n (count (re-seq #"(?m)^ok   " out))]
    (binding [*label* "[java] "]
      (if (and (zero? (:exit r)) (>= n 16) (not (re-find #"FAIL" out)))
        (ok "the Engine API's native tests: " n " passed (adapters identical; async 512 = memory over every PDF fixture; D040; limits; record/replay; the Model walks and reads from many threads; images; OCR port; assets; the Renderer port)")
        (bad "the Engine API's native tests failed:\n" (str/join "\n" (take 60 (str/split-lines out))))))))

;; The C# host files are held clean, as Go's are by `go vet`: every warning in the host files, the Engine layer, the bindings and the drivers fails the
;; build (the generated code is not linted). `--no-incremental` makes the compiler report them again.
(when cs-exe
  (let [r @(process {:out :string :err :string :extra-env {"EMON_CS_LINT" "1"}} "kin/scripts/emon-cs-build")]
    (binding [*label* "[csharp] "]
      (if (zero? (:exit r))
        (ok "the host files are warning-clean over host/csharp and the drivers")
        (bad "the C# host files are not warning-clean:\n" (str (:out r) (:err r)))))))

;; The C# Engine's native tests: the assembled tree, `EngineTest` (test/driver/csharp/EngineTest.cs; no xunit here, D044), the Java tests' twins.
(when cs-exe
  (let [launcher (str (fs/parent cs-exe) "/emon-cs-test")
        r @(process {:out :string :err :string :extra-env {"EMON_ROOT" (str (fs/canonicalize "."))}} launcher)
        out (str (:out r) (:err r))
        n (count (re-seq #"(?m)^ok   " out))]
    (binding [*label* "[csharp] "]
      (if (and (zero? (:exit r)) (>= n 17) (not (re-find #"FAIL" out)))
        (ok "the Engine API's native tests: " n " passed (adapters identical; async 512 = memory over every PDF fixture; D040; limits; record/replay; the Model walks and reads from many threads; images; OCR port; assets; the Renderer port; decode-img)")
        (bad "the Engine API's native tests failed:\n" (str/join "\n" (take 60 (str/split-lines out))))))))

;; The C binding's own test program (host/c/test/emon_test.c): the API of emon.h through the system C compiler, against the shared library and libemon.a.
(when c-exe
  (doseq [[label exe] [["shared" "emon-c-test"] ["static" "emon-c-static"]]]
    (let [r @(process {:out :string :err :string} (str (fs/parent c-exe) "/" exe))
          out (str (:out r))
          n (count (re-seq #"(?m)^ok   " out))]
      (binding [*label* "[c] "]
        (if (and (zero? (:exit r)) (>= n 55) (not (re-find #"(?m)^FAIL" out)))
          (ok "the C test against the " label " library: " n " checks passed (one-shot over bytes and a lazy source, the step API, errors by category and name, kin's option text, assets, record/replay, free, a panic that does not cross, a small caller stack)")
          (bad "the C test against the " label " library failed:\n" (str/join "\n" (take 60 (str/split-lines (str out (:err r)))))))))))

;; The pod's protocol test (kin/scripts/pod): babashka loads the pod and converts the slice's fixtures (path and bytes), errors, passwords, assets.
(when pod-exe
  (let [r @(process {:out :string :err :string} "bb" "kin/scripts/pod")
        out (str (:out r))
        n (count (re-seq #"(?m)^  ok   " out))]
    (binding [*label* "[pod] "]
      (if (and (zero? (:exit r)) (>= n 55) (not (re-find #"(?m)^  FAIL" out)))
        (ok "babashka loads the pod and converts the slice's seven fixtures by path and by bytes to the goldens (" n " checks: Model as JSON and EDN, HTML, assets, evidence, errors by name, passwords)")
        (bad "the pod's test failed:\n" (str/join "\n" (take 60 (str/split-lines (str out (:err r))))))))))

;; WHAT A HOST DOES NOT HAVE is not asked of it: a pod converts in one call (a path or bytes), with no async source and no stats.
(def no-async? #{"pod"})

;; LAZY READS ARE A REQUIREMENT (D058, D483): a one-page document that is mostly one 3 MiB picture is converted through a source that counts
;; what is read from it, and what is read is a tenth of it at most (P9.3 measured 2.1% in the browser; P8.4's image digests read all of it for
;; a release, unseen, because `bb wasm` is no gate). Built here, in memory, the way test/driver/wasm/fixtures.mjs builds it (`bigImagePdf`),
;; so the gate needs no browser; the same bytes, written to .cache/.
(defn big-picture-pdf!
  "Write a one-page PDF (a heading, a paragraph and a raw 2048 x 1536 gray picture of noise, drawn on the page) to `path`; its length."
  [path]
  (let [bos (java.io.ByteArrayOutputStream.)
        put (fn [^bytes b] (.write bos b 0 (alength b)))
        txt (fn [s] (.getBytes ^String s "ISO-8859-1"))
        img (byte-array (* 2048 1536))
        content (txt "BT /F1 24 Tf 72 700 Td (Field notes on range reads) Tj ET\nBT /F1 12 Tf 72 660 Td (Most of this page is a picture the conversion never reads.) Tj ET\nq 400 0 0 300 72 300 cm /Im1 Do Q\n")
        objs [["<< /Type /Catalog /Pages 2 0 R >>" nil]
              ["<< /Type /Pages /Kids [3 0 R] /Count 1 >>" nil]
              ["<< /Type /Page /Parent 2 0 R /MediaBox [0 0 612 792] /Contents 4 0 R /Resources << /Font << /F1 5 0 R >> /XObject << /Im1 6 0 R >> >> >>" nil]
              [(str "<< /Length " (alength content) " >>") content]
              ["<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>" nil]
              [(str "<< /Type /XObject /Subtype /Image /Width 2048 /Height 1536 /ColorSpace /DeviceGray /BitsPerComponent 8 /Length " (alength img) " >>") img]]]
    (.nextBytes (java.util.Random. 7) img)
    (put (txt "%PDF-1.7\n%"))
    (put (byte-array (map unchecked-byte [0xE2 0xE3 0xCF 0xD3 10])))
    (let [offs (vec (map-indexed
                     (fn [i [dict stream]]
                       (let [at (.size bos)]
                         (put (txt (str (inc i) " 0 obj\n" dict "\n")))
                         (when stream (put (txt "stream\n")) (put stream) (put (txt "\nendstream\n")))
                         (put (txt "endobj\n"))
                         at))
                     objs))
          xref (.size bos)]
      (put (txt (str "xref\n0 " (inc (count objs)) "\n0000000000 65535 f \n"
                     (apply str (map #(format "%010d 00000 n \n" %) offs))
                     "trailer\n<< /Size " (inc (count objs)) " /Root 1 0 R >>\nstartxref\n" xref "\n%%EOF\n"))))
    (fs/create-dirs (fs/parent path))
    (with-open [o (java.io.FileOutputStream. (str path))] (.write o (.toByteArray bos)))
    (.size bos)))

(def big-picture-path ".cache/lazy-reads/big-picture.pdf")
(def big-picture-length (big-picture-pdf! big-picture-path))

(doseq [[label exe] hosts]
  (binding [*exe* exe *label* (str "[" label "] ")]
  ;; --------------------------------------------------------- 2. the fixtures

  (defn pdf [d] (str "test/corpus/synth/pdf/" d ".pdf"))
  (def FULL "--html=ids,geometry,confidence=950,ledger,pretty")

  (defn html-paragraphs
    "The text of each <p> of a default-options HTML, tags removed, entities decoded. The running furniture (an <aside
    data-emon=\"furniture\">, which is not in the body) is not read: a document with a running header has <p>s in it."
    [html]
    (->> (re-seq #"<p(?: [^>]*)?>(.*?)</p>" (str/replace html #"(?s)<aside data-emon=\"furniture\".*?</aside>" ""))
         (map (fn [[_ inner]]
                (-> inner
                    (str/replace #"<[^>]*>" "")
                    (str/replace "&lt;" "<") (str/replace "&gt;" ">") (str/replace "&quot;" "\"") (str/replace "&amp;" "&"))))))

  (defn json-paragraphs [j]
    (letfn [(walk [n] (concat (when (= "paragraph" (get n "kind")) [(get n "text")]) (mapcat walk (get n "children"))))]
      (walk (get (json/parse-string j) "body"))))

  (def timings (atom []))
  (drive (pdf "h-plain"))                  ; warm the file cache and the binary: the timings below are not a cold start

  (doseq [d docs]
    (let [m (drive "--pretty" (pdf d))
          golden (slurp (str "test/para/" d ".json"))
          h (drive "--out=html" (pdf d))
          hf (drive "--out=html" FULL (pdf d))
          hg (str "test/slice/" d ".html")
          hfg (str "test/slice/" d ".full.html")]
      (swap! timings conj [d (:ms m)])
      (check (zero? (:exit m)) d ": the driver ran")
      (check (= (str (:out m) "\n") golden) d ": JSON is test/para/" d ".json")
      (when update?
        (fs/create-dirs "test/slice")
        (spit hg (:out h)) (spit hfg (:out hf)))
      (check (and (fs/exists? hg) (= (:out h) (slurp hg))) d ": HTML is " hg)
      (check (and (fs/exists? hfg) (= (:out hf) (slurp hfg))) d ": full HTML is " hfg)
      (check (= (html-paragraphs (:out h)) (json-paragraphs (:out m)))
             d ": the HTML's <p> are the JSON's paragraphs, in order (" (count (json-paragraphs (:out m))) ")")
      ;; 3. the async source and the other adapters
      (if (no-async? label)
        (check (and (= (:out (drive "--pretty" "--chunk=512" (pdf d))) (:out m)) (= (:out (drive "--out=html" "--chunk=512" (pdf d))) (:out h)))
               d ": --chunk=512 (no async source here) is the in-memory JSON and HTML, byte for byte")
        (let [a (drive "--pretty" "--chunk=512" "--async" "--stats" (pdf d))
              ah (drive "--out=html" "--chunk=512" "--async" (pdf d))
              stats (re-find #"attempts=(\d+) fetch-rounds=(\d+) bytes-requests=(\d+) source-reads=(\d+) bytes-fetched=(\d+) of (\d+)" (:err a))]
          (check (and (= (:out a) (:out m)) (= (:out ah) (:out h)))
                 d ": --chunk=512 --async is the in-memory JSON and HTML, byte for byte")
          (check (and stats (> (Long/parseLong (nth stats 1)) 1) (> (Long/parseLong (nth stats 2)) 0))
                 d ": it missed and re-ran: " (str/trim (:err a)))))
      (doseq [src ["seek" "spool"]]
        (check (= (:out (drive "--pretty" (str "--source=" src) (pdf d))) (:out m)) d ": --source=" src " is the same JSON"))))

  ;; LAZY READS (D058, D483): the big picture is never fetched. Every host with a counting (async) source reads at most a tenth of it, at
  ;; the browser's chunk (4 KiB) and at the slice's 512 bytes, and gives the Model that memory gives.
  (when-not (no-async? label)
    (let [mem (drive big-picture-path)]
      (check (zero? (:exit mem)) "the one-page big-picture document (" big-picture-length " bytes) converts")
      (doseq [chunk ["--chunk=4096" "--chunk=512"]]
        (let [a (drive chunk "--async" "--stats" big-picture-path)
              [_ fetched total] (re-find #"bytes-fetched=(\d+) of (\d+)" (:err a))
              fetched (some-> fetched Long/parseLong)]
          (check (and (zero? (:exit a)) (= (:out a) (:out mem)) fetched (= (Long/parseLong total) big-picture-length))
                 chunk " --async over the big-picture document is the in-memory Model")
          (check (and fetched (< (* 10 fetched) big-picture-length))
                 chunk " --async reads " fetched " of " big-picture-length " bytes of the one-page big-picture document (at most a tenth: a rule that needs a length or a header must not fetch a picture)")))))

  (ok "driver wall time per fixture (ms, in memory, baseline): "
      (str/join ", " (for [[d ms] @timings] (format "%s %.0f" d ms))))

  ;; ------------------------------------------------------- 4. the evidence dump

  (let [e (drive "--out=evidence" "test/pdf/minimal.pdf")]
    (check (= (str (:out e) "\n") (slurp "test/content/minimal.evidence.json"))
           "--out=evidence of test/pdf/minimal.pdf is the P1.7 golden"))

  ;; ----------------------------------------------------------- 5. the errors

  (defn err [name code & args]
    (let [r (apply drive args)]
      (check (and (= code (:exit r)) (= "" (:out r)) (str/includes? (:err r) (str "error: " name)))
             "driver " (str/join " " args) " -> error: " name ", exit " code)))

  (err "password-required" 4 "test/pdf/p3/crypt-aes-128-user.pdf")
  (err "password-incorrect" 4 "--password=wrong" "test/pdf/p3/crypt-aes-128-user.pdf")
  (err "encryption-unsupported" 4 "test/pdf/p3/unsupported-pubsec.pdf")
  (err "unsupported-format" 4 "test/pdf/notpdf.pdf")
  ;; images are read (P6.1, D187): one `image` page per frame; what the port cannot read is refused by name
  (let [r (drive "test/image/png-rgb8.png") k (drive "test/image/tiff-multi3-g4.tif")]
    (check (and (zero? (:exit r)) (str/includes? (:out r) "\"kind\":\"image\"") (str/includes? (:out r) "\"format\":\"png\""))
           "driver test/image/png-rgb8.png -> a Model of one image page")
    (check (and (zero? (:exit k)) (= 3 (count (re-seq #"\"kind\":\"image\"" (:out k)))))
           "driver test/image/tiff-multi3-g4.tif -> a Model of three image pages"))
  (err "unsupported-image" 4 "test/image/tiff-jpeg.tif")
  (err "undecodable" 4 "test/image/png-truncated.png")
  ;; assets (P3.13, D117): `--assets=images` converts, writes its settings and an `assets` array (empty when no figure is an
  ;; image), and a figure that is one embedded JPEG becomes asset 0 with its file written beside by the driver; off is a run
  ;; without the flag
  (let [r (drive "--assets=images" (pdf "h-plain"))
        d (drive "--assets=images" "test/assets/dct-rgb.pdf")
        n (drive "--assets=none" (pdf "h-plain"))
        p (drive (pdf "h-plain"))]
    (check (and (zero? (:exit r)) (str/includes? (:out r) "\"assets\":\"images\"") (str/ends-with? (str/trim (:out r)) "\"assets\":[]}"))
           "driver --assets=images -> the settings and an empty `assets` array for a document with no image")
    (check (and (zero? (:exit d)) (str/includes? (:out d) "\"asset\":0") (str/includes? (:out d) "\"origin\":\"embedded\"")
                (str/includes? (:out d) "\"type\":\"image/jpeg\""))
           "driver --assets=images test/assets/dct-rgb.pdf -> asset 0, an embedded JPEG")
    (check (and (zero? (:exit n)) (= (:out n) (:out p)) (not (str/includes? (:out n) "\"assets\"")))
           "driver --assets=none is a run without the flag: no `assets` anywhere"))
  (let [r (drive "--password=user-secret" "test/pdf/p3/crypt-aes-128-user.pdf")
        p (drive "test/pdf/p3/plain.pdf")]
    (check (and (zero? (:exit r)) (= (:out r) (:out p))) "--password=user-secret opens the locked file to the plain twin's Model"))
  (check (= 2 (:exit (drive "--nonsense" (pdf "h-plain")))) "an unknown flag is a usage error, exit 2")))

;; --------------------------------------------------------------- 6. THE BROWSER (P9.3, D356)
;;
;; The Rust host built for wasm32 and driven by the JS SDK in a headless Chrome (`test/driver/wasm/`): the slice's fixtures through every
;; byte-source adapter of SPEC 13.1 (an ArrayBuffer, a Uint8Array view, a Blob, a File, a URL read by `Range`, a spooled ReadableStream,
;; any `{size, read}`, an ArrayBuffer read by range, and a `{size, read}` over 512-byte chunks that misses and re-runs) give the goldens'
;; JSON and HTML, byte for byte; the named errors and the images through it. Without the toolchain
;; (`kin/scripts/emon-wasm-run` exits 3: a nightly with rust-src, Node 22, Chrome, the JS devDependencies) the arm is left out, loudly.
(def wasm
  (let [r @(process {:out :string :err :string} "kin/scripts/emon-wasm-run" "--check")]
    (case (:exit r)
      0 (str/trim (:out r))
      3 (do (println (str "  " (str/trim (:err r)) " (the wasm arm is left out)")) nil)
      (do (println "  FAIL the wasm module did not build:\n" (:err r)) (System/exit 1)))))

(defn sections
  "A bundle's sections by name (`== json` ... `== intake`)."
  [s]
  (let [names ["json" "json-pretty" "html" "html-full" "evidence" "intake"]
        marks (loop [ns names from 0 acc []]
                (if (empty? ns)
                  acc
                  (let [m (str "== " (first ns) "\n")
                        i (str/index-of s m from)]
                    (recur (rest ns) (+ i (count m)) (conj acc [i (+ i (count m))])))))]
    (into {} (map-indexed (fn [k [_ b]]
                            [(nth names k) (subs s b (if-let [nxt (get marks (inc k))] (dec (first nxt)) (dec (count s))))])
                          marks))))

(when wasm
  (binding [*label* "[wasm] "]
    (let [adapters ["array" "u8" "blob" "file" "url" "stream" "custom" "lazy" "async512"]
          pdf (fn [d] (str "test/corpus/synth/pdf/" d ".pdf"))
          jobs (vec (concat
                     (for [d docs a adapters] {:id (str d "-" a) :path (pdf d) :adapter a})
                     [{:id "minimal" :path "test/pdf/minimal.pdf" :adapter "array"}
                      {:id "locked" :path "test/pdf/p3/crypt-aes-128-user.pdf" :adapter "array"}
                      {:id "wrongpw" :path "test/pdf/p3/crypt-aes-128-user.pdf" :adapter "array" :password "wrong"}
                      {:id "rightpw" :path "test/pdf/p3/crypt-aes-128-user.pdf" :adapter "url" :password "user-secret"}
                      {:id "plain" :path "test/pdf/p3/plain.pdf" :adapter "array"}
                      {:id "pubsec" :path "test/pdf/p3/unsupported-pubsec.pdf" :adapter "array"}
                      {:id "notpdf" :path "test/pdf/notpdf.pdf" :adapter "blob"}
                      {:id "png" :path "test/image/png-rgb8.png" :adapter "blob"}
                      {:id "tiff3" :path "test/image/tiff-multi3-g4.tif" :adapter "url"}
                      {:id "tiffjpeg" :path "test/image/tiff-jpeg.tif" :adapter "array"}
                      {:id "pngcut" :path "test/image/png-truncated.png" :adapter "array"}
                      {:id "assets-none" :path (pdf "h-plain") :adapter "array"}
                      {:id "assets-dct" :path "test/assets/dct-rgb.pdf" :adapter "array" :assets "images"}]))
          base ".cache/slice-wasm"
          outd (str base "/out")
          jf (str base "/jobs.json")]
      (fs/create-dirs base)
      (fs/delete-tree outd)
      (spit jf (json/generate-string jobs))
      (let [r @(process {:out :string :err :string :extra-env {"EMON_WASM_MODULE" wasm}} "kin/scripts/emon-wasm-run" "--jobs" jf "--out" outd)]
        (check (zero? (:exit r)) "the browser driver ran " (count jobs) " conversions (" (str/trim (:err r)) ")"))
      (let [ans (fn [id] {:exit (parse-long (slurp (str outd "/" id ".exit")))
                          :err (slurp (str outd "/" id ".err"))
                          :out (slurp (str outd "/" id ".out"))
                          :stats (when (fs/exists? (str outd "/" id ".stats")) (json/parse-string (slurp (str outd "/" id ".stats")) true))
                          :sec (when (zero? (parse-long (slurp (str outd "/" id ".exit")))) (sections (slurp (str outd "/" id ".out"))))})
            err (fn [id name code]
                  (let [r (ans id)]
                    (check (and (= code (:exit r)) (= "" (:out r)) (str/includes? (:err r) (str "error: " name)))
                           id " -> error: " name ", exit " code)))]
        (doseq [d docs]
          (let [golden (slurp (str "test/para/" d ".json"))
                hg (slurp (str "test/slice/" d ".html"))
                hfg (slurp (str "test/slice/" d ".full.html"))]
            (doseq [a adapters]
              (let [r (ans (str d "-" a))]
                (check (and (zero? (:exit r)) (= (str (get-in r [:sec "json-pretty"]) "\n") golden)
                            (= (get-in r [:sec "html"]) hg) (= (get-in r [:sec "html-full"]) hfg))
                       d ": " a " gives test/para/" d ".json and the HTML goldens, byte for byte"))
              (when (#{"lazy" "async512"} a)
                (let [s (:stats (ans (str d "-" a)))]
                  (check (and s (> (:attempts s) 1) (> (:fetchRounds s) 0) (< (:bytesRead s) (+ (:inputBytes s) 1)))
                         d ": " a " read by range, missed and re-ran: " (select-keys s [:attempts :fetchRounds :bytesRequests :reads :bytesRead :inputBytes])))))))
        (check (= (str (get-in (ans "minimal") [:sec "evidence"]) "\n") (slurp "test/content/minimal.evidence.json"))
               "the evidence dump of test/pdf/minimal.pdf is the P1.7 golden")
        (err "locked" "password-required" 4)
        (err "wrongpw" "password-incorrect" 4)
        (err "pubsec" "encryption-unsupported" 4)
        (err "notpdf" "unsupported-format" 4)
        (err "tiffjpeg" "unsupported-image" 4)
        (err "pngcut" "undecodable" 4)
        (check (= (get-in (ans "rightpw") [:sec "json"]) (get-in (ans "plain") [:sec "json"]))
               "the password opens the locked file, read by range from a URL, to the plain twin's Model")
        (check (str/includes? (get-in (ans "png") [:sec "json"]) "\"kind\":\"image\"") "a PNG, from a Blob, is a Model of one image page")
        (check (= 3 (count (re-seq #"\"kind\":\"image\"" (get-in (ans "tiff3") [:sec "json"])))) "a multi-page TIFF, read by range from a URL, is three image pages")
        (check (and (str/includes? (get-in (ans "assets-dct") [:sec "json"]) "\"asset\":0") (str/includes? (get-in (ans "assets-dct") [:sec "json"]) "\"type\":\"image/jpeg\""))
               "assets=images of test/assets/dct-rgb.pdf: asset 0, an embedded JPEG")
        (check (not (str/includes? (get-in (ans "assets-none") [:sec "json"]) "\"assets\"")) "assets none: no `assets` anywhere"))
      (fs/delete-tree outd))))

(if (zero? @fails)
  (ok "the first vertical slice: " (count docs) " fixtures, PDF to JSON and HTML on the Rust host, the Go host" (if java-exe " and the Java host" "") (if cs-exe " and the C# host" "") (if c-exe ", the C binding" "") (if pod-exe ", the babashka pod" "") (if wasm " and in the browser (WASM + JS SDK, nine byte-source adapters)" "") ", in memory and async")
  (do (println "  FAIL" @fails "check(s) failed") (System/exit 1)))
