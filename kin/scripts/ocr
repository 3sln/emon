#!/usr/bin/env bb
;; A real engine's OCR, replayed from a transcript: recorded on Rust (Tesseract),
;; replayed on Rust and Go.   kin/scripts/ocr     (DEVLOG P2.6, D095)
;;
;; THE LIVE ENGINE IS NOT HERE. `tools/ocr/record.clj` ran Tesseract once on one
;; scanned page (`test/corpus/synth/scan/h-keyword.pdf`, page 1) and committed what
;; it answered: `test/ocr/h-keyword/` (the transcript) and `test/ocr/h-keyword.dump`
;; (the driver's stdout at recording). This gate only REPLAYS, so it tests emon and
;; never whose Tesseract is installed (SPEC 7.3). It holds:
;;
;;   1. the Rust replay and the Go replay print the IDENTICAL dump -- the evidence v2 (D096: `oruns`
;;      with orientation, script and confidences; `oblocks`, `olines`, `owords`, `osyms` and `oalts`
;;      with text, boxes, confidences, baselines, the hierarchy, styles, languages; `feats`), a hash of
;;      the bitmap's pixels and of each transcript file -- and it is the dump the live recording printed;
;;   2. the evidence is the answer's whole extension: 150+ words, one run, the 24 lines, every symbol
;;      and every alternative with its full text, alternatives on most of the words;
;;   3. a first CER of that evidence against the page's gold, under a ceiling;
;;   4. a replay never guesses: a changed request is `transcript-miss` on both;
;;   5. (P6.5) the committed SCAN transcripts of test/ocr/scan/, through the WHOLE Engine on Rust and on Go to one Model, the Model's
;;      provenance, `transcript-miss` for a changed request, the no-engine conversion, and the `emon-replay` accuracy ratchet;
;;   6. (P9.3) the same scans through the BROWSER (the WASM host and the JS SDK in a headless Chrome, when the toolchain is there):
;;      the committed transcripts replayed to the Rust Engine's identical bundle, `transcript-miss` for a changed request, and the
;;      no-engine conversion (`unsupported` is an answer). tesseract.js itself, live, is `bb wasm`.
(require '[babashka.fs :as fs]
         '[babashka.classpath :as cp]
         '[babashka.process :refer [shell process]]
         '[cheshire.core :as json]
         '[clojure.string :as str])
(cp/add-classpath "tools")
(require '[ocr.cer :as cer])

(def fails (atom 0))
(defn ok [& xs] (println (str "  ok   " (apply str xs))))
(defn bad [& xs] (swap! fails inc) (println (str "  FAIL " (apply str xs))))
(defn check [pass? & msg] (if pass? (apply ok msg) (apply bad msg)))

(def id "h-keyword")
(def pdf (str "test/corpus/synth/scan/" id ".pdf"))
(def tdir (str "test/ocr/" id))
(def cer-ceiling 0.05)

(def work (str (fs/create-temp-dir {:prefix "emon-ocr."})))
(.addShutdownHook (Runtime/getRuntime) (Thread. (fn [] (fs/delete-tree work))))

(defn exec [dir & cmd]
  (let [r @(apply process {:dir dir :out :string :err :string} cmd)]
    {:exit (:exit r) :out (:out r) :err (:err r)}))

(shell {:out :string :err :string} "kin/scripts/emit")

;; THE BROWSER ARM (P9.3, D356) is optional: `emon-wasm-run --check` exits 3 with `SKIP wasm -- why` on stderr when the toolchain is
;; missing, and the arm is then left out, LOUDLY, and nothing fails.
(def wasm
  (let [r @(process {:out :string :err :string} "kin/scripts/emon-wasm-run" "--check")]
    (case (:exit r)
      0 (str/trim (:out r))
      3 (do (println (str "  " (str/trim (:err r)) " (the wasm arm is left out)")) nil)
      (do (println "  FAIL the wasm module did not build:\n" (:err r)) (System/exit 1)))))

(defn build-rust []
  (let [d (str work "/rust")]
    (fs/create-dirs (str d "/emon"))
    (doseq [f (fs/glob "gen/rust/emon" "*.rs")] (fs/copy f (str d "/emon/" (fs/file-name f))))
    (doseq [f ["port.rs" "testport.rs" "plan.rs"]] (fs/copy (str "host/rust/src/" f) (str d "/" f)))
    (spit (str d "/emon.rs")
          (apply str (for [f (sort (map fs/file-name (fs/glob "gen/rust/emon" "*.rs")))]
                       (str "pub mod " (str/replace f #"\.rs$" "") ";\n"))))
    (fs/copy "test/ocr/rust/main.rs" (str d "/main.rs"))
    ;; no `--cfg live`: nothing here links Tesseract
    (let [r (exec d "rustc" "--edition" "2021" "-O" "-A" "warnings" "-o" "prog" "main.rs")]
      (if (zero? (:exit r))
        (str d "/prog")
        (do (bad "rust driver did not build:\n" (:err r)) nil)))))

(defn build-go []
  (let [d (str work "/go")]
    (fs/copy-tree "gen/go" d)
    (fs/create-dirs (str d "/port"))
    (doseq [f (fs/glob "host/go/port" "*.go")] (fs/copy f (str d "/port/" (fs/file-name f))))
    (fs/create-dirs (str d "/pngenc"))
    (fs/copy "host/go/pngenc/pngenc.go" (str d "/pngenc/pngenc.go"))
    (fs/create-dirs (str d "/planrun"))
    (doseq [f (fs/glob "host/go/planrun" "*.go")] (fs/copy f (str d "/planrun/" (fs/file-name f))))
    (spit (str d "/go.mod") "module emon\n\ngo 1.21\n")
    (fs/copy "test/ocr/go/main.go" (str d "/main.go"))
    (let [r (exec d "go" "build" "-o" "prog" ".")]
      (if (zero? (:exit r))
        (str d "/prog")
        (do (bad "go driver did not build:\n" (:err r)) nil)))))

(def rust (if (fs/which "rustc") (build-rust) (do (println "  SKIP rust   -- rustc not on PATH") nil)))
(def go (if (fs/which "go") (build-go) (do (println "  SKIP go     -- go not on PATH") nil)))

(def abs #(str (fs/absolutize %)))

(when (and rust go)
  (let [want (str/trim (slurp (str tdir ".dump")))
        t (abs tdir)
        pdf* (abs pdf)
        run (fn [prog dir] (let [r (exec work prog "replay" dir pdf*)] (assoc r :out (str/trim (:out r)))))
        rr (run rust t)
        rg (run go t)]
    ;; 1. identity ----------------------------------------------------------
    (check (and (zero? (:exit rr)) (= want (:out rr)))
           "rust replays the committed transcript to the dump the live recording printed ("
           (count want) " bytes: evidence, bitmap hash, file hashes)")
    (check (and (zero? (:exit rg)) (= (:out rr) (:out rg)))
           "GO REPLAYS THE TESSERACT TRANSCRIPT: the identical dump, byte for byte")
    ;; 2. what the evidence is ----------------------------------------------
    (let [ev (cer/dump-evidence (:out rr))
          ws (:owords ev)
          runs (:oruns ev)
          lines (:olines ev)
          syms (:osyms ev)
          alts (:oalts ev)
          sym-count (reduce + (map #(second (:syms %)) ws))
          alt-count (reduce + (map #(second (:alts %)) syms))
          with-alts (count (filter (fn [w] (let [[f n] (:syms w)]
                                             (some #(pos? (second (:alts %))) (subvec (vec syms) f (+ f n)))))
                                   ws))]
      (check (and (>= (count ws) 150) (every? :text ws))
             (count ws) " OCR words, each with its text")
      (check (and (= 1 (count runs))
                  (let [r (first runs)] (and (:script r) (contains? r :osd) (contains? r :sconf) (contains? r :oconf) (:flags r))))
             "one OCR run, with its orientation, script and confidences")
      (check (and (= 24 (count lines)) (every? #(and (:baseline %) (:words %) (:par %) (:px %)) lines)
                  (seq (:oblocks ev)))
             (count lines) " OCR lines, each with a baseline, its words, a paragraph and a pixel box, in "
             (count (:oblocks ev)) " blocks and paragraphs")
      (check (and (every? #(and (:baseline %) (:line %) (:px %)) ws) (= (count ws) (count (:feats ev))))
             "every word has a baseline, a line, a pixel box and a feature row")
      (check (and (= sym-count (count syms)) (every? #(and (:box %) (:conf %)) syms)
                  (= alt-count (count alts)) (every? :text alts))
             (count syms) " symbols, each with a box and a confidence, and " (count alts)
             " alternatives, each with its full text")
      (check (> with-alts (* 0.9 (count ws)))
             with-alts " of the words carry symbol alternatives")
      ;; 3. a first CER ------------------------------------------------------
      (let [r (cer/cer (:out rr) (str "test/corpus/synth/gold/" id ".gold.json"))]
        (check (< (:cer r) cer-ceiling)
               (format "CER %.4f against the gold (%d edits over %d chars), ceiling %.2f"
                       (:cer r) (:distance r) (:gold-chars r) cer-ceiling))))
    ;; 4. a replay never guesses --------------------------------------------
    (let [edn (slurp (str tdir "/transcript.edn"))
          tam (str work "/tampered")]
      (fs/create-dirs tam)
      (doseq [f (fs/list-dir t)] (fs/copy f (str tam "/" (fs/file-name f))))
      (check (str/includes? edn "[10 3 2 1 3 3 0 0 0 0]") "the OCR request is where the tamper expects it")
      (spit (str tam "/transcript.edn") (str/replace-first edn "[10 3 2 1 3 3 0 0 0 0]" "[10 3 2 1 4 3 0 0 0 0]"))
      (doseq [[name prog] [["rust" rust] ["go" go]]]
        (let [r (run prog tam)]
          (check (and (= 3 (:exit r)) (= "error: transcript-miss" (:out r)))
                 name " replay of a changed request (psm 3 -> 4): transcript-miss, nothing guessed"))))))

;; ---------------------------------------------------------------------------------------------------------------------------
;; 5. THE COMMITTED SCANS, through the whole Engine (P6.5, D211-D216). `tools/ocr/record-scan.clj` recorded each of test/ocr/scan/ID/
;; live on Rust (a slim transcript: the engine's answers and its `:producer`, no bitmaps). Here the Rust Engine and the Go Engine each
;; REPLAY it from the scan's own bytes: no Ocr port, no Tesseract. What must hold:
;;   * both give the identical bundle (JSON compact and pretty, HTML default and full, evidence, intake);
;;   * the Model says where the text came from (`settings.ocr`, `scanned` pages, `ocr` sources) and has the text;
;;   * a changed request (the engine's `psm`) is `transcript-miss` on both: a replay never guesses;
;;   * with NO transcript and no port the same scan converts, to pages with no text, identically on both (`unsupported` is an answer);
;;   * `bb accuracy --predictor emon-replay` over these documents holds its ratchet (the scoreboard's `emon-replay`).
(def scan-dir "test/ocr/scan")
(def scan-ids (when (fs/exists? scan-dir) (vec (sort (map fs/file-name (filter fs/directory? (fs/list-dir scan-dir)))))))

(defn build-driver [script env what]
  (let [r @(process {:out :string :err :string :extra-env env} script)]
    (if (zero? (:exit r))
      (str/trim (:out r))
      (do (bad "the " what " Engine driver did not build:\n" (:err r)) nil))))

;; THE JAVA ENGINE (P9.1, D449) replays the same transcripts: optional, left out LOUDLY without a JDK 22+ (`emon-java-build` exits 3);
;; EMON_SKIP_JAVA=1 leaves it out on purpose
(defn java-driver []
  (if (System/getenv "EMON_SKIP_JAVA")
    (do (println "  SKIP java engine -- EMON_SKIP_JAVA is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-java-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the Java arm is left out)")) nil)
        (do (bad "the Java Engine driver did not build:\n" (:err r)) nil)))))

;; THE C# ENGINE (P9.2, D1023) replays the same transcripts: optional, left out LOUDLY without a .NET 8+ SDK (`emon-cs-build` exits 3);
;; EMON_SKIP_CSHARP=1 leaves it out on purpose
(defn cs-driver []
  (if (System/getenv "EMON_SKIP_CSHARP")
    (do (println "  SKIP csharp engine -- EMON_SKIP_CSHARP is set") nil)
    (let [r @(process {:out :string :err :string} "kin/scripts/emon-cs-build")]
      (case (:exit r)
        0 (str/trim (:out r))
        3 (do (println (str "  " (str/trim (:err r)) " (the C# arm is left out)")) nil)
        (do (bad "the C# Engine driver did not build:\n" (:err r)) nil)))))

(when (seq scan-ids)
  (let [rdrv (when (fs/which "cargo") (build-driver "kin/scripts/emon-rs-build" {} "Rust"))
        gdrv (when (fs/which "go") (build-driver "kin/scripts/emon-go-build" {} "Go"))
        jdrv (java-driver)
        cdrv (cs-driver)]
    (when-not rdrv (println "  SKIP rust engine -- cargo not on PATH"))
    (when-not gdrv (println "  SKIP go engine   -- go not on PATH"))
    (when (and rdrv gdrv)
      (let [drive (fn [drv & a] (let [r @(apply process {:out :string :err :string} (abs drv) (map str a))]
                                  {:exit (:exit r) :out (:out r) :err (:err r)}))
            same? (fn [a b] (and (= (:exit a) (:exit b)) (= (:out a) (:out b)) (= (:err a) (:err b))))]
        (doseq [id scan-ids]
          (let [pdf (abs (str "test/corpus/synth/scan/" id ".pdf"))
                dir (abs (str scan-dir "/" id))
                rr (drive rdrv "--out=bundle" (str "--replay=" dir) pdf)
                rg (drive gdrv "--out=bundle" (str "--replay=" dir) pdf)
                edn (slurp (str dir "/transcript.edn"))
                tam (str work "/tamper-" id)]
            (check (and (zero? (:exit rr)) (same? rr rg))
                   id ": the Rust Engine and the Go Engine replay the committed transcript to the IDENTICAL bundle ("
                   (count (:out rr)) " bytes: JSON, HTML, evidence)")
            (when jdrv
              (let [rj (drive jdrv "--out=bundle" (str "--replay=" dir) pdf)]
                (check (same? rr rj)
                       id ": THE JAVA ENGINE replays the Tesseract transcript to the identical bundle, byte for byte")))
            (when cdrv
              (let [rc (drive cdrv "--out=bundle" (str "--replay=" dir) pdf)]
                (check (same? rr rc)
                       id ": THE C# ENGINE replays the Tesseract transcript to the identical bundle, byte for byte")))
            (check (and (str/includes? (:out rr) "\"ocr\":\"always\"") (str/includes? (:out rr) "\"kind\":\"scanned\"")
                        (str/includes? (:out rr) "\"src\":[\"ocr\",\"infer\"]") (str/includes? (:out rr) "\"ocr-only\""))
                   id ": the Model says where the text came from (settings.ocr, scanned pages, ocr sources, ocr-only)")
            (check (and (str/includes? edn ":producer {:engine \"tesseract\"") (not (str/includes? edn ":bitmap")))
                   id ": the transcript names its engine and carries no bitmap")
            ;; a changed request
            (fs/create-dirs tam)
            (spit (str tam "/transcript.edn") (str/replace edn #"(:kind :ocr :req \[\d+ 3 \d+ \d+ )3 " (fn [[_ p]] (str p "4 "))))
            (let [tr (drive rdrv "--out=bundle" (str "--replay=" tam) pdf)
                  tg (drive gdrv "--out=bundle" (str "--replay=" tam) pdf)]
              (check (and (not= edn (slurp (str tam "/transcript.edn")))
                          (= 4 (:exit tr)) (= 4 (:exit tg))
                          (str/includes? (:err tr) "error: transcript-miss") (str/includes? (:err tg) "error: transcript-miss"))
                     id ": a changed request (psm 3 -> 4) is transcript-miss on both Engines, nothing guessed")
              (when jdrv
                (let [tj (drive jdrv "--out=bundle" (str "--replay=" tam) pdf)]
                  (check (and (= 4 (:exit tj)) (same? tg tj))
                         id ": the same changed request is transcript-miss on the Java Engine, with the same stderr (the sentence is kin's)")))
              (when cdrv
                (let [tc (drive cdrv "--out=bundle" (str "--replay=" tam) pdf)]
                  (check (and (= 4 (:exit tc)) (same? tg tc))
                         id ": the same changed request is transcript-miss on the C# Engine, with the same stderr (the sentence is kin's)"))))
            ;; no transcript, no port
            (let [nr (drive rdrv "--out=bundle" pdf)
                  ng (drive gdrv "--out=bundle" pdf)]
              (check (and (zero? (:exit nr)) (same? nr ng) (not (str/includes? (:out nr) "\"ocr\":\"always\""))
                          (not (str/includes? (:out nr) "\"kind\":\"scanned\"")))
                     id ": with no engine the same scan converts to pages with no text, the same on both (`unsupported` is an answer)")
              (when jdrv
                (check (same? nr (drive jdrv "--out=bundle" pdf))
                       id ": and the same on the Java Engine"))
              (when cdrv
                (check (same? nr (drive cdrv "--out=bundle" pdf))
                       id ": and the same on the C# Engine")))))
        ;; THE BROWSER (P9.3, D356, D358): the Rust host built for wasm32, driven by the JS SDK in a headless Chrome, replays the same
        ;; committed transcripts to the Rust Engine's bundle; a changed request is `transcript-miss` there too; and with no OCR port and no
        ;; transcript the scan converts to pages with no text, as on Rust (`unsupported` is an answer: the SPEC 7.3 rule for a browser with no engine).
        ;; tesseract.js itself is `bb wasm`'s (live, not a gate). Without the toolchain the arm is left out, loudly.
        (when wasm
          (let [base ".cache/ocr-wasm"
                outd (str base "/out")
                scan-pdf (fn [id] (str "test/corpus/synth/scan/" id ".pdf"))
                tamper (fn [id]
                         (let [d (str base "/tamper-" id)
                               edn (slurp (str scan-dir "/" id "/transcript.edn"))]
                           (fs/create-dirs d)
                           (spit (str d "/transcript.edn") (str/replace edn #"(:kind :ocr :req \[\d+ 3 \d+ \d+ )3 " (fn [[_ p]] (str p "4 "))))
                           d))]
            (fs/create-dirs base)
            (fs/delete-tree outd)
            (spit (str base "/jobs.json")
                  (json/generate-string
                   (vec (mapcat (fn [id]
                                  [{:id (str id "-replay") :path (scan-pdf id) :adapter "blob" :replayDir (str scan-dir "/" id) :replay ["transcript.edn"]}
                                   {:id (str id "-tamper") :path (scan-pdf id) :adapter "array" :replayDir (tamper id) :replay ["transcript.edn"]}
                                   {:id (str id "-noport") :path (scan-pdf id) :adapter "url"}])
                                scan-ids))))
            (let [r @(process {:out :string :err :string :extra-env {"EMON_WASM_MODULE" wasm}} "kin/scripts/emon-wasm-run" "--jobs" (str base "/jobs.json") "--out" outd)]
              (check (zero? (:exit r)) "the browser driver ran " (* 3 (count scan-ids)) " conversions"))
            (doseq [id scan-ids]
              (let [rr (drive rdrv "--out=bundle" (str "--replay=" (abs (str scan-dir "/" id))) (abs (scan-pdf id)))
                    nr (drive rdrv "--out=bundle" (abs (scan-pdf id)))
                    ans (fn [k] {:exit (parse-long (slurp (str outd "/" id "-" k ".exit"))) :out (slurp (str outd "/" id "-" k ".out")) :err (slurp (str outd "/" id "-" k ".err"))})
                    w (ans "replay") t (ans "tamper") n (ans "noport")]
                (check (and (zero? (:exit w)) (= (:out w) (:out rr)))
                       "[wasm] " id ": the browser replays the committed Tesseract transcript to the Rust Engine's IDENTICAL bundle (" (count (:out w)) " bytes)")
                (check (and (= 4 (:exit t)) (str/includes? (:err t) "error: transcript-miss"))
                       "[wasm] " id ": a changed request (psm 3 -> 4) is transcript-miss in the browser, nothing guessed")
                (check (and (zero? (:exit n)) (= (:out n) (:out nr)) (not (str/includes? (:out n) "\"kind\":\"scanned\"")))
                       "[wasm] " id ": with no engine the browser converts the same scan to pages with no text, as Rust does"))))
          (fs/delete-tree ".cache/ocr-wasm"))
        ;; the ratchet
        (let [r @(process {:out :string :err :string} "bb" "tools/accuracy/accuracy.clj" "--predictor" "emon-replay" "--variants" "scan"
                          "--ids" (str/join "," scan-ids))]
          (check (and (zero? (:exit r)) (str/includes? (:out r) "ok   accuracy[emon-replay]") (not (str/includes? (:out r) "FAIL")))
                 "accuracy[emon-replay]: the committed transcripts, replayed, hold their scoreboard entry"
                 (when-let [l (some #(when (str/includes? % "accuracy[emon-replay]") (str/trim %)) (str/split-lines (:out r)))]
                   (str " (" (str/replace l #"^ok +accuracy\[emon-replay\]: " "") ")"))))))))

;; ---------------------------------------------------------------------------------------------------------------------------
;; 6. THE PIXEL SCANS (D392). test/ocr/scan-px/ID/ holds WHOLE transcripts (bitmaps kept, `record-scan.clj --px`): the engine reads pixels
;; since P6.3, and a table on a scan (invoice, bank-statement: the `scan/forms` category) asks for per-cell OCR from them, so a slim
;; transcript of such a page is not what the engine did. Here: both Engines replay to the IDENTICAL bundle, the text is the transcript's
;; (the Model has `ocr` sources), and the `emon-replay-px` ratchet holds `scan/forms` (a table's rows on a tilted scan, D391).
(def px-dir "test/ocr/scan-px")
(def px-ids (when (fs/exists? px-dir) (vec (sort (map fs/file-name (filter fs/directory? (fs/list-dir px-dir)))))))

(when (seq px-ids)
  (let [rdrv (when (fs/which "cargo") (build-driver "kin/scripts/emon-rs-build" {} "Rust"))
        gdrv (when (fs/which "go") (build-driver "kin/scripts/emon-go-build" {} "Go"))
        jdrv (java-driver)
        cdrv (cs-driver)]
    (when (and rdrv gdrv)
      (let [drive (fn [drv & a] (let [r @(apply process {:out :string :err :string} (abs drv) (map str a))]
                                  {:exit (:exit r) :out (:out r) :err (:err r)}))]
        (doseq [id px-ids]
          (let [pdf (abs (str "test/corpus/synth/scan/" id ".pdf"))
                dir (abs (str px-dir "/" id))
                rr (drive rdrv "--out=bundle" (str "--replay=" dir) pdf)
                rg (drive gdrv "--out=bundle" (str "--replay=" dir) pdf)]
            (check (and (zero? (:exit rr)) (= (:exit rr) (:exit rg)) (= (:out rr) (:out rg)) (= (:err rr) (:err rg)))
                   id ": the Rust Engine and the Go Engine replay the whole transcript to the IDENTICAL bundle (" (count (:out rr)) " bytes)")
            (when jdrv
              (let [rj (drive jdrv "--out=bundle" (str "--replay=" dir) pdf)]
                (check (and (zero? (:exit rj)) (= (:out rr) (:out rj)) (= (:err rr) (:err rj)))
                       id ": and the Java Engine replays it to the same bundle")))
            (when cdrv
              (let [rc (drive cdrv "--out=bundle" (str "--replay=" dir) pdf)]
                (check (and (zero? (:exit rc)) (= (:out rr) (:out rc)) (= (:err rr) (:err rc)))
                       id ": and the C# Engine replays it to the same bundle")))
            (check (and (str/includes? (:out rr) "\"ocr\":\"always\"") (str/includes? (:out rr) "\"src\":[\"ocr\",\"infer\"]"))
                   id ": the Model says where the text came from")))
        (let [r @(process {:out :string :err :string} "bb" "tools/accuracy/accuracy.clj" "--predictor" "emon-replay-px" "--variants" "scan"
                          "--ids" (str/join "," px-ids))]
          (check (and (zero? (:exit r)) (str/includes? (:out r) "ok   accuracy[emon-replay-px]") (not (str/includes? (:out r) "FAIL")))
                 "accuracy[emon-replay-px]: the whole transcripts, replayed, hold their scoreboard entry (scan/forms)"
                 (when-let [l (some #(when (str/includes? % "accuracy[emon-replay-px]") (str/trim %)) (str/split-lines (:out r)))]
                   (str " (" (str/replace l #"^ok +accuracy\[emon-replay-px\]: " "") ")"))))))))

(when (pos? @fails) (System/exit 1))
(when (and rust go (zero? @fails))
  (ok "one Tesseract transcript, recorded on Rust, replayed on Rust and Go: one evidence dump"))
