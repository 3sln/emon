#!/bin/sh
# Run EVERY gate, and fail if any gate prints no score.   bb gates
#
# DEVLOG P0.7, and nome's lesson (its D818): a gate nobody runs is not a gate,
# and a gate that exits 0 having checked nothing is worse. So this runs each
# gate listed below and requires three things of it:
#
#   1. it exits 0;
#   2. it prints at least one `  ok ` line -- its SCORE, the claim it made;
#   3. it prints no `FAIL` line (a gate may SKIP a missing toolchain, loudly,
#      but not fail quietly).
#
# THE LIST IS THE DEVLOG'S: every gate named in DEVLOG (P0.1 `check`, P0.2
# `hosts`, `drift`, P0.3/P0.6 `lang-test`, P0.5 `unit`) and nothing that only
# writes (`gen`, `emit`). A gate added to bb.edn and not to this list is
# caught below: every bb.edn task must be either a gate here or named in
# `not_gates`. (`accuracy` was one until the real pipeline existed; with the Rust Engine (P1.10)
# its ratchet binds `emon` and it is a gate, and so is `slice`. D078, D145.)
#
# `check` and `unit` are slow (they compile four languages); the rest are
# seconds. The order is cheapest first, so a stale generated tree fails fast.
set -e
cd "$(dirname "$0")/../.."

gates="hosts drift release-audit api-diff lang-test check unit plan ocr render pdfium-wasm align fusion gfuse artifacts seals sealpx sigs retarget fuzz png-check asset slice embedders identity image repeat accuracy package-check"
not_gates="gen emit gates import corpus-push corpus-pull corpus-test png-bench ocr-live fusion-report fusion-live align-record align-report fusion-record ghost-health render-record pdfium-fetch ink trace corpus-index-sha ci retarget-record sigs-record fusion-bench wasm asset-record baselines limits asset-fig-record rederive c pod fuzz-long perf calibration stamp-ghost sealpx-record parbench gfuse-record gfuse-measure gfuse-icdar samples version docs pdfium-wasm-record demo native cli package release-notes release-verify release-ops publish site tessdata-fetch"

# THE GATES THAT TAKE `--fast` (P11.7, D528): a deterministic SUBSET for pull requests (Rust and Go only, a fixed sample of documents; each
# prints a `FAST <gate>` line saying what it left out). `bb gates --fast GATE...` runs `bb GATE --fast` for each and refuses a gate not listed here.
# ci/gate-map.edn's `:fast` holds the same set (`bb ci map-coverage` fails if they differ). The pull request workflow runs these; the full
# gates run on release, weekly and on demand.
fast_gates="unit identity repeat accuracy slice ocr fusion gfuse retarget artifacts seals sealpx sigs align render image"

# `bb gates GATE...` runs only the named gates (the CI shards of .github/workflows/verify.yml, D266, D550); the
# completeness checks below always run. No arguments: every gate. `bb gates --fast GATE...`: their --fast variants.
fast=""
if [ "${1:-}" = "--fast" ]; then
  fast="--fast"; shift
  [ "$#" -gt 0 ] || { echo "  FAIL bb gates --fast needs the gates to run (a fast run of every gate is not a gate)"; exit 2; }
fi
run="$gates"
if [ "$#" -gt 0 ]; then
  run="$*"
  for g in $run; do
    case " $gates " in *" $g "*) ;; *) echo "  FAIL \`$g\` is not a gate (kin/scripts/gates)"; exit 2 ;; esac
    if [ -n "$fast" ]; then
      case " $fast_gates " in *" $g "*) ;; *) echo "  FAIL gate \`$g\` has no --fast variant (kin/scripts/gates fast_gates): run it in full"; exit 2 ;; esac
    fi
  done
fi

fails=0

# --- the list is complete: every bb.edn task is a gate or a named non-gate ---
tasks=$(sed -n 's/^[ {]*\([a-z][a-z-]*\) *{:doc.*/\1/p' bb.edn | tr '\n' ' ')
for t in $tasks; do
  case " $gates $not_gates " in
    *" $t "*) ;;
    *) echo "  FAIL bb.edn task \`$t\` is neither a gate nor a named non-gate (kin/scripts/gates)"
       fails=$((fails+1)) ;;
  esac
done
for g in $gates; do
  case " $tasks " in
    *" $g "*) ;;
    *) echo "  FAIL gate \`$g\` is not a bb.edn task"; fails=$((fails+1)) ;;
  esac
done

# --- each gate: exit 0, a score, no FAIL ---
log=$(mktemp "${TMPDIR:-/tmp}/emon-gates.XXXXXX")
trap 'rm -f "$log"' EXIT
for g in $run; do
  rc=0
  # shellcheck disable=SC2086
  bb "$g" $fast > "$log" 2>&1 || rc=$?
  scores=$(grep -c '^  ok ' "$log" || true)
  failed=$(grep -c 'FAIL' "$log" || true)
  # a --fast line is the gate's own label ("  FAST gate: a deterministic SUBSET ..."): not a failure, and shown so a green run is never taken for the full gate
  fastlines=$(grep '^  FAST ' "$log" || true)
  if [ "$rc" -ne 0 ] || [ "$failed" -ne 0 ]; then
    echo "  FAIL gate $g${fast:+ (--fast)}: exit $rc, $failed FAIL line(s)"
    tail -15 "$log" | sed 's/^/    /'
    fails=$((fails+1))
  elif [ "$scores" -eq 0 ]; then
    echo "  FAIL gate $g${fast:+ (--fast)} exited 0 and printed no score (no \`  ok \` line): it checked nothing it could say"
    fails=$((fails+1))
  else
    echo "  ok   gate $g${fast:+ (FAST subset)}: $scores score line(s)"
    [ -z "$fastlines" ] || printf '%s\n' "$fastlines" | sed 's/^/       /'
  fi
done

[ "$fails" -eq 0 ] || exit 1
if [ "$#" -gt 0 ]; then
  echo "  ok   the named gates ran and printed a score${fast:+ (FAST variants: subsets, not the full gates)}: $run"
else
  echo "  ok   every gate ran and printed a score"
fi
