#!/usr/bin/env bb
;; Write the heading stage's goldens from the Rust Engine's driver (DEVLOG P4.2, P4.4; D167-D171).
;;
;;     kin/scripts/heading-goldens         write test/heading/NAME.json (pretty canonical JSON) for each document below
;;
;; A DEVELOPMENT SCRIPT, run by a person after the stage changed on purpose; no gate runs it. The laws in
;; `kin/headingtest.kin` hold every target to what this wrote (PDF -> content -> style inventory -> headings ->
;; paragraphs and sections -> Model -> JSON, byte for byte), and `kin/scripts/heading-check` holds the goldens
;; to the synthetic GOLD (the HTML's own headings, their levels and numbers): what makes a golden of kin's own
;; output worth anything. The driver is the Engine's, `emon-rs` (`test/driver/rust/main.rs`; the temporary
;; `predict-naive.sh` it replaced is retired, D144), whose pipeline runs the heading analysis (D172).
;;
;; THE DOCUMENTS are the ones the maintainer's requirement is about (a higher heading printed smaller than an
;; inner one: h-inverted, h-inverted-numbered; levels told apart by weight, colour and indent at one size:
;; h-div-samesize; numbering by depth, by letters and romans, by keyword: h-numbered, h-inverted-numbered,
;; h-keyword), a plain one, letter dividers that wrap nothing, and a list that must not become headings.
(require '[clojure.java.io :as io]
         '[clojure.java.shell :as sh]
         '[clojure.string :as str])

(def root (-> *file* io/file .getCanonicalFile .getParentFile .getParentFile .getParentFile .getPath))

(def docs ["h-plain" "h-numbered" "h-keyword" "h-inverted" "h-inverted-numbered" "h-div-samesize"
           "initial-letter-headings" "lists-basic"])

(defn run [& args]
  (let [r (apply sh/sh (concat args [:dir root]))]
    (when-not (zero? (:exit r)) (println (:err r)) (System/exit 1))
    (:out r)))

;; builds the driver when gen/ or host/ changed (predict-emon.sh's stamp), by asking it for a document
(run "sh" "tools/accuracy/predict-emon.sh" "x" "pdf" "test/corpus/synth/pdf/h-plain.pdf" "x")

(.mkdirs (io/file root "test" "heading"))
;; THE TWO THIS CANNOT WRITE FROM THE DRIVER (D470's open item, closed by D488): the driver runs the lists stage and the inline stage, and `headingtest`
;; reads a Model without them, so for a document with a list or inline styles the driver's Model is not the golden's. These two are RE-CONFIDED instead:
;; the committed golden is kept and only the `"conf"` of its section, heading and paragraph nodes is set to what the driver gives those kinds on `h-plain`
;; (the calibrated value, kin/calibdata.kin; every node of a kind in these goldens has the one raw confidence, which is checked). The structure of the
;; two stays what a person last wrote on purpose; a refit moves nothing else in them. On a tree that is consistent this changes nothing.
(def reconf #{"initial-letter-headings" "lists-basic"})
(def conf-kinds #{"section" "heading" "paragraph"})

(defn conf-lines
  "-> [[line-index kind conf-value] ...] for every `\"conf\": N` of a node of a kind in `conf-kinds` in the pretty JSON lines (a node's `kind` precedes its `conf`, at the same indent)."
  [lines]
  (loop [i 0 kinds {} acc []]
    (if (= i (count lines))
      acc
      (let [l (nth lines i)]
        (if-let [[_ ind k] (re-matches #"(\s*)\"kind\": \"(\w+)\",?" l)]
          (recur (inc i) (assoc kinds (count ind) k) acc)
          (if-let [[_ ind n] (re-matches #"(\s*)\"conf\": (\d+),?" l)]
            (let [k (get kinds (count ind))]
              (recur (inc i) kinds (if (conf-kinds k) (conj acc [i k (parse-long n)]) acc)))
            (recur (inc i) kinds acc)))))))

(defn driver-json [d] (run ".cache/emon-rs/target/release/emon-rs" "--pretty" (str "test/corpus/synth/pdf/" d ".pdf")))

;; kind -> the one confidence the driver gives it on h-plain
(def kind-conf
  (let [m (reduce (fn [m [_ k n]] (update m k (fnil conj #{}) n)) {} (conf-lines (str/split-lines (driver-json "h-plain"))))]
    (doseq [k conf-kinds]
      (when-not (= 1 (count (m k))) (println "FAIL h-plain gives" k "the confidences" (pr-str (m k)) "-- want exactly one") (System/exit 1)))
    (update-vals m first)))

(doseq [d docs]
  (if (reconf d)
    (let [f (io/file root "test" "heading" (str d ".json"))
          text (slurp f :encoding "UTF-8")
          lines (vec (str/split-lines text))
          found (conf-lines lines)
          olds (reduce (fn [m [_ k n]] (update m k (fnil conj #{}) n)) {} found)]
      (doseq [[k s] olds :when (> (count s) 1)]
        (println "FAIL test/heading/" (str d ".json") "has" k "nodes of the confidences" (pr-str s) "-- the re-confidence wants one") (System/exit 1))
      (let [new (reduce (fn [ls [i k _]] (update ls i str/replace #"\d+(,?)$" (str (kind-conf k) "$1"))) lines found)]
        (spit f (str (str/join "\n" new) "\n") :encoding "UTF-8")
        (println "  re-confed test/heading/" (str d ".json") (count found) "node(s)")))
    (let [out (driver-json d)]
      (spit (io/file root "test" "heading" (str d ".json")) (str out "\n") :encoding "UTF-8")
      (println "  wrote test/heading/" (str d ".json") (count out) "bytes"))))
