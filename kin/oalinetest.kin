;; The F16-shaped integration law: amounts are copied by slot, neighbouring
;; valid words stay from the incumbent. No corpus, engine or invented output.
(ns emon.oalinetest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq new-cells]]
            [emon.port :refer [cells-push cells-at cells-set cells-len]]
            [emon.scan :refer [sc-prep sc-sel-base]]
            [emon.retarget :refer [rt-prep rtp-nl rtp-line0 rtp-q]]
            [emon.oaline :refer [oa-line-fuse]]
            [emon.evidence :refer [or-new or-set or-get or-count orf-pass orf-wfirst orf-wcount orf-lfirst orf-lcount op-line op-arb
                                   ol-new ol-set ol-get olf-run lh-first lh-count ow-new ow-get ow-count owf-from hd-tstart]]
            [kin.lang :refer [defn return let +]]))

(defn ^I32 oalt-text [^:mut ^Cells text]
  (cells-push text 52)
  (cells-push text 44)
  (cells-push text 52)
  (cells-push text 50)
  (cells-push text 57)
  (cells-push text 44)
  (cells-push text 56)
  (cells-push text 54)
  (cells-push text 55)
  (cells-push text 46)
  (cells-push text 49)
  (cells-push text 53)
  (cells-push text 49)
  (cells-push text 57)
  (cells-push text 48)
  (cells-push text 52)
  (cells-push text 52)
  (cells-push text 44)
  (cells-push text 52)
  (cells-push text 50)
  (cells-push text 51)
  (cells-push text 44)
  (cells-push text 56)
  (cells-push text 54)
  (cells-push text 55)
  (cells-push text 46)
  (cells-push text 49)
  (cells-push text 53)
  (cells-push text 49)
  (cells-push text 57)
  (cells-push text 57)
  (cells-push text 52)
  (return 0))

(deftest test-line-retry-merges-only-the-supported-amount-slot
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (oalt-text text) (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 3)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 3) (or-set runs 1 (orf-wcount) 2)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 240 20 100 20 240 20 0 0 0 3)
    (ol-new lines 1 100 10 240 20 100 20 240 20 0 0 3 2)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 160 20 100 20 160 20 0 0 0 10 0 204 -1)
    (ow-new words 1 165 10 180 20 165 20 180 20 0 0 10 2 0 500 -1)
    (ow-new words 1 200 10 240 20 200 20 240 20 0 0 12 4 0 900 -1)
    (ow-new words 1 100 10 180 20 100 20 180 20 0 1 16 12 0 810 -1)
    (ow-new words 1 200 10 240 20 200 20 240 20 0 1 28 4 0 990 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "one selected line remains")
    (assert-eq (or-count runs) 3 "one synthetic run")
    (assert-eq (or-get runs 2 (orf-pass)) (op-arb) "synthetic arbitration provenance")
    (assert-eq (ow-count words) 7 "two source-backed output words")
    (assert-eq (ow-get words 5 (owf-from)) 4 "amount copied from retry word 3")
    (assert-eq (ow-get words 6 (owf-from)) 3 "1904 copied from incumbent word 2")
    (assert-eq (ow-get words 5 (hd-tstart)) 16 "amount keeps the retry text span verbatim")
    (assert-eq (ow-get words 6 (hd-tstart)) 12 "unrelated 1994 is not adopted")
    (assert-eq (ol-get lines 2 (lh-count)) 2 "split amount becomes one word")
    (assert-eq (cells-at scr (sc-sel-base)) 2 "selection names the synthetic line")
    (assert-eq (cells-len rows) 16 "one decision with source and incumbent ranges")
    (assert-eq (cells-at rows 5) 0 "incumbent range starts at zero")
    (assert-eq (cells-at rows 6) 2 "exactly two incumbent words displaced")
    (assert-eq (cells-at rows 7) 3 "choice is a recorded reading")
    (assert-eq (cells-at rows 12) 606 "confidence margin is preserved")))

(deftest test-line-retry-cannot-concatenate-two-valid-numeric-cells
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 51)
    (cells-push text 46)
    (cells-push text 52)
    (cells-push text 53)
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 51)
    (cells-push text 46)
    (cells-push text 52)
    (cells-push text 53)
    (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 2)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 2) (or-set runs 1 (orf-wcount) 1)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 0 2)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 2 1)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 120 20 100 20 120 20 0 0 0 2 0 900 -1)
    (ow-new words 1 125 10 165 20 125 20 165 20 0 0 2 4 0 900 -1)
    (ow-new words 1 100 10 165 20 100 20 165 20 0 1 6 6 0 999 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "12 and 3.45 remain two valid numeric cells")
    (assert-eq (ow-count words) 3 "the retry's 123.45 is not a new output word")
    (assert-eq (cells-len rows) 0 "no arbitration admission")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "the incumbent line remains selected")))

(deftest test-line-retry-cannot-join-distant-numeric-cells
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 2)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 2) (or-set runs 1 (orf-wcount) 1)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 365 20 100 20 365 20 0 0 0 2)
    (ol-new lines 1 100 10 365 20 100 20 365 20 0 0 2 1)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 120 20 100 20 120 20 0 0 0 3 0 900 -1)
    (ow-new words 1 325 10 365 20 325 20 365 20 0 0 3 2 0 900 -1)
    (ow-new words 1 100 10 365 20 100 20 365 20 0 1 5 5 0 999 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "distant columns remain separate despite one malformed token")
    (assert-eq (ow-count words) 3 "the retry cannot collapse a large gap")
    (assert-eq (cells-len rows) 0 "no arbitration admission")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "the incumbent line remains selected")))

(deftest test-line-retry-keeps-a-separate-currency-token
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (cells-push text 36)
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (cells-push text 36)
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 2)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 2) (or-set runs 1 (orf-wcount) 1)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 0 2)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 2 1)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 110 20 100 20 110 20 0 0 0 1 0 900 -1)
    (ow-new words 1 115 10 165 20 115 20 165 20 0 0 1 5 0 900 -1)
    (ow-new words 1 100 10 165 20 100 20 165 20 0 1 6 6 0 999 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "a separate currency token is not part of the numeric join")
    (assert-eq (ow-count words) 3 "source token boundaries for a separate currency are kept")
    (assert-eq (cells-len rows) 0 "no arbitration admission")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "the incumbent line remains selected")))


(deftest test-line-retry-gap-math-does-not-wrap-at-large-coordinates
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (cells-push text 49)
    (cells-push text 50)
    (cells-push text 46)
    (cells-push text 51)
    (cells-push text 52)
    (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 2)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 2) (or-set runs 1 (orf-wcount) 1)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 400000040 20 100 20 400000040 20 0 0 0 2)
    (ol-new lines 1 100 10 400000040 20 100 20 400000040 20 0 0 2 1)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 120 20 100 20 120 20 0 0 0 3 0 900 -1)
    (ow-new words 1 400000000 10 400000040 20 400000000 20 400000040 20 0 0 3 2 0 900 -1)
    (ow-new words 1 100 10 400000040 20 100 20 400000040 20 0 1 5 5 0 999 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "distant columns remain separate despite one malformed token")
    (assert-eq (ow-count words) 3 "the retry cannot collapse a large gap")
    (assert-eq (cells-len rows) 0 "no arbitration admission")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "the incumbent line remains selected")))


(deftest test-line-retry-arbitration-is-upright-only
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (oalt-text text) (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 3)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 3) (or-set runs 1 (orf-wcount) 2)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 240 20 100 20 240 20 0 0 0 3)
    (ol-new lines 1 100 10 240 20 100 20 240 20 0 0 3 2)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 160 20 100 20 160 20 0 0 0 10 0 204 -1)
    (ow-new words 1 165 10 180 20 165 20 180 20 0 0 10 2 0 500 -1)
    (ow-new words 1 200 10 240 20 200 20 240 20 0 0 12 4 0 900 -1)
    (ow-new words 1 100 10 180 20 100 20 180 20 0 1 16 12 0 810 -1)
    (ow-new words 1 200 10 240 20 200 20 240 20 0 1 28 4 0 990 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (cells-set rtp (rtp-q) 9000)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "turned page keeps its incumbent")
    (assert-eq (cells-len rows) 0 "no arbitration outside upright scans")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "selection unchanged")))

(deftest test-line-retry-cannot-reinterpret-a-split-date-as-money
  (let [^Cells runs (new-cells) ^Cells lines (new-cells) ^Cells words (new-cells)
        ^Cells text (new-cells) ^Cells scr (new-cells) ^Cells rtp (new-cells)
        ^Cells rows (new-cells) ^Cells plan (new-cells) ^Cells joined (new-cells)
        ^Cells im (new-cells) ^Cells cm (new-cells)]
    (cells-push text 49)
    (cells-push text 48)
    (cells-push text 47)
    (cells-push text 49)
    (cells-push text 53)
    (cells-push text 47)
    (cells-push text 48)
    (cells-push text 52)
    (cells-push text 49)
    (cells-push text 48)
    (cells-push text 49)
    (cells-push text 53)
    (cells-push text 46)
    (cells-push text 48)
    (cells-push text 52)
    (sc-prep scr) (rt-prep rtp)
    (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 2)
    (or-set runs 0 (orf-lfirst) 0) (or-set runs 0 (orf-lcount) 1)
    (or-new runs 1 0) (or-set runs 1 (orf-pass) (op-line))
    (or-set runs 1 (orf-wfirst) 2) (or-set runs 1 (orf-wcount) 1)
    (or-set runs 1 (orf-lfirst) 1) (or-set runs 1 (orf-lcount) 1)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 0 2)
    (ol-new lines 1 100 10 165 20 100 20 165 20 0 0 2 1)
    (ol-set lines 0 (olf-run) 0) (ol-set lines 1 (olf-run) 1)
    (ow-new words 1 100 10 120 20 100 20 120 20 0 0 0 3 0 200 -1)
    (ow-new words 1 125 10 165 20 125 20 165 20 0 0 3 5 0 200 -1)
    (ow-new words 1 100 10 165 20 100 20 165 20 0 1 8 7 0 999 -1)
    (cells-set scr (sc-sel-base) 0)
    (cells-set rtp (rtp-nl) 1)
    (cells-set rtp (rtp-line0) 0) (cells-set rtp (+ (rtp-line0) 1) 1)
    (assert-eq (oa-line-fuse 1 rtp runs lines words text scr 1 rows plan joined im cm) 1 "selection remains one line")
    (assert-eq (or-count runs) 2 "a valid joined date cannot become a money amount")
    (assert-eq (ow-count words) 3 "a large margin cannot delete date punctuation")
    (assert-eq (cells-len rows) 0 "no arbitration admission")
    (assert-eq (cells-at scr (sc-sel-base)) 0 "the incumbent line remains selected")))

