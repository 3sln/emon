;; OCR INTO THE PIPELINE: scanned and image pages (P6.5, P6.5a; SPEC 7.2, 7.3, 8.3, 8.4.4, 9.1, 13; D008, D038, D089,
;; D095, D096, D130, D211-D215). emon's own module (D039).
;;
;; kin NEVER CALLS the `Ocr` port (D008): a unit asks for OCR as a request (`rq-ocr`, built by `sc-request`), answers
;; `us-requests`, and is re-run on the answers. This module is what a unit does with an OCR answer:
;;
;;   answer (the extension of `emon.ocr`, version 2)
;;      -> evidence v2 (`sc-answer`): `oruns`, `oblocks`, `olines`, `owords`, `osyms`, `oalts`, `feats`, a `views` row for the
;;         raster that was read and one for the engine's own thresholded image, the page's `epages` row and the
;;         placement of the image (`sc-page`)
;;      -> the lines of the pipeline (`sc-emit-lines`): one `lines` row per OCR line and one `words` row per OCR word,
;;         in the SAME arenas the text layer fills, so everything downstream (furniture, initials, headings,
;;         paragraphs, columns, tables) reads an OCR page as it reads a born-digital one and never learns the
;;         difference (SPEC 9.1: one pipeline)
;;      -> the Model's provenance (`sc-tag`): the text is `ocr`, not `text`, the page kind `scanned`, the
;;         paragraphs flagged `ocr-only`, the document's `settings.ocr` written.
;;
;; WHICH PAGES. An image input is one page per frame (`emon.rasterin`). A PDF page is OCR'd when it has NO text layer at all
;; (no `words` row: not even a hidden one) and carries an image that covers at least a quarter of it (`sc-cover-min`; a half until P12.6) and is upright (a real XObject, not
;; a stencil mask or an inline image). If that image is one plain XObject with exactly one filter, DCT, a JPEG stream is a JPEG file,
;; and the host's `ImageDecode` reads the span in place; in ANY OTHER CODEC (Flate, RunLength, LZW, CCITT, JBIG2, JPX, an encrypted
;; DCT, D564) the host RENDERS the page and the render is the raster (`emon.pageunit`'s scan mode). A page with a text layer is
;; born-digital whatever else it holds: fusion (P7) weighs a second reading against the text layer (D212). A page whose image is
;; rotated or tiled is left to the `Renderer` (P6.2) as a page of its own and has no OCR text.
;;
;; THE PIPELINE'S LINES FROM AN OCR LINE (D213). An OCR line carries what the text layer's does: a box, a baseline, a rotation, a
;; direction, its words. Three things differ and are decided here, once.
;;   * SIZE. A glyph has a font size; an OCR word has a box whose height changes with its letters ("was" has no ascender). The
;;     engine's ROW attributes (x-height and ascender height, version 2) are a property of the LINE, so the line's size is
;;     (x-height + ascenders) / 0.73 (an em), the same for all of its words, and the paragraph and heading stages that compare sizes
;;     compare lines, not letters. With no row attributes it is the line's box height over 0.93.
;;   * THE BOX of a line is its words' extent along the line and, across it, the band the row attributes name around the baseline,
;;     not the axis-aligned box of a line that is tilted: a 1.2 degree scan makes a 1000 pixel line 20 pixels taller, which would
;;     swallow the gap between lines the paragraph stage measures.
;;   * ROTATION. A line's `rot` is its baseline's angle less the page's dominant one (the lower median of the run's lines, as
;;     `xo-angle` is): a scan that was fed in 1 degree off is a page of upright lines, and one line that is not is still not.
;; The evidence rows (`olines`, `owords`) keep the engine's own numbers; only the pipeline's rows are normalised.
(ns emon.scan
  (:require [emon.lang :refer [I32 I64 Cells Src i64 i32 mul64 add64]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop]]
            [emon.pdfsrc :refer [ps-len ps-u8 ps-missed]]
            [emon.plan :refer [rq-ocr rq-ocr-view rq-ocr-lang rq-ocr-end rq-decode an-find an-ok an-arg an-status
                               an-ocr-count an-ocr-first aw-get aw-cp aw-next aw-x aw-y aw-w aw-h aw-conf
                               aw-line aw-block aw-len flt-dct us-requests us-done lay-full]]
            [emon.ocr :refer [ocf-symbols ocf-osd ocf-dpi-unit ox-find ox-line-at ox-first-word ox-block-at
                              ox-wflags ox-wlang ox-wpsize ox-wdflags ox-nsym ox-first-sym ox-sym-next
                              ox-sym-alts ox-alt-next ox-word-next ox-nlines ox-nblocks ox-orient ox-wdir
                              ox-tlorder ox-deskew ox-osd ox-script ox-sconf ox-oconf ox-binary ox-bw ox-bh]]
            [emon.evidence :refer [ep-new ep-set vw-new vw-get vwf-cropx vwf-cropy vw-px-to-cpt vw-box-to-cpt im-new im-get im-count
                                   or-new or-get or-set or-count op-re-rotated ob-new ob-set ob-get ob-count
                                   ol-new ol-set ol-get ol-count ow-new ow-set ow-get ow-count
                                   os-new os-set os-get os-count oa-add oa-count wd-new wd-set wd-get wd-count
                                   ln-new ln-set ln-count etx-append-cp etx-len ev-angle ev-baseline-at
                                   ev-overlap-small ev-rot-median ev-feat-ocr
                                   hd-page hd-x0 hd-y0 hd-x1 hd-y1 hd-bx0 hd-by0 hd-bx1 hd-by1 hd-rot hd-dir
                                   hd-tstart hd-tlen hd-conf
                                   lh-first lh-count lh-x0 lh-y0 lh-x1 lh-y1 lh-bx0 lh-by0 lh-bx1 lh-by1
                                   lh-rot lh-dir
                                   epf-flags epf-dpi
                                   rl-count rl-get rlf-page rlf-lx0 rlf-ly0 rlf-lx1 rlf-ly1 rlf-thick
                                   co-count co-get cf-page cf-x0 cf-y0 cf-x1 cf-y1 cf-conf cf-ink ik-get ikf-role ir-body
                                   oe-garbage oe-rule-ghost oe-corrected
                                   orf-request orf-round orf-pass orf-psm orf-orient orf-wdir orf-lorder orf-deskew
                                   orf-osd orf-script orf-sconf orf-oconf orf-flags orf-bfirst orf-bcount orf-bview
                                   orf-lfirst orf-lcount orf-wfirst orf-wcount orf-lang orf-langlen
                                   obf-btype obf-orient obf-wdir obf-first obf-count obf-x0 obf-y0 obf-x1 obf-y1
                                   olf-retry-gap olf-par olf-run olf-xheight olf-asc olf-desc olf-px olf-py olf-pw olf-ph
                                   owf-style owf-run owf-sfirst owf-scount owf-lang owf-flags owf-psize
                                   owf-px owf-py owf-pw owf-ph
                                   osf-conf osf-afirst osf-acount osf-px osf-py osf-pw osf-ph
                                   wf-style wf-size wf-font wf-gap wf-wbreak wf-src lf-src lf-order ls-revised
                                   ch-x0 ch-y0 ch-x1 ch-y1 ch-cp ld-rtl ld-ttb ob-block ob-paragraph
                                   vk-decode vk-engine-binary eg-raster wb-space wb-line-end
                                   mf-page mf-x0 mf-y0 mf-x1 mf-y1 mf-obj mf-pxw mf-pxh mf-flags mf-rot
                                   mf-skewed mg-mask mg-inline mg-smask]]
            [emon.pdflex :refer [pl-kind-of pl-first pl-next pl-int-value pl-stream-start pl-stream-len]]
            [emon.pdfdoc :refer [pd-get pd-stream-plan pd-pg-count pd-pg-crop pd-pg-rotate]]
            [emon.model :refer [sr-ocr sr-text node-count node-kind node-parent node-region-head node-region-count
                                node-src node-flags node-conf node-set-src node-set-conf node-add-flag nk-is-inline
                                region-page region-next region-x0 region-y0 region-x1 region-y1 fl-rotated fl-ocr-only fl-low-conf fl-script-unread page-count page-set-kind pk-scanned
                                ledger-add dr-ocr-empty dr-ocr-ghost dr-background sr-vector page-w page-h
                                node-text-start node-text-len node-set-text node-set-attr-text text-append-cp fk-ocr]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem bit-and bit-or]]))

;; ================================================================== languages

(defn ^I32 sc-iso3 [^I32 p]
  (comment "A two-letter ISO 639-1 code, packed `a * 256 + b`, as the ISO 639-3 code the `Ocr` port speaks, packed")
  (comment "`a * 65536 + b * 256 + c`; 0 for a code that is not in the table. Standard assignments, not engine names.")
  (if (== p 25966) (return 6647399))   ;; en eng
  (if (== p 25701) (return 6579573))   ;; de deu
  (if (== p 26226) (return 6713953))   ;; fr fra
  (if (== p 25971) (return 7565409))   ;; es spa
  (if (== p 26996) (return 6911073))   ;; it ita
  (if (== p 28788) (return 7368562))   ;; pt por
  (if (== p 28268) (return 7236708))   ;; nl nld
  (if (== p 29558) (return 7567205))   ;; sv swe
  (if (== p 25697) (return 6578542))   ;; da dan
  (if (== p 28258) (return 7237490))   ;; nb nor
  (if (== p 28270) (return 7237490))   ;; nn nor
  (if (== p 28271) (return 7237490))   ;; no nor
  (if (== p 26217) (return 6711662))   ;; fi fin
  (if (== p 28780) (return 7368556))   ;; pl pol
  (if (== p 25459) (return 6514035))   ;; cs ces
  (if (== p 29547) (return 7564395))   ;; sk slk
  (if (== p 29548) (return 7564406))   ;; sl slv
  (if (== p 26741) (return 6845806))   ;; hu hun
  (if (== p 29295) (return 7499630))   ;; ro ron
  (if (== p 25191) (return 6452588))   ;; bg bul
  (if (== p 26738) (return 6845046))   ;; hr hrv
  (if (== p 29554) (return 7565936))   ;; sr srp
  (if (== p 30059) (return 7695218))   ;; uk ukr
  (if (== p 29301) (return 7501171))   ;; ru rus
  (if (== p 25964) (return 6646892))   ;; el ell
  (if (== p 29810) (return 7632242))   ;; tr tur
  (if (== p 24946) (return 6386273))   ;; ar ara
  (if (== p 26725) (return 6841698))   ;; he heb
  (if (== p 26209) (return 6709619))   ;; fa fas
  (if (== p 30066) (return 7696996))   ;; ur urd
  (if (== p 26729) (return 6842734))   ;; hi hin
  (if (== p 25198) (return 6448494))   ;; bn ben
  (if (== p 29793) (return 7627117))   ;; ta tam
  (if (== p 29797) (return 7628140))   ;; te tel
  (if (== p 29800) (return 7628897))   ;; th tha
  (if (== p 30313) (return 7760229))   ;; vi vie
  (if (== p 26980) (return 6909540))   ;; id ind
  (if (== p 28019) (return 7172961))   ;; ms msa
  (if (== p 27233) (return 6975598))   ;; ja jpn
  (if (== p 27503) (return 7040882))   ;; ko kor
  (if (== p 25441) (return 6513012))   ;; ca cat
  (if (== p 27764) (return 7104884))   ;; lt lit
  (if (== p 27766) (return 7102838))   ;; lv lav
  (if (== p 25972) (return 6648692))   ;; et est
  (if (== p 26995) (return 6910828))   ;; is isl
  (if (== p 26465) (return 6777957))   ;; ga gle
  (if (== p 25465) (return 6519149))   ;; cy cym
  (if (== p 25973) (return 6649203))   ;; eu eus
  (if (== p 26476) (return 6777959))   ;; gl glg
  (if (== p 28020) (return 7171188))   ;; mt mlt
  (if (== p 29553) (return 7565673))   ;; sq sqi
  (if (== p 28011) (return 7170916))   ;; mk mkd
  (if (== p 25189) (return 6448492))   ;; be bel
  (if (== p 27489) (return 7037300))   ;; ka kat
  (if (== p 26745) (return 6846821))   ;; hy hye
  (if (== p 24934) (return 6383218))   ;; af afr
  (if (== p 27745) (return 7102836))   ;; la lat
  (if (== p 24954) (return 6388325))   ;; az aze
  (if (== p 27499) (return 7037306))   ;; kk kaz
  (if (== p 30074) (return 7699042))   ;; uz uzb
  (if (== p 28012) (return 7168364))   ;; ml mal
  (if (== p 27502) (return 7037294))   ;; kn kan
  (if (== p 28018) (return 7168370))   ;; mr mar
  (if (== p 26485) (return 6780266))   ;; gu guj
  (if (== p 28769) (return 7364974))   ;; pa pan
  (if (== p 28261) (return 7234928))   ;; ne nep
  (if (== p 29545) (return 7563630))   ;; si sin
  (if (== p 28025) (return 7174497))   ;; my mya
  (if (== p 27501) (return 7039085))   ;; km khm
  (if (== p 27759) (return 7102831))   ;; lo lao
  (if (== p 25199) (return 6451044))   ;; bo bod
  (if (== p 24941) (return 6385000))   ;; am amh
  (return 0))

(defn ^I32 sc-low [^I32 c]
  (comment "ASCII lowercase; anything else as it is.")
  (if (and (>= c 65) (<= c 90)) (return (+ c 32)))
  (return c))

(defn ^I32 sc-is-sep [^I32 c]
  (if (or (== c 45) (== c 95)) (return 1))
  (return 0))

(defn ^:pub ^I32 sc-lang [^Cells loc]
  (comment "The language a locale hint (a BCP 47 tag as code points: `de`, `de-CH`, `zh-Hant-TW`, `eng`) names, as an ISO 639-3")
  (comment "code packed `a * 65536 + b * 256 + c`; 0 when there is no hint or it is not one we can name, and then the")
  (comment "port reads with whatever it has (D038: no language is assumed). Chinese is `chs` or `cht` by its script (`Hant`) or")
  (comment "its region (TW, HK, MO): the port maps them to its simplified and traditional models. A three-letter primary")
  (comment "subtag is taken as it is (`deu`, `fra`, `chi`). With no locale the hint remains absent: D672 lets the port select")
  (comment "one installed discovery model (English when installed), rather than combining all scripts.")
  (let [^I32 n (cells-len loc)
        ^:mut ^I32 i 0
        ^:mut ^I32 plen 0
        ^:mut ^I32 a 0
        ^:mut ^I32 b 0
        ^:mut ^I32 c 0
        ^:mut ^I32 hant 0
        ^:mut ^I32 sub 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 s3 0
        ^:mut ^I32 k 0]
    (if (< n 2) (return 0))
    (comment "the primary subtag")
    (while (and (< i n) (== (sc-is-sep (cells-at loc i)) 0))
      (do (if (== plen 0) (set a (sc-low (cells-at loc i))))
          (if (== plen 1) (set b (sc-low (cells-at loc i))))
          (if (== plen 2) (set c (sc-low (cells-at loc i))))
          (set plen (+ plen 1))
          (set i (+ i 1))))
    (if (== plen 3)
      (do (if (or (< a 97) (> a 122)) (return 0))
          (if (or (< b 97) (> b 122)) (return 0))
          (if (or (< c 97) (> c 122)) (return 0))
          (if (and (== a 122) (and (== b 104) (== c 111))) (set plen 2))
          (if (and (== a 99) (and (== b 104) (== c 105))) (set plen 2))
          (if (== plen 3) (return (+ (+ (* a 65536) (* b 256)) c)))
          (set a 122)
          (set b 104)))
    (if (!= plen 2) (return 0))
    (if (or (< a 97) (> a 122)) (return 0))
    (if (or (< b 97) (> b 122)) (return 0))
    (if (and (== a 122) (== b 104))
      (do (comment "Chinese: look through the other subtags for `hant`, `tw`, `hk`, `mo`")
          (while (< i n)
            (do (if (== (sc-is-sep (cells-at loc i)) 1)
                  (do (set k (+ i 1))
                      (set sub 0)
                      (set s0 0)
                      (set s1 0)
                      (set s2 0)
                      (set s3 0)
                      (while (and (< k n) (== (sc-is-sep (cells-at loc k)) 0))
                        (do (if (== sub 0) (set s0 (sc-low (cells-at loc k))))
                            (if (== sub 1) (set s1 (sc-low (cells-at loc k))))
                            (if (== sub 2) (set s2 (sc-low (cells-at loc k))))
                            (if (== sub 3) (set s3 (sc-low (cells-at loc k))))
                            (set sub (+ sub 1))
                            (set k (+ k 1))))
                      (if (and (== sub 4) (and (== s0 104) (and (== s1 97) (and (== s2 110) (== s3 116)))))
                        (set hant 1))
                      (if (and (== sub 2) (and (== s0 116) (== s1 119))) (set hant 1))
                      (if (and (== sub 2) (and (== s0 104) (== s1 107))) (set hant 1))
                      (if (and (== sub 2) (and (== s0 109) (== s1 111))) (set hant 1))))
                (set i (+ i 1))))
          (if (== hant 1) (return (+ (+ (* 99 65536) (* 104 256)) 116)))
          (return (+ (+ (* 99 65536) (* 104 256)) 115))))
    (return (sc-iso3 (+ (* a 256) b)))))

(defn ^:pub ^I32 sc-request [^:mut ^Cells rq ^I32 id ^I32 bitmap ^I32 dpi ^Cells loc]
  (comment "The OCR request for page-sized bitmap `bitmap` (a decode or render request's id): the whole bitmap, `psm` 3 (fully")
  (comment "automatic page segmentation), symbols with their alternatives and orientation and script detection wanted, the")
  (comment "resolution `dpi` as a hint in the flags (D211), and the language the locale hint names, if any.")
  (let [^I32 q (rq-ocr rq id bitmap 3 (+ (+ (ocf-symbols) (ocf-osd)) (* dpi (ocf-dpi-unit))) 0 0 0 0)
        ^I32 lg (sc-lang loc)]
    (if (> lg 0)
      (rq-ocr-lang rq (quot lg 65536) (rem (quot lg 256) 256) (rem lg 256) 0))
    (rq-ocr-end rq q)
    (return q)))

(defn ^:pub ^I32 sc-request-at [^:mut ^Cells rq ^I32 id ^I32 bitmap ^I32 psm ^I32 dpi ^I32 x ^I32 y ^I32 w ^I32 h ^Cells loc]
  (comment "`sc-request` for a REGION of the bitmap (P7.4: a line at `psm` 7, a table cell): the pixel box x y w h, symbols with their")
  (comment "alternatives, no orientation detection, the resolution hint and the locale's language.")
  (let [^I32 q (rq-ocr rq id bitmap psm (+ (ocf-symbols) (* dpi (ocf-dpi-unit))) x y w h)
        ^I32 lg (sc-lang loc)]
    (if (> lg 0)
      (rq-ocr-lang rq (quot lg 65536) (rem (quot lg 256) 256) (rem lg 256) 0))
    (rq-ocr-end rq q)
    (return q)))

(defn ^:pub ^I32 sc-request-view [^:mut ^Cells rq ^I32 id ^I32 view ^I32 hhi ^I32 hlo ^I32 dpi ^Cells loc]
  (comment "`sc-request` for a KIN-MADE VIEW (D196): the whole view at `psm` 3 with symbols and the resolution hint, its pixel hash")
  (comment "`hhi` `hlo` (`bitmap-hash`) in the record so the transcript is keyed by what was asked.")
  (let [^I32 q (rq-ocr-view rq id view hhi hlo 3 (+ (ocf-symbols) (* dpi (ocf-dpi-unit))) 0 0 0 0)
        ^I32 lg (sc-lang loc)]
    (if (> lg 0)
      (rq-ocr-lang rq (quot lg 65536) (rem (quot lg 256) 256) (rem lg 256) 0))
    (rq-ocr-end rq q)
    (return q)))

(defn ^:pub ^I32 sc-request-view-psm [^:mut ^Cells rq ^I32 id ^I32 view ^I32 hhi ^I32 hlo ^I32 psm ^I32 dpi ^Cells loc]
  (comment "`sc-request-view` at the page segmentation mode `psm` (P8.2: a seal's strip and a stamp's crop are read as one block, `psm` 6).")
  (let [^I32 q (rq-ocr-view rq id view hhi hlo psm (+ (ocf-symbols) (* dpi (ocf-dpi-unit))) 0 0 0 0)
        ^I32 lg (sc-lang loc)]
    (if (> lg 0)
      (rq-ocr-lang rq (quot lg 65536) (rem (quot lg 256) 256) (rem lg 256) 0))
    (rq-ocr-end rq q)
    (return q)))

;; ===================================================== the answer as evidence

(defn ^I32 sc-cpt-len [^Cells views ^I32 view ^I32 v]
  (comment "A length of `v` pixels down the view's y axis, in centipoints; -1 stays -1.")
  (if (< v 0) (return -1))
  (return (- (vw-px-to-cpt views view 1 0 v) (vw-px-to-cpt views view 1 0 0))))

(defn ^I32 sc-ld [^I32 wdir]
  (comment "The engine's writing direction as `ld`: 0 left to right, 1 right to left, 2 top to bottom.")
  (if (== wdir 1) (return (ld-rtl)))
  (if (== wdir 2) (return (ld-ttb)))
  (return 0))

(defn ^I32 sc-grow [^:mut ^Cells oblocks ^I32 row ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "Grow block (or paragraph) `row`'s box to hold the box (x0 y0 x1 y1).")
  (if (< x0 (ob-get oblocks row (obf-x0))) (ob-set oblocks row (obf-x0) x0))
  (if (< y0 (ob-get oblocks row (obf-y0))) (ob-set oblocks row (obf-y0) y0))
  (if (> x1 (ob-get oblocks row (obf-x1))) (ob-set oblocks row (obf-x1) x1))
  (if (> y1 (ob-get oblocks row (obf-y1))) (ob-set oblocks row (obf-y1) y1))
  (return 0))

(defn ^I32 sc-ev-lines [^Cells an ^I32 ext ^I32 view ^I32 run ^I32 page
                        ^Cells views ^:mut ^Cells oblocks ^:mut ^Cells olines]
  (comment "The blocks, paragraphs and lines of the extension, in its order. A block is a run of lines with the same block id,")
  (comment "a paragraph a run of them with the same paragraph id inside it (-1 is an id like another); a block is followed by")
  (comment "its paragraphs, a paragraph's lines are the rows that follow it. A block's box, orientation and writing direction")
  (comment "are the engine's own, from the extension's block table (version 2); a line's row attributes are mapped to")
  (comment "centipoints.")
  (let [^I32 nl (ox-nlines an ext)
        ^I32 nb (ox-nblocks an ext)
        ^I32 orient0 (ox-orient an ext)
        ^I32 wdir0 (ox-wdir an ext)
        ^:mut ^I32 k 0
        ^:mut ^I32 l 0
        ^:mut ^I32 px 0
        ^:mut ^I32 py 0
        ^:mut ^I32 pw 0
        ^:mut ^I32 ph 0
        ^:mut ^I32 x0 0
        ^:mut ^I32 y0 0
        ^:mut ^I32 x1 0
        ^:mut ^I32 y1 0
        ^:mut ^I32 bx0 0
        ^:mut ^I32 by0 0
        ^:mut ^I32 bx1 0
        ^:mut ^I32 by1 0
        ^:mut ^I32 blk 0
        ^:mut ^I32 par 0
        ^:mut ^I32 bty 0
        ^:mut ^I32 curblk -2
        ^:mut ^I32 curpar -2
        ^:mut ^I32 brow -1
        ^:mut ^I32 prow -1
        ^:mut ^I32 lrow 0
        ^:mut ^I32 bcnt 0
        ^:mut ^I32 fresh 0
        ^:mut ^I32 bl -1
        ^:mut ^I32 orient 0
        ^:mut ^I32 wdir 0
        ^:mut ^I32 tx0 0
        ^:mut ^I32 ty0 0
        ^:mut ^I32 tx1 0
        ^:mut ^I32 ty1 0]
    (while (< k nl)
      (do (set l (ox-line-at an ext k))
          (set px (cells-at an l))
          (set py (cells-at an (+ l 1)))
          (set pw (cells-at an (+ l 2)))
          (set ph (cells-at an (+ l 3)))
          (set x0 (vw-box-to-cpt views view 0 px py pw ph))
          (set y0 (vw-box-to-cpt views view 1 px py pw ph))
          (set x1 (vw-box-to-cpt views view 2 px py pw ph))
          (set y1 (vw-box-to-cpt views view 3 px py pw ph))
          (set bx0 (vw-px-to-cpt views view 0 (cells-at an (+ l 4)) (cells-at an (+ l 5))))
          (set by0 (vw-px-to-cpt views view 1 (cells-at an (+ l 4)) (cells-at an (+ l 5))))
          (set bx1 (vw-px-to-cpt views view 0 (cells-at an (+ l 6)) (cells-at an (+ l 7))))
          (set by1 (vw-px-to-cpt views view 1 (cells-at an (+ l 6)) (cells-at an (+ l 7))))
          (set blk (cells-at an (+ l 8)))
          (set par (cells-at an (+ l 9)))
          (set bty (cells-at an (+ l 10)))
          (set orient orient0)
          (set wdir wdir0)
          (set bl -1)
          (if (and (>= blk 0) (< blk nb))
            (do (set bl (ox-block-at an ext blk))
                (set orient (cells-at an (+ bl 4)))
                (set wdir (cells-at an (+ bl 5)))))
          (set fresh 0)
          (if (or (== k 0) (!= blk curblk))
            (do (set tx0 x0)
                (set ty0 y0)
                (set tx1 x1)
                (set ty1 y1)
                (if (>= bl 0)
                  (do (set tx0 (vw-box-to-cpt views view 0 (cells-at an bl) (cells-at an (+ bl 1)) (cells-at an (+ bl 2)) (cells-at an (+ bl 3))))
                      (set ty0 (vw-box-to-cpt views view 1 (cells-at an bl) (cells-at an (+ bl 1)) (cells-at an (+ bl 2)) (cells-at an (+ bl 3))))
                      (set tx1 (vw-box-to-cpt views view 2 (cells-at an bl) (cells-at an (+ bl 1)) (cells-at an (+ bl 2)) (cells-at an (+ bl 3))))
                      (set ty1 (vw-box-to-cpt views view 3 (cells-at an bl) (cells-at an (+ bl 1)) (cells-at an (+ bl 2)) (cells-at an (+ bl 3))))))
                (set brow (ob-new oblocks page tx0 ty0 tx1 ty1 (ob-block) -1 run))
                (ob-set oblocks brow (obf-btype) bty)
                (ob-set oblocks brow (obf-orient) orient)
                (ob-set oblocks brow (obf-wdir) wdir)
                (ob-set oblocks brow (obf-first) (+ brow 1))
                (set curblk blk)
                (set curpar -2)))
          (if (!= par curpar)
            (do (set prow (ob-new oblocks page x0 y0 x1 y1 (ob-paragraph) brow run))
                (ob-set oblocks prow (obf-btype) bty)
                (ob-set oblocks prow (obf-orient) orient)
                (ob-set oblocks prow (obf-wdir) wdir)
                (ob-set oblocks prow (obf-first) (ol-count olines))
                (set bcnt (ob-get oblocks brow (obf-count)))
                (ob-set oblocks brow (obf-count) (+ bcnt 1))
                (set curpar par)
                (set fresh 1)))
          (if (== fresh 0)
            (do (sc-grow oblocks prow x0 y0 x1 y1)
                (if (< bl 0) (sc-grow oblocks brow x0 y0 x1 y1))))
          (set lrow (ol-new olines page x0 y0 x1 y1 bx0 by0 bx1 by1
                            (ev-angle (- bx1 bx0) (- by1 by0)) (sc-ld wdir) -1 0))
          (ol-set olines lrow (olf-par) prow)
          (ol-set olines lrow (olf-run) run)
          (ol-set olines lrow (olf-px) px)
          (ol-set olines lrow (olf-py) py)
          (ol-set olines lrow (olf-pw) pw)
          (ol-set olines lrow (olf-ph) ph)
          (ol-set olines lrow (olf-xheight) (sc-cpt-len views view (cells-at an (+ l 11))))
          (ol-set olines lrow (olf-asc) (sc-cpt-len views view (cells-at an (+ l 12))))
          (ol-set olines lrow (olf-desc) (sc-cpt-len views view (cells-at an (+ l 13))))
          (set bcnt (ob-get oblocks prow (obf-count)))
          (ob-set oblocks prow (obf-count) (+ bcnt 1))
          (set k (+ k 1))))
    (return nl)))

(defn ^I32 sc-ev-words [^Cells an ^I32 at ^I32 ext ^I32 view ^I32 run ^I32 page ^I32 l0
                        ^Cells views ^:mut ^Cells etext ^:mut ^Cells olines
                        ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts]
  (comment "The words of the answer with their symbols and alternatives. A word's line is the extension's line index (an")
  (comment "olines row l0 + it); its baseline is that LINE's evaluated at the word's x0 and x1 (mapped first, interpolated")
  (comment "after: D096). The engine's point size is in centipoints, its dictionary and numeric flags are carried.")
  (let [^I32 nw (an-ocr-count an at)
        ^:mut ^I32 nl 0
        ^:mut ^I32 wdir 0
        ^:mut ^I32 tlen 0
        ^:mut ^I32 w (an-ocr-first an at)
        ^:mut ^I32 wx -1
        ^:mut ^I32 i 0
        ^:mut ^I32 px 0
        ^:mut ^I32 py 0
        ^:mut ^I32 pw 0
        ^:mut ^I32 ph 0
        ^:mut ^I32 x0 0
        ^:mut ^I32 y0 0
        ^:mut ^I32 x1 0
        ^:mut ^I32 y1 0
        ^:mut ^I32 bx0 0
        ^:mut ^I32 by0 0
        ^:mut ^I32 bx1 0
        ^:mut ^I32 by1 0
        ^:mut ^I32 ln 0
        ^:mut ^I32 lx0 0
        ^:mut ^I32 ly0 0
        ^:mut ^I32 lx1 0
        ^:mut ^I32 ly1 0
        ^:mut ^I32 lrow -1
        ^:mut ^I32 ts 0
        ^:mut ^I32 nc 0
        ^:mut ^I32 k 0
        ^:mut ^I32 ow 0
        ^:mut ^I32 j 0
        ^:mut ^I32 ns 0
        ^:mut ^I32 sym 0
        ^:mut ^I32 ncp 0
        ^:mut ^I32 nalt 0
        ^:mut ^I32 a 0
        ^:mut ^I32 m 0
        ^:mut ^I32 acp 0
        ^:mut ^I32 cpv 0
        ^:mut ^I32 a0 0
        ^:mut ^I32 lcnt 0
        ^:mut ^I32 sy 0
        ^:mut ^I32 ps 0]
    (if (>= ext 0)
      (do (set wx (ox-first-word an ext))
          (set nl (ox-nlines an ext))
          (set wdir (ox-wdir an ext))))
    (while (< i nw)
      (do (set px (aw-get an w (aw-x)))
          (set py (aw-get an w (aw-y)))
          (set pw (aw-get an w (aw-w)))
          (set ph (aw-get an w (aw-h)))
          (set x0 (vw-box-to-cpt views view 0 px py pw ph))
          (set y0 (vw-box-to-cpt views view 1 px py pw ph))
          (set x1 (vw-box-to-cpt views view 2 px py pw ph))
          (set y1 (vw-box-to-cpt views view 3 px py pw ph))
          (set ln (aw-get an w (aw-line)))
          (set lrow -1)
          (set bx0 x0)
          (set by0 y1)
          (set bx1 x1)
          (set by1 y1)
          (if (and (>= wx 0) (and (>= ln 0) (< ln nl)))
            (do (set lrow (+ l0 ln))
                (set bx0 (vw-px-to-cpt views view 0 px py))
                (set bx1 (vw-px-to-cpt views view 0 (+ px pw) py))
                (set lx0 (ol-get olines lrow (lh-bx0)))
                (set ly0 (ol-get olines lrow (lh-by0)))
                (set lx1 (ol-get olines lrow (lh-bx1)))
                (set ly1 (ol-get olines lrow (lh-by1)))
                (set by0 (ev-baseline-at lx0 ly0 lx1 ly1 bx0))
                (set by1 (ev-baseline-at lx0 ly0 lx1 ly1 bx1))))
          (set ts (etx-len etext))
          (set nc (aw-get an w (aw-len)))
          (set k 0)
          (while (< k nc)
            (do (etx-append-cp etext (aw-cp an w k))
                (set k (+ k 1))))
          (set ow (ow-new owords page x0 y0 x1 y1 bx0 by0 bx1 by1
                          (ev-angle (- bx1 bx0) (- by1 by0)) (sc-ld wdir) ts nc lrow
                          (aw-get an w (aw-conf)) -1))
          (ow-set owords ow (owf-run) run)
          (ow-set owords ow (owf-px) px)
          (ow-set owords ow (owf-py) py)
          (ow-set owords ow (owf-pw) pw)
          (ow-set owords ow (owf-ph) ph)
          (if (>= lrow 0)
            (do (set lcnt (ol-get olines lrow (lh-count)))
                (if (== lcnt 0) (ol-set olines lrow (lh-first) ow))
                (ol-set olines lrow (lh-count) (+ lcnt 1))))
          (if (>= wx 0)
            (do (ow-set owords ow (owf-style) (ox-wflags an wx))
                (ow-set owords ow (owf-lang) (ox-wlang an wx))
                (set ps (ox-wpsize an wx))
                (if (> ps 1000000) (set ps 1000000))
                (if (>= ps 0) (ow-set owords ow (owf-psize) (* ps 100)))
                (ow-set owords ow (owf-flags) (ox-wdflags an wx))
                (set ns (ox-nsym an wx))
                (ow-set owords ow (owf-sfirst) (os-count osyms))
                (ow-set owords ow (owf-scount) ns)
                (set sy (ox-first-sym an wx))
                (set j 0)
                (while (< j ns)
                  (do (set ncp (cells-at an (+ sy 5)))
                      (set nalt (cells-at an (+ sy 6)))
                      (set px (cells-at an sy))
                      (set py (cells-at an (+ sy 1)))
                      (set pw (cells-at an (+ sy 2)))
                      (set ph (cells-at an (+ sy 3)))
                      (set ts -1)
                      (set tlen 0)
                      (set cpv -1)
                      (if (> ncp 1) (set tlen ncp))
                      (if (> ncp 0) (set cpv (cells-at an (+ sy 7))))
                      (if (> ncp 1)
                        (do (set ts (etx-len etext))
                            (set k 0)
                            (while (< k ncp)
                              (do (etx-append-cp etext (cells-at an (+ (+ sy 7) k)))
                                  (set k (+ k 1))))))
                      (set sym (os-new osyms page (vw-box-to-cpt views view 0 px py pw ph)
                                       (vw-box-to-cpt views view 1 px py pw ph)
                                       (vw-box-to-cpt views view 2 px py pw ph)
                                       (vw-box-to-cpt views view 3 px py pw ph)
                                       cpv ts tlen ow))
                      (os-set osyms sym (osf-conf) (cells-at an (+ sy 4)))
                      (os-set osyms sym (osf-px) px)
                      (os-set osyms sym (osf-py) py)
                      (os-set osyms sym (osf-pw) pw)
                      (os-set osyms sym (osf-ph) ph)
                      (set a0 (oa-count oalts))
                      (set a (ox-sym-alts an sy))
                      (set m 0)
                      (while (< m nalt)
                        (do (set acp (cells-at an a))
                            (if (> acp 0)
                              (do (set ts (etx-len etext))
                                  (set k 0)
                                  (while (< k acp)
                                    (do (etx-append-cp etext (cells-at an (+ (+ a 2) k)))
                                        (set k (+ k 1))))
                                  (oa-add oalts sym ts acp (cells-at an (+ a 1)))))
                            (set a (ox-alt-next an a))
                            (set m (+ m 1))))
                      (os-set osyms sym (osf-afirst) a0)
                      (os-set osyms sym (osf-acount) (- (oa-count oalts) a0))
                      (set sy (ox-sym-next an sy))
                      (set j (+ j 1))))
                (set wx (ox-word-next an wx))))
          (set w (aw-next an w))
          (set i (+ i 1))))
    (return nw)))

(defn ^:pub ^I32 sc-answer [^Cells an ^I32 at ^I32 page ^I32 view ^I32 request ^I32 lang
                      ^Cells views ^Cells epages ^:mut ^Cells etext ^:mut ^Cells oruns
                      ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords
                      ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells feats]
  (comment "One OCR answer as an OCR run with its blocks, paragraphs, lines, words, symbols and alternatives, and the")
  (comment "stage 1 features of every word. `view` is the `views` row of the raster that was read; `lang` the ISO 639-3 the request")
  (comment "named (0 none: the run records no language, D038). Answers the run's row.")
  (let [^I32 ext (ox-find an at)
        ^I32 run (or-new oruns page view)
        ^I32 b0 (ob-count oblocks)
        ^I32 l0 (ol-count olines)
        ^I32 w0 (ow-count owords)
        ^:mut ^I32 nl 0
        ^:mut ^I32 nb 0
        ^:mut ^I32 nw 0
        ^:mut ^I32 w 0
        ^:mut ^I32 rotmed 0
        ^:mut ^I32 ts 0]
    (or-set oruns run (orf-request) request)
    (or-set oruns run (orf-round) 1)
    (or-set oruns run (orf-pass) 1)
    (or-set oruns run (orf-psm) 3)
    (or-set oruns run (orf-flags) (+ (ocf-symbols) (ocf-osd)))
    (if (> lang 0)
      (do (set ts (etx-len etext))
          (etx-append-cp etext (quot lang 65536))
          (etx-append-cp etext (rem (quot lang 256) 256))
          (etx-append-cp etext (rem lang 256))
          (or-set oruns run (orf-lang) ts)
          (or-set oruns run (orf-langlen) 3)))
    (if (>= ext 0)
      (do (or-set oruns run (orf-orient) (ox-orient an ext))
          (or-set oruns run (orf-wdir) (ox-wdir an ext))
          (or-set oruns run (orf-lorder) (ox-tlorder an ext))
          (or-set oruns run (orf-deskew) (ox-deskew an ext))
          (or-set oruns run (orf-osd) (ox-osd an ext))
          (or-set oruns run (orf-script) (ox-script an ext))
          (or-set oruns run (orf-sconf) (ox-sconf an ext))
          (or-set oruns run (orf-oconf) (ox-oconf an ext))
          (set nl (sc-ev-lines an ext view run page views oblocks olines))))
    (set nw (sc-ev-words an at ext view run page l0 views etext olines owords osyms oalts))
    (or-set oruns run (orf-bfirst) b0)
    (set nb (- (ob-count oblocks) b0))
    (or-set oruns run (orf-bcount) nb)
    (or-set oruns run (orf-lfirst) l0)
    (set nl (- (ol-count olines) l0))
    (or-set oruns run (orf-lcount) nl)
    (or-set oruns run (orf-wfirst) w0)
    (or-set oruns run (orf-wcount) nw)
    (set rotmed (ev-rot-median olines l0 nl))
    (set w w0)
    (while (< w (+ w0 nw))
      (do (ev-feat-ocr feats epages etext olines owords osyms oalts w rotmed 100)
          (set w (+ w 1))))
    (return run)))

;; ======================================================= the pipeline's lines

(defn ^I32 sc-cap [] (return 400))   ;; the lines of a page whose size is clustered; later ones keep their own

(defn ^:pub ^I32 sc-sel-base [] (comment "Where `sc-emit-sel`'s selection starts in the scratch.") (return 2300))
(defn ^:pub ^I32 sc-sel-max [] (comment "The most lines a selection holds.") (return 1500))
(defn ^:pub ^I32 sc-aux-base [] (comment "A scratch region after the selection (P7.4: one cell for each line of the first pass: what becomes of it).") (return 3800))
(defn ^:pub ^I32 sc-share-base [] (comment "...and another: the share (per mille) of the line's ink that the body-ink view paints over (-1 none).") (return 5300))
(defn ^:pub ^I32 sc-partner-base [] (comment "...and another: the line of the body-ink run that replaces it.") (return 6800))
(defn ^:pub ^I32 sc-bonly-base [] (comment "...and another: one cell for each line of the body-ink run (1 a line no first-pass line covers, to be taken; 2 taken).") (return 8300))
(defn ^:pub ^I32 sc-xtra-base [] (comment "...and another (P12.6): the first cell is the row of the first-pass run's first line, and the cell after it for line k of that run is 0, or 1 + the row of the body-ink line whose words that lie over none of the first-pass line's are read with it (`rt-adopt`, `sc-line-words`).") (return 9800))
(defn ^:pub ^I32 sc-fate-base [] (comment "...and the last (P12.6): four regions of `sc-fate-max` cells for the words one line is emitted with: their `owords` rows, what becomes of each (`sc-fates`), and the start and length of the text of a corrected one.") (return 11301))
(defn ^:pub ^I32 sc-fate-max [] (comment "The most words of a line `sc-line-words` lists; a line of more is emitted as it is.") (return 400))

(defn ^:pub ^I32 sc-prep [^:mut ^Cells scr]
  (comment "The scratch of `sc-sample` and `sc-cluster`: 242 cells (two for the metrics and 240 samples), three for each of the first")
  (comment "`sc-cap` lines of a page (its ascender line, its descender depth, whether clustered), and `sc-cap` more for sorting a")
  (comment "cluster's members; made once.")
  (while (< (cells-len scr) (+ (sc-fate-base) (+ (* 4 (sc-fate-max)) 2)))
    (cells-push scr 0))
  (return 0))

(defn ^I32 sc-isort [^:mut ^Cells c ^I32 from ^I32 n]
  (comment "Insertion sort of the `n` cells of `c` that start at `from`, ascending (a line has a few hundred symbols at most).")
  (let [^:mut ^I32 i 1
        ^:mut ^I32 j 0
        ^:mut ^I32 v 0]
    (while (< i n)
      (do (set v (cells-at c (+ from i)))
          (set j (- i 1))
          (while (and (>= j 0) (> (cells-at c (+ from j)) v))
            (do (cells-set c (+ from (+ j 1)) (cells-at c (+ from j)))
                (set j (- j 1))))
          (cells-set c (+ from (+ j 1)) v)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 sc-class [^I32 cp]
  (comment "What a letter says about a line's metrics: 1 a letter that stands on the baseline and reaches the x-height only (a c e m n")
  (comment "o r s u v w x z), 2 one that reaches the ascender line (b d f h k l), 4 one that reaches the cap height (the digits and the")
  (comment "capitals), 3 one that hangs below the baseline (g j p q y), 0 any other. Basic Latin only: a script this does not know")
  (comment "measures nothing.")
  (if (or (== cp 97) (or (== cp 99) (or (== cp 101) (or (== cp 109) (or (== cp 110) (or (== cp 111) (or (== cp 114) (== cp 115))))))))
    (return 1))
  (if (or (== cp 117) (or (== cp 118) (or (== cp 119) (or (== cp 120) (== cp 122)))))
    (return 1))
  (if (or (== cp 98) (or (== cp 100) (or (== cp 102) (or (== cp 104) (or (== cp 107) (== cp 108))))))
    (return 2))
  (if (and (>= cp 48) (<= cp 57)) (return 4))
  (if (and (>= cp 65) (<= cp 90)) (return 4))
  (if (or (== cp 103) (or (== cp 106) (or (== cp 112) (or (== cp 113) (== cp 121)))))
    (return 3))
  (return 0))

(defn ^I32 sc-lowq [^Cells c ^I32 from ^I32 n]
  (comment "The 30th percentile of the `n` sorted cells that start at `from`. A symbol's box is its own component's most of the time and")
  (comment "the whole WORD's height some of the time (the engine does not always split a word's height among its letters: in a body line,")
  (comment "a third of the x-height letters can have the height of an ascender), and those are always TOO TALL, so the estimate leans low:")
  (comment "neither a mean nor the median survives that, a low percentile does.")
  (return (cells-at c (+ from (quot (* n 3) 10)))))

(defn ^I32 sc-sample [^Cells olines ^Cells owords ^Cells osyms ^I32 l ^I32 cls ^:mut ^Cells scr]
  (comment "The 30th PERCENTILE (`sc-lowq`: why not a mean), in centipoints, of one class of symbol on line `l`: for classes 1, 2 and 4")
  (comment "the height of its box (these letters stand on the baseline, so the box's height is their height, and the engine's baseline,")
  (comment "which is fitted to the whole line and is a pixel or two off at either end of a tilted one, is not in it), for class 3 its")
  (comment "bottom below the baseline; -1 with fewer than 4 symbols (x-height), 2 (hanging) or 3. `scr` is scratch from cell 2 on and is")
  (comment "overwritten.")
  (let [^I32 w0 (ol-get olines l (lh-first))
        ^I32 cnt (ol-get olines l (lh-count))
        ^I32 bx0 (ol-get olines l (lh-bx0))
        ^I32 by0 (ol-get olines l (lh-by0))
        ^I32 bx1 (ol-get olines l (lh-bx1))
        ^I32 by1 (ol-get olines l (lh-by1))
        ^:mut ^I32 j 0
        ^:mut ^I32 s 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 n 0
        ^:mut ^I32 yb 0
        ^:mut ^I32 v 0
        ^:mut ^I32 need 3]
    (if (== cls 3) (set need 2))
    (if (== cls 1) (set need 4))
    (while (and (< j cnt) (< n 240))
      (do (set s (ow-get owords (+ w0 j) (owf-sfirst)))
          (set s1 (+ s (ow-get owords (+ w0 j) (owf-scount))))
          (while (and (< s s1) (< n 240))
            (do (if (== (sc-class (os-get osyms s (ch-cp))) cls)
                  (do (if (== cls 3)
                        (do (set yb (ev-baseline-at bx0 by0 bx1 by1 (quot (+ (os-get osyms s (ch-x0)) (os-get osyms s (ch-x1))) 2)))
                            (set v (- (os-get osyms s (ch-y1)) yb)))
                        (set v (- (os-get osyms s (ch-y1)) (os-get osyms s (ch-y0)))))
                      (if (> v 0)
                        (do (cells-set scr (+ 2 n) v)
                            (set n (+ n 1))))))
                (set s (+ s 1))))
          (set j (+ j 1))))
    (if (< n need) (return -1))
    (sc-isort scr 2 n)
    (return (sc-lowq scr 2 n))))

(defn ^I32 sc-metrics [^Cells olines ^Cells owords ^Cells osyms ^I32 l ^:mut ^Cells scr]
  (comment "The line's ascender line `A` (its baseline to the top of its tall letters) and descender depth `D`, centipoints, into cells 0")
  (comment "and 1 of `scr` (-1 unknown), and answers its x-height `X` (-1 unknown). The engine's own row attributes when the answer has")
  (comment "them (x-height + ascenders, x-height, descenders); else MEASURED from the symbols' boxes and the baseline (D213): the")
  (comment "Tesseract C API does not export its row attributes, and a measurement is one implementation for every engine. A is the trimmed")
  (comment "mean top of the tall letters (b d f h k l; else the capitals and digits x 1.06), X that of the letters that stand on the")
  (comment "x-height (a c e m n o r s u v w x z), D the trimmed mean bottom of the hanging letters (g j p q y).")
  (let [^I32 xh (ol-get olines l (olf-xheight))
        ^I32 asc (ol-get olines l (olf-asc))
        ^I32 dsc (ol-get olines l (olf-desc))
        ^:mut ^I32 a -1
        ^:mut ^I32 d -1
        ^:mut ^I32 x -1]
    (if (and (> xh 0) (>= asc 0))
      (do (set a (+ xh asc))
          (set x xh)
          (set d dsc))
      (do (set a (sc-sample olines owords osyms l 2 scr))
          (if (< a 0)
            (do (set a (sc-sample olines owords osyms l 4 scr))
                (if (> a 0) (set a (quot (* a 106) 100)))))
          (set x (sc-sample olines owords osyms l 1 scr))
          (set d (sc-sample olines owords osyms l 3 scr))))
    (comment "An answer is only as sane as its engine: sizes are held to 10 000 pt, so that no product below can overflow.")
    (if (> a 1000000) (set a 1000000))
    (if (> d 1000000) (set d 1000000))
    (if (> x 1000000) (set x 1000000))
    (cells-set scr 0 a)
    (cells-set scr 1 d)
    (return x)))

(defn ^I32 sc-cluster [^:mut ^Cells scr ^I32 n]
  (comment "Sizes are a property of a page's TYPE, not of each line: the ascender lines `A` of the first `n` lines (cells 242 + 3 k, 0 or")
  (comment "less for none) are measured to a pixel or two, which is 5 per cent of a body line at 150 dpi, and the paragraph stage breaks")
  (comment "a paragraph at a 5 per cent change. So they are clustered: the densest window [A, 1.05 A] over the lines not yet placed is a")
  (comment "cluster, its members take the cluster's median of A and of D (their descender depth), and the next window is looked for among")
  (comment "the rest. The measure (`sc-sample`) is good to a per cent or two, so two sizes less than 5 per cent apart are one size here.")
  (let [^:mut ^I32 left 0
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 best -1
        ^:mut ^I32 bestc 0
        ^:mut ^I32 c 0
        ^:mut ^I32 a 0
        ^:mut ^I32 m 0
        ^:mut ^I32 medA 0
        ^:mut ^I32 medD 0]
    (while (< i n)
      (do (if (> (cells-at scr (+ 242 (* 4 i))) 0) (set left (+ left 1)))
          (set i (+ i 1))))
    (while (> left 0)
      (do (set best -1)
          (set bestc 0)
          (set i 0)
          (while (< i n)
            (do (set a (cells-at scr (+ 242 (* 4 i))))
                (if (and (> a 0) (== (cells-at scr (+ 244 (* 4 i))) 0))
                  (do (set c 0)
                      (set j 0)
                      (while (< j n)
                        (do (if (and (== (cells-at scr (+ 244 (* 4 j))) 0) (and (>= (cells-at scr (+ 242 (* 4 j))) a) (<= (* (cells-at scr (+ 242 (* 4 j))) 100) (* a 110))))
                              (set c (+ c 1)))
                            (set j (+ j 1))))
                      (if (> c bestc)
                        (do (set bestc c)
                            (set best i)))))
                (set i (+ i 1))))
          (if (< best 0)
            (set left 0)
            (do (set a (cells-at scr (+ 242 (* 4 best))))
                (set m 0)
                (set j 0)
                (while (< j n)
                  (do (if (and (== (cells-at scr (+ 244 (* 4 j))) 0) (and (>= (cells-at scr (+ 242 (* 4 j))) a) (<= (* (cells-at scr (+ 242 (* 4 j))) 100) (* a 110))))
                        (do (cells-set scr (+ (+ 242 (* 4 (sc-cap))) m) (cells-at scr (+ 242 (* 4 j))))
                            (set m (+ m 1))))
                      (set j (+ j 1))))
                (sc-isort scr (+ 242 (* 4 (sc-cap))) m)
                (set medA (cells-at scr (+ (+ 242 (* 4 (sc-cap))) (quot (- m 1) 2))))
                (set m 0)
                (set j 0)
                (while (< j n)
                  (do (if (and (== (cells-at scr (+ 244 (* 4 j))) 0) (and (>= (cells-at scr (+ 242 (* 4 j))) a) (<= (* (cells-at scr (+ 242 (* 4 j))) 100) (* a 110))))
                        (do (cells-set scr (+ (+ 242 (* 4 (sc-cap))) m) (cells-at scr (+ 243 (* 4 j))))
                            (set m (+ m 1))))
                      (set j (+ j 1))))
                (sc-isort scr (+ 242 (* 4 (sc-cap))) m)
                (set medD (cells-at scr (+ (+ 242 (* 4 (sc-cap))) (quot (- m 1) 2))))
                (set j 0)
                (while (< j n)
                  (do (if (and (== (cells-at scr (+ 244 (* 4 j))) 0) (and (>= (cells-at scr (+ 242 (* 4 j))) a) (<= (* (cells-at scr (+ 242 (* 4 j))) 100) (* a 110))))
                        (do (cells-set scr (+ 242 (* 4 j)) medA)
                            (cells-set scr (+ 243 (* 4 j)) medD)
                            (cells-set scr (+ 244 (* 4 j)) 1)
                            (set left (- left 1))))
                      (set j (+ j 1))))))))
    (return 0)))

(defn ^I32 sc-fit [^:mut ^Cells scr ^I32 n]
  (comment "A page's line sizes from what `sc-metrics` measured (cells 242 + 4 k: A, D, clustered, X). A line's x-height has dozens of")
  (comment "letters behind it and a tall-letter line a handful (a heading may have none), so a line's size is its X times the PAGE's")
  (comment "ratio of A to X (the median over the lines that have both: one typeface, one ratio; 1.5 when no line has both), and A itself only")
  (comment "where X is unknown. The sizes are then clustered (`sc-cluster`). Answers the ratio, per thousand.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 m 0
        ^:mut ^I32 r 1500
        ^:mut ^I32 a 0
        ^:mut ^I32 x 0
        ^:mut ^I32 d 0
        ^:mut ^I32 mm 0]
    (while (< i n)
      (do (set a (cells-at scr (+ 242 (* 4 i))))
          (set x (cells-at scr (+ 245 (* 4 i))))
          (if (and (> a 0) (> x 0))
            (do (cells-set scr (+ (+ 242 (* 4 (sc-cap))) m) (quot (* a 1000) x))
                (set m (+ m 1))))
          (set i (+ i 1))))
    (if (>= m 1)
      (do (sc-isort scr (+ 242 (* 4 (sc-cap))) m)
          (set r (cells-at scr (+ (+ 242 (* 4 (sc-cap))) (quot (- m 1) 2))))))
    (comment "a typeface's tall letters are 1.2 to 2 x its x-height; anything outside 1 to 3 is a bad measure, not a typeface")
    (if (< r 1000) (set r 1000))
    (if (> r 3000) (set r 3000))
    (set i 0)
    (while (< i n)
      (do (set a (cells-at scr (+ 242 (* 4 i))))
          (set x (cells-at scr (+ 245 (* 4 i))))
          (set d (cells-at scr (+ 243 (* 4 i))))
          (set mm -1)
          (if (> x 0) (set mm (quot (* x r) 1000)))
          (if (and (<= mm 0) (> a 0)) (set mm a))
          (if (and (< d 0) (> mm 0)) (set d (quot (* mm 27) 100)))
          (cells-set scr (+ 242 (* 4 i)) mm)
          (cells-set scr (+ 243 (* 4 i)) d)
          (set i (+ i 1))))
    (sc-cluster scr n)
    (return r)))

;; ======================================================= what becomes of an OCR word (P12.6)
;;
;; The lines of a scanned page are the engine's, with three things done to them on the way to the pipeline's `words` (the engine's own rows,
;; `owords`, are never changed but for a flag saying what was done, `oe-garbage` `oe-rule-ghost` `oe-corrected`):
;;   * WORDS THAT LIE OVER NOTHING. A body-ink line over a first-pass line (`rt-adopt` pairs them) may read what the first pass did not: a
;;     right-aligned column the first pass stopped before. Its words that lie over none of the first-pass line's (`sc-xtra-ok`) are
;;     read with the line, in their place along it (`sc-line-words`).
;;   * WORDS THAT ARE NO TEXT (`sc-fates`). A word of very low confidence and implausible characters that stands alone or among such words
;;     (paper texture, a ruled line, a hand), a dot leader read as characters, a table rule read as a character: kept out of the page's words, and
;;     written to the dropped ledger (`th-write-ocr`) as `ocr-ghost` or `rule-ghost`, never silently deleted.
;;   * SAFE CORRECTIONS (`sc-fates`): only ones the page itself shows. A rule's stroke glued to the end of a word (`1,089,780.58|`) is cut
;;     off; a `S` or `§` that stands alone just before an amount is the `$` it was; thousands read with periods (`4.985.9`) get their commas back,
;;     as the last period is the decimal one. The engine's text stays in the evidence. NO DIGIT IS EVER GUESSED.

(defn ^I32 sc-lo-conf [] (comment "`ocr-garbage-conf`: a word of at most this confidence (per mille) is a candidate for being no text.") (return 300))
(defn ^I32 sc-xtra-text-conf [] (comment "A newly recovered alphabetic word needs stronger evidence than an amount: weak readings of overlay strokes must not become prose.") (return 600))
(defn ^I32 sc-xtra-text-letters [] (comment "Fewer letters can be fragments of overlay strokes, even at a high engine confidence.") (return 3))
(defn ^I32 sc-xtra-small-conf [] (comment "A later-pass word under half the height of every partner word needs this confidence: an unsure speck must not create a column.") (return 700))
(defn ^I32 sc-xtra-conf [] (comment "A body-ink word that lies over none of the first-pass line's words is read with it only when its confidence (per mille) is at least this.") (return 400))
(defn ^I32 sc-rule-slack [] (comment "A character is on a rule when its centre is within this many centipoints (and the rule's half thickness) of the rule's centre line.") (return 150))

(defn ^I32 sc-mn [^I32 a ^I32 b]
  (if (< a b) (return a))
  (return b))

(defn ^I32 sc-mx [^I32 a ^I32 b]
  (if (> a b) (return a))
  (return b))

(defn ^I32 sc-cp-class [^I32 c]
  (comment "What a code point is to a word's plausibility: 1 a digit, 0 a letter (ASCII, Latin-1 and Latin Extended, and every script above them up to the private use area), 2 an ODD glyph")
  (comment "(one an engine invents over ink that is no text: the vertical bar, tilde, caret, grave, backslash, angle brackets, braces and square brackets, the section sign, copyright and registered")
  (comment "signs and the like of Latin-1, daggers, arrows and shapes, the private use area, the replacement character), 3 any other punctuation, currency sign or mark.")
  (if (and (>= c 48) (<= c 57)) (return 1))
  (if (and (>= c 65) (<= c 90)) (return 0))
  (if (and (>= c 97) (<= c 122)) (return 0))
  (if (== c 124) (return 2))
  (if (== c 126) (return 2))
  (if (== c 94) (return 2))
  (if (== c 96) (return 2))
  (if (== c 92) (return 2))
  (if (or (== c 60) (== c 62)) (return 2))
  (if (or (== c 123) (== c 125)) (return 2))
  (if (or (== c 91) (== c 93)) (return 2))
  (if (< c 128) (return 3))
  (if (< c 192)
    (do (if (or (== c 170) (or (== c 181) (== c 186))) (return 0))
        (if (or (== c 161) (or (== c 164) (or (== c 166) (or (== c 167) (or (== c 168) (or (== c 169) (== c 172))))))) (return 2))
        (if (or (== c 174) (or (== c 175) (or (== c 180) (or (== c 182) (or (== c 184) (== c 191)))))) (return 2))
        (return 3)))
  (if (< c 880)
    (do (if (or (== c 215) (== c 247)) (return 3))
        (return 0)))
  (if (< c 8192) (return 0))
  (if (< c 8224) (return 3))
  (if (< c 8352)
    (do (if (or (== c 8226) (or (== c 8230) (== c 8240))) (return 3))
        (return 2)))
  (if (< c 8400) (return 3))
  (if (< c 11264) (return 2))
  (if (< c 57344) (return 0))
  (if (< c 63744) (return 2))
  (if (== c 65533) (return 2))
  (return 0))

(defn ^I32 sc-count-class [^Cells etext ^I32 ts ^I32 n ^I32 cls]
  (comment "How many of the word's `n` code points (from `ts` in the shared text) are of the class `cls` (`sc-cp-class`).")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 k 0]
    (while (< i n)
      (do (if (== (sc-cp-class (cells-at etext (+ ts i))) cls) (set k (+ k 1)))
          (set i (+ i 1))))
    (return k)))

(defn ^I32 sc-distinct [^Cells etext ^I32 ts ^I32 n]
  (comment "How many different code points there are among the first 40 of the word's.")
  (let [^:mut ^I32 m n
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 d 0
        ^:mut ^I32 seen 0]
    (if (> m 40) (set m 40))
    (while (< i m)
      (do (set seen 0)
          (set j 0)
          (while (< j i)
            (do (if (== (cells-at etext (+ ts j)) (cells-at etext (+ ts i))) (set seen 1))
                (set j (+ j 1))))
          (if (== seen 0) (set d (+ d 1)))
          (set i (+ i 1))))
    (return d)))

(defn ^:pub ^I32 sc-implausible [^Cells etext ^I32 ts ^I32 n]
  (comment "1 when a word's characters are not those of a word: a single glyph that is no letter or digit; two odd glyphs (`sc-cp-class`); letters, digits and an odd glyph together; an odd glyph among five characters or more;")
  (comment "four or more characters and not one a letter or a digit; eight or more of which a quarter or fewer differ (`Petetetdedtededededet`). Else 0.")
  (let [^I32 nl (sc-count-class etext ts n 0)
        ^I32 nd (sc-count-class etext ts n 1)
        ^I32 no (sc-count-class etext ts n 2)]
    (if (<= n 0) (return 0))
    (if (and (== n 1) (== (+ nl nd) 0)) (return 1))
    (if (>= no 2) (return 1))
    (if (and (> no 0) (and (> nd 0) (> nl 0))) (return 1))
    (if (and (> no 0) (>= n 5)) (return 1))
    (if (and (>= n 4) (== (+ nl nd) 0)) (return 1))
    (if (and (>= n 8) (<= (* 4 (sc-distinct etext ts n)) n)) (return 1))
    (return 0)))

(defn ^:pub ^I32 sc-leader [^Cells etext ^I32 ts ^I32 n]
  (comment "1 for a dot leader the engine read as characters: three or more dots and commas and nothing else, or dots and commas with one digit repeated four or more times (`22.2222`)")
  (comment "that is no amount (an amount ends in a separator and two digits). Else 0.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 dots 0
        ^:mut ^I32 digs 0
        ^:mut ^I32 other 0
        ^:mut ^I32 d0 -1
        ^:mut ^I32 same 1
        ^:mut ^I32 c 0]
    (while (< i n)
      (do (set c (cells-at etext (+ ts i)))
          (if (or (== c 46) (== c 44))
            (set dots (+ dots 1))
            (if (and (>= c 48) (<= c 57))
              (do (set digs (+ digs 1))
                  (if (< d0 0) (set d0 c))
                  (if (!= c d0) (set same 0)))
              (set other (+ other 1))))
          (set i (+ i 1))))
    (if (> other 0) (return 0))
    (if (and (== digs 0) (>= dots 3)) (return 1))
    (if (and (>= digs 4) (and (== same 1) (>= dots 1)))
      (do (if (>= n 4)
            (if (and (or (== (cells-at etext (+ ts (- n 3))) 46) (== (cells-at etext (+ ts (- n 3))) 44))
                     (and (>= (cells-at etext (+ ts (- n 2))) 48) (and (<= (cells-at etext (+ ts (- n 2))) 57)
                                                                       (and (>= (cells-at etext (+ ts (- n 1))) 48) (<= (cells-at etext (+ ts (- n 1))) 57)))))
              (return 0)))
          (return 1)))
    (return 0)))

(defn ^I32 sc-cents [^Cells etext ^I32 ts ^I32 n]
  (comment "1 when the word ends in a separator and two digits (the cents of an amount).")
  (if (< n 4) (return 0))
  (if (and (or (== (cells-at etext (+ ts (- n 3))) 46) (== (cells-at etext (+ ts (- n 3))) 44))
           (and (>= (cells-at etext (+ ts (- n 2))) 48) (and (<= (cells-at etext (+ ts (- n 2))) 57)
                                                             (and (>= (cells-at etext (+ ts (- n 1))) 48) (<= (cells-at etext (+ ts (- n 1))) 57)))))
    (return 1))
  (return 0))

(defn ^:pub ^I32 sc-amount-like [^Cells etext ^I32 ts ^I32 n]
  (comment "1 for a word that reads as an amount: digits with dots or commas among them, at least one of each, starting with a digit and ending in one, between an opening")
  (comment "and a closing parenthesis or after a minus if it has them. Else 0.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 nd 0
        ^:mut ^I32 ns 0
        ^:mut ^I32 c 0
        ^:mut ^I32 a 0
        ^:mut ^I32 b n]
    (if (< n 3) (return 0))
    (if (or (== (cells-at etext ts) 40) (== (cells-at etext ts) 45)) (set a 1))
    (if (== (cells-at etext (+ ts (- n 1))) 41) (set b (- n 1)))
    (set i a)
    (while (< i b)
      (do (set c (cells-at etext (+ ts i)))
          (if (and (>= c 48) (<= c 57))
            (set nd (+ nd 1))
            (if (or (== c 46) (== c 44))
              (set ns (+ ns 1))
              (return 0)))
          (set i (+ i 1))))
    (if (or (== nd 0) (== ns 0)) (return 0))
    (set c (cells-at etext (+ ts (- b 1))))
    (if (and (>= c 48) (<= c 57)) (return 1))
    (return 0)))

(defn ^:pub ^I32 sc-groups-fix [^Cells etext ^I32 ts ^I32 n]
  (comment "1 when a word is an amount whose thousands were read with periods: digits and at least two periods, a first group of one to three digits, then groups of exactly three, and")
  (comment "the last group of one or two (the decimals): `4.985.9` is `4,985.9`, and `1.234.567` (a last group of three) is a European whole number and left alone.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 dots 0
        ^:mut ^I32 run 0
        ^:mut ^I32 groups 0
        ^:mut ^I32 c 0
        ^:mut ^I32 ok 1]
    (if (< n 5) (return 0))
    (while (< i n)
      (do (set c (cells-at etext (+ ts i)))
          (if (and (>= c 48) (<= c 57))
            (set run (+ run 1))
            (if (== c 46)
              (do (if (== run 0) (set ok 0))
                  (if (and (== groups 0) (> run 3)) (set ok 0))
                  (if (and (> groups 0) (!= run 3)) (set ok 0))
                  (set groups (+ groups 1))
                  (set dots (+ dots 1))
                  (set run 0))
              (set ok 0)))
          (set i (+ i 1))))
    (if (== ok 0) (return 0))
    (if (< dots 2) (return 0))
    (if (and (>= run 1) (<= run 2)) (return 1))
    (return 0)))

(defn ^:pub ^I32 sc-on-vrule [^Cells rules ^I32 page ^I32 cx ^I32 cy ^I32 slack]
  (comment "1 when the point (`cx`, `cy`) centipoints of page `page` lies on one of the tracer's vertical rules: at least 8 pt long and eight times as long as wide, covering `cy`, with")
  (comment "its centre line within `slack` and half its thickness of `cx`.")
  (let [^I32 n (rl-count rules)
        ^:mut ^I32 r 0
        ^:mut ^I32 xa 0
        ^:mut ^I32 xb 0
        ^:mut ^I32 ya 0
        ^:mut ^I32 yb 0
        ^:mut ^I32 dx 0
        ^:mut ^I32 dy 0
        ^:mut ^I32 d 0
        ^:mut ^I32 t 0]
    (while (< r n)
      (do (if (== (rl-get rules r (rlf-page)) page)
            (do (set xa (rl-get rules r (rlf-lx0)))
                (set xb (rl-get rules r (rlf-lx1)))
                (set ya (rl-get rules r (rlf-ly0)))
                (set yb (rl-get rules r (rlf-ly1)))
                (if (< yb ya) (do (set t ya) (set ya yb) (set yb t)))
                (set dx (- xb xa))
                (if (< dx 0) (set dx (- 0 dx)))
                (set dy (- yb ya))
                (if (and (> dy 0) (<= (* dx 8) dy))
                  (if (and (>= cy ya) (<= cy yb))
                    (do (set d (- cx (quot (+ xa xb) 2)))
                        (if (< d 0) (set d (- 0 d)))
                        (if (<= d (+ slack (quot (rl-get rules r (rlf-thick)) 2))) (return 1)))))))
          (set r (+ r 1))))
    (return 0)))

(defn ^:pub ^I32 sc-xtra-ok [^Cells owords ^Cells etext ^I32 w0 ^I32 cnt ^I32 xw]
  (comment "Does the body-ink word `xw` lie over none of the `cnt` first-pass words from `w0` (no more than a quarter of the narrower of two shares their extent along the line),")
  (comment "is it sure enough (`sc-xtra-conf`) to be read with the line, and are its characters those of a word (`sc-implausible`: a lone `§` is not)? 1 or 0.")
  (let [^I32 xa (ow-get owords xw (hd-x0))
        ^I32 xb (ow-get owords xw (hd-x1))
        ^:mut ^I32 j 0
        ^:mut ^I32 pa 0
        ^:mut ^I32 pb 0
        ^:mut ^I32 ov 0
        ^:mut ^I32 nar 0
        ^:mut ^I32 yo 0
        ^:mut ^I32 yh 0
        ^:mut ^I32 mh 0
        ^:mut ^I32 hh 0
        ^:mut ^I32 edge 0]
    (if (< (ow-get owords xw (hd-conf)) (sc-xtra-conf)) (return 0))
    (let [^I32 letters (sc-count-class etext (ow-get owords xw (hd-tstart)) (ow-get owords xw (hd-tlen)) 0)]
      (if (> letters 0)
        (if (or (< letters (sc-xtra-text-letters)) (< (ow-get owords xw (hd-conf)) (sc-xtra-text-conf))) (return 0))))
    (if (== (sc-implausible etext (ow-get owords xw (hd-tstart)) (ow-get owords xw (hd-tlen))) 1) (return 0))
    (while (< j cnt)
      (do (set hh (- (ow-get owords (+ w0 j) (hd-y1)) (ow-get owords (+ w0 j) (hd-y0))))
          (if (> hh 0) (if (or (== mh 0) (< hh mh)) (set mh hh)))
          (set pa (ow-get owords (+ w0 j) (hd-x0)))
          (set pb (ow-get owords (+ w0 j) (hd-x1)))
          (if (> pb edge) (set edge pb))
          (set ov (- (sc-mn xb pb) (sc-mx xa pa)))
          (set nar (sc-mn (- xb xa) (- pb pa)))
          (if (> ov 0)
            (if (> (* ov 4) nar) (return 0)))
          (set j (+ j 1))))
    (if (and (> cnt 0) (<= xb edge)) (return 0))
    (if (and (> mh 0) (< (* 2 (- (ow-get owords xw (hd-y1)) (ow-get owords xw (hd-y0)))) mh))
      (if (< (ow-get owords xw (hd-conf)) (sc-xtra-small-conf)) (return 0)))
    (comment "A different first-pass line can already hold this ink (a table row split at its last column). Check the entire first-pass run in two dimensions, not just the partner line.")
    (if (and (> cnt 0) (!= (ow-get owords w0 (owf-run)) (ow-get owords xw (owf-run))))
      (do (set j 0)
          (while (< j (ow-count owords))
            (do (if (== (ow-get owords j (owf-run)) (ow-get owords w0 (owf-run)))
                  (if (== (ow-get owords j (hd-page)) (ow-get owords xw (hd-page)))
                    (do (set yo (- (sc-mn (ow-get owords j (hd-y1)) (ow-get owords xw (hd-y1)))
                                   (sc-mx (ow-get owords j (hd-y0)) (ow-get owords xw (hd-y0)))))
                        (set yh (sc-mn (- (ow-get owords j (hd-y1)) (ow-get owords j (hd-y0)))
                                      (- (ow-get owords xw (hd-y1)) (ow-get owords xw (hd-y0)))))
                        (if (and (> yo 0) (> (* yo 2) yh))
                          (do (set pa (ow-get owords j (hd-x0)))
                              (set pb (ow-get owords j (hd-x1)))
                              (set ov (- (sc-mn xb pb) (sc-mx xa pa)))
                              (set nar (sc-mn (- xb xa) (- pb pa)))
                              (if (and (> ov 0) (> (* ov 4) nar)) (return 0)))))))
                (set j (+ j 1))))))
    (return 1)))

(defn ^:pub ^I32 sc-xtra-count [^Cells olines ^Cells owords ^Cells etext ^I32 l ^I32 xl]
  (comment "How many words of the body-ink line `xl` are read with the first-pass line `l` (`sc-xtra-ok`).")
  (let [^I32 w0 (ol-get olines l (lh-first))
        ^I32 cnt (ol-get olines l (lh-count))
        ^I32 x0 (ol-get olines xl (lh-first))
        ^I32 xn (ol-get olines xl (lh-count))
        ^:mut ^I32 j 0
        ^:mut ^I32 k 0]
    (while (< j xn)
      (do (if (== (sc-xtra-ok owords etext w0 cnt (+ x0 j)) 1) (set k (+ k 1)))
          (set j (+ j 1))))
    (return k)))

(defn ^I32 sc-line-words [^Cells olines ^Cells owords ^Cells etext ^I32 l ^I32 xl ^:mut ^Cells scr]
  (comment "The words line `l` is emitted with, in the order along it, written to `scr` from `sc-fate-base`: its own, and with them those of the body-ink line `xl` (-1 none) that")
  (comment "lie over none of its own (`sc-xtra-ok`). Answers how many; 0 when they are more than the scratch holds (the line is then emitted as it is, with nothing added).")
  (let [^I32 fb (sc-fate-base)
        ^I32 w0 (ol-get olines l (lh-first))
        ^I32 cnt (ol-get olines l (lh-count))
        ^:mut ^I32 x0 0
        ^:mut ^I32 xn 0
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 n 0]
    (if (> cnt (sc-fate-max)) (return 0))
    (if (>= xl 0)
      (do (set x0 (ol-get olines xl (lh-first)))
          (set xn (ol-get olines xl (lh-count)))))
    (while (and (< j xn) (== (sc-xtra-ok owords etext w0 cnt (+ x0 j)) 0))
      (set j (+ j 1)))
    (while (or (< i cnt) (< j xn))
      (do (if (>= n (sc-fate-max)) (return 0))
          (if (and (< i cnt) (or (>= j xn) (<= (ow-get owords (+ w0 i) (hd-x0)) (ow-get owords (+ x0 j) (hd-x0)))))
            (do (cells-set scr (+ fb n) (+ w0 i))
                (set i (+ i 1)))
            (do (cells-set scr (+ fb n) (+ x0 j))
                (set j (+ j 1))
                (while (and (< j xn) (== (sc-xtra-ok owords etext w0 cnt (+ x0 j)) 0))
                  (set j (+ j 1)))))
          (set n (+ n 1))))
    (return n)))

(defn ^I32 sc-tail-on-vrule [^Cells owords ^Cells osyms ^Cells rules ^I32 page ^I32 w]
  (comment "1 when the last symbol of word `w` is a vertical bar that lies on one of the page's vertical rules.")
  (let [^I32 sn (ow-get owords w (owf-scount))
        ^I32 s (- (+ (ow-get owords w (owf-sfirst)) sn) 1)]
    (if (< sn 2) (return 0))
    (if (!= (os-get osyms s (ch-cp)) 124) (return 0))
    (return (sc-on-vrule rules page
                         (quot (+ (os-get osyms s (ch-x0)) (os-get osyms s (ch-x1))) 2)
                         (quot (+ (os-get osyms s (ch-y0)) (os-get osyms s (ch-y1))) 2)
                         (sc-rule-slack)))))

(defn ^I32 sc-body-comp [^Cells comps ^Cells inks ^I32 r ^I32 page]
  (comment "1 when component `r` is of page `page`, of the body layer (`ir-body`) and sure (confidence at least 500).")
  (let [^I32 ink (co-get comps r (cf-ink))]
    (if (!= (co-get comps r (cf-page)) page) (return 0))
    (if (< (co-get comps r (cf-conf)) 500) (return 0))
    (if (< ink 0) (return 0))
    (if (!= (ik-get inks ink (ikf-role)) (ir-body)) (return 0))
    (return 1)))

(defn ^I32 sc-dot-like [^Cells comps ^Cells inks ^I32 page ^I32 r ^I32 wy0 ^I32 wy1 ^I32 hh]
  (comment "1 when body component `r` looks like a dot of a word whose box is from `wy0` to `wy1` (`hh` high): sure, at most 0.45 and at least 0.08 of the height each way, its bottom")
  (comment "in the lowest quarter of the box and not more than 0.15 of the height below it.")
  (let [^I32 w (- (co-get comps r (cf-x1)) (co-get comps r (cf-x0)))
        ^I32 h (- (co-get comps r (cf-y1)) (co-get comps r (cf-y0)))
        ^I32 dy1 (co-get comps r (cf-y1))]
    (if (== (sc-body-comp comps inks r page) 0) (return 0))
    (if (or (> (* w 100) (* hh 45)) (> (* h 100) (* hh 45))) (return 0))
    (if (or (< (* w 100) (* hh 8)) (< (* h 100) (* hh 8))) (return 0))
    (if (< (* (- dy1 wy0) 100) (* hh 75)) (return 0))
    (if (> (* (- dy1 wy1) 100) (* hh 15)) (return 0))
    (return 1)))

(defn ^I32 sc-dot-between [^Cells osyms ^I32 s0 ^I32 sn ^I32 cx]
  (comment "The index i of the symbol such that the x `cx` lies between the centres of symbols i and i + 1 of the word that starts at symbol `s0`, or -1.")
  (let [^:mut ^I32 i 0]
    (while (< (+ i 1) sn)
      (do (if (and (> (* 2 cx) (+ (os-get osyms (+ s0 i) (ch-x0)) (os-get osyms (+ s0 i) (ch-x1))))
                   (< (* 2 cx) (+ (os-get osyms (+ s0 (+ i 1)) (ch-x0)) (os-get osyms (+ s0 (+ i 1)) (ch-x1)))))
            (return i))
          (set i (+ i 1))))
    (return -1)))

(defn ^I32 sc-dot-clear [^Cells comps ^Cells inks ^I32 page ^I32 r ^I32 wy0 ^I32 hh]
  (comment "1 when no body ink lies above component `r` in its column, between the top of the word (`wy0`) and a fifth of the word's height above the component: a stroke of a broken digit would.")
  (let [^I32 nc (co-count comps)
        ^I32 dx0 (co-get comps r (cf-x0))
        ^I32 dx1 (co-get comps r (cf-x1))
        ^I32 dy0 (co-get comps r (cf-y0))
        ^:mut ^I32 q 0]
    (while (< q nc)
      (do (if (!= q r)
            (if (== (sc-body-comp comps inks q page) 1)
              (if (and (< (co-get comps q (cf-x0)) dx1) (> (co-get comps q (cf-x1)) dx0))
                (if (and (> (co-get comps q (cf-y1)) wy0) (< (co-get comps q (cf-y0)) (- dy0 (quot (* hh 20) 100))))
                  (return 0)))))
          (set q (+ q 1))))
    (return 1)))

(defn ^:pub ^I32 sc-dot-after [^Cells owords ^Cells osyms ^Cells comps ^Cells inks ^I32 page ^I32 w]
  (comment "The decimal point the engine lost, when the page's pixels show it: the index of the symbol of word `w` after which a point goes, or -1. The word must be digits and nothing else")
  (comment "(three to nine symbols, as many as its characters), one of them at least a quarter wider than the narrowest digit that is not a 1 (the engine's box for the digit before a")
  (comment "point it did not read takes the point in), and there must be a dot between two digits: a component of the body layer that is sure, no more than 0.45 of the word's height")
  (comment "each way, on its baseline, whose centre lies between the centres of two neighbouring symbols, with no body ink above it in its column (a stroke of a broken digit has some).")
  (comment "One or two digits must follow the point and one at least precede it. NO DIGIT IS GUESSED: the point is a thing the page shows.")
  (let [^I32 sn (ow-get owords w (owf-scount))
        ^I32 s0 (ow-get owords w (owf-sfirst))
        ^I32 wy0 (ow-get owords w (hd-y0))
        ^I32 wy1 (ow-get owords w (hd-y1))
        ^I32 hh (- wy1 wy0)
        ^I32 nc (co-count comps)
        ^:mut ^I32 i 0
        ^:mut ^I32 c 0
        ^:mut ^I32 wd 0
        ^:mut ^I32 ref -1
        ^:mut ^I32 wide 0
        ^:mut ^I32 r 0
        ^:mut ^I32 cx 0
        ^:mut ^I32 at -1]
    (if (or (< sn 3) (> sn 9)) (return -1))
    (if (!= (ow-get owords w (hd-tlen)) sn) (return -1))
    (if (<= hh 0) (return -1))
    (if (== nc 0) (return -1))
    (while (< i sn)
      (do (set c (os-get osyms (+ s0 i) (ch-cp)))
          (if (or (< c 48) (> c 57)) (return -1))
          (set wd (- (os-get osyms (+ s0 i) (ch-x1)) (os-get osyms (+ s0 i) (ch-x0))))
          (if (!= c 49)
            (if (or (< ref 0) (< wd ref)) (set ref wd)))
          (set i (+ i 1))))
    (if (<= ref 0) (return -1))
    (set i 0)
    (while (< i sn)
      (do (set c (os-get osyms (+ s0 i) (ch-cp)))
          (set wd (- (os-get osyms (+ s0 i) (ch-x1)) (os-get osyms (+ s0 i) (ch-x0))))
          (if (!= c 49)
            (if (>= (* wd 100) (* ref 125)) (set wide 1)))
          (set i (+ i 1))))
    (if (== wide 0) (return -1))
    (comment "a dot: small, on the baseline, between the centres of two neighbouring symbols")
    (set r 0)
    (while (and (< r nc) (< at 0))
      (do (if (== (sc-dot-like comps inks page r wy0 wy1 hh) 1)
            (do (set cx (quot (+ (co-get comps r (cf-x0)) (co-get comps r (cf-x1))) 2))
                (set at (sc-dot-between osyms s0 sn cx))
                (if (>= at 0)
                  (if (== (sc-dot-clear comps inks page r wy0 hh) 0) (set at -1)))))
          (set r (+ r 1))))
    (if (< at 0) (return -1))
    (comment "the digits that follow: one or two")
    (set wd (- sn (+ at 1)))
    (if (or (< wd 1) (> wd 2)) (return -1))
    (return at)))

(defn ^I32 sc-isdig [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return 1))
  (return 0))

(defn ^I32 sc-digits-before [^Cells etext ^I32 ts ^I32 i]
  (comment "How many digits end just before index `i` of the word that starts at `ts`.")
  (let [^:mut ^I32 j (- i 1)
        ^:mut ^I32 k 0]
    (while (and (>= j 0) (== (sc-isdig (cells-at etext (+ ts j))) 1))
      (do (set k (+ k 1))
          (set j (- j 1))))
    (return k)))

(defn ^I32 sc-digits-after [^Cells etext ^I32 ts ^I32 n ^I32 i]
  (comment "How many digits start just after index `i` of the word of `n` characters that starts at `ts`.")
  (let [^:mut ^I32 j (+ i 1)
        ^:mut ^I32 k 0]
    (while (and (< j n) (== (sc-isdig (cells-at etext (+ ts j))) 1))
      (do (set k (+ k 1))
          (set j (+ j 1))))
    (return k)))

(defn ^:pub ^I32 sc-thousands-comma [^Cells etext ^I32 ts ^I32 n]
  (comment "1 when the word has a thousands comma: one with one to three digits before it and exactly three after it (`459,088`). The page's own convention, when a page has some.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 b 0]
    (while (< i n)
      (do (if (== (cells-at etext (+ ts i)) 44)
            (do (set b (sc-digits-before etext ts i))
                (if (and (>= b 1) (<= b 3))
                  (if (== (sc-digits-after etext ts n i) 3) (return 1)))))
          (set i (+ i 1))))
    (return 0)))

(defn ^:pub ^I32 sc-dollar-word [^Cells etext ^I32 ts ^I32 n]
  (comment "1 for a word that is a dollar sign, or one that starts with it (after an opening parenthesis or a minus) and goes on with a digit: the page's own way of writing an amount.")
  (let [^:mut ^I32 a 0]
    (if (<= n 0) (return 0))
    (if (and (== n 1) (== (cells-at etext ts) 36)) (return 1))
    (if (or (== (cells-at etext ts) 40) (== (cells-at etext ts) 45)) (set a 1))
    (if (< (+ a 1) n)
      (if (and (== (cells-at etext (+ ts a)) 36) (== (sc-isdig (cells-at etext (+ ts (+ a 1)))) 1)) (return 1)))
    (return 0)))

(defn ^:pub ^I32 sc-period-thousands [^Cells etext ^I32 ts ^I32 n ^I32 sign]
  (comment "The index of the period of a word of the shape `(331.279)`: after any opening parenthesis, minus or dollar sign (and, when `sign` is 1, an S or a section sign read for one), one to three digits")
  (comment "that do not start with 0, one period and exactly three digits, then at most a closing parenthesis. A thousands comma read as a period (the page's own, see `sc-fates`); else -1.")
  (let [^:mut ^I32 a 0
        ^:mut ^I32 b n
        ^:mut ^I32 d 0]
    (while (and (< a 3) (and (< a n) (or (== (cells-at etext (+ ts a)) 40) (or (== (cells-at etext (+ ts a)) 45) (== (cells-at etext (+ ts a)) 36)))))
      (set a (+ a 1)))
    (if (and (== sign 1) (< a n))
      (if (or (== (cells-at etext (+ ts a)) 167) (== (cells-at etext (+ ts a)) 83)) (set a (+ a 1))))
    (if (>= a n) (return -1))
    (if (== (cells-at etext (+ ts (- n 1))) 41) (set b (- n 1)))
    (set d (sc-digits-after etext ts b (- a 1)))
    (if (or (< d 1) (> d 3)) (return -1))
    (if (== (cells-at etext (+ ts a)) 48) (return -1))
    (if (!= (cells-at etext (+ ts (+ a d))) 46) (return -1))
    (if (!= (sc-digits-after etext ts b (+ a d)) 3) (return -1))
    (if (!= (+ a (+ d 4)) b) (return -1))
    (return (+ a d))))

(defn ^I32 sc-flag [^:mut ^Cells owords ^I32 w ^I32 bit]
  (comment "Set `bit` among the engine flags of word row `w`.")
  (let [^I32 v (bit-or (ow-get owords w (owf-flags)) bit)]
    (ow-set owords w (owf-flags) v)
    (return 0)))

(defn ^I32 sc-fates [^:mut ^Cells owords ^:mut ^Cells etext ^Cells osyms ^Cells rules ^Cells comps ^Cells inks ^I32 page ^I32 m ^:mut ^Cells scr]
  (comment "What becomes of each of the `m` words of a line (listed at `sc-fate-base`): 0 it stays, 1 it is garbage (confidence at most `sc-lo-conf` and implausible characters (`sc-implausible`) on a line of")
  (comment "two words or fewer or of a mean confidence of 450 or less; or a word of a line of three or more whose mean is at most `sc-lo-conf`, best at most 450 and words of four characters or fewer on average: texture), 2 it is the ghost of a rule (a lone bar, `I`, `l` or `!`")
  (comment "on a vertical rule), 3 it is a dot leader (`sc-leader`), 4 its text is corrected (the cells at +2 and +3 regions say how). The words with a fate of 1 to 3 are flagged in `owords` (`oe-garbage`, `oe-rule-ghost`, one corrected: `oe-corrected`)")
  (comment "and taken out of the list; the corrected text is appended to `etext`. Answers how many words are left.")
  (let [^I32 fb (sc-fate-base)
        ^I32 fm (sc-fate-max)
        ^I32 commas (cells-at scr (+ (sc-fate-base) (* 4 (sc-fate-max))))
        ^I32 dollars (cells-at scr (+ (sc-fate-base) (+ (* 4 (sc-fate-max)) 1)))
        ^:mut ^I32 gl 0
        ^:mut ^I32 pd -1
        ^:mut ^I32 i 0
        ^:mut ^I32 w 0
        ^:mut ^I32 w2 0
        ^:mut ^I32 ts 0
        ^:mut ^I32 n 0
        ^:mut ^I32 ts2 0
        ^:mut ^I32 n2 0
        ^:mut ^I32 conf 0
        ^:mut ^I32 sum 0
        ^:mut ^I32 tch 0
        ^:mut ^I32 mx 0
        ^:mut ^I32 lmean 0
        ^:mut ^I32 f 0
        ^:mut ^I32 c 0
        ^:mut ^I32 hh 0
        ^:mut ^I32 h2 0
        ^:mut ^I32 gp 0
        ^:mut ^I32 nt 0
        ^:mut ^I32 k 0
        ^:mut ^I32 last 0
        ^:mut ^I32 kept 0
        ^:mut ^I32 changed 0]
    (while (< i m)
      (do (set w (cells-at scr (+ fb i)))
          (set conf (ow-get owords w (hd-conf)))
          (set sum (+ sum conf))
          (set tch (+ tch (ow-get owords w (hd-tlen))))
          (if (> conf mx) (set mx conf))
          (set i (+ i 1))))
    (set lmean (quot sum m))
    (set i 0)
    (while (< i m)
      (do (set w (cells-at scr (+ fb i)))
          (set ts (ow-get owords w (hd-tstart)))
          (set n (ow-get owords w (hd-tlen)))
          (set conf (ow-get owords w (hd-conf)))
          (set f 0)
          (cells-set scr (+ fb (+ (* 2 fm) i)) -1)
          (cells-set scr (+ fb (+ (* 3 fm) i)) 0)
          (comment "a dot leader")
          (if (== (sc-leader etext ts n) 1) (set f 3))
          (comment "An isolated punctuation speck at most one point each way is no text even when the engine is confident. Keep its evidence for the ledger.")
          (if (and (== f 0) (and (== m 1) (== n 1)))
            (if (and (<= (- (ow-get owords w (hd-x1)) (ow-get owords w (hd-x0))) 100)
                     (<= (- (ow-get owords w (hd-y1)) (ow-get owords w (hd-y0))) 100))
              (do (set c (cells-at etext ts))
                  (if (or (== c 46) (or (== c 44) (or (== c 39) (or (== c 96) (== c 183))))) (set f 1)))))
          (comment "texture: a line of three words or more, all of them unsure")
          (if (== f 0)
            (if (and (>= m 3) (and (<= lmean (sc-lo-conf)) (and (<= mx 450) (<= tch (* 4 m))))) (set f 1)))
          (comment "very unsure and no word, alone or among such words")
          (if (== f 0)
            (if (<= conf (sc-lo-conf))
              (if (== (sc-implausible etext ts n) 1)
                (if (or (<= m 2) (<= lmean 450)) (set f 1)))))
          (comment "a rule read as a character")
          (if (and (== f 0) (== n 1))
            (do (set c (cells-at etext ts))
                (if (or (== c 124) (or (== c 73) (or (== c 108) (== c 33))))
                  (if (== (sc-on-vrule rules page
                                       (quot (+ (ow-get owords w (hd-x0)) (ow-get owords w (hd-x1))) 2)
                                       (quot (+ (ow-get owords w (hd-y0)) (ow-get owords w (hd-y1))) 2)
                                       (sc-rule-slack)) 1)
                    (set f 2)))))
          (comment "a rule's stroke glued to the end of a word")
          (if (and (== f 0) (>= n 2))
            (if (== (cells-at etext (+ ts (- n 1))) 124)
              (if (== (sc-tail-on-vrule owords osyms rules page w) 1)
                (do (cells-set scr (+ fb (+ (* 2 fm) i)) ts)
                    (cells-set scr (+ fb (+ (* 3 fm) i)) (- n 1))
                    (set f 4)))))
          (comment "thousands read with periods")
          (if (and (== f 0) (== (sc-groups-fix etext ts n) 1))
            (do (set nt (etx-len etext))
                (set last (- n 1))
                (while (and (> last 0) (!= (cells-at etext (+ ts last)) 46))
                  (set last (- last 1)))
                (set k 0)
                (while (< k n)
                  (do (set c (cells-at etext (+ ts k)))
                      (if (and (== c 46) (!= k last)) (set c 44))
                      (etx-append-cp etext c)
                      (set k (+ k 1))))
                (cells-set scr (+ fb (+ (* 2 fm) i)) nt)
                (cells-set scr (+ fb (+ (* 3 fm) i)) n)
                (set f 4)))
          (comment "the page's own conventions: a thousands comma read as a period on a page that writes them with commas (two words at least), and a dollar sign glued to an amount and read as an S or a section sign on a page that writes its amounts with dollar signs (two words at least)")
          (if (and (== f 0) (>= n 4))
            (do (set gl 0)
                (set c (cells-at etext ts))
                (if (>= dollars 2)
                  (if (or (== c 167) (== c 83))
                    (if (== (sc-amount-like etext (+ ts 1) (- n 1)) 1) (set gl 1))))
                (set pd -1)
                (if (>= commas 2) (set pd (sc-period-thousands etext ts n gl)))
                (if (or (== gl 1) (>= pd 0))
                  (do (set nt (etx-len etext))
                      (set k 0)
                      (while (< k n)
                        (do (set c (cells-at etext (+ ts k)))
                            (if (and (== gl 1) (== k 0)) (set c 36))
                            (if (== k pd) (set c 44))
                            (etx-append-cp etext c)
                            (set k (+ k 1))))
                      (cells-set scr (+ fb (+ (* 2 fm) i)) nt)
                      (cells-set scr (+ fb (+ (* 3 fm) i)) n)
                      (set f 4)))))
          (comment "a decimal point the engine lost and the page shows (`sc-dot-after`)")
          (if (and (== f 0) (>= n 3))
            (do (set k (sc-dot-after owords osyms comps inks page w))
                (if (>= k 0)
                  (do (set nt (etx-len etext))
                      (set c 0)
                      (while (< c n)
                        (do (set last (cells-at etext (+ ts c)))
                            (etx-append-cp etext last)
                            (if (== c k) (etx-append-cp etext 46))
                            (set c (+ c 1))))
                      (cells-set scr (+ fb (+ (* 2 fm) i)) nt)
                      (cells-set scr (+ fb (+ (* 3 fm) i)) (+ n 1))
                      (set f 4)))))
          (comment "a currency sign read as an S or a section sign, alone just before an amount of the same height")
          (if (and (== f 0) (== n 1))
            (do (set c (cells-at etext ts))
                (if (and (< (+ i 1) m) (or (== c 83) (or (== c 167) (== c 115))))
                  (do (set w2 (cells-at scr (+ fb (+ i 1))))
                      (set ts2 (ow-get owords w2 (hd-tstart)))
                      (set n2 (ow-get owords w2 (hd-tlen)))
                      (set hh (- (ow-get owords w (hd-y1)) (ow-get owords w (hd-y0))))
                      (set h2 (- (ow-get owords w2 (hd-y1)) (ow-get owords w2 (hd-y0))))
                      (set gp (- (ow-get owords w2 (hd-x0)) (ow-get owords w (hd-x1))))
                      (if (and (== (sc-amount-like etext ts2 n2) 1) (and (>= gp 0) (<= gp (* 2 hh))))
                        (if (and (>= (* hh 100) (* 60 h2)) (<= (* hh 100) (* 160 h2)))
                          (if (or (== c 167) (or (== (sc-cents etext ts2 n2) 1) (>= dollars 2)))
                            (do (set nt (etx-len etext))
                                (etx-append-cp etext 36)
                                (cells-set scr (+ fb (+ (* 2 fm) i)) nt)
                                (cells-set scr (+ fb (+ (* 3 fm) i)) 1)
                                (set f 4)))))))))
          (cells-set scr (+ fb (+ fm i)) f)
          (if (or (== f 1) (== f 3)) (do (sc-flag owords w (oe-garbage)) (set changed 1)))
          (if (== f 2) (do (sc-flag owords w (oe-rule-ghost)) (set changed 1)))
          (if (== f 4) (do (sc-flag owords w (oe-corrected)) (set changed 1)))
          (set i (+ i 1))))
    (if (== changed 0) (return m))
    (comment "the words that stay, packed to the front")
    (set i 0)
    (while (< i m)
      (do (set f (cells-at scr (+ fb (+ fm i))))
          (if (or (== f 0) (== f 4))
            (do (cells-set scr (+ fb kept) (cells-at scr (+ fb i)))
                (cells-set scr (+ fb (+ fm kept)) f)
                (cells-set scr (+ fb (+ (* 2 fm) kept)) (cells-at scr (+ fb (+ (* 2 fm) i))))
                (cells-set scr (+ fb (+ (* 3 fm) kept)) (cells-at scr (+ fb (+ (* 3 fm) i))))
                (set kept (+ kept 1))))
          (set i (+ i 1))))
    (return kept)))

(defn ^I32 sc-emit-core [^Cells olines ^Cells owords ^Cells osyms ^I32 l0 ^I32 nl ^I32 page ^I32 rotmed
                         ^:mut ^Cells scr ^:mut ^Cells words ^:mut ^Cells lines ^I32 usesel]
  (let [^:mut ^I32 k 0
        ^:mut ^I32 made 0
        ^:mut ^I32 l 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 w0 0
        ^:mut ^I32 wi 0
        ^:mut ^I32 j 0
        ^:mut ^I32 r 0
        ^:mut ^I32 lnx 0
        ^:mut ^I32 lx0 0
        ^:mut ^I32 ly0 0
        ^:mut ^I32 lx1 0
        ^:mut ^I32 ly1 0
        ^:mut ^I32 bx0 0
        ^:mut ^I32 by0 0
        ^:mut ^I32 bx1 0
        ^:mut ^I32 by1 0
        ^:mut ^I32 ymid 0
        ^:mut ^I32 asc 0
        ^:mut ^I32 dsc 0
        ^:mut ^I32 size 0
        ^:mut ^I32 rot 0
        ^:mut ^I32 dir 0
        ^:mut ^I32 gap 0
        ^:mut ^I32 first 0
        ^:mut ^I32 ox 0
        ^:mut ^I32 ox1 0
        ^:mut ^I32 nx0 0
        ^:mut ^I32 xm 0
        ^:mut ^I32 nx1 0]
    (comment "Pass 1: every line's metrics, then their sizes clustered over the page.")
    (while (< k nl)
      (do (if (< k (sc-cap))
            (do (do (set l (+ l0 k)) (if (== usesel 1) (set l (cells-at scr (+ (sc-sel-base) k)))))
                (cells-set scr (+ 244 (* 4 k)) 0)
                (cells-set scr (+ 242 (* 4 k)) -1)
                (cells-set scr (+ 243 (* 4 k)) -1)
                (cells-set scr (+ 245 (* 4 k)) -1)
                (if (> (ol-get olines l (lh-count)) 0)
                  (do (set xm (sc-metrics olines owords osyms l scr))
                      (cells-set scr (+ 245 (* 4 k)) xm)
                      (cells-set scr (+ 242 (* 4 k)) (cells-at scr 0))
                      (cells-set scr (+ 243 (* 4 k)) (cells-at scr 1))))))
          (set k (+ k 1))))
    (if (< nl (sc-cap))
      (sc-fit scr nl)
      (sc-fit scr (sc-cap)))
    (set k 0)
    (while (< k nl)
      (do (do (set l (+ l0 k)) (if (== usesel 1) (set l (cells-at scr (+ (sc-sel-base) k)))))
          (set cnt (ol-get olines l (lh-count)))
          (if (> cnt 0)
            (do (set w0 (ol-get olines l (lh-first)))
                (set lx0 (ol-get olines l (lh-x0)))
                (set ly0 (ol-get olines l (lh-y0)))
                (set lx1 (ol-get olines l (lh-x1)))
                (set ly1 (ol-get olines l (lh-y1)))
                (set bx0 (ol-get olines l (lh-bx0)))
                (set by0 (ol-get olines l (lh-by0)))
                (set bx1 (ol-get olines l (lh-bx1)))
                (set by1 (ol-get olines l (lh-by1)))
                (set dir (ol-get olines l (lh-dir)))
                (if (< k (sc-cap))
                  (do (set asc (cells-at scr (+ 242 (* 4 k))))
                      (set dsc (cells-at scr (+ 243 (* 4 k)))))
                  (do (sc-metrics olines owords osyms l scr)
                      (set asc (cells-at scr 0))
                      (set dsc (cells-at scr 1))
                      (if (< dsc 0) (set dsc (quot (* asc 27) 100)))))
                (set ymid (quot (+ by0 by1) 2))
                (if (> asc 0)
                  (do (set size (quot (* asc 137) 100))
                      (set ly0 (- ymid asc))
                      (set ly1 (+ ymid dsc)))
                  (set size (quot (* (- ly1 ly0) 108) 100)))
                (if (< size 1) (set size 1))
                (set rot (rem (+ (- (ev-angle (- bx1 bx0) (- by1 by0)) rotmed) 36000) 36000))
                (set lnx (ln-count lines))
                (set first (wd-count words))
                (set j 0)
                (while (< j cnt)
                  (do (set wi (+ w0 j))
                      (set gap -1)
                      (if (< (+ j 1) cnt)
                        (do (set ox (ow-get owords wi (hd-x0)))
                            (set ox1 (ow-get owords wi (hd-x1)))
                            (set nx0 (ow-get owords (+ wi 1) (hd-x0)))
                            (set nx1 (ow-get owords (+ wi 1) (hd-x1)))
                            (if (== dir 1)
                              (set gap (- ox nx1))
                              (set gap (- nx0 ox1)))))
                      (set r (wd-new words page
                                     (ow-get owords wi (hd-x0)) (ow-get owords wi (hd-y0))
                                     (ow-get owords wi (hd-x1)) (ow-get owords wi (hd-y1))
                                     (ow-get owords wi (hd-bx0)) (ow-get owords wi (hd-by0))
                                     (ow-get owords wi (hd-bx1)) (ow-get owords wi (hd-by1))
                                     rot dir
                                     (ow-get owords wi (hd-tstart)) (ow-get owords wi (hd-tlen))
                                     lnx (ow-get owords wi (hd-conf)) -1))
                      (wd-set words r (wf-style) (ow-get owords wi (owf-style)))
                      (wd-set words r (wf-size) size)
                      (wd-set words r (wf-font) -1)
                      (wd-set words r (wf-gap) gap)
                      (wd-set words r (wf-wbreak) (wb-space))
                      (if (== (+ j 1) cnt) (wd-set words r (wf-wbreak) (wb-line-end)))
                      (wd-set words r (wf-src) (sr-ocr))
                      (set j (+ j 1))))
                (set r (ln-new lines page lx0 ly0 lx1 ly1 bx0 by0 bx1 by1 rot dir first cnt))
                (ln-set lines r (lf-src) (sr-ocr))
                (ln-set lines r (lf-order) r)
                (set made (+ made 1))))
          (set k (+ k 1))))
    (return made)))

(defn ^:pub ^I32 sc-emit-vetted [^Cells olines ^:mut ^Cells owords ^Cells osyms ^I32 nsel ^I32 page ^I32 rotmed
                                ^:mut ^Cells scr ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells etext ^Cells rules ^Cells comps ^Cells inks]
  (comment "`sc-emit-core` over the selection of `scr`, as `sc-emit-sel` does it, and with what becomes of the words of the lines (P12.6): the words a body-ink line adds to a")
  (comment "first-pass line (`sc-xtra-base`, `sc-line-words`), the words that are no text kept out and flagged in `owords`, the safe corrections made (`sc-fates`). A line of which every")
  (comment "word is kept out is not a line. The line's box and baseline are widened to the words that were added, and are otherwise the line's own, so that a page where nothing was added,")
  (comment "dropped or corrected is emitted as it always was. Answers the lines made.")
  (let [^I32 fb (sc-fate-base)
        ^I32 fm (sc-fate-max)
        ^:mut ^I32 k 0
        ^:mut ^I32 made 0
        ^:mut ^I32 l 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 revised 0
        ^:mut ^I32 mc 0
        ^:mut ^I32 mg 0
        ^:mut ^I32 xl 0
        ^:mut ^I32 kk 0
        ^:mut ^I32 w0 0
        ^:mut ^I32 wi 0
        ^:mut ^I32 wn 0
        ^:mut ^I32 ts 0
        ^:mut ^I32 tl 0
        ^:mut ^I32 j 0
        ^:mut ^I32 r 0
        ^:mut ^I32 lnx 0
        ^:mut ^I32 lx0 0
        ^:mut ^I32 ly0 0
        ^:mut ^I32 lx1 0
        ^:mut ^I32 ly1 0
        ^:mut ^I32 bx0 0
        ^:mut ^I32 by0 0
        ^:mut ^I32 bx1 0
        ^:mut ^I32 by1 0
        ^:mut ^I32 ymid 0
        ^:mut ^I32 asc 0
        ^:mut ^I32 dsc 0
        ^:mut ^I32 size 0
        ^:mut ^I32 rot 0
        ^:mut ^I32 dir 0
        ^:mut ^I32 gap 0
        ^:mut ^I32 first 0
        ^:mut ^I32 ox 0
        ^:mut ^I32 ox1 0
        ^:mut ^I32 nx0 0
        ^:mut ^I32 xm 0
        ^:mut ^I32 commas 0
        ^:mut ^I32 dollars 0
        ^:mut ^I32 nx1 0]
    (comment "Pass 1: every line's metrics, then their sizes clustered over the page.")
    (while (< k nsel)
      (do (if (< k (sc-cap))
            (do (set l (cells-at scr (+ (sc-sel-base) k)))
                (cells-set scr (+ 244 (* 4 k)) 0)
                (cells-set scr (+ 242 (* 4 k)) -1)
                (cells-set scr (+ 243 (* 4 k)) -1)
                (cells-set scr (+ 245 (* 4 k)) -1)
                (if (> (ol-get olines l (lh-count)) 0)
                  (do (set xm (sc-metrics olines owords osyms l scr))
                      (cells-set scr (+ 245 (* 4 k)) xm)
                      (cells-set scr (+ 242 (* 4 k)) (cells-at scr 0))
                      (cells-set scr (+ 243 (* 4 k)) (cells-at scr 1))))))
          (set k (+ k 1))))
    (if (< nsel (sc-cap))
      (sc-fit scr nsel)
      (sc-fit scr (sc-cap)))
    (comment "the page's own conventions, counted over its words: how many write a thousands comma, how many a dollar sign")
    (set commas 0)
    (set dollars 0)
    (set k 0)
    (while (< k nsel)
      (do (set l (cells-at scr (+ (sc-sel-base) k)))
          (set cnt (ol-get olines l (lh-count)))
          (set w0 (ol-get olines l (lh-first)))
          (set j 0)
          (while (< j cnt)
            (do (set wi (+ w0 j))
                (if (== (sc-thousands-comma etext (ow-get owords wi (hd-tstart)) (ow-get owords wi (hd-tlen))) 1)
                  (set commas (+ commas 1)))
                (if (== (sc-dollar-word etext (ow-get owords wi (hd-tstart)) (ow-get owords wi (hd-tlen))) 1)
                  (set dollars (+ dollars 1)))
                (set j (+ j 1))))
          (set k (+ k 1))))
    (cells-set scr (+ fb (* 4 fm)) commas)
    (cells-set scr (+ fb (+ (* 4 fm) 1)) dollars)
    (set k 0)
    (while (< k nsel)
      (do (set l (cells-at scr (+ (sc-sel-base) k)))
          (set cnt (ol-get olines l (lh-count)))
          (if (> cnt 0)
            (do (set w0 (ol-get olines l (lh-first)))
                (set lx0 (ol-get olines l (lh-x0)))
                (set ly0 (ol-get olines l (lh-y0)))
                (set lx1 (ol-get olines l (lh-x1)))
                (set ly1 (ol-get olines l (lh-y1)))
                (set bx0 (ol-get olines l (lh-bx0)))
                (set by0 (ol-get olines l (lh-by0)))
                (set bx1 (ol-get olines l (lh-bx1)))
                (set by1 (ol-get olines l (lh-by1)))
                (set dir (ol-get olines l (lh-dir)))
                (if (< k (sc-cap))
                  (do (set asc (cells-at scr (+ 242 (* 4 k))))
                      (set dsc (cells-at scr (+ 243 (* 4 k)))))
                  (do (sc-metrics olines owords osyms l scr)
                      (set asc (cells-at scr 0))
                      (set dsc (cells-at scr 1))
                      (if (< dsc 0) (set dsc (quot (* asc 27) 100)))))
                (comment "the words the line is emitted with: its own and the body-ink line's that lie over none of them, less the ones that are no text")
                (set xl -1)
                (set kk (- l (cells-at scr (sc-xtra-base))))
                (if (and (>= kk 0) (< kk (sc-sel-max)))
                  (set xl (- (cells-at scr (+ (sc-xtra-base) (+ kk 1))) 1)))
                (if (!= dir 0) (set xl -1))
                (set revised 0)
                (if (!= (ol-get olines l (olf-run)) (ol-get olines (cells-at scr (sc-xtra-base)) (olf-run)))
                  (set revised 1))
                (set mg 0)
                (set mc cnt)
                (set j (sc-line-words olines owords etext l xl scr))
                (if (> j 0)
                  (do (set mg 1)
                      (set mc (sc-fates owords etext osyms rules comps inks page j scr))
                      (if (or (> j cnt) (< mc j)) (set revised 1))))
                (if (and (== mg 1) (> mc 0))
                  (if (> j cnt)
                    (do (set wi (cells-at scr fb))
                        (set wn (cells-at scr (+ fb (- mc 1))))
                        (set bx0 (ow-get owords wi (hd-bx0)))
                        (set by0 (ow-get owords wi (hd-by0)))
                        (set bx1 (ow-get owords wn (hd-bx1)))
                        (set by1 (ow-get owords wn (hd-by1)))
                        (set lx0 (sc-mn lx0 (ow-get owords wi (hd-x0))))
                        (set lx1 (sc-mx lx1 (ow-get owords wn (hd-x1)))))))
                (set ymid (quot (+ by0 by1) 2))
                (if (> asc 0)
                  (do (set size (quot (* asc 137) 100))
                      (set ly0 (- ymid asc))
                      (set ly1 (+ ymid dsc)))
                  (set size (quot (* (- ly1 ly0) 108) 100)))
                (if (< size 1) (set size 1))
                (set rot (rem (+ (- (ev-angle (- bx1 bx0) (- by1 by0)) rotmed) 36000) 36000))
                (set lnx (ln-count lines))
                (set first (wd-count words))
                (set j 0)
                (while (< j mc)
                  (do (set wi (+ w0 j))
                      (set wn (+ w0 (+ j 1)))
                      (set ts 0)
                      (set tl 0)
                      (if (== mg 1)
                        (do (set wi (cells-at scr (+ fb j)))
                            (set wn (cells-at scr (+ fb (+ j 1))))))
                      (set ts (ow-get owords wi (hd-tstart)))
                      (set tl (ow-get owords wi (hd-tlen)))
                      (if (== mg 1)
                        (if (>= (cells-at scr (+ fb (+ (* 2 fm) j))) 0)
                          (do (set ts (cells-at scr (+ fb (+ (* 2 fm) j))))
                              (set tl (cells-at scr (+ fb (+ (* 3 fm) j)))))))
                      (set gap -1)
                      (if (< (+ j 1) mc)
                        (do (set ox (ow-get owords wi (hd-x0)))
                            (set ox1 (ow-get owords wi (hd-x1)))
                            (set nx0 (ow-get owords wn (hd-x0)))
                            (set nx1 (ow-get owords wn (hd-x1)))
                            (if (== dir 1)
                              (set gap (- ox nx1))
                              (set gap (- nx0 ox1)))))
                      (set r (wd-new words page
                                     (ow-get owords wi (hd-x0)) (ow-get owords wi (hd-y0))
                                     (ow-get owords wi (hd-x1)) (ow-get owords wi (hd-y1))
                                     (ow-get owords wi (hd-bx0)) (ow-get owords wi (hd-by0))
                                     (ow-get owords wi (hd-bx1)) (ow-get owords wi (hd-by1))
                                     rot dir ts tl
                                     lnx (ow-get owords wi (hd-conf)) -1))
                      (wd-set words r (wf-style) (ow-get owords wi (owf-style)))
                      (wd-set words r (wf-size) size)
                      (wd-set words r (wf-font) -1)
                      (wd-set words r (wf-gap) gap)
                      (wd-set words r (wf-wbreak) (wb-space))
                      (if (== (+ j 1) mc) (wd-set words r (wf-wbreak) (wb-line-end)))
                      (wd-set words r (wf-src) (sr-ocr))
                      (set j (+ j 1))))
                (if (> mc 0)
                  (do (set r (ln-new lines page lx0 ly0 lx1 ly1 bx0 by0 bx1 by1 rot dir first mc))
                      (ln-set lines r (lf-src) (+ (sr-ocr) (* revised (ls-revised))))
                      (ln-set lines r (lf-order) r)
                      (set made (+ made 1))))))
          (set k (+ k 1))))
    (return made)))

(defn ^:pub ^I32 sc-emit-lines [^Cells olines ^Cells owords ^Cells osyms ^I32 l0 ^I32 nl ^I32 page ^I32 rotmed
                          ^:mut ^Cells scr ^:mut ^Cells words ^:mut ^Cells lines]
  (comment "Every OCR line of the run [l0, l0 + nl) that has words as a `lines` row, and its words as `words` rows, in the arenas")
  (comment "the text layer fills (D213: size, box and rotation are the line's, see the head of this file). The words' text is")
  (comment "the shared `etext`'s: `hd-tstart` and `hd-tlen` of an OCR word are read as they are. Answers the lines made.")
  (return (sc-emit-core olines owords osyms l0 nl page rotmed scr words lines 0)))

(defn ^:pub ^I32 sc-emit-sel [^Cells olines ^:mut ^Cells owords ^Cells osyms ^I32 nsel ^I32 page ^I32 rotmed
                              ^:mut ^Cells scr ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells etext ^Cells rules ^Cells comps ^Cells inks]
  (comment "`sc-emit-lines` over the OCR lines the scratch names (P7.4): `nsel` `olines` rows, in the order to emit them, at `scr`")
  (comment "cells `sc-sel-base` and up (`sc-sel-set`; `sc-prep` makes room for `sc-sel-max` of them): the lines of several runs chosen")
  (comment "line by line, their size clustered over the chosen lines; and (P12.6, `sc-emit-vetted`) with the words a body-ink line adds, the words that")
  (comment "are no text left out and the safe corrections made, `rules`, `comps` and `inks` being the tracer's rules, components and ink layers. Answers the lines made.")
  (return (sc-emit-vetted olines owords osyms nsel page rotmed scr words lines etext rules comps inks)))

(defn ^:pub ^I32 sc-sel-set [^:mut ^Cells scr ^I32 k ^I32 row]
  (cells-set scr (+ (sc-sel-base) k) row)
  (return 0))

(defn ^:pub ^I32 sc-page-view [^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells images ^I32 page ^I32 decreq
                              ^I32 wcpt ^I32 hcpt ^I32 pxw ^I32 pxh ^I32 dpi100
                              ^I32 cropx ^I32 cropy ^I32 obj ^I32 ix0 ^I32 iy0 ^I32 ix1 ^I32 iy1]
  (comment "The first half of a page of OCR: the image's placement, the page's `epages` row and the `views` row of the raster that")
  (comment "is read (a decode, `decreq` its request, `pxw x pxh` pixels at `dpi100`, its top-left corner at (`cropx`, `cropy`)")
  (comment "centipoints). Answers the view's row: P7.4 normalizes the raster (its skew goes to this row) BEFORE the OCR answer is")
  (comment "mapped through it (`sc-page-evidence`), as SPEC 8.2 says.")
  (im-new images page ix0 iy0 ix1 iy1 obj pxw pxh)
  (let [^I32 ep (ep-new epages page wcpt hcpt)]
    (ep-set epages ep (epf-flags) (eg-raster))
    (ep-set epages ep (epf-dpi) dpi100)
    (return (vw-new views page (vk-decode) decreq -1 pxw pxh dpi100 (lay-full) -1 0 0 cropx cropy 0))))

(defn ^:pub ^I32 sc-page-evidence [^Cells an ^I32 at ^I32 page ^I32 request ^I32 vdec ^I32 dpi100 ^I32 lang
                                   ^:mut ^Cells views ^Cells epages ^:mut ^Cells etext ^:mut ^Cells oruns
                                   ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords
                                   ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells feats]
  (comment "The second half: the OCR answer at `at` as the page's evidence (the run with everything under it, and the engine's")
  (comment "thresholded image as a view of its own when the answer says it carries one), mapped through the view `vdec`. Answers the")
  (comment "run's row. The pipeline's lines are `sc-emit-lines`' or `sc-emit-sel`'s.")
  (let [^I32 cropx (vw-get views vdec (vwf-cropx))
        ^I32 cropy (vw-get views vdec (vwf-cropy))
        ^I32 run (sc-answer an at page vdec request lang views epages etext oruns oblocks olines owords osyms oalts feats)
        ^I32 ext (ox-find an at)
        ^:mut ^I32 vbin -1]
    (if (>= ext 0)
      (if (== (ox-binary an ext) 1)
        (do (set vbin (vw-new views page (vk-engine-binary) request vdec (ox-bw an ext) (ox-bh an ext) dpi100 (lay-full) -1 0 0 cropx cropy 1))
            (or-set oruns run (orf-bview) vbin))))
    (return run)))

(defn ^:pub ^I32 sc-page [^Cells an ^I32 at ^I32 page ^I32 request ^I32 decreq
                          ^I32 wcpt ^I32 hcpt ^I32 pxw ^I32 pxh ^I32 dpi100
                          ^I32 cropx ^I32 cropy ^I32 obj ^I32 ix0 ^I32 iy0 ^I32 ix1 ^I32 iy1 ^I32 lang
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells scr]
  (comment "One page whose OCR answer is at `an`/`at`: the page's evidence (`epages`, the `views` row of the raster read, the image's")
  (comment "placement, the run with everything under it, the engine's thresholded image as a view of its own when the answer says")
  (comment "it carries one) and its lines in the pipeline's arenas. `decreq` is the decode request that made the bitmap, `request`")
  (comment "the OCR request; the raster is `pxw x pxh` at `dpi100` (dots per inch x 100) and its top-left corner is at (`cropx`,")
  (comment "`cropy`) centipoints of the page; `obj` is the image's object number (0 none) and (`ix0` `iy0`)-(`ix1` `iy1`) its box.")
  (comment "`scr` is scratch (at least 242 cells). Answers the number of OCR lines the pipeline got.")
  (sc-prep scr)
  (let [^I32 vdec (sc-page-view epages views images page decreq wcpt hcpt pxw pxh dpi100 cropx cropy obj ix0 iy0 ix1 iy1)
        ^I32 l0 (ol-count olines)]
    (sc-page-evidence an at page request vdec dpi100 lang views epages etext oruns oblocks olines owords osyms oalts feats)
    (let [^I32 nl (- (ol-count olines) l0)
          ^I32 rotmed (ev-rot-median olines l0 nl)]
      (return (sc-emit-lines olines owords osyms l0 nl page rotmed scr words lines)))))

;; ================================================================== the Model

(defn ^I32 sc-node-page [^Cells nodes ^Cells regions ^I32 n]
  (comment "The page of node `n`'s first region, or its nearest ancestor's that has one; -1 when none has.")
  (let [^:mut ^I32 t n]
    (while (>= t 0)
      (do (if (> (node-region-count nodes t) 0)
            (return (region-page regions (node-region-head nodes t))))
          (set t (node-parent nodes t))))
    (return -1)))

(defn ^:pub ^I32 sc-mask-unread [] (comment "D564: added to a page's `mask` cell when the engine had no model for the page's script (`emon.scriptcheck`).") (return 4))
(defn ^:pub ^I32 sc-unread-conf [] (comment "D564: the most confidence (per mille) a block of a page in a script the engine cannot read keeps.") (return 100))

(defn ^:pub ^I32 sc-tag-unread [^:mut ^Cells nodes ^Cells regions ^Cells mask]
  (comment "D564: every node whose text is OCR's (`ocr` in its source) on a page the unit marked `sc-mask-unread` (OSD sure of a script that no model the engine read it")
  (comment "with reads, `emon.scriptcheck`): a block is flagged `script-unread` and `low-conf`, and every node's confidence is held at `sc-unread-conf`. The text is the")
  (comment "engine's guess at a script it cannot read, kept and never presented as confident. After every other provenance stage (the scan's, fusion's). Answers the nodes held.")
  (let [^I32 nn (node-count nodes)
        ^:mut ^I32 n 1
        ^:mut ^I32 pg 0
        ^:mut ^I32 held 0]
    (while (< n nn)
      (do (set pg (sc-node-page nodes regions n))
          (if (and (>= pg 1) (<= pg (cells-len mask)))
            (if (!= (bit-and (cells-at mask (- pg 1)) (sc-mask-unread)) 0)
              (if (== (bit-and (node-src nodes n) (sr-ocr)) (sr-ocr))
                (do (if (== (nk-is-inline (node-kind nodes n)) 0)
                      (do (node-add-flag nodes n (fl-script-unread))
                          (node-add-flag nodes n (fl-low-conf))))
                    (if (> (node-conf nodes n) (sc-unread-conf))
                      (node-set-conf nodes n (sc-unread-conf)))
                    (set held (+ held 1))))))
          (set n (+ n 1))))
    (return held)))

(defn ^:pub ^I32 sc-write-bare [^Cells nodes ^Cells regions ^Cells pages ^Cells im ^:mut ^Cells ledger]
  (comment "P12.6 (R1): a page of the Model with no node on it and an image of at least a tenth of its area (the biggest such image) gets a ledger row, `background`, for that image, so that a page")
  (comment "that comes out empty never has nothing dropped: the image is what it held and was not read, not drawn as a figure and not kept. Answers the rows written.")
  (let [^I32 np (page-count pages)
        ^I32 nn (node-count nodes)
        ^I32 ni (im-count im)
        ^:mut ^I32 p 0
        ^:mut ^I32 j 0
        ^:mut ^I32 n 0
        ^:mut ^I32 best -1
        ^:mut ^I32 has 0
        ^:mut ^I32 rows 0
        ^:mut ^I64 area (i64 0)
        ^:mut ^I64 bestarea (i64 0)]
    (while (< p np)
      (do (set best -1)
          (set bestarea (i64 0))
          (set j 0)
          (while (< j ni)
            (do (if (== (im-get im j (mf-page)) (+ p 1))
                  (do (set area (mul64 (i64 (- (im-get im j (mf-x1)) (im-get im j (mf-x0)))) (i64 (- (im-get im j (mf-y1)) (im-get im j (mf-y0))))))
                      (if (>= (mul64 area (i64 10)) (mul64 (i64 (page-w pages p)) (i64 (page-h pages p))))
                        (if (> area bestarea)
                          (do (set best j)
                              (set bestarea area))))))
                (set j (+ j 1))))
          (if (>= best 0)
            (do (set has 0)
                (set n 1)
                (while (and (< n nn) (== has 0))
                  (do (if (== (sc-node-page nodes regions n) (+ p 1)) (set has 1))
                      (set n (+ n 1))))
                (if (== has 0)
                  (do (ledger-add ledger (dr-background) (+ p 1) (im-get im best (mf-x0)) (im-get im best (mf-y0)) (im-get im best (mf-x1)) (im-get im best (mf-y1)) 600 (sr-vector))
                      (set rows (+ rows 1))))))
          (set p (+ p 1))))
    (return rows)))

(defn ^:pub ^I32 sc-tag [^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells text ^Cells regions
                         ^:mut ^Cells pages ^Cells mask ^I32 policy]
  (comment "The provenance of OCR text, after the paragraphs are built. `mask` has one cell a page: 0 none, 1 an image page was")
  (comment "OCR'd, 2 a PDF page was (its kind becomes `scanned`, SPEC 3.4), plus `sc-mask-unread` for a page in a script the engine cannot read (`sc-tag-unread`).")
  (comment "Every node on a masked page: its `text` source becomes")
  (comment "`ocr`, an inline text's confidence 1000 (a glyph's own) becomes 500 (an engine's word: uncalibrated, D130, Phase 10), and a")
  (comment "block that had `text` is flagged `ocr-only`. The root gets `settings.ocr` (`policy` 1 auto, 2 always) when any page was OCR'd.")
  (let [^I32 np (page-count pages)
        ^I32 nn (node-count nodes)
        ^:mut ^I32 i 0
        ^:mut ^I32 any 0
        ^:mut ^I32 n 1
        ^:mut ^I32 pg 0
        ^:mut ^I32 m 0
        ^:mut ^I32 s 0
        ^:mut ^I32 start 0]
    (while (< i np)
      (do (if (and (< i (cells-len mask)) (>= (rem (cells-at mask i) 4) 1))
            (set any 1))
          (if (and (< i (cells-len mask)) (== (rem (cells-at mask i) 4) 2))
            (page-set-kind pages i (pk-scanned)))
          (set i (+ i 1))))
    (if (== any 0) (return 0))
    (while (< n nn)
      (do (set pg (sc-node-page nodes regions n))
          (set m 0)
          (if (and (>= pg 1) (<= pg (cells-len mask)))
            (set m (cells-at mask (- pg 1))))
          (if (>= (rem m 4) 1)
            (do (set s (node-src nodes n))
                (if (!= (bit-and m 8) 0) (node-add-flag nodes n (fl-rotated)))
                (if (== (bit-and s (sr-text)) (sr-text))
                  (do (node-set-src nodes n (+ (- s (sr-text)) (sr-ocr)))
                      (if (== (nk-is-inline (node-kind nodes n)) 0)
                        (node-add-flag nodes n (fl-ocr-only)))
                      (if (== (node-conf nodes n) 1000)
                        (node-set-conf nodes n 500))))))
          (set n (+ n 1))))
    (set start (cells-len text))
    (if (== policy 1)
      (do (text-append-cp text 97) (text-append-cp text 117) (text-append-cp text 116) (text-append-cp text 111)))
    (if (== policy 2)
      (do (text-append-cp text 97) (text-append-cp text 108) (text-append-cp text 119) (text-append-cp text 97)
          (text-append-cp text 121) (text-append-cp text 115)))
    (if (> (cells-len text) start)
      (node-set-attr-text nodes attrs 0 (fk-ocr) start (- (cells-len text) start)))
    (return 1)))

;; ============================================================== a PDF's scanned pages

(defn ^I32 sc-native-jpeg [^Src src ^I32 start ^I32 n]
  (comment "The JPEG subset every ImageDecode host reads for scans: SOF0/1/2, 8-bit, one or three components. Other frames need page rendering; native libraries differ on arithmetic JPEG.")
  (let [^:mut ^I32 i 2
        ^:mut ^I32 m 0
        ^:mut ^I32 size 0
        ^:mut ^I32 comps 0]
    (if (< n 4) (return 0))
    (if (or (!= (ps-u8 src start) 255) (!= (ps-u8 src (+ start 1)) 216)) (return 0))
    (while (<= (+ i 4) n)
      (do (if (!= (ps-u8 src (+ start i)) 255) (return 0))
          (set m (ps-u8 src (+ start (+ i 1))))
          (if (== m 255)
            (set i (+ i 1))
            (if (or (== m 216) (or (== m 1) (and (>= m 208) (<= m 215))))
              (set i (+ i 2))
              (do (if (or (== m 217) (== m 218)) (return 0))
                  (set size (+ (* 256 (ps-u8 src (+ start (+ i 2)))) (ps-u8 src (+ start (+ i 3)))))
                  (if (or (< size 2) (> size (- n (+ i 2)))) (return 0))
                  (if (and (>= m 192) (and (<= m 207) (and (!= m 196) (and (!= m 200) (!= m 204)))))
                    (do (if (or (< m 192) (> m 194)) (return 0))
                        (if (< size 8) (return 0))
                        (if (!= (ps-u8 src (+ start (+ i 4))) 8) (return 0))
                        (set comps (ps-u8 src (+ start (+ i 9))))
                        (if (or (== comps 1) (== comps 3)) (return 1))
                        (return 0)))
                  (set i (+ i (+ size 2))))))))
    (return 0)))

(defn ^:pub ^I32 sc-dct-span [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                        ^I32 obj ^:mut ^Cells sp]
  (comment "Is object `obj` a stream whose whole filter chain is one DCT stage, in a file that is not encrypted? Then 1 and `sp`")
  (comment "holds [start, length] of its bytes in the file: a JPEG stream is a JPEG file, and the host's `ImageDecode` reads it in")
  (comment "place. Anything else 0. Loads objects, so `a`, `b` and `st` are overwritten and the source may miss.")
  (let [^I32 h (pd-get src ar dc a b st obj)
        ^:mut ^I32 plan 0
        ^:mut ^I32 h0 0
        ^:mut ^I32 h1 0
        ^:mut ^I32 kt 0
        ^:mut ^I32 j 0
        ^:mut ^I32 ns 0]
    (if (== h 0) (return 0))
    (comment "8 is the arena kind of a stream (`pl-k-stream`; what `pc-do-image` checks)")
    (if (!= (pl-kind-of ar h) 8) (return 0))
    (set plan (pd-stream-plan src ar dc a b st h))
    (if (ps-missed src) (return 0))
    (set h0 (pl-first ar plan))
    (set h1 (pl-next ar h0))
    (if (!= (pl-int-value ar h0) 0) (return 0))
    (set ns (pl-int-value ar h1))
    (if (!= ns 1) (return 0))
    (set kt (pl-next ar h1))
    (if (!= (pl-int-value ar kt) 7) (return 0))
    (comment "past the stage's six numbers to the decryption mode: 0 none")
    (while (< j 6)
      (do (set kt (pl-next ar kt))
          (set j (+ j 1))))
    (if (!= (pl-int-value ar kt) 0) (return 0))
    (if (== (sc-native-jpeg src (pl-stream-start ar h) (pl-stream-len ar h)) 0) (return 0))
    (if (ps-missed src) (return 0))
    (cells-drop sp 0)
    (cells-push sp (pl-stream-start ar h))
    (cells-push sp (pl-stream-len ar h))
    (return 1)))

(defn ^:pub ^I32 sc-cover-min [] (comment "P12.6 (R1): the share of a page's area (per mille) that the image of a page with no text at all must cover to be read as the page: a quarter. It was a half, and a 96 dpi book page on an A4 page covers 49.5 per cent of it: the page was dropped, body and ledger empty.") (return 250))

(defn ^:pub ^I32 sc-eligible [^Cells im ^I32 j ^I32 pw ^I32 ph]
  (comment "Can image placement `j` be OCR'd as the page? Upright and not skewed, a real XObject (not inline, not a stencil")
  (comment "mask), at least 16 pixels each way, and covering at least `sc-cover-min` of the page (`pw` x `ph` centipoints) by area. The caller has already seen that the page has no text at all, so the")
  (comment "image is what the page holds (the biggest of them, when it has more).")
  (if (<= (im-get im j (mf-obj)) 0) (return 0))
  (if (!= (im-get im j (mf-rot)) 0) (return 0))
  (if (!= (im-get im j (mf-skewed)) 0) (return 0))
  (if (!= (bit-and (im-get im j (mf-flags)) (+ (mg-mask) (mg-inline))) 0) (return 0))
  (if (< (im-get im j (mf-pxw)) 16) (return 0))
  (if (< (im-get im j (mf-pxh)) 16) (return 0))
  (let [^I64 area (mul64 (i64 (- (im-get im j (mf-x1)) (im-get im j (mf-x0))))
                         (i64 (- (im-get im j (mf-y1)) (im-get im j (mf-y0)))))
        ^I64 whole (mul64 (i64 pw) (i64 ph))]
    (if (< (mul64 area (i64 1000)) (mul64 whole (i64 (sc-cover-min)))) (return 0))
    (if (<= whole (i64 0)) (return 0))
    (return 1)))

(defn ^:pub ^I32 sc-word-agreement [^Cells ow ^Cells et ^I32 w]
  (comment "D667: overlapping words from different passes must agree on their text. Ambiguous splits are left alone; a near-identical word box with a different reading reduces trust.")
  (let [^:mut ^I32 j 0 ^:mut ^I32 k 0 ^:mut ^I32 same 0 ^I32 n (ow-get ow w (hd-tlen))]
    (while (< j (ow-count ow))
      (do (if (and (!= (ow-get ow j (owf-run)) (ow-get ow w (owf-run)))
                   (and (== (ow-get ow j (hd-page)) (ow-get ow w (hd-page)))
                        (>= (ev-overlap-small (ow-get ow w (hd-x0)) (ow-get ow w (hd-y0)) (ow-get ow w (hd-x1)) (ow-get ow w (hd-y1))
                                               (ow-get ow j (hd-x0)) (ow-get ow j (hd-y0)) (ow-get ow j (hd-x1)) (ow-get ow j (hd-y1))) 800)))
            (if (== (ow-get ow j (hd-tlen)) n)
              (do (set k 0) (set same 1)
                  (while (< k n)
                    (do (if (!= (cells-at et (+ (ow-get ow w (hd-tstart)) k)) (cells-at et (+ (ow-get ow j (hd-tstart)) k))) (set same 0))
                        (set k (+ k 1))))
                  (if (== same 0) (return 700)))))
          (set j (+ j 1))))
    (return 1000)))

(defn ^I32 sc-word-base [^Cells owords ^Cells etext ^I32 w]
  (let [^I32 ts (ow-get owords w (hd-tstart))
        ^I32 n (ow-get owords w (hd-tlen))
        ^I32 flags (ow-get owords w (owf-flags))
        ^:mut ^I32 score (ow-get owords w (hd-conf))
        ^:mut ^I32 i 0
        ^:mut ^I32 latin 0
        ^:mut ^I32 rejected 0
        ^:mut ^I32 cp 0]
    (if (< score 0) (set score 0))
    (if (> score 1000) (set score 1000))
    (while (< i n)
      (do (set cp (cells-at etext (+ ts i)))
          (if (or (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))) (set latin (+ latin 1)))
          (if (or (== cp 65533) (== (sc-cp-class cp) 2)) (set rejected (+ rejected 1)))
          (set i (+ i 1))))
    (if (and (>= latin 3) (== (bit-and flags 3) 0)) (set score (- score 180)))
    (if (== (sc-implausible etext ts n) 1) (set score (- score 400)))
    (if (> n 0) (set score (- score (quot (* rejected 600) n))))
    (if (!= (bit-and flags (oe-garbage)) 0) (if (> score 200) (set score 200)))
    (if (< score 0) (set score 0))
    (return score)))

(defn ^:pub ^I32 sc-word-trust [^Cells owords ^Cells etext ^I32 w]
  (return (quot (* (sc-word-base owords etext w) (sc-word-agreement owords etext w)) 1000)))

(defn ^I32 sc-rotated-page [^Cells oruns ^I32 page]
  (let [^:mut ^I32 r 0]
    (while (< r (or-count oruns))
      (do (if (and (== (or-get oruns r 0) page) (== (or-get oruns r (orf-pass)) (op-re-rotated))) (return 1))
          (set r (+ r 1))))
    (return 0)))

(defn ^:pub ^I32 sc-trust [^:mut ^Cells nodes ^Cells regions ^Cells owords ^Cells etext ^Cells oruns]
  (comment "D667: pure OCR nodes carry character-weighted word evidence, rather than paragraph/heading constants. Rejected words in their region also lower trust.")
  (let [^:mut ^I32 n 1 ^:mut ^I32 r 0 ^:mut ^I32 w 0 ^:mut ^I32 cx 0 ^:mut ^I32 cy 0
        ^:mut ^I32 sum 0 ^:mut ^I32 count 0 ^:mut ^I32 weight 0 ^:mut ^I32 score 0 ^:mut ^I32 tagged 0
        ^:mut ^I32 rotated 0 ^:mut ^I32 run 0 ^:mut ^I32 eligible 0 ^:mut ^I32 trust 0]
    (while (< n (node-count nodes))
      (do (if (and (!= (bit-and (node-src nodes n) (sr-ocr)) 0) (== (bit-and (node-src nodes n) (sr-text)) 0))
            (do (set sum 0) (set count 0)
                (set r (node-region-head nodes n))
                (while (>= r 0)
                  (do (set rotated 0)
                      (if (!= (bit-and (node-flags nodes n) (fl-rotated)) 0)
                        (set rotated (sc-rotated-page oruns (region-page regions r))))
                      (set w 0)
                      (while (< w (ow-count owords))
                        (do (set cx (quot (+ (ow-get owords w (hd-x0)) (ow-get owords w (hd-x1))) 2))
                            (set cy (quot (+ (ow-get owords w (hd-y0)) (ow-get owords w (hd-y1))) 2))
                            (set eligible 1)
                            (if (== rotated 1)
                              (do (set run (ow-get owords w (owf-run)))
                                  (set eligible 0)
                                  (if (and (>= run 0) (< run (or-count oruns)))
                                    (if (== (or-get oruns run (orf-pass)) (op-re-rotated)) (set eligible 1)))))
                            (if (and (and (== eligible 1) (== (ow-get owords w (hd-page)) (region-page regions r)))
                                     (and (and (>= cx (region-x0 regions r)) (<= cx (region-x1 regions r)))
                                          (and (>= cy (region-y0 regions r)) (<= cy (region-y1 regions r)))))
                              (do (set weight (ow-get owords w (hd-tlen)))
                                  (if (> weight 40) (set weight 40))
                                  (if (== rotated 1)
                                    (set trust (sc-word-base owords etext w))
                                    (set trust (sc-word-trust owords etext w)))
                                  (set sum (+ sum (* weight trust)))
                                  (set count (+ count weight))))
                            (set w (+ w 1))))
                      (set r (region-next regions r))))
                (if (> count 0)
                  (do (set score (quot sum count))
                      (node-set-conf nodes n score)
                      (if (< score 500) (node-add-flag nodes n (fl-low-conf)))
                      (set tagged (+ tagged 1))))))
          (set n (+ n 1))))
    (return tagged)))

(defn ^:pub ^I32 sc-format-control [^I32 cp]
  (if (or (== cp 1564) (or (== cp 8206) (== cp 8207))) (return 1))
  (if (or (and (>= cp 8234) (<= cp 8238)) (and (>= cp 8294) (<= cp 8297))) (return 1))
  (return 0))
(defn ^:pub ^I32 sc-unspaced [^I32 cp]
  (if (or (and (>= cp 12352) (<= cp 12543))
          (or (and (>= cp 13312) (<= cp 40959)) (and (>= cp 131072) (<= cp 195103)))) (return 1))
  (return 0))

(defn ^:pub ^I32 sc-clean-text [^:mut ^Cells nodes ^:mut ^Cells text]
  (comment "D669: OCR formatting controls and separators between adjacent Han/Kana characters are not content. Repoint only changed OCR text runs.")
  (let [^:mut ^I32 n 1 ^:mut ^I32 ts 0 ^:mut ^I32 ncp 0 ^:mut ^I32 i 0 ^:mut ^I32 cp 0
        ^:mut ^I32 start 0 ^:mut ^I32 skip 0 ^:mut ^I32 changed 0 ^:mut ^I32 any 0]
    (while (< n (node-count nodes))
      (do (if (!= (bit-and (node-src nodes n) (sr-ocr)) 0)
            (do (set ts (node-text-start nodes n)) (set ncp (node-text-len nodes n))
                (set start (cells-len text)) (set i 0) (set changed 0)
                (while (< i ncp)
                  (do (set cp (cells-at text (+ ts i))) (set skip (sc-format-control cp))
                      (if (and (== cp 32) (and (> i 0) (< (+ i 1) ncp)))
                        (if (and (== (sc-unspaced (cells-at text (+ ts (- i 1)))) 1)
                                 (== (sc-unspaced (cells-at text (+ ts (+ i 1)))) 1)) (set skip 1)))
                      (if (== skip 0) (text-append-cp text cp) (set changed 1))
                      (set i (+ i 1))))
                (if (== changed 1)
                  (do (node-set-text nodes n start (- (cells-len text) start)) (set any (+ any 1)))
                  (cells-drop text start))))
          (set n (+ n 1))))
    (return any)))

(defn ^:pub ^I32 sc-write-empty-regions [^Cells olines ^Cells nodes ^Cells regions ^:mut ^Cells ledger]
  (comment "D670: a represented ink gap with no Model region over it gets a ledger row, including unread crops and crops held out by the body-ink owner.")
  (let [^:mut ^I32 l 0 ^:mut ^I32 n 0 ^:mut ^I32 r 0 ^:mut ^I32 found 0 ^:mut ^I32 rows 0]
    (while (< l (ol-count olines))
      (do (if (== (ol-get olines l (olf-retry-gap)) 1)
            (do (set found 0) (set n 1)
                (while (and (< n (node-count nodes)) (== found 0))
                  (do (set r (node-region-head nodes n))
                      (while (and (>= r 0) (== found 0))
                        (do (if (== (region-page regions r) (ol-get olines l (hd-page)))
                              (if (> (ev-overlap-small (region-x0 regions r) (region-y0 regions r) (region-x1 regions r) (region-y1 regions r)
                                                      (ol-get olines l (lh-x0)) (ol-get olines l (lh-y0))
                                                      (ol-get olines l (lh-x1)) (ol-get olines l (lh-y1))) 100)
                                (set found 1)))
                            (set r (region-next regions r))))
                      (set n (+ n 1))))
                (if (== found 0)
                  (do (ledger-add ledger (dr-ocr-ghost) (ol-get olines l (hd-page))
                                  (ol-get olines l (lh-x0)) (ol-get olines l (lh-y0))
                                  (ol-get olines l (lh-x1)) (ol-get olines l (lh-y1)) 0 (sr-ocr))
                      (set rows (+ rows 1))))))
          (set l (+ l 1))))
    (return rows)))

(defn ^:pub ^I32 sc-write-empty-ocr [^Cells oruns ^Cells pages ^:mut ^Cells ledger]
  (comment "D698: an explicit ocr-empty diagnostic and dropped region after every attempt on a page returned no words. No text is invented.")
  (let [^:mut ^I32 p 0 ^:mut ^I32 r 0 ^:mut ^I32 seen 0 ^:mut ^I32 words 0 ^:mut ^I32 rows 0]
    (while (< p (page-count pages))
      (do (set r 0) (set seen 0) (set words 0)
          (while (< r (or-count oruns))
            (do (if (== (or-get oruns r 0) (+ p 1))
                  (do (set seen 1) (set words (+ words (or-get oruns r (orf-wcount))))))
                (set r (+ r 1))))
          (if (and (== seen 1) (== words 0))
            (do (ledger-add ledger (dr-ocr-empty) (+ p 1) 0 0 (page-w pages p) (page-h pages p) 1000 (sr-ocr))
                (set rows (+ rows 1))))
          (set p (+ p 1))))
    (return rows)))
