;; Laws and the row corpora for `emon.pdfdoc` (P1.5).
;;
;; THREE CORPORA, all written by `kin/scripts/pdf-fixtures.py` (hand-built
;; PDFs whose answers are known BY CONSTRUCTION, plus a Chrome and a
;; Ghostscript file whose answers come from poppler's `pdfinfo`):
;;
;;   test/pdf/fixtures.txt         file, status, page count, a digest of every
;;                                 page's boxes and rotation
;;   test/pdf/objects-in-files.txt file, object number, what it must be (an
;;                                 object dump, a missing object, or a
;;                                 stream's decoded bytes)
;;   test/pdf/corpus.txt           real files from `corpus/` (P1.5's "accuracy
;;                                 on real-world PDFs"): page count and digest
;;                                 as `pdfinfo` reports them
;;
;; plus `test/pdf/source/*.json`, the `Source` value of five fixtures as
;; goldens. Every target reads the same files and must agree.
;;
;; THE DIGEST is a 23-bit rolling hash over each page's MediaBox, CropBox (in
;; centipoints) and Rotate: one number that says every page's geometry, and
;; one the generating script computes independently in Python.
(ns emon.pdfdoctest
  (:require [emon.lang :refer [I32 I64 Blob Cells Text emit-ascii i64]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that
                               assert-that-at assert-text assert-text-span
                               text-blob new-cells new-text test-file
                               test-file-span cells-blob]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-set
                               cells-push cells-drop]]
            [emon.splitmix :refer [sm-seed sm-next sm-below]]
            [emon.pdfdoc :refer [pd-open pd-get pd-resolve pd-pages pd-stream-data
                                 pd-pg-count pd-pg-media pd-pg-crop pd-pg-rotate
                                 pd-source-json pd-status-emit-name pd-encrypted
                                 pd-version-major pd-version-minor pd-warn
                                 pd-ent-kind pd-object-count]]
            [emon.pdflex :refer [pl-dump pl-kind-of pl-k-stream]]
            [emon.pdffilter :refer [pf-status-emit-name]]
            [kin.lang :refer [defn return let set while if comment do
                              + - * < > <= >= == != and or quot rem]]))

;; ------------------------------------------------------------ row helpers

(defn ^I32 dt-nl [^Blob b ^I32 i]
  (let [^:mut ^I32 k i]
    (while (and (< k (blob-len b)) (!= (blob-u8 b k) 10))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 dt-tab [^Blob b ^I32 i ^I32 lim]
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 9))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 dt-dec [^Blob b ^I32 from ^I32 to]
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0]
    (while (< k to)
      (do (set v (+ (* v 10) (- (blob-u8 b k) 48)))
          (set k (+ k 1))))
    (return v)))

(defn ^I32 dt-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (return -1))

(defn ^I32 dt-compare-hex [^Cells out ^Blob b ^I32 from ^I32 to]
  (comment "-1 when `out` is exactly the hex in b[from, to) (`-` is empty); -2")
  (comment "for a length difference; else the first differing index.")
  (let [^:mut ^I32 n (quot (- to from) 2)
        ^:mut ^I32 i 0]
    (if (and (== (- to from) 1) (== (blob-u8 b from) 45)) (set n 0))
    (if (!= (cells-len out) n) (return -2))
    (while (< i n)
      (do (if (!= (cells-at out i)
                  (+ (* (dt-hexval (blob-u8 b (+ from (* i 2)))) 16)
                     (dt-hexval (blob-u8 b (+ from (+ (* i 2) 1))))))
            (return i))
          (set i (+ i 1))))
    (return -1)))

(defn ^I32 dt-pts [^I32 cp]
  (comment "Centipoints as whole points, rounded half up (floor of +0.5): the real")
  (comment "corpus is compared in points because poppler prints boxes with two")
  (comment "decimals, binary-rounded, and may differ from the exact decimal by a")
  (comment "centipoint (68.315 is 68.31 to poppler and 68.32 to emon).")
  (let [^I32 x (+ cp 50)
        ^:mut ^I32 q (quot x 100)]
    (if (< (rem x 100) 0) (set q (- q 1)))
    (return q)))

(defn ^I32 dt-digest-pts [^Cells pg]
  (comment "The 23-bit rolling hash of every page's boxes in whole points and")
  (comment "its rotation.")
  (let [^I32 n (pd-pg-count pg)
        ^:mut ^I32 i 0
        ^:mut ^I32 k 0
        ^:mut ^I32 h 0
        ^:mut ^I32 v 0]
    (while (< i n)
      (do (set k 0)
          (while (< k 9)
            (do (if (< k 4) (set v (dt-pts (pd-pg-media pg i k))))
                (if (and (>= k 4) (< k 8)) (set v (dt-pts (pd-pg-crop pg i (- k 4)))))
                (if (== k 8) (set v (pd-pg-rotate pg i)))
                (set v (rem v 8388593))
                (if (< v 0) (set v (+ v 8388593)))
                (set h (rem (+ (* h 131) v) 8388593))
                (set k (+ k 1))))
          (set i (+ i 1))))
    (return h)))

(defn ^I32 dt-digest [^Cells pg]
  (comment "The 23-bit rolling hash of every page's boxes and rotation.")
  (let [^I32 n (pd-pg-count pg)
        ^:mut ^I32 i 0
        ^:mut ^I32 k 0
        ^:mut ^I32 h 0
        ^:mut ^I32 v 0]
    (while (< i n)
      (do (set k 0)
          (while (< k 9)
            (do (if (< k 4) (set v (pd-pg-media pg i k)))
                (if (and (>= k 4) (< k 8)) (set v (pd-pg-crop pg i (- k 4))))
                (if (== k 8) (set v (pd-pg-rotate pg i)))
                (set v (rem v 8388593))
                (if (< v 0) (set v (+ v 8388593)))
                (set h (rem (+ (* h 131) v) 8388593))
                (set k (+ k 1))))
          (set i (+ i 1))))
    (return h)))

;; ------------------------------------------------------ one document, all

(defn ^I32 dt-open [^Blob pdf ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                    ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells pg]
  (comment "Open a document and list its pages (an empty `pg` when it will not")
  (comment "open). Answers the `pd-status`.")
  (let [^I32 status (pd-open pdf ar dc a b st)]
    (cells-drop pg 0)
    (if (== status 0)
      (pd-pages pdf ar dc a b st pg))
    (return status)))

;; ------------------------------------------------------------ the corpora

(defn ^I32 dt-run-fixtures-row [^Blob names ^I32 from ^I32 to ^:mut ^Cells ar
                                ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b
                                ^:mut ^Cells st ^:mut ^Cells pg ^:mut ^Text t]
  (comment "Open the file named by names[from, to) and write its status.")
  (let [^Blob pdf (test-file-span names from to)
        ^I32 status (dt-open pdf ar dc a b st pg)]
    (pd-status-emit-name t status)
    (return status)))

(deftest test-every-fixture-opens-or-fails-as-named
  (comment "Row: file, status, pages, digest.")
  (let [^Blob f (test-file "pdf/fixtures.txt")
        ^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^I32 n (blob-len f)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 rows 0
        ^:mut ^I32 e 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 status 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (dt-nl f pos))
          (if (and (< pos e) (!= (blob-u8 f pos) 35))
            (do (set rows (+ rows 1))
                (set s0 (dt-tab f pos e))
                (set s1 (dt-tab f (+ s0 1) e))
                (set s2 (dt-tab f (+ s1 1) e))
                (let [^Text t (new-text)]
                  (set status (dt-run-fixtures-row f pos s0 ar dc a b st pg t))
                  (assert-text-span t f (+ s0 1) s1 "status" line))
                (if (== status 0)
                  (do (assert-eq-at (pd-pg-count pg) (dt-dec f (+ s1 1) s2) "page count" line)
                      (assert-eq-at (dt-digest pg) (dt-dec f (+ s2 1) e) "page boxes and rotation" line)))))
          (set pos (+ e 1))))
    (assert-that (> rows 20) "the fixtures were read")))

(defn ^I32 dt-object-row [^Blob names ^I32 from ^I32 to ^I32 num ^I32 kind
                          ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                          ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells out
                          ^:mut ^Text t]
  (comment "Open the file, then: kind 111 (o) dumps object num into t (`!missing`")
  (comment "when there is none); kind 115 (s) decodes it into `out` and writes the")
  (comment "status name to t. Answers the pd-open status (non-zero: not opened).")
  (let [^Blob pdf (test-file-span names from to)
        ^I32 status (pd-open pdf ar dc a b st)
        ^:mut ^I32 h 0
        ^:mut ^I32 s 0]
    (if (!= status 0) (return status))
    (set h (pd-get pdf ar dc a b st num))
    (if (== kind 111)
      (if (== h 0)
        (emit-ascii t "!missing")
        (pl-dump t ar h)))
    (if (== kind 115)
      (do (cells-drop out 0)
          (if (== h 0)
            (emit-ascii t "!missing")
            (do (set s (pd-stream-data pdf ar dc a b st h out))
                (pf-status-emit-name t s)))))
    (return 0)))

(deftest test-every-object-resolves-as-built
  (comment "Row: file, object number, kind, status, expected.")
  (let [^Blob f (test-file "pdf/objects-in-files.txt")
        ^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^I32 n (blob-len f)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 rows 0
        ^:mut ^I32 e 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 s3 0
        ^:mut ^I32 opened 0
        ^:mut ^I32 kind 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (dt-nl f pos))
          (if (and (< pos e) (!= (blob-u8 f pos) 35))
            (do (set rows (+ rows 1))
                (set s0 (dt-tab f pos e))
                (set s1 (dt-tab f (+ s0 1) e))
                (set s2 (dt-tab f (+ s1 1) e))
                (set s3 (dt-tab f (+ s2 1) e))
                (set kind (blob-u8 f (+ s1 1)))
                (let [^Text t (new-text)]
                  (set opened (dt-object-row f pos s0 (dt-dec f (+ s0 1) s1) kind ar dc a b st out t))
                  (assert-eq-at opened 0 "the file opens" line)
                  (if (== kind 111)
                    (assert-text-span t f (+ s3 1) e "object" line))
                  (if (== kind 115)
                    (do (assert-text-span t f (+ s2 1) s3 "stream status" line)
                        (assert-eq-at (dt-compare-hex out f (+ s3 1) e) -1 "decoded bytes" line))))))
          (set pos (+ e 1))))
    (assert-that (> rows 40) "the rows were read")))

(defn ^I32 dt-corpus-row [^Blob names ^I32 from ^I32 to ^:mut ^Cells ar
                          ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b
                          ^:mut ^Cells st ^:mut ^Cells pg ^:mut ^Text t]
  (comment "Open a real file and write its status name to t.")
  (let [^Blob pdf (test-file-span names from to)
        ^I32 status (dt-open pdf ar dc a b st pg)]
    (pd-status-emit-name t status)
    (return status)))

(deftest test-every-real-file-opens-with-the-page-count-pdfinfo-reports
  (comment "Row: path (relative to test/), status, pages, digest in points. A file")
  (comment "emon cannot yet open says why (`bad-xref`: repair is P3.1;")
  (comment "`encrypted`: decryption is P3.2) and is a RATCHET: when it starts to")
  (comment "open this law fails until the row is regenerated.")
  (let [^Blob f (test-file "pdf/corpus.txt")
        ^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^I32 n (blob-len f)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 rows 0
        ^:mut ^I32 e 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 status 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (dt-nl f pos))
          (if (and (< pos e) (!= (blob-u8 f pos) 35))
            (do (set rows (+ rows 1))
                (set s0 (dt-tab f pos e))
                (set s1 (dt-tab f (+ s0 1) e))
                (set s2 (dt-tab f (+ s1 1) e))
                (let [^Text t (new-text)]
                  (set status (dt-corpus-row f pos s0 ar dc a b st pg t))
                  (assert-text-span t f (+ s0 1) s1 "status" line))
                (if (== status 0)
                  (do (assert-eq-at (pd-pg-count pg) (dt-dec f (+ s1 1) s2) "page count" line)
                      (assert-eq-at (dt-digest-pts pg) (dt-dec f (+ s2 1) e) "page boxes and rotation (points)" line)))))
          (set pos (+ e 1))))
    (assert-that (> rows 100) "the real files were read")))

;; ------------------------------------------------------------ the Source

(defn ^I32 dt-source [^Blob pdf ^:mut ^Text t]
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^I32 status (dt-open pdf ar dc a b st pg)]
    (if (!= status 0) (return status))
    (pd-source-json t dc pg)
    (return 0)))

(deftest test-source-of-minimal-pdf
  (let [^Blob want (test-file "pdf/source/minimal.json")
        ^Text t (new-text)
        ^I32 status (dt-source (test-file "pdf/minimal.pdf") t)]
    (assert-eq status 0 "opens")
    (assert-text-span t want 0 (- (blob-len want) 1) "Source JSON" 0)))

(deftest test-source-of-html-chrome-pdf
  (let [^Blob want (test-file "pdf/source/html-chrome.json")
        ^Text t (new-text)
        ^I32 status (dt-source (test-file "pdf/html-chrome.pdf") t)]
    (assert-eq status 0 "opens")
    (assert-text-span t want 0 (- (blob-len want) 1) "Source JSON" 0)))

(deftest test-source-of-ghostscript-xref-stream-pdf
  (let [^Blob want (test-file "pdf/source/gs-xrefstream.json")
        ^Text t (new-text)
        ^I32 status (dt-source (test-file "pdf/gs-xrefstream.pdf") t)]
    (assert-eq status 0 "opens")
    (assert-text-span t want 0 (- (blob-len want) 1) "Source JSON" 0)))

(deftest test-source-with-inherited-attributes
  (let [^Blob want (test-file "pdf/source/inherit.json")
        ^Text t (new-text)
        ^I32 status (dt-source (test-file "pdf/inherit.pdf") t)]
    (assert-eq status 0 "opens")
    (assert-text-span t want 0 (- (blob-len want) 1) "Source JSON" 0)))

(deftest test-source-with-odd-boxes-and-rotations
  (let [^Blob want (test-file "pdf/source/boxes.json")
        ^Text t (new-text)
        ^I32 status (dt-source (test-file "pdf/boxes.pdf") t)]
    (assert-eq status 0 "opens")
    (assert-text-span t want 0 (- (blob-len want) 1) "Source JSON" 0)))

;; ------------------------------------------------------------------- laws

(defn ^I32 dt-info [^Blob pdf ^I32 which]
  (comment "A fact about a document: 0 status, 1 encrypted, 2 version major,")
  (comment "3 version minor, 4 warning bits, 5 highest object number + 1.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^I32 status (dt-open pdf ar dc a b st pg)]
    (if (== which 0) (return status))
    (if (== which 1) (return (pd-encrypted dc)))
    (if (== which 2) (return (pd-version-major dc)))
    (if (== which 3) (return (pd-version-minor dc)))
    (if (== which 4) (return (pd-warn dc)))
    (return (pd-object-count dc))))

(deftest test-header-version-and-encryption-are-reported
  (assert-eq (dt-info (test-file "pdf/minimal.pdf") 2) 1 "major")
  (assert-eq (dt-info (test-file "pdf/minimal.pdf") 3) 4 "minor")
  (assert-eq (dt-info (test-file "pdf/xrefstream.pdf") 3) 5 "minor of a 1.5 file")
  (assert-eq (dt-info (test-file "pdf/minimal.pdf") 1) 0 "not encrypted")
  (assert-eq (dt-info (test-file "pdf/encrypt-flag.pdf") 1) 1 "an /Encrypt entry is reported")
  (assert-eq (dt-info (test-file "pdf/minimal.pdf") 5) 6 "objects 0 to 5"))

(deftest test-tolerated-damage-is-recorded-as-warnings
  (assert-eq (dt-info (test-file "pdf/minimal.pdf") 4) 0 "no warnings")
  (assert-eq (dt-info (test-file "pdf/junk-header.pdf") 4) 1 "offsets relative to a header at 0 + 81")
  (assert-eq (dt-info (test-file "pdf/hybrid.pdf") 4) 2 "hybrid-reference file")
  (assert-eq (dt-info (test-file "pdf/prev-loop.pdf") 4) 4 "a /Prev loop is cut")
  (assert-eq (dt-info (test-file "pdf/kids-cycle.pdf") 4) 128 "a cyclic page tree is cut")
  (assert-eq (dt-info (test-file "pdf/boxes.pdf") 4) 256 "a missing MediaBox is defaulted"))

;; ------------------------------------------------------------------- fuzz

(defn ^I32 dt-survive [^Blob pdf ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                       ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells pg ^:mut ^Cells out]
  (comment "Open, list the pages, and decode every stream the cross-reference")
  (comment "names: none of it may fault. Answers the pd-open status.")
  (let [^I32 status (dt-open pdf ar dc a b st pg)
        ^:mut ^I32 i 1
        ^:mut ^I32 h 0]
    (if (== status 0)
      (while (< i (pd-object-count dc))
        (do (set h (pd-get pdf ar dc a b st i))
            (if (!= h 0)
              (if (== (pl-kind-of ar h) 8)
                (pd-stream-data pdf ar dc a b st h out)))
            (set i (+ i 1)))))
    (return status)))

(defn ^I32 dt-cut [^Blob f ^I32 n ^:mut ^Cells cut]
  (comment "cut = the first n bytes of f.")
  (let [^:mut ^I32 i 0]
    (cells-drop cut 0)
    (while (< i n)
      (do (cells-push cut (blob-u8 f i))
          (set i (+ i 1))))
    (return n)))

(defn ^I32 dt-truncations [^Blob f ^I32 step ^:mut ^Cells ar ^:mut ^Cells dc
                           ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                           ^:mut ^Cells pg ^:mut ^Cells out ^:mut ^Cells cut]
  (comment "Every truncation of f (every `step` bytes): none may fault. Answers")
  (comment "how many still opened.")
  (let [^I32 n (blob-len f)
        ^:mut ^I32 k 0
        ^:mut ^I32 ok 0]
    (while (<= k n)
      (do (dt-cut f k cut)
          (if (== (dt-survive (cells-blob cut) ar dc a b st pg out) 0)
            (set ok (+ ok 1)))
          (set k (+ k step))))
    (return ok)))

(defn ^I32 dt-corruptions [^Blob f ^I32 rounds ^I32 flips ^I32 seed
                           ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                           ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells pg
                           ^:mut ^Cells out ^:mut ^Cells cut ^:mut ^Cells rng]
  (comment "`rounds` copies of f, each with `flips` random bytes replaced")
  (comment "(SplitMix, so every target damages the same bytes): none may fault.")
  (let [^I32 n (blob-len f)
        ^:mut ^I32 r 0
        ^:mut ^I32 j 0
        ^:mut ^I32 at 0
        ^:mut ^I32 ok 0]
    (sm-seed rng (i64 seed))
    (while (< r rounds)
      (do (dt-cut f n cut)
          (set j 0)
          (while (< j flips)
            (do (set at (sm-below rng n))
                (cells-set cut at (sm-below rng 256))
                (set j (+ j 1))))
          (if (== (dt-survive (cells-blob cut) ar dc a b st pg out) 0)
            (set ok (+ ok 1)))
          (set r (+ r 1))))
    (return ok)))

(deftest test-no-truncation-of-a-fixture-faults
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^Cells out (new-cells)
        ^Cells cut (new-cells)]
    (comment "Every byte of the two small files, and the whole of each: the")
    (comment "full file opens, anything cut before its xref does not.")
    (assert-eq (dt-truncations (test-file "pdf/minimal.pdf") 1 ar dc a b st pg out cut) 8 "minimal: the whole file, and the seven cuts inside its last line (`%%EOF`)")
    (assert-that (>= (dt-truncations (test-file "pdf/xrefstream.pdf") 1 ar dc a b st pg out cut) 1) "xref stream file")
    (assert-that (>= (dt-truncations (test-file "pdf/hybrid.pdf") 1 ar dc a b st pg out cut) 1) "hybrid file")
    (assert-that (>= (dt-truncations (test-file "pdf/incremental.pdf") 1 ar dc a b st pg out cut) 1) "incremental file")
    (assert-that (>= (dt-truncations (test-file "pdf/filters.pdf") 1 ar dc a b st pg out cut) 1) "filters file")))

(deftest test-no-corruption-of-a-fixture-faults
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells pg (new-cells)
        ^Cells out (new-cells)
        ^Cells cut (new-cells)
        ^Cells rng (new-cells)]
    (assert-that (>= (dt-corruptions (test-file "pdf/minimal.pdf") 400 3 1 ar dc a b st pg out cut rng) 0) "minimal")
    (assert-that (>= (dt-corruptions (test-file "pdf/xrefstream.pdf") 400 3 2 ar dc a b st pg out cut rng) 0) "xref stream")
    (assert-that (>= (dt-corruptions (test-file "pdf/hybrid.pdf") 400 3 3 ar dc a b st pg out cut rng) 0) "hybrid")
    (assert-that (>= (dt-corruptions (test-file "pdf/incremental.pdf") 400 3 4 ar dc a b st pg out cut rng) 0) "incremental")
    (assert-that (>= (dt-corruptions (test-file "pdf/filters.pdf") 400 3 5 ar dc a b st pg out cut rng) 0) "filters")
    (assert-that (>= (dt-corruptions (test-file "pdf/inherit.pdf") 400 3 6 ar dc a b st pg out cut rng) 0) "inherit")))
