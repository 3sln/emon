;; RASTER INTAKE: an image input becomes pages, and the pages are read by OCR (P6.1, P6.5; SPEC 2.0, 7.2, 7.3, 9.1; D058, D074,
;; D075, D089, D187-D190, D211-D215). emon's own module (D039).
;;
;; kin ONLY SNIFFS (D058). `rs-sniff` reads the first eight bytes of a `Src` and says PNG, JPEG, TIFF or none; it
;; decodes nothing. Decoding is the host's `ImageDecode` port, and kin reaches it the way it reaches every
;; expensive port (SPEC 7.3): a `decode` request, a unit status of `us-requests`, a re-run on the answers. Frame
;; `f` of the input is request id `f + 1` (ids are kin's and derived from what is asked, D089), so a replay finds
;; every answer by the whole record.
;;
;; THE UNIT, in at most three rounds (all under `max-rounds`):
;;   1. ask for frame 0. Its answer names the frame count.
;;   2. ask for every other frame, all at once (the host may take them in any order), and OCR of frame 0.
;;   3. OCR of every other frame, all at once.
;;   then build the page table, one `image` page per frame in frame order, and the OCR evidence and lines of each page (`emon.scan`).
;; The OCR request of frame `f` has id `frames + f + 1`: derived from what is asked, as ever. With `info` set the requests are
;; header-only (frame < 0, D187) and there is no OCR: stage 0's `intake` must not decode pixels. With `policy` 0 (`never`,
;; D038) there is none either; `auto` and `always` both OCR an image, which has no text layer to prefer. A frame whose OCR
;; the host cannot do (`unsupported`: no Ocr port) or failed has a page and no text, as before OCR existed.
;;
;; PAGE GEOMETRY. A frame of `w x h` pixels at `dpi100` (dots per inch x 100) is `w * 720000 / dpi100`
;; centipoints wide (SPEC 3.4). A frame that states no resolution is read AS 300 DPI and the document is flagged
;; `dpi-unknown`: SPEC 3.4 wants the resolution estimated from the text size; that estimate is not made (D215), the
;; 300 is the engine's own default, and the pixel size is kept in the page table either way (D187). The OCR request
;; carries the resolution it read the frame at as a hint (D211).
(ns emon.rasterin
  (:require [emon.lang :refer [I32 I64 Cells Src BitmapSet i64 i32 add64 mul64]]
            [emon.port :refer [cells-len cells-at cells-set cells-drop cells-push limit-of limit-breach]]
            [emon.pdfsrc :refer [ps-len ps-u8]]
            [emon.plan :refer [rq-decode an-find an-status an-arg flt-none ps-ok ps-unsupported ps-limit
                               us-requests pu-id pi-decode]]
            [emon.model :refer [page-new page-set-resolution pk-image node-set-flags node-set-attr-int
                                node-set-attr-text text-append-cp fk-format fk-pages fl-dpi-unknown]]
            [emon.pageunit :refer [pu-scan-core]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))


;; The formats `rs-sniff` answers. Codes are never reused (D050).
(defn ^:pub ^I32 rs-none [] (return 0))
(defn ^:pub ^I32 rs-png [] (return 1))
(defn ^:pub ^I32 rs-jpeg [] (return 2))
(defn ^:pub ^I32 rs-tiff [] (return 3))

;; The unit's own failure statuses (the PDF unit's are 1..10, D075).
(defn ^:pub ^I32 rs-undecodable [] (return 21))
(defn ^:pub ^I32 rs-unsupported [] (return 22))

;; The resolution assumed for a frame that states none.
(defn ^:pub ^I32 rs-default-dpi100 [] (return 30000))

(defn ^:pub ^I32 rs-sniff [^Src src]
  (comment "The format by signature at offset 0, never by name: PNG (the eight-byte signature), JPEG (FF D8 FF),")
  (comment "TIFF (II*\\0 or MM\\0*; BigTIFF is not read). 0 when it is none of them, and then the input is the PDF")
  (comment "path's to refuse or read. The host's `sniff` reads the same bytes the same way.")
  (let [^I32 n (ps-len src)]
    (if (< n 4) (return (rs-none)))
    (let [^I32 a (ps-u8 src 0)
          ^I32 b (ps-u8 src 1)
          ^I32 c (ps-u8 src 2)
          ^I32 d (ps-u8 src 3)]
      (if (and (>= n 8) (and (== a 137) (and (== b 80) (and (== c 78) (== d 71)))))
        (if (and (== (ps-u8 src 4) 13) (and (== (ps-u8 src 5) 10) (and (== (ps-u8 src 6) 26) (== (ps-u8 src 7) 10))))
          (return (rs-png))))
      (if (and (== a 255) (and (== b 216) (== c 255))) (return (rs-jpeg)))
      (if (and (== a 73) (and (== b 73) (and (== c 42) (== d 0)))) (return (rs-tiff)))
      (if (and (== a 77) (and (== b 77) (and (== c 0) (== d 42)))) (return (rs-tiff)))
      (return (rs-none)))))

(defn ^I32 rs-frame-arg [^I32 info ^I32 f]
  (comment "The `frame` field of the request for frame `f`: itself, or `-f - 1` for a header-only request.")
  (if (== info 1) (return (- (- 0 f) 1)))
  (return f))

(defn ^I32 rs-fail [^Cells ans ^I32 a]
  (comment "The unit's answer to a decode that did not succeed. A limit is a breach, and never returns.")
  (let [^I32 s (an-status ans a)]
    (if (== s (ps-limit))
      (limit-breach 9 (an-arg ans a 0)))
    (if (== s (ps-unsupported)) (return (rs-unsupported)))
    (return (rs-undecodable))))

(defn ^:pub ^I32 rs-cpt [^I32 px ^I32 dpi100]
  (comment "`px` pixels at `dpi100` (dots per inch x 100) in centipoints, rounded; at least 1, and held under 2e9.")
  (let [^I64 v (quot (add64 (mul64 (i64 px) (i64 720000)) (i64 (quot dpi100 2))) (i64 dpi100))]
    (if (> v (i64 2000000000)) (return 2000000000))
    (if (< v (i64 1)) (return 1))
    (return (i32 v))))

(defn ^I32 rs-format-name [^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells text ^I32 fmt]
  (comment "The root's `format` attribute: \"png\", \"jpeg\" or \"tiff\".")
  (let [^I32 start (cells-len text)]
    (if (== fmt (rs-png))
      (do (text-append-cp text 112) (text-append-cp text 110) (text-append-cp text 103)))
    (if (== fmt (rs-jpeg))
      (do (text-append-cp text 106) (text-append-cp text 112) (text-append-cp text 101) (text-append-cp text 103)))
    (if (== fmt (rs-tiff))
      (do (text-append-cp text 116) (text-append-cp text 105) (text-append-cp text 102) (text-append-cp text 102)))
    (node-set-attr-text nodes attrs 0 (fk-format) start (- (cells-len text) start))
    (return 0)))


(defn ^I32 rs-eff-dpi100 [^I32 dpi100]
  (comment "The resolution a frame is read at: its own, or 300 dpi when it states none.")
  (if (<= dpi100 0) (return (rs-default-dpi100)))
  (return dpi100))

(defn ^:pub ^I32 rs-ocr-id [^I32 frames ^I32 f]
  (comment "The request id of the OCR of frame `f` of a `frames`-frame input: after every decode's.")
  (return (+ (+ frames f) 1)))

(defn ^I32 rs-want-ocr [^I32 info ^I32 policy]
  (comment "1 when this attempt asks for OCR: not a header-only intake, and the policy is not `never`.")
  (if (== info 1) (return 0))
  (if (== policy 0) (return 0))
  (return 1))

(defn ^:pub ^I32 rs-doc [^Src src ^I32 input ^I32 fmt ^Cells ans ^:mut ^Cells rq
                          ^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells text ^:mut ^Cells pages
                          ^:mut ^Cells mask]
  (comment "THE DOCUMENT PASS of a raster input (P7.U): stage 0, HEADER ONLY (D187). Round 1 asks for frame 0's header (id 1),")
  (comment "round 2 for every other frame's (ids `f + 1`); then the root's `format` and `pages`, and one `image` page row per frame")
  (comment "in frame order, from the sizes and resolutions the headers answered. `mask` gets one 0 cell a page. No pixel is")
  (comment "decoded and no OCR is asked here: that is each frame's own page unit, `rs-page`. Answers `us-requests`, a failure")
  (comment "status, or 0.")
  (let [^I32 nbytes (ps-len src)
        ^I32 a0 (an-find ans 1)]
    (if (< a0 0)
      (do (rq-decode rq 1 input 0 nbytes (flt-none) (rs-frame-arg 1 0))
          (return (us-requests))))
    (if (!= (an-status ans a0) (ps-ok)) (return (rs-fail ans a0)))
    (let [^I32 frames (an-arg ans a0 5)
          ^:mut ^I32 f 1
          ^:mut ^I32 asked 0]
      (if (< frames 1) (return (rs-undecodable)))
      (if (> frames (limit-of 8)) (limit-breach 8 frames))
      (while (< f frames)
        (do (if (< (an-find ans (+ f 1)) 0)
              (do (rq-decode rq (+ f 1) input 0 nbytes (flt-none) (rs-frame-arg 1 f))
                  (set asked 1)))
            (set f (+ f 1))))
      (if (== asked 1) (return (us-requests)))
      (rs-format-name nodes attrs text fmt)
      (node-set-attr-int nodes attrs 0 (fk-pages) frames)
      (cells-drop mask 0)
      (set f 0)
      (while (< f frames)
        (do (let [^I32 a (an-find ans (+ f 1))]
              (if (!= (an-status ans a) (ps-ok)) (return (rs-fail ans a)))
              (let [^I32 w (an-arg ans a 0)
                    ^I32 h (an-arg ans a 1)
                    ^I32 dpi100 (an-arg ans a 3)
                    ^:mut ^I32 eff dpi100]
                (if (<= w 0) (return (rs-undecodable)))
                (if (<= h 0) (return (rs-undecodable)))
                (if (<= dpi100 0)
                  (do (set eff (rs-default-dpi100))
                      (node-set-flags nodes 0 (fl-dpi-unknown))))
                (let [^I32 p (page-new pages (+ f 1) (rs-cpt w eff) (rs-cpt h eff) 0 (pk-image))]
                  (page-set-resolution pages p (quot (+ dpi100 50) 100) w h))))
            (cells-push mask 0)
            (set f (+ f 1))))
      (return 0))))

(defn ^:pub ^I32 rs-page [^I32 f ^I32 input ^I32 nbytes ^I32 policy ^I32 fuse ^Cells ans ^:mut ^Cells rq ^Cells loc
                          ^BitmapSet bms ^:mut ^Cells mask ^:mut ^Cells scr
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells refs ^:mut ^Cells tlines ^:mut ^Cells cg
                          ^:mut ^Cells inks ^:mut ^Cells comps ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tpts
                          ^:mut ^Cells ws ^:mut ^Cells sv ^:mut ^Cells aux ^:mut ^Cells snap ^:mut ^Cells rtp
                          ^:mut ^Cells rn ^:mut ^Cells ri ^:mut ^Cells cs ^:mut ^Cells vr ^:mut ^Cells pc ^:mut ^Cells sg ^:mut ^Cells mem
                          ^:mut ^Cells s1 ^:mut ^Cells s2 ^:mut ^Cells s3 ^:mut ^Cells s4 ^:mut ^Cells s5 ^:mut ^Cells s6 ^:mut ^Cells ofz ^:mut ^Cells oaz]
  (comment "`fuse` is the page unit's flags (`emon.pageunit`'s `pu-px` and `pu-dry`: bit 2 the hidden setting `no-retarget`, bit 4 a DRY attempt, P10.2: it stops")
  (comment "before the write, having asked what the rounds up to there ask).")
  (comment "The unit of frame `f` (0-based) of a raster input: its pixels (`decode` id `pi-decode`, a whole image file, whose")
  (comment "failure is the conversion's: an image that cannot be read is refused by name, whatever the policy), then, unless")
  (comment "`policy` is 0 (never), the scan's page unit (`pu-scan-core`, D564): OCR of the bitmap (id `pi-ocr`), the ink layers of the bitmap and the targeted")
  (comment "passes the first pass calls for (a page fed sideways or upside down is read from its turned view, a small raster from an enlarged one); where the answers")
  (comment "are in, the frame's evidence and lines are appended to `words` and `lines` and `mask[f]` is 1. An image runs the scan seal and signature stages (its document")
  (comment "unit writes their candidates). Answers `us-requests`, a failure status, or 0. It writes nothing until every answer it asked for is in.")
  (let [^I32 did (pu-id f (pi-decode))
        ^I32 ad (an-find ans did)]
    (if (< ad 0)
      (do (rq-decode rq did input 0 nbytes (flt-none) f)
          (return (us-requests))))
    (if (!= (an-status ans ad) (ps-ok)) (return (rs-fail ans ad)))
    (if (== policy 0) (return 0))
    (let [^I32 eff (rs-eff-dpi100 (an-arg ans ad 3))
          ^I32 wc (rs-cpt (an-arg ans ad 0) eff)
          ^I32 hc (rs-cpt (an-arg ans ad 1) eff)]
      (return (pu-scan-core f input fuse did ad eff 0 0 0 wc hc wc hc 1 1
                            ans rq loc bms mask scr epages views etext feats images oruns oblocks olines owords osyms oalts words lines refs tlines cg
                            inks comps rules prims tpts ws sv aux snap rtp rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6 ofz oaz)))))
