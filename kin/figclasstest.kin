;; Laws for the figures (P8.1; SPEC 10.6, D020), on every target.
;;
;;   THE KINDS from geometry and ink: axes with ticks and bars are a chart; boxes with words in them and an arrow are a diagram; a lone
;;   shaded fill is a photograph; a small coloured drawing at the head of the page is a logo and in the middle of it is not; a raster
;;   is told by the bits it needed a pixel and its shape (photograph, barcode, code, screenshot, logo, illustration).
;;   WHAT IS NO FIGURE: lines of prose in a region, rings drawn one in another (a seal).
;;   THE PLACEHOLDER: a short paragraph on a figure is its label and not body text, a long one stays; a figure with a caption goes in
;;   just before it, whatever its top edge says (a column of text between).
(ns emon.figclasstest
  (:require [emon.lang :refer [I32 Blob Cells Text]]
            [emon.test :refer [deftest assert-eq assert-that assert-text new-text new-cells test-t TestT text-blob]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop blob-len text-cp]]
            [emon.model :refer [model-init node-new node-set-text node-add-region node-set-aux node-count node-kind node-parent node-attr node-text-len node-first-child
                                node-add-attr-text node-sub node-conf ledger-count ledger-reason dr-figure-unmeasured page-new pk-vector text-append-utf8 text-append-cp attr-value attr-len attr-next text-at
                                nk-table nk-cell nk-heading nk-figure nk-paragraph nk-caption nk-document fg-chart fg-diagram fg-photo fg-logo fg-screenshot fg-qr
                                fg-barcode fg-illustration fg-unknown fk-label fk-number fk-labels fk-image]]
            [emon.figclass :refer [fc-panel-row fc-emit-budget fc-write fc-measure fc-vector-kind fc-image-kind fc-reject fc-sign-rows fc-recur fc-stage]]
            [emon.glayer :refer [grg-new grg-set rk-figure]]
            [emon.restruct :refer [rs-figures]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

;; ------------------------------------------------------------------------------------------------ scenes

(defn ^I32 ft-path [^:mut ^Cells pa ^I32 page ^I32 kind ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 fill ^I32 stroke ^I32 flags]
  (comment "A row of `paths` (stride 24): kind 1 line, 2 rect, 3 curve, 4 other; flags 8 filled, 16 stroked, 1 closed, 64 pattern.")
  (let [^:mut ^I32 k 0]
    (cells-push pa page)
    (cells-push pa kind)
    (cells-push pa x0)
    (cells-push pa y0)
    (cells-push pa x1)
    (cells-push pa y1)
    (cells-push pa fill)
    (cells-push pa stroke)
    (cells-push pa 75)
    (cells-push pa 1000)
    (cells-push pa 1000)
    (cells-push pa flags)
    (set k 12)
    (while (< k 24)
      (do (cells-push pa 0)
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 ft-ws [^:mut ^Cells ws]
  (let [^:mut ^I32 i 0]
    (while (< i 728)
      (do (cells-push ws 0)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 ft-word [^:mut ^Cells fw ^:mut ^Cells et ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 cp0 ^I32 cp1]
  (comment "A word of two code points: a row of `words` (stride 24: page, box, text run at 11 and 12).")
  (let [^:mut ^I32 k 5
        ^I32 at (cells-len et)]
    (cells-push et cp0)
    (cells-push et cp1)
    (cells-push fw page)
    (cells-push fw x0)
    (cells-push fw y0)
    (cells-push fw x1)
    (cells-push fw y1)
    (while (< k 11)
      (do (cells-push fw 0)
          (set k (+ k 1))))
    (cells-push fw at)
    (cells-push fw 2)
    (set k 13)
    (while (< k 24)
      (do (cells-push fw 0)
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 ft-line [^:mut ^Cells fl ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 words]
  (comment "A row of `lines` (stride 16: page, box, first word at 11, count of words at 12).")
  (let [^:mut ^I32 k 5]
    (cells-push fl page)
    (cells-push fl x0)
    (cells-push fl y0)
    (cells-push fl x1)
    (cells-push fl y1)
    (while (< k 11)
      (do (cells-push fl 0)
          (set k (+ k 1))))
    (cells-push fl 0)
    (cells-push fl words)
    (cells-push fl 0)
    (cells-push fl 0)
    (cells-push fl 0)
    (return 0)))

(defn ^I32 ft-kind [^Cells pa ^Cells fw ^Cells fl ^Cells et ^:mut ^Cells ws ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 pageh]
  (comment "Measure the region of page 1 and answer the packed kind and confidence (kind * 1024 + confidence); 0 when it is no figure.")
  (let [^Cells grl (new-cells)]
    (cells-drop ws 0)
    (ft-ws ws)
    (fc-measure pa grl fw fl et 1 x0 y0 x1 y1 ws)
    (if (== (fc-reject ws) 1) (return 0))
    (return (fc-vector-kind ws x0 y0 x1 y1 pageh 0))))

;; ------------------------------------------------------------------------------------------------ the kinds

(deftest test-axes-with-ticks-and-bars-are-a-chart
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)
        ^:mut ^I32 pk 0]
    (comment "the vertical axis, the horizontal axis, three ticks on the vertical, three bars on one baseline of different heights")
    (ft-path pa 1 1 10162 15712 10238 28538 -1 0 16)
    (ft-path pa 1 1 10162 28462 37988 28538 -1 0 16)
    (ft-path pa 1 1 9862 28462 10238 28538 -1 0 16)
    (ft-path pa 1 1 9862 22000 10238 22076 -1 0 16)
    (ft-path pa 1 1 9862 16000 10238 16076 -1 0 16)
    (ft-path pa 1 2 10800 21750 16313 28500 3894949 -1 8)
    (ft-path pa 1 2 17363 18375 22875 28500 3894949 -1 8)
    (ft-path pa 1 2 23925 20063 29438 28500 3894949 -1 8)
    (set pk (ft-kind pa fw fl et ws 9800 15700 38000 28600 79200))
    (assert-eq (cells-at ws 3) 1 "the two long rules meet: axes")
    (assert-that (>= (cells-at ws 4) 3) "three short rules across the axis: ticks")
    (assert-eq (cells-at ws 5) 3 "three bars on one baseline")
    (assert-eq (quot pk 1024) (fg-chart) "a chart")
    (assert-that (>= (rem pk 1024) 700) "and a sure one: axes, ticks and bars")))

(deftest test-a-page-header-with-rules-and-numbers-is-not-a-chart
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)
        ^:mut ^I32 pk 0]
    (comment "P11.x2 (the W-9's banner): a rule across the foot of a band and one rule up from it meet (axes), two numbers (a form")
    (comment "number and a year) lie in it, and so does a sentence: no ticks, bars or series. A chart's text is its labels; a")
    (comment "line of five words or more makes it a banner.")
    (ft-path pa 1 1 10000 15000 50000 15080 -1 0 16)
    (ft-path pa 1 1 22000 10000 22080 15000 -1 0 16)
    (ft-word fw et 1 11000 10500 13000 11500 50 48)
    (ft-word fw et 1 14000 10500 16000 11500 50 52)
    (ft-line fl 1 23000 12000 49000 13000 9)
    (set pk (ft-kind pa fw fl et ws 9800 9800 50200 15200 79200))
    (assert-eq (cells-at ws 3) 1 "the two long rules meet: axes")
    (assert-eq (cells-at ws 19) 1 "a sentence in it")
    (assert-that (!= (quot pk 1024) (fg-chart)) "a banner is not a chart")
    (comment "the same rules and numbers with no sentence are the minimal chart they always were")
    (cells-drop fl 0)
    (cells-drop ws 0)
    (set pk (ft-kind pa fw fl et ws 9800 9800 50200 15200 79200))
    (assert-eq (quot pk 1024) (fg-chart) "axes and numbers alone are a chart")
    (comment "and two rules and a sentence, no numbers (a signature box): not a chart either")
    (cells-drop fw 0)
    (cells-drop et 0)
    (ft-line fl 1 23000 12000 49000 13000 9)
    (cells-drop ws 0)
    (set pk (ft-kind pa fw fl et ws 9800 9800 50200 15200 79200))
    (assert-that (!= (quot pk 1024) (fg-chart)) "a framed sentence is not a chart")))

(deftest test-boxes-with-words-and-an-arrow-are-a-diagram-and-with-no-axes
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)
        ^:mut ^I32 pk 0]
    (ft-path pa 1 2 10000 30000 20000 34000 -1 0 16)
    (ft-path pa 1 2 25000 30000 35000 34000 -1 0 16)
    (ft-path pa 1 1 20000 31960 25000 32040 -1 0 16)
    (ft-path pa 1 4 24400 31700 25000 32300 0 -1 8)
    (ft-word fw et 1 12000 31000 15000 32000 67 108)
    (ft-word fw et 1 28000 31000 31000 32000 83 118)
    (set pk (ft-kind pa fw fl et ws 9800 29800 35200 34200 79200))
    (assert-eq (cells-at ws 3) 0 "no axes")
    (assert-eq (cells-at ws 9) 2 "two boxes have a word in them")
    (assert-that (>= (cells-at ws 10) 2) "a rule and an arrow head join them")
    (assert-eq (quot pk 1024) (fg-diagram) "a diagram")))

(deftest test-a-lone-shaded-fill-is-a-photograph-and-nothing-else-is
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)]
    (ft-path pa 1 2 10000 10000 30000 20000 -1 -1 72)
    (assert-eq (quot (ft-kind pa fw fl et ws 10000 10000 30000 20000 79200) 1024) (fg-photo) "one pattern fill with no words: continuous tone")
    (ft-word fw et 1 12000 12000 14000 13000 65 66)
    (assert-that (!= (quot (ft-kind pa fw fl et ws 10000 10000 30000 20000 79200) 1024) (fg-photo)) "a word in it is not a photograph")))

(deftest test-a-small-coloured-drawing-at-the-head-of-the-page-is-a-logo-and-in-the-middle-is-not
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)
        ^Cells pb (new-cells)]
    (ft-path pa 1 3 7300 7300 10300 10300 43639 -1 9)
    (ft-path pa 1 2 8500 8500 9100 9100 16777215 -1 8)
    (assert-eq (quot (ft-kind pa fw fl et ws 7300 7300 10300 10300 79200) 1024) (fg-logo) "in the header band")
    (ft-path pb 1 3 7300 40000 10300 43000 43639 -1 9)
    (ft-path pb 1 2 8500 41200 9100 41800 16777215 -1 8)
    (assert-eq (quot (ft-kind pb fw fl et ws 7300 40000 10300 43000 79200) 1024) (fg-unknown) "the same drawing mid-page is unknown, and no figure without a caption")))

(deftest test-rings-one-in-another-are-a-seal-and-prose-is-no-figure
  (let [^Cells pa (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells et (new-cells)
        ^Cells ws (new-cells)
        ^Cells grl (new-cells)]
    (ft-path pa 1 3 10000 10000 22000 22000 -1 2000000 17)
    (ft-path pa 1 3 11500 11500 20500 20500 -1 2000000 17)
    (cells-drop ws 0)
    (ft-ws ws)
    (fc-measure pa grl fw fl et 1 10000 10000 22000 22000 ws)
    (assert-eq (fc-reject ws) 1 "two concentric rings: a seal")
    (comment "a box with prose in it")
    (cells-drop pa 0)
    (cells-drop ws 0)
    (ft-ws ws)
    (ft-path pa 1 2 10000 10000 30000 30000 15658734 5666423 24)
    (ft-line fl 1 11000 12000 29000 13000 9)
    (ft-line fl 1 11000 14000 29000 15000 8)
    (fc-measure pa grl fw fl et 1 10000 10000 30000 30000 ws)
    (assert-eq (cells-at ws 19) 2 "two lines of five words or more")
    (assert-eq (fc-reject ws) 1 "a sidebar is no figure")))

;; ------------------------------------------------------------------------------------------------ rasters

(defn ^I32 ft-fi [^:mut ^Cells fi ^I32 valid ^I32 codec ^I32 cls ^I32 ncomp ^I32 bpc ^I32 bpp ^I32 mkind]
  (cells-drop fi 0)
  (cells-push fi valid)
  (cells-push fi codec)
  (cells-push fi cls)
  (cells-push fi ncomp)
  (cells-push fi bpc)
  (cells-push fi 100)
  (cells-push fi 100)
  (cells-push fi bpp)
  (cells-push fi 0)
  (cells-push fi mkind)
  (cells-push fi 0)
  (cells-push fi 0)
  (return 0))

(deftest test-a-raster-is-a-photograph-a-code-a-screenshot-a-logo-or-line-art-by-its-bits-and-its-shape
  (let [^Cells fi (new-cells)]
    (ft-fi fi 1 7 2 3 8 300 0)
    (assert-eq (quot (fc-image-kind fi 0 20000 15000 20000 35000 79200 0) 1024) (fg-photo) "a JPEG that needed three bits a pixel")
    (assert-that (>= (rem (fc-image-kind fi 0 20000 15000 20000 35000 79200 0) 1024) 600) "a sure one")
    (ft-fi fi 1 0 2 3 8 60 0)
    (assert-eq (quot (fc-image-kind fi 0 30000 20000 20000 40000 79200 0) 1024) (fg-screenshot) "a large flat one")
    (assert-that (< (rem (fc-image-kind fi 0 30000 20000 20000 40000 79200 0) 1024) 500) "which is not sure enough for a figure with no caption")
    (assert-eq (quot (fc-image-kind fi 0 4000 4000 5000 9000 79200 0) 1024) (fg-logo) "a small flat one at the head of the page")
    (assert-eq (quot (fc-image-kind fi 0 4000 4000 30000 34000 79200 0) 1024) (fg-unknown) "and in the middle of it")
    (ft-fi fi 1 9 1 1 1 20 0)
    (assert-eq (quot (fc-image-kind fi 0 20000 5000 20000 25000 79200 0) 1024) (fg-barcode) "a two-colour one far wider than high")
    (assert-eq (quot (fc-image-kind fi 0 8000 8000 20000 28000 79200 0) 1024) (fg-qr) "a square two-colour one")
    (assert-eq (quot (fc-image-kind fi 0 12000 8000 20000 28000 79200 0) 1024) (fg-illustration) "any other two-colour one is line art")
    (assert-eq (quot (fc-image-kind fi 5 12000 8000 20000 28000 79200 0) 1024) (fg-unknown) "a placement with no row says nothing")))

;; ------------------------------------------------------------------------------------------------ the placeholder

(defn ^I32 ft-cand [^:mut ^Cells cand ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (let [^:mut ^I32 f 0]
    (cells-push cand page)
    (cells-push cand x0)
    (cells-push cand y0)
    (cells-push cand x1)
    (cells-push cand y1)
    (cells-push cand x0)
    (cells-push cand y0)
    (cells-push cand x1)
    (cells-push cand y1)
    (set f 9)
    (while (< f 32)
      (do (cells-push cand 0)
          (set f (+ f 1))))
    (return 0)))

(defn ^I32 ft-fd [^:mut ^Cells fd ^I32 kind ^I32 conf]
  (cells-push fd kind)
  (cells-push fd conf)
  (cells-push fd 16)
  (cells-push fd -1)
  (cells-push fd -1)
  (cells-push fd 0)
  (cells-push fd 0)
  (cells-push fd 0)
  (return 0))

(defn ^I32 ft-para [^:mut ^Cells nodes ^:mut ^Cells regions ^:mut ^Cells text ^I32 kind ^I32 nch ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "A node of `kind` with `nch` letters of text and one region on page 1.")
  (let [^I32 n (node-new nodes kind 0)
        ^I32 at (cells-len text)
        ^:mut ^I32 i 0]
    (while (< i nch)
      (do (text-append-cp text 97)
          (set i (+ i 1))))
    (node-set-text nodes n at nch)
    (node-add-region nodes regions n 1 x0 y0 x1 y1)
    (return n)))

(deftest test-a-figure-claims-the-text-inside-it-and-the-labels-in-a-chain-from-it
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells nn (new-cells)
        ^Cells na (new-cells)
        ^Cells nr (new-cells)
        ^Cells nm (new-cells)
        ^Cells cand (new-cells)
        ^Cells fg (new-cells)
        ^Cells fd (new-cells)
        ^Cells ab (new-cells)]
    (comment "D583 (smoke review B issue 7): a drawing is boxes and arrows, and its words are between and beside them. The figure's own region is 10000..40000 by 10000..30000. A label 10 pt right")
    (comment "of its edge is its (within 24 pt), and so is the one 15 pt right of THAT one, 35 pt from the figure, which the chain takes in; a paragraph of 100 characters and 30 pt tall INSIDE it is its text;")
    (comment "a short one far from it stays.")
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (ft-para nodes regions text (nk-paragraph) 3 41000 18000 42000 18750)
    (ft-para nodes regions text (nk-paragraph) 3 43500 18000 44500 18750)
    (ft-para nodes regions text (nk-paragraph) 100 12000 15000 30000 18000)
    (ft-para nodes regions text (nk-paragraph) 3 7200 60000 9000 60750)
    (ft-cand cand 1 10000 10000 40000 30000)
    (ft-fd fd (fg-diagram) 760)
    (cells-push fg 0)
    (cells-push fg 0)
    (rs-figures nodes attrs regions text nn na nr nm cand fg fd ab)
    (assert-eq (node-count nn) 3 "the document, the figure and the far paragraph: the other three are the figure's labels")
    (assert-eq (node-kind nn 1) (nk-figure) "the figure")
    (assert-eq (node-kind nn 2) (nk-paragraph) "and the paragraph that is not its")))

(deftest test-a-short-paragraph-on-a-figure-is-its-label-and-a-long-one-stays
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells nn (new-cells)
        ^Cells na (new-cells)
        ^Cells nr (new-cells)
        ^Cells nm (new-cells)
        ^Cells cand (new-cells)
        ^Cells fg (new-cells)
        ^Cells fd (new-cells)
        ^Cells ab (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (ft-para nodes regions text (nk-paragraph) 3 8000 12000 9600 12750)
    (ft-para nodes regions text (nk-paragraph) 60 7200 50000 54000 51250)
    (ft-para nodes regions text (nk-paragraph) 4 15000 31000 17000 31750)
    (ft-cand cand 1 10000 10000 40000 30000)
    (ft-fd fd (fg-chart) 760)
    (cells-push fg 0)
    (cells-push fg 0)
    (rs-figures nodes attrs regions text nn na nr nm cand fg fd ab)
    (assert-eq (node-count nn) 3 "the document, the figure and the long paragraph: the two short ones are labels")
    (assert-eq (node-kind nn 1) (nk-figure) "the figure goes in by its top edge (30000 is above the paragraph at 50000)")
    (assert-eq (node-sub nn 1) (fg-chart) "its kind")
    (assert-eq (node-conf nn 1) 760 "its confidence")
    (assert-that (>= (node-attr nn na 1 (fk-labels)) 0) "it has labels")
    (assert-eq (node-kind nn 2) (nk-paragraph) "the long paragraph is still body text")))

(deftest test-a-figure-goes-in-before-its-caption-whatever-its-top-edge-says
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells nn (new-cells)
        ^Cells na (new-cells)
        ^Cells nr (new-cells)
        ^Cells nm (new-cells)
        ^Cells cand (new-cells)
        ^Cells fg (new-cells)
        ^Cells fd (new-cells)
        ^Cells ab (new-cells)
        ^:mut ^I32 c 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (comment "document > paragraph (top), paragraph (far below: the other column), caption (just under the figure)")
    (ft-para nodes regions text (nk-paragraph) 60 7200 5000 54000 6250)
    (ft-para nodes regions text (nk-paragraph) 60 7200 40000 54000 41250)
    (set c (ft-para nodes regions text (nk-caption) 20 10000 31000 30000 32000))
    (node-set-aux nodes c 1)
    (ft-cand cand 1 10000 10000 30000 30000)
    (ft-fd fd (fg-chart) 760)
    (cells-push fg 0)
    (cells-push fg 0)
    (rs-figures nodes attrs regions text nn na nr nm cand fg fd ab)
    (assert-eq (node-count nn) 5 "the document, three blocks and the figure")
    (assert-eq (node-kind nn 3) (nk-figure) "the figure is just before its caption, after the paragraph that is lower on the page")
    (assert-eq (node-kind nn 4) (nk-caption) "and the caption follows it")))

;; ------------------------------------------------------------------------------------------------ the tables' (D557)

(defn ^I32 ft-held-line [^:mut ^Cells fl ^I32 y0 ^I32 held]
  (comment "A line of the text layer at x 12000..20000, 600 tall from y0, on page 1; `held` 1 when a table has claimed it (cell 15 is TB_HELD + 0).")
  (let [^I32 r (quot (cells-len fl) 16)]
    (ft-line fl 1 12000 y0 20000 (+ y0 600) 1)
    (if (== held 1) (cells-set fl (+ (* r 16) 15) 1073741824))
    (return 0)))

(defn ^I32 ft-figures [^I32 held ^I32 free]
  (comment "The figures stage over a page that has a region the graphics layer calls a figure (10000 10000 30000 30000, no paths, no images) with a")
  (comment "caption just under it and `held` lines of the text layer in it that a table has claimed and `free` that it has not. Answers how many figures.")
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells) ^Cells pages (new-cells)
        ^Cells ledger (new-cells) ^Cells layout (new-cells) ^Cells grg (new-cells)
        ^Cells fnodes (new-cells) ^Cells fattrs (new-cells) ^Cells fregions (new-cells) ^Cells fnm (new-cells)
        ^Cells pa (new-cells) ^Cells im (new-cells) ^Cells fi (new-cells) ^Cells grl (new-cells)
        ^Cells fw (new-cells) ^Cells fl (new-cells) ^Cells et (new-cells) ^Cells pg (new-cells) ^Cells sl (new-cells)
        ^Cells cand (new-cells) ^Cells fcand (new-cells) ^Cells cl (new-cells) ^Cells fg (new-cells) ^Cells fd (new-cells)
        ^Cells ab (new-cells) ^Cells ws (new-cells)
        ^:mut ^I32 c 0
        ^:mut ^I32 i 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (grg-new grg 1 10000 10000 30000 30000 (rk-figure))
    (set c (ft-para nodes regions text (nk-caption) 20 10000 30500 30000 31500))
    (node-set-aux nodes c 1)
    (while (< i held)
      (do (ft-held-line fl (+ 11000 (* 1500 i)) 1)
          (set i (+ i 1))))
    (set i 0)
    (while (< i free)
      (do (ft-held-line fl (+ 21000 (* 1500 i)) 0)
          (set i (+ i 1))))
    (return (fc-stage nodes attrs regions text pages fnodes fattrs fregions fnm pa im fi grg grl fw fl et pg sl cand 0 fcand cl fg fd ab ws))))

(deftest test-a-region-whose-text-a-table-has-claimed-is-no-figure
  (comment "A region the graphics layer calls a figure, with a caption just under it, is a figure; so is one with a few lines of text that no table holds.")
  (assert-eq (ft-figures 0 0) 1 "with no text in it the region is a figure")
  (assert-eq (ft-figures 0 3) 1 "with three lines no table holds it is a figure")
  (comment "The shaded header cell with its words and the rule under it (D556): the table the lines went to, the drawing is its own.")
  (assert-eq (ft-figures 3 1) 0 "three lines of four are a table's: no figure")
  (assert-eq (ft-figures 2 2) 0 "half of them are a table's: no figure")
  (assert-eq (ft-figures 1 3) 1 "one of four is a table's: the region is still a figure"))

;; ------------------------------------------------------------------------------------------------ recurrence (P8.4)

(defn ^I32 ft-fi-add [^:mut ^Cells fi ^I32 w ^I32 h ^I32 d1 ^I32 d2]
  (comment "A row of `fi` for a flat raster of w x h pixels whose stream has the digest d1 d2 (stride 12).")
  (cells-push fi 1)
  (cells-push fi 0)
  (cells-push fi 2)
  (cells-push fi 3)
  (cells-push fi 8)
  (cells-push fi w)
  (cells-push fi h)
  (cells-push fi 60)
  (cells-push fi 0)
  (cells-push fi 0)
  (cells-push fi d1)
  (cells-push fi d2)
  (return 0))

(defn ^I32 ft-img-cand [^:mut ^Cells cand ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 obj ^I32 fir]
  (comment "A candidate row that is an image placement: its object, and its row of `fi` (cells 25, 27 and 28).")
  (let [^I32 r (quot (cells-len cand) 32)]
    (ft-cand cand page x0 y0 x1 y1)
    (cells-set cand (+ (* r 32) 25) obj)
    (cells-set cand (+ (* r 32) 27) -1)
    (cells-set cand (+ (* r 32) 28) fir)
    (return r)))

(defn ^I32 ft-vec-cand [^:mut ^Cells cand ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "A candidate row that is a vector region (cell 27 is -2).")
  (let [^I32 r (quot (cells-len cand) 32)]
    (ft-cand cand page x0 y0 x1 y1)
    (cells-set cand (+ (* r 32) 27) -2)
    (return r)))

(defn ^I32 ft-pages [^:mut ^Cells pages ^I32 n]
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^:mut ^I32 i 1]
    (model-init nodes attrs regions text pages ledger layout)
    (while (<= i n)
      (do (page-new pages i 61200 79200 0 (pk-vector))
          (set i (+ i 1))))
    (return 0)))

(deftest test-a-raster-on-other-pages-is-a-recurring-logo-by-its-object-or-its-digest
  (let [^Cells fi (new-cells)
        ^Cells counts (new-cells)
        ^Cells pa (new-cells)
        ^Cells pages (new-cells)
        ^Cells cand (new-cells)]
    (ft-pages pages 4)
    (comment "fi rows: 0 and 1 are one raster (digest 5 6, 40 x 20), 2 is another size with the same digest, 3 another digest")
    (ft-fi-add fi 40 20 5 6)
    (ft-fi-add fi 40 20 5 6)
    (ft-fi-add fi 40 21 5 6)
    (ft-fi-add fi 40 20 9 9)
    (comment "page 1 object 7, page 2 object 8 (the same bytes), page 3 object 7 again, page 4 a different raster, page 1 object 7 a second time")
    (ft-img-cand cand 1 5000 5000 9000 7000 7 0)
    (ft-img-cand cand 2 30000 40000 34000 42000 8 1)
    (ft-img-cand cand 3 5000 5000 9000 7000 7 0)
    (ft-img-cand cand 4 5000 5000 9000 7000 11 3)
    (ft-img-cand cand 1 20000 5000 24000 7000 7 0)
    (fc-sign-rows fi pa cand counts)
    (assert-eq (fc-recur cand pages 1) 160 "the raster of page 2 is on two other pages (its digest equals the others', wherever it stands)")
    (assert-eq (fc-recur cand pages 0) 160 "the one of page 1: pages 2 (digest) and 3 (object); its second use on page 1 does not count")
    (assert-eq (fc-recur cand pages 3) 0 "a raster with another digest and object recurs nowhere")
    (comment "the same digest with another pixel size is another raster")
    (ft-img-cand cand 3 5000 5000 9000 7000 12 2)
    (fc-sign-rows fi pa cand counts)
    (assert-eq (fc-recur cand pages 5) 0 "the same digest of another size is no recurrence")
    (assert-eq (fc-recur cand pages 3) 0 "and it is not on the others' count")))

(deftest test-vector-art-recurs-at-the-same-place-whatever-its-scale
  (let [^Cells fi (new-cells)
        ^Cells counts (new-cells)
        ^Cells pa (new-cells)
        ^Cells pages (new-cells)
        ^Cells cand (new-cells)]
    (ft-pages pages 4)
    (comment "page 1: a round mark and a square in it, at the head of the page")
    (ft-path pa 1 3 7300 7300 10300 10300 43639 -1 9)
    (ft-path pa 1 2 8500 8500 9100 9100 16777215 -1 8)
    (ft-vec-cand cand 1 7300 7300 10300 10300)
    (comment "page 2: the same drawing at nine tenths of the size about the same centre")
    (ft-path pa 2 3 7450 7450 10150 10150 43639 -1 9)
    (ft-path pa 2 2 8590 8590 9010 9010 16777215 -1 8)
    (ft-vec-cand cand 2 7450 7450 10150 10150)
    (comment "page 3: the same drawing, same size, in the middle of the page")
    (ft-path pa 3 3 7300 40000 10300 43000 43639 -1 9)
    (ft-path pa 3 2 8500 41200 9100 41800 16777215 -1 8)
    (ft-vec-cand cand 3 7300 40000 10300 43000)
    (comment "page 4: twice the size, at the same place")
    (ft-path pa 4 3 7300 7300 13300 13300 43639 -1 9)
    (ft-path pa 4 2 9700 9700 10900 10900 16777215 -1 8)
    (ft-vec-cand cand 4 7300 7300 13300 13300)
    (fc-sign-rows fi pa cand counts)
    (assert-eq (fc-recur cand pages 0) 100 "page 1's mark recurs on page 2 only: page 3 is another place and page 4 another scale")
    (assert-eq (fc-recur cand pages 1) 100 "and page 2's on page 1")
    (assert-eq (fc-recur cand pages 2) 0 "the same drawing mid-page recurs nowhere")
    (assert-eq (fc-recur cand pages 3) 0 "nor does one of twice the size")))

(deftest test-a-recurring-raster-is-a-logo-wherever-it-stands-and-a-lone-one-is-not
  (let [^Cells fi (new-cells)]
    (ft-fi fi 1 0 2 3 8 60 0)
    (assert-eq (quot (fc-image-kind fi 0 4000 4000 30000 34000 79200 0) 1024) (fg-unknown) "a small flat raster mid-page, seen once")
    (assert-eq (quot (fc-image-kind fi 0 4000 4000 30000 34000 79200 100) 1024) (fg-logo) "the same on another page too: a logo")
    (assert-eq (rem (fc-image-kind fi 0 4000 4000 30000 34000 79200 220) 1024) 800 "and surer for each page it is on")))

(deftest test-measure-charges-only-the-page-prefix-visited
  (let [^Cells pa (new-cells) ^Cells fw (new-cells) ^Cells fl (new-cells)
        ^Cells et (new-cells) ^Cells grl (new-cells) ^Cells ws (new-cells)
        ^:mut ^I32 p 2]
    (ft-path pa 1 2 10000 10000 30000 20000 -1 -1 72)
    (ft-ws ws)
    (assert-eq (fc-measure pa grl fw fl et 1 10000 10000 30000 20000 ws) 0 "prefix measured")
    (assert-eq (cells-at ws 127) 1 "one indexed path visited")
    (while (<= p 16)
      (do (ft-path pa p 2 10000 10000 30000 20000 -1 -1 72)
          (set p (+ p 1))))
    (cells-set ws 127 0)
    (assert-eq (fc-measure pa grl fw fl et 1 10000 10000 30000 20000 ws) 0 "extended prefix measured")
    (assert-eq (cells-at ws 127) 1 "later pages cost no visits")
    (assert-eq (cells-at ws 20) 1 "same shaded fill decision")))

(deftest test-document-work-cap-refuses-before-visiting-and-clears-features
  (let [^Cells pa (new-cells) ^Cells fw (new-cells) ^Cells fl (new-cells)
        ^Cells et (new-cells) ^Cells grl (new-cells) ^Cells ws (new-cells)]
    (ft-path pa 1 2 10000 10000 30000 20000 -1 -1 72)
    (ft-ws ws)
    (cells-set ws 127 400000000)
    (cells-set ws 20 1)
    (assert-eq (fc-measure pa grl fw fl et 1 10000 10000 30000 20000 ws) 2 "explicit document resource refusal")
    (assert-eq (cells-at ws 127) 400000000 "no visits beyond cap")
    (assert-eq (cells-at ws 20) 0 "no previous candidate's features")))

(deftest test-page-work-cannot-starve-the-following-page
  (let [^Cells pa (new-cells) ^Cells fw (new-cells) ^Cells fl (new-cells)
        ^Cells et (new-cells) ^Cells grl (new-cells) ^Cells ws (new-cells)]
    (ft-path pa 1 2 10000 10000 30000 20000 -1 -1 72)
    (ft-path pa 2 2 10000 10000 30000 20000 -1 -1 72)
    (ft-ws ws)
    (cells-set ws 125 1)
    (cells-set ws 126 40000000)
    (assert-eq (fc-measure pa grl fw fl et 1 10000 10000 30000 20000 ws) 1 "page allowance exhausted")
    (assert-eq (fc-measure pa grl fw fl et 2 10000 10000 30000 20000 ws) 0 "next page has its own allowance")
    (assert-eq (cells-at ws 20) 1 "next page measured")))

(defn ^I32 ft-budget-pages [^TestT emon-t ^I32 n]
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells) ^Cells pages (new-cells)
        ^Cells ledger (new-cells) ^Cells layout (new-cells) ^Cells grg (new-cells)
        ^Cells fnodes (new-cells) ^Cells fattrs (new-cells) ^Cells fregions (new-cells) ^Cells fnm (new-cells)
        ^Cells pa (new-cells) ^Cells im (new-cells) ^Cells fi (new-cells) ^Cells grl (new-cells)
        ^Cells fw (new-cells) ^Cells fl (new-cells) ^Cells et (new-cells) ^Cells pg (new-cells) ^Cells sl (new-cells)
        ^Cells cand (new-cells) ^Cells fcand (new-cells) ^Cells cl (new-cells) ^Cells fg (new-cells) ^Cells fd (new-cells)
        ^Cells ab (new-cells) ^Cells ws (new-cells)
        ^:mut ^I32 p 1 ^:mut ^I32 i 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0 ^:mut ^I32 count 0]
    (model-init nodes attrs regions text pages ledger layout)
    (while (<= p n)
      (do (page-new pages p 500000 792000 0 (pk-vector))
          (set i 0)
          (while (< i 129)
            (do (set x (+ 1000 (* (rem i 20) 20000)))
                (set y (+ 1000 (* (quot i 20) 10000)))
                (ft-path pa p 2 x y (+ x 16000) (+ y 8000) -1 -1 72)
                (set i (+ i 1))))
          (set p (+ p 1))))
    (set count (fc-stage nodes attrs regions text pages fnodes fattrs fregions fnm pa im fi grg grl fw fl et pg sl cand 0 fcand cl fg fd ab ws))
    (assert-eq count (* n 128) "each page gets 128 measurements regardless of document length")
    (set i 0)
    (set count 0)
    (while (< i (quot (cells-len fd) 8))
      (do (if (== (cells-at fd (+ (* i 8) 5)) 3) (set count (+ count 1)))
          (set i (+ i 1))))
    (assert-eq count n "every over-limit region has explicit evidence")
    (fc-write fcand fd ledger)
    (assert-eq (ledger-count ledger) n "every unmeasured box reaches the dropped ledger")
    (assert-eq (ledger-reason ledger 0) (dr-figure-unmeasured) "the ledger names the resource refusal")
    (return count)))

(deftest test-page-candidate-prefix-invariance-at-one-four-and-sixteen
  (assert-eq (ft-budget-pages (test-t) 1) 1 "one page")
  (assert-eq (ft-budget-pages (test-t) 4) 4 "four pages")
  (assert-eq (ft-budget-pages (test-t) 16) 16 "sixteen pages"))


(deftest test-unmeasured-document-region-is-explicit-in-evidence-and-ledger
  (let [^Cells cand (new-cells) ^Cells fd (new-cells) ^Cells ledger (new-cells)
        ^Text t (new-text)]
    (ft-cand cand 1 10000 20000 30000 40000)
    (ft-fd fd 0 0)
    (cells-set fd 5 2)
    (cells-set cand 31 2)
    (assert-eq (fc-emit-budget cand fd t) 1 "one explicit resource record")
    (assert-text t ",\"fc-unmeasured\":[[1,10000,20000,30000,40000,2,2]]" "document refusals retain both statuses and the exact box")
    (fc-write cand fd ledger)
    (assert-eq (ledger-count ledger) 2 "measurement and signature refusal both represented")
    (assert-eq (ledger-reason ledger 0) (dr-figure-unmeasured) "unmeasured is distinct from measured rejection")))

(defn ^I32 ft-signature-prefix [^TestT emon-t ^I32 npages]
  (let [^Cells pa (new-cells) ^Cells cand (new-cells) ^Cells fi (new-cells) ^Cells counts (new-cells)
        ^:mut ^I32 p 1 ^:mut ^I32 r 0]
    (while (<= p npages)
      (do (ft-path pa p 3 7300 7300 10300 10300 43639 -1 9)
          (ft-path pa p 2 8500 8500 9100 9100 16777215 -1 8)
          (set p (+ p 1))))
    (while (< r 6300)
      (do (ft-vec-cand cand 1 7300 7300 10300 10300)
          (set r (+ r 1))))
    (fc-sign-rows fi pa cand counts)
    (assert-eq (cells-at cand (+ (* 6299 32) 13)) 2 "the last first-page signature survives appended pages")
    (assert-eq (cells-at cand (+ (* 6299 32) 14)) 2 "the unchanged drawing has two paths")
    (assert-eq (cells-at cand (+ (* 6299 32) 31)) 0 "appended pages spend no first-page resource allowance")
    (return 0)))

(deftest test-signature-budget-prefix-invariance-at-one-four-and-sixteen
  (ft-signature-prefix (test-t) 100)
  (ft-signature-prefix (test-t) 400)
  (ft-signature-prefix (test-t) 1600))

(deftest test-a-captioned-panel-group-owns-a-numbered-heading-as-its-caption
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells nn (new-cells) ^Cells na (new-cells) ^Cells nr (new-cells) ^Cells nm (new-cells)
        ^Cells cand (new-cells) ^Cells fg (new-cells) ^Cells fd (new-cells) ^Cells ab (new-cells)
        ^:mut ^I32 c 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (ft-para nodes regions text (nk-paragraph) 12 12000 12000 18000 13000)
    (set c (ft-para nodes regions text (nk-heading) 20 10000 32500 30000 33500))
    (node-add-attr-text nodes attrs c (fk-number) 0 9)
    (ft-cand cand 1 10000 10000 30000 30000)
    (cells-set cand 30 4)
    (ft-fd fd (fg-diagram) 700)
    (cells-push fg 0) (cells-push fg 0)
    (rs-figures nodes attrs regions text nn na nr nm cand fg fd ab)
    (assert-eq (node-count nn) 3 "the document, one figure with labels, and its caption")
    (assert-eq (node-kind nn 1) (nk-figure) "one diagram owner")
    (assert-that (>= (node-attr nn na 1 (fk-labels)) 0) "the diagram owns its labels")
    (assert-eq (node-kind nn 2) (nk-caption) "the numbered heading becomes the diagram caption")
    (assert-that (>= (node-attr nn na 2 (fk-label)) 0) "the caption keeps its figure number")
    (assert-eq (node-attr nn na 2 (fk-number)) -1 "heading-only number metadata is removed")))

(deftest test-an-existing-vector-region-and-its-panels-have-one-owner
  (let [^Cells cand (new-cells)]
    (ft-cand cand 1 9900 9900 31500 30100)
    (cells-set cand 27 -2)
    (assert-eq (fc-panel-row cand 1 10000 10000 30000 30000) 0 "the existing graphic owns the disconnected panels")
    (assert-eq (cells-len cand) 32 "one graphic candidate, never an overlapping second owner")
    (assert-eq (cells-at cand 30) 4 "the existing region becomes the captioned panel owner")
    (assert-eq (cells-at cand 7) 31500 "retain all of its original vector ink bounds")))

;; D761: the caption names the whole raster diagram before its shaded boxes claim tables.
(defn ^I32 ft-caption-word [^:mut ^Cells fw ^:mut ^Cells et ^Blob value ^I32 x ^I32 y]
  (let [^I32 at (cells-len et) ^:mut ^I32 f 0]
    (text-append-utf8 et value 0 (blob-len value))
    (while (< f 24) (do (cells-push fw 0) (set f (+ f 1))))
    (let [^I32 b (- (cells-len fw) 24)]
      (cells-set fw b 1) (cells-set fw (+ b 1) x) (cells-set fw (+ b 2) y)
      (cells-set fw (+ b 3) (+ x 3000)) (cells-set fw (+ b 4) (+ y 900))
      (cells-set fw (+ b 11) at) (cells-set fw (+ b 12) (- (cells-len et) at)))
    (return 0)))

(defn ^I32 ft-captioned-raster [^TestT emon-t ^I32 source ^I32 gap ^I32 hint]
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells) ^Cells pages (new-cells)
        ^Cells ledger (new-cells) ^Cells layout (new-cells) ^Cells grg (new-cells)
        ^Cells fnodes (new-cells) ^Cells fattrs (new-cells) ^Cells fregions (new-cells) ^Cells fnm (new-cells)
        ^Cells pa (new-cells) ^Cells im (new-cells) ^Cells fi (new-cells) ^Cells grl (new-cells)
        ^Cells fw (new-cells) ^Cells fl (new-cells) ^Cells et (new-cells) ^Cells pg (new-cells) ^Cells sl (new-cells)
        ^Cells cand (new-cells) ^Cells fcand (new-cells) ^Cells cl (new-cells) ^Cells fg (new-cells) ^Cells fd (new-cells)
        ^Cells ab (new-cells) ^Cells ws (new-cells)
        ^:mut ^I32 c 0 ^:mut ^I32 count 0 ^:mut ^I32 a 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (grg-new grg 1 10000 10000 40000 30000 (rk-figure))
    (grg-set grg 0 6 source)
    (if (== hint 1) (grg-new grg 1 12000 12000 35000 28000 1))
    (ft-line fl 1 12000 15000 30000 16000 5)
    (ft-line fl 1 12000 17000 30000 18000 5)
    (ft-caption-word fw et (text-blob "Figure") 10000 (+ 30000 gap))
    (ft-caption-word fw et (text-blob "1.1:") 13500 (+ 30000 gap))
    (ft-para nodes regions text (nk-paragraph) 7 15000 15000 19000 16000)
    (set c (ft-para nodes regions text (nk-caption) 20 10000 (+ 30000 gap) 40000 (+ 31000 gap)))
    (node-set-aux nodes c 1)
    (cells-set fw 36 0) ;; notes consumed the caption number before figures run
    (set count (fc-stage nodes attrs regions text pages fnodes fattrs fregions fnm pa im fi grg grl fw fl et pg sl cand 0 fcand cl fg fd ab ws))
    (if (and (== hint 1) (and (== source 16) (== gap 800)))
      (do (assert-eq count 1 "the captioned image has one figure owner")
          (assert-eq (node-count fnodes) 3 "the label leaves body flow; document, figure and caption survive")
          (assert-eq (node-kind fnodes 1) (nk-figure) "figure is before caption")
          (assert-eq (node-sub fnodes 1) (fg-diagram) "captioned flat diagram is a diagram")
          (set a (node-attr fnodes fattrs 1 (fk-labels)))
          (assert-that (>= a 0) "the figure owns the label value")
          (if (>= a 0)
            (do (assert-eq (attr-len fattrs a) 7 "the label value is complete")
                (assert-eq (text-at text (attr-value fattrs a)) 97 "the label value is copied verbatim")))
          (assert-eq (node-kind fnodes 2) (nk-caption) "caption remains available for binding")))
    (return count)))

(deftest test-captioned-image-role-precedes-shaded-box-tables
  (assert-eq (ft-captioned-raster (test-t) 16 800 1) 1 "numbered caption owns its raster diagram"))

(deftest test-a-caption-alone-does-not-reclassify-native-tables
  (assert-eq (ft-captioned-raster (test-t) 1 800 1) 0 "native rules keep their table claim")
  (assert-eq (ft-captioned-raster (test-t) 16 5000 1) 0 "a remote figure reference cannot claim the image"))

(deftest test-captioned-images-without-a-competing-grid-keep-their-role
  (assert-eq (ft-captioned-raster (test-t) 16 800 0) 0 "a caption alone does not force an existing photograph or chart into a diagram"))

(deftest test-a-captioned-diagram-owns-grid-values-without-refitting-them
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells nn (new-cells) ^Cells na (new-cells) ^Cells nr (new-cells) ^Cells nm (new-cells)
        ^Text values (new-text) ^Cells cand (new-cells) ^Cells fg (new-cells) ^Cells fd (new-cells) ^Cells ab (new-cells)
        ^:mut ^I32 table 0 ^:mut ^I32 cell 0 ^:mut ^I32 at 0 ^:mut ^I32 a 0 ^:mut ^I32 i 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (set table (node-new nodes (nk-table) 0))
    (node-add-region nodes regions table 1 12000 12000 30000 20000)
    (set cell (node-new nodes (nk-cell) table))
    (set at (cells-len text))
    (text-append-utf8 text (text-blob "34,647") 0 6)
    (node-set-text nodes cell at 6)
    (set cell (node-new nodes (nk-cell) table))
    (set at (cells-len text))
    (text-append-utf8 text (text-blob "35,415") 0 6)
    (node-set-text nodes cell at 6)
    (set table (node-new nodes (nk-table) 0))
    (node-add-region nodes regions table 1 12000 50000 30000 56000)
    (set cell (node-new nodes (nk-cell) table))
    (set at (cells-len text))
    (text-append-utf8 text (text-blob "100") 0 3)
    (node-set-text nodes cell at 3)
    (ft-cand cand 1 10000 10000 40000 30000)
    (cells-set cand 30 5)
    (ft-fd fd (fg-diagram) 700)
    (cells-push fg 0) (cells-push fg 0)
    (rs-figures nodes attrs regions text nn na nr nm cand fg fd ab)
    (assert-eq (node-count nn) 4 "document, diagram and the independent true table with its cell")
    (assert-eq (node-kind nn 1) (nk-figure) "the diagram owns the inner grid")
    (set a (node-attr nn na 1 (fk-labels)))
    (assert-that (>= a 0) "the numeric cells survive as figure labels")
    (if (>= a 0)
      (do (assert-eq (attr-len na a) 6 "first value survives whole")
          (assert-eq (text-at text (attr-value na a)) 51 "first value starts with its recorded digit")))
    (while (>= a 0)
      (do (set i 0)
          (while (< i (attr-len na a))
            (do (text-cp values (text-at text (+ (attr-value na a) i))) (set i (+ i 1))))
          (text-cp values 124)
          (set a (attr-next na a))))
    (assert-text values "34,647|35,415|" "both selected numeric values transfer verbatim, once each")
    (assert-eq (node-kind nn 2) (nk-table) "the separate short table retains table ownership")
    (set cell (node-first-child nn 2))
    (assert-eq (node-text-len nn cell) 3 "the true table keeps its numeric value")))
