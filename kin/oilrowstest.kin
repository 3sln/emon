;; Laws for row assembly of segment engines (P13.4, D883 ruling 2). A detector segment is one box with a few words: PP-OCR emits a receipt row
;; as its name, its quantity and its price, three segments, where Tesseract's layout analysis emits one textline. Kin joins collinear segments
;; into one pipeline line before the paragraph, table and column stages read them, and keeps each segment's end as a `gap` word break.
(ns emon.oilrowstest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq new-cells]]
            [emon.port :refer [cells-len]]
            [emon.oilrows :refer [or-assemble]]
            [emon.model :refer [sr-ocr]]
            [emon.evidence :refer [or-new or-set orf-flags rl-new rl-set rlf-lx0 rlf-ly0 rlf-lx1 rlf-ly1 rlf-thick wd-new wd-get wd-set wd-count ln-new ln-get ln-set ln-count
                                   lh-first lh-count lh-x0 lh-y0 lh-x1 lh-y1 lh-bx0 lh-by1 hd-tstart hd-line wf-size wf-gap wf-wbreak wf-src lf-src lf-order
                                   wb-space wb-gap wb-line-end]]
            [kin.lang :refer [defn return let set while if do comment + - * < > <= >= == != and or]]))

(defn ^I32 rt-seg [^:mut ^Cells lines ^:mut ^Cells words ^I32 x0 ^I32 x1 ^I32 y0 ^I32 y1 ^I32 tstart]
  (comment "One detector segment as the pipeline holds it after emission: a line of one word with the same box, whose text starts at `tstart`.")
  (let [^I32 first (wd-count words)
        ^I32 l (ln-count lines)]
    (wd-new words 1 x0 y0 x1 y1 x0 y1 x1 y1 0 0 tstart 3 l 900 -1)
    (wd-set words first (wf-size) 1200)
    (wd-set words first (wf-gap) -1)
    (wd-set words first (wf-wbreak) (wb-line-end))
    (wd-set words first (wf-src) (sr-ocr))
    (ln-new lines 1 x0 y0 x1 y1 x0 y1 x1 y1 0 0 first 1)
    (ln-set lines l (lf-src) (sr-ocr))
    (ln-set lines l (lf-order) l)
    (return l)))

(defn ^I32 rt-rule [^:mut ^Cells rules ^I32 x ^I32 y0 ^I32 y1]
  (comment "A vertical rule of page 1 at x from y0 to y1, 10 centipoints thick (the tracer's, as `emon.scantest` makes one).")
  (let [^I32 r (rl-new rules 1 (- x 5) y0 (+ x 5) y1 0)]
    (rl-set rules r (rlf-lx0) x)
    (rl-set rules r (rlf-ly0) y0)
    (rl-set rules r (rlf-lx1) x)
    (rl-set rules r (rlf-ly1) y1)
    (rl-set rules r (rlf-thick) 10)
    (return r)))

(defn ^I32 rt-runs [^:mut ^Cells runs ^I32 granularity]
  (comment "One OCR run on page 1 whose engine reports line granularity `granularity` (0 layout, 1 segment).")
  (let [^I32 r (or-new runs 1 0)]
    (or-set runs r (orf-flags) (* 256 granularity))
    (return r)))

(defn ^I32 rt-run [^Cells lines ^Cells words ^Cells runs ^Cells rules ^I32 n]
  (comment "Assemble the `n` lines made, through the one entry point.")
  (let [^Cells scr (new-cells)]
    (return (or-assemble runs 0 rules 1 lines 0 words 0 scr))))

(deftest test-three-segments-of-a-receipt-row-are-one-line-with-three-words
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-seg lines words 1000 5000 1000 1500 0)
    (rt-seg lines words 8000 9500 1010 1510 6)
    (rt-seg lines words 6500 6900 1005 1500 3)
    (assert-eq (rt-run lines words runs (new-cells) 3) 1 "name, quantity and price are one row, whatever order the detector emitted them in")
    (assert-eq (ln-count lines) 1 "one line row remains")
    (assert-eq (wd-count words) 3 "the three words are kept")
    (assert-eq (ln-get lines 0 (lh-first)) 0 "the line's words start at the range's first word")
    (assert-eq (ln-get lines 0 (lh-count)) 3 "three words")
    (assert-eq (wd-get words 0 (hd-tstart)) 0 "the name comes first")
    (assert-eq (wd-get words 1 (hd-tstart)) 3 "then the quantity")
    (assert-eq (wd-get words 2 (hd-tstart)) 6 "then the price, in reading order and not in the detector's")
    (assert-eq (wd-get words 0 (hd-line)) 0 "every word names the one line")
    (assert-eq (wd-get words 2 (hd-line)) 0 "every word names the one line")
    (assert-eq (ln-get lines 0 (lh-x0)) 1000 "the line's box is the segments' union: left")
    (assert-eq (ln-get lines 0 (lh-x1)) 9500 "right")
    (assert-eq (ln-get lines 0 (lh-y0)) 1000 "top")
    (assert-eq (ln-get lines 0 (lh-y1)) 1510 "bottom")
    (assert-eq (wd-get words 0 (wf-gap)) 1500 "the gap after the name is the distance to the quantity")
    (assert-eq (wd-get words 1 (wf-gap)) 1100 "and after the quantity the distance to the price")
    (assert-eq (wd-get words 2 (wf-gap)) -1 "none after the last")))

(deftest test-segment-boundaries-stay-as-gap-word-breaks
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-seg lines words 1000 5000 1000 1500 0)
    (rt-seg lines words 6500 6900 1000 1500 3)
    (rt-seg lines words 8000 9500 1000 1500 6)
    (rt-run lines words runs (new-cells) 3)
    (assert-eq (wd-get words 0 (wf-wbreak)) (wb-gap) "the end of the first segment is a recorded boundary: a table's cell cut")
    (assert-eq (wd-get words 1 (wf-wbreak)) (wb-gap) "and so is the second's")
    (assert-eq (wd-get words 2 (wf-wbreak)) (wb-line-end) "the row ends where its last segment does")))

(deftest test-rows-interleaved-by-the-detector-come-out-whole-and-in-order
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-seg lines words 1000 3000 1000 1500 0)
    (rt-seg lines words 1000 3200 1900 2400 3)
    (rt-seg lines words 6000 7500 1005 1505 6)
    (rt-seg lines words 6000 7600 1895 2395 9)
    (assert-eq (rt-run lines words runs (new-cells) 4) 2 "two rows from four segments")
    (assert-eq (ln-get lines 0 (lh-count)) 2 "the upper row has two words")
    (assert-eq (ln-get lines 1 (lh-count)) 2 "the lower row has two words")
    (assert-eq (ln-get lines 1 (lh-first)) 2 "its words are contiguous after the first row's")
    (assert-eq (wd-get words 0 (hd-tstart)) 0 "upper row: left word")
    (assert-eq (wd-get words 1 (hd-tstart)) 6 "upper row: right word")
    (assert-eq (wd-get words 2 (hd-tstart)) 3 "lower row: left word")
    (assert-eq (wd-get words 3 (hd-tstart)) 9 "lower row: right word")
    (assert-eq (wd-get words 3 (hd-line)) 1 "the lower row's words name the lower row")
    (assert-eq (ln-get lines 1 (lf-order)) 1 "reading order is the new row's")))

(deftest test-columns-stay-separate
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-seg lines words 1000 3000 1000 1500 0)
    (rt-seg lines words 3400 3800 1000 1500 3)
    (rt-seg lines words 10800 13000 1000 1500 6)
    (rt-seg lines words 13400 13800 1000 1500 9)
    (rt-seg lines words 1000 3200 1700 2200 12)
    (rt-seg lines words 10800 13200 1700 2200 15)
    (assert-eq (rt-run lines words runs (new-cells) 6) 4 "each column's row is one line; the gutter, fourteen heights wide, is not crossed, and the next row down is another line")
    (assert-eq (ln-get lines 0 (lh-count)) 2 "left column, first row: name and quantity")
    (assert-eq (ln-get lines 1 (lh-count)) 2 "right column, first row")
    (assert-eq (ln-get lines 2 (lh-count)) 1 "left column, second row")
    (assert-eq (ln-get lines 3 (lh-count)) 1 "right column, second row")))

(deftest test-a-vertical-rule-between-two-segments-keeps-them-apart
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)
        ^Cells rules (new-cells)]
    (rt-runs runs 1)
    (rt-rule rules 5800 800 1700)
    (rt-seg lines words 1000 5000 1000 1500 0)
    (rt-seg lines words 6500 9500 1000 1500 3)
    (rt-seg lines words 1000 5000 1700 2200 6)
    (rt-seg lines words 6500 9500 1700 2200 9)
    (assert-eq (rt-run lines words runs rules 4) 3 "the ruled row stays two cells; the unruled row below, with no rule beside it, is one line")
    (assert-eq (ln-get lines 0 (lh-count)) 1 "left of the rule")
    (assert-eq (ln-get lines 1 (lh-count)) 1 "right of the rule")))

(deftest test-segments-of-different-heights-or-offsets-are-not-a-row
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-seg lines words 1000 3000 1000 1500 0)
    (rt-seg lines words 3600 5000 1000 1900 3)
    (rt-seg lines words 3600 5000 1300 1800 6)
    (assert-eq (rt-run lines words runs (new-cells) 3) 3 "a segment nearly twice as tall is not of the row, and one a third of a height lower is a different row")))

(deftest test-a-layout-engine-run-is-never-reassembled
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 0)
    (rt-seg lines words 1000 5000 1000 1500 0)
    (rt-seg lines words 6500 6900 1000 1500 3)
    (rt-seg lines words 8000 9500 1000 1500 6)
    (assert-eq (rt-run lines words runs (new-cells) 3) 3 "Tesseract's lines are its own: the three stay three")
    (assert-eq (wd-get words 0 (wf-wbreak)) (wb-line-end) "and its words are untouched")))

(deftest test-a-page-read-by-a-layout-engine-as-well-is-left-alone
  (let [^Cells lines (new-cells)
        ^Cells words (new-cells)
        ^Cells runs (new-cells)]
    (rt-runs runs 1)
    (rt-runs runs 0)
    (rt-seg lines words 1000 5000 1000 1500 0)
    (rt-seg lines words 8000 9500 1000 1500 3)
    (assert-eq (rt-run lines words runs (new-cells) 2) 2 "with a layout engine's reading on the page, the selected lines may be its own: nothing is joined")))
