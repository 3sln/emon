;; Laws for `emon.health` on the fusion corpus (P7.2; SPEC 9.3; D284): the text layer of a document's first page (`test/corpus/synth/pdf/`,
;; the document pass as the Engine runs it: `pd-open`, `pc-document`, `th-run`) against the OCR of the same page, recorded live by Tesseract
;; at 150 dpi (`test/fusion/health/pdf/ID.ocr`, `tools/fusion/record_health.clj`: the width and height in pixels, then the engine's answer),
;; read back with `sc-answer` as the page unit does. No engine runs here and no pixel is read.
;;
;; THE ALIGNMENT IS A STAND-IN. P7.1 builds the correspondence groups in the page unit; this file builds its own with the plainest rule
;; that gives the health something to measure: a text-layer word and an OCR word are connected when their boxes overlap (the smaller
;; one at least half inside the other), a connected component is one group, its text-layer words joined in content-stream order and its
;; OCR words in engine order (so a split word and a merged word still compare as the same text), the similarity the Levenshtein
;; similarity of the ASCII-case-folded letters and digits. P7.1's alignment is better on every document whose words the engine splits,
;; so the agreement measured here is the lower bound the health will see.
;;
;; WHAT IS HELD (the numbers are the live ones, in DEVLOG P7.2): every font of a healthy document that has groups to count agrees with
;; OCR and stays at or over `tl-trusted`; the shifted font of `tl-broken-shift` agrees on almost nothing and scores under 300; the
;; unmapped font of `tl-broken-unmapped` is under 300 with or without OCR; the one font a document has that OCR cannot read at all
;; (a script the engine has no model for) is told apart by its agreement being low while its mapping is whole.
(ns emon.healthfusiontest
  (:require [emon.lang :refer [I32 Blob Src Cells]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that assert-that-at new-cells test-file]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop src-of-blob src-len src-u8]]
            [emon.pdfdoc :refer [pd-open]]
            [emon.pdfcontent :refer [pc-document]]
            [emon.plan :refer [lay-full]]
            [emon.scan :refer [sc-answer]]
            [emon.evidence :refer [vw-new vk-render fe-get ow-get ow-count rf-add ev-overlap-small hd-x0 hd-y0 hd-x1 hd-y1 hd-tstart hd-tlen ea-owords]]
            [emon.player :refer [cg-new cg-set hl-get hl-count hlf-score hlf-agreement hlf-kind hlf-page hlf-subject plh-font-page pl-ea-fw
                                 cgf-tfirst cgf-tcount cgf-ofirst cgf-ocount cgf-sim cgf-simfold]]
            [emon.tlhealth :refer [th-run th-trusted]]
            [emon.health :refer [hl-page hl-doc hlf-both hlf-agree hh-agree-words hh-agree-min]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 hf-parse [^Blob b ^:mut ^Cells out]
  (comment "The integers (decimal, optionally negative, separated by anything else) of a blob, pushed onto `out`.")
  (let [^Src s (src-of-blob b)
        ^I32 n (src-len s)
        ^:mut ^I32 i 0
        ^:mut ^I32 v 0
        ^:mut ^I32 neg 0
        ^:mut ^I32 has 0
        ^:mut ^I32 c 0]
    (while (< i n)
      (do (set c (src-u8 s i))
          (if (and (>= c 48) (<= c 57))
            (do (set v (+ (* v 10) (- c 48)))
                (set has 1))
            (do (if (and (== c 45) (== has 0)) (set neg 1))
                (if (== has 1)
                  (do (if (== neg 1) (set v (- 0 v)))
                      (cells-push out v)
                      (set v 0)
                      (set has 0)
                      (set neg 0)))
                (if (and (!= c 45) (== has 0)) (set neg 0))))
          (set i (+ i 1))))
    (if (== has 1)
      (do (if (== neg 1) (set v (- 0 v)))
          (cells-push out v)))
    (return 0)))

(defn ^I32 hf-find [^:mut ^Cells par ^I32 x]
  (comment "Union-find root with path halving.")
  (let [^:mut ^I32 a x
        ^:mut ^I32 p 0
        ^:mut ^I32 g 0]
    (set p (cells-at par a))
    (while (!= p a)
      (do (set g (cells-at par p))
          (cells-set par a g)
          (set a g)
          (set p (cells-at par a))))
    (return a)))

(defn ^I32 hf-union [^:mut ^Cells par ^I32 x ^I32 y]
  (let [^I32 rx (hf-find par x)
        ^I32 ry (hf-find par y)]
    (if (< rx ry) (cells-set par ry rx))
    (if (> rx ry) (cells-set par rx ry))
    (return 0)))

(defn ^I32 hf-letters [^Cells et ^I32 ts ^I32 tl ^:mut ^Cells out]
  (comment "Push the letters and digits of etext[ts, ts + tl) onto `out`, ASCII upper case folded to lower, everything else under 128 dropped.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 c 0]
    (while (< i tl)
      (do (set c (cells-at et (+ ts i)))
          (if (and (>= c 65) (<= c 90)) (set c (+ c 32)))
          (if (or (>= c 128) (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57))))
            (cells-push out c))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 hf-sim [^Cells a ^Cells b ^:mut ^Cells r0 ^:mut ^Cells r1]
  (comment "1000 - 1000 * lev(a, b) / max(len a, len b); 1000 for two empty ones.")
  (let [^I32 la (cells-len a)
        ^I32 lb (cells-len b)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 x 0
        ^:mut ^I32 y 0
        ^:mut ^I32 z 0
        ^:mut ^I32 cost 0
        ^:mut ^I32 m 0]
    (if (and (== la 0) (== lb 0)) (return 1000))
    (cells-drop r0 0)
    (cells-drop r1 0)
    (set j 0)
    (while (<= j lb)
      (do (cells-push r0 j)
          (cells-push r1 0)
          (set j (+ j 1))))
    (set i 1)
    (while (<= i la)
      (do (cells-set r1 0 i)
          (set j 1)
          (while (<= j lb)
            (do (set cost 1)
                (if (== (cells-at a (- i 1)) (cells-at b (- j 1))) (set cost 0))
                (set x (+ (cells-at r0 (- j 1)) cost))
                (set y (+ (cells-at r0 j) 1))
                (set z (+ (cells-at r1 (- j 1)) 1))
                (if (< y x) (set x y))
                (if (< z x) (set x z))
                (cells-set r1 j x)
                (set j (+ j 1))))
          (set j 0)
          (while (<= j lb)
            (do (cells-set r0 j (cells-at r1 j))
                (set j (+ j 1))))
          (set i (+ i 1))))
    (set m la)
    (if (> lb m) (set m lb))
    (return (- 1000 (quot (* 1000 (cells-at r0 lb)) m)))))

(defn ^I32 hf-groups [^I32 page ^Cells fw ^Cells owords ^Cells et ^:mut ^Cells cg ^:mut ^Cells refs ^:mut ^Cells par
                      ^:mut ^Cells ta ^:mut ^Cells tb ^:mut ^Cells r0 ^:mut ^Cells r1 ^:mut ^Cells gid]
  (comment "The stand-in alignment (see the head): the groups of the text-layer words (visible, `src` 1) and the OCR words of `page`.")
  (comment "Answers the number of groups; `cg` rows with their runs in `refs`, text-layer candidates then OCR ones.")
  (let [^I32 nf (quot (cells-len fw) 24)
        ^I32 no (ow-count owords)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 g 0
        ^:mut ^I32 ng 0
        ^:mut ^I32 root 0
        ^:mut ^I32 g0 0
        ^:mut ^I32 first 0
        ^:mut ^I32 nt 0
        ^:mut ^I32 nob 0
        ^:mut ^I32 ref 0
        ^:mut ^I32 sim 0
        ^:mut ^I32 x0 0
        ^:mut ^I32 y0 0
        ^:mut ^I32 x1 0
        ^:mut ^I32 y1 0]
    (cells-drop par 0)
    (cells-drop gid 0)
    (set i 0)
    (while (< i (+ nf no))
      (do (cells-push par i)
          (cells-push gid -1)
          (set i (+ i 1))))
    (comment "connect overlapping words")
    (set i 0)
    (while (< i nf)
      (do (if (and (== (cells-at fw (* i 24)) page) (== (cells-at fw (+ (* i 24) 23)) 1))
            (do (set j 0)
                (while (< j no)
                  (do (if (== (ow-get owords j 0) page)
                        (if (>= (ev-overlap-small (cells-at fw (+ (* i 24) 1)) (cells-at fw (+ (* i 24) 2)) (cells-at fw (+ (* i 24) 3)) (cells-at fw (+ (* i 24) 4))
                                                  (ow-get owords j (hd-x0)) (ow-get owords j (hd-y0)) (ow-get owords j (hd-x1)) (ow-get owords j (hd-y1)))
                                500)
                          (hf-union par i (+ nf j))))
                      (set j (+ j 1))))))
          (set i (+ i 1))))
    (comment "a group id to every root of a member, in order of the first member")
    (set i 0)
    (while (< i (+ nf no))
      (do (set root (hf-find par i))
          (if (and (== (cells-at gid root) -1)
                   (or (and (< i nf) (and (== (cells-at fw (* i 24)) page) (== (cells-at fw (+ (* i 24) 23)) 1)))
                       (and (>= i nf) (== (ow-get owords (- i nf) 0) page))))
            (do (cells-set gid root ng)
                (set ng (+ ng 1))))
          (set i (+ i 1))))
    (set g 0)
    (while (< g ng)
      (do (cells-drop ta 0)
          (cells-drop tb 0)
          (set nt 0)
          (set nob 0)
          (set first -1)
          (set x0 2000000000)
          (set y0 2000000000)
          (set x1 -2000000000)
          (set y1 -2000000000)
          (comment "its text-layer words, in order")
          (set i 0)
          (while (< i nf)
            (do (if (and (== (cells-at fw (* i 24)) page) (== (cells-at fw (+ (* i 24) 23)) 1))
                  (if (== (cells-at gid (hf-find par i)) g)
                    (do (set ref (rf-add refs (pl-ea-fw) i))
                        (if (== nt 0) (set first ref))
                        (set nt (+ nt 1))
                        (hf-letters et (cells-at fw (+ (* i 24) 11)) (cells-at fw (+ (* i 24) 12)) ta)
                        (if (< (cells-at fw (+ (* i 24) 1)) x0) (set x0 (cells-at fw (+ (* i 24) 1))))
                        (if (< (cells-at fw (+ (* i 24) 2)) y0) (set y0 (cells-at fw (+ (* i 24) 2))))
                        (if (> (cells-at fw (+ (* i 24) 3)) x1) (set x1 (cells-at fw (+ (* i 24) 3))))
                        (if (> (cells-at fw (+ (* i 24) 4)) y1) (set y1 (cells-at fw (+ (* i 24) 4)))))))
                (set i (+ i 1))))
          (set g0 (cg-new cg page 0 0 0 0 0))
          (cg-set cg g0 (cgf-tfirst) first)
          (cg-set cg g0 (cgf-tcount) nt)
          (set first -1)
          (comment "its OCR words, in order")
          (set j 0)
          (while (< j no)
            (do (if (== (ow-get owords j 0) page)
                  (if (== (cells-at gid (hf-find par (+ nf j))) g)
                    (do (set ref (rf-add refs (ea-owords) j))
                        (if (== nob 0) (set first ref))
                        (set nob (+ nob 1))
                        (hf-letters et (ow-get owords j (hd-tstart)) (ow-get owords j (hd-tlen)) tb)
                        (if (< (ow-get owords j (hd-x0)) x0) (set x0 (ow-get owords j (hd-x0))))
                        (if (< (ow-get owords j (hd-y0)) y0) (set y0 (ow-get owords j (hd-y0))))
                        (if (> (ow-get owords j (hd-x1)) x1) (set x1 (ow-get owords j (hd-x1))))
                        (if (> (ow-get owords j (hd-y1)) y1) (set y1 (ow-get owords j (hd-y1)))))))
                (set j (+ j 1))))
          (cg-set cg g0 (cgf-ofirst) first)
          (cg-set cg g0 (cgf-ocount) nob)
          (cg-set cg g0 1 x0)
          (cg-set cg g0 2 y0)
          (cg-set cg g0 3 x1)
          (cg-set cg g0 4 y1)
          (if (and (> nt 0) (> nob 0))
            (do (set sim (hf-sim ta tb r0 r1))
                (cg-set cg g0 (cgf-simfold) sim)
                (cg-set cg g0 (cgf-sim) sim)))
          (set g (+ g 1))))
    (return ng)))

(defn ^I32 hf-doc [^Blob file ^Blob ocr ^I32 with-ocr ^:mut ^Cells rep]
  (comment "One document's first page through the document pass, the recorded OCR (when `with-ocr` is 1; else P7.0 alone) and the")
  (comment "health. `rep` is made new: its cells are 0 the (font, page 1) rows, 1 how many are at least `tl-trusted`, 2 the lowest score,")
  (comment "3 the lowest agreement among the rows that have one (-1 for none), 4 the groups, 5 the groups with both candidates, 6 the")
  (comment "agreeing ones, 7 the lowest agreement among the rows with at least `agree-words` groups (-1 for none), then per font row")
  (comment "(page 1, in `hl` order) from cell 8: font, score, agreement, groups with both.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells cx (new-cells)
        ^Cells ox (new-cells)
        ^Cells cs (new-cells)
        ^Cells out (new-cells)
        ^Cells f0 (new-cells)
        ^Cells f1 (new-cells)
        ^Cells f2 (new-cells)
        ^Cells f3 (new-cells)
        ^Cells gl (new-cells)
        ^Cells et (new-cells)
        ^Cells mk (new-cells)
        ^Cells fnt (new-cells)
        ^Cells pg (new-cells)
        ^Cells wd (new-cells)
        ^Cells ln (new-cells)
        ^Cells pa (new-cells)
        ^Cells im (new-cells)
        ^Cells pts (new-cells)
        ^Cells gx (new-cells)
        ^Cells epages (new-cells)
        ^Cells feats (new-cells)
        ^Cells fw (new-cells)
        ^Cells fl (new-cells)
        ^Cells fa (new-cells)
        ^Cells hl (new-cells)
        ^Cells sc (new-cells)
        ^Cells cg (new-cells)
        ^Cells refs (new-cells)
        ^Cells views (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells an (new-cells)
        ^Cells par (new-cells)
        ^Cells gid (new-cells)
        ^Cells ta (new-cells)
        ^Cells tb (new-cells)
        ^Cells r0 (new-cells)
        ^Cells r1 (new-cells)
        ^Cells ints (new-cells)
        ^Src src (src-of-blob file)
        ^I32 o (pd-open src ar dc a b st)
        ^:mut ^I32 status 0
        ^:mut ^I32 v 0
        ^:mut ^I32 i 0
        ^:mut ^I32 trusted 0
        ^:mut ^I32 low 100000
        ^:mut ^I32 lowag 100000
        ^:mut ^I32 lowc 100000
        ^:mut ^I32 ng 0
        ^:mut ^I32 nboth 0
        ^:mut ^I32 nagree 0
        ^:mut ^I32 w 0
        ^:mut ^I32 h 0
        ^:mut ^I32 n 0]
    (if (!= o 0) (return -1))
    (set status (pc-document src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx))
    (if (!= status 0) (return -2))
    (th-run pg gl et mk fnt wd ln im epages feats fw fl fa hl sc)
    (if (== with-ocr 1)
      (do (comment "the recorded OCR of page 1: its size, then the answer record")
          (hf-parse ocr ints)
          (set w (cells-at ints 0))
          (set h (cells-at ints 1))
          (set n (cells-len ints))
          (set i 2)
          (while (< i n)
            (do (cells-push an (cells-at ints i))
                (set i (+ i 1))))
          (vw-new views 1 (vk-render) 1 -1 w h 15000 (lay-full) -1 0 0 0 0 0)
          (sc-answer an 0 1 0 2 0 views epages et oruns oblocks olines owords osyms oalts feats)
          (set ng (hf-groups 1 fw owords et cg refs par ta tb r0 r1 gid))
          (hl-page 1 cg refs fw wd et feats oblocks olines owords hl)
          (hl-doc feats fw hl)))
    (cells-drop rep 0)
    (while (< (cells-len rep) 8) (cells-push rep 0))
    (cells-set rep 4 ng)
    (set i 0)
    (while (< i (hl-count hl))
      (do (if (and (== (hl-get hl i (hlf-kind)) (plh-font-page)) (== (hl-get hl i (hlf-page)) 1))
            (do (set v (hl-get hl i (hlf-score)))
                (cells-set rep 0 (+ (cells-at rep 0) 1))
                (if (>= v (th-trusted)) (set trusted (+ trusted 1)))
                (if (< v low) (set low v))
                (if (and (>= (hl-get hl i (hlf-agreement)) 0) (< (hl-get hl i (hlf-agreement)) lowag)) (set lowag (hl-get hl i (hlf-agreement))))
                (if (and (>= (hl-get hl i (hlf-both)) (hh-agree-words)) (< (hl-get hl i (hlf-agreement)) lowc)) (set lowc (hl-get hl i (hlf-agreement))))
                (set nboth (+ nboth (hl-get hl i (hlf-both))))
                (set nagree (+ nagree (hl-get hl i (hlf-agree))))
                (cells-push rep (hl-get hl i (hlf-subject)))
                (cells-push rep v)
                (cells-push rep (hl-get hl i (hlf-agreement)))
                (cells-push rep (hl-get hl i (hlf-both)))))
          (set i (+ i 1))))
    (cells-set rep 1 trusted)
    (cells-set rep 2 low)
    (if (== lowag 100000) (set lowag -1))
    (cells-set rep 3 lowag)
    (if (== lowc 100000) (set lowc -1))
    (cells-set rep 7 lowc)
    (cells-set rep 5 nboth)
    (cells-set rep 6 nagree)
    (return 0)))

(defn ^I32 hf-agrees [^Cells rep]
  (comment "1 when every font with enough groups to count agrees with OCR at `agree-min` or more (or none had enough).")
  (let [^I32 v (cells-at rep 7)]
    (if (< v 0) (return 1))
    (if (>= v (hh-agree-min)) (return 1))
    (return 0)))

(deftest test-healthy-documents-1
  (comment "every font of these documents is trusted, with OCR in, and every font with groups to count agrees")
  (let [^Cells rep (new-cells)]
    (hf-doc (test-file "corpus/synth/pdf/align-justify-hyphen.pdf") (test-file "fusion/health/pdf/align-justify-hyphen.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "align-justify-hyphen: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "align-justify-hyphen: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/align-paragraphs.pdf") (test-file "fusion/health/pdf/align-paragraphs.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "align-paragraphs: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "align-paragraphs: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/align-rtl.pdf") (test-file "fusion/health/pdf/align-rtl.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "align-rtl: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "align-rtl: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/align-table-numeric.pdf") (test-file "fusion/health/pdf/align-table-numeric.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "align-table-numeric: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "align-table-numeric: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/bank-statement.pdf") (test-file "fusion/health/pdf/bank-statement.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "bank-statement: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "bank-statement: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/bg-texture.pdf") (test-file "fusion/health/pdf/bg-texture.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "bg-texture: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "bg-texture: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-continue.pdf") (test-file "fusion/health/pdf/columns-continue.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-continue: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-continue: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-margin-notes.pdf") (test-file "fusion/health/pdf/columns-margin-notes.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-margin-notes: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-margin-notes: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-mid-page.pdf") (test-file "fusion/health/pdf/columns-mid-page.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-mid-page: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-mid-page: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-newspaper.pdf") (test-file "fusion/health/pdf/columns-newspaper.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-newspaper: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-newspaper: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-span-figure.pdf") (test-file "fusion/health/pdf/columns-span-figure.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-span-figure: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-span-figure: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-three-news.pdf") (test-file "fusion/health/pdf/columns-three-news.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-three-news: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-three-news: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-two.pdf") (test-file "fusion/health/pdf/columns-two.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-two: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-two: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/columns-uneven.pdf") (test-file "fusion/health/pdf/columns-uneven.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "columns-uneven: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "columns-uneven: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/figures-charts.pdf") (test-file "fusion/health/pdf/figures-charts.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "figures-charts: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "figures-charts: the fonts counted agree")
    (hf-doc (test-file "corpus/synth/pdf/figures-logo-screenshot.pdf") (test-file "fusion/health/pdf/figures-logo-screenshot.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "figures-logo-screenshot: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "figures-logo-screenshot: the fonts counted agree")))

(deftest test-healthy-documents-2
  (comment "every font of these documents is trusted, with OCR in, and every font with groups to count agrees")
  (let [^Cells rep (new-cells)]
    (hf-doc (test-file "corpus/synth/pdf/footnotes-endnotes.pdf") (test-file "fusion/health/pdf/footnotes-endnotes.ocr") 1 rep)
    (assert-eq (cells-at rep 1) (cells-at rep 0) "footnotes-endnotes: every font is trusted")
    (assert-eq (hf-agrees rep) 1 "footnotes-endnotes: the fonts counted agree")
