(deftest test-a-shifted-font-is-caught-by-agreement-alone
  (let [^Cells rep (new-cells)]
    (hf-doc (test-file "corpus/synth/pdf/tl-broken-shift.pdf") (test-file "fusion/health/pdf/tl-broken-shift.ocr") 0 rep)
    (assert-eq (cells-at rep 0) 5 "tl-broken-shift: five fonts on page 1")
    (assert-eq (cells-at rep 1) 5 "tl-broken-shift: without OCR every one is trusted (P7.0 cannot tell)")
    (hf-doc (test-file "corpus/synth/pdf/tl-broken-shift.pdf") (test-file "fusion/health/pdf/tl-broken-shift.ocr") 1 rep)
    (assert-eq (cells-at rep 0) 5 "tl-broken-shift: five fonts")
    (assert-eq (cells-at rep 1) 4 "tl-broken-shift: with OCR four are trusted")
    (assert-that (< (cells-at rep 2) 300) "tl-broken-shift: the shifted font is under 300")
    (assert-eq (cells-at rep 7) 0 "tl-broken-shift: it agrees on nothing")
    (assert-that (>= (cells-at rep 5) 300) "tl-broken-shift: with groups to count")))

(deftest test-an-unmapped-font-is-caught-with-or-without-ocr
  (let [^Cells rep (new-cells)]
    (hf-doc (test-file "corpus/synth/pdf/tl-broken-unmapped.pdf") (test-file "fusion/health/pdf/tl-broken-unmapped.ocr") 0 rep)
    (assert-eq (cells-at rep 1) 4 "tl-broken-unmapped: four of five fonts are trusted without OCR")
    (assert-eq (cells-at rep 2) 34 "tl-broken-unmapped: the broken one is P7.0's 34")
    (hf-doc (test-file "corpus/synth/pdf/tl-broken-unmapped.pdf") (test-file "fusion/health/pdf/tl-broken-unmapped.ocr") 1 rep)
    (assert-eq (cells-at rep 1) 4 "tl-broken-unmapped: and with OCR")
    (assert-eq (cells-at rep 2) 34 "tl-broken-unmapped: still 34: no letters to count")))

(deftest test-fonts-that-lose-glyphs-stay-as-the-text-layer-scored-them
  (comment "the Devanagari fonts whose ToUnicode has no matras (P7.0, D240): with OCR in, the same scores; the engine reads none of it")
  (let [^Cells rep (new-cells)]
    (hf-doc (test-file "corpus/synth/pdf/script-devanagari.pdf") (test-file "fusion/health/pdf/script-devanagari.ocr") 1 rep)
    (assert-eq (cells-at rep 2) 616 "script-devanagari: P7.0's")
    (hf-doc (test-file "corpus/synth/pdf/script-mixed.pdf") (test-file "fusion/health/pdf/script-mixed.ocr") 1 rep)
    (assert-eq (cells-at rep 2) 201 "script-mixed: P7.0's")
    (assert-eq (cells-at rep 1) 11 "script-mixed: the same fonts trusted")))
