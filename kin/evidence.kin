    (ev-set c 24 r 14 -1)
    (ev-set c 24 r 16 -1)
    (ev-set c 24 r 17 -1)
    (ev-set c 24 r 18 v-gfirst)
    (ev-set c 24 r 20 -1)
    (ev-set c 24 r 21 -1)
    (return r)))

(defn ^:pub ^I32 fo-count [^Cells c] (return (ev-count c 16)))
(defn ^:pub ^I32 fo-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 16 i f)))
(defn ^:pub ^I32 fo-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 16 i f v)))
(defn ^:pub ^I32 fo-new [^:mut ^Cells c ^I32 v-obj ^I32 v-subtype]
