;; -------------------------------------------------------------- generic

(defn ^I32 ev-get [^Cells c ^I32 stride ^I32 row ^I32 f]
  (return (cells-at c (+ (* row stride) f))))

(defn ^I32 ev-set [^:mut ^Cells c ^I32 stride ^I32 row ^I32 f ^I32 v]
  (cells-set c (+ (* row stride) f) v)
  (return 0))

(defn ^I32 ev-count [^Cells c ^I32 stride]
  (return (quot (cells-len c) stride)))

(defn ^I32 ev-push [^:mut ^Cells c ^I32 stride]
  (comment "Append a row of zeros and answer its index.")
  (let [^I32 row (quot (cells-len c) stride)
        ^:mut ^I32 i 0]
    (while (< i stride)
      (do (cells-push c 0)
          (set i (+ i 1))))
    (return row)))

(defn ^:pub ^I32 evs-init [^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                           ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats]
  (comment "Empty the shared bundle.")
  (cells-drop epages 0)
  (cells-drop views 0)
  (cells-drop pts 0)
  (cells-drop refs 0)
  (cells-drop etext 0)
  (cells-drop feats 0)
  (return 0))

(defn ^:pub ^I32 evt-init [^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                           ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                           ^:mut ^Cells images]
  (comment "Empty the text bundle.")
  (cells-drop glyphs 0)
  (cells-drop words 0)
  (cells-drop lines 0)
  (cells-drop marks 0)
  (cells-drop fonts 0)
  (cells-drop paths 0)
  (cells-drop images 0)
  (return 0))

(defn ^:pub ^I32 evo-init [^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                           ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts]
  (comment "Empty the OCR bundle.")
  (cells-drop oruns 0)
  (cells-drop oblocks 0)
  (cells-drop olines 0)
  (cells-drop owords 0)
  (cells-drop osyms 0)
  (cells-drop oalts 0)
  (return 0))

(defn ^:pub ^I32 evr-init [^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                           ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Empty the trace bundle.")
  (cells-drop inks 0)
  (cells-drop components 0)
  (cells-drop rules 0)
  (cells-drop prims 0)
  (cells-drop tlines 0)
  (return 0))

(defn ^:pub ^I32 ev-init [^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Empty all 24 arenas.")
  (evs-init epages views pts refs etext feats)
  (evt-init glyphs words lines marks fonts paths images)
  (evo-init oruns oblocks olines owords osyms oalts)
  (evr-init inks components rules prims tlines)
  (return 0))

(defn ^:pub ^I32 etx-append-cp [^:mut ^Cells etext ^I32 cp]
  (comment "Append a code point to the evidence text arena (non-scalars become")
  (comment "U+FFFD, as in the Model's text arena); answer the index it went to.")
  (return (text-append-cp etext cp)))

(defn ^:pub ^I32 etx-len [^Cells etext] (return (cells-len etext)))


;; ---------------------------------------------------------------- the builders

(defn ^:pub ^I32 ep-count [^Cells c] (return (ev-count c 12)))
(defn ^:pub ^I32 ep-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 12 i f)))
(defn ^:pub ^I32 ep-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 12 i f v)))
(defn ^:pub ^I32 ep-new [^:mut ^Cells c ^I32 v-page ^I32 v-width ^I32 v-height]
  (comment "Append a row of epages: page width height; every other field is its default.")
  (let [^I32 r (ev-push c 12)]
    (ev-set c 12 r 0 v-page)
    (ev-set c 12 r 1 v-width)
    (ev-set c 12 r 2 v-height)
    (return r)))

(defn ^:pub ^I32 vw-count [^Cells c] (return (ev-count c 24)))
(defn ^:pub ^I32 vw-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 24 i f)))
(defn ^:pub ^I32 vw-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 24 i f v)))
(defn ^:pub ^I32 pt-count [^Cells c] (return (ev-count c 3)))
(defn ^:pub ^I32 pt-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 3 i f)))
(defn ^:pub ^I32 pt-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 3 i f v)))
(defn ^:pub ^I32 pt-new [^:mut ^Cells c ^I32 v-x ^I32 v-y ^I32 v-op]
  (comment "Append a row of pts: x y op; every other field is its default.")
  (let [^I32 r (ev-push c 3)]
    (ev-set c 3 r 0 v-x)
    (ev-set c 3 r 1 v-y)
    (ev-set c 3 r 2 v-op)
    (return r)))

(defn ^:pub ^I32 gl-count [^Cells c] (return (ev-count c 32)))
(defn ^:pub ^I32 gl-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 32 i f)))
(defn ^:pub ^I32 gl-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 32 i f v)))
(defn ^:pub ^I32 gl-new [^:mut ^Cells c ^I32 v-page ^I32 v-x0 ^I32 v-y0 ^I32 v-x1 ^I32 v-y1 ^I32 v-cp ^I32 v-tstart ^I32 v-tlen ^I32 v-word]
  (comment "Append a row of glyphs: page x0 y0 x1 y1 cp tstart tlen word; every other field is its default.")
  (let [^I32 r (ev-push c 32)]
    (ev-set c 32 r 0 v-page)
    (ev-set c 32 r 1 v-x0)
    (ev-set c 32 r 2 v-y0)
    (ev-set c 32 r 3 v-x1)
    (ev-set c 32 r 4 v-y1)
    (ev-set c 32 r 5 v-cp)
    (ev-set c 32 r 6 v-tstart)
    (ev-set c 32 r 7 v-tlen)
    (ev-set c 32 r 8 v-word)
    (ev-set c 32 r 16 5)
    (ev-set c 32 r 17 -1)
    (ev-set c 32 r 20 -1)
    (ev-set c 32 r 21 -1)
    (ev-set c 32 r 22 1000)
    (ev-set c 32 r 23 1000)
    (ev-set c 32 r 24 -1)
    (ev-set c 32 r 26 -1)
    (ev-set c 32 r 27 -1)
    (ev-set c 32 r 28 -1)
    (ev-set c 32 r 30 -1)
    (ev-set c 32 r 9 v-x0)
    (ev-set c 32 r 10 v-y1)
    (ev-set c 32 r 11 v-x1)
    (ev-set c 32 r 12 v-y1)
    (return r)))

(defn ^:pub ^I32 wd-count [^Cells c] (return (ev-count c 24)))
(defn ^:pub ^I32 wd-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 24 i f)))
(defn ^:pub ^I32 wd-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 24 i f v)))
(defn ^:pub ^I32 wd-new [^:mut ^Cells c ^I32 v-page ^I32 v-x0 ^I32 v-y0 ^I32 v-x1 ^I32 v-y1 ^I32 v-bx0 ^I32 v-by0 ^I32 v-bx1 ^I32 v-by1 ^I32 v-rot ^I32 v-dir ^I32 v-tstart ^I32 v-tlen ^I32 v-line ^I32 v-conf ^I32 v-feat]
  (comment "Append a row of words: page x0 y0 x1 y1 bx0 by0 bx1 by1 rot dir tstart tlen line conf feat; every other field is its default.")
  (let [^I32 r (ev-push c 24)]
    (ev-set c 24 r 0 v-page)
    (ev-set c 24 r 1 v-x0)
    (ev-set c 24 r 2 v-y0)
    (ev-set c 24 r 3 v-x1)
    (ev-set c 24 r 4 v-y1)
    (ev-set c 24 r 5 v-bx0)
    (ev-set c 24 r 6 v-by0)
    (ev-set c 24 r 7 v-bx1)
    (ev-set c 24 r 8 v-by1)
    (ev-set c 24 r 9 v-rot)
    (ev-set c 24 r 10 v-dir)
    (ev-set c 24 r 11 v-tstart)
    (ev-set c 24 r 12 v-tlen)
    (ev-set c 24 r 13 v-line)
    (ev-set c 24 r 14 v-conf)
    (ev-set c 24 r 15 v-feat)
    (ev-set c 24 r 17 -1)
    (ev-set c 24 r 19 -1)
    (ev-set c 24 r 21 -1)
    (ev-set c 24 r 23 1)
    (return r)))

(defn ^:pub ^I32 ln-count [^Cells c] (return (ev-count c 16)))
(defn ^:pub ^I32 ln-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 16 i f)))
(defn ^:pub ^I32 ln-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 16 i f v)))
(defn ^:pub ^I32 ln-new [^:mut ^Cells c ^I32 v-page ^I32 v-x0 ^I32 v-y0 ^I32 v-x1 ^I32 v-y1 ^I32 v-bx0 ^I32 v-by0 ^I32 v-bx1 ^I32 v-by1 ^I32 v-rot ^I32 v-dir ^I32 v-first ^I32 v-count]
  (comment "Append a row of lines: page x0 y0 x1 y1 bx0 by0 bx1 by1 rot dir first count; every other field is its default.")
  (let [^I32 r (ev-push c 16)]
    (ev-set c 16 r 0 v-page)
    (ev-set c 16 r 1 v-x0)
    (ev-set c 16 r 2 v-y0)
    (ev-set c 16 r 3 v-x1)
    (ev-set c 16 r 4 v-y1)
    (ev-set c 16 r 5 v-bx0)
    (ev-set c 16 r 6 v-by0)
    (ev-set c 16 r 7 v-bx1)
    (ev-set c 16 r 8 v-by1)
    (ev-set c 16 r 9 v-rot)
    (ev-set c 16 r 10 v-dir)
    (ev-set c 16 r 11 v-first)
    (ev-set c 16 r 12 v-count)
    (ev-set c 16 r 13 1)
    (ev-set c 16 r 14 -1)
    (return r)))

(defn ^:pub ^I32 mk-count [^Cells c] (return (ev-count c 24)))
(defn ^:pub ^I32 mk-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 24 i f)))
