;; --------------------------------------------------- integer trigonometry

(defn ^I32 ev-ratio [^I32 lo ^I32 hi]
  (comment "round(1024 * lo / hi) for 0 <= lo <= hi, hi > 0 (half up), in 64 bits.")
  (return (i32 (quot (add64 (mul64 (i64 lo) (i64 2048)) (i64 hi)) (mul64 (i64 hi) (i64 2))))))

(defn ^:pub ^I32 ev-angle [^I32 dx ^I32 dy]
  (comment "The angle of the vector (dx, dy), in page space (y DOWN), in centi-degrees")
  (comment "counter-clockwise AS DISPLAYED, in [0, 36000): integer atan2 of (dx, -dy) by octant")
  (comment "reduction and the table of atan(i/1024), i = round(1024 * min / max); the error is")
  (comment "under 0.03 degree and exact at every multiple of 45. The zero vector is 0. Every source")
  (comment "spells `rot` with this and nothing else (SPEC 8.4.1).")
  (let [^:mut ^I32 x dx
        ^:mut ^I32 y dy
        ^:mut ^I32 ax 0
        ^:mut ^I32 ay 0
        ^:mut ^I32 t 0
        ^:mut ^I32 a 0]
    (if (== x -2147483648) (set x -2147483647))
    (if (== y -2147483648) (set y -2147483647))
    (set y (- 0 y))
    (set ax x)
    (if (< ax 0) (set ax (- 0 ax)))
    (set ay y)
    (if (< ay 0) (set ay (- 0 ay)))
    (if (and (== ax 0) (== ay 0)) (return 0))
    (if (<= ay ax)
      (set t (ev-atan-at 0 (ev-ratio ay ax)))
      (set t (- 9000 (ev-atan-at 0 (ev-ratio ax ay)))))
    (if (and (>= x 0) (>= y 0)) (set a t))
    (if (and (< x 0) (>= y 0)) (set a (- 18000 t)))
    (if (and (< x 0) (< y 0)) (set a (+ 18000 t)))
    (if (and (>= x 0) (< y 0)) (set a (- 36000 t)))
    (if (>= a 36000) (set a (- a 36000)))
    (return a)))

(defn ^:pub ^I32 ev-sin [^I32 cdeg]
  (comment "sin of an angle in centi-degrees, in 16.16 (65536 is 1): a generated table over 0..9000")
  (comment "and the symmetries, for any integer angle.")
  (let [^:mut ^I32 a (rem cdeg 36000)]
    (if (< a 0) (set a (+ a 36000)))
    (if (<= a 9000) (return (ev-sin-at 0 a)))
    (if (<= a 18000) (return (ev-sin-at 0 (- 18000 a))))
    (if (<= a 27000) (return (- 0 (ev-sin-at 0 (- a 18000)))))
    (return (- 0 (ev-sin-at 0 (- 36000 a))))))

(defn ^:pub ^I32 ev-cos [^I32 cdeg]
  (comment "cos of an angle in centi-degrees, in 16.16.")
  (return (ev-sin (+ (rem cdeg 36000) 9000))))

(defn ^:pub ^I64 ev-floordiv [^I64 a ^I64 b]
  (comment "a / b rounded toward minus infinity, for b > 0 (`quot` truncates toward zero).")
  (let [^I64 q (quot a b)]
    (if (< (- a (mul64 q b)) (i64 0))
      (return (- q (i64 1))))
    (return q)))

(defn ^I64 ev-round16 [^I64 v]
  (comment "floor((v + 2^15) / 2^16): a 16.16 value to the nearest integer, halves up (D096).")
  (return (ev-floordiv (add64 v (i64 32768)) (i64 65536))))

(defn ^:pub ^I32 ev-overlap-small [^I32 ax0 ^I32 ay0 ^I32 ax1 ^I32 ay1
                                   ^I32 bx0 ^I32 by0 ^I32 bx1 ^I32 by1]
  (comment "Intersection area over the SMALLER box's area, per-mille; 0 when they miss or the smaller is empty.")
  (let [^:mut ^I32 x0 ax0
        ^:mut ^I32 y0 ay0
        ^:mut ^I32 x1 ax1
        ^:mut ^I32 y1 ay1]
    (if (> bx0 x0) (set x0 bx0))
    (if (> by0 y0) (set y0 by0))
    (if (< bx1 x1) (set x1 bx1))
    (if (< by1 y1) (set y1 by1))
    (if (or (>= x0 x1) (>= y0 y1)) (return 0))
    (let [^I64 inter (mul64 (i64 (- x1 x0)) (i64 (- y1 y0)))
          ^I64 areaa (mul64 (i64 (- ax1 ax0)) (i64 (- ay1 ay0)))
          ^I64 areab (mul64 (i64 (- bx1 bx0)) (i64 (- by1 by0)))
          ^:mut ^I64 small areaa]
      (if (< areab small) (set small areab))
      (if (<= small (i64 0)) (return 0))
      (return (i32 (quot (mul64 inter (i64 1000)) small))))))

(defn ^:pub ^I32 ev-baseline-at [^I32 bx0 ^I32 by0 ^I32 bx1 ^I32 by1 ^I32 x]
  (comment "The segment's y at x, by integer interpolation (truncating); a vertical segment answers by1.")
  (if (<= bx1 bx0) (return by1))
  (return (+ by0 (i32 (quot (mul64 (i64 (- by1 by0)) (i64 (- x bx0))) (i64 (- bx1 bx0)))))))

;; ------------------------------------------------ the arenas with no builder of their own

(defn ^:pub ^I32 rf-count [^Cells c] (return (ev-count c 2)))
(defn ^:pub ^I32 rf-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 2 i f)))
(defn ^:pub ^I32 rf-add [^:mut ^Cells c ^I32 ea ^I32 index]
  (comment "Append a reference `(ea, index)` to any row of any arena; answers its row.")
  (let [^I32 r (ev-push c 2)]
    (ev-set c 2 r 0 ea)
    (ev-set c 2 r 1 index)
    (return r)))

(defn ^:pub ^I32 pt-add [^:mut ^Cells pts ^I32 x ^I32 y ^I32 op]
  (comment "Append a point of a path or contour (x y in centipoints, `op` a `po`); answers its row. (`pt-new`.)")
  (return (pt-new pts x y op)))

(defn ^:pub ^I32 fe-count [^Cells c] (return (ev-count c 32)))
(defn ^:pub ^I32 fe-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 32 i f)))
(defn ^:pub ^I32 fe-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 32 i f v)))
(defn ^:pub ^I32 fe-new [^:mut ^Cells c ^I32 ea ^I32 index]
  (comment "Append a feature row for the word at `(ea, index)`, every column -1 (not computed yet).")
  (let [^I32 r (ev-push c 32)
        ^:mut ^I32 k 2]
    (ev-set c 32 r 0 ea)
    (ev-set c 32 r 1 index)
    (while (< k 32)
      (do (ev-set c 32 r k -1)
          (set k (+ k 1))))
    (return r)))

(defn ^:pub ^I32 oa-add [^:mut ^Cells oalts ^I32 sym ^I32 tstart ^I32 tlen ^I32 conf]
  (comment "Append an alternative of symbol `sym`. A symbol's alternatives are a run, so they must all be")
  (comment "added before the next symbol's are (and the symbol's `afirst acount` set to the run);")
  (comment "`ev-check` holds it by asking every alternative to lie in its symbol's run.")
  (let [^I32 r (ev-push oalts 4)]
    (ev-set oalts 4 r 0 sym)
    (ev-set oalts 4 r 1 tstart)
    (ev-set oalts 4 r 2 tlen)
    (ev-set oalts 4 r 3 conf)
    (return r)))

;; --------------------------------------------------------------- marks

(defn ^:pub ^I32 mk-open [^:mut ^Cells marks ^I32 page ^I32 kind ^I32 tstart ^I32 tlen
                          ^I32 parent ^I32 gfirst ^I32 zfirst]
  (comment "Open a marked-content row (the caller keeps the stack of open rows: the `parent` it passes is")
  (comment "the innermost open one, -1 at the top). `gfirst` is the next glyph, `zfirst` the next paint")
  (comment "number. Answers the row. `mk-close` fills `gcount` and `zlast`.")
  (let [^I32 r (mk-new marks page kind tstart tlen parent gfirst)]
    (ev-set marks 24 r 20 zfirst)
    (return r)))

(defn ^:pub ^I32 mk-close [^:mut ^Cells marks ^I32 row ^I32 gnext ^I32 znext]
  (comment "Close the row: `gnext` the next glyph index and `znext` the next paint number AT THE CLOSE.")
  (comment "`gcount` = `gnext` - `gfirst`; `zlast` = `znext` - 1 (so a span that painted nothing has")
  (comment "`zlast` < `zfirst`).")
  (let [^I32 gfirst (ev-get marks 24 row 18)]
    (ev-set marks 24 row 19 (- gnext gfirst))
    (ev-set marks 24 row 21 (- znext 1))
    (return 0)))

(defn ^:pub ^I32 mk-artifact-of [^Cells marks ^I32 mark]
  (comment "The nearest artifact row on `mark`'s chain (itself, then its parents): its `/Type` * 16 +")
  (comment "its `/Subtype`, packed; 0 when none of the chain is an artifact. (SPEC 9.5 defence 1.)")
  (let [^:mut ^I32 t mark]
    (while (>= t 0)
      (do (if (== (ev-get marks 24 t 1) 1)
            (return (+ (* (ev-get marks 24 t 6) 16) (ev-get marks 24 t 7))))
          (set t (ev-get marks 24 t 4))))
    (return 0)))

(defn ^:pub ^I32 mk-artifact-class [^I32 kind ^I32 ty ^I32 su]
  (comment "D101's artifact class of a mark row, from its kind, /Type and /Subtype codes: 0 when it is not an")
  (comment "/Artifact; else `watermark` (the subtype), `background`, `pagination` (the type, or the subtype")
  (comment "header or footer), `layout`, else `other`. What v0 stored in a glyph's `artifact`.")
  (if (!= kind 1) (return 0))
  (if (== su 3) (return (ar-watermark)))
  (if (== ty 4) (return (ar-background)))
  (if (or (== ty 1) (or (== su 1) (== su 2))) (return (ar-pagination)))
  (if (== ty 3) (return (ar-layout)))
  (return (ar-other)))

(defn ^:pub ^I32 mk-ocg-of [^Cells marks ^I32 mark]
  (comment "The innermost optional-content row on `mark`'s chain, -1 when none.")
  (let [^:mut ^I32 t mark]
    (while (>= t 0)
      (do (if (== (ev-get marks 24 t 1) 2) (return t))
          (set t (ev-get marks 24 t 4))))
    (return -1)))

;; ---------------------------------------------------------------- views

(defn ^:pub ^I32 vw-new [^:mut ^Cells views ^I32 page ^I32 kind ^I32 request ^I32 parent
                         ^I32 pxw ^I32 pxh ^I32 dpi100 ^I32 layer ^I32 ink ^I32 turns
                         ^I32 deskew ^I32 cropx ^I32 cropy ^I32 flags]
  (comment "Append a view (SPEC 8.4.2) and compute its transform ONCE, from the integer parameters, so every")
  (comment "reader uses the same numbers. The raster shows the page region whose top-left is (cropx, cropy)")
  (comment "centipoints, turned `turns` quarter turns CLOCKWISE (as displayed) and its rows rotated `deskew`")
  (comment "centi-degrees counter-clockwise; `dpi100` is the resolution x100. px -> cpt is")
  (comment "x = e + (a*px + c*py) / 2^16, y = f + (b*px + d*py) / 2^16 (16.16 a b c d, e f centipoints), its")
  (comment "inverse px = (a'*dx + c'*dy) / 2^16, py = (b'*dx + d'*dy) / 2^16 with dx, dy from (e, f): stored at")
  (comment "`vwf-ia..id`. The scale is 720000 * 65536 / dpi100 in 64 bits; the quarter turns are exact; the")
  (comment "deskew is `ev-cos`/`ev-sin`. There is NO rounding at all at 72, 96, 150, 200, 300, 400 and 600 dpi")
  (comment "with no deskew.")
  (let [^I32 r (ev-push views 24)
        ^:mut ^I32 dpi dpi100
        ^:mut ^I32 q (rem turns 4)
        ^:mut ^I32 xx 1
        ^:mut ^I32 xy 0
        ^:mut ^I32 yx 0
        ^:mut ^I32 yy 1]
    (if (< dpi 1) (set dpi 7200))
    (if (< q 0) (set q (+ q 4)))
    (if (== q 1) (do (set xx 0) (set xy -1) (set yx 1) (set yy 0)))
    (if (== q 2) (do (set xx -1) (set xy 0) (set yx 0) (set yy -1)))
    (if (== q 3) (do (set xx 0) (set xy 1) (set yx -1) (set yy 0)))
    (let [^I64 s16 (quot (add64 (mul64 (i64 1440000) (i64 65536)) (i64 dpi)) (mul64 (i64 2) (i64 dpi)))
          ^I32 co (ev-cos deskew)
          ^I32 si (ev-sin deskew)
          ^I32 ux (+ (* xx co) (* xy si))
          ^I32 uy (+ (* xy co) (- 0 (* xx si)))
          ^I32 vx (+ (* yx co) (* yy si))
          ^I32 vy (+ (* yy co) (- 0 (* yx si)))]
      (comment "16.16 unit vectors of the raster's x and y axes in page space: (ux, uy) and (vx, vy).")
      (ev-set views 24 r 0 page)
      (ev-set views 24 r 1 kind)
      (ev-set views 24 r 2 request)
      (ev-set views 24 r 3 parent)
      (ev-set views 24 r 4 pxw)
      (ev-set views 24 r 5 pxh)
      (ev-set views 24 r 6 dpi100)
      (ev-set views 24 r 7 layer)
      (ev-set views 24 r 8 ink)
      (ev-set views 24 r 9 turns)
      (ev-set views 24 r 10 deskew)
      (ev-set views 24 r 11 cropx)
      (ev-set views 24 r 12 cropy)
      (ev-set views 24 r 13 (i32 (ev-round16 (mul64 s16 (i64 ux)))))
      (ev-set views 24 r 14 (i32 (ev-round16 (mul64 s16 (i64 uy)))))
      (ev-set views 24 r 15 (i32 (ev-round16 (mul64 s16 (i64 vx)))))
      (ev-set views 24 r 16 (i32 (ev-round16 (mul64 s16 (i64 vy)))))
      (comment "The inverse of a rotation times a scale is its transpose over the scale squared.")
      (ev-set views 24 r 19 (i32 (ev-floordiv (add64 (mul64 (i64 ux) (i64 65536)) (quot s16 (i64 2))) s16)))
      (ev-set views 24 r 20 (i32 (ev-floordiv (add64 (mul64 (i64 vx) (i64 65536)) (quot s16 (i64 2))) s16)))
      (ev-set views 24 r 21 (i32 (ev-floordiv (add64 (mul64 (i64 uy) (i64 65536)) (quot s16 (i64 2))) s16)))
      (ev-set views 24 r 22 (i32 (ev-floordiv (add64 (mul64 (i64 vy) (i64 65536)) (quot s16 (i64 2))) s16)))
      (ev-set views 24 r 23 flags)
      (comment "The page position of pixel (0, 0): a corner of the region, by the quarter turns.")
      (let [^I32 wcpt (i32 (ev-round16 (mul64 s16 (i64 pxw))))
            ^I32 hcpt (i32 (ev-round16 (mul64 s16 (i64 pxh))))
            ^:mut ^I32 e cropx
            ^:mut ^I32 f cropy]
        (if (== q 1) (set f (+ cropy wcpt)))
        (if (== q 2) (do (set e (+ cropx wcpt)) (set f (+ cropy hcpt))))
        (if (== q 3) (set e (+ cropx hcpt)))
        (ev-set views 24 r 17 e)
        (ev-set views 24 r 18 f)
        (return r)))))

(defn ^:pub ^I32 vw-px-to-cpt [^Cells views ^I32 v ^I32 axis ^I32 px ^I32 py]
  (comment "A pixel position of view `v` as page space: `axis` 0 the x, 1 the y, in centipoints (64-bit")
  (comment "arithmetic, round half up with FLOOR division, D096).")
  (if (== axis 0)
    (return (+ (ev-get views 24 v 17)
               (i32 (ev-round16 (add64 (mul64 (i64 (ev-get views 24 v 13)) (i64 px))
                                       (mul64 (i64 (ev-get views 24 v 15)) (i64 py))))))))
  (return (+ (ev-get views 24 v 18)
             (i32 (ev-round16 (add64 (mul64 (i64 (ev-get views 24 v 14)) (i64 px))
                                     (mul64 (i64 (ev-get views 24 v 16)) (i64 py))))))))

(defn ^:pub ^I32 vw-cpt-to-px [^Cells views ^I32 v ^I32 axis ^I32 x ^I32 y]
  (comment "A page position as a pixel of view `v` (the inverse; `axis` 0 the x, 1 the y).")
  (let [^I64 dx (i64 (- x (ev-get views 24 v 17)))
        ^I64 dy (i64 (- y (ev-get views 24 v 18)))]
    (if (== axis 0)
      (return (i32 (ev-round16 (add64 (mul64 (i64 (ev-get views 24 v 19)) dx)
                                      (mul64 (i64 (ev-get views 24 v 21)) dy))))))
    (return (i32 (ev-round16 (add64 (mul64 (i64 (ev-get views 24 v 20)) dx)
                                    (mul64 (i64 (ev-get views 24 v 22)) dy)))))))

(defn ^:pub ^I32 vw-box-to-cpt [^Cells views ^I32 v ^I32 k ^I32 px ^I32 py ^I32 pw ^I32 ph]
  (comment "The page box of a pixel box `x y w h` of view `v`: the four corners mapped, the smallest box")
  (comment "around them. `k` picks the answer: 0 x0, 1 y0, 2 x1, 3 y1.")
  (let [^I32 xa (vw-px-to-cpt views v 0 px py)
        ^I32 xb (vw-px-to-cpt views v 0 (+ px pw) py)
        ^I32 xc (vw-px-to-cpt views v 0 px (+ py ph))
        ^I32 xd (vw-px-to-cpt views v 0 (+ px pw) (+ py ph))
        ^I32 ya (vw-px-to-cpt views v 1 px py)
        ^I32 yb (vw-px-to-cpt views v 1 (+ px pw) py)
        ^I32 yc (vw-px-to-cpt views v 1 px (+ py ph))
        ^I32 yd (vw-px-to-cpt views v 1 (+ px pw) (+ py ph))
        ^:mut ^I32 lo 0
        ^:mut ^I32 hi 0]
    (if (== k 0)
      (do (set lo xa)
          (if (< xb lo) (set lo xb))
          (if (< xc lo) (set lo xc))
          (if (< xd lo) (set lo xd))
          (return lo)))
    (if (== k 1)
      (do (set lo ya)
          (if (< yb lo) (set lo yb))
          (if (< yc lo) (set lo yc))
          (if (< yd lo) (set lo yd))
          (return lo)))
    (if (== k 2)
      (do (set hi xa)
          (if (> xb hi) (set hi xb))
          (if (> xc hi) (set hi xc))
          (if (> xd hi) (set hi xd))
          (return hi)))
    (set hi ya)
    (if (> yb hi) (set hi yb))
    (if (> yc hi) (set hi yc))
    (if (> yd hi) (set hi yd))
    (return hi)))


;; ----------------------------------------------- the arenas, by their `ea` code

(defn ^:pub ^I32 ev-len [^I32 ea ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "The number of cells of arena `ea` (its `ea` code, SPEC 8.4.6); 0 for a code that is none.")
  (if (== ea 1) (return (cells-len epages)))
  (if (== ea 2) (return (cells-len views)))
  (if (== ea 3) (return (cells-len pts)))
  (if (== ea 4) (return (cells-len refs)))
  (if (== ea 5) (return (cells-len etext)))
  (if (== ea 6) (return (cells-len feats)))
  (if (== ea 7) (return (cells-len glyphs)))
  (if (== ea 8) (return (cells-len words)))
  (if (== ea 9) (return (cells-len lines)))
  (if (== ea 10) (return (cells-len marks)))
  (if (== ea 11) (return (cells-len fonts)))
  (if (== ea 12) (return (cells-len paths)))
  (if (== ea 13) (return (cells-len images)))
  (if (== ea 14) (return (cells-len oruns)))
  (if (== ea 15) (return (cells-len oblocks)))
  (if (== ea 16) (return (cells-len olines)))
  (if (== ea 17) (return (cells-len owords)))
  (if (== ea 18) (return (cells-len osyms)))
  (if (== ea 19) (return (cells-len oalts)))
  (if (== ea 20) (return (cells-len inks)))
  (if (== ea 21) (return (cells-len components)))
  (if (== ea 22) (return (cells-len rules)))
  (if (== ea 23) (return (cells-len prims)))
  (if (== ea 24) (return (cells-len tlines)))
  (return 0))

(defn ^:pub ^I32 ev-peek [^I32 ea ^I32 row ^I32 f ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Cell `f` of row `row` of arena `ea`.")
  (if (== ea 1) (return (cells-at epages (+ (* row 12) f))))
  (if (== ea 2) (return (cells-at views (+ (* row 24) f))))
  (if (== ea 3) (return (cells-at pts (+ (* row 3) f))))
  (if (== ea 4) (return (cells-at refs (+ (* row 2) f))))
  (if (== ea 5) (return (cells-at etext (+ (* row 1) f))))
  (if (== ea 6) (return (cells-at feats (+ (* row 32) f))))
  (if (== ea 7) (return (cells-at glyphs (+ (* row 32) f))))
  (if (== ea 8) (return (cells-at words (+ (* row 24) f))))
  (if (== ea 9) (return (cells-at lines (+ (* row 16) f))))
  (if (== ea 10) (return (cells-at marks (+ (* row 24) f))))
  (if (== ea 11) (return (cells-at fonts (+ (* row 16) f))))
  (if (== ea 12) (return (cells-at paths (+ (* row 24) f))))
  (if (== ea 13) (return (cells-at images (+ (* row 20) f))))
  (if (== ea 14) (return (cells-at oruns (+ (* row 28) f))))
  (if (== ea 15) (return (cells-at oblocks (+ (* row 16) f))))
  (if (== ea 16) (return (cells-at olines (+ (* row 24) f))))
  (if (== ea 17) (return (cells-at owords (+ (* row 28) f))))
  (if (== ea 18) (return (cells-at osyms (+ (* row 20) f))))
  (if (== ea 19) (return (cells-at oalts (+ (* row 4) f))))
  (if (== ea 20) (return (cells-at inks (+ (* row 12) f))))
  (if (== ea 21) (return (cells-at components (+ (* row 24) f))))
  (if (== ea 22) (return (cells-at rules (+ (* row 20) f))))
  (if (== ea 23) (return (cells-at prims (+ (* row 24) f))))
  (if (== ea 24) (return (cells-at tlines (+ (* row 20) f))))
  (return 0))

(defn ^:pub ^I32 ev-poke [^I32 ea ^I32 row ^I32 f ^I32 v ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Set cell `f` of row `row` of arena `ea` to `v` (the laws break a page with it).")
  (if (== ea 1) (do (cells-set epages (+ (* row 12) f) v) (return 0)))
  (if (== ea 2) (do (cells-set views (+ (* row 24) f) v) (return 0)))
  (if (== ea 3) (do (cells-set pts (+ (* row 3) f) v) (return 0)))
  (if (== ea 4) (do (cells-set refs (+ (* row 2) f) v) (return 0)))
  (if (== ea 5) (do (cells-set etext (+ (* row 1) f) v) (return 0)))
  (if (== ea 6) (do (cells-set feats (+ (* row 32) f) v) (return 0)))
  (if (== ea 7) (do (cells-set glyphs (+ (* row 32) f) v) (return 0)))
  (if (== ea 8) (do (cells-set words (+ (* row 24) f) v) (return 0)))
  (if (== ea 9) (do (cells-set lines (+ (* row 16) f) v) (return 0)))
  (if (== ea 10) (do (cells-set marks (+ (* row 24) f) v) (return 0)))
  (if (== ea 11) (do (cells-set fonts (+ (* row 16) f) v) (return 0)))
  (if (== ea 12) (do (cells-set paths (+ (* row 24) f) v) (return 0)))
  (if (== ea 13) (do (cells-set images (+ (* row 20) f) v) (return 0)))
  (if (== ea 14) (do (cells-set oruns (+ (* row 28) f) v) (return 0)))
  (if (== ea 15) (do (cells-set oblocks (+ (* row 16) f) v) (return 0)))
  (if (== ea 16) (do (cells-set olines (+ (* row 24) f) v) (return 0)))
  (if (== ea 17) (do (cells-set owords (+ (* row 28) f) v) (return 0)))
  (if (== ea 18) (do (cells-set osyms (+ (* row 20) f) v) (return 0)))
  (if (== ea 19) (do (cells-set oalts (+ (* row 4) f) v) (return 0)))
  (if (== ea 20) (do (cells-set inks (+ (* row 12) f) v) (return 0)))
  (if (== ea 21) (do (cells-set components (+ (* row 24) f) v) (return 0)))
  (if (== ea 22) (do (cells-set rules (+ (* row 20) f) v) (return 0)))
  (if (== ea 23) (do (cells-set prims (+ (* row 24) f) v) (return 0)))
  (if (== ea 24) (do (cells-set tlines (+ (* row 20) f) v) (return 0)))
  (return 0))

;; the dump key (an `ek` code) of each arena's name, index = ea - 1
(defdata ^:pub ev-ea-key
  :emitter kin.lang/flat-array
  :data [55 56 57 58 59 60 2 3 4 61 62 5 6 63 64 65 66 67 68 69 7 70 71 72]
  :accessors {^I32 ev-ea-key-count [^I32 ignored]
              ^I32 ev-ea-key-at [^I32 ignored ^I32 i]})

;; ------------------------------------------------------ features (SPEC 8.4.5)
;;
;; Stage 1 of the feature vector for an OCR word: the columns that need only the OCR answer and the page.
;; Each is an integer computed by a named function here; columns whose stage comes later stay -1.

(defn ^:pub ^I32 ev-page-row [^Cells epages ^I32 page]
  (comment "The `epages` row of `page`, -1 when there is none.")
  (let [^I32 n (quot (cells-len epages) 12)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (if (== (ev-get epages 12 i (epf-page)) page) (return i))
          (set i (+ i 1))))
    (return -1)))

(defn ^I32 ev-lower-median [^Cells c ^I32 stride ^I32 first ^I32 cnt ^I32 f]
  (comment "The LOWER MEDIAN of cell `f` of rows [first, first + cnt) of an arena: the ((cnt - 1) / 2)th smallest;")
  (comment "0 for no rows.")
  (let [^I32 k (quot (- cnt 1) 2)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 less 0
        ^:mut ^I32 leq 0
        ^:mut ^I32 r 0
        ^:mut ^I32 rj 0]
    (if (<= cnt 0) (return 0))
    (while (< i cnt)
      (do (set r (ev-get c stride (+ first i) f))
          (set less 0)
          (set leq 0)
          (set j 0)
          (while (< j cnt)
            (do (set rj (ev-get c stride (+ first j) f))
                (if (< rj r) (set less (+ less 1)))
                (if (<= rj r) (set leq (+ leq 1)))
                (set j (+ j 1))))
          (if (and (<= less k) (< k leq)) (return r))
          (set i (+ i 1))))
    (return 0)))

(defn ^:pub ^I32 ev-rot-median [^Cells olines ^I32 first ^I32 cnt]
  (comment "The page's dominant text angle for `xo-angle`: the lower median of the `rot` of the OCR lines")
  (comment "[first, first + cnt) (an OCR run's); 0 for no line.")
  (return (ev-lower-median olines 24 first cnt (lh-rot))))

(defn ^I32 ev-word-cls [^I32 c]
  (comment "A code point's class for `xo-implausible`: 1 lowercase letter, 2 uppercase letter, 3 digit, 0 anything")
  (comment "else (only ASCII and Latin-1 are classed: what is not is never implausible).")
  (if (and (>= c 97) (<= c 122)) (return 1))
  (if (and (>= c 65) (<= c 90)) (return 2))
  (if (and (>= c 48) (<= c 57)) (return 3))
  (if (== c 223) (return 1))
  (if (and (>= c 224) (<= c 246)) (return 1))
  (if (and (>= c 248) (<= c 255)) (return 1))
  (if (and (>= c 192) (<= c 214)) (return 2))
  (if (and (>= c 216) (<= c 222)) (return 2))
  (return 0))

(defn ^I32 ev-implausible [^Cells etext ^I32 ts ^I32 n]
  (comment "Per-mille of the adjacent code-point pairs of etext[ts, ts + n) that are letter <-> digit or")
  (comment "lowercase -> uppercase (floor); 0 for one code point or none.")
  (let [^:mut ^I32 i 1
        ^:mut ^I32 bad 0
        ^:mut ^I32 p 0
        ^:mut ^I32 q 0]
    (if (< n 2) (return 0))
    (while (< i n)
      (do (set p (ev-word-cls (cells-at etext (+ ts (- i 1)))))
          (set q (ev-word-cls (cells-at etext (+ ts i))))
          (if (and (!= p 0) (!= q 0))
            (do (if (and (== p 3) (!= q 3)) (set bad (+ bad 1)))
                (if (and (!= p 3) (== q 3)) (set bad (+ bad 1)))
                (if (and (== p 1) (== q 2)) (set bad (+ bad 1)))))
          (set i (+ i 1))))
    (return (quot (* bad 1000) (- n 1)))))

(defn ^I32 ev-sym-alt-same [^Cells osyms ^Cells oalts ^Cells etext ^I32 s ^I32 a]
  (comment "1 when alternative a has the same text as symbol s: the symbol's `etext` run when it has one (a")
  (comment "ligature), else its one code point.")
  (let [^I32 ts (ev-get osyms 20 s (ch-tstart))
        ^I32 tl (ev-get osyms 20 s (ch-tlen))
        ^I32 cp (ev-get osyms 20 s (ch-cp))
        ^I32 as (ev-get oalts 4 a (oaf-tstart))
        ^I32 al (ev-get oalts 4 a (oaf-tlen))
        ^:mut ^I32 sl 1
        ^:mut ^I32 k 0]
    (if (and (>= ts 0) (> tl 0)) (set sl tl))
    (if (and (< ts 0) (< cp 0)) (set sl 0))
    (if (!= sl al) (return 0))
    (while (< k al)
      (do (if (and (>= ts 0) (> tl 0))
            (if (!= (cells-at etext (+ ts k)) (cells-at etext (+ as k))) (return 0))
            (if (!= cp (cells-at etext (+ as k))) (return 0)))
          (set k (+ k 1))))
    (return 1)))

(defn ^I32 ev-sym-start [^Cells osyms ^I32 s ^I32 q]
  (comment "Where symbol s begins along a line whose direction is quadrant q (0 right, 1 up, 2 left, 3 down).")
  (if (== q 0) (return (ev-get osyms 20 s (ch-x0))))
  (if (== q 1) (return (- 0 (ev-get osyms 20 s (ch-y1)))))
  (if (== q 2) (return (- 0 (ev-get osyms 20 s (ch-x1)))))
  (return (ev-get osyms 20 s (ch-y0))))

(defn ^I32 ev-sym-end [^Cells osyms ^I32 s ^I32 q]
  (if (== q 0) (return (ev-get osyms 20 s (ch-x1))))
  (if (== q 1) (return (- 0 (ev-get osyms 20 s (ch-y0)))))
  (if (== q 2) (return (- 0 (ev-get osyms 20 s (ch-x0)))))
  (return (ev-get osyms 20 s (ch-y1))))

(defn ^I32 ev-spacing [^Cells osyms ^I32 sf ^I32 sn ^I32 rot]
  (comment "The mean gap between consecutive symbols over the mean symbol width, per-mille, both along the")
  (comment "word's writing direction (the quadrant of `rot`); -1 for fewer than two symbols or no width.")
  (let [^:mut ^I32 q (rem (quot (+ rot 4500) 9000) 4)
        ^:mut ^I64 gaps (i64 0)
        ^:mut ^I64 widths (i64 0)
        ^:mut ^I32 i 0]
    (if (< sn 2) (return -1))
    (while (< i sn)
      (do (set widths (add64 widths (i64 (- (ev-sym-end osyms (+ sf i) q) (ev-sym-start osyms (+ sf i) q)))))
          (if (< (+ i 1) sn)
            (set gaps (add64 gaps (i64 (- (ev-sym-start osyms (+ sf (+ i 1)) q) (ev-sym-end osyms (+ sf i) q))))))
          (set i (+ i 1))))
    (if (<= widths (i64 0)) (return -1))
    (return (i32 (quot (mul64 (mul64 gaps (i64 1000)) (i64 sn)) (mul64 widths (i64 (- sn 1))))))))

(defn ^I32 ev-height-median [^Cells owords ^I32 first ^I32 cnt]
  (comment "The lower median of the box heights of OCR words [first, first + cnt); 0 for none.")
  (let [^I32 k (quot (- cnt 1) 2)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 less 0
        ^:mut ^I32 leq 0
        ^:mut ^I32 h 0
        ^:mut ^I32 hj 0]
    (if (<= cnt 0) (return 0))
    (while (< i cnt)
      (do (set h (- (ev-get owords 28 (+ first i) (hd-y1)) (ev-get owords 28 (+ first i) (hd-y0))))
          (set less 0)
          (set leq 0)
          (set j 0)
          (while (< j cnt)
            (do (set hj (- (ev-get owords 28 (+ first j) (hd-y1)) (ev-get owords 28 (+ first j) (hd-y0))))
                (if (< hj h) (set less (+ less 1)))
                (if (<= hj h) (set leq (+ leq 1)))
                (set j (+ j 1))))
          (if (and (<= less k) (< k leq)) (return h))
          (set i (+ i 1))))
    (return 0)))

(defn ^:pub ^I32 ev-feat-ocr [^:mut ^Cells feats ^Cells epages ^Cells etext ^Cells olines
                              ^:mut ^Cells owords ^Cells osyms ^Cells oalts
                              ^I32 w ^I32 rotmed ^I32 altclose]
  (comment "Stage 1 features of OCR word w (SPEC 8.4.5): a new `feats` row, the word's `feat` pointed at it,")
  (comment "columns 2-8, 17, 19, 20, 21, 28 and 29 computed from the answer alone (the others -1).")
  (comment "2 the raw word confidence; 3 the lowest and 4 the mean (floor) symbol confidence; 5 the smallest")
  (comment "MARGIN: over the symbols that have a differing alternative, the symbol's confidence less the best")
  (comment "differing alternative's (-1 if none has one); 6 the symbols whose margin is at most `altclose`;")
  (comment "7 the engine's flags; 8 the implausible class transitions; 17 the height over its line's median,")
  (comment "per-mille; 19 the angle to `rotmed`, the run's dominant line angle; 20 the distance of the word's")
  (comment "baseline midpoint from its line's baseline there; 21 the mean gap between symbols over their mean")
  (comment "width, per-mille (along the writing direction); 28 the code points; 29 the distance to the nearest page")
  (comment "edge. The text is `etext`'s.")
  (let [^I32 row (fe-new feats 17 w)
        ^I32 sf (ev-get owords 28 w (owf-sfirst))
        ^I32 sn (ev-get owords 28 w (owf-scount))
        ^I32 ts (ev-get owords 28 w (hd-tstart))
        ^I32 tl (ev-get owords 28 w (hd-tlen))
        ^I32 pg (ev-get owords 28 w (hd-page))
        ^I32 lineix (ev-get owords 28 w (hd-line))
        ^I32 rot (ev-get owords 28 w (hd-rot))
        ^:mut ^I32 s 0
        ^:mut ^I32 lo -1
        ^:mut ^I32 sum 0
        ^:mut ^I32 nconf 0
        ^:mut ^I32 minmargin 2147483647
        ^:mut ^I32 nmargin 0
        ^:mut ^I32 ambiguous 0
        ^:mut ^I32 a 0
        ^:mut ^I32 af 0
        ^:mut ^I32 ac 0
        ^:mut ^I32 best -1
        ^:mut ^I32 sc 0
        ^:mut ^I32 marg 0
        ^:mut ^I32 d 0
        ^:mut ^I32 med 0
        ^:mut ^I32 lf 0
        ^:mut ^I32 lc 0
        ^:mut ^I32 xm 0
        ^:mut ^I32 ym 0
        ^:mut ^I32 ep 0]
    (ev-set owords 28 w (hd-feat) row)
    (fe-set feats row (xo-conf) (ev-get owords 28 w (hd-conf)))
    (set s sf)
    (while (< s (+ sf sn))
      (do (set sc (ev-get osyms 20 s (osf-conf)))
          (if (>= sc 0)
            (do (set sum (+ sum sc))
                (set nconf (+ nconf 1))
                (if (or (< lo 0) (< sc lo)) (set lo sc))))
          (set af (ev-get osyms 20 s (osf-afirst)))
          (set ac (ev-get osyms 20 s (osf-acount)))
          (set best -1)
          (set a af)
          (while (< a (+ af ac))
            (do (if (== (ev-sym-alt-same osyms oalts etext s a) 0)
                  (if (> (ev-get oalts 4 a (oaf-conf)) best) (set best (ev-get oalts 4 a (oaf-conf)))))
                (set a (+ a 1))))
          (if (and (>= best 0) (>= sc 0))
            (do (set marg (- sc best))
                (set nmargin (+ nmargin 1))
                (if (< marg minmargin) (set minmargin marg))
                (if (<= marg altclose) (set ambiguous (+ ambiguous 1)))))
          (set s (+ s 1))))
    (if (> nconf 0)
      (do (fe-set feats row (xo-sym-min) lo)
          (fe-set feats row (xo-sym-mean) (quot sum nconf))))
    (if (> nmargin 0)
      (do (fe-set feats row (xo-margin) minmargin)
          (fe-set feats row (xo-ambiguous) ambiguous)))
    (fe-set feats row (xo-engine-flags) (ev-get owords 28 w (owf-flags)))
    (fe-set feats row (xo-implausible) (ev-implausible etext ts tl))
    (set d (- rot rotmed))
    (if (< d 0) (set d (- 0 d)))
    (if (> d 18000) (set d (- 36000 d)))
    (fe-set feats row (xo-angle) d)
    (fe-set feats row (xo-spacing) (ev-spacing osyms sf sn rot))
    (fe-set feats row (xo-length) tl)
    (if (>= lineix 0)
      (do (set lf (ev-get olines 24 lineix (lh-first)))
          (set lc (ev-get olines 24 lineix (lh-count)))
          (set med (ev-height-median owords lf lc))
          (if (> med 0)
            (fe-set feats row (xo-rel-height)
                    (i32 (quot (mul64 (i64 (- (ev-get owords 28 w (hd-y1)) (ev-get owords 28 w (hd-y0)))) (i64 1000)) (i64 med)))))
          (set xm (quot (+ (ev-get owords 28 w (hd-bx0)) (ev-get owords 28 w (hd-bx1))) 2))
          (set ym (quot (+ (ev-get owords 28 w (hd-by0)) (ev-get owords 28 w (hd-by1))) 2))
          (set d (- ym (ev-baseline-at (ev-get olines 24 lineix (lh-bx0)) (ev-get olines 24 lineix (lh-by0))
                                       (ev-get olines 24 lineix (lh-bx1)) (ev-get olines 24 lineix (lh-by1)) xm)))
          (if (< d 0) (set d (- 0 d)))
          (fe-set feats row (xo-base-dev) d)))
    (set ep (ev-page-row epages pg))
    (if (>= ep 0)
      (do (set d (ev-get owords 28 w (hd-x0)))
          (if (< (ev-get owords 28 w (hd-y0)) d) (set d (ev-get owords 28 w (hd-y0))))
          (if (< (- (ev-get epages 12 ep (epf-width)) (ev-get owords 28 w (hd-x1))) d)
            (set d (- (ev-get epages 12 ep (epf-width)) (ev-get owords 28 w (hd-x1)))))
          (if (< (- (ev-get epages 12 ep (epf-height)) (ev-get owords 28 w (hd-y1))) d)
            (set d (- (ev-get epages 12 ep (epf-height)) (ev-get owords 28 w (hd-y1)))))
          (if (< d 0) (set d 0))
          (fe-set feats row (xo-edge) d)))
    (return row)))


(defn ^:pub ^I32 ev-rows [^I32 ea ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "The rows of arena `ea` (its length over its stride); 0 for a code that is none.")
  (if (or (< ea 1) (> ea 24)) (return 0))
  (let [^I32 nlen (ev-len ea epages views pts refs etext feats glyphs words lines marks fonts paths images
                         oruns oblocks olines owords osyms oalts inks components rules prims tlines)]
    (return (quot nlen (ev-strides-at 0 (- ea 1))))))

;; ------------------------------------------------------------------ check

(defn ^:pub ^I32 ev-run-ok [^I32 start ^I32 n ^I32 total]
  (comment "1 when [start, start+n) lies inside [0, total), or the run is empty")
  (comment "and absent (start -1, n 0 -- or any start with n 0).")
  (if (< n 0) (return 0))
  (if (== n 0) (return 1))
  (if (< start 0) (return 0))
  (if (> start total) (return 0))
  (if (> n (- total start)) (return 0))
  (return 1))

(defn ^:pub ^I32 ev-check [^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                           ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                           ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                           ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                           ^:mut ^Cells images
                           ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                           ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                           ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                           ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "0 when the evidence is well formed; otherwise the code of the first thing that is not.")
  (comment "1: an arena whose length is not a whole number of rows. 2..89: the rows of `ev-ck` in order (a")
  (comment "text run, a run, an index, an index to an earlier row, a back pointer that the row it points to")
  (comment "does not cover, a box with x0 > x1 or y0 > y1: read its row for which). 100: a `refs` row")
  (comment "whose arena or index is none; 101: a `feats` row whose subject is not a word; 102: a word whose")
  (comment "`feat` row does not name it. The OCR nesting block > paragraph > line > word > symbol >")
  (comment "alternative is the back-pointer rows: a child lies in the run of the row it points to, and in")
  (comment "its run's range, so nothing is counted twice and nothing is orphaned.")
  (let [^:mut ^I32 ea 1
        ^:mut ^I32 k 0
        ^:mut ^I32 i 0
        ^:mut ^I32 n 0
        ^:mut ^I32 nt 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 f1 0
        ^:mut ^I32 f2 0
        ^:mut ^I32 tg 0
        ^:mut ^I32 v1 0
        ^:mut ^I32 v2 0
        ^:mut ^I32 nlen 0
        ^:mut ^I32 sea 0]
    (while (<= ea 24)
      (do (set nlen (ev-len ea epages views pts refs etext feats glyphs words lines marks fonts paths images
                           oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (if (!= (rem nlen (ev-strides-at 0 (- ea 1))) 0) (return 1))
          (set ea (+ ea 1))))
    (set k 0)
    (while (< k (ev-ck-count 0))
      (do (set ea (ev-ck-at 0 k 1))
          (set kind (ev-ck-at 0 k 2))
          (set f1 (ev-ck-at 0 k 3))
          (set f2 (ev-ck-at 0 k 4))
          (set tg (ev-ck-at 0 k 5))
          (set n (ev-rows ea epages views pts refs etext feats glyphs words lines marks fonts paths images
                          oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (set nt (ev-rows tg epages views pts refs etext feats glyphs words lines marks fonts paths images
                           oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (set i 0)
          (while (< i n)
            (do (set v1 (ev-peek ea i f1 epages views pts refs etext feats glyphs words lines marks fonts paths images
                                 oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                (if (or (== kind 1) (== kind 2))
                  (do (set v2 (ev-peek ea i f2 epages views pts refs etext feats glyphs words lines marks fonts paths images
                                       oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                      (if (or (>= v1 0) (== kind 2))
                        (if (== (ev-run-ok v1 v2 nt) 0) (return (ev-ck-at 0 k 0))))))
                (if (== kind 3)
                  (if (or (< v1 -1) (>= v1 nt)) (return (ev-ck-at 0 k 0))))
                (if (== kind 4)
                  (if (or (< v1 0) (>= v1 nt)) (return (ev-ck-at 0 k 0))))
                (if (== kind 5)
                  (if (or (< v1 -1) (>= v1 i)) (return (ev-ck-at 0 k 0))))
                (if (== kind 6)
                  (if (>= v1 0)
                    (do (if (>= v1 nt) (return (ev-ck-at 0 k 0)))
                        (set v2 (ev-peek tg v1 f2 epages views pts refs etext feats glyphs words lines marks fonts paths images
                                         oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                        (set nlen (ev-peek tg v1 (+ f2 1) epages views pts refs etext feats glyphs words lines marks fonts paths images
                                          oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                        (if (or (< i v2) (>= i (+ v2 nlen))) (return (ev-ck-at 0 k 0))))))
                (if (== kind 8)
                  (do (set v2 (ev-peek ea i (+ f1 2) epages views pts refs etext feats glyphs words lines marks fonts paths images
                                       oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                      (if (> v1 v2) (return (ev-ck-at 0 k 0)))
                      (set v1 (ev-peek ea i (+ f1 1) epages views pts refs etext feats glyphs words lines marks fonts paths images
                                       oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                      (set v2 (ev-peek ea i (+ f1 3) epages views pts refs etext feats glyphs words lines marks fonts paths images
                                       oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                      (if (> v1 v2) (return (ev-ck-at 0 k 0)))))
                (set i (+ i 1))))
          (set k (+ k 1))))
    (comment "references: the arena and the row exist")
    (set i 0)
    (while (< i (quot (cells-len refs) 2))
      (do (set ea (cells-at refs (* i 2)))
          (if (or (< ea 1) (> ea 24)) (return 100))
          (set n (ev-rows ea epages views pts refs etext feats glyphs words lines marks fonts paths images
                          oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (if (or (< (cells-at refs (+ (* i 2) 1)) 0) (>= (cells-at refs (+ (* i 2) 1)) n)) (return 100))
          (set i (+ i 1))))
    (comment "features: the subject is a word (text layer or OCR) that exists, and it names its row back")
    (set i 0)
    (while (< i (quot (cells-len feats) 32))
      (do (set sea (cells-at feats (* i 32)))
          (if (and (!= sea 8) (!= sea 17)) (return 101))
          (set n (ev-rows sea epages views pts refs etext feats glyphs words lines marks fonts paths images
                          oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (if (or (< (cells-at feats (+ (* i 32) 1)) 0) (>= (cells-at feats (+ (* i 32) 1)) n)) (return 101))
          (set i (+ i 1))))
    (set i 0)
    (while (< i (quot (cells-len words) 24))
      (do (set v1 (cells-at words (+ (* i 24) 15)))
          (if (>= v1 0)
            (if (or (!= (cells-at feats (* v1 32)) 8) (!= (cells-at feats (+ (* v1 32) 1)) i)) (return 102)))
          (set i (+ i 1))))
    (set i 0)
    (while (< i (quot (cells-len owords) 28))
      (do (set v1 (cells-at owords (+ (* i 28) 15)))
          (if (>= v1 0)
            (if (or (!= (cells-at feats (* v1 32)) 17) (!= (cells-at feats (+ (* v1 32) 1)) i)) (return 102)))
          (set i (+ i 1))))
    (return 0)))

;; ------------------------------------------------------------------- dump
;;
;; Fixed key order per row (the stride order), defaults omitted, exactly the Model's rules (`emon.json`).
;; `ev-begin` is `js-begin` with THIS module's key table.

(defn ^:pub ^I32 ev-begin [^:mut ^Text t ^I32 pr ^I32 d ^I32 started ^I32 code]
  (if (== started 1) (emit-ascii t ","))
  (if (== pr 1) (js-indent t (+ d 1)))
  (emit-ascii t "\"")
  (ek-emit-name t code)
  (emit-ascii t "\":")
  (if (== pr 1) (emit-ascii t " "))
  (return 1))

(defn ^I32 ev-fint [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                    ^I32 f ^I32 key ^I32 dflt ^I32 started]
  (comment "`\"key\":value` when the field is not its default.")
  (let [^I32 v (ev-get c stride row f)]
    (if (== v dflt) (return started))
    (ev-begin t pr d started key)
    (text-i32 t v)
    (return 1)))

(defn ^I32 ev-fcpt [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                    ^I32 f ^I32 key ^I32 dflt ^I32 started]
  (comment "As `ev-fint`, written in points (centipoints or centi-degrees).")
  (let [^I32 v (ev-get c stride row f)]
    (if (== v dflt) (return started))
    (ev-begin t pr d started key)
    (js-cpt t v)
    (return 1)))

(defn ^I32 ev-fquad [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                     ^I32 f ^I32 key ^I32 started]
  (comment "`\"key\":[a,b,c,d]`, four cells f..f+3, in points: a box, a baseline.")
  (ev-begin t pr d started key)
  (emit-ascii t "[")
  (js-cpt t (ev-get c stride row f))
  (js-fsep t pr 1)
  (js-cpt t (ev-get c stride row (+ f 1)))
  (js-fsep t pr 1)
  (js-cpt t (ev-get c stride row (+ f 2)))
  (js-fsep t pr 1)
  (js-cpt t (ev-get c stride row (+ f 3)))
  (emit-ascii t "]")
  (return 1))

(defn ^I32 ev-fpx4 [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                    ^I32 f ^I32 key ^I32 started]
  (comment "A pixel box `\"key\":[x,y,w,h]` in integers; omitted when it has no area (w and h 0).")
  (if (and (== (ev-get c stride row (+ f 2)) 0) (== (ev-get c stride row (+ f 3)) 0))
    (return started))
  (ev-begin t pr d started key)
  (emit-ascii t "[")
  (text-i32 t (ev-get c stride row f))
  (js-fsep t pr 1)
  (text-i32 t (ev-get c stride row (+ f 1)))
  (js-fsep t pr 1)
  (text-i32 t (ev-get c stride row (+ f 2)))
  (js-fsep t pr 1)
  (text-i32 t (ev-get c stride row (+ f 3)))
  (emit-ascii t "]")
  (return 1))

(defn ^I32 ev-fpair [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                     ^I32 f ^I32 key ^I32 d1 ^I32 d2 ^I32 pts ^I32 started]
  (comment "Two cells as `\"key\":[a,b]`, integers (pts 0) or points (pts 1); omitted when they are (d1, d2).")
  (if (and (== (ev-get c stride row f) d1) (== (ev-get c stride row (+ f 1)) d2))
    (return started))
  (ev-begin t pr d started key)
  (emit-ascii t "[")
  (if (== pts 1) (js-cpt t (ev-get c stride row f)) (text-i32 t (ev-get c stride row f)))
  (js-fsep t pr 1)
  (if (== pts 1) (js-cpt t (ev-get c stride row (+ f 1))) (text-i32 t (ev-get c stride row (+ f 1))))
  (emit-ascii t "]")
  (return 1))

(defn ^I32 ev-fcolor [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                      ^I32 f ^I32 key ^I32 started]
  (comment "A colour as `\"#rrggbb\"`; -1 (none) is omitted.")
  (let [^I32 v (ev-get c stride row f)]
    (if (< v 0) (return started))
    (ev-begin t pr d started key)
    (emit-ascii t "\"#")
    (js-hex t (bit-and (sar32 v 20) 15))
    (js-hex t (bit-and (sar32 v 16) 15))
    (js-hex t (bit-and (sar32 v 12) 15))
    (js-hex t (bit-and (sar32 v 8) 15))
    (js-hex t (bit-and (sar32 v 4) 15))
    (js-hex t (bit-and v 15))
    (emit-ascii t "\"")
    (return 1)))

(defn ^I32 ev-fpacked [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                       ^I32 f ^I32 key ^I32 started]
  (comment "Up to four ASCII characters packed big-endian in one cell (a script, a language) as a string; 0 is omitted.")
  (let [^I32 v (ev-get c stride row f)
        ^:mut ^I32 sh 24
        ^:mut ^I32 ch 0]
    (if (== v 0) (return started))
    (ev-begin t pr d started key)
    (emit-ascii t "\"")
    (while (>= sh 0)
      (do (set ch (bit-and (sar32 v sh) 255))
          (if (and (> ch 31) (< ch 127))
            (if (and (!= ch 34) (!= ch 92)) (text-cp t ch)))
          (set sh (- sh 8))))
    (emit-ascii t "\"")
    (return 1)))

(defn ^I32 ev-ftextk [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                      ^I32 fstart ^Cells etext ^I32 key ^I32 started]
  (comment "A text run of `etext` (cells fstart, fstart+1) as a string; an absent run (start -1) is omitted.")
  (let [^I32 s (ev-get c stride row fstart)]
    (if (< s 0) (return started))
    (ev-begin t pr d started key)
    (js-str t etext s (ev-get c stride row (+ fstart 1)))
    (return 1)))

(defn ^I32 ev-frun [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                    ^I32 f ^I32 key ^I32 started]
  (comment "A run as `\"key\":[first,count]`.")
  (ev-begin t pr d started key)
  (emit-ascii t "[")
  (text-i32 t (ev-get c stride row f))
  (js-fsep t pr 1)
  (text-i32 t (ev-get c stride row (+ f 1)))
  (emit-ascii t "]")
  (return 1))

(defn ^I32 ev-fbits [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^I32 stride ^I32 row
                     ^I32 f ^I32 which ^I32 key ^I32 started]
  (comment "A bit set as an array of names: which 1 `sr`, 2 `fl`, 3 `sy`, 4 `pg`, 5 `mg`, 6 `mc`, 7 `eg`, 8 `vg`,")
  (comment "9 `oe`, 10 `os`, 11 `vc`. Zero is omitted.")
  (let [^I32 v (ev-get c stride row f)
        ^:mut ^I32 b 0
        ^:mut ^I32 k 0
        ^:mut ^I32 bit 1]
    (if (== v 0) (return started))
    (ev-begin t pr d started key)
    (if (== which 1) (js-bits-src t pr v))
    (if (== which 2) (js-bits-flags t pr v))
    (if (== which 3) (js-bits-style t pr v))
    (if (> which 3)
      (do (emit-ascii t "[")
          (while (< b 16)
            (do (if (!= (bit-and v bit) 0)
                  (do (js-fsep t pr k)
                      (emit-ascii t "\"")
                      (if (== which 4) (pg-emit-name t bit))
                      (if (== which 5) (mg-emit-name t bit))
                      (if (== which 6) (mc-emit-name t bit))
                      (if (== which 7) (eg-emit-name t bit))
                      (if (== which 8) (vg-emit-name t bit))
                      (if (== which 9) (oe-emit-name t bit))
                      (if (== which 10) (os-emit-name t bit))
                      (if (== which 11) (vc-emit-name t bit))
                      (emit-ascii t "\"")
                      (set k (+ k 1))))
                (set bit (* bit 2))
                (set b (+ b 1))))
          (emit-ascii t "]")))
    (return 1)))

(defn ^I32 ev-fenum [^:mut ^Text t ^I32 pr ^I32 d ^I32 started ^I32 key ^I32 which ^I32 v]
  (comment "An enumerated code as its name. which: 1 `gh`, 2 `vz`, 3 `ar`, 4 `ld`, 5 `pa`, 6 `ck`, 7 `mk`, 8 `as`,")
  (comment "9 `ob`, 10 `op`, 11 `ft`, 12 `wb`, 13 `cs`, 14 `ir`, 15 `rs`, 16 `pm`, 17 `po`, 18 `ea`, 19 `vk`.")
  (comment "Code 0 is \"none\" and -1 \"unknown\": neither is written.")
  (if (<= v 0) (return started))
  (ev-begin t pr d started key)
  (emit-ascii t "\"")
  (if (== which 1) (gh-emit-name t v))
  (if (== which 2) (vz-emit-name t v))
  (if (== which 3) (ar-emit-name t v))
  (if (== which 4) (ld-emit-name t v))
  (if (== which 5) (pa-emit-name t v))
  (if (== which 6) (ck-emit-name t v))
  (if (== which 7) (mk-emit-name t v))
  (if (== which 8) (as-emit-name t v))
  (if (== which 9) (ob-emit-name t v))
  (if (== which 10) (op-emit-name t v))
  (if (== which 11) (ft-emit-name t v))
  (if (== which 12) (wb-emit-name t v))
  (if (== which 13) (cs-emit-name t v))
  (if (== which 14) (ir-emit-name t v))
  (if (== which 15) (rs-emit-name t v))
  (if (== which 16) (pm-emit-name t v))
  (if (== which 17) (po-emit-name t v))
  (if (== which 18) (ea-emit-name t v))
  (if (== which 19) (vk-emit-name t v))
  (emit-ascii t "\"")
  (return 1))

(defn ^I32 ev-field [^:mut ^Text t ^I32 pr ^I32 d ^Cells c ^Cells etext ^I32 stride ^I32 row
                     ^I32 r ^I32 started]
  (comment "One printed field of a row, by its row `r` of `ev-fd`: [arena first-cell kind key default arg].")
  (let [^I32 f (ev-fd-at 0 r 1)
        ^I32 kind (ev-fd-at 0 r 2)
        ^I32 key (ev-fd-at 0 r 3)
        ^I32 dflt (ev-fd-at 0 r 4)
        ^I32 arg (ev-fd-at 0 r 5)]
    (if (== kind 1) (return (ev-fint t pr d c stride row f key dflt started)))
    (if (== kind 2) (return (ev-fcpt t pr d c stride row f key dflt started)))
    (if (or (== kind 3) (== kind 4)) (return (ev-fquad t pr d c stride row f key started)))
    (if (== kind 5) (return (ev-fcolor t pr d c stride row f key started)))
    (if (== kind 6) (return (ev-ftextk t pr d c stride row f etext key started)))
    (if (== kind 7)
      (do (if (and (== (ev-get c stride row f) dflt) (== (ev-get c stride row (+ f 1)) arg))
            (return started))
          (return (ev-frun t pr d c stride row f key started))))
    (if (== kind 8) (return (ev-fenum t pr d started key arg (ev-get c stride row f))))
    (if (== kind 9) (return (ev-fbits t pr d c stride row f arg key started)))
    (if (== kind 10) (return (ev-fpx4 t pr d c stride row f key started)))
    (if (== kind 11) (return (ev-fpacked t pr d c stride row f key started)))
    (if (== kind 12) (return (ev-fpair t pr d c stride row f key dflt arg 0 started)))
    (if (== kind 13) (return (ev-fpair t pr d c stride row f key dflt arg 1 started)))
    (return started)))

(defn ^:pub ^I32 ev-row [^:mut ^Text t ^I32 pr ^I32 d ^I32 ea ^Cells c ^Cells etext ^I32 row]
  (comment "One row of arena `ea` as an object, its fields in stride order (the table `ev-fd`).")
  (let [^I32 stride (ev-strides-at 0 (- ea 1))
        ^I32 first (ev-fx-at 0 (- ea 1) 0)
        ^I32 cnt (ev-fx-at 0 (- ea 1) 1)
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0]
    (emit-ascii t "{")
    (while (< k cnt)
      (do (set s (ev-field t pr d c etext stride row (+ first k) s))
          (set k (+ k 1))))
    (js-close t pr d s)
    (return 0)))

(defn ^I32 ev-arena [^:mut ^Text t ^I32 pr ^I32 started ^I32 ea ^Cells c ^Cells etext]
  (comment "`\"arena\":[row, ...]` for any arena with a field table.")
  (let [^I32 n (quot (cells-len c) (ev-strides-at 0 (- ea 1)))
        ^:mut ^I32 i 0]
    (ev-begin t pr 0 started (ev-ea-key-at 0 (- ea 1)))
    (emit-ascii t "[")
    (while (< i n)
      (do (js-aelem t pr 1 i)
          (ev-row t pr 2 ea c etext i)
          (set i (+ i 1))))
    (js-aend t pr 1 n)
    (return 1)))

(defn ^I32 ev-arena-refs [^:mut ^Text t ^I32 pr ^I32 started ^Cells refs]
  (comment "`\"refs\":[[\"arena\",index], ...]`: an array of flat arrays is flat, so it stays on one line in")
  (comment "the pretty form too (`kin/scripts/json-check.py`).")
  (let [^I32 n (quot (cells-len refs) 2)
        ^:mut ^I32 i 0]
    (ev-begin t pr 0 started (ev-ea-key-at 0 3))
    (emit-ascii t "[")
    (while (< i n)
      (do (js-fsep t pr i)
          (emit-ascii t "[\"")
          (ea-emit-name t (cells-at refs (* i 2)))
          (emit-ascii t "\",")
          (if (== pr 1) (emit-ascii t " "))
          (text-i32 t (cells-at refs (+ (* i 2) 1)))
          (emit-ascii t "]")
          (set i (+ i 1))))
    (emit-ascii t "]")
    (return 1)))

(defn ^I32 ev-arena-etext [^:mut ^Text t ^I32 pr ^I32 started ^Cells etext]
  (comment "`\"etext\":[\"all the text\"]`, the whole arena as one string; `[]` when it is empty.")
  (let [^I32 n (cells-len etext)]
    (ev-begin t pr 0 started (ev-ea-key-at 0 4))
    (emit-ascii t "[")
    (if (> n 0) (js-str t etext 0 n))
    (emit-ascii t "]")
    (return 1)))

(defn ^I32 ev-arena-feats [^:mut ^Text t ^I32 pr ^I32 started ^Cells feats]
  (comment "`\"feats\":[{\"subject\":[\"owords\",i],\"conf\":..., ...}]`: a column under its name (`xo` for OCR")
  (comment "words, `xt` for text-layer words, `cN` for a column with none), -1 (not computed) omitted.")
  (let [^I32 n (quot (cells-len feats) 32)
        ^:mut ^I32 i 0
        ^:mut ^I32 col 0
        ^:mut ^I32 s 0
        ^:mut ^I32 sea 0]
    (ev-begin t pr 0 started (ev-ea-key-at 0 5))
    (emit-ascii t "[")
    (while (< i n)
      (do (js-aelem t pr 1 i)
          (set sea (ev-get feats 32 i 0))
          (emit-ascii t "{")
          (set s 0)
          (set s (ev-begin t pr 2 s (ek-subject)))
          (emit-ascii t "[\"")
          (ea-emit-name t sea)
          (emit-ascii t "\",")
          (if (== pr 1) (emit-ascii t " "))
          (text-i32 t (ev-get feats 32 i 1))
          (emit-ascii t "]")
          (set col 2)
          (while (< col 32)
            (do (if (!= (ev-get feats 32 i col) -1)
                  (do (if (== s 1) (emit-ascii t ","))
                      (if (== pr 1) (js-indent t 3))
                      (emit-ascii t "\"")
                      (if (== sea 8)
                        (if (== (xt-emit-name t col) 0)
                          (do (emit-ascii t "c") (text-i32 t col)))
                        (if (== (xo-emit-name t col) 0)
                          (do (emit-ascii t "c") (text-i32 t col))))
                      (emit-ascii t "\":")
                      (if (== pr 1) (emit-ascii t " "))
                      (text-i32 t (ev-get feats 32 i col))))
                (set col (+ col 1))))
          (js-close t pr 2 s)
          (set i (+ i 1))))
    (js-aend t pr 1 n)
    (return 1)))

(defn ^:pub ^I32 ev-emit-body [^:mut ^Text t ^I32 pretty ^I32 s0
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "The arenas of the evidence dump, `epages` to `tlines`, written as members of the object the caller opened;")
  (comment "`s0` is 1 when a member came before. Answers 1. (`ev-emit` and the layer dump of `emon.player` share it.)")
  (let [^:mut ^I32 s s0]
    (set s (ev-arena t pretty s 1 epages etext))
    (set s (ev-arena t pretty s 2 views etext))
    (set s (ev-arena t pretty s 3 pts etext))
    (set s (ev-arena-refs t pretty s refs))
    (set s (ev-arena-etext t pretty s etext))
    (set s (ev-arena-feats t pretty s feats))
    (set s (ev-arena t pretty s 7 glyphs etext))
    (set s (ev-arena t pretty s 8 words etext))
    (set s (ev-arena t pretty s 9 lines etext))
    (set s (ev-arena t pretty s 10 marks etext))
    (set s (ev-arena t pretty s 11 fonts etext))
    (set s (ev-arena t pretty s 12 paths etext))
    (set s (ev-arena t pretty s 13 images etext))
    (set s (ev-arena t pretty s 14 oruns etext))
    (set s (ev-arena t pretty s 15 oblocks etext))
    (set s (ev-arena t pretty s 16 olines etext))
    (set s (ev-arena t pretty s 17 owords etext))
    (set s (ev-arena t pretty s 18 osyms etext))
    (set s (ev-arena t pretty s 19 oalts etext))
    (set s (ev-arena t pretty s 20 inks etext))
    (set s (ev-arena t pretty s 21 components etext))
    (set s (ev-arena t pretty s 22 rules etext))
    (set s (ev-arena t pretty s 23 prims etext))
    (set s (ev-arena t pretty s 24 tlines etext))
    (return s)))

(defn ^:pub ^I32 ev-emit [^:mut ^Text t ^I32 pretty
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Write the evidence as `emon-evidence` JSON (SPEC 4.5, 8.4.6), version \"1\": one array per arena,")
  (comment "in the order of the `ea` codes, each row in its fixed key order.")
  (let [^:mut ^I32 s 0]
    (emit-ascii t "{")
    (set s (ev-begin t pretty 0 s (ek-version)))
    (emit-ascii t "\"1\"")
    (set s (ev-emit-body t pretty s epages views pts refs etext feats glyphs words lines marks fonts paths images
                         oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (js-close t pretty 0 s)
    (return 0)))
