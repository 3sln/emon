(defn ^:pub ^I32 mk-new [^:mut ^Cells c ^I32 v-page ^I32 v-kind ^I32 v-tstart ^I32 v-tlen ^I32 v-parent ^I32 v-gfirst]
  (comment "Append a row of marks: page kind tstart tlen parent gfirst; every other field is its default.")
