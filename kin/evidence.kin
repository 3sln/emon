(defn ^:pub ^I32 or-stride [] (return 28))
(defn ^:pub ^I32 ob-stride [] (return 16))
(defn ^:pub ^I32 ol-stride [] (return 24))
(defn ^:pub ^I32 ow-stride [] (return 28))
(defn ^:pub ^I32 os-stride [] (return 20))
(defn ^:pub ^I32 oa-stride [] (return 4))
(defn ^:pub ^I32 ik-stride [] (return 12))
(defn ^:pub ^I32 co-stride [] (return 24))
(defn ^:pub ^I32 rl-stride [] (return 20))
(defn ^:pub ^I32 pm-stride [] (return 24))
(defn ^:pub ^I32 tl-stride [] (return 20))

;; word head, 16 cells
(defn ^:pub ^I32 hd-page [] (return 0))
(defn ^:pub ^I32 hd-x0 [] (return 1))
(defn ^:pub ^I32 hd-y0 [] (return 2))
(defn ^:pub ^I32 hd-x1 [] (return 3))
(defn ^:pub ^I32 hd-y1 [] (return 4))
(defn ^:pub ^I32 hd-bx0 [] (return 5))
(defn ^:pub ^I32 hd-by0 [] (return 6))
(defn ^:pub ^I32 hd-bx1 [] (return 7))
(defn ^:pub ^I32 hd-by1 [] (return 8))
(defn ^:pub ^I32 hd-rot [] (return 9))
(defn ^:pub ^I32 hd-dir [] (return 10))
(defn ^:pub ^I32 hd-tstart [] (return 11))
(defn ^:pub ^I32 hd-tlen [] (return 12))
(defn ^:pub ^I32 hd-line [] (return 13))
(defn ^:pub ^I32 hd-conf [] (return 14))
(defn ^:pub ^I32 hd-feat [] (return 15))
;; line head, 13 cells
(defn ^:pub ^I32 lh-page [] (return 0))
(defn ^:pub ^I32 lh-x0 [] (return 1))
(defn ^:pub ^I32 lh-y0 [] (return 2))
(defn ^:pub ^I32 lh-x1 [] (return 3))
(defn ^:pub ^I32 lh-y1 [] (return 4))
(defn ^:pub ^I32 lh-bx0 [] (return 5))
(defn ^:pub ^I32 lh-by0 [] (return 6))
(defn ^:pub ^I32 lh-bx1 [] (return 7))
(defn ^:pub ^I32 lh-by1 [] (return 8))
