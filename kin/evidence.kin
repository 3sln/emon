    (return r)))

(defn ^:pub ^I32 im-count [^Cells c] (return (ev-count c 20)))
(defn ^:pub ^I32 im-get [^Cells c ^I32 i ^I32 f] (return (ev-get c 20 i f)))
(defn ^:pub ^I32 im-set [^:mut ^Cells c ^I32 i ^I32 f ^I32 v] (return (ev-set c 20 i f v)))
(defn ^:pub ^I32 im-new [^:mut ^Cells c ^I32 v-page ^I32 v-x0 ^I32 v-y0 ^I32 v-x1 ^I32 v-y1 ^I32 v-obj ^I32 v-pxw ^I32 v-pxh]
  (comment "Append a row of images: page x0 y0 x1 y1 obj pxw pxh; every other field is its default.")
  (let [^I32 r (ev-push c 20)]
    (ev-set c 20 r 0 v-page)
    (ev-set c 20 r 1 v-x0)
