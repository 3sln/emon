;; The P3.6 checks that have run (SPEC 8.4.3): a bit set in `vchk` says that check ran.
(defenum ^:pub vc
  [[vc-clip 1 "clip"]
   [vc-offpage 2 "offpage"]
   [vc-white 4 "white"]
   [vc-zero-size 8 "zero-size"]
   [vc-occlusion 16 "occlusion"]
   [vc-ocg 32 "ocg"]
   [vc-transparent 64 "transparent"]
   [vc-blend 128 "blend"]
   [vc-softmask 256 "softmask"]])

