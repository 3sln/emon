  (let [^I32 r (ev-push c 16)]
    (ev-set c 16 r 0 v-obj)
    (ev-set c 16 r 1 v-subtype)
    (ev-set c 16 r 5 -1)
    (ev-set c 16 r 6 -1)
    (ev-set c 16 r 10 -1)
    (ev-set c 16 r 12 -1)
    (ev-set c 16 r 14 -1)
    (ev-set c 16 r 15 -1)
    (return r)))

(defn ^:pub ^I32 pa-count [^Cells c] (return (ev-count c 24)))
