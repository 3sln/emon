;; The evidence schema, v2 (P1.12; SPEC 2.1, 8.4, 9, 4.5; D056 revised by D096). emon's own module (D039).
;;
;; EVIDENCE IS RAW OBSERVATION IN PAGE SPACE, with a source and no interpretation beyond what the source
;; itself asserts (SPEC 2.1). Stage 1 writes it, stage 2 compares it across sources, and the debug dump
;; below is what a fusion test is written against. It is arenas of integers, like the Model
;; (`emon.model`, D011): kin cannot allocate, so the host hands in `Cells` and kin fills them.
;;
;; THE 24 ARENAS, in the order of their `ea` codes (SPEC 8.4.6) and in four BUNDLES a host holds as
;; structs (`EvShared`, `EvText`, `EvOcr`, `EvTrace`); every function that takes all of them takes them in
;; this order, and a function that needs one takes only that one (D050):
;;
;;   shared   epages 12   views 24   pts 3   refs 2   etext 1   feats 32
;;   text     glyphs 32   words 24   lines 16   marks 24   fonts 16   paths 24   images 20
;;   ocr      oruns 28   oblocks 16   olines 24   owords 28   osyms 20   oalts 4
;;   trace    inks 12   components 24   rules 20   prims 24   tlines 20
;;
;; `evs-init evt-init evo-init evr-init` empty a bundle, `ev-init` all of them, `ev-check` verifies all of
;; them (strides, every text run, every run, every reference, the OCR nesting, the features' subjects),
;; `ev-emit` dumps them (version "1").
;;
;; UNITS. Page space is top-left, y down, in centipoints (SPEC 3.4, D009); a pixel is a pixel and says so.
;; Angles are CENTI-DEGREES, counter-clockwise AS DISPLAYED, 0 <= a < 36000, made by `ev-angle` and nothing
;; else. Colour is 0xRRGGBB in one cell, -1 for none. Confidence is per-mille (an OCR symbol's or
;; alternative's x10, as the engine gives it), -1 absent. ABSENT IS -1 for an index or a value that may be
;; missing; a count is 0. Every placed row has `page` and an axis-aligned box `x0 y0 x1 y1` with
;; `x0 <= x1` and `y0 <= y1` (`ev-check` holds it), and every glyph, word and line a two-point BASELINE.
;;
;; THE THREE HEADS (`hd-*` a word's 16 cells, `lh-*` a line's 13, `ch-*` a character's 9) begin every
;; word-like, line-like and char-like row of every source, so one reader over `(Cells, stride)` does
;; alignment (the laws hold it). An arena's own fields follow its head under its own prefix:
;;
;;   gf- glyphs  wf- words  lf- lines  mkf- marks  fnf- fonts  pf- paths  mf- images  epf- epages
;;   vwf- views  ptf- pts  rff- refs  xf- feats  orf- oruns  obf- oblocks  olf- olines  owf- owords
;;   osf- osyms  oaf- oalts  ikf- inks  cf- components  rlf- rules  pmf- prims  tlf- tlines
;;
;; (`etf-` is unused: `etext` has no fields.) The prefixes are the brief's; none collided.
;;
;; THE DUMP is `emon-evidence` (SPEC 4.5), canonical JSON under the Model's rules (fixed key order, defaults
;; omitted, optional `pretty`), version "1". It is TABLE DRIVEN: `ev-fd` lists, per arena, every printed field
;; (first cell, kind, key, default) and `ev-row` walks it, so the layout constants above and the dump cannot
;; drift apart unnoticed (a law checks that every cell of every stride is either printed or named spare).
;; It is not a public contract.
(ns emon.evidence
  (:require [emon.lang :refer [I32 I64 Cells Text defenum emit-ascii sar32 i64 i32 add64 mul64]]
            [emon.port :refer [cells-len cells-at cells-set cells-push
                               cells-drop text-i32 text-cp]]
            [emon.model :refer [text-append-cp]]
            [emon.json :refer [js-indent js-close js-aelem js-aend js-fsep
                               js-cpt js-str js-hex js-bits-src js-bits-flags
                               js-bits-style]]
            [emon.trig :refer [ev-atan-at ev-sin-at]]
            [kin.lang :refer [defn defdata return let set while if do comment
                              + - * < > <= >= == != and or quot rem
                              bit-and]]))

;; ------------------------------------------------------------- the tables
;; Codes are assigned once and never reused (D050). The spellings are the SPEC's words.

;; How a glyph's Unicode value was obtained (SPEC 8.1).
(defenum ^:pub gh
  [[gh-tounicode 1 "tounicode"]
   [gh-encoding 2 "encoding"]
   [gh-glyphname 3 "glyphname"]
   [gh-cid 4 "cid"]
   [gh-unknown 5 "unknown"]])

;; Why a glyph is not visible (SPEC 8.1); 0 is "visible" and is not written.
;; Render mode 3 is NOT here: it is the `hidden-text` source, not invisibility. `ocg-hidden` (an optional-content group
;; that is off by default) and `transparent` (the ink's alpha is 0) are P3.6's (D152).
(defenum ^:pub vz
  [[vz-clipped 1 "clipped"]
   [vz-offpage 2 "offpage"]
   [vz-white 3 "white-on-white"]
   [vz-zero-size 4 "zero-size"]
   [vz-occluded 5 "occluded"]
   [vz-ocg-hidden 6 "ocg-hidden"]
   [vz-transparent 7 "transparent"]])

;; An `/Artifact`'s `/Type` (SPEC 8.4.3, D101). CODES ARE FOREVER. v2 writes `pagination` 1, `layout` 3,
;; `background` 4, `page` 6 and `other` 5 (a Type that is none of those, or absent: an artifact span always
;; has one of them, so `mk-artifact-of` answers 0 only for "no artifact"); `watermark` 2 was v0's subtype
;; stored as a type and is NEVER WRITTEN AGAIN (the subtype is `as`). D101 had already given 5 to `other`,
;; so the brief's "new `page` 5" is 6 here.
(defenum ^:pub ar
  [[ar-pagination 1 "pagination"]
   [ar-watermark 2 "watermark"]
   [ar-layout 3 "layout"]
   [ar-background 4 "background"]
   [ar-other 5 "other"]
   [ar-page 6 "page"]])

;; An `/Artifact`'s `/Subtype`: 0 none, `other` a name that is none of these.
(defenum ^:pub as
  [[as-header 1 "header"]
   [as-footer 2 "footer"]
   [as-watermark 3 "watermark"]
   [as-other 4 "other"]])

;; A line's direction (SPEC 10.1); 0 is left-to-right and is not written.
(defenum ^:pub ld
  [[ld-rtl 1 "rtl"]
   [ld-ttb 2 "ttb"]
   [ld-btt 3 "btt"]])

;; A vector path's kind.
(defenum ^:pub pa
  [[pa-line 1 "line"]
   [pa-rect 2 "rect"]
   [pa-curve 3 "curve"]
   [pa-other 4 "other"]])

;; What the tracer found (SPEC 8.2).
(defenum ^:pub ck
  [[ck-blob 1 "blob"]
   [ck-rule-h 2 "rule-h"]
   [ck-rule-v 3 "rule-v"]
   [ck-box 4 "box"]
   [ck-ellipse 5 "ellipse"]
   [ck-arrow 6 "arrow"]
   [ck-curve 7 "curve"]
   [ck-text-like 8 "text-like"]])

;; Flag bits: paths, images, marks (D101), epages, views, OCR words' engine flags, OCR symbols'.
(defenum ^:pub pg
  [[pg-closed 1 "closed"]
   [pg-evenodd 2 "evenodd"]
   [pg-clip 4 "clip"]
   [pg-filled 8 "filled"]
   [pg-stroked 16 "stroked"]
   [pg-shading 32 "shading"]
   [pg-pattern 64 "pattern"]
   [pg-blend 128 "blend"]
   [pg-softmask 256 "softmask"]
   [pg-truncated 512 "truncated"]])

(defenum ^:pub mg
  [[mg-mask 1 "mask"]
   [mg-smask 2 "smask"]
   [mg-inline 4 "inline"]
   [mg-masked 8 "masked"]
   [mg-blend 16 "blend"]
   [mg-softmask 32 "softmask"]])

;; `/Properties` reference (2), inline dictionary (1), name not found (4), closed by the end of its stream (8), an
;; optional-content span made for a Form XObject's or an image's own `/OC` (16, D152).
(defenum ^:pub mc
  [[mc-inline 1 "inline"]
   [mc-resource 2 "resource"]
   [mc-unresolved 4 "unresolved"]
   [mc-unterminated 8 "unterminated"]
   [mc-xobject 16 "xobject"]])

(defenum ^:pub eg
  [[eg-text-layer 1 "text-layer"]
