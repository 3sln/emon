;; every arena's stride, index = ea - 1
(defdata ^:pub ev-strides
  :emitter kin.lang/flat-array
  :data [12 24 3 2 1 32 32 24 16 24 16 24 20 28 16 24 28 20 4 12 24 20 24 20]
  :accessors {^I32 ev-strides-count [^I32 ignored]
              ^I32 ev-strides-at [^I32 ignored ^I32 i]})

;; THE CHECKS `ev-check` makes from a table, one row each: [code arena kind f1 f2 target].
;; kind 1: a text run (f1 start, f2 length) inside `etext` (start -1 is absent); kind 2: a run (first f1, count f2) inside the
;; target arena; kind 3: an index (f1) into the target, -1 absent; kind 4: the same but required; kind 5: an index of an
;; EARLIER row of the same arena or -1. Codes 2.. in this order; 1 is a stride; the ones after the table are in `ev-check`.
(defdata ^:pub ev-ck
  :emitter kin.lang/flat-array
  :stride 6
  :data [2 7 1 6 7 5
