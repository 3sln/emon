;; ------------------------------------------------------------- the layouts
;; Strides, then the three HEADS (SPEC 8.4.1) once, then each arena's own fields from where its head ends.

(defn ^:pub ^I32 ep-stride [] (return 12))
(defn ^:pub ^I32 vw-stride [] (return 24))
(defn ^:pub ^I32 pt-stride [] (return 3))
(defn ^:pub ^I32 rf-stride [] (return 2))
(defn ^:pub ^I32 etx-stride [] (return 1))
(defn ^:pub ^I32 fe-stride [] (return 32))
(defn ^:pub ^I32 gl-stride [] (return 32))
(defn ^:pub ^I32 wd-stride [] (return 24))
(defn ^:pub ^I32 ln-stride [] (return 16))
(defn ^:pub ^I32 mk-stride [] (return 24))
(defn ^:pub ^I32 fo-stride [] (return 16))
(defn ^:pub ^I32 pa-stride [] (return 24))
