;; Laws for the `Crypto` port (P3.2, D006, D097): MD5, SHA-256/384/512, RC4 and
;; AES-CBC, on every target, against PUBLISHED TEST VECTORS:
;;
;;   MD5      RFC 1321 appendix A.5
;;   SHA-2    FIPS 180-4 examples (NIST "SHA_All"), the one-block, two-block and
;;            the 896-bit messages
;;   RC4      the widely published vectors ("Key"/"Plaintext", "Wiki"/"pedia",
;;            "Secret"/"Attack at dawn") and RFC 6229's first bytes
;;   AES      FIPS 197 appendix C (one block) and NIST SP 800-38A F.2 (CBC,
;;            128, 192 and 256 bit keys, four blocks)
;;
;; The Rust host writes all of these by hand (its standard library has none),
;; Go, Java and C# call theirs, so one set of answers holding on all four is the
;; claim: "a host must not substitute a compatible algorithm" (SPEC 7.2). A
;; padded decryption is checked against ciphertext made by the JDK's
;; AES/CBC/PKCS5Padding.
(ns emon.cryptotest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq assert-cells-hex hex-blob text-blob
                               new-cells]]
            [emon.port :refer [cells-len cells-push crypto-md5 crypto-sha256
                               crypto-sha384 crypto-sha512 crypto-rc4
                               crypto-aes-decrypt crypto-aes-encrypt]]
            [kin.lang :refer [let comment + - == ]]))

(deftest test-md5-rfc1321
  (let [^Cells o (new-cells)]
    (assert-eq (crypto-md5 (text-blob "") 0 0 o) 16 "16 bytes out")
    (assert-cells-hex o "d41d8cd98f00b204e9800998ecf8427e" "empty")))

(deftest test-md5-abc
  (let [^Cells o (new-cells)]
    (crypto-md5 (text-blob "abc") 0 3 o)
    (assert-cells-hex o "900150983cd24fb0d6963f7d28e17f72" "abc")))

(deftest test-md5-message-digest
  (let [^Cells o (new-cells)]
    (crypto-md5 (text-blob "message digest") 0 14 o)
    (assert-cells-hex o "f96b697d7cb7938d525a2f31aaf161d0" "message digest")))

(deftest test-md5-alphabet-and-digits
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)]
    (crypto-md5 (text-blob "abcdefghijklmnopqrstuvwxyz") 0 26 o)
    (assert-cells-hex o "c3fcd3d76192e4007dfb496cca67e13b" "a-z")
    (crypto-md5 (text-blob "12345678901234567890123456789012345678901234567890123456789012345678901234567890") 0 80 p)
    (assert-cells-hex p "57edf4a22be3c955ac49da2e2107b67a" "80 digits: two blocks")))

(deftest test-md5-a-span-not-the-whole-blob
  (let [^Cells o (new-cells)]
    (crypto-md5 (text-blob "xxabcyy") 2 3 o)
    (assert-cells-hex o "900150983cd24fb0d6963f7d28e17f72" "the span abc")))

(deftest test-md5-appends
  (let [^Cells o (new-cells)]
    (cells-push o 7)
    (crypto-md5 (text-blob "abc") 0 3 o)
    (assert-eq (cells-len o) 17 "one byte then 16")
    (assert-cells-hex o "07900150983cd24fb0d6963f7d28e17f72" "appended after the 7")))

(deftest test-sha256-fips180
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)
        ^Cells q (new-cells)]
    (assert-eq (crypto-sha256 (text-blob "abc") 0 3 o) 32 "32 bytes out")
    (assert-cells-hex o "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad" "abc")
    (crypto-sha256 (text-blob "") 0 0 p)
    (assert-cells-hex p "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855" "empty")
    (crypto-sha256 (text-blob "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq") 0 56 q)
    (assert-cells-hex q "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1" "448 bits: two blocks")))

(deftest test-sha384-fips180
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)
        ^Cells q (new-cells)]
    (assert-eq (crypto-sha384 (text-blob "abc") 0 3 o) 48 "48 bytes out")
    (assert-cells-hex o "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7" "abc")
    (crypto-sha384 (text-blob "") 0 0 p)
    (assert-cells-hex p "38b060a751ac96384cd9327eb1b1e36a21fdb71114be07434c0cc7bf63f6e1da274edebfe76f65fbd51ad2f14898b95b" "empty")
    (crypto-sha384 (text-blob "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") 0 112 q)
    (assert-cells-hex q "09330c33f71147e83d192fc782cd1b4753111b173b3b05d22fa08086e3b0f712fcc7c71a557e2db966c3e9fa91746039" "896 bits: two blocks")))

(deftest test-sha512-fips180
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)
        ^Cells q (new-cells)]
    (assert-eq (crypto-sha512 (text-blob "abc") 0 3 o) 64 "64 bytes out")
    (assert-cells-hex o "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f" "abc")
    (crypto-sha512 (text-blob "") 0 0 p)
    (assert-cells-hex p "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" "empty")
    (crypto-sha512 (text-blob "abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu") 0 112 q)
    (assert-cells-hex q "8e959b75dae313da8cf4f72814fc143f8f7779c6eb9f7fa17299aeadb6889018501d289e4900f7e4331b99dec4b5433ac7d329eeb6dd26545e96e55b874be909" "896 bits: two blocks")))

(deftest test-rc4-published-vectors
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)
        ^Cells q (new-cells)]
    (assert-eq (crypto-rc4 (text-blob "Key") 0 3 (text-blob "Plaintext") 0 9 o) 9 "9 bytes out")
    (assert-cells-hex o "bbf316e8d940af0ad3" "Key / Plaintext")
    (crypto-rc4 (text-blob "Wiki") 0 4 (text-blob "pedia") 0 5 p)
    (assert-cells-hex p "1021bf0420" "Wiki / pedia")
    (crypto-rc4 (text-blob "Secret") 0 6 (text-blob "Attack at dawn") 0 14 q)
    (assert-cells-hex q "45a01f645fc35b383552544b9bf5" "Secret / Attack at dawn")))

(deftest test-rc4-rfc6229-first-bytes
  (comment "RFC 6229, 40-bit key 0102030405: keystream offset 0 is b2396305f03dc027...")
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)]
    (crypto-rc4 (hex-blob "0102030405") 0 5 (hex-blob "00000000 00000000 00000000 00000000") 0 16 o)
    (assert-cells-hex o "b2396305f03dc027ccc3524a0a1118a8" "40-bit key, 16 bytes of keystream")
    (comment "128-bit key 0102..10: keystream starts 9ac7cc9a609d1ef7b2932899cde41b97")
    (crypto-rc4 (hex-blob "0102030405060708090a0b0c0d0e0f10") 0 16 (hex-blob "00000000 00000000 00000000 00000000") 0 16 p)
    (assert-cells-hex p "9ac7cc9a609d1ef7b2932899cde41b97" "128-bit key")))

(deftest test-rc4-is-its-own-inverse-and-takes-spans
  (let [^Cells o (new-cells)]
    (crypto-rc4 (hex-blob "ffff4b6579ff") 2 3 (hex-blob "ee bbf316e8d940af0ad3 ee") 1 9 o)
    (assert-cells-hex o "506c61696e74657874" "the key span is Key, the data span decrypts to Plaintext")))

(deftest test-rc4-refuses-an-empty-key
  (let [^Cells o (new-cells)]
    (assert-eq (crypto-rc4 (hex-blob "00") 0 0 (hex-blob "0011") 0 2 o) -1 "no key")
    (assert-eq (cells-len o) 0 "nothing appended")))

(deftest test-aes-fips197-one-block
  (comment "FIPS 197 C.1 and C.3: AES-128 and AES-256, a zero IV makes CBC one ECB block.")
  (let [^Cells o (new-cells)
        ^Cells p (new-cells)
        ^Cells q (new-cells)
        ^Cells r (new-cells)]
    (assert-eq (crypto-aes-encrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                                   (hex-blob "00000000000000000000000000000000 00112233445566778899aabbccddeeff") 0 32 o)
               16 "one block out")
    (assert-cells-hex o "69c4e0d86a7b0430d8cdb78070b4c55a" "AES-128 encrypt")
    (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                        (hex-blob "00000000000000000000000000000000 69c4e0d86a7b0430d8cdb78070b4c55a") 0 32 0 p)
    (assert-cells-hex p "00112233445566778899aabbccddeeff" "AES-128 decrypt")
    (crypto-aes-encrypt (hex-blob "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f") 0 32
                        (hex-blob "00000000000000000000000000000000 00112233445566778899aabbccddeeff") 0 32 q)
    (assert-cells-hex q "8ea2b7ca516745bfeafc49904b496089" "AES-256 encrypt")
    (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f") 0 32
                        (hex-blob "00000000000000000000000000000000 8ea2b7ca516745bfeafc49904b496089") 0 32 0 r)
    (assert-cells-hex r "00112233445566778899aabbccddeeff" "AES-256 decrypt")))

(deftest test-aes-192-one-block
  (comment "FIPS 197 C.2.")
  (let [^Cells o (new-cells)]
    (crypto-aes-encrypt (hex-blob "000102030405060708090a0b0c0d0e0f1011121314151617") 0 24
                        (hex-blob "00000000000000000000000000000000 00112233445566778899aabbccddeeff") 0 32 o)
    (assert-cells-hex o "dda97ca4864cdfe06eaf70a0ec0d7191" "AES-192 encrypt")))

(deftest test-aes-cbc-sp800-38a-128
  (comment "SP 800-38A F.2.1 / F.2.2: four blocks, the IV first in the data.")
  (let [^Cells e (new-cells)
        ^Cells d (new-cells)]
    (assert-eq (crypto-aes-encrypt (hex-blob "2b7e151628aed2a6abf7158809cf4f3c") 0 16
                                   (hex-blob "000102030405060708090a0b0c0d0e0f 6bc1bee22e409f96e93d7e117393172a ae2d8a571e03ac9c9eb76fac45af8e51 30c81c46a35ce411e5fbc1191a0a52ef f69f2445df4f9b17ad2b417be66c3710") 0 80 e)
               64 "four blocks")
    (assert-cells-hex e "7649abac8119b246cee98e9b12e9197d5086cb9b507219ee95db113a917678b273bed6b8e3c1743b7116e69e222295163ff1caa1681fac09120eca307586e1a7" "F.2.1 ciphertext")
    (crypto-aes-decrypt (hex-blob "2b7e151628aed2a6abf7158809cf4f3c") 0 16
                        (hex-blob "000102030405060708090a0b0c0d0e0f 7649abac8119b246cee98e9b12e9197d 5086cb9b507219ee95db113a917678b2 73bed6b8e3c1743b7116e69e22229516 3ff1caa1681fac09120eca307586e1a7") 0 80 0 d)
    (assert-cells-hex d "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710" "F.2.2 plaintext")))

(deftest test-aes-cbc-sp800-38a-192
  (let [^Cells e (new-cells)]
    (crypto-aes-encrypt (hex-blob "8e73b0f7da0e6452c810f32b809079e562f8ead2522c6b7b") 0 24
                        (hex-blob "000102030405060708090a0b0c0d0e0f 6bc1bee22e409f96e93d7e117393172a ae2d8a571e03ac9c9eb76fac45af8e51 30c81c46a35ce411e5fbc1191a0a52ef f69f2445df4f9b17ad2b417be66c3710") 0 80 e)
    (assert-cells-hex e "4f021db243bc633d7178183a9fa071e8b4d9ada9ad7dedf4e5e738763f69145a571b242012fb7ae07fa9baac3df102e008b0e27988598881d920a9e64f5615cd" "F.2.3 ciphertext")))

(deftest test-aes-cbc-sp800-38a-256
  (let [^Cells e (new-cells)
        ^Cells d (new-cells)]
    (crypto-aes-encrypt (hex-blob "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4") 0 32
                        (hex-blob "000102030405060708090a0b0c0d0e0f 6bc1bee22e409f96e93d7e117393172a ae2d8a571e03ac9c9eb76fac45af8e51 30c81c46a35ce411e5fbc1191a0a52ef f69f2445df4f9b17ad2b417be66c3710") 0 80 e)
    (assert-cells-hex e "f58c4c04d6e5f1ba779eabfb5f7bfbd69cfc4e967edb808d679f777bc6702c7d39f23369a9d9bacfa530e26304231461b2eb05e2c39be9fcda6c19078c6a9d1b" "F.2.5 ciphertext")
    (crypto-aes-decrypt (hex-blob "603deb1015ca71be2b73aef0857d77811f352c073b6108d72d9810a30914dff4") 0 32
                        (hex-blob "000102030405060708090a0b0c0d0e0f f58c4c04d6e5f1ba779eabfb5f7bfbd6 9cfc4e967edb808d679f777bc6702c7d 39f23369a9d9bacfa530e26304231461 b2eb05e2c39be9fcda6c19078c6a9d1b") 0 80 0 d)
    (assert-cells-hex d "6bc1bee22e409f96e93d7e117393172aae2d8a571e03ac9c9eb76fac45af8e5130c81c46a35ce411e5fbc1191a0a52eff69f2445df4f9b17ad2b417be66c3710" "F.2.6 plaintext")))

(deftest test-aes-padding-is-stripped-only-when-asked
  (comment "Ciphertext made by the JDK's AES/CBC/PKCS5Padding; key 00..0f, IV 0f..00.")
  (let [^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells c (new-cells)
        ^Cells d (new-cells)
        ^Cells e (new-cells)]
    (assert-eq (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                                   (hex-blob "0f0e0d0c0b0a09080706050403020100 181547ce6a5438cb22241856b35cc489") 0 32 1 a)
               5 "five bytes once the padding is gone")
    (assert-cells-hex a "68656c6c6f" "hello")
    (assert-eq (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                                   (hex-blob "0f0e0d0c0b0a09080706050403020100 181547ce6a5438cb22241856b35cc489") 0 32 0 b)
               16 "sixteen with pad 0")
    (assert-cells-hex b "68656c6c6f0b0b0b0b0b0b0b0b0b0b0b" "the padding is kept when not asked")
    (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                        (hex-blob "0f0e0d0c0b0a09080706050403020100 ff14dbe405cc0ee24d0de41289f0fc981c8a2100b00814723d26cb8858d62767") 0 48 1 c)
    (assert-cells-hex c "303132333435363738396162636465666768696a" "twenty bytes across two blocks")
    (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                        (hex-blob "0f0e0d0c0b0a09080706050403020100 ff14dbe405cc0ee24d0de41289f0fc988680054fc9016bbf4f4067cd27826cdb") 0 48 1 d)
    (assert-cells-hex d "30313233343536373839616263646566" "sixteen bytes: a whole block of padding is removed")
    (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f") 0 32
                        (hex-blob "0f0e0d0c0b0a09080706050403020100 2e5a65859a9f16ccfc0dddb5306145a9") 0 32 1 e)
    (assert-cells-hex e "68656c6c6f" "AES-256 padded")))

(deftest test-aes-short-and-ragged-input
  (let [^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells c (new-cells)]
    (assert-eq (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                                   (hex-blob "0f0e0d0c0b0a09080706050403020100") 0 16 1 a)
               0 "an IV and nothing else")
    (assert-eq (crypto-aes-decrypt (hex-blob "000102030405060708090a0b0c0d0e0f") 0 16
                                   (hex-blob "0f0e0d0c0b0a09080706050403020100 181547ce6a5438cb22241856b35cc489 ffff") 0 34 1 b)
               5 "a ragged tail is dropped")
    (assert-eq (crypto-aes-decrypt (hex-blob "0001020304") 0 5
                                   (hex-blob "0f0e0d0c0b0a09080706050403020100 181547ce6a5438cb22241856b35cc489") 0 32 1 c)
               -1 "a key of the wrong size")
    (assert-eq (cells-len c) 0 "nothing appended")))
