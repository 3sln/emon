;; Laws for `emon.pageunit` (P7.U, D195, D196, D207) and the `BitmapSet` port: a page unit with no answers asks the same
;; requests every time, under its own ids; a page it has nothing to say about asks nothing; and the set holds an answer's
;; bitmap and the ones kin makes, apart.
(ns emon.pageunittest
  (:require [emon.lang :refer [I32 Cells Bitmap BitmapSet]]
            [emon.test :refer [deftest assert-eq assert-that new-cells new-bitmap-set]]
            [emon.port :refer [cells-len cells-at cells-set cells-push bms-get bms-has bms-put bitmap-w bitmap-h bitmap-channels
                               bitmap-u8 bitmap-set-u8]]
            [emon.plan :refer [rec-id rec-kind rec-count rq-arg pk-decode pk-render pk-ocr an-fail an-render an-decode ps-unsupported lay-full lay-no-text us-requests us-done pu-id pu-view-id view-base
                               pi-render-text pi-render-no-text pi-decode pi-ocr flt-dct]]
            [emon.pageunit :refer [pu-w pu-kind pu-dpi pk-scan pk-born pk-none pu-run-pdf pu-ask-rasters]]
            [emon.rasterplan :refer [rp-ask-none rp-ask-full rp-ask-witness rp-f-ask rp-f-wat rp-f-wn rp-f-scripts]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^I32 plan-of [^Cells pl ^I32 pages ^I32 kind]
  (comment "`pages` rows; every page of `kind`, with a stream at bytes 100 + 50 of the input, a box and a page size.")
  (let [^:mut ^I32 i 0]
    (while (< i pages)
      (do (cells-push pl kind)
          (cells-push pl 9)
          (cells-push pl 100)
          (cells-push pl 50)
          (cells-push pl 0)
          (cells-push pl 0)
          (cells-push pl 61200)
          (cells-push pl 79200)
          (cells-push pl 61200)
          (cells-push pl 79200)
          (comment "`emon.rasterplan`'s cells: what the page asks (nothing), its witness rows (none), its scripts (none)")
          (cells-push pl 0)
          (cells-push pl 0)
          (cells-push pl 0)
          (cells-push pl 0)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 born-plan [^Cells pl ^I32 pages ^I32 ask ^I32 scripts]
  (comment "`pages` born-digital pages of the plan that ask `ask` (`rp-ask-*`), with the scripts bit set `scripts`.")
  (let [^:mut ^I32 i 0]
    (plan-of pl pages (pk-born))
    (while (< i pages)
      (do (cells-set pl (+ (* i (pu-w)) (rp-f-ask)) ask)
          (cells-set pl (+ (* i (pu-w)) (rp-f-scripts)) scripts)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 run-page-fused [^I32 i ^I32 policy ^I32 fuse ^Cells pl ^Cells ans ^Cells rq]
  (comment "A page unit with the fusion arguments: `fuse` the hidden setting `no-retarget` (bit 2).")
  (return (pu-run-pdf i 3 policy pl ans rq (new-cells) (new-bitmap-set) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      fuse (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells))))

(defn ^I32 run-page [^I32 i ^I32 policy ^Cells pl ^Cells ans ^Cells rq]
  (return (run-page-fused i policy 0 pl ans rq)))

(defn ^I32 run-page-watched [^I32 i ^I32 policy ^I32 fuse ^Cells pl ^Cells ans ^Cells rq
                             ^Cells mask ^Cells epages ^Cells views ^Cells olines ^Cells owords ^Cells words ^Cells lines]
  (comment "A page unit whose written arenas are the caller's, to see whether an attempt wrote them.")
  (return (pu-run-pdf i 3 policy pl ans rq (new-cells) (new-bitmap-set) mask (new-cells)
                      epages views (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) olines
                      owords (new-cells) (new-cells) words lines
                      fuse (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                      (new-cells) (new-cells) (new-cells) (new-cells))))

(defn ^I32 watched-len [^Cells mask ^Cells epages ^Cells views ^Cells olines ^Cells owords ^Cells words ^Cells lines]
  (comment "How many cells the page unit's written arenas hold in all (the mask is sized by the caller, so its length is not counted).")
  (return (+ (+ (+ (cells-len epages) (cells-len views)) (+ (cells-len olines) (cells-len owords))) (+ (cells-len words) (cells-len lines)))))

(defn ^I32 nth-rec [^Cells rq ^I32 n]
  (comment "The cell where record `n` (0-based) of the requests starts.")
  (let [^:mut ^I32 at 0
        ^:mut ^I32 k 0]
    (while (< k n)
      (do (set at (+ at (cells-at rq at)))
          (set k (+ k 1))))
    (return at)))

(defn ^I32 answer-renders [^:mut ^Cells ans ^I32 page]
  (comment "Both renders of page `page` answered, 2550 x 3300 RGB at 300 dpi.")
  (an-render ans (pu-id page (pi-render-text)) 2550 3300 3 300)
  (an-render ans (pu-id page (pi-render-no-text)) 2550 3300 3 300)
  (return 0))

(deftest test-ids-are-per-page-unit
  (assert-eq (pu-id 0 (pi-decode)) 260 "page 0 decode")
  (assert-eq (pu-id 0 (pi-render-text)) 257 "page 0 render with text")
  (assert-eq (pu-id 41 (pi-decode)) 10756 "page 41 decode: 42 * 256 + 4")
  (assert-eq (pu-view-id 0 1) (+ (view-base) 1) "a kin-made view of page 0")
  (assert-eq (pu-view-id 2 5) (+ (view-base) 517) "and of page 2")
  (assert-that (> (view-base) (pu-id 60000 255)) "no request id reaches the views' range"))

(deftest test-a-scanned-pages-unit-asks-for-its-stream-under-its-own-id
  (let [^Cells pl (new-cells)
        ^Cells rq (new-cells)]
    (plan-of pl 3 (pk-scan))
    (assert-eq (run-page 1 2 pl (new-cells) rq) (us-requests) "it asks")
    (assert-eq (rec-kind rq 0) (pk-decode) "a decode")
    (assert-eq (rec-id rq 0) 516 "page 1: 2 * 256 + 4")
    (assert-eq (rq-arg rq 0 0) 3 "of input 3")
    (assert-eq (rq-arg rq 0 1) 100 "the stream's start")
    (assert-eq (rq-arg rq 0 2) 50 "and length")
    (assert-eq (rq-arg rq 0 3) (flt-dct) "a DCT stream")))

(deftest test-a-unit-with-no-answers-asks-the-same-every-time
  (let [^Cells pl (new-cells)
        ^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)]
    (plan-of pl 2 (pk-scan))
    (run-page 0 2 pl (new-cells) rq1)
    (run-page 0 2 pl (new-cells) rq2)
    (assert-eq (cells-len rq1) (cells-len rq2) "the same length")
    (assert-eq (cells-at rq1 2) (cells-at rq2 2) "the same id")
    (assert-eq (cells-at rq1 4) (cells-at rq2 4) "the same arguments")))

(deftest test-a-born-digital-page-asks-what-its-plan-says
  (comment "a plan that asks nothing (`ocr: auto` on a healthy page): nothing is asked, whatever the policy")
  (let [^Cells pl1 (new-cells)
        ^Cells rq1 (new-cells)]
    (born-plan pl1 2 (rp-ask-none) 0)
    (assert-eq (run-page 1 2 pl1 (new-cells) rq1) (us-done) "always, but the plan asks nothing")
    (assert-eq (cells-len rq1) 0 "no request"))
  (comment "`full`: the two renders in round 1, the same every time")
  (let [^Cells pl2 (new-cells)
        ^Cells rq2 (new-cells)
        ^Cells rq3 (new-cells)]
    (born-plan pl2 2 (rp-ask-full) 0)
    (assert-eq (run-page 1 2 pl2 (new-cells) rq2) (us-requests) "it asks")
    (run-page 1 2 pl2 (new-cells) rq3)
    (assert-eq (cells-len rq2) 14 "two renders of seven cells")
    (assert-eq (cells-len rq3) 14 "the same again")
    (assert-eq (rec-kind rq2 0) (pk-render) "a render")
    (assert-eq (rec-id rq2 0) 513 "page 1, with text: 2 * 256 + 1")
    (assert-eq (rq-arg rq2 0 0) 3 "of input 3")
    (assert-eq (rq-arg rq2 0 1) 1 "page 1, 0-based")
    (assert-eq (rq-arg rq2 0 2) 300 "at 300 dpi")
    (assert-eq (rq-arg rq2 0 3) (lay-full) "with its text")
    (assert-eq (rec-id rq2 7) 514 "and without it")
    (assert-eq (rq-arg rq2 7 3) (lay-no-text) "the layer"))
  (comment "the renderer answers `unsupported`: nothing more is asked, nothing is written, the page is the text layer's")
  (let [^Cells pl4 (new-cells)
        ^Cells ans4 (new-cells)
        ^Cells rq4 (new-cells)]
    (born-plan pl4 1 (rp-ask-full) 0)
    (an-fail ans4 (pk-render) 257 (ps-unsupported))
    (an-fail ans4 (pk-render) 258 (ps-unsupported))
    (assert-eq (run-page 0 2 pl4 ans4 rq4) (us-done) "no render, no OCR, done")
    (assert-eq (cells-len rq4) 0 "nothing asked"))
  (comment "`never` plans nothing, and a page with no text layer nor a scan asks nothing")
  (let [^Cells pl5 (new-cells)
        ^Cells rq5 (new-cells)]
    (born-plan pl5 1 (rp-ask-full) 0)
    (assert-eq (run-page 0 0 pl5 (new-cells) rq5) (us-done) "never: done")
    (assert-eq (cells-len rq5) 0 "no request"))
  (let [^Cells pl6 (new-cells)
        ^Cells rq6 (new-cells)]
    (plan-of pl6 1 (pk-none))
    (assert-eq (run-page 0 2 pl6 (new-cells) rq6) (us-done) "no image: done")
    (assert-eq (cells-len rq6) 0 "no request")))

(deftest test-under-full-the-whole-render-with-its-text-is-read-in-round-two-in-the-text-layers-scripts
  (let [^Cells pl (new-cells)
        ^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells pl1 (new-cells)
        ^Cells rq1 (new-cells)]
    (born-plan pl 1 (rp-ask-full) 0)
    (answer-renders ans 0)
    (assert-eq (run-page 0 2 pl ans rq) (us-requests) "the OCR is asked")
    (assert-eq (rec-count rq) 1 "one request")
    (assert-eq (rec-kind rq 0) (pk-ocr) "an OCR")
    (assert-eq (rec-id rq 0) 272 "the page's first pass: 256 + 16")
    (assert-eq (rq-arg rq 0 0) 257 "of the render with its text")
    (assert-eq (rq-arg rq 0 1) 3 "psm 3")
    (assert-eq (rq-arg rq 0 5) 0 "the whole bitmap")
    (assert-eq (cells-len rq) 10 "no language: every model")
    (comment "a Latin text layer asks for the Latin script's models")
    (born-plan pl1 1 (rp-ask-full) 1)
    (run-page 0 2 pl1 ans rq1)
    (assert-eq (cells-len rq1) 11 "one language cell")
    (assert-eq (cells-at rq1 10) 1281455214 "`Latn`")))

(deftest test-under-witness-the-render-without-its-text-and-the-witness-lines-are-read-in-round-two
  (let [^Cells pl (new-cells)
        ^Cells ans (new-cells)
        ^Cells rq (new-cells)]
    (born-plan pl 1 (rp-ask-witness) 0)
    (cells-set pl (rp-f-wat) (cells-len pl))
    (cells-set pl (rp-f-wn) 2)
    (comment "two witness rows: page 0, line 4 then line 9, boxes in centipoints, font 7")
    (cells-push pl 0) (cells-push pl 4) (cells-push pl 7200) (cells-push pl 14400) (cells-push pl 36000) (cells-push pl 15600) (cells-push pl 7) (cells-push pl 0)
    (cells-push pl 0) (cells-push pl 9) (cells-push pl 7200) (cells-push pl 16800) (cells-push pl 36000) (cells-push pl 18000) (cells-push pl 7) (cells-push pl 0)
    (answer-renders ans 0)
    (assert-eq (run-page 0 2 pl ans rq) (us-requests) "the first pass is asked")
    (assert-eq (rec-count rq) 3 "the render without text, and two witness lines")
    (let [^I32 r0 (nth-rec rq 0)
          ^I32 r1 (nth-rec rq 1)
          ^I32 r2 (nth-rec rq 2)]
      (assert-eq (rec-id rq r0) 272 "the first pass")
      (assert-eq (rq-arg rq r0 0) 258 "of the render WITHOUT its text")
      (assert-eq (rq-arg rq r0 1) 3 "psm 3")
      (assert-eq (rec-id rq r1) 352 "witness line 0: 256 + 96")
      (assert-eq (rq-arg rq r1 0) 257 "of the render WITH its text")
      (assert-eq (rq-arg rq r1 1) 7 "psm 7")
      (assert-eq (rq-arg rq r1 3) 297 "x: 72 pt at 300 dpi less the pad of 3")
      (assert-eq (rq-arg rq r1 4) 597 "y")
      (assert-eq (rq-arg rq r1 5) 1206 "width")
      (assert-eq (rq-arg rq r1 6) 56 "height")
      (assert-eq (rec-id rq r2) 353 "witness line 1"))))

(deftest test-a-dry-attempt-asks-what-the-real-one-asks-before-its-first-write-and-then-stops
  (comment "P10.2: a scanned page. With no answer a dry attempt asks the decode, as the real one; with the decode answered it asks the OCR, as the real one;")
  (comment "with the OCR answered too the real attempt goes on to write the page, and the dry one stops where the write would begin, having written nothing.")
  (let [^Cells pl (new-cells)
        ^Cells ans (new-cells)
        ^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)
        ^Cells rq3 (new-cells)
        ^Cells rq4 (new-cells)
        ^Cells mask (new-cells)
        ^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)]
    (plan-of pl 1 (pk-scan))
    (assert-eq (run-page-watched 0 2 4 pl ans rq1 mask epages views olines owords words lines) (us-requests) "dry: it asks the decode")
    (run-page-watched 0 2 0 pl (new-cells) rq2 mask epages views olines owords words lines)
    (assert-eq (cells-len rq1) (cells-len rq2) "the same request as the real attempt's")
    (assert-eq (cells-at rq1 2) (cells-at rq2 2) "under the same id")
    (an-decode ans 260 2550 3300 1 30000 0 1)
    (assert-eq (run-page-watched 0 2 4 pl ans rq3 mask epages views olines owords words lines) (us-requests) "dry: with the decode answered it asks the OCR")
    (assert-eq (rec-kind rq3 0) (pk-ocr) "an OCR")
    (assert-eq (rec-id rq3 0) 272 "of the page's first pass")
    (an-render ans 272 2550 3300 1 300)
    (assert-eq (run-page-watched 0 2 4 pl ans rq4 mask epages views olines owords words lines) (us-done) "dry: with the OCR answered it stops")
    (assert-eq (cells-len rq4) 0 "asking nothing")
    (assert-eq (watched-len mask epages views olines owords words lines) 0 "and having written nothing")))

(deftest test-a-dry-attempt-of-a-born-digital-page-stops-before-its-first-write
  (let [^Cells pl (new-cells)
        ^Cells ans (new-cells)
        ^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)
        ^Cells rq3 (new-cells)
        ^Cells mask (new-cells)
        ^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)]
    (born-plan pl 1 (rp-ask-full) 0)
    (assert-eq (run-page-watched 0 2 4 pl ans rq1 mask epages views olines owords words lines) (us-requests) "dry: the two renders")
    (assert-eq (cells-len rq1) 14 "of seven cells each, as the real attempt's")
    (answer-renders ans 0)
    (assert-eq (run-page-watched 0 2 4 pl ans rq2 mask epages views olines owords words lines) (us-requests) "dry: the renders answered, the OCR")
    (assert-eq (rec-kind rq2 0) (pk-ocr) "an OCR")
    (an-render ans 272 2550 3300 3 300)
    (assert-eq (run-page-watched 0 2 4 pl ans rq3 mask epages views olines owords words lines) (us-done) "dry: the OCR answered, it stops")
    (assert-eq (cells-len rq3) 0 "asking nothing")
    (assert-eq (watched-len mask epages views olines owords words lines) 0 "and having written nothing")))

(deftest test-the-bitmap-set-keeps-what-kin-makes
  (let [^BitmapSet s (new-bitmap-set)]
    (assert-eq (bms-has s 5) 0 "empty")
    (assert-eq (bitmap-w (bms-get s 5)) 0 "an absent bitmap is 0 x 0")
    (assert-eq (bitmap-h (bms-get s 5)) 0 "in both directions")
    (let [^Bitmap b (bms-put s (view-base) 4 3 1)]
      (assert-eq (bms-has s (view-base)) 1 "put")
      (assert-eq (bitmap-w b) 4 "its width")
      (assert-eq (bitmap-h b) 3 "its height")
      (assert-eq (bitmap-channels b) 1 "its channels")
      (assert-eq (bitmap-u8 b 1 1 0) 0 "zeroed")
      (bitmap-set-u8 b 1 1 0 200)
      (assert-eq (bitmap-u8 (bms-get s (view-base)) 1 1 0) 200 "the set holds the very bitmap kin filled"))
    (assert-eq (bms-has s (+ (view-base) 1)) 0 "another id is absent")))
