;; Laws for `emon.xalign` (P7.1; SPEC 9.2; D202, D250-D252), on every target.
;;
;; THE HEADS ARE BUILT BY HAND (the document fixtures are `bb align`'s): a text-layer word, an OCR word and a tracer line are
;; head rows like any other (SPEC 8.4.1), so what is held here is the alignment alone: 1:1 on a clean line, a split (`Chapter1`
;; read as `Chapter` `1`) and a merge, a missing word each way (text-only, OCR-only, and the order the groups come in), a line at 30
;; degrees whose boxes are large, a right-to-left line (logical order on both sides: the OCR words are given in visual order),
;; two OCR runs over one line (one group holds both runs; the first run's similarity is the group's, the second's is a column) and
;; their OCR-only words joining across runs, a `hidden-text` layer under the OCR, an invisible word that is not a candidate, a
;; tracer line a group sits on, the two similarities (case kept, case-folded letters), pages that do not leak into each other,
;; and a line too long for the dynamic program.
(ns emon.xaligntest
  (:require [emon.lang :refer [I32 Cells Blob]]
            [emon.test :refer [deftest assert-eq assert-that new-cells text-blob TestT test-t]]
            [emon.port :refer [cells-len cells-at blob-len blob-u8]]
            [emon.model :refer [sr-text sr-hidden-text]]
            [emon.evidence :refer [ep-new wd-new wd-set wd-count ow-new ow-set ow-count tl-new fe-new fe-set fe-get rf-get
                                   etx-append-cp etx-len
                                   ea-words ea-owords wf-src owf-run hd-feat xt-vis xt-sim-ocr xt-sim-ocr2 xo-sim-text xo-sim-hidden]]
            [emon.player :refer [cg-count cg-get cgf-tfirst cgf-tcount cgf-ofirst cgf-ocount cgf-hfirst cgf-hcount cgf-tline
                                 cgf-sim cgf-simfold cgf-flags plg-text-only plg-ocr-only plg-split plg-merged]]
            [emon.xalign :refer [xa-page]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 xl-txt [^:mut ^Cells etext ^Blob b]
  (comment "Append the bytes of b as code points; answer where the first went.")
  (let [^I32 at (etx-len etext)
        ^I32 n (blob-len b)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (etx-append-cp etext (blob-u8 b i))
          (set i (+ i 1))))
    (return at)))

(defn ^I32 xl-tw [^:mut ^Cells words ^:mut ^Cells etext ^:mut ^Cells feats ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1
                  ^I32 rot ^I32 dir ^I32 line ^I32 src ^I32 vis ^Blob b]
  (comment "A text-layer word: its box, the baseline along the bottom edge, its text, line, `src` and worst `vis`; answers its row.")
  (let [^I32 at (xl-txt etext b)
        ^I32 n (blob-len b)
        ^I32 w (wd-count words)
        ^I32 f (fe-new feats (ea-words) w)]
    (wd-new words page x0 y0 x1 y1 x0 y1 x1 y1 rot dir at n line -1 f)
    (wd-set words w (wf-src) src)
    (fe-set feats f (xt-vis) vis)
    (return w)))

(defn ^I32 xl-ow [^:mut ^Cells owords ^:mut ^Cells etext ^:mut ^Cells feats ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1
                  ^I32 rot ^I32 dir ^I32 run ^Blob b]
  (comment "An OCR word of run `run` (an `oruns` row): its box, text; answers its row.")
  (let [^I32 at (xl-txt etext b)
        ^I32 n (blob-len b)
        ^I32 w (ow-count owords)
        ^I32 f (fe-new feats (ea-owords) w)]
    (ow-new owords page x0 y0 x1 y1 x0 y1 x1 y1 rot dir at n -1 900 f)
    (ow-set owords w (owf-run) run)
    (return w)))

(defn ^I32 xl-align [^:mut ^Cells epages ^Cells words ^Cells owords ^Cells tlines ^:mut ^Cells feats ^Cells etext
                     ^:mut ^Cells refs ^:mut ^Cells cg ^I32 page]
  (comment "Align one page with fresh scratch; answers the groups appended.")
  (let [^Cells scr (new-cells)
        ^Cells gp (new-cells)
        ^Cells dp (new-cells)
        ^Cells ta (new-cells)
        ^Cells tb (new-cells)
        ^Cells tt (new-cells)]
    (return (xa-page page epages words owords tlines feats etext refs cg scr gp dp ta tb tt))))

(defn ^I32 xl-ref [^Cells cg ^Cells refs ^I32 g ^I32 first-field ^I32 k]
  (comment "The row index the k-th reference of a run of group g (the run's first-field) points at.")
  (return (rf-get refs (+ (cg-get cg g first-field) k) 1)))

(deftest test-a-clean-line-is-one-to-one
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (xl-tw words etext feats 1 7200 10000 9600 11200 0 0 0 (sr-text) 0 (text-blob "The"))
    (xl-tw words etext feats 1 10200 10000 13800 11200 0 0 0 (sr-text) 0 (text-blob "quick"))
    (xl-tw words etext feats 1 14400 10000 18600 11200 0 0 0 (sr-text) 0 (text-blob "brown"))
    (xl-tw words etext feats 1 19200 10000 21600 11200 0 0 0 (sr-text) 0 (text-blob "fox"))
    (xl-ow owords etext feats 1 7260 10040 9660 11260 0 0 0 (text-blob "The"))
    (xl-ow owords etext feats 1 10260 10040 13860 11260 0 0 0 (text-blob "quick"))
    (xl-ow owords etext feats 1 14460 10040 18660 11260 0 0 0 (text-blob "brown"))
    (xl-ow owords etext feats 1 19260 10040 21660 11260 0 0 0 (text-blob "fox"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 4 "four groups")
    (assert-eq (cg-count cg) 4 "four rows")
    (assert-eq (cg-get cg 0 (cgf-tcount)) 1 "the first group has a text word")
    (assert-eq (cg-get cg 0 (cgf-ocount)) 1 "and an OCR word")
    (assert-eq (cg-get cg 3 (cgf-flags)) 0 "no flags")
    (assert-eq (cg-get cg 2 (cgf-sim)) 1000 "brown / brown")
    (assert-eq (cg-get cg 2 (cgf-simfold)) 1000 "folded too")
    (assert-eq (xl-ref cg refs 2 (cgf-tfirst) 0) 2 "the third group's text word is words row 2")
    (assert-eq (xl-ref cg refs 2 (cgf-ofirst) 0) 2 "and OCR word 2")
    (assert-eq (cg-get cg 1 (cgf-hcount)) 0 "no hidden words")
    (assert-eq (cg-get cg 1 (cgf-hfirst)) -1 "so an absent run")
    (assert-eq (cg-get cg 1 (cgf-tline)) -1 "no tracer line")
    (assert-eq (cg-get cg 0 1) 7200 "the box is the union: x0")
    (assert-eq (cg-get cg 0 3) 9660 "the box is the union: x1")
    (assert-eq (fe-get feats 0 (xt-sim-ocr)) 1000 "the text word's column 24")
    (assert-eq (fe-get feats 6 (xo-sim-text)) 1000 "the OCR word's column 24")
    (assert-eq (fe-get feats 2 (xt-sim-ocr2)) -1 "no second run: column 25 stays")))

(deftest test-the-two-similarities
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "Hello,"))
    (xl-tw words etext feats 1 11000 10000 14000 11200 0 0 0 (sr-text) 0 (text-blob "World"))
    (xl-ow owords etext feats 1 7200 10000 10200 11200 0 0 0 (text-blob "hello"))
    (xl-ow owords etext feats 1 11000 10000 14000 11200 0 0 0 (text-blob "Wor1d"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 2 "two groups")
    (assert-eq (cg-get cg 0 (cgf-sim)) 666 "case and a comma: 4 of 6")
    (assert-eq (cg-get cg 0 (cgf-simfold)) 1000 "folded letters: equal")
    (assert-eq (cg-get cg 1 (cgf-sim)) 800 "one wrong letter: 4 of 5")
    (assert-eq (cg-get cg 1 (cgf-simfold)) 800 "and folded the same")
    (assert-eq (fe-get feats 1 (xt-sim-ocr)) 800 "the text word's column")))

(deftest test-a-merge-and-a-split
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "the text layer says `Chapter` `1`, OCR reads `Chapter1`: a merge")
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "Chapter"))
    (xl-tw words etext feats 1 10500 10000 11100 11200 0 0 0 (sr-text) 0 (text-blob "1"))
    (xl-ow owords etext feats 1 7200 10000 11150 11200 0 0 0 (text-blob "Chapter1"))
    (comment "and the other way on the next line: the text layer's `Section2`, OCR's `Section` `2`: a split")
    (xl-tw words etext feats 1 7200 14000 12000 15200 0 0 1 (sr-text) 0 (text-blob "Section2"))
    (xl-ow owords etext feats 1 7200 14000 11400 15200 0 0 0 (text-blob "Section"))
    (xl-ow owords etext feats 1 11700 14000 12000 15200 0 0 0 (text-blob "2"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 2 "two groups")
    (assert-eq (cg-get cg 0 (cgf-tcount)) 2 "the merge holds both text words")
    (assert-eq (cg-get cg 0 (cgf-ocount)) 1 "and one OCR word")
    (assert-eq (cg-get cg 0 (cgf-flags)) 8 "merged")
    (assert-eq (cg-get cg 0 (cgf-sim)) 1000 "Chapter1 is Chapter 1")
    (assert-eq (cg-get cg 1 (cgf-tcount)) 1 "the split has one text word")
    (assert-eq (cg-get cg 1 (cgf-ocount)) 2 "and two OCR words")
    (assert-eq (cg-get cg 1 (cgf-flags)) 4 "split")
    (assert-eq (cg-get cg 1 (cgf-sim)) 1000 "Section2 is Section 2")))

(deftest test-words-the-steps-do-not-reach-are-attached
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "line 0: the text layer's `Section2.1`, OCR's `Section` `2` `.1` (three words: no step reaches it)")
    (xl-tw words etext feats 1 7200 10000 13200 11200 0 0 0 (sr-text) 0 (text-blob "Section2.1"))
    (xl-ow owords etext feats 1 7200 10000 11000 11200 0 0 0 (text-blob "Section"))
    (xl-ow owords etext feats 1 11300 10000 11900 11200 0 0 0 (text-blob "2"))
    (xl-ow owords etext feats 1 12100 10000 13200 11200 0 0 0 (text-blob ".1"))
    (comment "line 1: the text layer's `a` `b` `c` set tight, OCR's `abc`")
    (xl-tw words etext feats 1 7200 14000 8000 15200 0 0 1 (sr-text) 0 (text-blob "a"))
    (xl-tw words etext feats 1 8000 14000 8800 15200 0 0 1 (sr-text) 0 (text-blob "b"))
    (xl-tw words etext feats 1 8800 14000 9600 15200 0 0 1 (sr-text) 0 (text-blob "c"))
    (xl-ow owords etext feats 1 7200 14000 9600 15200 0 0 0 (text-blob "abc"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 2 "two groups, not four or five")
    (assert-eq (cg-get cg 0 (cgf-tcount)) 1 "Section2.1 is one text word")
    (assert-eq (cg-get cg 0 (cgf-ocount)) 3 "with its three OCR words")
    (assert-eq (cg-get cg 0 (cgf-flags)) 4 "split")
    (assert-eq (cg-get cg 0 (cgf-sim)) 1000 "Section2.1 is Section 2 .1")
    (assert-eq (cg-get cg 1 (cgf-tcount)) 3 "a b c are three text words")
    (assert-eq (cg-get cg 1 (cgf-ocount)) 1 "with one OCR word")
    (assert-eq (cg-get cg 1 (cgf-flags)) 8 "merged")
    (assert-eq (cg-get cg 1 (cgf-sim)) 1000 "abc")))

(deftest test-a-missing-word-each-way
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "line 0: the text layer has a b c, OCR missed b. line 1: the text layer has d f, OCR also read e between them.")
    (xl-tw words etext feats 1 7200 10000 9600 11200 0 0 0 (sr-text) 0 (text-blob "alpha"))
    (xl-tw words etext feats 1 10200 10000 12600 11200 0 0 0 (sr-text) 0 (text-blob "bravo"))
    (xl-tw words etext feats 1 13200 10000 15600 11200 0 0 0 (sr-text) 0 (text-blob "delta"))
    (xl-tw words etext feats 1 7200 14000 9600 15200 0 0 1 (sr-text) 0 (text-blob "echo"))
    (xl-tw words etext feats 1 13200 14000 15600 15200 0 0 1 (sr-text) 0 (text-blob "golf"))
    (xl-ow owords etext feats 1 7200 10000 9600 11200 0 0 0 (text-blob "alpha"))
    (xl-ow owords etext feats 1 13200 10000 15600 11200 0 0 0 (text-blob "delta"))
    (xl-ow owords etext feats 1 7200 14000 9600 15200 0 0 0 (text-blob "echo"))
    (xl-ow owords etext feats 1 10200 14000 12600 15200 0 0 0 (text-blob "foxtrot"))
    (xl-ow owords etext feats 1 13200 14000 15600 15200 0 0 0 (text-blob "golf"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 6 "alpha, bravo, delta, echo, golf, foxtrot")
    (assert-eq (cg-get cg 1 (cgf-flags)) (plg-text-only) "bravo: text-only")
    (assert-eq (cg-get cg 1 (cgf-ocount)) 0 "bravo: no OCR")
    (assert-eq (cg-get cg 1 (cgf-sim)) -1 "bravo: no similarity")
    (assert-eq (cg-get cg 0 (cgf-ocount)) 1 "alpha is matched")
    (assert-eq (cg-get cg 2 (cgf-ocount)) 1 "delta is matched")
    (assert-eq (cg-get cg 5 (cgf-flags)) (plg-ocr-only) "foxtrot: OCR-only, and last (the OCR-only ones follow the text layer's)")
    (assert-eq (cg-get cg 5 (cgf-tcount)) 0 "foxtrot: no text")
    (assert-eq (cg-get cg 5 (cgf-tfirst)) -1 "foxtrot: an absent run")
    (assert-eq (xl-ref cg refs 5 (cgf-ofirst) 0) 3 "foxtrot is OCR word 3")
    (assert-eq (cg-get cg 5 (cgf-sim)) -1 "foxtrot: no similarity")
    (assert-eq (cg-get cg 4 (cgf-ocount)) 1 "golf is matched")
    (assert-eq (fe-get feats 1 (xt-sim-ocr)) -1 "bravo's column stays")))

(deftest test-a-line-at-thirty-degrees
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "four words along a line rising at 30 degrees, each box 3200 square so neighbours' boxes touch; the OCR boxes are a little off")
    (xl-tw words etext feats 1 5600 28400 8800 31600 3000 0 0 (sr-text) 0 (text-blob "one"))
    (xl-tw words etext feats 1 8200 26900 11400 30100 3000 0 0 (sr-text) 0 (text-blob "two"))
    (xl-tw words etext feats 1 10800 25400 14000 28600 3000 0 0 (sr-text) 0 (text-blob "three"))
    (xl-tw words etext feats 1 13400 23900 16600 27100 3000 0 0 (sr-text) 0 (text-blob "four"))
    (xl-ow owords etext feats 1 5640 28440 8840 31640 3000 0 0 (text-blob "one"))
    (xl-ow owords etext feats 1 8240 26940 11440 30140 3000 0 0 (text-blob "two"))
    (xl-ow owords etext feats 1 10840 25440 14040 28640 3000 0 0 (text-blob "three"))
    (xl-ow owords etext feats 1 13440 23940 16640 27140 3000 0 0 (text-blob "four"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 4 "four groups")
    (assert-eq (xl-ref cg refs 1 (cgf-ofirst) 0) 1 "two pairs with two")
    (assert-eq (xl-ref cg refs 3 (cgf-ofirst) 0) 3 "four pairs with four")
    (assert-eq (cg-get cg 2 (cgf-sim)) 1000 "three")
    (assert-eq (cg-get cg 0 (cgf-flags)) 0 "no flags")
    (assert-eq (cg-get cg 0 5) 3000 "the group's angle is the text word's")))

(deftest test-a-right-to-left-line-is-in-logical-order
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "the text layer in logical order, first word at the right (the baseline runs left to right, as the evidence has it)")
    (xl-tw words etext feats 1 20000 10000 23000 11200 0 1 0 (sr-text) 0 (text-blob "first"))
    (xl-tw words etext feats 1 16000 10000 19000 11200 0 1 0 (sr-text) 0 (text-blob "second"))
    (xl-tw words etext feats 1 12000 10000 15000 11200 0 1 0 (sr-text) 0 (text-blob "third"))
    (comment "OCR in VISUAL order, left to right, so only the reversal of a right-to-left line pairs them")
    (xl-ow owords etext feats 1 12000 10000 15000 11200 0 1 0 (text-blob "third"))
    (xl-ow owords etext feats 1 16000 10000 19000 11200 0 1 0 (text-blob "second"))
    (xl-ow owords etext feats 1 20000 10000 23000 11200 0 1 0 (text-blob "first"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 3 "three groups")
    (assert-eq (cg-get cg 0 (cgf-sim)) 1000 "first is first")
    (assert-eq (cg-get cg 1 (cgf-sim)) 1000 "second is second")
    (assert-eq (cg-get cg 2 (cgf-sim)) 1000 "third is third")
    (assert-eq (xl-ref cg refs 0 (cgf-ofirst) 0) 2 "first is the last OCR word")))

(deftest test-two-ocr-runs-share-the-groups
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "Hello"))
    (xl-tw words etext feats 1 11000 10000 14000 11200 0 0 0 (sr-text) 0 (text-blob "world"))
    (comment "run 0 reads both, then the stamp the text layer does not have; run 1 reads both with a wrong letter and the stamp too")
    (xl-ow owords etext feats 1 7200 10000 10200 11200 0 0 0 (text-blob "Hello"))
    (xl-ow owords etext feats 1 11000 10000 14000 11200 0 0 0 (text-blob "world"))
    (xl-ow owords etext feats 1 20000 10000 24000 11200 0 0 0 (text-blob "PAID"))
    (xl-ow owords etext feats 1 7230 10020 10230 11220 0 0 4 (text-blob "Hello"))
    (xl-ow owords etext feats 1 11030 10020 14030 11220 0 0 4 (text-blob "wor1d"))
    (xl-ow owords etext feats 1 20030 10020 24030 11220 0 0 4 (text-blob "PA1D"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 3 "three groups: Hello, world, the stamp")
    (assert-eq (cg-get cg 0 (cgf-ocount)) 2 "a group holds both runs' words")
    (assert-eq (cg-get cg 1 (cgf-ocount)) 2 "world as well")
    (assert-eq (cg-get cg 1 (cgf-sim)) 1000 "the group's similarity is the first run's")
    (assert-eq (fe-get feats 1 (xt-sim-ocr)) 1000 "the text word's column 24 is the first run's")
    (assert-eq (fe-get feats 1 (xt-sim-ocr2)) 800 "and its column 25 the second's")
    (assert-eq (fe-get feats 6 (xo-sim-text)) 800 "the second run's word has its own")
    (assert-eq (cg-get cg 2 (cgf-flags)) (plg-ocr-only) "the stamp is OCR-only")
    (assert-eq (cg-get cg 2 (cgf-ocount)) 2 "and both runs' readings of it are one group")
    (assert-eq (cg-get cg 2 (cgf-tcount)) 0 "without a text word")))

(deftest test-hidden-text-and-an-invisible-word
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (comment "a visible word, a hidden-text word (an older OCR layer under a scan) and a word that is clipped away (vis 1)")
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "seen"))
    (xl-tw words etext feats 1 11000 10000 14000 11200 0 0 1 (sr-hidden-text) 0 (text-blob "older"))
    (xl-tw words etext feats 1 15000 10000 18000 11200 0 0 2 (sr-text) 1 (text-blob "clip"))
    (xl-ow owords etext feats 1 7200 10000 10200 11200 0 0 0 (text-blob "seen"))
    (xl-ow owords etext feats 1 11000 10000 14000 11200 0 0 0 (text-blob "olden"))
    (xl-ow owords etext feats 1 15000 10000 18000 11200 0 0 0 (text-blob "clip"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 3 "seen, the hidden layer's word, and the OCR-only clip")
    (assert-eq (cg-get cg 0 (cgf-tcount)) 1 "seen is a visible word")
    (assert-eq (cg-get cg 1 (cgf-tcount)) 0 "the hidden word is not in the visible run")
    (assert-eq (cg-get cg 1 (cgf-hcount)) 1 "it is in the hidden one")
    (assert-eq (cg-get cg 1 (cgf-ocount)) 1 "with its OCR word")
    (assert-eq (cg-get cg 1 (cgf-sim)) 800 "older / olden, hidden against OCR")
    (assert-eq (fe-get feats 4 (xo-sim-hidden)) 800 "the OCR word's column 25")
    (assert-eq (fe-get feats 4 (xo-sim-text)) -1 "and not column 24")
    (assert-eq (cg-get cg 2 (cgf-flags)) (plg-ocr-only) "the clipped word is no candidate: OCR-only")
    (assert-eq (cg-get cg 2 (cgf-tcount)) 0 "no text")))

(deftest test-a-tracer-line-under-a-group
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "one"))
    (xl-tw words etext feats 1 7200 30000 10200 31200 0 0 1 (sr-text) 0 (text-blob "two"))
    (tl-new tlines 1 6000 9800 40000 11400 6000 11300 40000 11300 0 0 -1 0)
    (tl-new tlines 1 6000 29800 40000 31400 6000 31300 40000 31300 0 0 -1 0)
    (tl-new tlines 2 6000 9800 40000 11400 6000 11300 40000 11300 0 0 -1 0)
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 2 "two text-only groups")
    (assert-eq (cg-get cg 0 (cgf-tline)) 0 "the first sits on the first tracer line")
    (assert-eq (cg-get cg 1 (cgf-tline)) 1 "the second on the second")
    (assert-eq (cg-get cg 0 (cgf-flags)) (plg-text-only) "text-only")))

(deftest test-pages-do-not-leak
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)]
    (ep-new epages 1 61200 79200)
    (ep-new epages 2 61200 79200)
    (xl-tw words etext feats 1 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "page"))
    (xl-tw words etext feats 2 7200 10000 10200 11200 0 0 0 (sr-text) 0 (text-blob "next"))
    (xl-ow owords etext feats 1 7200 10000 10200 11200 0 0 0 (text-blob "page"))
    (xl-ow owords etext feats 2 7200 10000 10200 11200 0 0 0 (text-blob "mext"))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 1 "page 1: one group")
    (assert-eq (cg-get cg 0 (cgf-sim)) 1000 "page")
    (assert-eq (cg-get cg 0 0) 1 "on page 1")
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 2) 1 "page 2: one group")
    (assert-eq (cg-get cg 1 (cgf-sim)) 750 "next / mext")
    (assert-eq (cg-get cg 1 0) 2 "on page 2")
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 3) 0 "page 3: nothing")
    (assert-eq (cg-count cg) 2 "two rows")
    (assert-eq (rf-get refs (cg-get cg 1 (cgf-tfirst)) 1) 1 "page 2's text word is words row 1")))

(deftest test-a-line-too-long-for-the-table-is-paired-greedily
  (let [^Cells epages (new-cells)
        ^Cells words (new-cells)
        ^Cells owords (new-cells)
        ^Cells tlines (new-cells)
        ^Cells feats (new-cells)
        ^Cells etext (new-cells)
        ^Cells refs (new-cells)
        ^Cells cg (new-cells)
        ^:mut ^I32 i 0]
    (ep-new epages 1 100000000 79200)
    (while (< i 1100)
      (do (xl-tw words etext feats 1 (+ 1000 (* i 100)) 10000 (+ 1060 (* i 100)) 11200 0 0 0 (sr-text) 0 (text-blob "w"))
          (xl-ow owords etext feats 1 (+ 1005 (* i 100)) 10000 (+ 1065 (* i 100)) 11200 0 0 0 (text-blob "w"))
          (set i (+ i 1))))
    (assert-eq (xl-align epages words owords tlines feats etext refs cg 1) 1100 "every word is a group")
    (assert-eq (cg-get cg 1099 (cgf-ocount)) 1 "the last has its OCR word")
    (assert-eq (xl-ref cg refs 1099 (cgf-ofirst) 0) 1099 "which is the last")
    (assert-eq (cg-get cg 500 (cgf-flags)) 0 "paired")))
