;; Request flags survive the OIL answer replacement. Wire laws are in oiltest.
(ns emon.ocrtest
  (:require [emon.test :refer [deftest assert-eq]]
            [emon.ocr :refer [ocf-dpi ocf-osd ocf-symbols]]
            [kin.lang :refer [+ *]]))

(deftest test-the-resolution-hint-is-the-flags-above-the-low-byte
  (assert-eq (ocf-dpi (+ (ocf-symbols) (ocf-osd))) 0 "no hint in the low flags")
  (assert-eq (ocf-dpi (+ 3 (* 150 256))) 150 "150 dpi")
  (assert-eq (ocf-dpi (+ 3 (* 300 256))) 300 "300 dpi"))
