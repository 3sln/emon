;; Experimental scored table engine, initially the measured identity pipeline.
(ns emon.tscore
  (:require [emon.lang :refer [I32 Cells]]
            [emon.table :refer [tb-scored]]
            [kin.lang :refer [defn return]]))

(defn ^:pub ^I32 ts-build [^Cells wd ^:mut ^Cells ln ^Cells et ^Cells grl ^Cells gfl ^I32 np
                           ^:mut ^Cells tb ^:mut ^Cells tc ^:mut ^Cells tw ^:mut ^Cells tq ^:mut ^Cells tx
                           ^:mut ^Cells tbk ^:mut ^Cells tbo
                           ^:mut ^Cells s0 ^:mut ^Cells s1 ^:mut ^Cells s2 ^:mut ^Cells s3 ^:mut ^Cells s4
                           ^:mut ^Cells s5 ^:mut ^Cells s6 ^:mut ^Cells s7 ^:mut ^Cells s8 ^:mut ^Cells s9
                           ^:mut ^Cells s10 ^:mut ^Cells s11 ^:mut ^Cells s12 ^:mut ^Cells s13 ^:mut ^Cells s14
                           ^:mut ^Cells s15 ^:mut ^Cells s16 ^:mut ^Cells s17 ^:mut ^Cells s18
                           ^Cells pages
                           ^Cells gl ^Cells mk ^Cells se ^Cells sc ^Cells ss ^Cells grg
                           ^:mut ^Cells g0 ^:mut ^Cells g1 ^:mut ^Cells g2 ^:mut ^Cells g3 ^:mut ^Cells g4 ^:mut ^Cells g5
                           ^:mut ^Cells tv ^Cells an]
  (return (tb-scored wd ln et grl gfl np tb tc tw tq tx tbk tbo s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 pages gl mk se sc ss grg g0 g1 g2 g3 g4 g5 tv an)))
