;; THE TABLES OF LIMITS AND SETTINGS (P10.10; D396, D434; SPEC 7.4): every bound a kin source reads through `limit-of`, and every choice it reads
;; through `setting-of`, with its NAME, its DEFAULT and its RANGE, once. A host's `limit-of` is `override, then the environment, then this table's
;; default` and nothing more; it used to carry the table (`limit_spec`, in four spellings) and the names were parsed back out of an English message.
;;
;; THIS MODULE IS PURE (it refers no port form), which is what lets Go's `port` package import it: a module that writes text refers `text-ascii`, so
;; the generated package imports `port`, and `port` could not import it back (D405). The writing and parsing of names is `emon.config`'s.
;;
;; A KIND IS A ROW'S INDEX. The numbering is the contract the sources already use (`(limit-of 3)` is OBJECTS) and `kin/porttest.kin` still asserts
;; it on every host. A name is the spelling `limit.NAME` takes in an options text and the host's error reports (`input-bytes`); the environment
;; variable is `EMON_LIMIT_` and the name in capitals with `_` for `-`. A kind not in the table has default 0 and no name (a host reports `unknown`).
;;
;; A row of `lm-rows` is [default lo hi name-offset name-length on-hit]; `lm-chars` is every name back to back, as code points. The names and the rows
;; were written by a script and `kin/configtest.kin` holds each one to its literal.
;;
;; WHAT HAPPENS AT THE BOUND (`on-hit`, P10.4, D477): 0 a BREACH (`limit-breach`: a typed payload on every host, the conversion's named error); 1 a
;; BUDGET (the work stops there and the conversion goes on: a value that cannot be followed reads as absent, a form that is too deep is skipped with a
;; warning, a candidate past the cap is dropped; never an error: failing a long book for its 4097th footnote would be worse than dropping it); 2 RESERVED
;; (named and ranged so that `limit.NAME` and the environment already mean it, but nothing reads it yet: SPEC 7.4 names it ahead of the feature).
;; TWO ROWS ARE NOT COUNTS OF A DOCUMENT'S THINGS (P10.4 close): 14 `fonts-per-doc` is a budget ranged 0..512, the slab of font handles in `emon.pdfcontent`
;; (the font past it has evidence id -1 and its page is flagged); 15 `stage-ms` is a time, the milliseconds a unit of the plan loop may run, where 0 is OFF
;; (the default): the host's clock supplies the elapsed time and `pl-stage-over` of `emon.planloop` decides (D498, D501).
;; ROW 16 `workers` IS NOT A BOUND ON THE INPUT EITHER (P10.2, SPEC 12.1): it is the most workers the `parallel=N` option may be given. It is a budget (a larger N
;; is served with this many, the conversion goes on, and its bytes are the serial run's at any N); an embedder who must never run more than K threads sets
;; `limit.workers=K`, and `limit.workers=1` is serial whatever N says. The host reads it where it sizes its pool (`pl-workers` of `emon.planloop` is the clamp).
;; Its default is 16, not a machine's core count: each page a host looks ahead of the loop (N - 1 of them) holds its decoded bitmaps until the loop reaches it,
;; so the memory a run takes grows with N (D1305), and a host with more cores to give raises it.
;; `bb limits` reports the column, where each bound is read and which law or fixture exercises it.
(ns emon.limits
  (:require [emon.lang :refer [I32]]
            [kin.lang :refer [defn defdata return if or < >= + comment]]))

(defdata ^:pub lm-chars
  :emitter kin.lang/flat-array
  :data [105 110 112 117 116 45 98 121 116 101 115 115 116 114 101 97
         109 45 98 121 116 101 115 116 111 116 97 108 45 98 121 116
         101 115 111 98 106 101 99 116 115 114 101 102 45 100 101 112
         116 104 111 112 101 114 97 116 111 114 115 102 111 114 109 45
         100 101 112 116 104 112 97 116 116 101 114 110 45 100 101 112
         116 104 112 97 103 101 115 112 105 120 101 108 115 111 99 114
         45 114 101 113 117 101 115 116 115 110 111 116 101 45 98 111
         100 105 101 115 110 111 116 101 45 114 101 102 115 97 115 115
         101 116 45 112 108 97 99 101 109 101 110 116 115
         102 111 110 116 115 45 112 101 114 45 100 111 99
         115 116 97 103 101 45 109 115
         119 111 114 107 101 114 115]
  :accessors {^I32 lm-char-at [^I32 ignored ^I32 i]})

(defdata ^:pub lm-rows
  :emitter kin.lang/flat-array
  :stride 6
  :data [1073741824 0 2147483647 0 11 0     ;; 0  input-bytes
         268435456 0 2147483647 11 12 0     ;; 1  stream-bytes
         1073741824 0 2147483647 23 11 0    ;; 2  total-bytes
         10000000 0 2147483647 34 7 0       ;; 3  objects
         64 0 2147483647 41 9 1             ;; 4  ref-depth
         50000000 0 2147483647 50 9 0       ;; 5  operators
         32 0 32 59 10 1                    ;; 6  form-depth (the stack of the forms being run is 32 cells: `MAX_FORMS` of `emon.pdfcontent`)
         8 0 2147483647 69 13 2             ;; 7  pattern-depth
         100000 0 2147483647 82 5 0         ;; 8  pages
         268435456 0 2147483647 87 6 0      ;; 9  pixels
         100000 0 2147483647 93 12 0        ;; 10 ocr-requests
         4096 0 2147483647 105 11 1         ;; 11 note-bodies
         8192 0 2147483647 116 9 1          ;; 12 note-refs
         4096 0 2147483647 125 16 1         ;; 13 asset-placements
         512 0 512 141 13 1                 ;; 14 fonts-per-doc (the slab of font handles in `emon.pdfcontent` is 512 cells: `MAX_FIDS`)
         0 0 2147483647 154 8 0             ;; 15 stage-ms (0 is OFF; the host supplies the elapsed milliseconds, kin decides: `pl-stage-over`)
         16 0 2147483647 162 7 1]           ;; 16 workers (a BUDGET: the most workers `parallel=N` is given, P10.2; more is clamped to it, 0 means 1: `pl-workers`)
  :accessors {^I32 lm-row-count [^I32 ignored]
              ^I32 lm-row-at [^I32 ignored ^I32 row ^I32 field]})

;; A SETTING IS A CHOICE AND NOT A BOUND (`setting-of`): [default lo hi name-offset name-length]. OCR_MODE 0 auto / 1 always / 2 never (SPEC 17.1 is
;; still open, so `auto`), TASKS 0 serial / 1 parallel (D022: serial is the default).
(defdata ^:pub sg-chars
  :emitter kin.lang/flat-array
  :data [111 99 114 45 109 111 100 101 116 97 115 107 115]
  :accessors {^I32 sg-char-at [^I32 ignored ^I32 i]})

(defdata ^:pub sg-rows
  :emitter kin.lang/flat-array
  :stride 5
  :data [0 0 2 0 8                        ;; 0  ocr-mode
         0 0 1 8 5]                       ;; 1  tasks
  :accessors {^I32 sg-row-count [^I32 ignored]
              ^I32 sg-row-at [^I32 ignored ^I32 row ^I32 field]})

(defn ^:pub ^I32 lm-count []
  (return (lm-row-count 0)))

(defn ^:pub ^I32 lm-default [^I32 kind]
  (comment "The limit's default; 0 for a kind not in the table.")
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return 0))
  (return (lm-row-at 0 kind 0)))

(defn ^:pub ^I32 lm-lo [^I32 kind]
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return 0))
  (return (lm-row-at 0 kind 1)))

(defn ^:pub ^I32 lm-hi [^I32 kind]
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return 0))
  (return (lm-row-at 0 kind 2)))

(defn ^:pub ^I32 lm-on-hit [^I32 kind]
  (comment "What happens at the bound: 0 a breach (an error), 1 a budget (the work stops there, the conversion goes on), 2 reserved (nothing reads it yet).")
  (comment "0 for a kind not in the table.")
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return 0))
  (return (lm-row-at 0 kind 5)))

(defn ^:pub ^I32 lm-name-len [^I32 kind]
  (comment "The length of the limit's name, 0 for a kind not in the table.")
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return 0))
  (return (lm-row-at 0 kind 4)))

(defn ^:pub ^I32 lm-name-ch [^I32 kind ^I32 i]
  (comment "The i-th code point of the limit's name; -1 past its end or for a kind not in the table.")
  (if (or (< kind 0) (>= kind (lm-row-count 0))) (return -1))
  (if (or (< i 0) (>= i (lm-row-at 0 kind 4))) (return -1))
  (return (lm-char-at 0 (+ (lm-row-at 0 kind 3) i))))

(defn ^:pub ^I32 sg-count []
  (return (sg-row-count 0)))

(defn ^:pub ^I32 sg-default [^I32 kind]
  (if (or (< kind 0) (>= kind (sg-row-count 0))) (return 0))
  (return (sg-row-at 0 kind 0)))

(defn ^:pub ^I32 sg-lo [^I32 kind]
  (if (or (< kind 0) (>= kind (sg-row-count 0))) (return 0))
  (return (sg-row-at 0 kind 1)))

(defn ^:pub ^I32 sg-hi [^I32 kind]
  (if (or (< kind 0) (>= kind (sg-row-count 0))) (return 0))
  (return (sg-row-at 0 kind 2)))

(defn ^:pub ^I32 sg-name-len [^I32 kind]
  (if (or (< kind 0) (>= kind (sg-row-count 0))) (return 0))
  (return (sg-row-at 0 kind 4)))

(defn ^:pub ^I32 sg-name-ch [^I32 kind ^I32 i]
  (if (or (< kind 0) (>= kind (sg-row-count 0))) (return -1))
  (if (or (< i 0) (>= i (sg-row-at 0 kind 4))) (return -1))
  (return (sg-char-at 0 (+ (sg-row-at 0 kind 3) i))))
