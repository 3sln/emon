;; Laws for `emon.sealfield` (P8.2; SPEC 10.7; D016, D800, D801), on every target. The text is UTF-8 in a literal and decoded here to the code points the stage reads.
;;
;;   * characters: a decimal digit of any script has its value, a letter its script;
;;   * a DATE is digits, a separator and digits (any order the numbers settle, or the locale hint says, else the text as it stands), the CJK marks, or a day, a word
;;     of letters and a year (as it stands); written out `YYYY-MM-DD` when no reading disputes it; the first in the text; none in a text with no digits;
;;   * a NAME is the first phrase between a ring's separators that has letters and no digit and is long enough for its script (a seal: one word of four letters or two
;;     Han letters; a stamp: two words of five letters); the date and the digits of a registration number are no name; a signature has neither;
;;   * the locale hint orders a numeric date and nothing else.
(ns emon.sealfieldtest
  (:require [emon.lang :refer [I32 Blob Cells]]
            [emon.test :refer [deftest assert-eq assert-that text-blob new-cells]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-push cells-drop]]
            [emon.sealfield :refer [sf-prep sf-fields sf-order sf-digit sf-script]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 sft-put [^Blob b ^:mut ^Cells c]
  (comment "Decode the UTF-8 of the blob into code points (cleared first). Answers how many.")
  (let [^I32 n (blob-len b)
        ^:mut ^I32 k 0
        ^:mut ^I32 x 0]
    (cells-drop c 0)
    (while (< k n)
      (do (set x (blob-u8 b k))
          (if (< x 128)
            (do (cells-push c x) (set k (+ k 1)))
            (if (< x 224)
              (do (cells-push c (+ (* (rem x 32) 64) (rem (blob-u8 b (+ k 1)) 64))) (set k (+ k 2)))
              (if (< x 240)
                (do (cells-push c (+ (* (+ (* (rem x 16) 64) (rem (blob-u8 b (+ k 1)) 64)) 64) (rem (blob-u8 b (+ k 2)) 64))) (set k (+ k 3)))
                (do (cells-push c (+ (* (+ (* (+ (* (rem x 8) 64) (rem (blob-u8 b (+ k 1)) 64)) 64) (rem (blob-u8 b (+ k 2)) 64)) 64) (rem (blob-u8 b (+ k 3)) 64))) (set k (+ k 4))))))))
    (return (cells-len c))))

(deftest test-a-character-has-a-value-or-a-script
  (assert-eq (sf-digit 55) 7 "an ASCII 7")
  (assert-eq (sf-digit 1635) 3 "an Arabic-Indic 3")
  (assert-eq (sf-digit 1782) 6 "an Extended Arabic-Indic 6")
  (assert-eq (sf-digit 2407) 1 "a Devanagari 1")
  (assert-eq (sf-digit 65301) 5 "a fullwidth 5")
  (assert-eq (sf-digit 65) -1 "a letter is none")
  (assert-eq (sf-script 65) 1 "A is Latin")
  (assert-eq (sf-script 233) 1 "so is e acute")
  (assert-eq (sf-script 1040) 3 "Cyrillic A")
  (assert-eq (sf-script 945) 2 "Greek alpha")
  (assert-eq (sf-script 20013) 10 "a Han letter")
  (assert-eq (sf-script 12402) 8 "a Kana")
  (assert-eq (sf-script 54620) 9 "a Hangul syllable")
  (assert-eq (sf-script 1575) 5 "an Arabic letter")
  (assert-eq (sf-script 48) 0 "a digit is no letter")
  (assert-eq (sf-script 45) 0 "nor a dash")
  (assert-eq (sf-script 8226) 0 "nor a bullet")
  (assert-eq (sf-script 215) 0 "nor a multiplication sign"))

(defn ^I32 sft-run [^Blob b ^:mut ^Cells et ^:mut ^Cells out ^I32 kind ^I32 order]
  (comment "Decode the text and read its fields into `out`; answers the length of the text.")
  (let [^I32 n (sft-put b et)]
    (sf-fields et 0 n kind order out 0)
    (return n)))

(deftest test-a-date-of-digits-is-found-and-written-out
  (let [^Cells et (new-cells)
        ^Cells out (new-cells)]
    (sft-run (text-blob "PAID 2026-03-14") et out 2 0)
    (assert-eq (cells-at out 2) 1 "year first, one separator: a date nothing disputes")
    (assert-eq (cells-at out 3) 5 "it starts after PAID")
    (assert-eq (cells-at out 4) 10 "and is ten characters")
    (assert-eq (cells-at out 5) 2026 "the year")
    (assert-eq (cells-at out 6) 3 "the month")
    (assert-eq (cells-at out 7) 14 "the day")
    (sft-run (text-blob "Date: 2026/4/2.") et out 2 0)
    (assert-eq (cells-at out 6) 4 "a slash and one-digit parts")
    (assert-eq (cells-at out 7) 2 "the day, 2")
    (sft-run (text-blob "14.03.2026") et out 1 0)
    (assert-eq (cells-at out 2) 1 "a day over 12 first: the day, then the month")
    (assert-eq (cells-at out 6) 3 "month 3")
    (assert-eq (cells-at out 7) 14 "day 14")
    (sft-run (text-blob "03/14/2026") et out 1 0)
    (assert-eq (cells-at out 6) 3 "a second number over 12 is the day, whatever the order")
    (assert-eq (cells-at out 7) 14 "so the first is the month")
    (sft-run (text-blob "03/04/2026") et out 1 0)
    (assert-eq (cells-at out 2) 2 "both numbers at most 12 and with no hint: the text as it stands")
    (assert-eq (cells-at out 4) 10 "its ten characters")
    (sft-run (text-blob "03/04/2026") et out 1 2)
    (assert-eq (cells-at out 2) 1 "month first by the hint")
    (assert-eq (cells-at out 6) 3 "month 3")
    (assert-eq (cells-at out 7) 4 "day 4")
    (sft-run (text-blob "03/04/2026") et out 1 1)
    (assert-eq (cells-at out 6) 4 "day first by the hint: month 4")
    (assert-eq (cells-at out 7) 3 "day 3")
    (sft-run (text-blob "05/05/2026") et out 1 0)
    (assert-eq (cells-at out 2) 1 "the same number twice is the same either way")
    (sft-run (text-blob "SEALED 12.5.24") et out 1 0)
    (assert-eq (cells-at out 2) 2 "a two-digit year is a date's shape only: as it stands")
    (sft-run (text-blob "NO DIGITS HERE") et out 1 0)
    (assert-eq (cells-at out 2) 0 "a text with no digits has no date")
    (sft-run (text-blob "REG 20261 AND 99") et out 1 0)
    (assert-eq (cells-at out 2) 0 "numbers that are no date shape are none")
    (sft-run (text-blob "2026-13-40") et out 1 0)
    (assert-eq (cells-at out 2) 0 "a month of 13 is no date")))

(deftest test-a-date-of-other-scripts-and-words-is-found
  (let [^Cells et (new-cells)
        ^Cells out (new-cells)]
    (sft-run (text-blob "北京市 2026年3月14日 公章") et out 1 0)
    (assert-eq (cells-at out 2) 1 "the CJK year, month and day marks")
    (assert-eq (cells-at out 5) 2026 "the year")
    (assert-eq (cells-at out 6) 3 "the month")
    (assert-eq (cells-at out 7) 14 "the day")
    (assert-eq (cells-at out 3) 4 "it starts after the city and a space")
    (sft-run (text-blob "서울 2026년 03월 14일") et out 1 0)
    (assert-eq (cells-at out 2) 0 "Hangul marks with spaces between are not read (no guessing)")
    (sft-run (text-blob "٢٠٢٦-٠٣-١٤") et out 2 0)
    (assert-eq (cells-at out 2) 1 "Arabic-Indic digits are digits")
    (assert-eq (cells-at out 6) 3 "month 3")
    (assert-eq (cells-at out 7) 14 "day 14")
    (sft-run (text-blob "ISSUED 14 March 2026 BY") et out 1 0)
    (assert-eq (cells-at out 2) 2 "a day, a word and a year: as it stands")
    (assert-eq (cells-at out 3) 7 "from the day")
    (assert-eq (cells-at out 4) 13 "to the year's end")
    (sft-run (text-blob "ISSUED March 14, 2026 BY") et out 1 0)
    (assert-eq (cells-at out 2) 2 "a word, a day and a year too")
    (assert-eq (cells-at out 3) 7 "from the word")
    (assert-eq (cells-at out 4) 14 "to the year's end")
    (sft-run (text-blob "14-Mar-2026") et out 1 0)
    (assert-eq (cells-at out 2) 2 "hyphens between a day, a word and a year")
    (sft-run (text-blob "14 2026") et out 1 0)
    (assert-eq (cells-at out 2) 0 "a day and a year with no word between is no date")))

(deftest test-a-name-is-the-first-phrase-of-letters
  (let [^Cells et (new-cells)
        ^Cells out (new-cells)]
    (sft-run (text-blob "CITY OF RIVERTON -NOTARY PUBLIC- SEAL") et out 1 0)
    (assert-eq (cells-at out 0) 0 "the ring's first phrase starts the text")
    (assert-eq (cells-at out 1) 16 "and is sixteen characters, cut at the hyphen")
    (assert-eq (cells-at out 8) 1 "its letters are Latin")
    (sft-run (text-blob "HARBOR COUNTY CLERK · OFFICIAL SEAL") et out 1 0)
    (assert-eq (cells-at out 1) 19 "a bullet is a separator")
    (sft-run (text-blob "ACME GMBH • HRB 12345 • MUNICH") et out 1 0)
    (assert-eq (cells-at out 1) 9 "the first phrase, not the register number's")
    (sft-run (text-blob "12345 ★ ACME LIMITED") et out 1 0)
    (assert-eq (cells-at out 0) 8 "a phrase of digits is no name: the next is")
    (assert-eq (cells-at out 1) 12 "ACME LIMITED")
    (sft-run (text-blob "ООО РОМАШКА • ПЕЧАТЬ") et out 1 0)
    (assert-eq (cells-at out 1) 11 "Cyrillic: two words")
    (assert-eq (cells-at out 8) 3 "whose letters are Cyrillic")
    (sft-run (text-blob "北京某某有限公司★合同专用章") et out 1 0)
    (assert-eq (cells-at out 0) 0 "Han letters have no spaces: the phrase before the star")
    (assert-eq (cells-at out 1) 8 "eight letters")
    (assert-eq (cells-at out 8) 10 "of the Han script")
    (sft-run (text-blob "PAID 2026-03-14") et out 2 0)
    (assert-eq (cells-at out 1) 0 "a stamp of one word has no name")
    (assert-eq (cells-at out 2) 1 "it has a date")
    (sft-run (text-blob "APPROVED BY ACCOUNTING 2026-03-14") et out 2 0)
    (assert-eq (cells-at out 1) 22 "a stamp of three words does")
    (assert-eq (cells-at out 3) 23 "and the date is behind it")
    (sft-run (text-blob "SEAL") et out 1 0)
    (assert-eq (cells-at out 1) 4 "a seal of one word of four letters is named by it")
    (sft-run (text-blob "OK") et out 1 0)
    (assert-eq (cells-at out 1) 0 "two letters are none")
    (sft-run (text-blob "Jordan Rivera 2026-03-14") et out 3 0)
    (assert-eq (cells-at out 1) 0 "a signature has no name here")
    (assert-eq (cells-at out 2) 0 "and no date")
    (sft-run (text-blob "CO-OP SOCIETY") et out 1 0)
    (assert-eq (cells-at out 1) 13 "a hyphen inside a word is not a separator")))

(deftest test-the-locale-hint-orders-a-numeric-date
  (let [^Cells loc (new-cells)]
    (sft-put (text-blob "en-US") loc)
    (assert-eq (sf-order loc) 2 "US: month first")
    (sft-put (text-blob "en_US") loc)
    (assert-eq (sf-order loc) 2 "with an underscore too")
    (sft-put (text-blob "de-DE") loc)
    (assert-eq (sf-order loc) 1 "Germany: day first")
    (sft-put (text-blob "ja") loc)
    (assert-eq (sf-order loc) 1 "a language alone: day first")
    (sft-put (text-blob "") loc)
    (assert-eq (sf-order loc) 0 "no hint: none")
    (assert-that (>= (sf-prep loc 0) 0) "the answer's scratch is made")
    (assert-eq (cells-len loc) 32 "of 32 cells")
    (sf-prep loc 20)
    (assert-eq (cells-len loc) 52 "and from another cell, after it")))
