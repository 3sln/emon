;; ------------------------------------------------------------- the corners

(deftest test-centipoints-print-as-points
  (let [^Text t (new-text)]
    (js-cpt t 7250) (emit-ascii t " ")
    (js-cpt t 7200) (emit-ascii t " ")
    (js-cpt t -5) (emit-ascii t " ")
    (js-cpt t 0) (emit-ascii t " ")
    (js-cpt t 12) (emit-ascii t " ")
    (js-cpt t 10) (emit-ascii t " ")
    (js-cpt t 5) (emit-ascii t " ")
    (js-cpt t 99) (emit-ascii t " ")
    (js-cpt t 100) (emit-ascii t " ")
    (js-cpt t 101) (emit-ascii t " ")
    (js-cpt t 1234) (emit-ascii t " ")
    (js-cpt t -150) (emit-ascii t " ")
    (js-cpt t -100) (emit-ascii t " ")
    (js-cpt t -2147483648) (emit-ascii t " ")
    (js-cpt t 2147483647)
    (assert-text t "72.5 72 -0.05 0 0.12 0.1 0.05 0.99 1 1.01 12.34 -1.5 -1 -21474836.48 21474836.47" "points")))

(deftest test-strings-escape-what-SPEC-4-3-says
  (let [^Cells text (new-cells)
        ^Text t (new-text)]
    (text-append-cp text 34)
    (text-append-cp text 92)
    (text-append-cp text 10)
    (text-append-cp text 9)
    (text-append-cp text 13)
    (text-append-cp text 0)
    (text-append-cp text 31)
    (text-append-cp text 8232)
    (text-append-cp text 8233)
    (text-append-cp text 47)
    (text-append-cp text 32)
    (js-str t text 0 11)
    (assert-text t "\"\\\"\\\\\\n\\t\\u000d\\u0000\\u001f\\u2028\\u2029/ \"" "escapes")))

(deftest test-the-deepest-tree-serializes
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells st (new-cells)
        ^Text compact (new-text)
        ^Text pretty (new-text)
        ^:mut ^I32 at 0]
    (model-init nodes attrs regions text pages ledger layout)
    (while (!= at -1)
      (set at (node-new nodes (nk-section) at)))
    (assert-eq (model-check nodes attrs regions text pages ledger layout st) 0 "well formed")
    (assert-eq (js-emit compact 0 nodes attrs regions text pages ledger layout) 0 "compact")
    (assert-eq (js-emit pretty 1 nodes attrs regions text pages ledger layout) 0 "pretty")))
