;; Laws for `emon.json` (P1.2): golden files, byte for byte, on every target.
;; A golden is `test/json/NAME.model` (a line script, parsed by `emon.mscript`)
;; plus `NAME.json` / `NAME.pretty.json`, the exact bytes `js-emit` must write.
(ns emon.jsontest
  (:require [emon.lang :refer [I32 Blob Cells Text emit-ascii]]
            [emon.test :refer [deftest assert-eq assert-text assert-text-span
                               test-file new-cells new-text]]
            [emon.mscript :refer [jt-build jt-end]]
            [emon.port :refer [cells-len cells-at cells-set]]
            [emon.model :refer [model-init node-new text-append-cp
                                model-check max-depth nk-section]]
            [emon.json :refer [js-emit js-cpt js-str]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or]]))

;; ----------------------------------------------------------------- goldens

(deftest test-golden-minimal
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells st (new-cells)
        ^Text compact (new-text)
        ^Text pretty (new-text)]
    (assert-eq (jt-build (test-file "json/minimal.model") nodes attrs regions text pages ledger layout st) 0 "the script builds")
    (assert-eq (model-check nodes attrs regions text pages ledger layout st) 0 "the Model is well formed")
    (js-emit compact 0 nodes attrs regions text pages ledger layout)
    (js-emit pretty 1 nodes attrs regions text pages ledger layout)
    (assert-text-span compact (test-file "json/minimal.json") 0 (jt-end (test-file "json/minimal.json")) "compact" 0)
    (assert-text-span pretty (test-file "json/minimal.pretty.json") 0 (jt-end (test-file "json/minimal.pretty.json")) "pretty" 0)))

