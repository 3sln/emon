;; Laws for `emon.scriptcheck` (D564, P12.3 I-13): a page whose script OSD is sure of and that no model the engine read it with reads is UNREAD; one read by a model that
;; reads the script, a Latin page, a page OSD is unsure of, and a page of too few words are not.
(ns emon.scriptchecktest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq assert-that new-cells test-t TestT]]
            [emon.port :refer [cells-at cells-drop cells-push cells-set]]
            [emon.plan :refer [an-ocr an-ocr-word an-ocr-cp an-ocr-end rq-arg rec-count an-find]]
            [emon.ocr :refer [ox-begin ox-line ox-block ox-word]]
            [emon.scriptcheck :refer [sk-route sk-unread sk-unpack sk-min-conf sk-weak-conf sk-tag-conflicts]]
            [emon.evidence :refer [or-new or-set ow-new orf-pass orf-script orf-sconf orf-wfirst orf-wcount op-first op-line]]
            [emon.model :refer [model-init node-new nk-paragraph node-add-region node-set-text node-set-conf node-conf node-flags node-text-start node-text-len node-parent fl-script-unread node-add-src sr-text nk-text]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot bit-and]]))

(defn ^I32 sk-answer [^:mut ^Cells ans ^I32 id ^I32 n ^I32 script ^I32 sconf ^I32 lang ^I32 lang0 ^I32 dflags]
  (comment "An OCR answer of `n` words, one a line, each read in the language cell `lang` (the first in `lang0`), whose page OSD says is in `script` at the confidence `sconf`;")
  (comment "`dflags` 1 says the engine's dictionary knows the words, 0 not.")
  (let [^I32 at (an-ocr ans id)
        ^:mut ^I32 k 0
        ^:mut ^I32 word 0]
    (while (< k n)
      (do (set word (an-ocr-word ans at 10 (+ 20 (* k 60)) 60 40 760 k 0))
          (an-ocr-cp ans word 72)
          (an-ocr-cp ans word 105)
          (set k (+ k 1))))
    (ox-begin ans 0 0 0 0 0 script sconf 500 n 1 0 0 0)
    (set k 0)
    (while (< k n)
      (do (ox-line ans 10 (+ 20 (* k 60)) 60 40 10 (+ 55 (* k 60)) 70 (+ 55 (* k 60)) 0 0 0 20 14 6)
          (set k (+ k 1))))
    (ox-block ans 10 20 60 (* n 60) 0 0 0)
    (set k 0)
    (while (< k n)
      (do (if (== k 0) (ox-word ans 0 lang0 -1 dflags) (ox-word ans 0 lang -1 dflags))
          (set k (+ k 1))))
    (an-ocr-end ans at)
    (return at)))

(defn ^I32 unread-of-d [^I32 n ^I32 script ^I32 sconf ^I32 lang ^I32 lang0 ^I32 dflags]
  (let [^Cells ans (new-cells)
        ^I32 at (sk-answer ans 272 n script sconf lang lang0 dflags)]
    (return (sk-unread ans at (new-cells)))))

(defn ^I32 unread-of [^I32 n ^I32 script ^I32 sconf ^I32 lang ^I32 lang0]
  (return (unread-of-d n script sconf lang lang0 0)))

(deftest test-a-language-cell-unpacks-to-its-letters
  (let [^Cells out (new-cells)]
    (assert-eq (sk-unpack 1701734144 out) 3 "`eng` is three letters")
    (assert-eq (cells-at out 0) 101 "e")
    (assert-eq (cells-at out 2) 103 "g")
    (assert-eq (sk-unpack 0 out) 0 "none")))

(deftest test-a-script-no-model-read-is-unread
  (comment "Deva 1147500129, Latn 1281455214, Cyrl 1132032620; the languages `eng` 1701734144, `hin` 1751739904, `rus` 1920299776")
  (assert-eq (unread-of 5 1147500129 629 1701734144 1701734144) 1 "a Devanagari page (OSD 62.9) read by `eng`: unread (the smoke review's Hindi scan)")
  (assert-eq (unread-of 5 1132032620 400 1701734144 1701734144) 1 "a Cyrillic page read by `eng`: unread")
  (assert-eq (unread-of 5 1147500129 629 1751739904 1751739904) 0 "the same read by `hin`, which reads Devanagari: read")
  (assert-eq (unread-of 5 1147500129 629 1701734144 1751739904) 0 "one word read by `hin` is a model that reads it: read")
  (assert-eq (unread-of 5 1132032620 400 1920299776 1920299776) 0 "a Cyrillic page read by `rus`: read")
  (assert-eq (unread-of 5 1147500129 629 1920299776 1920299776) 1 "a Devanagari page read by `rus` (which reads Cyrillic): unread"))

(deftest test-a-page-the-engine-can-read-or-osd-is-unsure-of-is-not-flagged
  (assert-eq (unread-of 5 1281455214 629 1701734144 1701734144) 0 "a Latin page")
  (assert-eq (unread-of-d 5 1147500129 100 1701734144 1701734144 1) 0 "OSD unsure (confidence 10: a Latin page reads that) and the engine's dictionary knows the words: Latin")
  (assert-eq (unread-of-d 5 1147500129 (- (sk-min-conf) 1) 1701734144 1701734144 1) 0 "just under the bound, the words known")
  (assert-eq (unread-of-d 5 1147500129 (sk-min-conf) 1701734144 1701734144 1) 1 "at it: believed whatever the dictionary says (the page of the smoke review)")
  (assert-eq (unread-of 5 1147500129 (sk-weak-conf) 1701734144 1701734144) 1 "R2: OSD at 5.0 and none of the words known (Urdu, Han, Ethiopic in a Latin model): unread")
  (assert-eq (unread-of 5 1147500129 (- (sk-weak-conf) 1) 1701734144 1701734144) 0 "under 5.0: OSD says nothing")
  (assert-eq (unread-of 2 1147500129 629 1701734144 1701734144) 0 "two words: the engine read nothing of it to speak of")
  (assert-eq (unread-of 5 0 629 1701734144 1701734144) 0 "no script"))

(deftest test-an-answer-with-no-extension-is-not-flagged
  (let [^Cells ans (new-cells)
        ^I32 at (an-ocr ans 272)
        ^I32 w (an-ocr-word ans at 10 20 60 40 760 0 0)]
    (an-ocr-cp ans w 72)
    (an-ocr-end ans at)
    (assert-eq (sk-unread ans at (new-cells)) 0 "an engine that says nothing of the script")))

(deftest test-osd-routes-an-unread-page-through-its-script-and-english
  (let [^Cells ans (new-cells) ^Cells rq (new-cells)]
    (sk-answer ans 10 5 1147500129 629 1701734144 1701734144 0)
    (assert-eq (sk-route ans 0 28 260 300 rq (new-cells)) -1 "an unread Devanagari page asks for its script")
    (assert-eq (rec-count rq) 1 "one extra pass")
    (assert-eq (rq-arg rq 0 7) 1147500129 "Deva reads with installed script models")
    (assert-eq (rq-arg rq 0 8) 1701734144 "plus English")
    (cells-drop rq 0)
    (sk-answer ans 28 5 1147500129 629 1751739904 1751739904 1)
    (assert-eq (sk-route ans 0 28 260 300 rq (new-cells)) (an-find ans 28) "the answer is adopted")
    (assert-eq (rec-count rq) 0 "a completed pass is not asked again")))

(deftest test-chinese-word-language-aliases-count-as-installed-han-models
  (assert-eq (unread-of 5 1214344809 629 1667789568 1667789568) 0 "chi_sim words are recorded as chs and read Han")
  (assert-eq (unread-of 5 1214344809 629 1667789824 1667789824) 0 "chi_tra words are recorded as cht and read Han"))

;; D753: confidence is a claim about this page's text, including an unhealthy legacy layer.
(deftest test-script-conflict-flags-are-owned-by-the-affected-page-with-values-kept
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells runs (new-cells) ^Cells words (new-cells) ^Cells et (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (let [^I32 bad (node-new nodes (nk-paragraph) 0)
          ^I32 clean (node-new nodes (nk-paragraph) 0)
          ^:mut ^I32 pg 1 ^:mut ^I32 i 0 ^:mut ^I32 r 0]
      (cells-push text 65)
      (cells-push text 55)
      (node-set-text nodes bad 0 2)
      (node-set-text nodes clean 0 2)
      (node-set-conf nodes bad 900)
      (node-set-conf nodes clean 900)
      (node-add-region nodes regions bad 1 0 0 100 100)
      (node-add-region nodes regions clean 4 0 0 100 100)
      (while (< i 60) (do (cells-push et 65) (set i (+ i 1))))
      (while (<= pg 3)
        (do (set r (or-new runs pg 0))
            (or-set runs r (orf-pass) (op-first))
            (or-set runs r (orf-script) 1098015074)
            (or-set runs r (orf-sconf) 32)
            (or-set runs r (orf-wfirst) (- pg 1))
            (or-set runs r (orf-wcount) 1)
            (ow-new words pg 0 0 100 100 0 0 100 100 0 0 0 60 0 900 0)
            (set pg (+ pg 1))))
      (assert-eq (sk-tag-conflicts nodes regions runs words et) 1 "only represented text on the corroborated pages is held")
      (assert-eq (node-conf nodes bad) 100 "suspect text has the unread cap")
      (assert-eq (bit-and (node-flags nodes bad) (fl-script-unread)) (fl-script-unread) "explicit unread flag")
      (assert-eq (node-conf nodes clean) 900 "adjacent clean page stays high")
      (assert-eq (node-flags nodes clean) 0 "no flag crosses the page boundary")
      (assert-eq (node-parent nodes bad) 0 "owner retained")
      (assert-eq (node-text-start nodes bad) 0 "text span retained")
      (assert-eq (node-text-len nodes bad) 2 "Latin name and number retained")
      (assert-eq (cells-at text 0) 65 "A retained")
      (assert-eq (cells-at text 1) 55 "7 retained"))))

(defn ^I32 sk-mixed-trial [^TestT emon-t ^I32 khmer ^I32 ethiopic ^I32 pass]
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells runs (new-cells) ^Cells words (new-cells) ^Cells et (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (let [^I32 n (node-new nodes (nk-paragraph) 0)
          ^I32 child (node-new nodes (nk-text) n)
          ^I32 r (or-new runs 1 0) ^:mut ^I32 i 0]
      (cells-push text 55)
      (node-set-text nodes child 0 1)
      (node-add-src nodes n (sr-text))
      (node-add-src nodes child (sr-text))
      (node-set-conf nodes n 900)
      (node-set-conf nodes child 900)
      (node-add-region nodes regions n 9 0 0 100 100)
      (node-add-region nodes regions n 1 0 0 100 100)
      (while (< i khmer) (do (cells-push et 6016) (set i (+ i 1))))
      (set i 0)
      (while (< i ethiopic) (do (cells-push et 4608) (set i (+ i 1))))
      (or-set runs r (orf-pass) pass)
      (or-set runs r (orf-wfirst) 0)
      (or-set runs r (orf-wcount) 1)
      (ow-new words 1 0 0 100 100 0 0 100 100 0 0 0 (+ khmer ethiopic) 0 900 0)
      (sk-tag-conflicts nodes regions runs words et)
      (assert-eq (node-parent nodes n) 0 "owner is unchanged by diagnostic")
      (assert-eq (node-parent nodes child) n "inline value keeps its paragraph owner")
      (assert-eq (node-conf nodes child) (node-conf nodes n) "the inline value and its block share the confidence bound")
      (assert-eq (node-text-len nodes child) 1 "number remains represented")
      (assert-eq (cells-at text 0) 55 "exact value 7 survives")
      (return (node-conf nodes n)))))

(deftest test-khmer-ethiopic-contamination-is-explicit-without-deleting-legacy-values
  (assert-eq (sk-mixed-trial (test-t) 100 2 (op-first)) 100 "mixed primary reading is flagged"))

(deftest test-clean-scripts-and-rejected-alternatives-cannot-accuse-the-body
  (assert-eq (sk-mixed-trial (test-t) 100 0 (op-first)) 900 "clean Khmer stays high")
  (assert-eq (sk-mixed-trial (test-t) 0 100 (op-first)) 900 "clean Ethiopic stays high")
  (assert-eq (sk-mixed-trial (test-t) 99 2 (op-first)) 900 "too little script evidence")
  (assert-eq (sk-mixed-trial (test-t) 100 2 (op-line)) 900 "a rejected crop is no page-level claim"))

(defn ^I32 sk-arabic-trial [^TestT emon-t ^I32 np ^I32 hasarabic ^I32 samepage]
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells runs (new-cells) ^Cells words (new-cells) ^Cells et (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (let [^I32 n (node-new nodes (nk-paragraph) 0) ^:mut ^I32 i 0 ^:mut ^I32 r 0 ^:mut ^I32 pg 0]
      (cells-push text 65)
      (node-set-text nodes n 0 1)
      (node-set-conf nodes n 900)
      (node-add-region nodes regions n 1 0 0 100 100)
      (while (< i 60) (do (cells-push et 65) (set i (+ i 1))))
      (if (== hasarabic 1) (cells-set et 0 1575))
      (set i 0)
      (while (< i np)
        (do (set pg (+ i 1))
            (if (== samepage 1) (set pg 1))
            (set r (or-new runs pg 0))
            (or-set runs r (orf-pass) (op-first))
            (or-set runs r (orf-script) 1098015074)
            (or-set runs r (orf-sconf) 32)
            (or-set runs r (orf-wfirst) i)
            (or-set runs r (orf-wcount) 1)
            (ow-new words pg 0 0 100 100 0 0 100 100 0 0 0 60 0 900 0)
            (set i (+ i 1))))
      (sk-tag-conflicts nodes regions runs words et)
      (assert-eq (node-text-len nodes n) 1 "Latin name remains owned")
      (assert-eq (cells-at text 0) 65 "Latin name remains exact")
      (return (node-conf nodes n)))))

(deftest test-weak-osd-needs-distinct-pages-and-cannot-condemn-a-native-reading
  (assert-eq (sk-arabic-trial (test-t) 2 0 0) 900 "two weak pages do not establish the script")
  (assert-eq (sk-arabic-trial (test-t) 3 0 1) 900 "three reads of one page are not corroboration")
  (assert-eq (sk-arabic-trial (test-t) 3 1 0) 900 "native Arabic with Latin names remains high")
  (assert-eq (sk-arabic-trial (test-t) 3 0 0) 100 "three conflicting page readings are explicitly unread"))
