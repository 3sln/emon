;; Laws for `emon.retarget` (P7.4; SPEC 8.3, 7.3; D196): what the first pass calls for, the body-ink view, the request that names a kin-made view and its hash,
;; and which run's line the pipeline reads.
(ns emon.retargettest
  (:require [emon.lang :refer [I32 Bitmap Cells BitmapSet]]
            [emon.test :refer [deftest assert-eq assert-that new-cells new-bitmap-set]]
            [emon.port :refer [bitmap-new bitmap-w bitmap-h bitmap-u8 bitmap-set-u8 bitmap-hash bms-put bms-get cells-len cells-at cells-set cells-push]]
            [emon.plan :refer [rec-id rec-kind rq-arg rq-nargs pk-ocr view-base pu-view-id rec-count]]
            [emon.evidence :refer [vw-new vk-render
                                   or-new or-set or-get orf-lfirst orf-lcount orf-wfirst orf-wcount orf-osd orf-oconf
                                   ol-new ol-set ol-get ow-new ow-count ol-count olf-px olf-py olf-pw olf-ph lh-first lh-count
                                   fe-new fe-set ea-owords xo-body-share]]
            [emon.norm :refer [nm-view nm-paper-gray]]
            [emon.scan :refer [sc-prep sc-sel-base sc-aux-base sc-share-base sc-partner-base]]
            [emon.retarget :refer [rt-prep rt-decide rt-turns rt-erase-into rt-ask-view rt-adopt rt-line-state
                                   rtp-q rtp-body rtp-erased rtp-nl rtp-nc rtp-cell0 rtp-line0 rtp-brun rtp-primary rtp-hash rt-lines rt-line-conf rt-max]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^I32 rtt-rect [^Bitmap b ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 r ^I32 g ^I32 bl]
  (let [^:mut ^I32 y y0
        ^:mut ^I32 x 0]
    (while (< y y1)
      (do (set x x0)
          (while (< x x1)
            (do (bitmap-set-u8 b x y 0 r)
                (bitmap-set-u8 b x y 1 g)
                (bitmap-set-u8 b x y 2 bl)
                (set x (+ x 1))))
          (set y (+ y 1))))
    (return 0)))

(defn ^I32 rtt-word [^:mut ^Cells owords ^:mut ^Cells feats ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 conf ^I32 line]
  (comment "One OCR word on page 1 with a feature row.")
  (let [^I32 f (fe-new feats (ea-owords) (ow-count owords))
        ^I32 w (ow-new owords 1 x0 y0 x1 y1 x0 y1 x1 y1 0 0 0 4 line conf f)]
    (return w)))

(defn ^I32 rtt-line [^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells feats ^I32 y0 ^I32 conf]
  (comment "A line of two words at height y0 (100 centipoints tall); answers its row.")
  (let [^I32 first (ow-count owords)
        ^I32 l (ol-count olines)]
    (rtt-word owords feats 100 y0 600 (+ y0 100) conf l)
    (rtt-word owords feats 700 y0 1200 (+ y0 100) conf l)
    (ol-new olines 1 100 y0 1200 (+ y0 100) 100 (+ y0 100) 1200 (+ y0 100) 0 0 first 2)
    (ol-set olines l (olf-px) 100)
    (ol-set olines l (olf-py) y0)
    (ol-set olines l (olf-pw) 1100)
    (ol-set olines l (olf-ph) 100)
    (return l)))

(defn ^I32 rtt-run [^:mut ^Cells oruns ^Cells olines ^Cells owords ^I32 l0 ^I32 w0]
  (comment "A run over the lines [l0, now) and the words [w0, now).")
  (let [^I32 r (or-new oruns 1 0)]
    (or-set oruns r (orf-lfirst) l0)
    (or-set oruns r (orf-lcount) (- (ol-count olines) l0))
    (or-set oruns r (orf-wfirst) w0)
    (or-set oruns r (orf-wcount) (- (ow-count owords) w0))
    (or-set oruns r (orf-osd) -1)
    (or-set oruns r (orf-oconf) -1)
    (return r)))

(deftest test-the-erased-view-keeps-the-body-ink-and-its-edge-and-paints-foreign-ink-the-paper
  (let [^Bitmap src (bitmap-new 100 80 3)
        ^Bitmap gray (bitmap-new 100 80 1)
        ^Bitmap bin (bitmap-new 100 80 1)
        ^Bitmap mask (bitmap-new 100 80 1)
        ^Bitmap bodym (bitmap-new 100 80 1)
        ^Bitmap emap (bitmap-new 100 80 1)
        ^Bitmap out (bitmap-new 100 80 1)
        ^Cells views (new-cells)
        ^Cells inks (new-cells)
        ^Cells ws (new-cells)
        ^Cells sv (new-cells)
        ^Cells aux (new-cells)]
    (rtt-rect src 0 0 100 80 255 255 255)
    (rtt-rect src 5 5 45 35 0 0 0)
    (rtt-rect src 55 5 95 35 192 32 31)
    (rtt-rect src 5 45 45 75 205 205 205)
    (comment "a red pixel against the black block's edge: the block's own, as the edge of a glyph is")
    (rtt-rect src 45 20 46 21 192 32 31)
    (vw-new views 1 (vk-render) 2 -1 100 80 15000 0 -1 0 0 0 0 0)
    (nm-view views inks 1 0 src gray bin ws sv aux)
    (rt-erase-into src gray ws mask bodym 130 emap out)
    (assert-eq (bitmap-u8 out 20 20 0) 0 "the body's black stays black")
    (assert-eq (bitmap-u8 out 70 20 0) (nm-paper-gray ws) "a red seal is the paper's")
    (assert-eq (bitmap-u8 emap 70 20 0) 255 "and the map says it was painted over")
    (assert-eq (bitmap-u8 out 20 60 0) (nm-paper-gray ws) "a light grey watermark is the paper's")
    (assert-eq (bitmap-u8 out 50 40 0) (bitmap-u8 gray 50 40 0) "and the paper stays as it was")
    (assert-eq (bitmap-u8 emap 50 40 0) 0 "and is not on the map")
    (assert-eq (bitmap-u8 out 45 20 0) (bitmap-u8 gray 45 20 0) "foreign ink against the body's ink is kept: it is the body's edge")
    (assert-eq (bitmap-u8 emap 45 20 0) 0 "and not on the map either")))

(deftest test-a-view-is-asked-by-its-hash-and-another-pixel-is-another-request
  (let [^BitmapSet bms (new-bitmap-set)
        ^Cells rq (new-cells)
        ^Cells rtp (new-cells)
        ^Cells rq2 (new-cells)
        ^Bitmap v (bms-put bms (pu-view-id 0 32) 20 10 1)]
    (rt-prep rtp)
    (bitmap-set-u8 v 3 4 0 200)
    (rt-ask-view rq 300 (pu-view-id 0 32) v 130 (new-cells) rtp)
    (assert-eq (rec-count rq) 1 "one request")
    (assert-eq (rec-kind rq 0) (pk-ocr) "an ocr")
    (assert-eq (rq-arg rq 0 0) (pu-view-id 0 32) "of the kin-made view, by its id from view-base")
    (assert-that (>= (rq-arg rq 0 0) (view-base)) "an id the hosts know for a view")
    (assert-eq (rq-arg rq 0 1) 3 "psm 3")
    (assert-eq (rq-nargs rq 0) 9 "the pixel box, then the two cells of the hash")
    (assert-eq (rq-arg rq 0 7) (cells-at rtp (rtp-hash)) "the hash's high half is the bulk form's")
    (assert-eq (rq-arg rq 0 8) (cells-at rtp (+ (rtp-hash) 1)) "and its low half")
    (bitmap-set-u8 v 3 4 0 201)
    (rt-ask-view rq2 300 (pu-view-id 0 32) v 130 (new-cells) rtp)
    (assert-that (!= (rq-arg rq2 0 8) (rq-arg rq 0 8)) "a view that came out with one other pixel is another request")))

(deftest test-the-first-pass-calls-for-the-lines-it-was-unsure-of-and-for-the-body-ink-pass-over-foreign-ink
  (let [^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells feats (new-cells)
        ^Cells rtp (new-cells)]
    (rtt-line olines owords feats 0 900)
    (rtt-line olines owords feats 200 400)
    (rtt-line olines owords feats 400 950)
    (rtt-line olines owords feats 600 450)
    (let [^I32 run (rtt-run oruns olines owords 0 0)]
      (rt-prep rtp)
      (assert-eq (rt-turns 0 oruns run (new-cells) 1) 0 "a page with no OSD is upright")
      (or-set oruns run (orf-osd) 90)
      (or-set oruns run (orf-oconf) 150)
      (assert-eq (rt-turns 0 oruns run (new-cells) 1) 3 "a page OSD is sure is turned 90 degrees (its text runs bottom to top) is made upright by three quarter turns clockwise")
      (or-set oruns run (orf-osd) 180)
      (assert-eq (rt-turns 0 oruns run (new-cells) 1) 2 "and one that is upside down by two")
      (or-set oruns run (orf-osd) 90)
      (or-set oruns run (orf-oconf) 15)
      (assert-eq (rt-turns 0 oruns run (new-cells) 1) 0 "and one it is not sure of, with no text line of the tracer's to say so, is not")
      (assert-eq (rt-turns 1 oruns run (new-cells) 1) 0 "and a render is upright, whatever")
      (assert-eq (rt-decide 0 0 2 oruns run olines owords (new-cells) 1 130 rtp) 2 "two lines under the confidence floor (500): the second (400) and the fourth (450)")
      (assert-eq (cells-at rtp (rtp-body)) 1 "the body-ink pass is wanted: two lines have foreign ink under them")
      (assert-eq (cells-at rtp (rtp-q)) 0 "the page is upright")
      (assert-eq (cells-at rtp (rtp-line0)) 1 "the least sure line first, row 1")
      (assert-eq (cells-at rtp (+ (rtp-line0) 2)) 3 "then row 3")
      (rt-prep rtp)
      (assert-eq (rt-decide 0 0 0 oruns run olines owords (new-cells) 1 130 rtp) 2 "the same lines")
      (assert-eq (cells-at rtp (rtp-body)) 0 "and no body-ink pass: no foreign ink under any line")
      (rt-prep rtp)
      (cells-set rtp (rtp-erased) 50)
      (rt-decide 0 0 0 oruns run olines owords (new-cells) 1 130 rtp)
      (assert-eq (cells-at rtp (rtp-body)) 1 "but one when the view paints over 5 per cent of the page's ink: the text the first pass did not read may lie under it")
      (rt-prep rtp)
      (assert-eq (rt-decide 1 0 2 oruns run olines owords (new-cells) 1 130 rtp) 0 "a born-digital page re-reads no line: its text layer reads it")
      (assert-eq (cells-at rtp (rtp-body)) 1 "but it has its body-ink pass: a witness for arbitration")
      (rt-prep rtp)
      (rt-decide 0 3 2 oruns run olines owords (new-cells) 1 130 rtp)
      (assert-eq (cells-at rtp (rtp-q)) 3 "the turn is the plan's")
      (assert-eq (cells-at rtp (rtp-body)) 0 "and a page that is to be turned has no body-ink pass of the raster as it is"))))

(deftest test-the-body-ink-run-replaces-a-line-over-foreign-ink-and-a-ghost-is-dropped
  (let [^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells feats (new-cells)
        ^Cells rtp (new-cells)
        ^Cells scr (new-cells)]
    (sc-prep scr)
    (rtt-line olines owords feats 0 900)
    (rtt-line olines owords feats 200 600)
    (rtt-line olines owords feats 400 950)
    (rtt-line olines owords feats 800 400)
    (let [^I32 fr (rtt-run oruns olines owords 0 0)
          ^I32 l1 (ol-count olines)
          ^I32 w1 (ow-count owords)]
      (comment "the body-ink run read the second line again and a line that the first pass did not see")
      (rtt-line olines owords feats 200 900)
      (rtt-line olines owords feats 1000 800)
      (let [^I32 br (rtt-run oruns olines owords l1 w1)]
        (rt-prep rtp)
        (cells-set rtp (rtp-brun) br)
        (comment "what the body-ink view paints over, of each first-pass line's ink (per mille)")
        (cells-set scr (sc-share-base) 0)
        (cells-set scr (+ (sc-share-base) 1) 700)
        (cells-set scr (+ (sc-share-base) 2) 50)
        (cells-set scr (+ (sc-share-base) 3) 800)
        (assert-eq (rt-line-state oruns olines owords rtp scr 0 0 br 0 4) 0 "a line with no foreign ink under it stays")
        (assert-eq (rt-line-state oruns olines owords rtp scr 1 1 br 0 4) 1 "a line over foreign ink is replaced by the body-ink run's line over it")
        (assert-eq (cells-at scr (+ (sc-partner-base) 1)) 4 "that line")
        (assert-eq (rt-line-state oruns olines owords rtp scr 2 2 br 0 4) 0 "a line with a little foreign ink under it stays")
        (assert-eq (rt-line-state oruns olines owords rtp scr 3 3 br 0 4) 2 "a line mostly foreign ink that the body-ink run did not read is a ghost")
        (assert-eq (rt-adopt rtp oruns fr olines owords scr) 4 "four lines: the first, the second's reading, the third, and the line the first pass did not read; the ghost is dropped")
        (assert-eq (cells-at scr (sc-sel-base)) 0 "the first pass's first line")
        (assert-eq (cells-at scr (+ (sc-sel-base) 1)) 4 "then the body-ink run's line where the second was")
        (assert-eq (cells-at scr (+ (sc-sel-base) 2)) 2 "then the third, in the first pass's order")
        (assert-eq (cells-at scr (+ (sc-sel-base) 3)) 5 "and the body-ink run's line over nothing, below them where it lies")
        (assert-eq (cells-at rtp (rtp-primary)) fr "the first pass is the page's reading")))))

(deftest test-a-line-is-read-again-by-its-cells-only-when-no-text-is-lost-and-they-are-surer
  (let [^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells feats (new-cells)
        ^Cells rtp (new-cells)
        ^Cells scr (new-cells)]
    (sc-prep scr)
    (rtt-line olines owords feats 0 600)
    (let [^I32 l1 (ol-count olines)
          ^I32 w1 (ow-count owords)
          ^I32 empty (rtt-run oruns olines owords l1 w1)]
      (rt-prep rtp)
      (cells-set scr (sc-share-base) 0)
      (cells-set rtp (rtp-nc) 2)
      (comment "two cells of line 0: the first read as nothing, the second as a line of two words, surer")
      (cells-set rtp (+ (rtp-cell0) 4) 0)
      (cells-set rtp (+ (rtp-cell0) 5) empty)
      (rtt-line olines owords feats 0 900)
      (let [^I32 second (rtt-run oruns olines owords l1 w1)]
        (cells-set rtp (+ (rtp-cell0) 10) 0)
        (cells-set rtp (+ (rtp-cell0) 11) second)
        (assert-eq (rt-line-state oruns olines owords rtp scr 0 0 -1 0 1) 4 "the cells read what the line did, and surer: the line is replaced by them")
        (cells-set rtp (+ (rtp-cell0) 5) -1)
        (assert-eq (rt-line-state oruns olines owords rtp scr 0 0 -1 0 1) 0 "a cell that was not read keeps the line")))))
