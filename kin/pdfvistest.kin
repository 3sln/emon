;; Laws for visibility classification, graphics state and optional content (P3.5, P3.6; D152-D157), on every target.
;;
;; THE CORPUS is test/vis/, written by `kin/scripts/vis-fixtures` (babashka), which says BY HAND what every glyph
;; of every fixture must come out as, from what the operators mean, and computes the colours of the colour-space
;; fixture with a second, independent evaluator in double precision (`kin/scripts/vis-check` holds the same rows
;; to the generated Rust and, with --render, to what the poppler renderer draws). Here every target is held to the
;; rows (test/vis/rows.txt):
;;
;;   F path                       run the file (path relative to test/)
;;   G vis vby src ncp text       the next ncp glyphs: `vis`, `vby`, and their words' source (1 text, 2 hidden-text)
;;   C rgb cls vis ncp text       the next ncp glyphs: filled with this colour (within two levels a channel; -1 unknown),
;;                                of this colour-space class (0 none), with this `vis`
;;   O ocgdef ncp                 the ncp glyphs just given are in an optional-content span whose default state is this
;;   I vis vby                    the next image placement
;;   N glyphs images              how many of each the file made
;;   P vis vby backdrop chk tr n  the next painted path (a clip and a shading are not painted paths): `vis`, `vby`, the
;;                                backdrop the white check found (rrggbb or -1), the `vchk` bits that must be set, whether
;;                                `truncated` (0 or 1), the points of geometry kept (-1 not asked) (P3.6a, D219)
;;
;; AND LAWS ABOUT HOW: a word is one thing to see (no word mixes visibilities), every classification's `vchk` says which
;; checks ran, the evidence is well formed (`ev-check`), and the paths the interpreter makes read back (a rectangle is a
;; rectangle, a clip's box is the intersection of the clips on its chain).
(ns emon.pdfvistest
  (:require [emon.lang :refer [I32 Blob Src Cells Text]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that assert-that-at new-cells
                               test-file test-file-span test-t Str TestT]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-drop cells-set src-of-blob]]
            [emon.pdfvis :refer [pv-hit pv-covers pv-path-k pv-full-k pv-img-k pv-opaque-rect pv-opaque-img
                                  pv-index pv-backdrop pv-occluder]]
            [emon.pdfdoc :refer [pd-open]]
            [emon.pdfcontent :refer [pc-document]]
            [emon.evidence :refer [pa-new pa-set mk-new mk-set mkf-kind mkf-parent mk-optional-content
                                   pf-z pf-mark pf-falpha pf-width pg-stroked pg-blend
                                   gl-count gl-get wd-count wd-get mk-get pa-count pa-get im-count im-get
                                   ch-word ch-x0 ch-y0 ch-x1 ch-y1
                                   gf-vis gf-vby gf-vchk gf-fill gf-cs gf-mark gf-clip gf-mode
                                   wf-src wf-gfirst wf-gcount mkf-ocgdef mk-ocg-of
                                   pf-kind pf-flags pf-x0 pf-y0 pf-x1 pf-y1 pf-fill pf-pcount pf-clip pf-vis pf-vby pf-vchk pf-backdrop
                                   mf-vis mf-vby mf-vchk mf-page mf-z
                                   pa-rect pg-clip pg-filled pg-shading pg-truncated
                                   vc-clip vc-offpage vc-white vc-zero-size vc-occlusion vc-ocg vc-transparent
                                   ev-check]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem bit-and]]))

;; ------------------------------------------------------------ row helpers

(defn ^I32 vt-nl [^Blob b ^I32 i]
  (let [^:mut ^I32 k i]
    (while (and (< k (blob-len b)) (!= (blob-u8 b k) 10))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 vt-tab [^Blob b ^I32 i ^I32 lim]
  (comment "Index of the next tab in [i, lim), or lim.")
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 9))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 vt-dec [^Blob b ^I32 from ^I32 to]
  (comment "A decimal, possibly negative.")
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0
        ^:mut ^I32 neg 0]
    (if (and (< k to) (== (blob-u8 b k) 45))
      (do (set neg 1) (set k (+ k 1))))
    (while (< k to)
      (do (set v (+ (* v 10) (- (blob-u8 b k) 48)))
          (set k (+ k 1))))
    (if (== neg 1) (return (- 0 v)))
    (return v)))

(defn ^I32 vt-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (if (and (>= c 65) (<= c 70)) (return (- c 55)))
  (return -1))

(defn ^I32 vt-rgb [^Blob b ^I32 from ^I32 to]
  (comment "rrggbb as a number, or -1 for the field `-1`.")
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0]
    (if (== (- to from) 2) (return -1))
    (while (< k to)
      (do (set v (+ (* v 16) (vt-hexval (blob-u8 b k))))
          (set k (+ k 1))))
    (return v)))

(defn ^I32 vt-chan [^I32 v ^I32 i]
  (comment "Channel i (0 blue, 1 green, 2 red) of a 0xRRGGBB colour.")
  (let [^:mut ^I32 w v
        ^:mut ^I32 k 0]
    (while (< k i)
      (do (set w (quot w 256))
          (set k (+ k 1))))
    (return (rem w 256))))

(defn ^I32 vt-near [^I32 got ^I32 want]
  (comment "1 when two colours are within two levels in every channel (-1 is only near -1).")
  (if (or (< got 0) (< want 0))
    (do (if (and (< got 0) (< want 0)) (return 1))
        (return 0)))
  (let [^:mut ^I32 i 0
        ^:mut ^I32 d 0]
    (while (< i 3)
      (do (set d (- (vt-chan got i) (vt-chan want i)))
          (if (or (> d 2) (< d -2)) (return 0))
          (set i (+ i 1))))
    (return 1)))

;; -------------------------------------------------------------- the run

(defn ^I32 vt-run [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                   ^:mut ^Cells cx ^:mut ^Cells ox ^:mut ^Cells cs ^:mut ^Cells out
                   ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                   ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt ^:mut ^Cells pg
                   ^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx]
  (cells-drop gl 0)
  (cells-drop et 0)
  (cells-drop mk 0)
  (cells-drop fnt 0)
  (cells-drop wd 0)
  (cells-drop ln 0)
  (cells-drop pa 0)
  (cells-drop im 0)
  (cells-drop pts 0)
  (let [^I32 o (pd-open src ar dc a b st)]
    (if (!= o 0) (return (+ 100 o)))
    (return (pc-document src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx))))

(defn ^I32 vt-glyphs [^TestT emon-t ^Cells gl ^Cells wd ^Cells mk ^I32 g ^I32 n ^I32 vis ^I32 by ^I32 src
                      ^I32 want-rgb ^I32 cls ^I32 colour ^I32 line]
  (comment "Check n glyphs from g: `vis`, `vby`, the word's source, and for a colour row the fill and class.")
  (let [^:mut ^I32 k 0
        ^:mut ^I32 w 0
        ^:mut ^I32 got 0]
    (assert-that-at (<= (+ g n) (gl-count gl)) "there are glyphs for the row" line)
    (if (> (+ g n) (gl-count gl)) (return 0))
    (while (< k n)
      (do (assert-eq-at (gl-get gl (+ g k) (gf-vis)) vis "vis" line)
          (assert-eq-at (gl-get gl (+ g k) (gf-vby)) by "vby" line)
          (set w (gl-get gl (+ g k) (ch-word)))
          (if (>= w 0)
            (assert-eq-at (wd-get wd w (wf-src)) src "the word's source" line))
          (if (== colour 1)
            (do (assert-that-at (== (vt-near (gl-get gl (+ g k) (gf-fill)) want-rgb) 1) "fill colour" line)
                (set got (gl-get gl (+ g k) (gf-cs)))
                (if (< got 0) (set got 0))
                (assert-eq-at got cls "colour-space class" line)))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 vt-ocg [^TestT emon-t ^Cells gl ^Cells mk ^I32 g ^I32 n ^I32 want ^I32 line]
  (comment "The glyphs [g, g+n) are in an optional-content span whose default state is `want`.")
  (let [^:mut ^I32 k 0
        ^:mut ^I32 m 0]
    (while (< k n)
      (do (set m (mk-ocg-of mk (gl-get gl (+ g k) (gf-mark))))
          (assert-that-at (>= m 0) "an optional-content span encloses the glyph" line)
          (if (>= m 0)
            (assert-eq-at (mk-get mk m (mkf-ocgdef)) want "the span's default state" line))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 vt-words [^TestT emon-t ^Cells gl ^Cells wd ^I32 line]
  (comment "No word mixes visibilities: every glyph of a word has its first glyph's `vis` (and hidden-ness is the same, by")
  (comment "the source of the word).")
  (let [^:mut ^I32 w 0
        ^:mut ^I32 k 0
        ^:mut ^I32 g0 0
        ^:mut ^I32 n 0]
    (while (< w (wd-count wd))
      (do (set g0 (wd-get wd w (wf-gfirst)))
          (set n (wd-get wd w (wf-gcount)))
          (set k 1)
          (while (< k n)
            (do (assert-eq-at (gl-get gl (+ g0 k) (gf-vis)) (gl-get gl g0 (gf-vis)) "a word has one visibility" line)
                (set k (+ k 1))))
          (set w (+ w 1))))
    (return 0)))

(defn ^I32 vt-rows [^TestT emon-t ^Blob rows]
  (comment "Check the row file; answers how many rows were checked.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells cx (new-cells)
        ^Cells ox (new-cells)
        ^Cells cs (new-cells)
        ^Cells out (new-cells)
        ^Cells f0 (new-cells)
        ^Cells f1 (new-cells)
        ^Cells f2 (new-cells)
        ^Cells f3 (new-cells)
        ^Cells gl (new-cells)
        ^Cells et (new-cells)
        ^Cells mk (new-cells)
        ^Cells fnt (new-cells)
        ^Cells pg (new-cells)
        ^Cells wd (new-cells)
        ^Cells ln (new-cells)
        ^Cells pa (new-cells)
        ^Cells im (new-cells)
        ^Cells pts (new-cells)
        ^Cells gx (new-cells)
        ^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells refs (new-cells)
        ^Cells feats (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)
        ^I32 n (blob-len rows)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 e 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 checked 0
        ^:mut ^I32 g 0
        ^:mut ^I32 gprev 0
        ^:mut ^I32 nprev 0
        ^:mut ^I32 ii 0
        ^:mut ^I32 pi 0
        ^:mut ^I32 tr 0
        ^:mut ^I32 want 0
        ^:mut ^I32 status 0
        ^:mut ^I32 p 0
        ^:mut ^I32 q 0
        ^:mut ^I32 vis 0
        ^:mut ^I32 by 0
        ^:mut ^I32 src 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 rgb 0
        ^:mut ^I32 cls 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (vt-nl rows pos))
          (if (and (< pos e) (!= (blob-u8 rows pos) 35))
            (do (set kind (blob-u8 rows pos))
                (set checked (+ checked 1))
                (if (== kind 70)
                  (do (set status (vt-run (src-of-blob (test-file-span rows (+ pos 2) e))
                                          ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx))
                      (assert-eq-at status 0 "the file ran" line)
                      (assert-eq-at (ev-check epages views pts refs et feats gl wd ln mk fnt pa im oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0 "the evidence is well formed" line)
                      (vt-words emon-t gl wd line)
                      (set g 0)
                      (set ii 0)
                      (set pi 0)))
                (if (== kind 80)
                  (do (comment "P vis vby backdrop chk tr n")
                      (while (and (< pi (pa-count pa))
                                  (!= (bit-and (pa-get pa pi (pf-flags)) (+ (pg-clip) (pg-shading))) 0))
                        (set pi (+ pi 1)))
                      (assert-that-at (< pi (pa-count pa)) "there is a painted path row" line)
                      (if (< pi (pa-count pa))
                        (do (set p (+ pos 2))
                            (set q (vt-tab rows p e))
                            (assert-eq-at (pa-get pa pi (pf-vis)) (vt-dec rows p q) "path vis" line)
                            (set p (+ q 1))
                            (set q (vt-tab rows p e))
                            (assert-eq-at (pa-get pa pi (pf-vby)) (vt-dec rows p q) "path vby" line)
                            (set p (+ q 1))
                            (set q (vt-tab rows p e))
                            (assert-eq-at (pa-get pa pi (pf-backdrop)) (vt-rgb rows p q) "path backdrop" line)
                            (set p (+ q 1))
                            (set q (vt-tab rows p e))
                            (set want (vt-dec rows p q))
                            (assert-eq-at (bit-and (pa-get pa pi (pf-vchk)) want) want "path vchk has the checks that ran" line)
                            (set p (+ q 1))
                            (set q (vt-tab rows p e))
                            (set want (vt-dec rows p q))
                            (set tr 0)
                            (if (!= (bit-and (pa-get pa pi (pf-flags)) (pg-truncated)) 0) (set tr 1))
                            (assert-eq-at tr want "path truncated" line)
                            (set p (+ q 1))
                            (set q (vt-tab rows p e))
                            (set want (vt-dec rows p q))
                            (if (>= want 0)
                              (assert-eq-at (pa-get pa pi (pf-pcount)) want "path points kept" line))))
                      (set pi (+ pi 1))))
                (if (== kind 71)
                  (do (comment "G vis vby src ncp text")
                      (set p (+ pos 2))
                      (set q (vt-tab rows p e))
                      (set vis (vt-dec rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set by (vt-dec rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set src (vt-dec rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set cnt (vt-dec rows p q))
                      (vt-glyphs emon-t gl wd mk g cnt vis by src 0 0 0 line)
                      (set gprev g)
                      (set nprev cnt)
                      (set g (+ g cnt))))
                (if (== kind 67)
                  (do (comment "C rgb cls vis ncp text")
                      (set p (+ pos 2))
                      (set q (vt-tab rows p e))
                      (set rgb (vt-rgb rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set cls (vt-dec rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set vis (vt-dec rows p q))
                      (set p (+ q 1))
                      (set q (vt-tab rows p e))
                      (set cnt (vt-dec rows p q))
                      (vt-glyphs emon-t gl wd mk g cnt vis -1 1 rgb cls 1 line)
                      (set gprev g)
                      (set nprev cnt)
                      (set g (+ g cnt))))
                (if (== kind 79)
                  (do (comment "O ocgdef ncp")
                      (set p (+ pos 2))
                      (set q (vt-tab rows p e))
                      (set vis (vt-dec rows p q))
                      (vt-ocg emon-t gl mk gprev nprev vis line)))
                (if (== kind 73)
                  (do (comment "I vis vby")
                      (set p (+ pos 2))
                      (set q (vt-tab rows p e))
                      (set vis (vt-dec rows p q))
                      (set by (vt-dec rows (+ q 1) e))
                      (assert-that-at (< ii (im-count im)) "there is an image row" line)
                      (if (< ii (im-count im))
                        (do (assert-eq-at (im-get im ii (mf-vis)) vis "image vis" line)
                            (assert-eq-at (im-get im ii (mf-vby)) by "image vby" line)))
                      (set ii (+ ii 1))))
                (if (== kind 78)
                  (do (comment "N glyphs images")
                      (set p (+ pos 2))
                      (set q (vt-tab rows p e))
                      (assert-eq-at (gl-count gl) (vt-dec rows p q) "glyph count" line)
                      (assert-eq-at (im-count im) (vt-dec rows (+ q 1) e) "image count" line)))))
          (set pos (+ e 1))))
    (return checked)))

(deftest test-every-visibility-fixture-is-classified-as-written
  (comment "The files of test/vis: white on white and the same colour as the background, clipped, off the page, tiny, painted")
  (comment "over, optional content, alpha, hidden OCR layers and a page as a crawler is fed it, and the colour spaces.")
  (assert-that (> (vt-rows (test-t) (test-file "vis/rows.txt")) 150) "the rows were read"))

;; D701: the original row scans are the oracle, including uncertain backdrops.
(defn ^I32 vt-old-backdrop [^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells mk
                        ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 gz ^I32 jp ^I32 ji ^I32 p0 ^I32 i0 ^I32 me ^I32 lim]
  (comment "The colour behind a glyph cell with this box and paint number: 0xRRGGBB, or -2 when it cannot be told. Paths")
  (comment "are searched backwards from row jp (the first with a later z), images from row ji. `me` is the path row being")
  (comment "classified (-1 for a glyph): an earlier rectangle that this path, itself an exactly known opaque rectangle,")
  (comment "covers completely is not what it is painted on, it is painted OVER (a rule drawn twice is one rule: of two paints")
  (comment "of the same colour on the same box the later is the ink and the earlier the one it hides, never both hidden).")
  (let [^:mut ^I32 r (- jp 1)
        ^:mut ^I32 steps 0
        ^:mut ^I32 zp -1
        ^:mut ^I32 res 16777215
        ^:mut ^I32 fl 0
        ^:mut ^I32 rx0 0
        ^:mut ^I32 ry0 0
        ^:mut ^I32 rx1 0
        ^:mut ^I32 ry1 0
        ^:mut ^I32 zi -1
        ^:mut ^I32 found 0]
    (while (and (>= r p0) (and (< steps lim) (== found 0)))
      (do (set fl (pa-get pa r (pf-flags)))
          (if (and (== (bit-and fl (pg-clip)) 0) (!= (bit-and fl (pg-filled)) 0))
            (do (set rx0 (pv-path-k pa r 0))
                (set ry0 (pv-path-k pa r 1))
                (set rx1 (pv-path-k pa r 2))
                (set ry1 (pv-path-k pa r 3))
                (if (and (>= me 0) (== (pv-opaque-rect pa mk me) 1))
                  (if (== (pv-covers (pv-path-k pa me 0) (pv-path-k pa me 1) (pv-path-k pa me 2) (pv-path-k pa me 3)
                                     (pv-full-k pa r 0) (pv-full-k pa r 1) (pv-full-k pa r 2) (pv-full-k pa r 3)) 1)
                    (set rx1 (- rx0 1))))
                (if (== (pv-hit x0 y0 x1 y1 rx0 ry0 rx1 ry1) 1)
                  (do (set found 1)
                      (set zp (pa-get pa r (pf-z)))
                      (if (and (== (pv-opaque-rect pa mk r) 1) (== (pv-covers rx0 ry0 rx1 ry1 x0 y0 x1 y1) 1))
                        (set res (pa-get pa r (pf-fill)))
                        (set res -2))))))
          (set r (- r 1))
          (set steps (+ steps 1))))
    (comment "The nearest earlier image that touches the cell.")
    (set r (- ji 1))
    (set steps 0)
    (set found 0)
    (while (and (>= r i0) (and (< steps lim) (== found 0)))
      (do (set rx0 (pv-img-k im pa r 0))
          (set ry0 (pv-img-k im pa r 1))
          (set rx1 (pv-img-k im pa r 2))
          (set ry1 (pv-img-k im pa r 3))
          (if (== (pv-hit x0 y0 x1 y1 rx0 ry0 rx1 ry1) 1)
            (do (set found 1)
                (set zi (im-get im r (mf-z)))))
          (set r (- r 1))
          (set steps (+ steps 1))))
    (if (> zi zp) (return -2))
    (return res)))

(defn ^I32 vt-old-occluder [^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells mk
                        ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 jp ^I32 ji ^I32 p1 ^I32 i1 ^I32 lim]
  (comment "The `z` of the first later paint that is opaque, exactly known and covers the whole box, else -1. Paths")
  (comment "are searched forwards from row jp to p1, images from ji to i1.")
  (let [^:mut ^I32 r jp
        ^:mut ^I32 steps 0
        ^:mut ^I32 zp -1
        ^:mut ^I32 zi -1]
    (while (and (< r p1) (and (< steps lim) (< zp 0)))
      (do (if (== (pv-opaque-rect pa mk r) 1)
            (if (== (pv-covers (pv-path-k pa r 0) (pv-path-k pa r 1) (pv-path-k pa r 2) (pv-path-k pa r 3) x0 y0 x1 y1) 1)
              (set zp (pa-get pa r (pf-z)))))
          (set r (+ r 1))
          (set steps (+ steps 1))))
    (set r ji)
    (set steps 0)
    (while (and (< r i1) (and (< steps lim) (< zi 0)))
      (do (if (== (pv-opaque-img im mk r) 1)
            (if (== (pv-covers (pv-img-k im pa r 0) (pv-img-k im pa r 1) (pv-img-k im pa r 2) (pv-img-k im pa r 3) x0 y0 x1 y1) 1)
              (set zi (im-get im r (mf-z)))))
          (set r (+ r 1))
          (set steps (+ steps 1))))
    (if (and (>= zp 0) (>= zi 0))
      (do (if (< zp zi) (return zp))
          (return zi)))
    (if (>= zp 0) (return zp))
    (return zi)))


(deftest test-index-preserves-row-bounds-and-uncertain-backdrops
  (let [^Cells pa (new-cells) ^Cells im (new-cells) ^Cells mk (new-cells) ^Cells ix (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 m 0 ^:mut ^I32 j 0 ^:mut ^I32 lim 0 ^:mut ^I32 me -1]
    (set m (mk-new mk 1 (mk-optional-content) 0 0 -1 0))
    (mk-set mk m (mkf-ocgdef) 0)
    (while (< j 4200)
      (do (set r (pa-new pa 1 (pa-rect) 0 0 1000 1000))
          (pa-set pa r (pf-z) j)
          (pa-set pa r (pf-flags) (pg-stroked))
          (pa-set pa r (pf-width) 3)
          (if (== (rem j 7) 0)
            (do (pa-set pa r (pf-flags) (pg-filled))
                (pa-set pa r (pf-fill) 123)))
          (if (== (rem j 11) 0) (pa-set pa r (pf-mark) m))
          (if (== (rem j 13) 0) (pa-set pa r (pf-falpha) 500))
          (if (== (rem j 17) 0) (pa-set pa r (pf-flags) (+ (pg-filled) (pg-blend))))
          (if (== (rem j 19) 0)
            (do (pa-set pa r (pf-flags) (pg-clip))
                (pa-set pa r (pf-x1) 100)
                (pa-set pa r (pf-y1) 100)))
          (if (> j 0) (pa-set pa r (pf-clip) (- j 1)))
          (set j (+ j 1))))
    (pv-index pa mk ix 0 4200)
    (set j 0)
    (while (< j 4200)
      (do (set lim 1)
          (while (<= lim 4096)
            (do (assert-eq (pv-occluder pa im mk ix 200 200 800 800 j 0 4200 0 lim)
                           (vt-old-occluder pa im mk 200 200 800 800 j 0 4200 0 lim) "first occluder at the same row bound")
                (set me -1)
                (while (< me 2)
                  (do (assert-eq (pv-backdrop pa im mk ix 200 200 800 800 j j 0 0 0 me lim)
                                 (vt-old-backdrop pa im mk 200 200 800 800 j j 0 0 0 me lim) "backdrop includes uncertain paint and self-cover")
                      (set me (+ me 1))))
                (set lim (* lim 8))))
          (set j (+ j 61))))))

(deftest test-index-keeps-exclusive-forward-and-inclusive-backward-bound
  (let [^Cells pa (new-cells) ^Cells im (new-cells) ^Cells mk (new-cells) ^Cells ix (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 j 0]
    (while (< j 4100)
      (do (set r (pa-new pa 1 (pa-rect) 0 0 1000 1000))
          (pa-set pa r (pf-z) j)
          (pa-set pa r (pf-fill) 123)
          (pa-set pa r (pf-flags) (pg-stroked))
          (set j (+ j 1))))
    (pa-set pa 4097 (pf-flags) (pg-filled))
    (pv-index pa mk ix 1 4100)
    (assert-eq (pv-occluder pa im mk ix 200 200 800 800 1 0 4100 0 4096) -1 "row jp+lim is excluded")
    (assert-eq (pv-occluder pa im mk ix 200 200 800 800 2 0 4100 0 4096) 4097 "row jp+lim-1 is included")
    (assert-eq (pv-backdrop pa im mk ix 200 200 800 800 4098 4098 0 1 0 -1 1) 123 "row jp-lim is included")
    (assert-eq (pv-backdrop pa im mk ix 200 200 800 800 4099 4099 0 1 0 -1 1) 16777215 "earlier than jp-lim is excluded")))
