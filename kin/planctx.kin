;; THE PLAN MACHINE'S CONTEXT (P10.8; D396, D399): what one plan/fulfil loop keeps between attempts, declared once in kin and constructed by each host
;; (`defctx`: a public type with the fields' own names, `new()`, `clone()`). `emon.planloop` borrows its fields with `fd`. A tag defined by a file is
;; not in that file's own scope (found in kin), so the context lives in a namespace of its own, like `emon.enctx`'s.
;;
;;   ans         the answers so far, back to back (the unit's `answers`): the ANSWERED SET is their ids
;;   rq          the requests the last attempt wrote (the unit's `requests`), emptied by each `pl-attempt`
;;   reqs        the round's outstanding requests, SORTED BY ID: a `requests` round or a fetch round (`outk`)
;;   got         the answers offered to the round so far, in the order they arrived
;;   cur         the one answer being offered (`pl-offer` reads it)
;;   tx          the transcript's entries, in id order: `[round request... answer...]`, each record length-prefixed, drained by the host
;;   cand        the ranges the host's source missed, as `input offset length` triples, for `pl-fetch`
;;   srt         scratch: the starts of the requests in id order
;;   pgr, pgq    per page unit, the rounds it took and the requests it made (folded in by `pl-fold`)
;;   msg         the sentence of the last error (the host's `Display` is `name: msg`)
;;   max-rounds, fetch-limit      the two limits of SPEC 13.1 (set by the host from its Config)
;;   attempts, rounds, requests, fetch-rounds, bytes-requests    one unit's accounting (the Stats)
;;   fetch-round the misses in a row (a round of requests starts it over); round the round the outstanding requests belong to
;;   outk        what `reqs` holds: 0 nothing, 1 `bytes` requests, 2 a round of requests
;;   err, err-limit, err-actual  the error's name (`pe`), and a limit's value and the number it reached (a unit status for `pe-unit-failed`)
;;   elapsed     the milliseconds the current unit has run, rounded up, put by the host (its clock) before each `pl-after`; `stage-ms` is judged against it
;;   phase, page which unit the engine is on (`ph`) and which page it is
;;   t-*         the totals the finished units folded in (what the host's RunStats reads)
(ns emon.planctx
  (:require [emon.lang :refer [I32 Cells Text defctx]]))

(defctx ^:pub Plan [^Cells ans ^Cells rq ^Cells reqs ^Cells got ^Cells cur ^Cells tx ^Cells cand ^Cells srt ^Cells pgr ^Cells pgq
      ^Text msg
      ^I32 max-rounds ^I32 fetch-limit ^I32 attempts ^I32 rounds ^I32 requests ^I32 fetch-rounds ^I32 bytes-requests
      ^I32 fetch-round ^I32 round ^I32 outk ^I32 err ^I32 err-limit ^I32 err-actual ^I32 phase ^I32 page
      ^I32 elapsed
      ^I32 t-attempts ^I32 t-fetch-rounds ^I32 t-bytes-requests ^I32 t-requests])
