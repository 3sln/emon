(ns emon.pageboundstest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq assert-that new-cells test-t TestT]]
            [emon.port :refer [cells-push cells-at]]
            [emon.pagebounds :refer [pb-first pb-after pb-first-span pb-build-ranges]]
            [kin.lang :refer [defn let set while if do + - * < > <= >= == and or quot rem]]))

(deftest test-page-ranges-preserve-every-surviving-row-with-tombstones
  (let [^Cells rows (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 p 0 ^:mut ^I32 first 0 ^:mut ^I32 end 0]
    (while (< r 140)
      (do (set p (+ 1 (quot r 7)))
          (if (== (rem r 3) 0) (set p -7))
          (if (== (rem r 5) 0) (set p 0))
          (cells-push rows p) (cells-push rows r) (cells-push rows 0)
          (set r (+ r 1))))
    (set p 1)
    (while (<= p 22)
      (do (set first (pb-first rows 3 p)) (set end (pb-after rows 3 p))
          (assert-that (and (>= first 0) (and (<= first end) (<= end 140))) "valid range")
          (set r 0)
          (while (< r 140)
            (do (if (== (cells-at rows (* r 3)) p)
                  (assert-that (and (>= r first) (< r end)) "every old-scan hit is inside the range in the same order"))
                (set r (+ r 1))))
          (set p (+ p 1))))))

(deftest test-zero-based-trace-pages-and-absent-pages
  (let [^Cells rows (new-cells)]
    (cells-push rows 0) (cells-push rows 0) (cells-push rows 2) (cells-push rows 2)
    (assert-eq (pb-first rows 1 0) 0 "page zero starts at zero")
    (assert-eq (pb-after rows 1 0) 2 "page zero ends before positive pages")
    (assert-eq (pb-first rows 1 1) 2 "absent page has an empty range")
    (assert-eq (pb-after rows 1 1) 2 "absent page has an empty range")
    (assert-eq (pb-after rows 1 2) 4 "last page includes its last row")))


(deftest test-appended-column-pieces-have-a-separate-page-ordered-run
  (let [^Cells rows (new-cells)]
    (cells-push rows 1) (cells-push rows 1) (cells-push rows 2)
    (cells-push rows 2) (cells-push rows 3) (cells-push rows 3)
    (cells-push rows 1) (cells-push rows 1) (cells-push rows 2) (cells-push rows 3)
    (assert-eq (pb-first-span rows 1 3 0 6) 4 "original page three begins before the appended pieces")
    (assert-eq (pb-first-span rows 1 4 0 6) 6 "original page three ends at the immutable boundary")
    (assert-eq (pb-first-span rows 1 3 6 10) 9 "appended page three follows earlier pages' pieces")
    (assert-eq (pb-first-span rows 1 4 6 10) 10 "all appended pieces are retained")))


(deftest test-range-index-keeps-unordered-fixtures-and-deleted-rows
  (let [^Cells rows (new-cells) ^Cells ix (new-cells)]
    (cells-push rows 2) (cells-push rows -7) (cells-push rows 1)
    (cells-push rows 2) (cells-push rows 0) (cells-push rows 3)
    (pb-build-ranges rows 1 0 6 4 ix)
    (assert-eq (cells-at ix 2) 2 "page one's first row")
    (assert-eq (cells-at ix 3) 3 "page one's end")
    (assert-eq (cells-at ix 4) 0 "page two includes its earlier row")
    (assert-eq (cells-at ix 5) 4 "page two includes its later row")
    (assert-eq (cells-at ix 8) 6 "empty page begins at the end")
    (assert-eq (cells-at ix 9) 6 "empty page stays empty")))
