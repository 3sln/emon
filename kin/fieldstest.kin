;; Laws for the form fields (P11.x3; SPEC 3.2, 5.1; D548), on every target.
;;
;; WHAT THE ANNOTATION READER MAKES of an AcroForm is the laws of `emon.pdfcatalogtest` (`test-widgets-ride-in-an-as-synthetic-field-rows`: a check box, a radio
;; group, text fields that inherit their value, a combo box). WHAT `emon.fields` MAKES of those rows and a Model written by hand is here: the rule that decides which
;; block holds a field (a check box before the label to its right, a text field after the label to its left or above it, a leader that joins a far label to its
;; box, a label above a row of boxes against the instruction line that ends beside the first one, a field with no label), over the scene of the IRS W-9 (the
;; geometry of its real widgets and the real lines beside them), and the HTML a field is written as (a span that never is an input).
(ns emon.fieldstest
  (:require [emon.lang :refer [I32 Blob Cells Text]]
            [emon.test :refer [deftest assert-eq assert-text new-cells new-text new-buf text-blob TestT test-t]]
            [emon.port :refer [blob-len cells-len cells-set cells-push]]
            [emon.model :refer [model-init model-check node-new node-set-text node-set-sub node-set-aux node-add-region text-len text-append-utf8
                                nk-paragraph nk-span nk-text nk-table nk-rowgroup nk-row nk-cell]]
            [emon.html :refer [html-emit]]
            [emon.json :refer [js-emit]]
            [emon.pdfannot :refer [an-field]]
            [emon.fields :refer [fl-run]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

;; ------------------------------------------------------------------------------------------------ scenes

(defn ^I32 fdt-par [^:mut ^Cells nodes ^:mut ^Cells regions ^:mut ^Cells text ^Blob b ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "A paragraph under the document, with this text and this box on page 1.")
  (let [^I32 n (node-new nodes (nk-paragraph) 0)
        ^I32 s (text-len text)]
    (text-append-utf8 text b 0 (blob-len b))
    (node-set-text nodes n s (- (text-len text) s))
    (node-add-region nodes regions n 1 x0 y0 x1 y1)
    (return n)))

(defn ^I32 fdt-run [^:mut ^Cells txt ^Blob b]
  (comment "Append b to the annotation text and answer where it starts.")
  (let [^I32 s (cells-len txt)]
    (text-append-utf8 txt b 0 (blob-len b))
    (return s)))

(defn ^I32 fdt-field [^:mut ^Cells an ^:mut ^Cells txt ^I32 kind ^I32 checked ^Blob name ^Blob value ^Blob export ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "One `an-field` row (the layout is in the head of `emon.pdfannot`) on page 1: kind 2 check box, 3 radio, 4 text; `checked` for a button; the strings may be empty.")
  (let [^I32 at (cells-len an)
        ^I32 ns (fdt-run txt name)
        ^I32 vs (fdt-run txt value)
        ^I32 es (fdt-run txt export)
        ^:mut ^I32 k 0]
    (while (< k 38)
      (do (cells-push an 0)
          (set k (+ k 1))))
    (cells-set an (+ at 1) (an-field))
    (cells-set an (+ at 4) x0)
    (cells-set an (+ at 5) y0)
    (cells-set an (+ at 6) x1)
    (cells-set an (+ at 7) y1)
    (cells-set an (+ at 8) kind)
    (cells-set an (+ at 9) checked)
    (cells-set an (+ at 11) 1)
    (cells-set an (+ at 12) ns)
    (cells-set an (+ at 13) (blob-len name))
    (cells-set an (+ at 14) -1)
    (cells-set an (+ at 16) -1)
    (cells-set an (+ at 18) -1)
    (if (> (blob-len value) 0)
      (do (cells-set an (+ at 14) vs)
          (cells-set an (+ at 15) (blob-len value))))
    (if (> (blob-len export) 0)
      (do (cells-set an (+ at 16) es)
          (cells-set an (+ at 17) (blob-len export))))
    (return 0)))

(defn ^I32 fdt-html [^TestT emon-t ^Cells on ^Cells oa ^Cells orr ^:mut ^Cells text ^Cells an ^Cells txt ^:mut ^Text out]
  (comment "`fl-run` over the Model written by hand, then its HTML into out. The result is checked as a Model (ids in document order, runs inside the text arena).")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells nm (new-cells)
        ^Cells fc (new-cells)
        ^Cells fh (new-cells)
        ^Cells bt (new-cells)
        ^Cells sc (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells st (new-cells)
        ^I32 n (fl-run on oa orr text nodes attrs regions nm an txt fc fh bt sc)
        ^:mut ^I32 ok 0]
    (if (> n 0) (set ok 1))
    (assert-eq ok 1 "the fields were put in")
    (assert-eq (model-check nodes attrs regions text pages ledger layout st) 0 "the Model with the fields is well formed")
    (html-emit out 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (return n)))

;; ------------------------------------------------------------------------------------------------ the rule

(deftest test-a-check-box-goes-before-the-label-to-its-right-and-says-whether-it-is-on
  (comment "A box 6 pt left of `Individual/sole proprietor`, off, and one 6 pt left of `C corporation`, on and a radio button: each comes before its label's words as a")
  (comment "span, never an input; a button's element is empty, its export value is `data-emon-value`, and it says what it is (`role`) and whether it is on (`aria-checked`).")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Individual/sole proprietor") 8700 18000 16400 18800)
    (fdt-par nodes regions text (text-blob "C corporation") 19400 18000 23700 18800)
    (fdt-field an txt 2 0 (text-blob "c1_1[0]") (text-blob "") (text-blob "1") 7300 18020 8100 18820)
    (fdt-field an txt 3 1 (text-blob "c1_1[1]") (text-blob "") (text-blob "b") 18000 18020 18800 18820)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p><span data-emon=\"field\" data-emon-name=\"c1_1[0]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"1\"></span>Individual/sole proprietor</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[1]\" data-emon-type=\"radio\" role=\"radio\" data-emon-checked=\"true\" aria-checked=\"true\" data-emon-value=\"b\"></span>C corporation</p></main></body></html>" "check boxes before their labels")))

(deftest test-a-text-field-goes-after-the-label-to-its-left-or-above-it
  (comment "`Name` has a box under it (the label is above: 4 pt over the box's top, overlapping it): the box comes after the label, with its value as the span's content. `LLC.")
  (comment "Enter the tax classification` has a box 7.6 pt right of it on its line, and a line of boxes over it ends 4 pt over the box: the nearer left label wins, because the")
  (comment "label above is nearer by less than 8 pt.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "1 Name of entity/individual") 6200 9700 27400 11400)
    (fdt-par nodes regions text (text-blob "Trust/estate") 40200 18000 44000 18800)
    (fdt-par nodes regions text (text-blob "LLC. Enter the tax classification") 8600 19400 41000 20200)
    (fdt-field an txt 4 -1 (text-blob "f1_01[0]") (text-blob "Ada Lovelace") (text-blob "") 5860 11800 57600 13200)
    (fdt-field an txt 4 -1 (text-blob "f1_03[0]") (text-blob "") (text-blob "") 41760 19200 44640 20300)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>1 Name of entity/individual<span data-emon=\"field\" data-emon-name=\"f1_01[0]\" data-emon-type=\"text\">Ada Lovelace</span></p><p>Trust/estate</p><p>LLC. Enter the tax classification<span data-emon=\"field\" data-emon-name=\"f1_03[0]\" data-emon-type=\"text\"></span></p></main></body></html>" "text fields after their labels")))

(deftest test-the-cents-box-of-a-line-goes-with-the-dollars-box-beside-it-not-with-the-line-above
  (comment "D583 (smoke review A issue 10; the geometry of lines 14 and 15a of the IRS Form 941): each line has a box of dollars and a box of cents 7 pt to its right. The dollars box has its label to its left")
  (comment "on its line (3.6 pt). The cents box of line 15a is 76 pt from that label, with no leader between, and the label of line 14 ends 4.6 pt over its top: the nearest label above took it.")
  (comment "A field just to the left on its line, which has a label, is the line's: the cents box goes with it.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "14 Balance due. If line 12 is more than line 13, enter the difference") 4095 67928 44393 68942)
    (fdt-par nodes regions text (text-blob "15a Overpayment. If line 13 is more than line 12, enter the difference") 4100 69830 29140 70840)
    (fdt-field an txt 4 -1 (text-blob "f1_53[0]") (text-blob "") (text-blob "") 44640 67500 54720 68900)
    (fdt-field an txt 4 -1 (text-blob "f1_54[0]") (text-blob "") (text-blob "") 55440 67500 57525 68900)
    (fdt-field an txt 4 -1 (text-blob "f1_55[0]") (text-blob "") (text-blob "") 29500 69400 36000 70800)
    (fdt-field an txt 4 -1 (text-blob "f1_56[0]") (text-blob "") (text-blob "") 36720 69400 38805 70800)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>14 Balance due. If line 12 is more than line 13, enter the difference<span data-emon=\"field\" data-emon-name=\"f1_53[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_54[0]\" data-emon-type=\"text\"></span></p><p>15a Overpayment. If line 13 is more than line 12, enter the difference<span data-emon=\"field\" data-emon-name=\"f1_55[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_56[0]\" data-emon-type=\"text\"></span></p></main></body></html>"
                 "the cents boxes go with their dollars boxes")))

(deftest test-the-label-over-a-row-of-boxes-beats-the-instruction-that-ends-beside-the-first
  (comment "Three boxes of a number under `Social security number`, the first 15.6 pt right of the end of an instruction line that is on its line: the label above is 3 pt over")
  (comment "the box, so the instruction line (nearer than 24 pt, but not by 8 pt) does not take it; the third box is past the end of the label (20 pt sideways) and still has")
  (comment "no other label, and a dash between the boxes is no label.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Social security number") 42200 36000 49800 36900)
    (fdt-par nodes regions text (text-blob "Enter your TIN in the appropriate box.") 3600 36400 40200 38300)
    (fdt-par nodes regions text (text-blob "-") 46600 37900 47000 38800)
    (fdt-field an txt 4 -1 (text-blob "f1_13[0]") (text-blob "") (text-blob "") 51840 37200 57600 39600)
    (fdt-field an txt 4 -1 (text-blob "f1_11[0]") (text-blob "") (text-blob "") 41760 37200 46080 39600)
    (fdt-field an txt 4 -1 (text-blob "f1_12[0]") (text-blob "") (text-blob "") 47520 37200 50400 39600)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>Social security number<span data-emon=\"field\" data-emon-name=\"f1_11[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_12[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_13[0]\" data-emon-type=\"text\"></span></p><p>Enter your TIN in the appropriate box.</p><p>-</p></main></body></html>" "the label above, boxes in reading order")))

(deftest test-dot-leaders-join-a-label-to-a-box-however-far
  (comment "A check box 102 pt right of the end of its label: with dot leaders between them it is the label's, after its words; without, no label is near enough and the box gets a")
  (comment "paragraph of its own after the paragraph above it.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "this box if you have any foreign partners") 7400 26300 33800 27200)
    (fdt-par nodes regions text (text-blob ". . . .") 39600 26300 43400 27200)
    (fdt-field an txt 2 1 (text-blob "c1_2[0]") (text-blob "") (text-blob "Yes") 44060 26300 44860 27100)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>this box if you have any foreign partners<span data-emon=\"field\" data-emon-name=\"c1_2[0]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"true\" aria-checked=\"true\" data-emon-value=\"Yes\"></span></p><p>. . . .</p></main></body></html>" "joined by the leaders")))

(deftest test-without-a-leader-a-far-label-is-no-label
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "this box if you have any foreign partners") 7400 26300 33800 27200)
    (fdt-field an txt 2 1 (text-blob "c1_2[0]") (text-blob "") (text-blob "Yes") 44060 26300 44860 27100)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>this box if you have any foreign partners</p><p><span data-emon=\"field\" data-emon-name=\"c1_2[0]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"true\" aria-checked=\"true\" data-emon-value=\"Yes\"></span></p></main></body></html>" "no leader, no label")))

(deftest test-a-field-with-no-label-gets-a-paragraph-after-the-block-above-it
  (comment "A text field with nothing near it, between two paragraphs of its page: a paragraph of its own between them (reading order by the top edge). A second one above the")
  (comment "first paragraph comes before it. A form of a page with no text at all: the paragraph is the document's last.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Heading text") 5000 5000 20000 6000)
    (fdt-par nodes regions text (text-blob "Later text") 5000 30000 20000 31000)
    (fdt-field an txt 4 -1 (text-blob "mid") (text-blob "v") (text-blob "") 5000 12000 9000 13000)
    (fdt-field an txt 4 -1 (text-blob "top") (text-blob "") (text-blob "") 5000 1000 9000 2000)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p><span data-emon=\"field\" data-emon-name=\"top\" data-emon-type=\"text\"></span></p><p>Heading text</p><p><span data-emon=\"field\" data-emon-name=\"mid\" data-emon-type=\"text\">v</span></p><p>Later text</p></main></body></html>" "paragraphs of their own")))

(deftest test-a-form-of-a-page-with-no-text-has-one-paragraph-at-the-documents-end
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-field an txt 4 -1 (text-blob "only") (text-blob "") (text-blob "") 5000 12000 9000 13000)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p><span data-emon=\"field\" data-emon-name=\"only\" data-emon-type=\"text\"></span></p></main></body></html>" "a page with no text")))

(deftest test-a-label-with-styled-words-has-no-text-of-its-own-and-still-holds-a-field
  (comment "The W-9's `1 Name of entity` is a bold `1` and the words after it: the paragraph has no text run, its words are its inline children's. It is a label all the same (its")
  (comment "words are the children's), the field under it comes after the last of them, and the children are kept.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (let [^I32 p (node-new nodes (nk-paragraph) 0)
          ^I32 sp (node-new nodes (nk-span) p)
          ^I32 t1 (node-new nodes (nk-text) sp)
          ^I32 t2 (node-new nodes (nk-text) p)
          ^I32 s1 (text-len text)]
      (node-set-sub nodes sp 1)
      (text-append-utf8 text (text-blob "1") 0 1)
      (node-set-text nodes t1 s1 1)
      (text-append-utf8 text (text-blob " Name of entity") 0 15)
      (node-set-text nodes t2 (+ s1 1) 15)
      (node-add-region nodes regions p 1 6200 9700 27400 11400))
    (fdt-field an txt 4 -1 (text-blob "f1_01[0]") (text-blob "") (text-blob "") 5860 11800 57600 13200)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p><b>1</b> Name of entity<span data-emon=\"field\" data-emon-name=\"f1_01[0]\" data-emon-type=\"text\"></span></p></main></body></html>" "after the last inline")))

(deftest test-a-box-in-an-empty-table-cell-with-no-label-goes-in-the-cell
  (comment "A check box that stands in an empty cell, with the next cell's text 151 pt away (no label near enough): the cell holds it, and is not `empty` any more.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (let [^I32 tb (node-new nodes (nk-table) 0)
          ^I32 rg (node-new nodes (nk-rowgroup) tb)
          ^I32 rw (node-new nodes (nk-row) rg)
          ^I32 c1 (node-new nodes (nk-cell) rw)
          ^I32 c2 (node-new nodes (nk-cell) rw)
          ^I32 s (text-len text)]
      (node-set-sub nodes rg 2)
      (node-set-aux nodes c1 1)
      (node-add-region nodes regions c1 1 3600 6000 5200 7000)
      (text-append-utf8 text (text-blob "Total") 0 5)
      (node-set-text nodes c2 s 5)
      (node-add-region nodes regions c2 1 20000 6000 30000 7000))
    (fdt-field an txt 2 0 (text-blob "inbox") (text-blob "") (text-blob "1") 3900 6200 4900 6800)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><table><tbody><tr><td><span data-emon=\"field\" data-emon-name=\"inbox\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"1\"></span></td><td>Total</td></tr></tbody></table></main></body></html>" "in the cell")))

(deftest test-a-document-without-a-field-is-not-touched
  (comment "No row of the annotation reader is a field: `fl-run` answers 0 and writes nothing, so a document that is not a form has the Model it had.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Cells nn (new-cells)
        ^Cells na (new-cells)
        ^Cells nr (new-cells)
        ^Cells nm (new-cells)
        ^Cells fc (new-cells)
        ^Cells fh (new-cells)
        ^Cells bt (new-cells)
        ^Cells sc (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Plain text") 5000 5000 20000 6000)
    (assert-eq (fl-run nodes attrs regions text nn na nr nm an txt fc fh bt sc) 0 "no field, nothing done")
    (assert-eq (cells-len nn) 0 "and nothing was written")))

;; ------------------------------------------------------------------------------------------------ the W-9

(defn ^I32 fdt-w9-text [^:mut ^Cells nodes ^:mut ^Cells regions ^:mut ^Cells text]
  (comment "The lines of the W-9's first page that its widgets stand beside, with their real boxes (points times a hundred), in document order.")
  (fdt-par nodes regions text (text-blob "1 Name of entity/individual. An entry is required.") 6200 9700 57300 11400)
  (fdt-par nodes regions text (text-blob "2 Business name/disregarded entity name, if different from above.") 6200 13300 27400 14200)
  (fdt-par nodes regions text (text-blob "3a Check the appropriate box for federal tax classification") 6200 15700 44200 16600)
  (fdt-par nodes regions text (text-blob "4 Exemptions (codes apply only to") 45800 15800 56700 16700)
  (fdt-par nodes regions text (text-blob "Individual/sole proprietor") 8700 18000 16400 18800)
  (fdt-par nodes regions text (text-blob "C corporation") 19400 18000 23700 18800)
  (fdt-par nodes regions text (text-blob "S corporation") 26600 18000 30800 18800)
  (fdt-par nodes regions text (text-blob "Partnership") 33800 18000 37400 18800)
  (fdt-par nodes regions text (text-blob "Trust/estate") 40200 18000 44000 18800)
  (fdt-par nodes regions text (text-blob "Exempt payee code (if any)") 45800 19300 54000 20100)
  (fdt-par nodes regions text (text-blob "LLC. Enter the tax classification (C = C corporation, S = S corporation, P = Partnership)") 8600 19400 41000 20200)
  (fdt-par nodes regions text (text-blob "code (if any)") 45800 22800 49600 23600)
  (fdt-par nodes regions text (text-blob "Other (see instructions)") 8600 23000 15900 23800)
  (fdt-par nodes regions text (text-blob "3b If on line 3a you checked Partnership or Trust/estate") 6200 24600 43400 25500)
  (fdt-par nodes regions text (text-blob "this box if you have any foreign partners, owners, or beneficiaries. See instructions") 7400 26300 33800 27200)
  (fdt-par nodes regions text (text-blob ". . . .") 39600 26300 43400 27200)
  (fdt-par nodes regions text (text-blob "5 Address (number, street, and apt. or suite no.). See instructions.") 6200 27700 27300 28600)
  (fdt-par nodes regions text (text-blob "Requester's name and address (optional)") 39300 27700 52100 28600)
  (fdt-par nodes regions text (text-blob "6 City, state, and ZIP code") 6200 30100 15100 31000)
  (fdt-par nodes regions text (text-blob "7 List account number(s) here (optional)") 6200 32500 19100 33400)
  (fdt-par nodes regions text (text-blob "Social security number") 42200 36000 49800 36900)
  (fdt-par nodes regions text (text-blob "Enter your TIN in the appropriate box.") 3600 36400 40200 38300)
  (fdt-par nodes regions text (text-blob "-") 46600 37900 47000 38800)
  (fdt-par nodes regions text (text-blob "-") 50900 37900 51300 38800)
  (fdt-par nodes regions text (text-blob "Employer identification number") 42200 40800 52600 41700)
  (return 0))

(defn ^I32 fdt-w9-fields [^:mut ^Cells an ^:mut ^Cells txt]
  (comment "The W-9's widgets: the seven boxes of 3a and the box of 3b (all off but the first), and fifteen text fields, in the order of the file's page annotations.")
  (fdt-field an txt 4 -1 (text-blob "f1_15[0]") (text-blob "") (text-blob "") 46080 42000 56160 44400)
  (fdt-field an txt 4 -1 (text-blob "f1_01[0]") (text-blob "Ada Lovelace") (text-blob "") 5860 11800 57600 13200)
  (fdt-field an txt 4 -1 (text-blob "f1_02[0]") (text-blob "") (text-blob "") 5860 14200 57600 15600)
  (fdt-field an txt 4 -1 (text-blob "f1_05[0]") (text-blob "") (text-blob "") 54360 19200 57600 20400)
  (fdt-field an txt 4 -1 (text-blob "f1_06[0]") (text-blob "") (text-blob "") 50060 22800 57600 24000)
  (fdt-field an txt 4 -1 (text-blob "f1_09[0]") (text-blob "") (text-blob "") 38980 28600 57600 32400)
  (fdt-field an txt 4 -1 (text-blob "f1_10[0]") (text-blob "") (text-blob "") 5860 33400 57600 34800)
  (fdt-field an txt 4 -1 (text-blob "f1_11[0]") (text-blob "") (text-blob "") 41760 37200 46080 39600)
  (fdt-field an txt 4 -1 (text-blob "f1_12[0]") (text-blob "") (text-blob "") 47520 37200 50400 39600)
  (fdt-field an txt 4 -1 (text-blob "f1_13[0]") (text-blob "") (text-blob "") 51840 37200 57600 39600)
  (fdt-field an txt 4 -1 (text-blob "f1_14[0]") (text-blob "") (text-blob "") 41760 42000 44640 44400)
  (fdt-field an txt 4 -1 (text-blob "f1_07[0]") (text-blob "") (text-blob "") 5860 28600 38810 30000)
  (fdt-field an txt 4 -1 (text-blob "f1_08[0]") (text-blob "") (text-blob "") 5860 31000 38810 32400)
  (fdt-field an txt 2 1 (text-blob "c1_1[0]") (text-blob "") (text-blob "1") 7300 18020 8100 18820)
  (fdt-field an txt 2 0 (text-blob "c1_1[1]") (text-blob "") (text-blob "2") 18000 18020 18800 18820)
  (fdt-field an txt 2 0 (text-blob "c1_1[2]") (text-blob "") (text-blob "3") 25200 18020 26000 18820)
  (fdt-field an txt 2 0 (text-blob "c1_1[3]") (text-blob "") (text-blob "4") 32400 18020 33200 18820)
  (fdt-field an txt 2 0 (text-blob "c1_1[4]") (text-blob "") (text-blob "5") 38880 18020 39680 18820)
  (fdt-field an txt 2 0 (text-blob "c1_1[5]") (text-blob "") (text-blob "6") 7300 19350 8100 20150)
  (fdt-field an txt 4 -1 (text-blob "f1_03[0]") (text-blob "") (text-blob "") 41760 19200 44640 20300)
  (fdt-field an txt 2 0 (text-blob "c1_1[6]") (text-blob "") (text-blob "7") 7300 23000 8100 23800)
  (fdt-field an txt 4 -1 (text-blob "f1_04[0]") (text-blob "") (text-blob "") 16240 22800 44640 24000)
  (fdt-field an txt 2 0 (text-blob "c1_2[0]") (text-blob "") (text-blob "8") 44060 26300 44860 27100)
  (return 0))

(deftest test-the-w9s-eight-boxes-and-fifteen-text-fields-land-beside-their-labels
  (comment "The W-9's first page: each of the seven boxes of 3a is before the label to its right (the first is on, so it says so and its value is the export value), the")
  (comment "LLC box before the LLC line and the letter box after it (the label above it is nearer by 4 pt, the one to its left by 7.6: the left one stays), `Other` and its box,")
  (comment "the box of 3b after the line it ends (the dot leaders join them), the name field after the name label (it has a value), the address, the requester, the city, the account")
  (comment "number after their labels above them, the three boxes of the number after `Social security number` and the two of the EIN after theirs; and no field is left over.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-w9-text nodes regions text)
    (fdt-w9-fields an txt)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>1 Name of entity/individual. An entry is required.<span data-emon=\"field\" data-emon-name=\"f1_01[0]\" data-emon-type=\"text\">Ada Lovelace</span></p><p>2 Business name/disregarded entity name, if different from above.<span data-emon=\"field\" data-emon-name=\"f1_02[0]\" data-emon-type=\"text\"></span></p><p>3a Check the appropriate box for federal tax classification</p><p>4 Exemptions (codes apply only to</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[0]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"true\" aria-checked=\"true\" data-emon-value=\"1\"></span>Individual/sole proprietor</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[1]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"2\"></span>C corporation</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[2]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"3\"></span>S corporation</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[3]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"4\"></span>Partnership</p><p><span data-emon=\"field\" data-emon-name=\"c1_1[4]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"5\"></span>Trust/estate</p><p>Exempt payee code (if any)<span data-emon=\"field\" data-emon-name=\"f1_05[0]\" data-emon-type=\"text\"></span></p><p><span data-emon=\"field\" data-emon-name=\"c1_1[5]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"6\"></span>LLC. Enter the tax classification (C = C corporation, S = S corporation, P = Partnership)<span data-emon=\"field\" data-emon-name=\"f1_03[0]\" data-emon-type=\"text\"></span></p><p>code (if any)<span data-emon=\"field\" data-emon-name=\"f1_06[0]\" data-emon-type=\"text\"></span></p><p><span data-emon=\"field\" data-emon-name=\"c1_1[6]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"7\"></span>Other (see instructions)<span data-emon=\"field\" data-emon-name=\"f1_04[0]\" data-emon-type=\"text\"></span></p><p>3b If on line 3a you checked Partnership or Trust/estate</p><p>this box if you have any foreign partners, owners, or beneficiaries. See instructions<span data-emon=\"field\" data-emon-name=\"c1_2[0]\" data-emon-type=\"checkbox\" role=\"checkbox\" data-emon-checked=\"false\" aria-checked=\"false\" data-emon-value=\"8\"></span></p><p>. . . .</p><p>5 Address (number, street, and apt. or suite no.). See instructions.<span data-emon=\"field\" data-emon-name=\"f1_07[0]\" data-emon-type=\"text\"></span></p><p>Requester's name and address (optional)<span data-emon=\"field\" data-emon-name=\"f1_09[0]\" data-emon-type=\"text\"></span></p><p>6 City, state, and ZIP code<span data-emon=\"field\" data-emon-name=\"f1_08[0]\" data-emon-type=\"text\"></span></p><p>7 List account number(s) here (optional)<span data-emon=\"field\" data-emon-name=\"f1_10[0]\" data-emon-type=\"text\"></span></p><p>Social security number<span data-emon=\"field\" data-emon-name=\"f1_11[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_12[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_13[0]\" data-emon-type=\"text\"></span></p><p>Enter your TIN in the appropriate box.</p><p>-</p><p>-</p><p>Employer identification number<span data-emon=\"field\" data-emon-name=\"f1_14[0]\" data-emon-type=\"text\"></span><span data-emon=\"field\" data-emon-name=\"f1_15[0]\" data-emon-type=\"text\"></span></p></main></body></html>" "the W-9's fields")))

(deftest test-the-json-of-a-field-is-an-inline-with-its-widgets-box
  (comment "In the Model's JSON a field is an inline of its block, with no id: its name, type, value, whether it is on, the widget's box, `annot` and how far it is trusted; the block's text is")
  (comment "unchanged and its words are now a `text` inline beside the field.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells an (new-cells)
        ^Cells txt (new-cells)
        ^Cells nn (new-cells)
        ^Cells na (new-cells)
        ^Cells nr (new-cells)
        ^Cells nm (new-cells)
        ^Cells fc (new-cells)
        ^Cells fh (new-cells)
        ^Cells bt (new-cells)
        ^Cells sc (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Agree") 8700 18000 16400 18800)
    (fdt-field an txt 2 1 (text-blob "agree") (text-blob "") (text-blob "Yes") 7300 18020 8100 18820)
    (assert-eq (fl-run nodes attrs regions text nn na nr nm an txt fc fh bt sc) 4 "put in: the document, the paragraph, the field and its text")
    (js-emit out 0 nn na nr text pages ledger layout (new-cells) (new-cells))
    (assert-text out "{\"emon\":\"1.1\",\"settings\":{\"locale\":null},\"conf\":\"calibrated\",\"pages\":[],\"body\":{\"id\":0,\"kind\":\"document\",\"children\":[{\"id\":1,\"kind\":\"paragraph\",\"text\":\"Agree\",\"inlines\":[{\"kind\":\"field\",\"name\":\"agree\",\"type\":\"checkbox\",\"value\":\"Yes\",\"checked\":true,\"at\":[[1,73,180.2,81,188.2]],\"src\":[\"annot\"],\"conf\":950},{\"kind\":\"text\",\"text\":\"Agree\",\"src\":[\"text\"],\"conf\":815}],\"at\":[[1,87,180,164,188]]}]},\"furniture\":[],\"dropped\":[]}" "the JSON")))

(deftest test-a-labels-own-leaders-connect-its-field-past-the-nearer-row-above
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells an (new-cells) ^Cells txt (new-cells) ^Text out (new-text)]
    (comment "A form row's leader dots may already belong to the label paragraph. They still bridge the gap to its field: the wide previous row above must not take the next two fields.")
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "28 Taxable income") 5590 50591 47022 51545)
    (fdt-par nodes regions text (text-blob "29a Net operating loss deduction . . .") 5590 51791 37422 52745)
    (fdt-par nodes regions text (text-blob "b Special deductions . . .") 5590 52991 37422 53945)
    (fdt-field an txt 4 -1 (text-blob "loss") (text-blob "") (text-blob "") 41040 51600 48165 52800)
    (fdt-field an txt 4 -1 (text-blob "special") (text-blob "") (text-blob "") 41040 52800 48165 54000)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>28 Taxable income</p><p>29a Net operating loss deduction . . .<span data-emon=\"field\" data-emon-name=\"loss\" data-emon-type=\"text\"></span></p><p>b Special deductions . . .<span data-emon=\"field\" data-emon-name=\"special\" data-emon-type=\"text\"></span></p></main></body></html>" "each field belongs to its row's leader label")))


(deftest test-an-explicit-leader-label-beats-the-bare-row-number-beside-its-field
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells an (new-cells) ^Cells txt (new-cells) ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "29a Net loss . . .") 5590 51791 37422 52745)
    (fdt-par nodes regions text (text-blob "29a") 39285 51791 40634 52745)
    (fdt-field an txt 4 -1 (text-blob "loss") (text-blob "") (text-blob "") 41040 51600 48165 52800)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>29a Net loss . . .<span data-emon=\"field\" data-emon-name=\"loss\" data-emon-type=\"text\"></span></p><p>29a</p></main></body></html>" "the leader connects the descriptive label past its row number")))

(deftest test-unattached-printing-dots-are-not-form-paragraphs-and-do-not-drop-fields
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells an (new-cells) ^Cells txt (new-cells) ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob ". . . .") 7200 10000 16000 11200)
    (fdt-par nodes regions text (text-blob ".") 7200 11500 7400 12700)
    (fdt-par nodes regions text (text-blob "...") 7200 16000 7800 17200)
    (fdt-par nodes regions text (text-blob "Label") 7200 20000 16000 21200)
    (fdt-field an txt 4 -1 (text-blob "orphan") (text-blob "") (text-blob "") 50000 13000 56000 14200)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p><span data-emon=\"field\" data-emon-name=\"orphan\" data-emon-type=\"text\"></span></p><p>...</p><p>Label</p></main></body></html>" "printing leaders disappear, a meaningful ellipsis and the anchored field remain")))

(deftest test-an-empty-entry-cell-owns-its-widget-before-a-neighbour-label
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells an (new-cells) ^Cells txt (new-cells) ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (fdt-par nodes regions text (text-blob "Total") 1000 2000 2900 3000)
    (let [^I32 tb (node-new nodes (nk-table) 0)
          ^I32 rg (node-new nodes (nk-rowgroup) tb)
          ^I32 rw (node-new nodes (nk-row) rg)
          ^I32 c (node-new nodes (nk-cell) rw)]
      (node-set-sub nodes rg 2)
      (node-set-aux nodes c 1)
      (node-add-region nodes regions c 1 3000 2000 6000 3000))
    (fdt-field an txt 4 -1 (text-blob "gain") (text-blob "123.45") (text-blob "") 3200 2100 5800 2900)
    (fdt-html (test-t) nodes attrs regions text an txt out)
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>Total</p><table><tbody><tr><td><span data-emon=\"field\" data-emon-name=\"gain\" data-emon-type=\"text\">123.45</span></td></tr></tbody></table></main></body></html>" "the containing cell owns the named field and value exactly once")))
