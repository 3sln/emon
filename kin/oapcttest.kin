(ns emon.oapcttest
  (:require [emon.lang :refer [I32 Cells Bitmap BitmapSet]]
            [emon.test :refer [deftest assert-eq new-cells new-bitmap-set]]
            [emon.port :refer [cells-push cells-at cells-set cells-len bms-put bms-get bitmap-set-u8 bitmap-u8 bitmap-w bitmap-h]]
            [emon.evidence :refer [ow-new ow-set hd-x0 hd-x1 hd-y0 hd-y1 or-new or-set or-get orf-wfirst orf-wcount orf-pass ol-new ol-get lh-first lh-count ow-get owf-from ow-count hd-tstart op-arb]]
            [emon.oapct :refer [pct-rows pct-plan pct-fuse]]
            [emon.oacrop :refer [oa-three]]
            [emon.scan :refer [sc-prep sc-sel-base]]
            [kin.lang :refer [defn return let set while do < +]]))
(defn ^I32 pctt-words [^:mut ^Cells text ^:mut ^Cells words]
  (cells-push text 49)
  (cells-push text 48)
  (cells-push text 48)
  (ow-new words 1 100 100 130 120 100 120 130 120 0 0 0 3 0 900 -1)
  (cells-push text 49)
  (cells-push text 49)
  (cells-push text 48)
  (ow-new words 1 300 100 330 120 300 120 330 120 0 0 3 3 0 900 -1)
  (cells-push text 49)
  (cells-push text 48)
  (cells-push text 46)
  (cells-push text 48)
  (ow-new words 1 500 100 530 120 500 120 530 120 0 0 6 4 0 900 -1)
  (cells-push text 50)
  (cells-push text 48)
  (cells-push text 48)
  (ow-new words 1 100 140 130 160 100 160 130 160 0 0 10 3 0 900 -1)
  (cells-push text 50)
  (cells-push text 52)
  (cells-push text 48)
  (ow-new words 1 300 140 330 160 300 160 330 160 0 0 13 3 0 900 -1)
  (cells-push text 50)
  (cells-push text 48)
  (cells-push text 46)
  (cells-push text 48)
  (ow-new words 1 500 140 530 160 500 160 530 160 0 0 16 4 0 900 -1)
  (cells-push text 51)
  (cells-push text 48)
  (cells-push text 48)
  (ow-new words 1 100 180 130 200 100 200 130 200 0 0 20 3 0 900 -1)
  (cells-push text 51)
  (cells-push text 57)
  (cells-push text 48)
  (ow-new words 1 300 180 330 200 300 200 330 200 0 0 23 3 0 900 -1)
  (cells-push text 51)
  (cells-push text 48)
  (cells-push text 46)
  (cells-push text 48)
  (ow-new words 1 500 180 530 200 500 200 530 200 0 0 26 4 0 900 -1)
  (cells-push text 52)
  (cells-push text 48)
  (cells-push text 48)
  (ow-new words 1 100 220 130 240 100 240 130 240 0 0 30 3 0 900 -1)
  (cells-push text 53)
  (cells-push text 54)
  (cells-push text 48)
  (ow-new words 1 300 220 330 240 300 240 330 240 0 0 33 3 0 900 -1)
  (cells-push text 52)
  (cells-push text 48)
  (cells-push text 46)
  (cells-push text 48)
  (ow-new words 1 500 220 530 240 500 240 530 240 0 0 36 4 0 900 -1)
  (cells-push text 50)
  (cells-push text 48)
  (cells-push text 52)
  (cells-push text 53)
  (ow-new words 1 100 260 130 280 100 280 130 280 0 0 40 4 0 900 -1)
  (cells-push text 49)
  (cells-push text 57)
  (cells-push text 48)
  (cells-push text 51)
  (ow-new words 1 300 260 330 280 300 280 330 280 0 0 44 4 0 900 -1)
  (cells-push text 54)
  (cells-push text 46)
  (cells-push text 57)
  (ow-new words 1 500 260 530 280 500 280 530 280 0 0 48 3 0 900 -1)
  (return 0))

(deftest test-percent-family-requires-incumbent-support-before-a-crop
  (let [^Cells text (new-cells) ^Cells words (new-cells) ^Cells rows (new-cells)
        ^Cells plan (new-cells) ^Cells am (new-cells) ^Cells bm (new-cells) ^Cells pm (new-cells)]
    (pctt-words text words)
    (assert-eq (pct-rows words text 0 15 rows am bm pm) 5 "five complete geometric rows")
    (assert-eq (cells-at rows 3) 1 "first identity closes on incumbents")
    (assert-eq (cells-at rows 19) 0 "the positive sign fails the negative change")
    (assert-eq (pct-plan words rows plan) 4 "one supported failing cell gets a crop")
    (assert-eq (cells-at plan 0) 14 "only the failing percent slot")
    (assert-eq (cells-at plan 2) 4 "four incumbent identities support the family")
    (cells-set rows 3 0)
    (assert-eq (pct-plan words rows plan) 0 "three holds cannot authorize a crop")))

(deftest test-percent-crop-cap-holds-two-independently-supported-failing-slots
  (let [^Cells text (new-cells) ^Cells words (new-cells) ^Cells rows (new-cells)
        ^Cells proposal (new-cells) ^Cells am (new-cells) ^Cells bm (new-cells) ^Cells pm (new-cells)
        ^:mut ^I32 w 15 ^:mut ^I32 x 0]
    (pctt-words text words) (pctt-words text words)
    (while (< w 30)
      (do (set x (+ (ow-get words w (hd-x0)) 900)) (ow-set words w (hd-x0) x)
          (set x (+ (ow-get words w (hd-x1)) 900)) (ow-set words w (hd-x1) x)
          (set w (+ w 1))))
    (assert-eq (pct-rows words text 0 30 rows am bm pm) 10 "two complete five-row families")
    (assert-eq (pct-plan words rows proposal) 0 "two separately supported failures exceed this stage's one-crop cap")
    (assert-eq (cells-len proposal) 0 "a cap veto leaves no stale proposal")))

(deftest test-percent-family-cannot-borrow-support-across-uncovered-whitespace
  (let [^Cells text (new-cells) ^Cells words (new-cells) ^Cells rows (new-cells)
        ^Cells plan (new-cells) ^Cells am (new-cells) ^Cells bm (new-cells) ^Cells pm (new-cells)]
    (pctt-words text words)
    (ow-set words 12 (hd-y0) 500) (ow-set words 12 (hd-y1) 520)
    (ow-set words 13 (hd-y0) 500) (ow-set words 13 (hd-y1) 520)
    (ow-set words 14 (hd-y0) 500) (ow-set words 14 (hd-y1) 520)
    (assert-eq (pct-rows words text 0 15 rows am bm pm) 5 "all five rows remain complete")
    (assert-eq (pct-plan words rows plan) 0 "a separate open row has no established family")))

(deftest test-percent-closure-copies-only-the-verbatim-closing-slot
  (let [^Cells text (new-cells) ^Cells words (new-cells) ^Cells rows (new-cells)
        ^Cells plan (new-cells) ^Cells am (new-cells) ^Cells bm (new-cells) ^Cells pm (new-cells)
        ^Cells cm (new-cells) ^Cells candidates (new-cells) ^Cells runs (new-cells)
        ^Cells lines (new-cells) ^Cells scr (new-cells) ^Cells decisions (new-cells)]
    (pctt-words text words)
    (pct-rows words text 0 15 rows am bm pm) (pct-plan words rows plan)
    (cells-push plan 0) (cells-push plan 0) (cells-push plan 1) (cells-push plan 1)
    (let [^I32 start (cells-len text)]
      (cells-push text 45) (cells-push text 54) (cells-push text 46) (cells-push text 57)
      (ow-new words 1 500 260 530 280 500 280 530 280 0 1 start 4 0 800 -1)
      (or-new runs 1 0) (or-set runs 0 (orf-wfirst) 0) (or-set runs 0 (orf-wcount) 15)
      (or-new runs 1 0) (or-set runs 1 (orf-wfirst) 15) (or-set runs 1 (orf-wcount) 1)
      (ol-new lines 1 100 260 530 280 100 280 530 280 0 0 12 3)
      (sc-prep scr) (cells-set scr (sc-sel-base) 0)
      (assert-eq (pct-fuse 1 plan rows 1 text runs lines words scr 1 decisions candidates am bm pm cm) 1 "one selected line")
      (assert-eq (or-get runs 2 (orf-pass)) (op-arb) "arbitration provenance")
      (assert-eq (ow-count words) 19 "three output copies")
      (assert-eq (ow-get words 16 (owf-from)) 13 "first unchanged integer remains incumbent")
      (assert-eq (ow-get words 17 (owf-from)) 14 "second unchanged integer remains incumbent")
      (assert-eq (ow-get words 18 (owf-from)) 16 "percent copied from the recorded crop")
      (assert-eq (ow-get words 18 (hd-tstart)) start "verbatim source span")
      (assert-eq (cells-len decisions) 16 "one arithmetic decision")
      (assert-eq (cells-at decisions 9) 2 "percent rule")
      (assert-eq (cells-at decisions 13) 12 "identity names first source operand")
      (assert-eq (cells-at decisions 14) 13 "identity names second source operand")
      (assert-eq (cells-at decisions 15) 14 "identity names incumbent percent slot"))))

(deftest test-three-times-crop-filter-preserves-flat-gray-and-central-ink
  (let [^BitmapSet bms (new-bitmap-set) ^Bitmap src (bms-put bms 1 9 1 1)
        ^:mut ^I32 x 0]
    (while (< x 9) (do (bitmap-set-u8 src x 0 0 120) (set x (+ x 1))))
    (oa-three bms 2 3 src)
    (let [^Bitmap flat (bms-get bms 2)]
      (assert-eq (bitmap-w flat) 27 "integer x3 width")
      (assert-eq (bitmap-h flat) 3 "integer x3 height")
      (assert-eq (bitmap-u8 flat 13 1 0) 120 "normalized coefficients preserve flat gray"))
    (set x 0)
    (while (< x 9) (do (bitmap-set-u8 src x 0 0 255) (set x (+ x 1))))
    (bitmap-set-u8 src 4 0 0 0)
    (oa-three bms 4 5 src)
    (let [^Bitmap ink (bms-get bms 4)]
      (assert-eq (bitmap-u8 ink 13 1 0) 0 "source-center phase preserves black ink")
      (assert-eq (bitmap-u8 ink 12 1 0) 47 "independent Lanczos sample left of the central stroke")
      (assert-eq (bitmap-u8 ink 14 1 0) 47 "symmetric sample right of the central stroke"))))

(deftest test-percent-activation-does-not-repair-digits-on-a-sign-shaped-row
  (let [^Cells text (new-cells) ^Cells words (new-cells) ^Cells rows (new-cells)
        ^Cells proposal (new-cells) ^Cells am (new-cells) ^Cells bm (new-cells) ^Cells pm (new-cells)]
    (pctt-words text words)
    (cells-set text (+ (cells-len text) -1) 56)
    (assert-eq (pct-rows words text 0 15 rows am bm pm) 5 "five geometric rows remain")
    (assert-eq (cells-at rows 19) -1 "6.8 cannot be repaired by sign restoration")
    (assert-eq (pct-plan words rows proposal) 0 "no crop when the digits also need changing")))
