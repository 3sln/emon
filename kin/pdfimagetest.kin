;; Laws for PDF image pixels (P3.12; D117, D291-D293), on every target.
;;
;; THE CORPUS is test/assets/, written by `kin/scripts/asset-fixtures` (babashka): one PDF a case, and rows.txt, whose
;; expectations come from the generator's own implementation of SPEC 10.11 in exact (ratio) arithmetic, with poppler as
;; the second opinion on every case whose rules it shares (see the script). Here every target is held to the rows:
;;
;;   P name file obj pv         the JPEG passthrough verdict, and that the bytes kept are the file's own span (own cases)
;;   D name file obj orient crop fill w h channels alpha sha
;;                              kin's pixels (oriented, cut, with alpha) hash to the generator's SHA-256 of RGBA8
;;                              (obj `cN`: the first inline image of content stream N)
;;   R name file obj ...        the `decode-img` request a codec image plans, field by field, payload included
;;   O a b c d code            a placement matrix's orientation
;;   X name file obj class      a colour space kin does not read: class 9, and `pi-pixels` says so
;;   M name file n box...       the image placements `pc-document` makes (object and box in page space, skewed)
;;   I name file obj n          an inline image: its data span ends at its `EI`
;;
;; AND LAWS ABOUT HOW: the host's pixels (`pi-adopt`) take the place of samples, a 16-bit sample reduces by the stated
;; rule, a `decode-img` request round-trips through `emon.plan`'s readers, and a missing file part is zero.
(ns emon.pdfimagetest
  (:require [emon.lang :refer [I32 I64 Blob Src Cells Bitmap Buf i64 i32 add64]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that assert-that-at new-cells new-buf hex-blob
                               test-file test-file-span test-t Str TestT]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-drop cells-set cells-push src-of-blob cells-bytes
                               bitmap-new bitmap-w bitmap-h bitmap-channels bitmap-u8 bitmap-set-u8
                               buf-len buf-push buf-blob crypto-sha256]]
            [emon.pdfdoc :refer [pd-open pd-get pd-stream-data]]
            [emon.pdfcontent :refer [pc-document]]
            [emon.pdfimage :refer [pi-info pi-info-inline pi-samples pi-samples-inline pi-passthrough pi-pixels
                                   pi-orient pi-view pi-crop pi-adopt pi-request pi-get pi-out-w pi-out-h
                                   pi-out-channels pi-has-alpha pi-f-class pi-f-mkind pi-f-mobj pi-f-gobj
                                   pi-f-own pi-f-sstart pi-f-slen pi-f-dstart pi-f-dend pi-f-dnext pi-f-w pi-f-h
                                   pi-f-nf pi-f-codec pv-ok pv-exif]]
            [emon.plan :refer [rq-arg rq-nargs rec-count rec-kind rec-len pk-decode-img dq-filter dq-w dq-h dq-comps
                               dq-bpc dq-k dq-columns dq-rows dq-ccitt dq-where dq-offset dq-length dq-sha
                               dq-gwhere dq-goffset dq-glength dq-gsha dq-nargs rec-check]]
            [emon.fx :refer [fx-muldiv]]
            [emon.evidence :refer [im-count im-get mf-obj mf-x0 mf-y0 mf-x1 mf-y1 mf-skewed]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem bit-and]]))

;; ------------------------------------------------------------ row helpers

(defn ^I32 it-nl [^Blob b ^I32 i]
  (let [^:mut ^I32 k i]
    (while (and (< k (blob-len b)) (!= (blob-u8 b k) 10))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 it-tab [^Blob b ^I32 i ^I32 lim]
  (comment "Index of the next tab in [i, lim), or lim.")
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 9))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 it-start [^Blob b ^I32 pos ^I32 e ^I32 n]
  (comment "Where the n-th (0-based) tab-separated field of the row [pos, e) starts.")
  (let [^:mut ^I32 p pos
        ^:mut ^I32 k 0]
    (while (< k n)
      (do (set p (+ (it-tab b p e) 1))
          (set k (+ k 1))))
    (return p)))

(defn ^I32 it-end [^Blob b ^I32 start ^I32 e]
  (return (it-tab b start e)))

(defn ^I32 it-dec [^Blob b ^I32 from ^I32 to]
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0
        ^:mut ^I32 neg 0]
    (if (and (< k to) (== (blob-u8 b k) 45))
      (do (set neg 1) (set k (+ k 1))))
    (while (< k to)
      (do (set v (+ (* v 10) (- (blob-u8 b k) 48)))
          (set k (+ k 1))))
    (if (== neg 1) (return (- 0 v)))
    (return v)))

(defn ^I32 it-int [^Blob b ^I32 pos ^I32 e ^I32 n]
  (let [^I32 s (it-start b pos e n)]
    (return (it-dec b s (it-end b s e)))))

(defn ^I32 it-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (return -1))

(defn ^I32 it-comma [^Blob b ^I32 i ^I32 lim]
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 44))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 it-cint [^Blob b ^I32 from ^I32 to ^I32 n]
  (comment "The n-th comma-separated integer of b[from, to).")
  (let [^:mut ^I32 p from
        ^:mut ^I32 k 0]
    (while (< k n)
      (do (set p (+ (it-comma b p to) 1))
          (set k (+ k 1))))
    (return (it-dec b p (it-comma b p to)))))

(defn ^I32 it-hex-eq [^Cells c ^Blob b ^I32 from ^I32 to]
  (comment "1 when the bytes in `c` are exactly the hex in b[from, to).")
  (let [^:mut ^I32 i 0]
    (if (!= (cells-len c) (quot (- to from) 2)) (return 0))
    (while (< i (cells-len c))
      (do (if (!= (cells-at c i) (+ (* (it-hexval (blob-u8 b (+ from (* i 2)))) 16)
                                    (it-hexval (blob-u8 b (+ from (+ (* i 2) 1))))))
            (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 it-word-bytes [^Cells rq ^I32 at ^I32 first ^:mut ^Cells out]
  (comment "Eight request words (big-endian) as 32 byte cells.")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 w 0
        ^:mut ^I64 u (i64 0)]
    (cells-drop out 0)
    (while (< i 8)
      (do (set w (rq-arg rq at (+ first i)))
          (set u (i64 w))
          (if (< w 0) (set u (add64 u (i64 4294967296))))
          (cells-push out (i32 (rem (quot u (i64 16777216)) (i64 256))))
          (cells-push out (i32 (rem (quot u (i64 65536)) (i64 256))))
          (cells-push out (i32 (rem (quot u (i64 256)) (i64 256))))
          (cells-push out (i32 (rem u (i64 256))))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 it-words-zero [^Cells rq ^I32 at ^I32 first]
  (let [^:mut ^I32 i 0]
    (while (< i 8)
      (do (if (!= (rq-arg rq at (+ first i)) 0) (return 0))
          (set i (+ i 1))))
    (return 1)))

;; ------------------------------------------------------------ the document

(defn ^I32 it-find-bi [^Cells cs]
  (comment "The index just after the first `BI` operator of a content stream, or -1.")
  (let [^I32 n (cells-len cs)
        ^:mut ^I32 p 0]
    (while (< (+ p 2) n)
      (do (if (and (== (cells-at cs p) 66)
                   (and (== (cells-at cs (+ p 1)) 73)
                        (or (== (cells-at cs (+ p 2)) 32) (== (cells-at cs (+ p 2)) 10))))
            (return (+ p 2)))
          (set p (+ p 1))))
    (return -1)))

(defn ^I32 it-fill-bitmap [^Bitmap b ^I32 seed]
  (comment "A deterministic picture: the byte of (x, y, channel).")
  (let [^:mut ^I32 x 0
        ^:mut ^I32 y 0
        ^:mut ^I32 c 0]
    (while (< y (bitmap-h b))
      (do (set x 0)
          (while (< x (bitmap-w b))
            (do (set c 0)
                (while (< c (bitmap-channels b))
                  (do (bitmap-set-u8 b x y c (rem (+ (+ (* x 37) (* y 91)) (+ (* c 53) seed)) 256))
                      (set c (+ c 1))))
                (set x (+ x 1))))
          (set y (+ y 1))))
    (return 0)))

(defn ^I32 it-hash [^Bitmap out ^Bitmap al ^:mut ^Buf bf ^:mut ^Cells h]
  (comment "SHA-256 of the RGBA8 row-major bytes of the colour and alpha bitmaps (a gray is r = g = b) into `h`.")
  (let [^:mut ^I32 x 0
        ^:mut ^I32 y 0
        ^:mut ^I32 r 0]
    (cells-drop h 0)
    (while (< y (bitmap-h out))
      (do (set x 0)
          (while (< x (bitmap-w out))
            (do (set r (bitmap-u8 out x y 0))
                (buf-push bf r)
                (if (== (bitmap-channels out) 1)
                  (do (buf-push bf r)
                      (buf-push bf r))
                  (do (buf-push bf (bitmap-u8 out x y 1))
                      (buf-push bf (bitmap-u8 out x y 2))))
                (buf-push bf (bitmap-u8 al x y 0))
                (set x (+ x 1))))
          (set y (+ y 1))))
    (crypto-sha256 (buf-blob bf) 0 (buf-len bf) h)
    (return 0)))

;; ------------------------------------------------------------ D rows

(defn ^I32 it-d [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "D name file obj orient crop fill w h channels alpha sha")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells mi (new-cells)
        ^Cells smp (new-cells)
        ^Cells msmp (new-cells)
        ^Cells cs (new-cells)
        ^Cells h (new-cells)
        ^Buf bf (new-buf)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 os (it-start rows pos e 3)
        ^I32 oe (it-end rows os e)
        ^I32 orient (it-int rows pos e 4)
        ^I32 cr (it-start rows pos e 5)
        ^I32 cre (it-end rows cr e)
        ^I32 fill (it-int rows pos e 6)
        ^I32 hs (it-start rows pos e 11)
        ^:mut ^I32 have 0
        ^:mut ^I32 st1 0
        ^:mut ^I32 sh 0
        ^:mut ^I32 msh 0
        ^:mut ^I32 mobj 0
        ^:mut ^I32 num 0
        ^:mut ^I32 from 0]
    (let [^Src src (src-of-blob (test-file-span rows fs fe))]
      (assert-eq-at (pd-open src ar dc a b st) 0 "the file opens" line)
      (if (== (blob-u8 rows os) 99)
        (do (comment "an inline image of the content stream whose object number follows `c`")
            (set sh (pd-get src ar dc a b st (it-dec rows (+ os 1) oe)))
            (pd-stream-data src ar dc a b st sh cs)
            (set from (it-find-bi cs))
            (assert-that-at (>= from 0) "the content stream has an inline image" line)
            (assert-eq-at (pi-info-inline src ar dc a b st out im cs from (cells-len cs)) 0 "the inline image is read" line)
            (assert-eq-at (pi-samples-inline im cs b st smp) 0 "its samples decode" line))
        (do (set num (it-dec rows os oe))
            (set sh (pd-get src ar dc a b st num))
            (assert-eq-at (pi-info src ar dc a b st out im sh num) 0 "the image is read" line)
            (if (or (== (pi-get im (pi-f-mkind)) 2) (== (pi-get im (pi-f-mkind)) 3))
              (do (set have 1)
                  (set mobj (pi-get im (pi-f-mobj)))
                  (set msh (pd-get src ar dc a b st mobj))
                  (assert-eq-at (pi-info src ar dc a b st out mi msh mobj) 0 "the mask is read" line)
                  (assert-eq-at (pi-samples src ar dc a b st mi msh msmp) 0 "the mask's samples decode" line)))
            (assert-eq-at (pi-samples src ar dc a b st im sh smp) 0 "the samples decode" line)))
      (pi-view im orient)
      (if (!= (blob-u8 rows cr) 45)
        (pi-crop im (it-cint rows cr cre 0) (it-cint rows cr cre 1) (it-cint rows cr cre 2) (it-cint rows cr cre 3)
                 (it-cint rows cr cre 4) (it-cint rows cr cre 5) (it-cint rows cr cre 6) (it-cint rows cr cre 7)
                 (it-cint rows cr cre 8)))
      (assert-eq-at (pi-out-w im) (it-int rows pos e 7) "the width" line)
      (assert-eq-at (pi-out-h im) (it-int rows pos e 8) "the height" line)
      (assert-eq-at (pi-out-channels im) (it-int rows pos e 9) "the colour channels" line)
      (assert-eq-at (pi-has-alpha im) (it-int rows pos e 10) "alpha or none" line)
      (let [^Bitmap pic (bitmap-new (pi-out-w im) (pi-out-h im) (pi-out-channels im))
            ^Bitmap al (bitmap-new (pi-out-w im) (pi-out-h im) 1)]
        (set st1 (pi-pixels im smp pic mi msmp pic have fill pic al))
        (assert-eq-at st1 0 "the pixels are made" line)
        (it-hash pic al bf h)
        (assert-that-at (== (it-hex-eq h rows hs (it-end rows hs e)) 1) "the RGBA8 hash is the generator's" line)))
    (return 0)))

;; ------------------------------------------------------------ P rows

(defn ^I32 it-p [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "P name file obj pv")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells data (new-cells)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 num (it-int rows pos e 3)
        ^I32 want (it-int rows pos e 4)
        ^:mut ^I32 sh 0
        ^:mut ^I32 i 0
        ^:mut ^I32 same 1]
    (let [^Src src (src-of-blob (test-file-span rows fs fe))]
      (assert-eq-at (pd-open src ar dc a b st) 0 "the file opens" line)
      (set sh (pd-get src ar dc a b st num))
      (assert-eq-at (pi-info src ar dc a b st out im sh num) 0 "the image is read" line)
      (assert-eq-at (pi-samples src ar dc a b st im sh data) 1 "a DCT chain ends at the codec" line)
      (assert-eq-at (pi-passthrough im data) want "the passthrough verdict" line)
      (if (== want 0)
        (do (comment "what passes through is JPEG, and when it is the input's own it is that span, byte for byte")
            (assert-eq-at (cells-at data 0) 255 "SOI" line)
            (assert-eq-at (cells-at data 1) 216 "SOI" line)
            (if (== (pi-get im (pi-f-own)) 1)
              (do (assert-eq-at (cells-len data) (pi-get im (pi-f-slen)) "the span's length" line)
                  (while (< i (cells-len data))
                    (do (if (!= (cells-at data i) (blob-u8 (test-file-span rows fs fe) (+ (pi-get im (pi-f-sstart)) i)))
                          (set same 0))
                        (set i (+ i 1))))
                  (assert-eq-at same 1 "an own JPEG is the file's bytes" line)))))
      (return 0))))

;; ------------------------------------------------------------ R rows

(defn ^I32 it-r [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "R name file obj filter w h comps bpc k cols rows cflags where off len gwhere goff glen sha gsha")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells data (new-cells)
        ^Cells glob (new-cells)
        ^Cells rq (new-cells)
        ^Cells tmp (new-cells)
        ^Cells words (new-cells)
        ^Cells wb (new-cells)
        ^Buf payload (new-buf)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 num (it-int rows pos e 3)
        ^I32 shs (it-start rows pos e 19)
        ^I32 gss (it-start rows pos e 20)
        ^:mut ^I32 sh 0
        ^:mut ^I32 gsh 0
        ^:mut ^I32 want-payload 0]
    (let [^Src src (src-of-blob (test-file-span rows fs fe))]
      (assert-eq-at (pd-open src ar dc a b st) 0 "the file opens" line)
      (set sh (pd-get src ar dc a b st num))
      (assert-eq-at (pi-info src ar dc a b st out im sh num) 0 "the image is read" line)
      (assert-eq-at (pi-samples src ar dc a b st im sh data) 1 "an image codec ends the chain" line)
      (if (!= (pi-get im (pi-f-gobj)) 0)
        (do (set gsh (pd-get src ar dc a b st (pi-get im (pi-f-gobj))))
            (pd-stream-data src ar dc a b st gsh glob)))
      (assert-eq-at (pi-request rq 7 0 im data glob payload tmp words) 0 "the request is planned" line)
      (assert-eq-at (rec-count rq) 1 "one record" line)
      (assert-eq-at (rec-kind rq 0) (pk-decode-img) "kind 6" line)
      (assert-eq-at (rec-check rq 6 6) 0 "the record is well formed" line)
      (assert-eq-at (rq-nargs rq 0) (dq-nargs) "31 arguments" line)
      (assert-eq-at (rq-arg rq 0 (dq-filter)) (it-int rows pos e 4) "filter" line)
      (assert-eq-at (rq-arg rq 0 (dq-w)) (it-int rows pos e 5) "w" line)
      (assert-eq-at (rq-arg rq 0 (dq-h)) (it-int rows pos e 6) "h" line)
      (assert-eq-at (rq-arg rq 0 (dq-comps)) (it-int rows pos e 7) "comps" line)
      (assert-eq-at (rq-arg rq 0 (dq-bpc)) (it-int rows pos e 8) "bpc" line)
      (assert-eq-at (rq-arg rq 0 (dq-k)) (it-int rows pos e 9) "k" line)
      (assert-eq-at (rq-arg rq 0 (dq-columns)) (it-int rows pos e 10) "columns" line)
      (assert-eq-at (rq-arg rq 0 (dq-rows)) (it-int rows pos e 11) "rows" line)
      (assert-eq-at (rq-arg rq 0 (dq-ccitt)) (it-int rows pos e 12) "ccitt flags" line)
      (assert-eq-at (rq-arg rq 0 (dq-where)) (it-int rows pos e 13) "where" line)
      (assert-eq-at (rq-arg rq 0 (dq-offset)) (it-int rows pos e 14) "offset" line)
      (assert-eq-at (rq-arg rq 0 (dq-length)) (it-int rows pos e 15) "length" line)
      (assert-eq-at (rq-arg rq 0 (dq-gwhere)) (it-int rows pos e 16) "gwhere" line)
      (assert-eq-at (rq-arg rq 0 (dq-goffset)) (it-int rows pos e 17) "goffset" line)
      (assert-eq-at (rq-arg rq 0 (dq-glength)) (it-int rows pos e 18) "glength" line)
      (if (== (blob-u8 rows shs) 45)
        (assert-that-at (== (it-words-zero rq 0 (dq-sha)) 1) "an input's span has a zero SHA" line)
        (do (it-word-bytes rq 0 (dq-sha) wb)
            (assert-that-at (== (it-hex-eq wb rows shs (it-end rows shs e)) 1) "the payload's SHA-256" line)
            (set want-payload (it-int rows pos e 15))))
      (if (== (blob-u8 rows gss) 45)
        (assert-that-at (== (it-words-zero rq 0 (dq-gsha)) 1) "no globals: a zero SHA" line)
        (do (it-word-bytes rq 0 (dq-gsha) wb)
            (assert-that-at (== (it-hex-eq wb rows gss (it-end rows gss e)) 1) "the globals' SHA-256" line)
            (set want-payload (+ want-payload (it-int rows pos e 18)))))
      (assert-eq-at (buf-len payload) want-payload "the payload holds the kin-made bytes and nothing else" line)
      (return 0))))

;; ------------------------------------------------------------ O, X, I rows

(defn ^I32 it-o [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "O a b c d code (the matrix times 1000)")
  (assert-eq-at (pi-orient (fx-muldiv (i64 (it-int rows pos e 1)) (i64 16777216) (i64 1000))
                           (fx-muldiv (i64 (it-int rows pos e 2)) (i64 16777216) (i64 1000))
                           (fx-muldiv (i64 (it-int rows pos e 3)) (i64 16777216) (i64 1000))
                           (fx-muldiv (i64 (it-int rows pos e 4)) (i64 16777216) (i64 1000)))
                (it-int rows pos e 5) "the orientation of the matrix" line)
  (return 0))

(defn ^I32 it-x [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "X name file obj class")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 num (it-int rows pos e 3)
        ^:mut ^I32 sh 0]
    (let [^Src src (src-of-blob (test-file-span rows fs fe))]
      (assert-eq-at (pd-open src ar dc a b st) 0 "the file opens" line)
      (set sh (pd-get src ar dc a b st num))
      (assert-eq-at (pi-info src ar dc a b st out im sh num) 0 "the image is read" line)
      (assert-eq-at (pi-get im (pi-f-class)) (it-int rows pos e 4) "the colour class" line)
      (pi-samples src ar dc a b st im sh smp)
      (pi-view im 0)
      (let [^Bitmap pic (bitmap-new 1 1 3)
            ^Bitmap al (bitmap-new 1 1 1)]
        (assert-eq-at (pi-pixels im smp pic dmi dms pic 0 0 pic al) 1 "a colour space that is not read gives no pixels" line)))
    (return 0)))

(defn ^I32 it-i [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "I name file obj n: the inline image's data ends where `EI` stands")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells cs (new-cells)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 num (it-int rows pos e 3)
        ^:mut ^I32 from 0
        ^:mut ^I32 sh 0
        ^:mut ^I32 nx 0]
    (let [^Src src (src-of-blob (test-file-span rows fs fe))]
      (assert-eq-at (pd-open src ar dc a b st) 0 "the file opens" line)
      (set sh (pd-get src ar dc a b st num))
      (pd-stream-data src ar dc a b st sh cs)
      (set from (it-find-bi cs))
      (assert-eq-at (pi-info-inline src ar dc a b st out im cs from (cells-len cs)) 0 "the inline image is read" line)
      (set nx (pi-get im (pi-f-dnext)))
      (assert-eq-at (cells-at cs (- nx 2)) 69 "E" line)
      (assert-eq-at (cells-at cs (- nx 1)) 73 "I" line)
      (assert-that-at (< (pi-get im (pi-f-dstart)) (pi-get im (pi-f-dend))) "the data is not empty" line)
      (assert-that-at (<= (pi-get im (pi-f-dend)) (- nx 2)) "the data ends at or before the EI" line))
    (return 0)))

;; ------------------------------------------------------------ M rows

(defn ^I32 it-doc [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                   ^:mut ^Cells cx ^:mut ^Cells ox ^:mut ^Cells cs ^:mut ^Cells out
                   ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                   ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt ^:mut ^Cells pg
                   ^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx]
  (let [^I32 o (pd-open src ar dc a b st)]
    (if (!= o 0) (return (+ 100 o)))
    (return (pc-document src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx))))

(defn ^I32 it-m [^TestT emon-t ^Blob rows ^I32 pos ^I32 e ^I32 line]
  (comment "M name file n obj,x0,y0,x1,y1,skewed ... : the placements, in the order the content draws them")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells cx (new-cells)
        ^Cells ox (new-cells)
        ^Cells cs (new-cells)
        ^Cells out (new-cells)
        ^Cells f0 (new-cells)
        ^Cells f1 (new-cells)
        ^Cells f2 (new-cells)
        ^Cells f3 (new-cells)
        ^Cells gl (new-cells)
        ^Cells et (new-cells)
        ^Cells mk (new-cells)
        ^Cells fnt (new-cells)
        ^Cells pg (new-cells)
        ^Cells wd (new-cells)
        ^Cells ln (new-cells)
        ^Cells pa (new-cells)
        ^Cells im (new-cells)
        ^Cells pts (new-cells)
        ^Cells gx (new-cells)
        ^I32 fs (it-start rows pos e 2)
        ^I32 fe (it-end rows fs e)
        ^I32 n (it-int rows pos e 3)
        ^:mut ^I32 k 0
        ^:mut ^I32 p 0
        ^:mut ^I32 q 0]
    (assert-eq-at (it-doc (src-of-blob (test-file-span rows fs fe)) ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg
                          wd ln pa im pts gx) 0 "the page runs" line)
    (assert-eq-at (im-count im) n "the number of placements" line)
    (if (== (im-count im) n)
      (while (< k n)
        (do (set p (it-start rows pos e (+ 4 k)))
            (set q (it-end rows p e))
            (assert-eq-at (im-get im k (mf-obj)) (it-cint rows p q 0) "the image object" line)
            (assert-eq-at (im-get im k (mf-x0)) (it-cint rows p q 1) "x0 in page space" line)
            (assert-eq-at (im-get im k (mf-y0)) (it-cint rows p q 2) "y0 in page space" line)
            (assert-eq-at (im-get im k (mf-x1)) (it-cint rows p q 3) "x1 in page space" line)
            (assert-eq-at (im-get im k (mf-y1)) (it-cint rows p q 4) "y1 in page space" line)
            (assert-eq-at (im-get im k (mf-skewed)) (it-cint rows p q 5) "skewed" line)
            (set k (+ k 1)))))
    (return 0)))

;; ------------------------------------------------------------ the corpus

(defn ^I32 it-rows [^TestT emon-t ^Blob rows]
  (comment "Check every row; answers how many were checked.")
  (let [^I32 n (blob-len rows)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 e 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 checked 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (it-nl rows pos))
          (if (and (< pos e) (!= (blob-u8 rows pos) 35))
            (do (set kind (blob-u8 rows pos))
                (set checked (+ checked 1))
                (if (== kind 68) (it-d emon-t rows pos e line))
                (if (== kind 80) (it-p emon-t rows pos e line))
                (if (== kind 82) (it-r emon-t rows pos e line))
                (if (== kind 79) (it-o emon-t rows pos e line))
                (if (== kind 88) (it-x emon-t rows pos e line))
                (if (== kind 73) (it-i emon-t rows pos e line))
                (if (== kind 77) (it-m emon-t rows pos e line))))
          (set pos (+ e 1))))
    (return checked)))

(deftest test-asset-rows
  (assert-that (> (it-rows (test-t) (test-file "assets/rows.txt")) 100) "every row of test/assets/rows.txt is checked"))

;; ------------------------------------------------------------ laws about how

(defn ^I32 it-paint [^I32 v]
  (comment "A bilevel host pixel (here any byte): 0 paints, anything on the high side does not (1-bit: v >> 7).")
  (if (< v 128) (return 255))
  (return 0))

(deftest test-host-pixels-take-the-samples-place
  (comment "A stencil whose pixels the host decoded (a CCITT mask): 0 paints, in the fill colour; the rest is clear.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/ccitt-g4-mask.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (pi-adopt im 64 32 1)
    (pi-view im 0)
    (let [^Bitmap host (bitmap-new 64 32 1)
          ^Bitmap pic (bitmap-new 64 32 3)
          ^Bitmap al (bitmap-new 64 32 1)]
      (it-fill-bitmap host 0)
      (assert-eq (pi-pixels im smp host dmi dms host 0 11259375 pic al) 0 "the pixels are made")
      (assert-eq (bitmap-u8 al 3 2 0) (it-paint (bitmap-u8 host 3 2 0)) "alpha follows the host's pixel")
      (assert-eq (bitmap-u8 al 40 20 0) (it-paint (bitmap-u8 host 40 20 0)) "alpha follows the host's pixel (2)")
      (assert-eq (bitmap-u8 pic 3 2 0) 171 "the fill colour, red")
      (assert-eq (bitmap-u8 pic 3 2 1) 205 "the fill colour, green")
      (assert-eq (bitmap-u8 pic 3 2 2) 239 "the fill colour, blue"))))

(deftest test-host-pixels-keep-an-rgb-decode
  (comment "A DCT image with /Decode [1 0 1 0 1 0] the host decoded to RGB: the inversion is kin's.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/dct-decode.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (pi-adopt im 24 16 3)
    (pi-view im 0)
    (let [^Bitmap host (bitmap-new 24 16 3)
          ^Bitmap pic (bitmap-new 24 16 3)
          ^Bitmap al (bitmap-new 24 16 1)]
      (it-fill-bitmap host 7)
      (assert-eq (pi-pixels im smp host dmi dms host 0 0 pic al) 0 "the pixels are made")
      (assert-eq (bitmap-u8 pic 5 4 0) (- 255 (bitmap-u8 host 5 4 0)) "red is inverted")
      (assert-eq (bitmap-u8 pic 5 4 1) (- 255 (bitmap-u8 host 5 4 1)) "green is inverted")
      (assert-eq (bitmap-u8 pic 23 15 2) (- 255 (bitmap-u8 host 23 15 2)) "blue is inverted")
      (assert-eq (bitmap-u8 al 5 4 0) 255 "no alpha"))))

(deftest test-host-pixels-of-a-cmyk-jpeg-are-rgb-as-they-are
  (comment "A 4-component DCT arrives as RGB (the host honoured Adobe's marker): kin applies no /Decode and no CMYK rule.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/dct-cmyk.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (assert-eq (pi-get im (pi-f-class)) 3 "the dictionary says CMYK")
    (pi-adopt im 24 16 3)
    (assert-eq (pi-get im (pi-f-class)) 2 "the pixels are RGB")
    (pi-view im 0)
    (let [^Bitmap host (bitmap-new 24 16 3)
          ^Bitmap pic (bitmap-new 24 16 3)
          ^Bitmap al (bitmap-new 24 16 1)]
      (it-fill-bitmap host 99)
      (assert-eq (pi-pixels im smp host dmi dms host 0 0 pic al) 0 "the pixels are made")
      (assert-eq (bitmap-u8 pic 7 9 0) (bitmap-u8 host 7 9 0) "red as the host made it")
      (assert-eq (bitmap-u8 pic 7 9 2) (bitmap-u8 host 7 9 2) "blue as the host made it"))))

(deftest test-a-sixteen-bit-sample-reduces-by-the-stated-rule
  (comment "(v * 255 + 32767) / 65535: 0 -> 0, 128 -> 0, 129 -> 1, 32767 -> 127, 32768 -> 128, 65535 -> 255.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/flate-rgb16.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (assert-eq (pi-get im (pi-f-w)) 17 "its width")
    (assert-eq (pi-get im (pi-f-h)) 11 "its height")
    (assert-eq (pi-samples src ar dc a b st im sh smp) 0 "the samples decode")
    (assert-eq (cells-len smp) (* (* 17 11) 6) "six bytes a pixel")
    (let [^:mut ^I32 i 0]
      (while (< i 6)
        (do (cells-set smp i 0)
            (set i (+ i 1))))
      (cells-set smp 0 0)
      (cells-set smp 1 128)
      (cells-set smp 2 0)
      (cells-set smp 3 129)
      (cells-set smp 4 127)
      (cells-set smp 5 255)
      (pi-view im 0)
      (let [^Bitmap pic (bitmap-new 17 11 3)
            ^Bitmap al (bitmap-new 17 11 1)]
        (assert-eq (pi-pixels im smp pic dmi dms pic 0 0 pic al) 0 "the pixels are made")
        (assert-eq (bitmap-u8 pic 0 0 0) 0 "0 is 0")
        (assert-eq (bitmap-u8 pic 0 0 1) 1 "129 is 1")
        (assert-eq (bitmap-u8 pic 0 0 2) 127 "32767 is 127")))))

(deftest test-a-short-stream-reads-zero
  (comment "D030: a damaged stream still yields what could be read; what is missing is 0.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/gray8.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (assert-eq (pi-samples src ar dc a b st im sh smp) 0 "the samples decode")
    (cells-drop smp 20)
    (pi-view im 0)
    (let [^Bitmap pic (bitmap-new 17 11 1)
          ^Bitmap al (bitmap-new 17 11 1)]
      (assert-eq (pi-pixels im smp pic dmi dms pic 0 0 pic al) 0 "the pixels are made")
      (assert-eq (bitmap-u8 pic 16 10 0) 0 "past the end of the data")
      (assert-eq (bitmap-u8 pic 16 5 0) 0 "past the end of the data (2)"))))

(deftest test-the-wrong-sized-bitmap-is-refused
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells smp (new-cells)
        ^Cells dmi (new-cells)
        ^Cells dms (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/gray8.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (assert-eq (pi-samples src ar dc a b st im sh smp) 0 "the samples decode")
    (pi-view im 0)
    (let [^Bitmap pic (bitmap-new 16 11 1)
          ^Bitmap al (bitmap-new 17 11 1)]
      (assert-eq (pi-pixels im smp pic dmi dms pic 0 0 pic al) 2 "a colour bitmap of the wrong width is answer 2"))))

;; ------------------------------------------------------------ the marker walk, by hand

(defn ^I32 it-hex-cells [^Blob b ^:mut ^Cells c]
  (comment "The bytes of a `hex-blob` as one cell each.")
  (let [^:mut ^I32 i 0]
    (cells-drop c 0)
    (while (< i (blob-len b))
      (do (cells-push c (blob-u8 b i))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 it-verdict [^TestT emon-t ^Cells im ^Cells data ^Blob hex ^I32 want ^I32 line]
  (comment "`pi-passthrough` of a hand-made JPEG (the record is a 24 x 16 DeviceRGB DCT image's).")
  (it-hex-cells hex data)
  (assert-eq-at (pi-passthrough im data) want "the verdict of the marker walk" line)
  (return 0))

(deftest test-the-marker-walk-decides-passthrough
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells data (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/dct-rgb.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (comment "baseline, progressive, with fill bytes before the marker")
    (it-verdict (test-t) im data (hex-blob "ffd8ffc00011080010001803011100021101031101ffd9") 0 1)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc20011080010001803011100021101031101ffd9") 0 2)
    (it-verdict (test-t) im data (hex-blob "ffd8ffffffc00011080010001803011100021101031101ffd9") 0 3)
    (comment "lossless and hierarchical: SOF3, SOF5, SOF7 (reason 5); arithmetic: SOF9, SOF10, SOF11, SOF13, SOF15 (reason 4)")
    (it-verdict (test-t) im data (hex-blob "ffd8ffc30011080010001803011100021101031101ffd9") 5 4)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc50011080010001803011100021101031101ffd9") 5 5)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc70011080010001803011100021101031101ffd9") 5 6)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc90011080010001803011100021101031101ffd9") 4 7)
    (it-verdict (test-t) im data (hex-blob "ffd8ffca0011080010001803011100021101031101ffd9") 4 8)
    (it-verdict (test-t) im data (hex-blob "ffd8ffcb0011080010001803011100021101031101ffd9") 4 9)
    (it-verdict (test-t) im data (hex-blob "ffd8ffcd0011080010001803011100021101031101ffd9") 4 10)
    (it-verdict (test-t) im data (hex-blob "ffd8ffcf0011080010001803011100021101031101ffd9") 4 11)
    (comment "components: 2 and 4 are not 1 or 3, and 1 is not DeviceRGB's; precision 12; a size that is not the dictionary's")
    (it-verdict (test-t) im data (hex-blob "ffd8ffc0000e080010001802011100021101ffd9") 6 12)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc00014080010001804011100021101031101041101ffd9") 6 13)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc0000b080010001801011100ffd9") 6 14)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc000110c0010001803011100021101031101ffd9") 7 15)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc00011080010001903011100021101031101ffd9") 15 16)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc00011080011001803011100021101031101ffd9") 15 17)
    (comment "no SOF, no SOI, a segment longer than the data, a stray byte where a marker belongs")
    (it-verdict (test-t) im data (hex-blob "ffd8ffd9") 3 18)
    (it-verdict (test-t) im data (hex-blob "0000ffc00011080010001803011100021101031101ffd9") 3 19)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc00011") 3 20)
    (it-verdict (test-t) im data (hex-blob "ffd8ffc000ff0800100018") 3 21)
    (it-verdict (test-t) im data (hex-blob "ffd800ffffc00011080010001803011100021101031101ffd9") 3 22)
    (comment "Exif orientation: 6 turns it (little and big endian), 1 does not, and an APP1 that is not Exif is not read")
    (it-verdict (test-t) im data (hex-blob "ffd8ffe1002245786966000049492a0008000000010012010300010000000600000000000000ffc00011080010001803011100021101031101ffd9") 14 23)
    (it-verdict (test-t) im data (hex-blob "ffd8ffe100224578696600004d4d002a00000008000101120003000000010006000000000000ffc00011080010001803011100021101031101ffd9") 14 24)
    (it-verdict (test-t) im data (hex-blob "ffd8ffe1002245786966000049492a0008000000010012010300010000000100000000000000ffc00011080010001803011100021101031101ffd9") 0 25)
    (it-verdict (test-t) im data (hex-blob "ffd8ffe100224578696600004d4d002a00000008000101120003000000010001000000000000ffc00011080010001803011100021101031101ffd9") 0 26)
    (it-verdict (test-t) im data (hex-blob "ffd8ffe10008787878787878ffc00011080010001803011100021101031101ffd9") 0 27)))

(deftest test-the-passthrough-conditions-of-the-dictionary
  (comment "A JPEG that would pass, in an image whose dictionary says otherwise: /Decode, a mask, /ImageMask, an Indexed")
  (comment "or CMYK colour space, a filter after DCT, and a bit depth that is not 8 are each their own reason.")
  (let [^Cells ar (new-cells)
        ^Cells dc (new-cells)
        ^Cells a (new-cells)
        ^Cells b (new-cells)
        ^Cells st (new-cells)
        ^Cells out (new-cells)
        ^Cells im (new-cells)
        ^Cells data (new-cells)
        ^:mut ^I32 sh 0
        ^Src src (src-of-blob (test-file "assets/dct-decode.pdf"))]
    (assert-eq (pd-open src ar dc a b st) 0 "the file opens")
    (set sh (pd-get src ar dc a b st 5))
    (assert-eq (pi-info src ar dc a b st out im sh 5) 0 "the image is read")
    (it-hex-cells (hex-blob "ffd8ffc00011080010001803011100021101031101ffd9") data)
    (assert-eq (pi-passthrough im data) 10 "a /Decode that is not the default is reason 10")
    (assert-eq (pi-get im (pi-f-class)) 2 "the colour class is RGB")
    (assert-eq (pi-get im (pi-f-codec)) 7 "DCTDecode ends the chain")))
