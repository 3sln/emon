;; D883 section 2.6: source namespaces have a closed, typed registry.
;; Rows: namespace key type arity subject attach consumer fallback.
;; Subject: answer=0 block=1 line=2 word=3 symbol=4.
;; Attach: informative=1 not-implied=2 requested=3. Type 9 is ncp/cps.
;; Policy consumers (through oilsrc/oxs-policy-value before ingestion):
;; 1/3 scriptcheck/sk-unread, fallback word ISO language;
;;     scriptchecktest/test-source-model-overrides-language-and-absence-keeps-the-fallback.
;; 2/2 upscale/up-turns, fallback page orientation (then retarget's tracer);
;;     upscaletest/test-crop-reversal-precedes-enlargement-and-absence-keeps-page-fallback.
;; oilsrc's generic accessors also check this column, source namespace and identity
;; policy. No geometric key is policy-readable in this phase.
(ns emon.oilregistry
  (:require [emon.lang :refer [I32]]
            [kin.lang :refer [defn defdata return let set while if do + * < == and]]))

(defdata ^:pub oil-keys
  :emitter kin.lang/flat-array
  :data [1 1 8 1 1 2 0 0
         1 2 9 0 0 2 0 0
         1 3 9 0 3 2 1 1
         2 1 2 1 2 1 0 0
         2 2 1 2 2 2 1 2
         2 3 1 1 2 2 0 0
         2 4 1 3 3 3 0 0]
  :accessors {^I32 oil-key-cells [^I32 ignored]
              ^I32 oil-key-cell [^I32 ignored ^I32 index]})

(defn ^:pub ^I32 oil-key-find [^I32 ns ^I32 key]
  (let [^:mut ^I32 i 0]
    (while (< i (oil-key-cells 0))
      (do (if (and (== (oil-key-cell 0 i) ns) (== (oil-key-cell 0 (+ i 1)) key)) (return i))
          (set i (+ i 8)))))
  (return -1))

(defn ^:pub ^I32 oil-key-field [^I32 registry ^I32 field]
  (return (oil-key-cell 0 (+ registry field))))
