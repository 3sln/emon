;; CONFIDENCE CALIBRATION (P10.1; SPEC 3.5, 9.6; D370). emon's own module (D039).
;;
;; THE MODEL'S CONFIDENCE IS WRITTEN CALIBRATED. Every rule of the pipeline writes a RAW score (its own per mille
;; constant: 500 for a block it inferred, 600 for a table, 1000 for a glyph's own text, the fusion rules' columns), and
;; the arenas keep that raw score: it is what the rules read (`ar-tag-apply` lowers one, `scan`'s `sc-tag` tests
;; one). What leaves the Model, as JSON (`emon.json`) and as `data-emon-conf` (`emon.html`), is `cal-conf` of it: the
;; per-kind isotonic map of SPEC 9.6, so that among the nodes of a kind whose confidence is c about c/1000 are
;; right (SPEC 3.5), as `bb calibration` measures against the gold and the `conf-ece-*` rows of the scoreboard
;; ratchet.
;;
;; THE TABLE is `emon.calibdata`'s `cd-rows`, GENERATED by `bb calibration --fit` from the raw confidences of the
;; evaluation corpora and committed (a refit is a reviewed change with its reliability diagram, SPEC 9.6). A row is
;; [kind class raw-lo calibrated]: the node kind (`nk`; 100 the dropped ledger), the CLASS of its source (`cal-class`
;; of its `src`: 0 text layer, 1 OCR, 2 both, 3 neither, -1 any class) and a step of the map: the calibrated
;; confidence for raw scores from raw-lo up to the next row of that kind and class. The rows are sorted by kind, class,
;; raw-lo, and a step of one class that says what the kind's says is not a row.
;;
;; THE LOOKUP, `cal-conf kind src raw`: the steps of (kind, class of `src`) when there are any, else the steps of
;; (kind, any class), else the raw score as it is (a kind with too few rows to fit has no row). Within the steps the
;; last one whose raw-lo is at most the raw score, and below the first the first (the map is a step function
;; clamped at its ends, so a raw score no run has produced yet takes its neighbour's value, never an invented
;; one). Absent (-1) stays absent. The map is monotone in the raw score within a class and kind, by the fit.
(ns emon.calib
  (:require [emon.lang :refer [I32 Cells]]
            [emon.calibdata :refer [cd-count cd-at]]
            [emon.model :refer [sr-text sr-hidden-text sr-ocr node-conf node-src node-kind node-flags node-parent fl-script-unread]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or bit-and bit-or]]))

(defn ^:pub ^I32 cal-dropped [] (comment "the kind code of a row of the dropped ledger, which has no node kind") (return 100))

(defn ^:pub ^I32 cal-class [^I32 src]
  (comment "The class of a source bitset: 0 the text layer (visible or hidden), 1 OCR, 2 both, 3 neither (structure the analysis inferred).")
  (let [^I32 tl (bit-and src (bit-or (sr-text) (sr-hidden-text)))
        ^I32 oc (bit-and src (sr-ocr))]
    (if (and (!= tl 0) (!= oc 0)) (return 2))
    (if (!= oc 0) (return 1))
    (if (!= tl 0) (return 0))
    (return 3)))

(defn ^:pub ^I32 cal-lookup [^I32 kind ^I32 cls ^I32 raw]
  (comment "`cal-conf` for a class code: a code the table has no row for (9 is none) reads the kind's `any` rows.")
  (if (< raw 0) (return raw))
  (let [^I32 n (cd-count 0)
        ^:mut ^I32 i 0
        ^:mut ^I32 hit-c -1
        ^:mut ^I32 first-c -1
        ^:mut ^I32 hit-a -1
        ^:mut ^I32 first-a -1]
    (while (< i n)
      (do (if (== (cd-at 0 i 0) kind)
            (do (if (== (cd-at 0 i 1) cls)
                  (do (if (< first-c 0) (set first-c (cd-at 0 i 3)))
                      (if (<= (cd-at 0 i 2) raw) (set hit-c (cd-at 0 i 3)))))
                (if (== (cd-at 0 i 1) -1)
                  (do (if (< first-a 0) (set first-a (cd-at 0 i 3)))
                      (if (<= (cd-at 0 i 2) raw) (set hit-a (cd-at 0 i 3)))))))
          (set i (+ i 1))))
    (if (>= hit-c 0) (return hit-c))
    (if (>= first-c 0) (return first-c))
    (if (>= hit-a 0) (return hit-a))
    (if (>= first-a 0) (return first-a))
    (return raw)))

(defn ^:pub ^I32 cal-conf [^I32 kind ^I32 src ^I32 raw]
  (comment "The calibrated confidence (per mille) of a raw one for a node kind and source; -1 stays -1.")
  (return (cal-lookup kind (cal-class src) raw)))

(defn ^:pub ^I32 cal-node-conf [^Cells nodes ^I32 n]
  (comment "The calibrated confidence of node `n`, as the Model writes it (`cal-conf` of its kind, source and raw score), D1610: EXCEPT a node of a block flagged")
  (comment "`script-unread` (the engine had no model for the page's script, `emon.scriptcheck`), which is written at its raw score when that is lower. The map is a")
  (comment "step function clamped at its ends, and the lowest step of OCR text is a text the engine read: a raw 100 would be written as that, and the engine's guess")
  (comment "at a script it cannot read would carry the confidence of what it can.")
  (let [^I32 raw (node-conf nodes n)
        ^I32 cf (cal-conf (node-kind nodes n) (node-src nodes n) raw)
        ^:mut ^I32 a n]
    (if (< raw 0) (return cf))
    (if (<= cf raw) (return cf))
    (while (>= a 0)
      (do (if (!= (bit-and (node-flags nodes a) (fl-script-unread)) 0) (return raw))
          (set a (node-parent nodes a))))
    (return cf)))
