;; THE TESSERACT FALLBACK OF A PLATFORM READER, PAGE BY PAGE (P13.21b, D907; D883 rulings 3, 4 and 8; D901). emon's own module (D039).
;;
;; `ocr-engine=apple-vision` reads with Apple Vision. Vision is the better reader (receipts, tables, speed, no pack to fetch), and the candidate Apple turnkey default (`emon.engines`'
;; `en-turnkey`, P13.21b D907); but it has no recogniser for some scripts, it reads a stamp as body text and it puts a tilted form's row cells in another order. Where one of those is so, the
;; PAGE is Tesseract's: this module decides which page, in kin, from what the Vision reading and the page's pixels say, so a replay makes the same choice (the choice is a pure function of
;; the answers the page unit has). A host decides nothing: it routes a request to the adapter of the engine the request names (`emon.adapters`' `ad-route`), and the request names
;; Vision unless this module made it Tesseract's (`emon.ocrengine`'s `oe-tag-fb`).
;;
;; THE RULES (a page of a scan or an image frame; a born-digital page keeps its text layer and is read by Vision alone):
;;   UNREAD   Vision gave no reading (`unsupported`: a language it has no locale for, a script it cannot read, or `failed`): Tesseract reads the page.
;;   SCRIPT   Vision read the page, and the script its text is in is one Vision has no recogniser for (`fb-vision-reads`: kin's `emon.ocrloc` table of the locales Vision has, the table the
;;            adapter maps a request through; a locale this OS lacks makes the adapter refuse the request, which is UNREAD above), by kin's own census of its letters (D883 ruling 4: Vision has no OSD).
;;   THIN     a reading of fewer than `fb-thin-chars` letters and digits: a page Vision could not read (a Hindi or a Persian page came out as 0 to 18 stray marks on this macOS; the thinnest of 120 receipts
;;            has 28). It costs a blank page a Tesseract reading.
;;   DOUBT    a reading of fewer than `fb-doubt-chars` letters and digits, or a mix of scripts no page has (`fb-noise`: at least `fb-noise-share` per mille of the letters outside the script family most
;;            of them are in; Han and kana are one family, Greek letters and, on a page that is not Latin, Latin ones count for nothing): a page Vision may not have been able to read, or may have. What
;;            Tesseract says of its script decides (`fb-spec-take`): the fallback's first pass is asked beside the reading (`pi-spec`, with orientation and script detection, as every first pass has it),
;;            and when its script is named with `sk-min-conf` and is not one Vision reads the page is Tesseract's, else it stays Vision's and the reading is thrown away. A short receipt has this many
;;            letters and digits too, and Tesseract's detection of a Latin page that short is weak (a Cyrillic of 6.7 on a Latin receipt), so only a sure script counts. The cost is a Tesseract reading of
;;            every such page, which is why the line is where it is: Vision reads 60 characters of a receipt that Tesseract reads 20 of.
;;   SEAL     the page's pixels show a seal or a stamp (`emon.sealpx`'s `sx-find`, the candidates whose primitive the tracer is sure of: `fb-seal-hits`): Vision reads a stamp as text and reads its ring badly, Tesseract holds seal and stamp pages
;;            (ruling 8). The test is made after the ink layers are made, before any pass is asked, in `emon.pageunit`, and not on a page kin took for a receipt (its receipt trigger, `emon.pageink`: the
;;            rings of a receipt's logo are as sure as a seal's, and Vision reads receipts best).
;;   FORM     a page of numeric columns that is not a receipt (`fb-form`: an invoice, a statement): Vision answers the cells of such a row as lines of their own, and the rows come out in another
;;            order (the `scan/forms` category of D901: CER 0.31 against Tesseract's 0.04 with every word right). Applied because the measurement of P13.21b called for it: the form rows of
;;            Vision alone are worse than Tesseract's by more than 0.01 after the language fix. A receipt (kin's receipt trigger, `emon.norm`) is excluded: Vision reads receipts best.
;; The page is then read by Tesseract as a page of its own (`pi-fallback`: the ordinary first pass, with the page's languages), and everything after it (the targeted passes, the cells, the
;; strips) is Tesseract's too: `en-page` tells `oe-tag-fb` that the page was taken. If Tesseract cannot read it either (no adapter, a pack the app declined: the answer is unread) the page keeps
;; its Vision reading: the fallback is an improvement and never a requirement, so a host with Vision alone behaves exactly as it did before this module. A page's rounds are the ones it
;; always had plus the fallback's one (render, Vision, Tesseract, then the targeted passes): no round more than the `max-rounds` of 5 allows. The fallback's first pass has two ids: `pi-fallback`
;; (27), asked when the page is Tesseract's by the rules above, and `pi-spec` (20), asked beside a doubtful reading and taken when its script says so.
(ns emon.ofall
  (:require [emon.lang :refer [I32 Cells]]
            [emon.port :refer [cells-at cells-len cells-drop cells-push cells-set]]
            [emon.plan :refer [an-find an-ok pu-id]]
            [emon.oil :refer [oil-find oil-has oil-get oh-caps oc-script oil-script oil-sconf oil-nwords oil-first-word oil-wlen oil-wcp oil-word-next]]
            [emon.evidence :refer [ol-get ow-get lh-first lh-count lh-y0 lh-y1 hd-tstart hd-tlen co-count co-get cf-page cf-kind ck-text-like]]
            [emon.ocrport :refer [sc-latn sc-latf]]
            [emon.ocrscript :refer [os-census-count os-census-of]]
            [emon.ocrloc :refer [ol-has]]
            [emon.scriptcheck :refer [sk-census sk-min-conf]]
            [emon.scan :refer [sc-request]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^:pub ^I32 fb-slot-read [] (comment "The page-local request id of the Tesseract fallback's first pass (`pu-id`: 16-127 are OCR ids; 27 was free).") (return 27))
(defn ^:pub ^I32 fb-slot-spec [] (comment "The page-local request id of the fallback's first pass asked beside a doubtful reading, taken when its script says so (20 was free).") (return 20))
(defn ^I32 fb-chars [^Cells an ^I32 ext]
  (comment "How many letters and digits the answer's words hold.")
  (let [^:mut ^I32 w (oil-first-word an ext) ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 n 0 ^:mut ^I32 cp 0]
    (while (< i (oil-nwords an ext))
      (do (set j 0)
          (while (< j (oil-wlen an ext w))
            (do (set cp (oil-wcp an ext w j))
                (if (or (>= (os-census-of cp) 0) (and (>= cp 48) (<= cp 57))) (set n (+ n 1)))
                (set j (+ j 1))))
          (set w (oil-word-next an ext w))
          (set i (+ i 1))))
    (return n)))

(defn ^:pub ^I32 fb-noise-letters [] (comment "A reading of fewer letters than this is not judged by its mix of scripts.") (return 20))
(defn ^:pub ^I32 fb-noise-share [] (comment "Per mille of the letters outside the main script family from which a reading is noise: real Latin pages measured at most 62 (SROIE), 156 (one CORD receipt) and 18 (the synthetic scans).") (return 100))
(defn ^:pub ^I32 fb-tess-reads [^Cells ans ^I32 ao ^:mut ^Cells scr]
  (comment "1 when Tesseract, with the English model the page unit names for a page with no language, reads what Vision read: the census script of Vision's reading is Latin, or there is none. A page of")
  (comment "Han, Kana, Hangul or Cyrillic text is one Vision reads (a Chinese form read by Tesseract without a language scored a fifth of Vision's characters): the pixel rules (INK, SEAL, FORM) leave it alone.")
  (if (!= (an-ok ans ao) 1) (return 0))
  (let [^I32 ext (oil-find ans ao)]
    (if (< ext 0) (return 1))
    (let [^I32 script (sk-census ans ext scr)]
      (if (== script 0) (return 1))
      (if (== script (sc-latn)) (return 1))
      (if (== script (sc-latf)) (return 1))))
  (return 0))

(defn ^:pub ^I32 fb-thin-chars [] (comment "A reading of fewer letters and digits than this is the reading of a page Vision could not read: of 120 receipts the thinnest has 28 (first pass), the Persian and Hindi pages came out as 0 to 18.") (return 20))
(defn ^:pub ^I32 fb-doubt-chars [] (comment "A reading of fewer than this is doubted: 60 is under the median receipt (76).") (return 60))
(defn ^:pub ^I32 fb-engine [] (comment "The OIL engine of the reader whose pages fall back (Apple Vision, `oen` 3).") (return 3))

(defn ^:pub ^I32 fb-read-id [^I32 page] (return (pu-id page (fb-slot-read))))
(defn ^:pub ^I32 fb-spec-id [^I32 page] (return (pu-id page (fb-slot-spec))))

(defn ^:pub ^I32 fb-slot-is-fallback [^I32 id]
  (comment "1 when the request id is one of a page's fallback first passes (`fb-slot-read`, `fb-slot-spec`): Tesseract's, whatever else the page is. Ids of the asset unit and above are no page's.")
  (if (>= id 8388608) (return 0))
  (let [^I32 k (- id (* (quot id 256) 256))]
    (if (== k (fb-slot-read)) (return 1))
    (if (== k (fb-slot-spec)) (return 1)))
  (return 0))

(defn ^:pub ^I32 fb-vision-reads [^I32 script]
  (comment "1 when Apple Vision has a recogniser for the script (ISO 15924, a packed cell): the locales of `emon.ocrloc` for engine 3 (Latin, Cyrillic, Han, Japanese, Hangul and Thai on the OS this was")
  (comment "measured on; Vision there reads no Arabic, Indic, Hebrew, Greek, Armenian, Georgian, Ethiopic or Khmer).")
  (if (== script (sc-latf)) (return 1))
  (return (ol-has (fb-engine) script)))

(defn ^:pub ^I32 fb-letters [^Cells an ^I32 ext ^:mut ^Cells scr]
  (comment "How many script-bearing letters the answer's words hold (digits and punctuation are none), by kin's census.")
  (sk-census an ext scr)
  (let [^:mut ^I32 k 0 ^:mut ^I32 total 0]
    (while (< k (os-census-count 0))
      (do (set total (+ total (cells-at scr k)))
          (set k (+ k 1))))
    (return total)))

(defn ^I32 fb-ask [^:mut ^Cells rq ^I32 page ^I32 bitmap ^I32 dpi ^Cells loc]
  (comment "The fallback's first pass: the page's ordinary OCR request under the fallback's id (tagged Tesseract's by `oe-tag-fb`, which knows the id).")
  (sc-request rq (fb-read-id page) bitmap dpi loc)
  (return -1))

(defn ^:pub ^I32 fb-noise [^Cells an ^I32 ext ^:mut ^Cells scr]
  (comment "The number of letters of the reading (`ext` is `oil-find`'s) that are noise, when there are at least `fb-noise-letters` of them and that is `fb-noise-share` per mille of them or more; else 0.")
  (comment "Noise is a letter outside the script family most of the letters are in. Greek letters count for nothing (scientific text is full of them), Han and kana are one family (a Japanese page is both), and")
  (comment "when the main family is not Latin the Latin letters count for nothing too (a Japanese or Russian form has its TEL and e-mail). `scr` is scratch.")
  (sk-census an ext scr)
  (let [^:mut ^I32 k 0 ^:mut ^I32 total 0 ^:mut ^I32 top 0 ^:mut ^I32 v 0 ^:mut ^I32 noise 0
        ^I32 latin (cells-at scr 0) ^I32 greek (cells-at scr 2) ^I32 cjk (+ (cells-at scr 6) (cells-at scr 8))]
    (while (< k (os-census-count 0))
      (do (set total (+ total (cells-at scr k)))
          (if (and (!= k 2) (and (!= k 6) (!= k 8)))
            (do (set v (cells-at scr k)) (if (> v top) (set top v))))
          (set k (+ k 1))))
    (if (> cjk top) (set top cjk))
    (set total (- total greek))
    (set noise (- total top))
    (if (> top latin) (set noise (- noise latin)))
    (if (< total (fb-noise-letters)) (return 0))
    (if (>= (* noise 1000) (* total (fb-noise-share))) (return noise))
    (return 0)))

(defn ^:pub ^I32 fb-ask-spec [^:mut ^Cells rq ^I32 page ^I32 bitmap ^I32 dpi ^Cells loc]
  (comment "The fallback's first pass beside a doubtful reading: the ordinary first pass, under `pi-spec`'s id.")
  (sc-request rq (fb-spec-id page) bitmap dpi loc)
  (return -1))

(defn ^:pub ^I32 fb-spec-take [^Cells ans ^I32 specq]
  (comment "1 when the fallback's first pass asked beside a doubtful reading (the answer at `specq`) names a script with `sk-min-conf` or more that Vision has no recogniser for: the page is Tesseract's.")
  (if (< specq 0) (return 0))
  (if (!= (an-ok ans specq) 1) (return 0))
  (let [^I32 ext (oil-find ans specq)]
    (if (< ext 0) (return 0))
    (if (== (oil-has (oil-get ans ext (oh-caps)) (oc-script)) 0) (return 0))
    (let [^I32 script (oil-script ans ext)]
      (if (<= script 0) (return 0))
      (if (< (oil-sconf ans ext) (sk-min-conf)) (return 0))
      (if (== (fb-vision-reads script) 1) (return 0))))
  (return 1))

(defn ^:pub ^I32 fb-taken-id [^Cells ans ^I32 page]
  (comment "The request id of the answer that is the page's first pass when the page is Tesseract's, 0 when it is Vision's: the fallback's first pass if it was asked and read, else the one beside a doubtful")
  (comment "reading when its script took the page. Every request of a taken page is Tesseract's (`oe-tag-fb`).")
  (let [^I32 at (an-find ans (fb-read-id page))]
    (if (>= at 0)
      (if (== (an-ok ans at) 1) (return (fb-read-id page)))))
  (let [^I32 sp (an-find ans (fb-spec-id page))]
    (if (== (fb-spec-take ans sp) 1) (return (fb-spec-id page))))
  (return 0))

(defn ^:pub ^I32 fb-route [^I32 page ^Cells ans ^I32 ao ^I32 bitmap ^I32 dpi ^:mut ^Cells rq ^Cells loc ^:mut ^Cells scr]
  (comment "Whether the page whose Vision reading is the answer at `ao` (not ok when Vision refused it) goes to Tesseract, by the UNREAD, THIN, SCRIPT and DOUBT rules above. Answers 0 to keep Vision's")
  (comment "reading and -1 when this asked for the fallback's first pass (under its own id when the rules decide, beside the reading when a doubt does): the caller returns its `us-requests`. A")
  (comment "fallback that was asked, usable or not, is final: 0 (a usable one was taken before this was called). `bitmap` is the page's raster, `dpi` its resolution, `loc` the locale hint.")
  (if (>= (an-find ans (fb-read-id page)) 0) (return 0))
  (if (>= (an-find ans (fb-spec-id page)) 0) (return 0))
  (if (!= (an-ok ans ao) 1) (return (fb-ask rq page bitmap dpi loc)))
  (let [^I32 ext (oil-find ans ao)]
    (if (< ext 0) (return 0))
    (let [^I32 chars (fb-chars ans ext)]
      (if (< chars (fb-thin-chars)) (return (fb-ask rq page bitmap dpi loc)))
      (let [^I32 script (sk-census ans ext scr)]
        (if (> script 0)
          (if (== (fb-vision-reads script) 0) (return (fb-ask rq page bitmap dpi loc)))))
      (if (< chars (fb-doubt-chars)) (return (fb-ask-spec rq page bitmap dpi loc)))
      (if (> (fb-noise ans ext scr) 0) (return (fb-ask-spec rq page bitmap dpi loc)))))
  (return 0))

(defn ^:pub ^I32 fb-seal-conf [] (comment "A seal or stamp candidate counts when its primitive's confidence (per mille) is at least this: the tracer's rings and stamp outlines of the seal fixtures are 856 to 928, the weak curves it finds on a photographed receipt are 300.") (return 700))

(defn ^:pub ^I32 fb-seal-hits [^Cells cand]
  (comment "The SEAL rule's count: how many of `sx-find`'s candidates (16 cells each, the primitive's confidence in cell 15) are sure enough to be a seal or a stamp.")
  (let [^I32 n (quot (cells-len cand) 16) ^:mut ^I32 j 0 ^:mut ^I32 hits 0]
    (while (< j n)
      (do (if (>= (cells-at cand (+ (* j 16) 15)) (fb-seal-conf)) (set hits (+ hits 1)))
          (set j (+ j 1))))
    (return hits)))

(defn ^:pub ^I32 fb-form-lines [] (comment "A page of fewer OCR lines than this is not a form: a statement has dozens.") (return 12))
(defn ^:pub ^I32 fb-form-rows [] (comment "A page with at least this many rows of three or more lines, two of them numeric, is a form.") (return 6))
(defn ^:pub ^I32 fb-form-max [] (comment "A page of more OCR lines than this is left alone (the clusters of `fb-form` are quadratic in them)." ) (return 1500))

(defn ^I32 fb-digits [^Cells etext ^I32 from ^I32 nch]
  (comment "How many digits the code points [from, from + nch) hold.")
  (let [^:mut ^I32 j 0 ^:mut ^I32 d 0 ^:mut ^I32 c 0]
    (while (< j nch)
      (do (set c (cells-at etext (+ from j)))
          (if (and (>= c 48) (<= c 57)) (set d (+ d 1)))
          (set j (+ j 1))))
    (return d)))

(defn ^I32 fb-letters-in [^Cells etext ^I32 from ^I32 nch]
  (comment "How many letters (ASCII, or any code point from 128 up) the code points [from, from + nch) hold.")
  (let [^:mut ^I32 j 0 ^:mut ^I32 d 0 ^:mut ^I32 c 0]
    (while (< j nch)
      (do (set c (cells-at etext (+ from j)))
          (if (or (and (>= c 65) (<= c 90)) (or (and (>= c 97) (<= c 122)) (>= c 128))) (set d (+ d 1)))
          (set j (+ j 1))))
    (return d)))

(defn ^I32 fb-numeric-line [^Cells olines ^Cells owords ^Cells etext ^I32 l]
  (comment "1 when a word of OCR line `l` is a number or a code that is mostly one: a digit in it and at most two letters (`6.50`, `4,130.74`, `S00001`, `15mm`).")
  (let [^I32 first (ol-get olines l (lh-first))
        ^I32 n (ol-get olines l (lh-count))
        ^:mut ^I32 k 0 ^:mut ^I32 from 0 ^:mut ^I32 nch 0]
    (while (< k n)
      (do (set from (ow-get owords (+ first k) (hd-tstart)))
          (set nch (ow-get owords (+ first k) (hd-tlen)))
          (if (> (fb-digits etext from nch) 0)
            (if (<= (fb-letters-in etext from nch) 2) (return 1)))
          (set k (+ k 1)))))
  (return 0))

(defn ^:pub ^I32 fb-form [^Cells olines ^Cells owords ^Cells etext ^I32 l0 ^I32 nl ^I32 receipt ^:mut ^Cells scr]
  (comment "The FORM rule: how many rows of the Vision reading's lines [l0, l0 + nl) are rows of a table of numbers (0: the page is not one). A row is the lines whose centres lie within 0.6 of")
  (comment "the mean line height of the row's first line, three or more of them, two or more numeric (`fb-numeric-line`); `fb-form-rows` rows make a form. A page kin took for a receipt (`receipt`: the")
  (comment "receipt trigger of `emon.pageink`, non-zero) is never a form: the receipt reads of Vision are the reason it is the default. `scr` is scratch: the clusters' centres, counts and numeric counts.")
  (if (!= receipt 0) (return 0))
  (if (< nl (fb-form-lines)) (return 0))
  (if (> nl (fb-form-max)) (return 0))
  (cells-drop scr 0)
  (let [^:mut ^I32 i 0 ^:mut ^I32 sum 0 ^:mut ^I32 l 0 ^:mut ^I32 cy 0 ^:mut ^I32 c 0 ^:mut ^I32 hit -1 ^:mut ^I32 k 0 ^:mut ^I32 rows 0 ^:mut ^I32 d 0]
    (while (< i (* 3 nl)) (do (cells-push scr 0) (set i (+ i 1))))
    (set i 0)
    (while (< i nl)
      (do (set l (+ l0 i))
          (set sum (+ sum (- (ol-get olines l (lh-y1)) (ol-get olines l (lh-y0)))))
          (set i (+ i 1))))
    (let [^I32 h (quot sum nl)]
      (if (<= h 0) (return 0))
      (set i 0)
      (while (< i nl)
        (do (set l (+ l0 i))
            (set cy (quot (+ (ol-get olines l (lh-y0)) (ol-get olines l (lh-y1))) 2))
            (set hit -1)
            (set c 0)
            (while (< c k)
              (do (set d (- (cells-at scr c) cy))
                  (if (< d 0) (set d (- 0 d)))
                  (if (<= (* d 10) (* 6 h)) (do (set hit c) (set c k)))
                  (set c (+ c 1))))
            (if (< hit 0)
              (do (set hit k)
                  (cells-set scr hit cy)
                  (set k (+ k 1))))
            (cells-set scr (+ nl hit) (+ (cells-at scr (+ nl hit)) 1))
            (if (== (fb-numeric-line olines owords etext l) 1)
              (cells-set scr (+ (* 2 nl) hit) (+ (cells-at scr (+ (* 2 nl) hit)) 1)))
            (set i (+ i 1)))))
    (set c 0)
    (while (< c k)
      (do (if (and (>= (cells-at scr (+ nl c)) 3) (>= (cells-at scr (+ (* 2 nl) c)) 2)) (set rows (+ rows 1)))
          (set c (+ c 1))))
    (if (>= rows (fb-form-rows)) (return rows)))
  (return 0))

(defn ^:pub ^I32 fb-ask-if [^I32 page ^Cells ans ^I32 hit ^I32 bitmap ^I32 dpi ^:mut ^Cells rq ^Cells loc]
  (comment "The SEAL and FORM rules: `hit` is what `sx-find` found in the page's pixels (seals and stamps) or `fb-form` found in the reading (rows of numbers). With one or more, and no fallback")
  (comment "asked yet, ask the fallback's first pass and answer -1; else 0.")
  (if (== hit 0) (return 0))
  (if (>= (an-find ans (fb-read-id page)) 0) (return 0))
  (return (fb-ask rq page bitmap dpi loc)))
