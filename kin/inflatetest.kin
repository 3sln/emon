;; Laws and the row corpus for `emon.inflate` (P0.4).
;;
;; THE CORPUS is `test/inflate/streams.txt`, written by
;; `kin/scripts/inflate-corpus.py` from streams a HOST TOOL produced (CPython's
;; zlib, at levels 0/1/6/9, every strategy and several window sizes) plus
;; hand-built and truncated ones; see that script for the row format and for
;; how each damaged row is also rejected by zlib. Every target reads the same
;; file and must answer the same status, the same consumed count and the same
;; bytes on every row.
;;
;; THE DRIVER IS KIN: the file is read as a `Blob` and parsed here, so the
;; four targets also agree about the row parser. A failure names the LINE of
;; the file (1-based) and the field that differed.
(ns emon.inflatetest
  (:require [emon.lang :refer [I32 Blob Cells Buf Text emit-ascii]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that
                               assert-cells-hex assert-text hex-blob new-cells new-buf
                               new-text test-file cells-blob Str TestT test-t]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-push
                               cells-drop text-i32 buf-len buf-at buf-truncate buf-push buf-grow buf-copy-back]]
            [emon.inflate :refer [iz-zlib iz-raw iz-zlib-buf iz-raw-buf iz-consumed iz-status-emit-name
                                  iz-ok iz-truncated iz-bad-header iz-bad-checksum
                                  iz-bad-distance iz-bad-block-type iz-bad-code]]
            [kin.lang :refer [defn return let set while if comment do
                              + - * < > <= >= == != and or quot bit-and]]))

;; ---------------------------------------------------------- row parsing

(defn ^I32 it-nl [^Blob b ^I32 i]
  (comment "Index of the next newline at or after i, or the blob's length.")
  (let [^:mut ^I32 k i]
    (while (and (< k (blob-len b)) (!= (blob-u8 b k) 10))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 it-semi [^Blob b ^I32 i ^I32 lim]
  (comment "Index of the next `;` in [i, lim), or lim.")
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 59))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 it-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (return -1))

(defn ^I32 it-dec [^Blob b ^I32 from ^I32 to]
  (comment "A decimal integer, with an optional leading minus.")
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0
        ^:mut ^I32 neg 0]
    (if (and (< k to) (== (blob-u8 b k) 45))
      (do (set neg 1) (set k (+ k 1))))
    (while (< k to)
      (do (set v (+ (* v 10) (- (blob-u8 b k) 48)))
          (set k (+ k 1))))
    (if (== neg 1) (return (- 0 v)))
    (return v)))

(defn ^I32 it-hex-into [^Blob b ^I32 from ^I32 to ^:mut ^Cells c]
  (comment "Decode the hex pairs in b[from, to) into c (cleared first).")
  (let [^:mut ^I32 k from]
    (cells-drop c 0)
    (while (< (+ k 1) (+ to 0))
      (do (cells-push c (+ (* (it-hexval (blob-u8 b k)) 16)
                           (it-hexval (blob-u8 b (+ k 1)))))
          (set k (+ k 2))))
    (return (cells-len c))))

(defn ^I32 it-compare [^Cells out ^Blob b ^I32 from ^I32 to ^I32 exact]
  (comment "-1 when `out` matches the hex in b[from, to): exactly, or (exact =")
  (comment "0) as a PREFIX of it. -2 for a length problem; otherwise the")
  (comment "index of the first differing byte.")
  (let [^I32 n (quot (- to from) 2)
        ^:mut ^I32 i 0]
    (if (> (cells-len out) n) (return -2))
    (if (and (== exact 1) (!= (cells-len out) n)) (return -2))
    (while (< i (cells-len out))
      (do (if (!= (cells-at out i)
                  (+ (* (it-hexval (blob-u8 b (+ from (* i 2)))) 16)
                     (it-hexval (blob-u8 b (+ from (+ (* i 2) 1))))))
            (return i))
          (set i (+ i 1))))
    (return -1)))

;; ------------------------------------------------------------- the corpus

(deftest test-every-row-of-the-zlib-corpus
  (comment "Fields: name ; kind ; status ; consumed ; stream-hex ; output-hex.")
  (let [^Blob f (test-file "inflate/streams.txt")
        ^Cells src (new-cells)
        ^Cells out (new-cells)
        ^Cells st (new-cells)
        ^Cells st2 (new-cells)
        ^Buf bout (new-buf)
        ^I32 n (blob-len f)
        ^:mut ^I32 k 0
        ^:mut ^I32 gotb 0
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 rows 0
        ^:mut ^I32 e 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 s3 0
        ^:mut ^I32 s4 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 status 0
        ^:mut ^I32 consumed 0
        ^:mut ^I32 got 0
        ^:mut ^I32 slen 0
        ^:mut ^I32 exact 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (it-nl f pos))
          (if (and (< pos e) (!= (blob-u8 f pos) 35))
            (do (set rows (+ rows 1))
                (set s0 (it-semi f pos e))
                (set s1 (it-semi f (+ s0 1) e))
                (set s2 (it-semi f (+ s1 1) e))
                (set s3 (it-semi f (+ s2 1) e))
                (set s4 (it-semi f (+ s3 1) e))
                (set kind (blob-u8 f (+ s0 1)))
                (set status (it-dec f (+ s1 1) s2))
                (set consumed (it-dec f (+ s2 1) s3))
                (set slen (it-hex-into f (+ s3 1) s4 src))
                (cells-drop out 0)
                (if (or (== kind 122) (== kind 90))
                  (set got (iz-zlib (cells-blob src) 0 slen out st))
                  (set got (iz-raw (cells-blob src) 0 slen out st)))
                (assert-eq-at got status "status" line)
                (if (>= consumed 0)
                  (assert-eq-at (iz-consumed st) consumed "consumed" line))
                (set exact 0)
                (if (or (== kind 90) (== kind 82)) (set exact 1))
                (assert-eq-at (it-compare out f (+ s4 1) e exact)
                              -1 "output" line)
                (comment "The Buf form (D1220) is held to the Cells one on the same row: status, consumed, every byte.")
                (buf-truncate bout 0)
                (if (or (== kind 122) (== kind 90))
                  (set gotb (iz-zlib-buf (cells-blob src) 0 slen bout st2))
                  (set gotb (iz-raw-buf (cells-blob src) 0 slen bout st2)))
                (assert-eq-at gotb got "buf status" line)
                (assert-eq-at (iz-consumed st) (iz-consumed st2) "buf consumed" line)
                (assert-eq-at (buf-len bout) (cells-len out) "buf length" line)
                (set k 0)
                (while (< k (cells-len out))
                  (do (if (!= (buf-at bout k) (cells-at out k))
                        (assert-eq-at (buf-at bout k) (cells-at out k) "buf byte" line))
                      (set k (+ k 1))))))
          (set pos (+ e 1))))
    (assert-eq rows 346 "the corpus has this many rows")))

;; ---------------------------------------------------------- readable laws

(deftest test-the-classic-stored-hello
  (comment "zlib.compress(b'hello', 0): header, one stored block, Adler-32.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (iz-zlib (hex-blob "7801 010500faff 68656c6c6f 062c0215") 0 16 out st)
               (iz-ok) "status")
    (assert-cells-hex out "68656c6c6f" "hello")
    (assert-eq (iz-consumed st) 16 "consumed")))

(deftest test-the-classic-fixed-hello
  (comment "zlib.compress(b'hello', 1) is a fixed-Huffman block.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (iz-zlib (hex-blob "7801 cb48cdc9c90700 062c0215") 0 13 out st)
               (iz-ok) "status")
    (assert-cells-hex out "68656c6c6f" "hello")))

(deftest test-a-partial-result-survives-damage
  (comment "The first bytes decoded before the fault are kept.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (iz-zlib (hex-blob "7801 cb48cdc9c9") 0 7 out st) (iz-truncated) "truncated")
    (assert-eq (cells-len out) 4 "four bytes came out before the end")
    (assert-eq (iz-zlib (hex-blob "7801 cb48cdc9c90700 062c0216") 0 13 out st)
               (iz-bad-checksum) "bad checksum")
    (assert-eq (cells-len out) 9 "and the output is kept")))

(deftest test-the-input-range-is-respected
  (comment "Only src[start, end) is read: junk before start and after end is")
  (comment "never seen, and `consumed` is an index into the whole blob.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (iz-zlib (hex-blob "ffff 7801 cb48cdc9c90700 062c0215 ffff") 2 15 out st)
               (iz-ok) "status")
    (assert-eq (iz-consumed st) 15 "consumed is absolute")
    (assert-cells-hex out "68656c6c6f" "hello")
    (assert-eq (iz-zlib (hex-blob "7801 cb48cdc9c90700 062c0215") 0 12 out st)
               (iz-truncated) "one byte short of the trailer")))

(deftest test-output-appends-to-what-is-there
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (cells-push out 33)
    (assert-eq (iz-zlib (hex-blob "7801 cb48cdc9c90700 062c0215") 0 13 out st)
               (iz-ok) "status")
    (assert-cells-hex out "2168656c6c6f" "appended after the existing byte")))

(deftest test-status-names-are-the-table
  (let [^Text t (new-text)]
    (iz-status-emit-name t 0)
    (emit-ascii t " ")
    (iz-status-emit-name t 1)
    (emit-ascii t " ")
    (iz-status-emit-name t 5)
    (emit-ascii t " ")
    (iz-status-emit-name t 9)
    (assert-text t "ok truncated bad-distance bad-checksum" "names")))

;; ----------------------------------------------- the table-driven decoder
;;
;; (P10.3a, D421) Each block kind and each edge of the lookup table has a law
;; with a stream from outside emon: CPython's zlib for the first, hand-built
;; with a bit writer checked by the JDK's zlib for the rest (that script is
;; kin/scripts/inflate-vectors).
;; The table is 10 bits for literal/length codes and 8 for distance codes, so
;; codes of 11 to 15 bits, a code that is not in the table, and a distance code
;; that does not exist all go through the slow bit-by-bit path and must say
;; what it always said.

(defn ^I32 it-check-raw [^TestT emon-t ^Blob z ^I32 status ^I32 consumed ^Str hex]
  (comment "A bare deflate stream: its status, how much it consumed and its output.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (iz-raw z 0 (blob-len z) out st) status "status")
    (assert-eq (iz-consumed st) consumed "consumed")
    (assert-cells-hex out hex "output")
    (return 0)))

(deftest test-a-dynamic-block-from-zlib
  (comment "729 bytes of words and numbers, level 9: one dynamic block. The Adler-32")
  (comment "in the trailer checks every byte of the output.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)
        ^Blob z (hex-blob "")]
    (assert-eq (blob-len z) 297 "the stream is this long")
    (assert-eq (iz-zlib z 0 297 out st) (iz-ok) "status")
    (assert-eq (iz-consumed st) 297 "consumed")
    (assert-eq (cells-len out) 729 "length")
    (assert-eq (cells-at out 0) 111 "o")
    (assert-eq (cells-at out 7) 57 "9")
    (assert-eq (cells-at out 728) 56 "the last byte, 8")))

(deftest test-a-code-of-fifteen-bits
  (comment "A dynamic block whose literal/length code has lengths 1, 2, ... 14 for")
  (comment "the bytes 0 to 13 and 15 for end-of-block (and a lone distance code of")
  (comment "length 1): bytes 10 to 13 and the end of the block are codes of 11 to 15")
  (comment "bits, beyond the 10-bit table.")
  (it-check-raw (test-t)
                (hex-blob "0de00182244992244902128b9a4756cffeffbb77a0fd7fdffff7fff9fb7ff7ff03")
                (iz-ok) 33 "0001020d050d0d00070c03"))

(deftest test-stored-fixed-and-dynamic-blocks-in-one-stream
  (comment "A stored block, a fixed one (both flushed to a byte boundary) and the")
  (comment "dynamic one of the law above, the last.")
  (it-check-raw (test-t)
                (hex-blob "001600e9ff73746f72656420626c6f636b206279746573000102ff000000ffff4acbac484d5148c3209372f293b375a012c9f929a9c58a00000000ffff0de00182244992244902128b9a4756cffeffbb77a0fd7fdffff7fff9fb7ff7ff03")
                (iz-ok) 94
                "73746f72656420626c6f636b206279746573000102ff666978656420666978656420666978656420666978656420626c6f636b2c20666978656420636f646573210001020d050d0d00070c03"))

(deftest test-the-longest-match
  (comment "A literal x and then a match of length 258 (symbol 285, no extra bits)")
  (comment "at distance 1: 259 of them.")
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)
        ^:mut ^I32 i 0]
    (assert-eq (iz-raw (hex-blob "ab180500") 0 4 out st) (iz-ok) "status")
    (assert-eq (cells-len out) 259 "length")
    (while (< i 259)
      (do (assert-eq-at (cells-at out i) 120 "x" i)
          (set i (+ i 1))))))

(defn ^I32 it-stored-block [^:mut ^Cells z ^I32 n]
  (comment "A non-final stored block of n bytes, the byte at i being i * 7 + i / 256.")
  (let [^:mut ^I32 i 0]
    (cells-push z 0)
    (cells-push z (bit-and n 255))
    (cells-push z (quot n 256))
    (cells-push z (bit-and (- 65535 n) 255))
    (cells-push z (quot (- 65535 n) 256))
    (while (< i n)
      (do (cells-push z (bit-and (+ (* i 7) (quot i 256)) 255))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 it-push-blob [^:mut ^Cells z ^Blob b]
  (let [^:mut ^I32 i 0]
    (while (< i (blob-len b))
      (do (cells-push z (blob-u8 b i))
          (set i (+ i 1))))
    (return 0)))

(deftest test-the-maximum-distance
  (comment "32768 stored bytes, then a fixed block that copies three bytes from")
  (comment "distance 32768 (symbol 29, all 13 extra bits set): the very first three.")
  (comment "With one byte less of history the same copy reaches too far back.")
  (let [^Cells z (new-cells)
        ^Cells out (new-cells)
        ^Cells st (new-cells)]
    (it-stored-block z 32768)
    (it-push-blob z (hex-blob "03deff0f00"))
    (assert-eq (iz-raw (cells-blob z) 0 (cells-len z) out st) (iz-ok) "status")
    (assert-eq (iz-consumed st) (cells-len z) "consumed")
    (assert-eq (cells-len out) 32771 "length")
    (assert-eq (cells-at out 32768) (cells-at out 0) "first copied byte")
    (assert-eq (cells-at out 32769) (cells-at out 1) "second")
    (assert-eq (cells-at out 32770) (cells-at out 2) "third")
    (assert-eq (cells-at out 32767) (bit-and (+ (* 32767 7) 127) 255) "the last stored byte")
    (cells-drop z 0)
    (cells-drop out 0)
    (it-stored-block z 32767)
    (it-push-blob z (hex-blob "03deff0f00"))
    (assert-eq (iz-raw (cells-blob z) 0 (cells-len z) out st) (iz-bad-distance) "too far back")
    (assert-eq (cells-len out) 32767 "the stored bytes are kept")))

(deftest test-a-code-that-is-not-in-the-table-keeps-its-error
  (comment "The block of the 15-bit law, with a match symbol and then the distance")
  (comment "code '1', which the lone distance code of length 1 does not have. The walk")
  (comment "reads 15 bits before it says bad-code: with them it does, and with the")
  (comment "stream ending sooner it is truncated, as it always was.")
  (it-check-raw (test-t)
                (hex-blob "0de00182244992244902128b9a4756cffeffbb77a0fdff030000")
                (iz-bad-code) 25 "000102")
  (it-check-raw (test-t)
                (hex-blob "0de00182244992244902128b9a4756cffeffbb77a0fdff03")
                (iz-truncated) 24 "000102"))

;; ------------------------------------------- the bulk forms of the Buf (D1220)

(defn ^I32 it-ref-grow [^:mut ^Buf b ^I32 n ^I32 v]
  (comment "`buf-grow`'s oracle: n pushes.")
  (let [^:mut ^I32 k 0]
    (while (< k n)
      (do (buf-push b v)
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 it-ref-copy-back [^:mut ^Buf b ^I32 dist ^I32 n]
  (comment "`buf-copy-back`'s oracle: n pushes of the byte `dist` before the end, which a distance under n makes repeat.")
  (let [^:mut ^I32 k 0]
    (while (< k n)
      (do (buf-push b (buf-at b (- (buf-len b) dist)))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 it-same-buf [^TestT emon-t ^Buf a ^Buf b ^Str msg]
  (let [^:mut ^I32 i 0]
    (assert-eq (buf-len a) (buf-len b) msg)
    (while (< i (buf-len a))
      (do (if (!= (buf-at a i) (buf-at b i))
            (assert-eq (buf-at a i) (buf-at b i) msg))
          (set i (+ i 1))))
    (return 0)))

(deftest test-buf-grow-and-copy-back-are-the-pushes
  (comment "Distance 1, a distance under the length (the pattern repeats), equal to it, past it, the whole buffer back, a length of 0, and a")
  (comment "value past 255 for the fill (its low eight bits). The per-byte forms are the oracle.")
  (let [^Buf a (new-buf)
        ^Buf b (new-buf)
        ^:mut ^I32 i 0]
    (while (< i 9)
      (do (buf-push a (+ 200 i))
          (buf-push b (+ 200 i))
          (set i (+ i 1))))
    (buf-grow a 5 511)
    (it-ref-grow b 5 511)
    (it-same-buf (test-t) a b "grow")
    (buf-copy-back a 1 7)
    (it-ref-copy-back b 1 7)
    (it-same-buf (test-t) a b "distance 1")
    (buf-copy-back a 3 10)
    (it-ref-copy-back b 3 10)
    (it-same-buf (test-t) a b "distance 3, length 10")
    (buf-copy-back a 4 4)
    (it-ref-copy-back b 4 4)
    (it-same-buf (test-t) a b "distance = length")
    (buf-copy-back a 20 5)
    (it-ref-copy-back b 20 5)
    (it-same-buf (test-t) a b "distance past the length")
    (buf-copy-back a (buf-len a) 2)
    (it-ref-copy-back b (buf-len b) 2)
    (it-same-buf (test-t) a b "the whole buffer back")
    (buf-copy-back a 2 0)
    (buf-grow a 0 7)
    (it-same-buf (test-t) a b "nothing")))
