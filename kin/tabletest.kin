                (set j (+ j 1))))
          (set c (+ c 1))))
    (assert-eq hits 1 "section has exactly one owner")
    (set hits 0)
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (set j 0)
          (while (< j (cells-at tc (+ (* c 16) 9)))
            (do (if (== (cells-at tw (+ (cells-at tc (+ (* c 16) 8)) j)) 88)
                  (do (set hits (+ hits 1)) (assert-eq (cells-at tc (+ (* c 16) 3)) 4 "section owns its spanning row")))
                (set j (+ j 1))))
          (set c (+ c 1))))
    (assert-eq hits 1 "section has exactly one owner")))

(deftest test-captioned-disconnected-panels-own-their-labels-before-tables
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 c 0]
    (while (< r 2)
      (do (set c 0)
          (while (< c 2)
            (do (let [^I32 x (+ 10000 (* c 12000)) ^I32 y (+ 10000 (* r 12000))]
                  (tt-rule pa x y (+ x 8000) (+ y 20))
                  (tt-rule pa x (+ y 9000) (+ x 8000) (+ y 9020))
                  (tt-rule pa x y (+ x 20) (+ y 9000))
                  (tt-rule pa (+ x 7980) y (+ x 8000) (+ y 9000))
                  (tt-at wd ln et (text-blob "Some") (+ x 4000) (+ y 1000) 0 0)
                  (tt-at wd ln et (text-blob "Lines") (+ x 500) (+ y 2300) 0 0)
                  (tt-at wd ln et (text-blob "Text") (+ x 4500) (+ y 2300) 0 0)
                  (tt-at wd ln et (text-blob "in") (+ x 500) (+ y 3600) 0 0)
                  (tt-at wd ln et (text-blob "Box") (+ x 4500) (+ y 3600) 0 0))
                (set c (+ c 1))))
          (set r (+ r 1))))
    (tt-at wd ln et (text-blob "Figure") 10000 32500 0 0)
    (tt-at wd ln et (text-blob "34.") 13500 32500 0 0)
    (tt-at wd ln et (text-blob "Alignment") 15500 32500 0 0)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 0 "one captioned diagram owns all panel labels; there are zero tables")))

;; D743: header ownership follows independently evidenced amount anchors.
(deftest test-adjacent-amount-headers-bind-to-their-own-values
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 c 0 ^:mut ^I32 debit -1 ^:mut ^I32 credit -1]
    (tt-at wd ln et (text-blob "Details") 7600 10000 1 0)
    (tt-word wd ln et (text-blob "Debit") 27160 10000 35320 10800 1)
    (tt-word wd ln et (text-blob "Credit") 35920 10000 45960 10800 1)
    (tt-at wd ln et (text-blob "Balance") 56600 10000 1 1)
    (while (< r 6)
      (do (tt-at wd ln et (text-blob "Transfer") 7600 (+ 12500 (* r 2200)) 0 0)
          (tt-at wd ln et (text-blob "15.00") 35320 (+ 12500 (* r 2200)) 0 1)
          (tt-at wd ln et (text-blob "20.00") 45960 (+ 12500 (* r 2200)) 0 1)
          (tt-at wd ln et (text-blob "100.00") 56600 (+ 12500 (* r 2200)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one four-column ledger owns every value once")
    (assert-eq (cells-at tb 8) 4 "headers do not change amount cuts")
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (if (== (cells-at tc (* c 16)) 0)
            (do (if (== (cells-at tc (+ (* c 16) 1)) 1) (set debit c))
                (if (== (cells-at tc (+ (* c 16) 1)) 2) (set credit c))))
          (set c (+ c 1))))
    (assert-that (>= debit 0) "debit header cell exists")
    (assert-that (>= credit 0) "credit header cell exists")
    (if (and (>= debit 0) (>= credit 0))
      (do (assert-eq (cells-at tc (+ (* debit 16) 9)) 1 "Debit owns only its own header word")
          (assert-eq (cells-at tw (cells-at tc (+ (* debit 16) 8))) 1 "Debit is over 15.00")
          (assert-eq (cells-at tc (+ (* credit 16) 9)) 1 "Credit is not an empty header")
          (if (> (cells-at tc (+ (* credit 16) 9)) 0)
            (assert-eq (cells-at tw (cells-at tc (+ (* credit 16) 8))) 2 "Credit is over 20.00"))))))

;; D744: a marginal band occupied only by a spanning total is not a data column.
(deftest test-a-spanning-total-does-not-create-an-extra-leading-column
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0]
    (tt-at wd ln et (text-blob "Industry") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "2023") 32000 10000 1 1)
    (tt-at wd ln et (text-blob "2022") 43000 10000 1 1)
    (tt-at wd ln et (text-blob "Total nonfarm") 5500 12500 0 0)
    (tt-at wd ln et (text-blob "158,424") 32000 12500 0 1)
    (tt-at wd ln et (text-blob "159,734") 43000 12500 0 1)
    (while (< r 6)
      (do (tt-at wd ln et (text-blob "Manufacturing") 7600 (+ 15000 (* r 2200)) 0 0)
          (tt-at wd ln et (text-blob "100.00") 32000 (+ 15000 (* r 2200)) 0 1)
          (tt-at wd ln et (text-blob "200.00") 43000 (+ 15000 (* r 2200)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one table owns all total and industry values once")
    (assert-eq (cells-at tb 8) 3 "the indented Industry and spanning Total share one stub column")))

(deftest test-one-genuine-spanning-amount-header-remains-a-spanner
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 c 0 ^:mut ^I32 found 0]
    (tt-at wd ln et (text-blob "Kind") 7600 10000 1 0)
    (tt-word wd ln et (text-blob "Combined") 27160 10000 33000 10800 1)
    (tt-word wd ln et (text-blob "Amounts") 33500 10000 45960 10800 1)
    (while (< r 6)
      (do (tt-at wd ln et (text-blob "Transfer") 7600 (+ 12500 (* r 2200)) 0 0)
          (tt-at wd ln et (text-blob "15.00") 35320 (+ 12500 (* r 2200)) 0 1)
          (tt-at wd ln et (text-blob "20.00") 45960 (+ 12500 (* r 2200)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one grouped amount table")
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (if (and (== (cells-at tc (* c 16)) 0) (> (cells-at tc (+ (* c 16) 9)) 0))
            (if (== (cells-at tw (cells-at tc (+ (* c 16) 8))) 1)
              (do (set found (+ found 1))
                  (assert-eq (cells-at tc (+ (* c 16) 3)) 2 "a single Amounts label still owns both numeric columns"))))
          (set c (+ c 1))))
    (assert-eq found 1 "the spanning label retains exactly one owner")))

;; D745: a partial two-date ledger continues past undated merchant details.
(deftest test-merchant-sublines-stay-in-their-dated-parent-rows
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells) ^Text t (new-text)
        ^:mut ^I32 r 0]
    (tt-rule pa 7000 9500 50000 9550)
    (tt-at wd ln et (text-blob "PostDate") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "TransDate") 15000 10000 1 0)
    (tt-at wd ln et (text-blob "Description") 26000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 49000 10000 1 1)
    (tt-rule pa 7000 11500 50000 11550)
    (while (< r 4)
      (do (tt-at wd ln et (text-blob "09/01") 7600 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "09/01") 15000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Merchant") 26000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "15.00") 49000 (+ 13000 (* r 5000)) 0 1)
          (tt-at wd ln et (text-blob "Reference") 30000 (+ 14200 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Submerchant") 26000 (+ 15400 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "0.00") 49000 (+ 15400 (* r 5000)) 0 1)
          (set r (+ r 1))))
    (tt-at wd ln et (text-blob "Unrelated prose") 7600 35000 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "ledger evidence is well formed")
    (assert-text t "T4w;Gh;R;Ch[PostDate];Ch[TransDate];Ch[Description];Ch[Amount];Gb;R;C[09/01];C[09/01];C[Merchant Reference Submerchant];C[15.00 0.00];R;C[09/01];C[09/01];C[Merchant Reference Submerchant];C[15.00 0.00];R;C[09/01];C[09/01];C[Merchant Reference Submerchant];C[15.00 0.00];R;C[09/01];C[09/01];C[Merchant Reference Submerchant];C[15.00 0.00];P[Unrelated prose];" "every merchant subline belongs to its preceding dated row and prose remains outside")))

(deftest test-a-wrapped-change-header-does-not-add-a-trailing-data-column
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0]
    (tt-word wd ln et (text-blob "Unadjusted") 25672 7017 33164 7712 0)
    (tt-word wd ln et (text-blob "Adjusted") 44361 7017 50650 7712 0)
    (tt-word wd ln et (text-blob "Industry") 11202 8713 13687 9408 0)
    (while (< q 8)
      (do (tt-word wd ln et (text-blob "Aug.") (+ 22668 (* q 4020)) 8838 (+ 24105 (* q 4020)) 9533 0)
          (tt-word wd ln et (text-blob "2026") (+ 22610 (* q 4020)) 9636 (+ 24163 (* q 4020)) 10331 0)
          (set q (+ q 1))))
    (tt-word wd ln et (text-blob "Change") 54321 8189 56767 8884 0)
    (tt-word wd ln et (text-blob "from:") 54748 8888 56339 9583 0)
    (tt-word wd ln et (text-blob "July2026") 53914 9586 56709 10281 0)
    (tt-word wd ln et (text-blob "-") 56942 9586 57174 10281 0)
    (tt-word wd ln et (text-blob "Aug.2026") 53896 10204 57191 10980 0)
    (while (< r 12)
      (do (tt-word wd ln et (text-blob "Industry") 4490 (+ 12056 (* r 963)) 21100 (+ 12751 (* r 963)) 0)
          (set q 0)
          (while (< q 8)
            (do (tt-word wd ln et (text-blob "100,000") (+ 21834 (* q 4020)) (+ 12056 (* r 963)) (+ 24359 (* q 4020)) (+ 12751 (* r 963)) 0)
                (set q (+ q 1))))
          (tt-word wd ln et (text-blob "127") 54673 (+ 12056 (* r 963)) 55838 (+ 12751 (* r 963)) 0)
          (set r (+ r 1))))
    (set r 0)
    (while (< r (wd-count wd)) (do (wd-set wd r (wf-size) 700) (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one table owns every original count once")
    (assert-eq (cells-at tb 8) 10 "one stub plus nine value columns; the wrapped header adds no data column")))

;; D746: wide statistical tables have unbolded uppercase group boundaries.
(deftest test-unbolded-demographic-groups-own-rows-above-their-values
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 c 0 ^:mut ^I32 groups 0]
    (tt-at wd ln et (text-blob "Status") 7600 10000 1 0)
    (while (< q 6)
      (do (tt-at wd ln et (text-blob "2026") (+ 24000 (* q 5000)) 10000 1 1)
          (set q (+ q 1))))
    (tt-at wd ln et (text-blob "TOTAL") 7600 12500 0 0)
    (while (< r 6)
      (do (if (== r 3) (tt-at wd ln et (text-blob "WHITE") 7600 (+ 13500 (* r 2200)) 0 0))
          (tt-at wd ln et (text-blob "Civilian") 7600 (+ 14500 (* r 2200)) 0 0)
          (set q 0)
          (while (< q 6)
            (do (tt-at wd ln et (text-blob "100.00") (+ 24000 (* q 5000)) (+ 14500 (* r 2200)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one statistical table owns all six value columns")
    (assert-eq (cells-at tb 8) 7 "no group creates a phantom numeric column")
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (if (and (> (cells-at tc (* c 16)) 0) (== (cells-at tc (+ (* c 16) 9)) 1))
            (if (or (== (cells-at tw (cells-at tc (+ (* c 16) 8))) 7)
                    (== (cells-at tw (cells-at tc (+ (* c 16) 8))) 29))
              (do (set groups (+ groups 1))
                  (assert-eq (cells-at tc (+ (* c 16) 3)) 7 "the group label has its own full-width row"))))
          (set c (+ c 1))))
    (assert-eq groups 2 "TOTAL and WHITE are independent of the following Civilian values")))

(defn ^I32 tt-word-owner [^Cells tb ^I32 k ^Cells tc ^Cells tw ^I32 word]
  (let [^I32 first (cells-at tb (+ (* k 32) 9)) ^I32 end (+ first (cells-at tb (+ (* k 32) 10)))
        ^:mut ^I32 c first ^:mut ^I32 i 0]
    (while (< c end)
      (do (set i 0)
          (while (< i (cells-at tc (+ (* c 16) 9)))
            (do (if (== (cells-at tw (+ (cells-at tc (+ (* c 16) 8)) i)) word) (return c))
                (set i (+ i 1))))
          (set c (+ c 1))))
    (return -1)))

(deftest test-uppercase-wrapped-stubs-are-not-demographic-groups
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 owner -1]
    (tt-at wd ln et (text-blob "Status") 7600 10000 1 0)
    (while (< q 6)
      (do (tt-at wd ln et (text-blob "2026") (+ 24000 (* q 5000)) 10000 1 1)
          (set q (+ q 1))))
    (while (< r 6)
      (do (if (== r 3) (tt-at wd ln et (text-blob "GROSS") 8350 20100 0 0))
          (tt-at wd ln et (text-blob "DOMESTIC") 7600 (+ 14500 (* r 2200)) 0 0)
          (set q 0)
          (while (< q 6)
            (do (tt-at wd ln et (text-blob "100.00") (+ 24000 (* q 5000)) (+ 14500 (* r 2200)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one table keeps its wrapped uppercase label")
    (set owner (tt-word-owner tb 0 tc tw 28))
    (assert-that (>= owner 0) "GROSS has a cell owner")
    (if (>= owner 0)
      (do (assert-eq (cells-at tc (+ (* owner 16) 3)) 1 "an uppercase continuation is not promoted to a spanning group")
          (assert-eq (cells-at tc (+ (* owner 16) 12)) 0 "an uppercase continuation has no proved-section flag")))))

(deftest test-a-long-two-date-ledger-stops-before-a-boxed-summary
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 k 0 ^:mut ^I32 ledger -1 ^:mut ^I32 owner -1]
    (tt-rule pa 7000 7500 50000 7550)
    (tt-at wd ln et (text-blob "ACTIVITY") 7600 8000 1 0)
    (tt-at wd ln et (text-blob "PostDate") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "TransDate") 15000 10000 1 0)
    (tt-at wd ln et (text-blob "Description") 26000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 49000 10000 1 1)
    (tt-rule pa 7000 11500 50000 11550)
    (while (< r 8)
      (do (tt-at wd ln et (text-blob "09/01") 7600 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "09/01") 15000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Merchant") 26000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "15.00") 49000 (+ 13000 (* r 5000)) 0 1)
          (tt-at wd ln et (text-blob "Reference") 30000 (+ 14200 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Submerchant") 26000 (+ 15400 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "0.00") 49000 (+ 15400 (* r 5000)) 0 1)
          (set r (+ r 1))))
    (tt-rule pa 23500 52600 46000 52650)
    (tt-rule pa 23500 58000 46000 58050)
    (tt-rule pa 23500 52600 23550 58000)
    (tt-rule pa 45950 52600 46000 58000)
    (tt-at wd ln et (text-blob "Totals") 24500 53200 1 0)
    (tt-at wd ln et (text-blob "Fees") 24500 54800 0 0)
    (tt-at wd ln et (text-blob "100.02") 45000 54800 0 1)
    (tt-at wd ln et (text-blob "Interest") 24500 56300 0 0)
    (tt-at wd ln et (text-blob "12.43") 45000 56300 0 1)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "the ledger and boxed summary have independent owners")
    (while (< k (quot (cells-len tb) 32))
      (do (if (>= (tt-word-owner tb k tc tw 0) 0) (set ledger k)) (set k (+ k 1))))
    (assert-that (>= ledger 0) "the dated ledger survives")
    (if (>= ledger 0)
      (do (assert-eq (cells-at tb (+ (* ledger 32) 8)) 4 "the ledger keeps four stable columns")
          (set r 0)
          (while (< r 8)
            (do (set owner (tt-word-owner tb ledger tc tw (+ 7 (* r 7))))
                (assert-that (>= owner 0) "the merchant has a parent row")
                (assert-eq owner (tt-word-owner tb ledger tc tw (+ 9 (* r 7))) "the reference stays in its merchant cell")
                (assert-eq owner (tt-word-owner tb ledger tc tw (+ 10 (* r 7))) "the undated merchant subline stays in its parent cell")
                (assert-eq (tt-word-owner tb ledger tc tw (+ 8 (* r 7))) (tt-word-owner tb ledger tc tw (+ 11 (* r 7))) "the printed zero remains in the parent amount cell")
                (set r (+ r 1))))
          (assert-eq (tt-word-owner tb ledger tc tw 63) -1 "the summary amount is outside the ledger")))))

(defn ^I32 tt-index-word [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 n ^I32 x ^I32 y ^I32 right]
  (if (== n 1) (do (tt-at wd ln et (text-blob "1") x y 0 right) (return 0)))
  (if (== n 2) (do (tt-at wd ln et (text-blob "2") x y 0 right) (return 0)))
  (if (== n 3) (do (tt-at wd ln et (text-blob "3") x y 0 right) (return 0)))
  (if (== n 4) (do (tt-at wd ln et (text-blob "4") x y 0 right) (return 0)))
  (if (== n 5) (do (tt-at wd ln et (text-blob "5") x y 0 right) (return 0)))
  (if (== n 6) (do (tt-at wd ln et (text-blob "6") x y 0 right) (return 0)))
  (if (== n 7) (do (tt-at wd ln et (text-blob "7") x y 0 right) (return 0)))
  (tt-at wd ln et (text-blob "8") x y 0 right)
  (return 0))

(defn ^I32 tt-numbered-shade [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa ^I32 base]
  (let [^:mut ^I32 r 0 ^:mut ^I32 y 0]
    (tt-rule pa 7000 (+ base 10000) 7050 (+ base 37600))
    (tt-rule pa 12000 (+ base 10000) 12050 (+ base 37600))
    (tt-rule pa 27000 (+ base 10000) 27050 (+ base 37600))
    (tt-rule pa 38000 (+ base 10000) 38050 (+ base 37600))
    (tt-rule pa 47000 (+ base 10000) 47050 (+ base 37600))
    (tt-rule pa 50000 (+ base 10000) 50050 (+ base 37600))
    (tt-fill pa 7000 (+ base 13800) 50000 (+ base 16600) 14737632)
    (tt-fill pa 7000 (+ base 21800) 50000 (+ base 24600) 14737632)
    (tt-fill pa 7000 (+ base 27000) 50000 (+ base 29800) 14737632)
    (tt-fill pa 7000 (+ base 32200) 50000 (+ base 35000) 14737632)
    (tt-at wd ln et (text-blob "Line") 7600 (+ base 11000) 0 0)
    (tt-at wd ln et (text-blob "Item") 13000 (+ base 11000) 0 0)
    (tt-at wd ln et (text-blob "2023") 32000 (+ base 11000) 0 1)
    (tt-at wd ln et (text-blob "2022") 43000 (+ base 11000) 0 1)
    (tt-at wd ln et (text-blob "Line") 49000 (+ base 11000) 0 1)
    (while (< r 8)
      (do (set y (+ base (+ 14000 (* r 2600))))
          (if (>= r 2) (set y (+ y 2800)))
          (tt-index-word wd ln et (+ r 1) 8000 y 0)
          (if (== r 1)
            (do (tt-at wd ln et (text-blob "Wrapped") 13000 y 0 0)
                (tt-index-word wd ln et (+ r 1) 49000 y 1)
                (tt-at wd ln et (text-blob "and") 13000 (+ y 1200) 0 0)
                (tt-at wd ln et (text-blob "Other") 13000 (+ y 2400) 0 0)
                (tt-at wd ln et (text-blob "Workers") 13000 (+ y 3600) 0 0)
                (tt-at wd ln et (text-blob "100.00") 32000 (+ y 3600) 0 1)
                (tt-at wd ln et (text-blob "200.00") 43000 (+ y 3600) 0 1))
            (do (tt-at wd ln et (text-blob "Workers") 13000 y 0 0)
                (tt-at wd ln et (text-blob "100.00") 32000 y 0 1)
                (tt-at wd ln et (text-blob "200.00") 43000 y 0 1)
                (tt-index-word wd ln et (+ r 1) 49000 y 1)))
          (set r (+ r 1))))
    (return 0)))

(deftest test-numbered-shading-keeps-tall-white-rows-and-the-final-row
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 c -1]
    (tt-numbered-shade wd ln et pa 0)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "one framed numbered table")
    (assert-eq (cells-at tb 8) 5 "the two year columns keep their own identities")
    (assert-eq (cells-at tb 7) 9 "header and all eight printed row numbers remain coherent")
    (assert-eq (tt-word-owner tb 0 tc tw 11) (tt-word-owner tb 0 tc tw 15) "the tall white row owns its entire wrapped stub")
    (set c (tt-word-owner tb 0 tc tw 45))
    (assert-that (>= c 0) "the final unshaded row's 2023 value is owned")
    (if (>= c 0) (assert-eq (cells-at tc (+ (* c 16) 1)) 2 "the final 100.00 stays under 2023"))
    (set c (tt-word-owner tb 0 tc tw 46))
    (assert-that (>= c 0) "the final unshaded row's 2022 value is owned")
    (if (>= c 0) (assert-eq (cells-at tc (+ (* c 16) 1)) 3 "the final 200.00 stays under 2022"))))

(deftest test-separate-numbered-frames-remain-separate-tables
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)]
    (tt-numbered-shade wd ln et pa 0)
    (tt-numbered-shade wd ln et pa 39000)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "adjacent independent frames cannot become one table")))

(deftest test-a-new-ledger-header-separates-a-withdrawal-from-account-totals
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 k 0 ^:mut ^I32 ledger -1 ^:mut ^I32 amount -1]
    (tt-rule pa 7000 9500 50000 9550)
    (tt-at wd ln et (text-blob "Total deposits") 7600 10000 0 0)
    (tt-at wd ln et (text-blob "2") 20000 10000 0 1)
    (tt-at wd ln et (text-blob "Total withdrawals") 30000 10000 0 0)
    (tt-at wd ln et (text-blob "3") 49000 10000 0 1)
    (tt-at wd ln et (text-blob "Deposit count") 7600 11300 0 0)
    (tt-at wd ln et (text-blob "Withdrawal count") 30000 11300 0 0)
    (tt-at wd ln et (text-blob "Deposit amount") 7600 13000 0 0)
    (tt-at wd ln et (text-blob "10.00") 20000 13000 0 1)
    (tt-at wd ln et (text-blob "Withdrawal amount") 30000 13000 0 0)
    (tt-at wd ln et (text-blob "20.00") 49000 13000 0 1)
    (tt-at wd ln et (text-blob "Credits") 7600 14300 0 0)
    (tt-at wd ln et (text-blob "Debits") 30000 14300 0 0)
    (tt-at wd ln et (text-blob "USD Savings Account") 7600 16000 1 0)
    (tt-at wd ln et (text-blob "817-002") 49000 16000 1 1)
    (tt-at wd ln et (text-blob "Date") 7600 18000 1 0)
    (tt-at wd ln et (text-blob "Details") 15000 18000 1 0)
    (tt-at wd ln et (text-blob "Deposit") 32000 18000 1 1)
    (tt-at wd ln et (text-blob "Withdrawal") 41000 18000 1 1)
    (tt-at wd ln et (text-blob "Balance") 50000 18000 1 1)
    (tt-at wd ln et (text-blob "D") 7600 19200 0 0)
    (tt-at wd ln et (text-blob "T") 15000 19200 0 0)
    (tt-at wd ln et (text-blob "C") 32000 19200 0 1)
    (tt-at wd ln et (text-blob "W") 41000 19200 0 1)
    (tt-at wd ln et (text-blob "B") 50000 19200 0 1)
    (tt-rule pa 7000 20700 50000 20750)
    (tt-at wd ln et (text-blob "20Sep") 7600 22000 0 0)
    (tt-at wd ln et (text-blob "Payment") 15000 22000 0 0)
    (tt-at wd ln et (text-blob "181.04") 41000 22000 0 1)
    (tt-at wd ln et (text-blob "149818.96") 50000 22000 0 1)
    (tt-at wd ln et (text-blob "Reference") 15000 23200 0 0)
    (tt-at wd ln et (text-blob "Merchant") 15000 24400 0 0)
    (tt-rule pa 7000 26000 50000 26050)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "totals and a newly headed ledger have different owners")
    (while (< k (quot (cells-len tb) 32))
      (do (set amount (tt-word-owner tb k tc tw 26))
          (if (>= amount 0)
            (do (set ledger k)
                (assert-eq (cells-at tb (+ (* k 32) 8)) 5 "the new ledger has five explicit columns")
                (assert-eq (cells-at tc (+ (* amount 16) 1)) 3 "181.04 belongs under Withdrawal")
                (assert-eq (tt-word-owner tb k tc tw 25) (tt-word-owner tb k tc tw 28) "the transaction owns its reference line")
                (assert-eq (tt-word-owner tb k tc tw 25) (tt-word-owner tb k tc tw 29) "the transaction owns its merchant continuation")
                (assert-eq (tt-word-owner tb k tc tw 7) -1 "the ledger does not own the previous account's total")
                (assert-eq (tt-word-owner tb k tc tw 12) -1 "the account title is outside the data grid")))
          (set k (+ k 1))))
    (assert-that (>= ledger 0) "the first USD transaction retains an independent ledger owner")))

;; D751: extending a ledger must not suppress unrelated rotated text.
(deftest test-ledger-growth-does-not-hide-unowned-rotated-text
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 k 0 ^:mut ^I32 owner -1]
    (tt-rule pa 7000 7500 50000 7550)
    (tt-at wd ln et (text-blob "ACTIVITY") 7600 8000 1 0)
    (tt-at wd ln et (text-blob "PostDate") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "TransDate") 15000 10000 1 0)
    (tt-at wd ln et (text-blob "Description") 26000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 49000 10000 1 1)
    (tt-rule pa 7000 11500 50000 11550)
    (while (< r 8)
      (do (tt-at wd ln et (text-blob "09/01") 7600 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "09/01") 15000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Merchant") 26000 (+ 13000 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "15.00") 49000 (+ 13000 (* r 5000)) 0 1)
          (tt-at wd ln et (text-blob "Reference") 30000 (+ 14200 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "Submerchant") 26000 (+ 15400 (* r 5000)) 0 0)
          (tt-at wd ln et (text-blob "0.00") 49000 (+ 15400 (* r 5000)) 0 1)
          (set r (+ r 1))))
    (tt-at wd ln et (text-blob "WATERMARK") 30000 30000 0 0)
    (wd-set wd 61 (hd-rot) 4500)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "the original ledger remains selected")
    (while (< k (quot (cells-len tb) 32))
      (do (set owner (tt-word-owner tb k tc tw 61))
          (assert-eq owner -1 "rotated context has no amount or description cell owner")
          (set k (+ k 1))))
    (assert-eq (ln-get ln 61 15) 0 "unowned rotated context remains outside claimed ledger lines")))

(deftest test-an-entry-grid-keeps-eleven-empty-rows-and-the-total-in-their-columns
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells an (new-cells) ^Text t (new-text) ^:mut ^I32 r 0 ^:mut ^I32 c 0]
    (comment "D757: a regular three-column entry ledger has eleven empty widget rows between its header and total. The adjacent open-label form remains covered by D583.")
    (while (<= r 12)
      (do (tt-rule pa 7200 (- (+ 10000 (* r 2000)) 50) 37200 (+ (+ 10000 (* r 2000)) 50)) (set r (+ r 1))))
    (tt-rule pa 7200 39950 37200 40050)
    (while (<= c 3)
      (do (tt-rule pa (- (+ 7200 (* c 10000)) 50) 10000 (+ (+ 7200 (* c 10000)) 50) 40000) (set c (+ c 1))))
    (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "Cost") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "Gain") 27600 10600 1 0)
    (tt-at wd ln et (text-blob "Total") 7600 34600 0 0)
    (tt-at wd ln et (text-blob "123") 17600 34600 0 0)
    (tt-at wd ln et (text-blob "456") 27600 34600 0 0)
    (tt-at wd ln et (text-blob "More") 7600 36600 0 0)
    (tt-at wd ln et (text-blob "234") 17600 36600 0 0)
    (tt-at wd ln et (text-blob "567") 27600 36600 0 0)
    (tt-at wd ln et (text-blob "End") 7600 38600 0 0)
    (tt-at wd ln et (text-blob "345") 17600 38600 0 0)
    (tt-at wd ln et (text-blob "678") 27600 38600 0 0)
    (let [^I32 totalat (cells-len an)]
      (tt-widget an 17600 38300 26600 39700)
      (cells-set an (+ totalat 8) 4))
    (set r 1)
    (while (<= r 11)
      (do (set c 0)
          (while (< c 3)
            (do (tt-widget an (+ 7600 (* c 10000)) (+ 10300 (* r 2000)) (+ 16600 (* c 10000)) (+ 11700 (* r 2000))) (set c (+ c 1))))
          (set r (+ r 1))))
    ;; A neighbouring checkbox is 1 pt above the grid: its appearance must not supply grid cuts.
    (tt-rule pa 8000 9050 8800 9150) (tt-rule pa 8000 9850 8800 9950)
    (tt-rule pa 7950 9100 8050 9900) (tt-rule pa 8750 9100 8850 9900)
    (let [^I32 at (cells-len an)]
      (tt-widget an 8000 9100 8800 9900)
      (cells-set an (+ at 8) 2))
    (assert-eq (tt-run-an wd ln et pa t 1 an) 0 "entry grid: valid Model")
    (assert-text t "T3r;Gh;R;Ch[Item];Ch[Cost];Ch[Gain];Gb;R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[];C[];C[];R;C[Total More End];C[123 234 345];C[456 567 678];"
                 "eleven rows survive, and total values stay under Cost and Gain")))

(defn ^I32 tt-widget-build [^Cells wd ^:mut ^Cells ln ^Cells et ^Cells pa ^:mut ^Cells tb ^:mut ^Cells tc ^:mut ^Cells tw ^Cells an]
  (let [^Cells pages (new-cells) ^Cells grl (new-cells) ^Cells gfl (new-cells)]
    (page-new pages 1 61200 79200 0 (pk-vector))
    (gf-doc pa (new-cells) (new-cells) (new-cells) 1 (gfx-mode) grl gfl (new-cells) (new-cells))
    (tb-build wd ln et grl gfl 1 tb tc tw (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells)
                        pages (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) an)
    (if (!= (tt-body-audit wd et tb tc tw) 0) (return -7))
    (return (quot (cells-len tb) 32))))

(deftest test-a-labelled-form-is-not-a-blank-entry-grid
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells an (new-cells) ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 c 0 ^:mut ^I32 k 0 ^:mut ^I32 ruled 0]
    (comment "D759: adjacent-form control. A label on every body row is not a repeated blank entry row, even when most cells hold widgets. Do not promote the whole form to a ruled grid.")
    (while (<= r 13)
      (do (tt-rule pa 7200 (- (+ 10000 (* r 2000)) 50) 37200 (+ (+ 10000 (* r 2000)) 50)) (set r (+ r 1))))
    (while (<= c 3)
      (do (tt-rule pa (- (+ 7200 (* c 10000)) 50) 10000 (+ (+ 7200 (* c 10000)) 50) 36000) (set c (+ c 1))))
    (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "Cost") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "Gain") 27600 10600 1 0)
    (set r 1)
    (while (<= r 11)
      (do (tt-at wd ln et (text-blob "Label") 7600 (+ 10600 (* r 2000)) 0 0)
          (set c 1)
          (while (< c 3)
            (do (tt-widget an (+ 7600 (* c 10000)) (+ 10300 (* r 2000)) (+ 16600 (* c 10000)) (+ 11700 (* r 2000))) (set c (+ c 1))))
          (set r (+ r 1))))
    (tt-at wd ln et (text-blob "Total") 7600 34600 0 0)
    (tt-at wd ln et (text-blob "123") 17600 34600 0 0)
    (tt-at wd ln et (text-blob "456") 27600 34600 0 0)
    (assert-that (>= (tt-widget-build wd ln et pa tb tc tw an) 0) "all source words retain an owner")
    (while (< k (quot (cells-len tb) 32))
      (do (if (== (cells-at tb (+ (* k 32) 5)) 1) (set ruled 1)) (set k (+ k 1))))
    (assert-eq ruled 0 "labels and scattered widgets do not prove a blank entry lattice")))

;; D769: labels must own the intended row, even when all tokens survive.
(deftest test-equally-spaced-incoming-stub-owns-the-following-values
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 label -1 ^:mut ^I32 tail -1 ^:mut ^I32 value -1]
    (tt-at wd ln et (text-blob "Description") 4500 10000 1 0)
    (while (< q 3)
      (do (tt-at wd ln et (text-blob "2023") (+ 35000 (* q 7000)) 10000 1 1) (set q (+ q 1))))
    (while (< r 6)
      (do (if (== r 4)
            (do (set label (wd-count wd))
                (tt-at wd ln et (text-blob "Net earnings attributable to company") 4500 19000 1 0)))
          (if (== r 4) (set tail (wd-count wd)))
          (tt-at wd ln et (text-blob "shareholders") 4500 (+ 12000 (* r 2000)) 0 0)
          (if (== r 4) (set value (wd-count wd)))
          (set q 0)
          (while (< q 3)
            (do (if (== q 0)
                  (tt-at wd ln et (text-blob "96,223") (+ 35000 (* q 7000)) (+ 12000 (* r 2000)) 0 1)
                  (if (== q 1)
                    (tt-at wd ln et (text-blob "(22,759)") (+ 35000 (* q 7000)) (+ 12000 (* r 2000)) 0 1)
                    (tt-at wd ln et (text-blob "89,937") (+ 35000 (* q 7000)) (+ 12000 (* r 2000)) 0 1)))
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one financial table")
    (let [^I32 owner (tt-word-owner tb 0 tc tw label)
          ^I32 tailowner (tt-word-owner tb 0 tc tw tail)
          ^I32 valueowner (tt-word-owner tb 0 tc tw value)]
      (assert-that (>= owner 0) "incoming stub is owned")
      (assert-eq owner tailowner "complete net earnings label shares one cell")
      (assert-eq (cells-at tc (* owner 16)) (cells-at tc (* valueowner 16)) "net earnings label owns 96,223")
      (set q 0)
      (while (< q 3)
        (do (let [^I32 amountowner (tt-word-owner tb 0 tc tw (+ value q))]
              (assert-eq (cells-at tc (* amountowner 16)) (cells-at tc (* owner 16)) "each signed earnings value belongs to the complete label")
              (assert-eq (cells-at tc (+ (* amountowner 16) 1)) (+ q 1) "each earnings value keeps its year column"))
            (set q (+ q 1)))))))

(deftest test-centred-mixed-case-subgroup-has-an-independent-row
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 group -1 ^:mut ^I32 before -1 ^:mut ^I32 after -1]
    (tt-at wd ln et (text-blob "Status") 7600 10000 1 0)
    (while (< q 6)
      (do (tt-at wd ln et (text-blob "2026") (+ 26000 (* q 5000)) 10000 1 1) (set q (+ q 1))))
    (tt-at wd ln et (text-blob "TOTAL") 7600 12500 0 0)
    (while (< r 6)
      (do (if (== r 3)
            (do (set group (wd-count wd))
                (tt-word wd ln et (text-blob "Men, 20 years and over") 8526 20000 16366 20700 0)
                (set after (wd-count wd))))
          (if (== r 2) (set before (wd-count wd)))
          (tt-word wd ln et (text-blob "Civilian........................") 4490 (+ 14500 (* r 2200)) 21100 (+ 15200 (* r 2200)) 0)
          (set q 0)
          (while (< q 6)
            (do (tt-at wd ln et (text-blob "100.00") (+ 26000 (* q 5000)) (+ 14500 (* r 2200)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one statistical table")
    (let [^I32 owner (tt-word-owner tb 0 tc tw group)
          ^I32 beforeowner (tt-word-owner tb 0 tc tw before)
          ^I32 afterowner (tt-word-owner tb 0 tc tw after)]
      (assert-that (>= owner 0) "subgroup has an owner")
      (assert-eq (cells-at tc (+ (* owner 16) 9)) 1 "subgroup owns only its label")
      (assert-that (!= (cells-at tc (* owner 16)) (cells-at tc (* beforeowner 16))) "preceding values exclude subgroup")
      (assert-that (!= (cells-at tc (* owner 16)) (cells-at tc (* afterowner 16))) "following values exclude subgroup"))))

(deftest test-a-centred-number-is-not-a-statistical-subgroup
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 group -1]
    (tt-at wd ln et (text-blob "Status") 7600 10000 1 0)
    (while (< q 6)
      (do (tt-at wd ln et (text-blob "2026") (+ 26000 (* q 5000)) 10000 1 1) (set q (+ q 1))))
    (tt-at wd ln et (text-blob "TOTAL") 7600 12500 0 0)
    (while (< r 6)
      (do (if (== r 3)
            (do (set group (wd-count wd))
                (tt-word wd ln et (text-blob "12345") 8526 20000 16366 20700 0)
                ))
          (tt-word wd ln et (text-blob "Civilian........................") 4490 (+ 14500 (* r 2200)) 21100 (+ 15200 (* r 2200)) 0)
          (set q 0)
          (while (< q 6)
            (do (tt-at wd ln et (text-blob "100.00") (+ 26000 (* q 5000)) (+ 14500 (* r 2200)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one statistical table")
    (let [^I32 owner (tt-word-owner tb 0 tc tw group)]
      (assert-that (>= owner 0) "subgroup has an owner")
      (assert-eq (cells-at tc (+ (* owner 16) 3)) 1 "a centred count has no full-width section span")
      (assert-eq (cells-at tc (+ (* owner 16) 12)) 0 "a numeric label has no section proof"))))

;; D775: the final transaction owns aligned description spill below its frame.
(deftest test-ledger-description-spill-keeps-its-final-transaction-owner
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 k 0 ^:mut ^I32 ledger -1 ^:mut ^I32 amount -1]
    (tt-rule pa 7000 9500 50000 9550)
    (tt-at wd ln et (text-blob "Total deposits") 7600 10000 0 0)
    (tt-at wd ln et (text-blob "2") 20000 10000 0 1)
    (tt-at wd ln et (text-blob "Total withdrawals") 30000 10000 0 0)
    (tt-at wd ln et (text-blob "3") 49000 10000 0 1)
    (tt-at wd ln et (text-blob "Deposit count") 7600 11300 0 0)
    (tt-at wd ln et (text-blob "Withdrawal count") 30000 11300 0 0)
    (tt-at wd ln et (text-blob "Deposit amount") 7600 13000 0 0)
    (tt-at wd ln et (text-blob "10.00") 20000 13000 0 1)
    (tt-at wd ln et (text-blob "Withdrawal amount") 30000 13000 0 0)
    (tt-at wd ln et (text-blob "20.00") 49000 13000 0 1)
    (tt-at wd ln et (text-blob "Credits") 7600 14300 0 0)
    (tt-at wd ln et (text-blob "Debits") 30000 14300 0 0)
    (tt-at wd ln et (text-blob "USD Savings Account") 7600 16000 1 0)
    (tt-at wd ln et (text-blob "817-002") 49000 16000 1 1)
    (tt-at wd ln et (text-blob "Date") 7600 18000 1 0)
    (tt-at wd ln et (text-blob "Details") 15000 18000 1 0)
    (tt-at wd ln et (text-blob "Deposit") 32000 18000 1 1)
    (tt-at wd ln et (text-blob "Withdrawal") 41000 18000 1 1)
    (tt-at wd ln et (text-blob "Balance") 50000 18000 1 1)
    (tt-at wd ln et (text-blob "D") 7600 19200 0 0)
    (tt-at wd ln et (text-blob "T") 15000 19200 0 0)
    (tt-at wd ln et (text-blob "C") 32000 19200 0 1)
    (tt-at wd ln et (text-blob "W") 41000 19200 0 1)
    (tt-at wd ln et (text-blob "B") 50000 19200 0 1)
    (tt-rule pa 7000 20700 50000 20750)
    (tt-at wd ln et (text-blob "20Sep") 7600 22000 0 0)
    (tt-at wd ln et (text-blob "Payment") 15000 22000 0 0)
    (tt-at wd ln et (text-blob "181.04") 41000 22000 0 1)
    (tt-at wd ln et (text-blob "149818.96") 50000 22000 0 1)
    (tt-at wd ln et (text-blob "Reference") 15000 23250 0 0)
    (tt-at wd ln et (text-blob "Merchant") 15000 24450 0 0)
    (tt-rule pa 7000 23200 50000 23250)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "totals and a newly headed ledger have different owners")
    (while (< k (quot (cells-len tb) 32))
      (do (set amount (tt-word-owner tb k tc tw 26))
          (if (>= amount 0)
            (do (set ledger k)
                (assert-eq (cells-at tb (+ (* k 32) 8)) 5 "the new ledger has five explicit columns")
                (assert-eq (cells-at tc (+ (* amount 16) 1)) 3 "181.04 belongs under Withdrawal")
                (assert-eq (tt-word-owner tb k tc tw 25) (tt-word-owner tb k tc tw 28) "the transaction owns its reference line")
                (assert-eq (tt-word-owner tb k tc tw 25) (tt-word-owner tb k tc tw 29) "the transaction owns its merchant continuation")
                (assert-eq (tt-word-owner tb k tc tw 7) -1 "the ledger does not own the previous account's total")
                (assert-eq (tt-word-owner tb k tc tw 12) -1 "the account title is outside the data grid")))
          (set k (+ k 1))))
    (assert-that (>= ledger 0) "the first USD transaction retains an independent ledger owner")))


(deftest test-ledger-does-not-claim-offset-prose-below-its-frame
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 k 0 ^:mut ^I32 ledger -1 ^:mut ^I32 amount -1]
    (tt-rule pa 7000 9500 50000 9550)
    (tt-at wd ln et (text-blob "Total deposits") 7600 10000 0 0)
    (tt-at wd ln et (text-blob "2") 20000 10000 0 1)
    (tt-at wd ln et (text-blob "Total withdrawals") 30000 10000 0 0)
    (tt-at wd ln et (text-blob "3") 49000 10000 0 1)
    (tt-at wd ln et (text-blob "Deposit count") 7600 11300 0 0)
    (tt-at wd ln et (text-blob "Withdrawal count") 30000 11300 0 0)
    (tt-at wd ln et (text-blob "Deposit amount") 7600 13000 0 0)
    (tt-at wd ln et (text-blob "10.00") 20000 13000 0 1)
    (tt-at wd ln et (text-blob "Withdrawal amount") 30000 13000 0 0)
    (tt-at wd ln et (text-blob "20.00") 49000 13000 0 1)
    (tt-at wd ln et (text-blob "Credits") 7600 14300 0 0)
    (tt-at wd ln et (text-blob "Debits") 30000 14300 0 0)
    (tt-at wd ln et (text-blob "USD Savings Account") 7600 16000 1 0)
    (tt-at wd ln et (text-blob "817-002") 49000 16000 1 1)
    (tt-at wd ln et (text-blob "Date") 7600 18000 1 0)
    (tt-at wd ln et (text-blob "Details") 15000 18000 1 0)
    (tt-at wd ln et (text-blob "Deposit") 32000 18000 1 1)
    (tt-at wd ln et (text-blob "Withdrawal") 41000 18000 1 1)
    (tt-at wd ln et (text-blob "Balance") 50000 18000 1 1)
    (tt-at wd ln et (text-blob "D") 7600 19200 0 0)
    (tt-at wd ln et (text-blob "T") 15000 19200 0 0)
    (tt-at wd ln et (text-blob "C") 32000 19200 0 1)
    (tt-at wd ln et (text-blob "W") 41000 19200 0 1)
    (tt-at wd ln et (text-blob "B") 50000 19200 0 1)
    (tt-rule pa 7000 20700 50000 20750)
    (tt-at wd ln et (text-blob "20Sep") 7600 22000 0 0)
    (tt-at wd ln et (text-blob "Payment") 15000 22000 0 0)
    (tt-at wd ln et (text-blob "181.04") 41000 22000 0 1)
    (tt-at wd ln et (text-blob "149818.96") 50000 22000 0 1)
    (tt-at wd ln et (text-blob "Reference") 17000 23250 0 0)
    (tt-at wd ln et (text-blob "Merchant") 17000 24450 0 0)
    (tt-rule pa 7000 23200 50000 23250)
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "totals and a newly headed ledger have different owners")
    (while (< k (quot (cells-len tb) 32))
      (do (set amount (tt-word-owner tb k tc tw 26))
          (if (>= amount 0)
            (do (set ledger k)
                (assert-eq (cells-at tb (+ (* k 32) 8)) 5 "the new ledger has five explicit columns")
                (assert-eq (cells-at tc (+ (* amount 16) 1)) 3 "181.04 belongs under Withdrawal")
                (assert-eq (tt-word-owner tb k tc tw 28) -1 "offset prose remains outside the ledger")
                (assert-eq (tt-word-owner tb k tc tw 29) -1 "later offset prose remains outside the ledger")
                (assert-eq (tt-word-owner tb k tc tw 7) -1 "the ledger does not own the previous account's total")
                (assert-eq (tt-word-owner tb k tc tw 12) -1 "the account title is outside the data grid")))
          (set k (+ k 1))))
    (assert-that (>= ledger 0) "the first USD transaction retains an independent ledger owner")))


;; D777: ownership precedes continuation, even with identical columns/headers.
(defn ^I32 tt-currency-links [^Blob first ^Blob second]
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^:mut ^I32 p 1 ^:mut ^I32 r 0]
    (while (<= p 2)
      (do (if (== p 1)
            (tt-atp wd ln et first 7600 10000 0 0 p)
            (tt-atp wd ln et second 7600 10000 0 0 p))
          (tt-cols5 wd ln et p 11600 1 (text-blob "Date") (text-blob "Details") (text-blob "Debit") (text-blob "Credit") (text-blob "Balance"))
          (set r 0)
          (while (< r 6)
            (do (tt-cols5 wd ln et p (+ 13200 (* r 1600)) 0 (text-blob "02 Jan") (text-blob "Salary") (text-blob "") (text-blob "10.33") (text-blob "10,609.03"))
                (set r (+ r 1))))
          (set p (+ p 1))))
    (return (tt-count-an wd ln et pa t 2 (new-cells)))))

(deftest test-two-currency-ledgers-link-by-their-own-columns
  (do
    (assert-eq (tt-currency-links (text-blob "HKD current account 817 890692 838")
                                (text-blob "HKD current account 817 890692 838 (Continued)")) 1
               "a matching account signature explains the continued context above the next header")
    (assert-eq (tt-currency-links (text-blob "HKD current account 817 890692 838")
                                (text-blob "USD current account 817 890692 838 (Continued)")) 2
               "identical headers and columns never merge different currency accounts")
    (assert-eq (tt-currency-links (text-blob "HKD current account 817 890692 838")
                                (text-blob "HKD current account 817 890692 839")) 2
               "different account numbers refuse even without a continued marker")))

(defn ^I32 tt-explained-forward [^I32 prose ^I32 wrong ^I32 foot]
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0]
    (tt-cols5 wd ln et 1 10000 0 (text-blob "Date") (text-blob "Description") (text-blob "Withdrawal") (text-blob "Deposit") (text-blob "Balance"))
    (tt-rule pa 7600 12300 22000 12350)
    (tt-rule pa 7600 13950 22000 14000)
    (tt-rule pa 7600 12300 7650 14000)
    (tt-rule pa 21950 12300 22000 14000)
    (tt-at wd ln et (text-blob "CURRENCY SGD") 8000 12500 0 0)
    (if (== prose 1) (tt-at wd ln et (text-blob "Unexplained ordinary prose") 8000 16500 0 0))
    (if (== prose 2) (tt-at wd ln et (text-blob "Ordinary prose amount") 15000 14500 0 0)
                    (tt-at wd ln et (text-blob "Balance Brought Forward") 15000 14500 0 0))
    (if (== wrong 1) (tt-at wd ln et (text-blob "91.00") 48800 14500 0 1)
                    (tt-at wd ln et (text-blob "90.00") 48800 14500 0 1))
    (while (< r 6)
      (do (tt-cols5 wd ln et 1 (+ 19000 (* r 1600)) 0 (text-blob "02 Jan") (text-blob "Salary") (text-blob "1.00") (text-blob "10.33") (text-blob "99.33"))
          (set r (+ r 1))))
    (if (> foot 0)
      (do (tt-at wd ln et (text-blob "Balance Carried Forward") 7600 30900 0 0)
          (if (== foot 3)
            (do (tt-at wd ln et (text-blob "61.98") 25000 30900 0 1)
                (tt-at wd ln et (text-blob "6.00") 35000 30900 0 1))
            (do (if (== foot 2) (tt-at wd ln et (text-blob "6.01") 25000 30900 0 1)
                                (tt-at wd ln et (text-blob "6.00") 25000 30900 0 1))
                (tt-at wd ln et (text-blob "61.98") 35000 30900 0 1)))
          (tt-at wd ln et (text-blob "99.33") 45000 30900 0 1)))
    (tt-ruled-build wd ln et pa tb tc tw)
    (set r 0)
    (while (< r (quot (cells-len tb) 32))
      (do (if (> foot 0)
            (do (if (and (> (cells-at tb (+ (* r 32) 12)) 0)
                         (!= (bit-and (cells-at tb (+ (* r 32) 31)) 4) 0)) (return 1)))
            (if (> (cells-at tb (+ (* r 32) 22)) 0) (return 1)))
          (set r (+ r 1))))
    (return 0)))

(deftest test-explained-header-refuses-prose-and-a-broken-opening-identity
  (do (assert-eq (tt-explained-forward 1 0 0) 0 "unexplained prose prevents reaching past it for a header")
      (assert-eq (tt-explained-forward 0 1 0) 0 "a forward row without the opening identity is unexplained")
      (assert-eq (tt-explained-forward 2 0 0) 0 "an unrelated prose amount is not a forward row even when its value fits the identity")
      (assert-eq (tt-explained-forward 0 0 0) 1 "a boxed label and arithmetically placed opening row explain the header gap")))

(deftest test-carried-forward-requires-column-sums-in-monotone-order
  (do (assert-eq (tt-explained-forward 0 0 2) 0 "a carried amount differing from its column sum stays outside the ledger")
      (assert-eq (tt-explained-forward 0 0 3) 0 "swapping withdrawal and deposit sums must not swap their semantic columns")
      (assert-eq (tt-explained-forward 0 0 1) 1 "offset carried amounts use column sums and the closing balance in monotone order")))

(defn ^I32 tt-screening [^:mut ^Text t ^I32 closed]
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^:mut ^I32 r 0]
    (comment "D783: large gaps inside a fully bordered response cell do not move its alternatives into another row or discard the question grid.")
    (while (<= r 4)
      (do (tt-rule pa 10000 (- (+ 20000 (* r 4000)) 25) 50000 (+ (+ 20000 (* r 4000)) 25))
          (set r (+ r 1))))
    (tt-rule pa 9975 20000 10025 36000)
    (if (== closed 1) (tt-rule pa 29975 20000 30025 36000))
    (tt-rule pa 49975 20000 50025 36000)
    (tt-word wd ln et (text-blob "Question") 10500 20500 15000 21300 1)
    (tt-word wd ln et (text-blob "Response") 30500 20500 35000 21300 1)
    (set r 1)
    (while (< r 4)
      (do (if (== r 1)
            (tt-word wd ln et (text-blob "Will project one collect") 10500 (+ 20500 (* r 4000)) 27000 (+ 21300 (* r 4000)) 0)
            (if (== r 2)
              (tt-word wd ln et (text-blob "Will project two collect") 10500 (+ 20500 (* r 4000)) 27000 (+ 21300 (* r 4000)) 0)
              (tt-word wd ln et (text-blob "Will project three collect") 10500 (+ 20500 (* r 4000)) 27000 (+ 21300 (* r 4000)) 0)))
          (tt-word wd ln et (text-blob "personal information?") 10500 (+ 21700 (* r 4000)) 27000 (+ 22500 (* r 4000)) 0)
          (tt-word wd ln et (text-blob "Yes") 30500 (+ 20500 (* r 4000)) 32000 (+ 21300 (* r 4000)) 0)
          (tt-word wd ln et (text-blob "No") 45500 (+ 20500 (* r 4000)) 46500 (+ 21300 (* r 4000)) 0)
          (set r (+ r 1))))
    (return (tt-run wd ln et pa t))))

(deftest test-a-closed-screening-grid-owns-wrapped-questions-and-spaced-responses
  (let [^Text t (new-text)]
    (assert-eq (tt-screening t 1) 0 "screening grid is well formed")
    (assert-text t "T2r;Gh;R;Ch[Question];Ch[Response];Gb;R;C[Will project one collect personal information?];C[Yes No];R;C[Will project two collect personal information?];C[Yes No];R;C[Will project three collect personal information?];C[Yes No];" "each complete question and both response values belong to the same ruled row")))

(deftest test-response-gaps-without-a-complete-grid-keep-their-column-analysis
  (let [^Text t (new-text)]
    (assert-eq (tt-screening t 0) 0 "open grid is well formed")
    (assert-text t "T3p;Gh;R;Ch[Question];Ch[Response];Ch[];Gb;R;C[Will project one collect personal information?];C[Yes];C[No];R;C[Will project two collect personal information?];C[Yes];C[No];R;C[Will project three collect personal information?];C[Yes];C[No];" "unruled alternatives remain independent columns")))

;; D808: header roles require entry-grid ownership, including exact value columns.
(deftest test-an-entry-grid-owns-two-unbold-header-rows-before-empty-fields
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells an (new-cells) ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0 ^:mut ^I32 c 0]
    (comment "D757: a regular three-column entry ledger has eleven empty widget rows between its header and total. The adjacent open-label form remains covered by D583.")
    (while (<= r 12)
      (do (tt-rule pa 7200 (- (+ 10000 (* r 2000)) 50) 37200 (+ (+ 10000 (* r 2000)) 50)) (set r (+ r 1))))
    (tt-rule pa 7200 39950 37200 40050)
    (while (<= c 3)
      (do (tt-rule pa (- (+ 7200 (* c 10000)) 50) 10000 (+ (+ 7200 (* c 10000)) 50) 40000) (set c (+ c 1))))
    (tt-at wd ln et (text-blob "1 Item") 7600 10600 0 0)
    (tt-at wd ln et (text-blob "Cost") 17600 10600 0 0)
    (tt-at wd ln et (text-blob "Gain") 27600 10600 0 0)
    (tt-at wd ln et (text-blob "Total") 7600 34600 0 0)
    (tt-at wd ln et (text-blob "123") 17600 34600 0 0)
    (tt-at wd ln et (text-blob "456") 27600 34600 0 0)
    (tt-at wd ln et (text-blob "More") 7600 36600 0 0)
    (tt-at wd ln et (text-blob "234") 17600 36600 0 0)
    (tt-at wd ln et (text-blob "567") 27600 36600 0 0)
    (tt-at wd ln et (text-blob "End") 7600 38600 0 0)
    (tt-at wd ln et (text-blob "345") 17600 38600 0 0)
    (tt-at wd ln et (text-blob "678") 27600 38600 0 0)
    (let [^I32 totalat (cells-len an)]
      (tt-widget an 17600 38300 26600 39700)
      (cells-set an (+ totalat 8) 4))
    (tt-at wd ln et (text-blob "Code") 7600 12600 0 0)
    (tt-at wd ln et (text-blob "Basis") 17600 12600 0 0)
    (tt-at wd ln et (text-blob "Adjustment") 27600 12600 0 0)
    (set r 2)
    (while (<= r 11)
      (do (set c 0)
          (while (< c 3)
            (do (tt-widget an (+ 7600 (* c 10000)) (+ 10300 (* r 2000)) (+ 16600 (* c 10000)) (+ 11700 (* r 2000))) (set c (+ c 1))))
          (set r (+ r 1))))
    ;; A neighbouring checkbox is 1 pt above the grid: its appearance must not supply grid cuts.
    (tt-rule pa 8000 9050 8800 9150) (tt-rule pa 8000 9850 8800 9950)
    (tt-rule pa 7950 9100 8050 9900) (tt-rule pa 8750 9100 8850 9900)
    (let [^I32 at (cells-len an)]
      (tt-widget an 8000 9100 8800 9900)
      (cells-set an (+ at 8) 2))
    (assert-eq (tt-widget-build wd ln et pa tb tc tw an) 1 "one entry grid owns every source word")
    (assert-eq (cells-at tb 11) 2 "both unbold rows are column headers before the blank entry rows")
    (assert-eq (cells-at tb 7) 13 "headers, ten entries and the original wrapped total survive")
    (let [^I32 first (cells-at tb 9)]
      (assert-eq (cells-at tc (+ (* first 16) 10)) 1 "Item is a column header")
      (assert-eq (cells-at tc (+ (* (+ first 3) 16) 10)) 1 "Code is a column header")
      (assert-eq (tt-word-owner tb 0 tc tw 0) first "Item owns its original first column")
      (assert-eq (tt-word-owner tb 0 tc tw 4) (+ first 37) "123 stays in the total Cost cell"))))


;; D810: filled entry values remain body cells.
(deftest test-filled-entry-fields-cannot-be-promoted-to-column-headers
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells an (new-cells) ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0 ^:mut ^I32 c 0]
    (comment "D757: a regular three-column entry ledger has eleven empty widget rows between its header and total. The adjacent open-label form remains covered by D583.")
    (while (<= r 12)
      (do (tt-rule pa 7200 (- (+ 10000 (* r 2000)) 50) 37200 (+ (+ 10000 (* r 2000)) 50)) (set r (+ r 1))))
    (tt-rule pa 7200 39950 37200 40050)
    (while (<= c 3)
      (do (tt-rule pa (- (+ 7200 (* c 10000)) 50) 10000 (+ (+ 7200 (* c 10000)) 50) 40000) (set c (+ c 1))))
    (tt-at wd ln et (text-blob "123") 7600 10600 0 0)
    (tt-at wd ln et (text-blob "456") 17600 10600 0 0)
    (tt-at wd ln et (text-blob "789") 27600 10600 0 0)
    (tt-at wd ln et (text-blob "Total") 7600 34600 0 0)
    (tt-at wd ln et (text-blob "123") 17600 34600 0 0)
    (tt-at wd ln et (text-blob "456") 27600 34600 0 0)
    (tt-at wd ln et (text-blob "More") 7600 36600 0 0)
    (tt-at wd ln et (text-blob "234") 17600 36600 0 0)
    (tt-at wd ln et (text-blob "567") 27600 36600 0 0)
    (tt-at wd ln et (text-blob "End") 7600 38600 0 0)
    (tt-at wd ln et (text-blob "345") 17600 38600 0 0)
    (tt-at wd ln et (text-blob "678") 27600 38600 0 0)
    (let [^I32 totalat (cells-len an)]
      (tt-widget an 17600 38300 26600 39700)
      (cells-set an (+ totalat 8) 4))
    (tt-at wd ln et (text-blob "234") 7600 12600 0 0)
    (tt-at wd ln et (text-blob "567") 17600 12600 0 0)
    (tt-at wd ln et (text-blob "890") 27600 12600 0 0)
    (set r 0)
    (while (< r 2)
      (do (set c 0)
          (while (< c 3)
            (do (tt-widget an (+ 7600 (* c 10000)) (+ 10300 (* r 2000)) (+ 16600 (* c 10000)) (+ 11700 (* r 2000))) (set c (+ c 1))))
          (set r (+ r 1))))
    (set r 2)
    (while (<= r 11)
      (do (set c 0)
          (while (< c 3)
            (do (tt-widget an (+ 7600 (* c 10000)) (+ 10300 (* r 2000)) (+ 16600 (* c 10000)) (+ 11700 (* r 2000))) (set c (+ c 1))))
          (set r (+ r 1))))
    ;; A neighbouring checkbox is 1 pt above the grid: its appearance must not supply grid cuts.
    (tt-rule pa 8000 9050 8800 9150) (tt-rule pa 8000 9850 8800 9950)
    (tt-rule pa 7950 9100 8050 9900) (tt-rule pa 8750 9100 8850 9900)
    (let [^I32 at (cells-len an)]
      (tt-widget an 8000 9100 8800 9900)
      (cells-set an (+ at 8) 2))
    (assert-eq (tt-widget-build wd ln et pa tb tc tw an) 1 "one entry grid owns every source word")
    (assert-eq (cells-at tb 11) 0 "entered values in widgets are body rows before the remaining blank fields")
    (assert-eq (cells-at tb 7) 13 "two filled entries, ten blank entries and the original total survive")
    (let [^I32 first (cells-at tb 9)]
      (assert-eq (cells-at tc (+ (* first 16) 10)) 0 "123 is a body value")
      (assert-eq (cells-at tc (+ (* (+ first 3) 16) 10)) 0 "234 is a body value")
      (assert-eq (tt-word-owner tb 0 tc tw 0) first "123 owns its original first column")
      (assert-eq (tt-word-owner tb 0 tc tw 4) (+ first 37) "the original total stays in its second column"))))
