    (tt-at wd ln et (text-blob "May") 30000 12000 0 0)
    (tt-at wd ln et (text-blob "Test") 7600 13600 0 0)
    (tt-at wd ln et (text-blob "Ben") 20000 13600 0 0)
    (tt-at wd ln et (text-blob "June") 30000 13600 0 0)
    (tt-at wd ln et (text-blob "Ship") 7600 15200 0 0)
    (tt-at wd ln et (text-blob "Chen") 20000 15200 0 0)
    (tt-at wd ln et (text-blob "July") 30000 15200 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "shaded: well formed")
    (assert-text t "T3s;Gh;R;Ch[Task];Ch[Owner];Ch[Due];Gb;R;C[Build];C[Ana];C[May];R;C[Test];C[Ben];C[June];R;C[Ship];C[Chen];C[July];"
                 "four bands of fill of one extent, two colours: rows from the bands")))

(defn ^I32 tt-zebra [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa]
  (comment "Three stripes of one colour with a plain row between them and the body rows in them (a zebra, 1600 a row), and no")
  (comment "stripe under the header row: the stack of fills begins at y 11600 and the header row is above it (D503).")
  (tt-fill pa 7200 11600 37200 13200 15000000)
  (tt-fill pa 7200 14800 37200 16400 15000000)
  (tt-fill pa 7200 18000 37200 19600 15000000)
  (tt-at wd ln et (text-blob "Build") 7600 12000 0 0)
  (tt-at wd ln et (text-blob "Ana") 20000 12000 0 0)
  (tt-at wd ln et (text-blob "May") 30000 12000 0 0)
  (tt-at wd ln et (text-blob "Test") 7600 13600 0 0)
  (tt-at wd ln et (text-blob "Ben") 20000 13600 0 0)
  (tt-at wd ln et (text-blob "June") 30000 13600 0 0)
  (tt-at wd ln et (text-blob "Ship") 7600 15200 0 0)
  (tt-at wd ln et (text-blob "Chen") 20000 15200 0 0)
  (tt-at wd ln et (text-blob "July") 30000 15200 0 0)
  (tt-at wd ln et (text-blob "Pack") 7600 16800 0 0)
  (tt-at wd ln et (text-blob "Dee") 20000 16800 0 0)
  (tt-at wd ln et (text-blob "Aug") 30000 16800 0 0)
  (tt-at wd ln et (text-blob "Done") 7600 18400 0 0)
  (tt-at wd ln et (text-blob "Eli") 20000 18400 0 0)
  (tt-at wd ln et (text-blob "Sept") 30000 18400 0 0)
  (return 0))

(deftest test-the-plain-row-above-a-zebra-is-its-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-zebra wd ln et pa)
    (tt-at wd ln et (text-blob "Task") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Owner") 20000 10000 1 0)
    (tt-at wd ln et (text-blob "Due") 30000 10000 1 0)
    (assert-eq (tt-run wd ln et pa t) 0 "zebra header: well formed")
    (assert-text t "T3s;Gh;R;Ch[Task];Ch[Owner];Ch[Due];Gb;R;C[Build];C[Ana];C[May];R;C[Test];C[Ben];C[June];R;C[Ship];C[Chen];C[July];R;C[Pack];C[Dee];C[Aug];R;C[Done];C[Eli];C[Sept];"
                 "the row of cells above the first stripe, one gap from it, is the table's header row, not paragraphs (D503)")))

(deftest test-a-line-of-prose-above-a-zebra-is-not-its-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-zebra wd ln et pa)
    (tt-at wd ln et (text-blob "Orders ship free of charge") 7600 10000 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "zebra prose: well formed")
    (assert-text t "P[Orders ship free of charge];T3s;Gb;R;C[Build];C[Ana];C[May];R;C[Test];C[Ben];C[June];R;C[Ship];C[Chen];C[July];R;C[Pack];C[Dee];C[Aug];R;C[Done];C[Eli];C[Sept];"
                 "one chunk of prose above the stripes is a paragraph, and the stripes are the table (D503)")))

;; ---------------------------------------------------------- caption and foot

(deftest test-a-caption-and-a-bold-last-row
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-line3 wd ln et (text-blob "Table") (text-blob "2.") (text-blob "Results") 7200 8400)
    (tt-grid pa 7200 17200 27200 37200 10000 12000 14000 16000)
    (tt-at wd ln et (text-blob "A") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "B") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "C") 27600 10600 1 0)
    (tt-at wd ln et (text-blob "x") 7600 12600 0 0)
    (tt-at wd ln et (text-blob "1") 17600 12600 0 0)
    (tt-at wd ln et (text-blob "2") 27600 12600 0 0)
    (tt-at wd ln et (text-blob "Sum") 7600 14600 0 0)
    (tt-at wd ln et (text-blob "3") 17600 14600 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "caption: well formed")
    (assert-text t "T3r;K[Table 2|Results];Gh;R;Ch[A];Ch[B];Ch[C];Gb;R;Cs[x];C[1];C[2];R;Cs[Sum];Cc2[3];"
                 "the caption is the table's first child: label and text, not a paragraph")))

;; ------------------------------------- a table's last column is not a note (D469)

(defn ^I32 tt-small [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 x ^I32 y ^I32 size]
  (comment "One word and a line of its own, 500 per character, `size` tall (a note's small type).")
  (let [^I32 w0 (wd-count wd)
        ^I32 x1 (+ x (* 500 (blob-len b)))]
    (tt-tw wd et b x y x1 (+ y size) 0 size (ln-count ln))
    (ln-new ln 1 x y x1 (+ y size) x (- (+ y size) 200) x1 (- (+ y size) 200) 0 0 w0 1)
    (return 0)))

(defn ^I32 tt-ledger-page [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa]
  (comment "Four lines of a paragraph that end at x 26000, then a ruled 3 x 3 table to x 37200 whose last column's words stand")
  (comment "right of where the paragraph ends (the shape of the `ttab-*` and `gfx-*` documents: a narrow last column).")
  (tt-word wd ln et (text-blob "The table below was extracted from the ledger") 7200 4000 26000 4800 0)
  (tt-word wd ln et (text-blob "and the figures are totals for the quarter") 7200 5200 26000 6000 0)
  (tt-word wd ln et (text-blob "of the year as the office has recorded them") 7200 6400 26000 7200 0)
  (tt-word wd ln et (text-blob "and as the auditors have since confirmed.") 7200 7600 26000 8400 0)
  (tt-rule pa 7200 9950 37200 10050)
  (tt-rule pa 7200 11950 37200 12050)
  (tt-rule pa 7200 13950 37200 14050)
  (tt-rule pa 7200 15950 37200 16050)
  (tt-rule pa 7150 10000 7250 16000)
  (tt-rule pa 17150 10000 17250 16000)
  (tt-rule pa 27150 10000 27250 16000)
  (tt-rule pa 37150 10000 37250 16000)
  (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
  (tt-at wd ln et (text-blob "Qty") 17600 10600 1 0)
  (tt-small wd ln et (text-blob "Note") 27600 10600 900)
  (tt-at wd ln et (text-blob "Bolt") 7600 12600 0 0)
  (tt-at wd ln et (text-blob "10") 17600 12600 0 0)
  (tt-small wd ln et (text-blob "up") 27600 12600 900)
  (tt-at wd ln et (text-blob "Nut") 7600 14600 0 0)
  (tt-at wd ln et (text-blob "12") 17600 14600 0 0)
  (tt-small wd ln et (text-blob "flat") 27600 14600 900)
  (return 0))

(deftest test-the-last-column-of-a-table-is-its-cells-and-not-a-note
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-ledger-page wd ln et pa)
    (assert-eq (tt-run wd ln et pa t) 0 "last column: well formed")
    (assert-text t "P[The table below was extracted from the ledger and the figures are totals for the quarter of the year as the office has recorded them and as the auditors have since confirmed.];T3r;Gb;R;C[Item];C[Qty];Cs[Note];R;C[Bolt];C[10];Cs[up];R;C[Nut];C[12];Cs[flat];"
                 "the words of the last column stand right of the paragraph and are the table's cells: no note repeats them (D469; a text layer's too, as a scan's in D463)")))

(deftest test-a-note-beside-a-table-is-still-a-note
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-ledger-page wd ln et pa)
    (comment "A note in small type left of the table (the paragraph and the table begin at 7200), beside the row of Bolt: not a")
    (comment "cell, so a note. (Right of the table it would be one run with the last column's small words, which a table holds.)")
    (tt-small wd ln et (text-blob "see note") 1500 12600 700)
    (assert-eq (tt-run wd ln et pa t) 0 "note: well formed")
    (assert-text t "P[The table below was extracted from the ledger and the figures are totals for the quarter of the year as the office has recorded them and as the auditors have since confirmed.];N;P[see note];T3r;Gb;R;C[Item];C[Qty];Cs[Note];R;C[Bolt];C[10];Cs[up];R;C[Nut];C[12];Cs[flat];"
                 "a note beside the table, outside it, is a note of its own, and the cells are still the table's")))

;; -------------------------------- a side fragment a table holds in part (D504)

(defn ^I32 tt-headless-page [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa]
  (comment "The ledger page whose table lacks its first row: the rules begin under the header, so the header's small word `Note`")
  (comment "in the last column is not held while the values under it are (the side fragment is held in part).")
  (tt-word wd ln et (text-blob "The table below was extracted from the ledger") 7200 4000 26000 4800 0)
  (tt-word wd ln et (text-blob "and the figures are totals for the quarter") 7200 5200 26000 6000 0)
  (tt-word wd ln et (text-blob "of the year as the office has recorded them") 7200 6400 26000 7200 0)
  (tt-word wd ln et (text-blob "and as the auditors have since confirmed.") 7200 7600 26000 8400 0)
  (tt-rule pa 7200 11950 37200 12050)
  (tt-rule pa 7200 13950 37200 14050)
  (tt-rule pa 7200 15950 37200 16050)
  (tt-rule pa 7150 12000 7250 16000)
  (tt-rule pa 17150 12000 17250 16000)
  (tt-rule pa 27150 12000 27250 16000)
  (tt-rule pa 37150 12000 37250 16000)
  (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
  (tt-at wd ln et (text-blob "Qty") 17600 10600 1 0)
  (tt-small wd ln et (text-blob "Note") 27600 10600 900)
  (tt-at wd ln et (text-blob "Bolt") 7600 12600 0 0)
  (tt-at wd ln et (text-blob "10") 17600 12600 0 0)
  (tt-small wd ln et (text-blob "up") 27600 12600 900)
  (tt-at wd ln et (text-blob "Nut") 7600 14600 0 0)
  (tt-at wd ln et (text-blob "12") 17600 14600 0 0)
  (tt-small wd ln et (text-blob "flat") 27600 14600 900)
  (return 0))

(deftest test-a-side-fragment-held-in-part-with-one-word-left-is-no-note
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-headless-page wd ln et pa)
    (assert-eq (tt-run wd ln et pa t) 0 "held in part: well formed")
    (assert-text t "P[The table below was extracted from the ledger and the figures are totals for the quarter of the year as the office has recorded them and as the auditors have since confirmed.];P[Note];P[Item];P[Qty];T3r;Gb;R;C[Bolt];C[10];Cs[up];R;C[Nut];C[12];Cs[flat];"
                 "the header's `Note` is the one word the table does not hold, too little for a note, so it is body text and not lost, and `up` and `flat` are not written twice (D504)")))

(deftest test-a-side-fragment-held-in-part-is-a-note-of-the-lines-left
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-headless-page wd ln et pa)
    (tt-small wd ln et (text-blob "see") 27600 9000 900)
    (tt-small wd ln et (text-blob "the") 27600 9800 900)
    (assert-eq (tt-run wd ln et pa t) 0 "held in part, words left: well formed")
    (assert-text t "P[The table below was extracted from the ledger and the figures are totals for the quarter of the year as the office has recorded them and as the auditors have since confirmed.];N;P[see the Note];P[Item];P[Qty];T3r;Gb;R;C[Bolt];C[10];Cs[up];R;C[Nut];C[12];Cs[flat];"
                 "the lines the table does not hold are a note and the ones it holds stay in the table (D504)")))

;; ------------------------- a statement whose rows are ruled in part, with styled headers (D557)

(defn ^I32 tt-bank-rules-at [^:mut ^Cells pa ^I32 y0 ^I32 rows]
  (comment "`rows` + 1 row borders of a statement, drawn as the HTML-to-PDF producers do: under the first three cells of each row only (the date, the")
  (comment "description and the category: three abutting segments from x 5910 to 38670), the first at y0 and one every 2025 below it.")
  (let [^:mut ^I32 r 0
        ^:mut ^I32 y y0]
    (while (<= r rows)
      (do (tt-rule pa 5910 (- y 38) 9150 (+ y 38))
          (tt-rule pa 9150 (- y 38) 32910 (+ y 38))
          (tt-rule pa 32910 (- y 38) 38670 (+ y 38))
          (set y (+ y 2025))
          (set r (+ r 1))))
    (return 0)))

(defn ^I32 tt-bank-rules [^:mut ^Cells pa ^I32 rows]
  (comment "The row borders of a statement (`tt-bank-rules-at`), the first at y 21345, and two vertical rules in the header's band only (x 38707")
  (comment "and 46342), the amount cell's borders. Nothing is ruled under the last two cells.")
  (tt-bank-rules-at pa 21345 rows)
  (tt-rule pa 38669 19455 38745 21308)
  (tt-rule pa 46304 19455 46380 21308)
  (return 0))

(defn ^I32 tt-sized [^:mut ^Cells wd ^I32 size]
  (comment "Give the word just added the type size `size`.")
  (let [^I32 last (- (wd-count wd) 1)]
    (wd-set wd last (wf-size) size)
    (return 0)))

(defn ^I32 tt-bank-row [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^I32 bold ^I32 size ^Blob d ^Blob desc ^Blob cat ^Blob amt ^Blob bal]
  (comment "One row of the statement at y, in type of `size`: date and description at the left (bold when `bold`), the category left of x 38000,")
  (comment "the amount right-aligned to 45221 and the balance to 55379; a blank blob leaves the cell out.")
  (if (> (blob-len d) 0) (do (tt-at wd ln et d 5910 y bold 0) (tt-sized wd size)))
  (if (> (blob-len desc) 0) (do (tt-at wd ln et desc 10230 y bold 0) (tt-sized wd size)))
  (if (> (blob-len cat) 0) (do (tt-at wd ln et cat 35689 y 0 0) (tt-sized wd size)))
  (if (> (blob-len amt) 0) (do (tt-at wd ln et amt 45221 y 0 1) (tt-sized wd size)))
  (if (> (blob-len bal) 0) (do (tt-at wd ln et bal 55379 y bold 1) (tt-sized wd size)))
  (return 0))

(defn ^I32 tt-bank-page [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa ^I32 header]
  (comment "A statement: a small header row (not bold, 700 against the body's 800, a pitch of more than 2.4 sizes above the first row) above the")
  (comment "first rule when `header` is 1, a bold opening row, three transactions and a closing row, ruled as `tt-bank-rules` says.")
  (tt-bank-rules pa 5)
  (if (== header 1)
    (tt-bank-row wd ln et 19700 0 700 (text-blob "DATE") (text-blob "DESCRIPTION") (text-blob "CATEGORY") (text-blob "AMOUNT") (text-blob "BALANCE")))
  (tt-bank-row wd ln et 21745 1 800 (text-blob "Sep 1") (text-blob "Opening Balance") (text-blob "") (text-blob "") (text-blob "$10,989.78"))
  (tt-bank-row wd ln et 23770 0 800 (text-blob "Sep 2") (text-blob "Withdrawal CAPITAL ONE") (text-blob "Debit") (text-blob "- $803.85") (text-blob "$10,185.93"))
  (tt-bank-row wd ln et 25795 0 800 (text-blob "Sep 4") (text-blob "Zelle sent CAMERON") (text-blob "Debit") (text-blob "- $1,500.00") (text-blob "$8,685.93"))
  (tt-bank-row wd ln et 27820 0 800 (text-blob "Sep 14") (text-blob "Deposit from KESTRAL") (text-blob "Credit") (text-blob "+ $3,982.04") (text-blob "$12,667.97"))
  (tt-bank-row wd ln et 29845 0 800 (text-blob "Sep 30") (text-blob "Closing Balance") (text-blob "") (text-blob "") (text-blob "$12,667.97"))
  (return 0))

(deftest test-a-ruled-in-part-statement-keeps-its-amount-and-balance-columns-and-its-styled-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-bank-page wd ln et pa 1)
    (assert-eq (tt-run wd ln et pa t) 0 "statement: well formed")
    (assert-text t "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];"
                 "the amount and balance columns are the table's (the rows are ruled under three cells only), the header is the small row above the first rule, and the bold opening row is a body row")))

(deftest test-a-column-past-a-gutter-or-a-rule-or-another-tables-rules-is-not-the-tables
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text) ^Text t3 (new-text)]
    (comment "A memo in the margin, further right of the balance than the widest gap inside the table (9500 against 14600): not a column.")
    (tt-bank-page wd ln et pa 1)
    (tt-at wd ln et (text-blob "memo") 70000 23770 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "gutter: well formed")
    (assert-text t "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[memo];"
                 "a word beyond a gutter is left out")
    (comment "A vertical rule down every row between the amount and the balance: the amounts are the table's, the balances are not.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-page wd ln et pa 1)
    (tt-rule pa 47950 19455 48050 31000)
    (assert-eq (tt-run wd ln et pa t2) 0 "rule: well formed")
    (assert-text t2 "T4p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];P[BALANCE];P[$10,989.78];P[$10,185.93 $8,685.93 $12,667.97 $12,667.97];"
                 "a rule that spans the rows ends the reach: the amounts are inside it, the balances beyond it are not")
    (comment "Another table's rules on the same rows, to the right: its words are its own.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-page wd ln et pa 1)
    (tt-rule pa 41000 23332 60000 23408)
    (tt-rule pa 41000 25357 60000 25433)
    (assert-eq (tt-run wd ln et pa t3) 0 "neighbour: well formed")
    (assert-text t3 "T4p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Ch[];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];C[];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];C[];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];C[];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];C[];R;Cs[Sep 30];Cs[Closing Balance];Cs[];C[];P[AMOUNT];P[BALANCE];P[$10,989.78];P[- $803.85];P[$10,185.93];P[- $1,500.00];P[$8,685.93];P[+ $3,982.04];P[$12,667.97 $12,667.97];"
                 "another table's rules on the same rows, to the right, keep the table from reaching over: its words are not this table's (the table is what it was)")))

(deftest test-a-line-above-a-partial-table-that-does-not-line-up-with-it-is-not-its-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Two chunks above the first rule, a little further than a line of text but nowhere near the columns' edges: paragraphs.")
    (tt-bank-page wd ln et pa 0)
    (tt-at wd ln et (text-blob "Statement") 7000 19700 0 0)
    (tt-at wd ln et (text-blob "Page 2") 41000 19700 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "stray line: well formed")
    (assert-text t "P[Statement];P[Page 2];T5p;Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];"
                 "a line that does not line up with the columns is not a header; the bold opening row is a row of amounts, not a header")))

;; ------------- the last row with no rule under it, and tables of one chain that are two (D559)

(defn ^I32 tt-bank-table [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa ^I32 y0 ^I32 rows ^I32 header ^I32 n]
  (comment "A statement table whose first border is at y0 (the layout of `tt-bank-page`): `rows` + 1 borders, the small header row above the first")
  (comment "when `header` is 1, the two vertical rules of its band, and the first `n` of its five rows at y0 + 400 and one every 2025 below it: the bold")
  (comment "opening row, three transactions and the closing row (y0 + 8500). With 4 `rows` and 5 `n` the closing row stands under the last border")
  (comment "(nothing is ruled under it), with 5 it is between two.")
  (tt-bank-rules-at pa y0 rows)
  (tt-rule pa 38669 (- y0 1890) 38745 (- y0 37))
  (tt-rule pa 46304 (- y0 1890) 46380 (- y0 37))
  (if (== header 1)
    (tt-bank-row wd ln et (- y0 1645) 0 700 (text-blob "DATE") (text-blob "DESCRIPTION") (text-blob "CATEGORY") (text-blob "AMOUNT") (text-blob "BALANCE")))
  (if (>= n 1)
    (tt-bank-row wd ln et (+ y0 400) 1 800 (text-blob "Sep 1") (text-blob "Opening Balance") (text-blob "") (text-blob "") (text-blob "$10,989.78")))
  (if (>= n 2)
    (tt-bank-row wd ln et (+ y0 2425) 0 800 (text-blob "Sep 2") (text-blob "Withdrawal CAPITAL ONE") (text-blob "Debit") (text-blob "- $803.85") (text-blob "$10,185.93")))
  (if (>= n 3)
    (tt-bank-row wd ln et (+ y0 4450) 0 800 (text-blob "Sep 4") (text-blob "Zelle sent CAMERON") (text-blob "Debit") (text-blob "- $1,500.00") (text-blob "$8,685.93")))
  (if (>= n 4)
    (tt-bank-row wd ln et (+ y0 6475) 0 800 (text-blob "Sep 14") (text-blob "Deposit from KESTRAL") (text-blob "Credit") (text-blob "+ $3,982.04") (text-blob "$12,667.97")))
  (if (>= n 5)
    (tt-bank-row wd ln et (+ y0 8500) 0 800 (text-blob "Sep 30") (text-blob "Closing Balance") (text-blob "") (text-blob "") (text-blob "$12,667.97")))
  (return 0))

(defn ^I32 tt-bank-small [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa ^I32 y0 ^I32 rows]
  (comment "A second, small statement table with the same columns, its first border at y0: `rows` + 1 borders, its header, an opening row and a")
  (comment "withdrawal, and the closing row at y0 + 4450 (under the last border when `rows` is 2, between two when it is 3).")
  (tt-bank-rules-at pa y0 rows)
  (tt-rule pa 38669 (- y0 1890) 38745 (- y0 37))
  (tt-rule pa 46304 (- y0 1890) 46380 (- y0 37))
  (tt-bank-row wd ln et (- y0 1645) 0 700 (text-blob "DATE") (text-blob "DESCRIPTION") (text-blob "CATEGORY") (text-blob "AMOUNT") (text-blob "BALANCE"))
  (tt-bank-row wd ln et (+ y0 400) 1 800 (text-blob "Sep 1") (text-blob "Opening Balance") (text-blob "") (text-blob "") (text-blob "$0.10"))
  (tt-bank-row wd ln et (+ y0 2425) 0 800 (text-blob "Sep 9") (text-blob "Withdrawal rejected") (text-blob "") (text-blob "") (text-blob "$0.10"))
  (tt-bank-row wd ln et (+ y0 4450) 0 800 (text-blob "Sep 30") (text-blob "Closing Balance") (text-blob "") (text-blob "") (text-blob "$0.10"))
  (return 0))

(deftest test-the-last-row-of-a-partial-table-with-no-rule-under-it-stays-in-the-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The closing row stands under the last border, at the pitch of the rows, and lines up with the columns: a row of the table.")
    (tt-bank-table wd ln et pa 21345 4 1 5)
    (assert-eq (tt-run wd ln et pa t) 0 "closing row: well formed")
    (assert-text t "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];"
                 "a row below the last rule that lines up with the table's columns, at its pitch, is the table's (before: a table of four columns, the row three paragraphs under it)")))

(deftest test-a-line-below-a-partial-table-is-no-row-of-it-unless-it-lines-up-and-keeps-the-pitch
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text)]
    (comment "A line of one chunk under the last border: a paragraph.")
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-at wd ln et (text-blob "Page 2 of 4") 5910 31870 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "one chunk: well formed")
    (assert-text t "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Page 2 of 4];"
                 "a line of one chunk under the table is not a row of it")
    (comment "Two chunks that do not line up with the columns: paragraphs.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-at wd ln et (text-blob "Statement") 7000 31870 0 0)
    (tt-at wd ln et (text-blob "Page 2") 41000 31870 0 0)
    (assert-eq (tt-run wd ln et pa t2) 0 "stray: well formed")
    (assert-text t2 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Statement];P[Page 2];"
                  "two chunks that do not line up with the columns are not a row")
    (comment "A row that lines up with the columns but stands twelve sizes under the last row: not the table's.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-bank-row wd ln et 40000 0 800 (text-blob "Sep 30") (text-blob "Closing Balance") (text-blob "") (text-blob "") (text-blob "$12,667.97"))
    (assert-eq (tt-run wd ln et pa t3) 0 "far: well formed")
    (assert-text t3 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Sep 30];P[Closing Balance];P[$12,667.97];"
                  "a row far under the table is not its row")
    (comment "A summary block under the table, in its last columns (an invoice's totals): it lines up with the columns but does not begin in the first.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-bank-row wd ln et 31870 0 800 (text-blob "") (text-blob "") (text-blob "Total due") (text-blob "") (text-blob "$12,667.97"))
    (assert-eq (tt-run wd ln et pa t4) 0 "totals: well formed")
    (assert-text t4 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Total due];P[$12,667.97];"
                  "a row of the last columns under the table is a block of its own, not a row of the table (an invoice's totals)")))

(deftest test-two-tables-of-a-chain-of-rules-are-two-when-a-heading-a-grid-or-a-gap-lies-between
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text)]
    (comment "A heading, in larger type, between two tables whose rules are 154 pt apart: two tables, the heading a paragraph.")
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-bank-row wd ln et 38000 1 1200 (text-blob "Second account") (text-blob "") (text-blob "") (text-blob "") (text-blob ""))
    (tt-bank-small wd ln et pa 46870 3)
    (assert-eq (tt-run wd ln et pa t) 0 "heading: well formed")
    (assert-text t "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Second account];T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Ch[AMOUNT];Ch[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];C[];C[];C[$0.10];R;Cs[Sep 9];Cs[Withdrawal rejected];C[];C[];C[$0.10];R;Cs[Sep 30];Cs[Closing Balance];C[];C[];C[$0.10];"
                 "a heading in larger type between two grids of one chain makes two tables (before: one, the second's rows colspan rows of the first)")
    (comment "A row of another grid (three chunks that do not line up with the columns, in the same type) between them.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-at wd ln et (text-blob "0.10%") 6700 38000 0 0)
    (tt-at wd ln et (text-blob "$3.54") 24000 38000 0 0)
    (tt-at wd ln et (text-blob "30") 41000 38000 0 0)
    (tt-bank-small wd ln et pa 46870 3)
    (assert-eq (tt-run wd ln et pa t2) 0 "grid: well formed")
    (assert-text t2 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[0.10%];P[$3.54];P[30];T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Ch[AMOUNT];Ch[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];C[];C[];C[$0.10];R;Cs[Sep 9];Cs[Withdrawal rejected];C[];C[];C[$0.10];R;Cs[Sep 30];Cs[Closing Balance];C[];C[];C[$0.10];"
                  "a row between the grids that does not line up with the first one's columns makes them two")
    (comment "Nothing between them but a gap of white space many rows deep (the second table's header is the only row there).")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 5 1 5)
    (tt-bank-small wd ln et pa 46870 3)
    (assert-eq (tt-run wd ln et pa t3) 0 "gap: well formed")
    (assert-text t3 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Ch[AMOUNT];Ch[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];C[];C[];C[$0.10];R;Cs[Sep 9];Cs[Withdrawal rejected];C[];C[];C[$0.10];R;Cs[Sep 30];Cs[Closing Balance];C[];C[];C[$0.10];"
                  "a white gap of many rows between two grids makes them two")
    (comment "The statement: both closing rows under their last border, a heading between.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-bank-table wd ln et pa 21345 4 1 5)
    (tt-bank-row wd ln et 38000 1 1200 (text-blob "Second account") (text-blob "") (text-blob "") (text-blob "") (text-blob ""))
    (tt-bank-small wd ln et pa 46870 2)
    (assert-eq (tt-run wd ln et pa t4) 0 "statement: well formed")
    (assert-text t4 "T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Che[AMOUNT];Che[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];Cs[];Ce[];Ce[$10,989.78];R;Cs[Sep 2];Cs[Withdrawal CAPITAL ONE];Cs[Debit];Ce[- $803.85];Ce[$10,185.93];R;Cs[Sep 4];Cs[Zelle sent CAMERON];Cs[Debit];Ce[- $1,500.00];Ce[$8,685.93];R;Cs[Sep 14];Cs[Deposit from KESTRAL];Cs[Credit];Ce[+ $3,982.04];Ce[$12,667.97];R;Cs[Sep 30];Cs[Closing Balance];Cs[];Ce[];Ce[$12,667.97];P[Second account];T5p;Gh;R;Chs[DATE];Chs[DESCRIPTION];Ch[CATEGORY];Ch[AMOUNT];Ch[BALANCE];Gb;R;Cs[Sep 1];Cs[Opening Balance];C[];C[];C[$0.10];R;Cs[Sep 9];Cs[Withdrawal rejected];C[];C[];C[$0.10];R;Cs[Sep 30];Cs[Closing Balance];C[];C[];C[$0.10];"
                  "the two together: two tables, each with its closing row")))

;; ---------------------------------------- a vertical rule that spans the rows is a column cut (D559)

(defn ^I32 tt-cut-row [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^Blob a ^Blob b ^Blob c ^I32 style]
  (comment "A row of three cells at y: `a` at x 7600, `b` ending at 26800 and `c` beginning at 27200 (400 apart: one chunk of the row's text),")
  (comment "all in `style` (0 plain, 1 bold).")
  (tt-at wd ln et a 7600 y style 0)
  (tt-at wd ln et b 26800 y style 1)
  (tt-at wd ln et c 27200 y style 0)
  (return 0))

(deftest test-a-vertical-rule-between-two-words-that-touch-is-a-column-cut
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text)]
    (comment "Partial: four borders and a rule down the rows between the two words that touch.")
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-rule pa 27000 10000 27100 16000)
    (tt-cut-row wd ln et 10600 (text-blob "Bolt") (text-blob "Debit") (text-blob "$803") 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t) 0 "rule: well formed")
    (assert-text t "T3p;Gb;R;C[Bolt];C[Debit];Cs[$803];R;C[Nut];C[Debit];Cs[$91];R;C[Gear];C[Paid];Cs[$1,200];"
                 "the rule runs the three rows: the cells on its two sides are two (before: one cell `Debit $803`, two columns)")
    (comment "Without the rule the words are one cell.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-cut-row wd ln et 10600 (text-blob "Bolt") (text-blob "Debit") (text-blob "$803") 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t2) 0 "no rule: well formed")
    (assert-text t2 "T2p;Gb;R;C[Bolt];C[Debit $803];R;C[Nut];C[Debit $91];R;C[Gear];C[Paid $1,200];"
                 "no rule, no cut: the touching words are one cell")
    (comment "A rule beside one row only is no column cut (it spans one row of three).")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-rule pa 27000 10000 27100 12000)
    (tt-cut-row wd ln et 10600 (text-blob "Bolt") (text-blob "Debit") (text-blob "$803") 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t3) 0 "short rule: well formed")
    (assert-text t3 "T2p;Gb;R;C[Bolt];C[Debit $803];R;C[Nut];C[Debit $91];R;C[Gear];C[Paid $1,200];"
                 "a rule beside one row of three cuts nothing")
    (comment "A rule through the words is a strike or a frame, not the border between two cells.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-rule pa 25500 10000 25600 16000)
    (tt-cut-row wd ln et 10600 (text-blob "Bolt") (text-blob "Debit") (text-blob "$803") 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t4) 0 "through the words: well formed")
    (assert-text t4 "T2p;Gb;R;C[Bolt];C[Debit $803];R;C[Nut];C[Debit $91];R;C[Gear];C[Paid $1,200];"
                 "a rule through the words cuts nothing")))

(deftest test-a-rule-cuts-only-the-rows-it-runs-along
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text)]
    (comment "D563, the shape of the 1040's dependents block: a label of one phrase on the first row, `(b) And in the U.S.`, whose words the")
    (comment "rule below would fall between (a check box's border, or a column's, runs down the rows under the label and not through it):")
    (comment "the rule is a column boundary for the rows it runs along, and the label is one cell.")
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-rule pa 27000 12000 27100 16000)
    (tt-at wd ln et (text-blob "Item") 7600 10600 0 0)
    (tt-at wd ln et (text-blob "(b) And") 26800 10600 0 1)
    (tt-at wd ln et (text-blob "in the U.S.") 27200 10600 0 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t) 0 "label: well formed")
    (assert-text t "T3p;Gb;R;C[Item];Cc2[(b) And in the U.S.];R;C[Nut];C[Debit];Cs[$91];R;C[Gear];C[Paid];Cs[$1,200];"
                 "the label is one cell over the two columns the rule makes below it (before: two cells, the phrase cut in two)")
    (comment "A rule that runs along the label's row and the others cuts it, as before.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 13950 37200 14050)
    (tt-rule pa 7200 15950 37200 16050)
    (tt-rule pa 27000 10000 27100 16000)
    (tt-at wd ln et (text-blob "Item") 7600 10600 0 0)
    (tt-at wd ln et (text-blob "(b) And") 26800 10600 0 1)
    (tt-at wd ln et (text-blob "in the U.S.") 27200 10600 0 0)
    (tt-cut-row wd ln et 12600 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14600 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (assert-eq (tt-run wd ln et pa t2) 0 "label cut: well formed")
    (assert-text t2 "T3p;Gb;R;C[Item];Ce[(b) And];Cs[in the U.S.];R;C[Nut];Ce[Debit];Cs[$91];R;C[Gear];Ce[Paid];Cs[$1,200];"
                  "a rule along all three rows is between the label's two words too")))

(deftest test-a-vertical-rule-cuts-the-columns-of-a-table-without-horizontal-rules
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Whitespace: the same, with no horizontal rule at all (the rule is handed to the profile of the words alone).")
    (tt-cut-row wd ln et 10000 (text-blob "Item") (text-blob "Kind") (text-blob "Price") 1)
    (tt-cut-row wd ln et 11600 (text-blob "Bolt") (text-blob "Debit") (text-blob "$803") 0)
    (tt-cut-row wd ln et 13200 (text-blob "Nut") (text-blob "Debit") (text-blob "$91") 0)
    (tt-cut-row wd ln et 14800 (text-blob "Gear") (text-blob "Paid") (text-blob "$1,200") 0)
    (tt-cut-row wd ln et 16400 (text-blob "Cog") (text-blob "Debit") (text-blob "$35") 0)
    (tt-rule pa 27000 9800 27100 17400)
    (assert-eq (tt-run wd ln et pa t) 0 "whitespace: well formed")
    (assert-text t "T3w;Gh;R;Ch[Item];Ch[Kind];Chs[Price];Gb;R;C[Bolt];C[Debit];Cs[$803];R;C[Nut];C[Debit];Cs[$91];R;C[Gear];C[Paid];Cs[$1,200];R;C[Cog];C[Debit];Cs[$35];"
                 "a rule through the rows' height between two touching words is a column cut for the whitespace profile too")))

;; ------------------------------------ the smoke review's born-digital table defects (P12.2, D566-)

(defn ^I32 tt-row4 [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^I32 style ^Blob a ^Blob b ^Blob c ^Blob d]
  (comment "A row of four words, left edges at 7600, 13600, 19600 and 25600 (the columns of a 6000-wide four-column grid from x 7200), 800 tall from y.")
  (tt-at wd ln et a 7600 y style 0)
  (tt-at wd ln et b 13600 y style 0)
  (tt-at wd ln et c 19600 y style 0)
  (tt-at wd ln et d 25600 y style 0)
  (return 0))

(deftest test-a-grid-with-no-rules-between-its-rows-has-the-rows-of-its-text
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Repro shape 1 (BLS, BEA, a 10-K): full-height vertical rules, horizontal rules at the top, under the header and at the bottom,")
    (comment "and ten rows of four numbers between the last two, a pitch of 1600 apart with nothing ruled between them.")
    (tt-rule pa 7200 9950 31200 10050)
    (tt-rule pa 7200 11950 31200 12050)
    (tt-rule pa 7200 28750 31200 28850)
    (tt-rule pa 7150 10000 7250 28800)
    (tt-rule pa 13150 10000 13250 28800)
    (tt-rule pa 19150 10000 19250 28800)
    (tt-rule pa 25150 10000 25250 28800)
    (tt-rule pa 31150 10000 31250 28800)
    (tt-row4 wd ln et 10600 1 (text-blob "Q1") (text-blob "Q2") (text-blob "Q3") (text-blob "Q4"))
    (tt-row4 wd ln et 12600 0 (text-blob "0.00") (text-blob "0.10") (text-blob "0.20") (text-blob "0.30"))
    (tt-row4 wd ln et 14200 0 (text-blob "1.01") (text-blob "1.11") (text-blob "1.21") (text-blob "1.31"))
    (tt-row4 wd ln et 15800 0 (text-blob "2.02") (text-blob "2.12") (text-blob "2.22") (text-blob "2.32"))
    (tt-row4 wd ln et 17400 0 (text-blob "3.03") (text-blob "3.13") (text-blob "3.23") (text-blob "3.33"))
    (tt-row4 wd ln et 19000 0 (text-blob "4.04") (text-blob "4.14") (text-blob "4.24") (text-blob "4.34"))
    (tt-row4 wd ln et 20600 0 (text-blob "5.05") (text-blob "5.15") (text-blob "5.25") (text-blob "5.35"))
    (tt-row4 wd ln et 22200 0 (text-blob "6.06") (text-blob "6.16") (text-blob "6.26") (text-blob "6.36"))
    (tt-row4 wd ln et 23800 0 (text-blob "7.07") (text-blob "7.17") (text-blob "7.27") (text-blob "7.37"))
    (tt-row4 wd ln et 25400 0 (text-blob "8.08") (text-blob "8.18") (text-blob "8.28") (text-blob "8.38"))
    (tt-row4 wd ln et 27000 0 (text-blob "9.09") (text-blob "9.19") (text-blob "9.29") (text-blob "9.39"))
    (assert-eq (tt-run wd ln et pa t) 0 "rows: well formed")
    (assert-text t "T4r;Gh;R;Ch[Q1];Ch[Q2];Ch[Q3];Ch[Q4];Gb;R;C[0.00];C[0.10];C[0.20];C[0.30];R;C[1.01];C[1.11];C[1.21];C[1.31];R;C[2.02];C[2.12];C[2.22];C[2.32];R;C[3.03];C[3.13];C[3.23];C[3.33];R;C[4.04];C[4.14];C[4.24];C[4.34];R;C[5.05];C[5.15];C[5.25];C[5.35];R;C[6.06];C[6.16];C[6.26];C[6.36];R;C[7.07];C[7.17];C[7.27];C[7.37];R;C[8.08];C[8.18];C[8.28];C[8.38];R;C[9.09];C[9.19];C[9.29];C[9.39];"
                 "the body is ten rows, one for each line of its text (before: one row of four cells of ten lines each)")))

(deftest test-the-reading-that-yields-the-real-row-count-is-the-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The BLS and BEA shape: the header and two rows are ruled (a lattice of three rows), the eight rows under them are not, their columns")
    (comment "those of the lattice. The ruled reading scores best and has three rows; the reading of the whitespace has the ten rows of the text.")
    (tt-rule pa 7200 9950 31200 10050)
    (tt-rule pa 7200 11950 31200 12050)
    (tt-rule pa 7200 13550 31200 13650)
    (tt-rule pa 7200 15150 31200 15250)
    (tt-rule pa 7150 10000 7250 15200)
    (tt-rule pa 13150 10000 13250 15200)
    (tt-rule pa 19150 10000 19250 15200)
    (tt-rule pa 25150 10000 25250 15200)
    (tt-rule pa 31150 10000 31250 15200)
    (tt-row4 wd ln et 10600 1 (text-blob "Q1") (text-blob "Q2") (text-blob "Q3") (text-blob "Q4"))
    (tt-row4 wd ln et 12400 0 (text-blob "0.00") (text-blob "0.10") (text-blob "0.20") (text-blob "0.30"))
    (tt-row4 wd ln et 14000 0 (text-blob "1.01") (text-blob "1.11") (text-blob "1.21") (text-blob "1.31"))
    (tt-row4 wd ln et 15600 0 (text-blob "2.02") (text-blob "2.12") (text-blob "2.22") (text-blob "2.32"))
    (tt-row4 wd ln et 17200 0 (text-blob "3.03") (text-blob "3.13") (text-blob "3.23") (text-blob "3.33"))
    (tt-row4 wd ln et 18800 0 (text-blob "4.04") (text-blob "4.14") (text-blob "4.24") (text-blob "4.34"))
    (tt-row4 wd ln et 20400 0 (text-blob "5.05") (text-blob "5.15") (text-blob "5.25") (text-blob "5.35"))
    (tt-row4 wd ln et 22000 0 (text-blob "6.06") (text-blob "6.16") (text-blob "6.26") (text-blob "6.36"))
    (tt-row4 wd ln et 23600 0 (text-blob "7.07") (text-blob "7.17") (text-blob "7.27") (text-blob "7.37"))
    (tt-row4 wd ln et 25200 0 (text-blob "8.08") (text-blob "8.18") (text-blob "8.28") (text-blob "8.38"))
    (assert-eq (tt-run wd ln et pa t) 0 "reading: well formed")
    (assert-text t "T4w;Gh;R;Ch[Q1];Ch[Q2];Ch[Q3];Ch[Q4];Gb;R;C[0.00];C[0.10];C[0.20];C[0.30];R;C[1.01];C[1.11];C[1.21];C[1.31];R;C[2.02];C[2.12];C[2.22];C[2.32];R;C[3.03];C[3.13];C[3.23];C[3.33];R;C[4.04];C[4.14];C[4.24];C[4.34];R;C[5.05];C[5.15];C[5.25];C[5.35];R;C[6.06];C[6.16];C[6.26];C[6.36];R;C[7.07];C[7.17];C[7.27];C[7.37];R;C[8.08];C[8.18];C[8.28];C[8.38];"
                 "one table of ten rows (before: the ruled three, and the seven rows under them left as paragraphs)")))

(defn ^I32 tt-row3 [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^Blob a ^Blob b ^Blob c]
  (comment "A row of three four-letter words at x 7600, 20000 and 30000, 800 tall from y (plain).")
  (tt-at wd ln et a 7600 y 0 0)
  (tt-at wd ln et b 20000 y 0 0)
  (tt-at wd ln et c 30000 y 0 0)
  (return 0))

(deftest test-the-fragments-of-a-zebra-are-the-table-whose-rows-they-are-part-of
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The 10-K's balance sheet: a zebra whose stripes stop (a stripe is missing, so the fills make two stacks of three) over fourteen rows of one")
    (comment "pitch. Each stack alone is a reading of its rows; the whitespace reading has all fourteen, the rows between the stacks too.")
    (tt-fill pa 7200 11600 37200 13200 15000000)
    (tt-fill pa 7200 14800 37200 16400 15000000)
    (tt-fill pa 7200 18000 37200 19600 15000000)
    (tt-fill pa 7200 24400 37200 26000 15000000)
    (tt-fill pa 7200 27600 37200 29200 15000000)
    (tt-fill pa 7200 30800 37200 32400 15000000)
    (tt-row3 wd ln et 12000 (text-blob "Bolt") (text-blob "10.5") (text-blob "2.25"))
    (tt-row3 wd ln et 13600 (text-blob "Nuts") (text-blob "11.5") (text-blob "3.25"))
    (tt-row3 wd ln et 15200 (text-blob "Cogs") (text-blob "12.5") (text-blob "4.25"))
    (tt-row3 wd ln et 16800 (text-blob "Gear") (text-blob "13.5") (text-blob "5.25"))
    (tt-row3 wd ln et 18400 (text-blob "Axle") (text-blob "14.5") (text-blob "6.25"))
    (tt-row3 wd ln et 20000 (text-blob "Cams") (text-blob "15.5") (text-blob "7.25"))
    (tt-row3 wd ln et 21600 (text-blob "Pins") (text-blob "16.5") (text-blob "8.25"))
    (tt-row3 wd ln et 23200 (text-blob "Rods") (text-blob "17.5") (text-blob "9.25"))
    (tt-row3 wd ln et 24800 (text-blob "Bars") (text-blob "18.5") (text-blob "1.35"))
    (tt-row3 wd ln et 26400 (text-blob "Tabs") (text-blob "19.5") (text-blob "2.35"))
    (tt-row3 wd ln et 28000 (text-blob "Pegs") (text-blob "20.5") (text-blob "3.35"))
    (tt-row3 wd ln et 29600 (text-blob "Hubs") (text-blob "21.5") (text-blob "4.35"))
    (tt-row3 wd ln et 31200 (text-blob "Rims") (text-blob "22.5") (text-blob "5.35"))
    (tt-row3 wd ln et 32800 (text-blob "Tyre") (text-blob "23.5") (text-blob "6.35"))
    (assert-eq (tt-run wd ln et pa t) 0 "fragments: well formed")
    (assert-text t "T3w;Gb;R;C[Bolt];C[10.5];C[2.25];R;C[Nuts];C[11.5];C[3.25];R;C[Cogs];C[12.5];C[4.25];R;C[Gear];C[13.5];C[5.25];R;C[Axle];C[14.5];C[6.25];R;C[Cams];C[15.5];C[7.25];R;C[Pins];C[16.5];C[8.25];R;C[Rods];C[17.5];C[9.25];R;C[Bars];C[18.5];C[1.35];R;C[Tabs];C[19.5];C[2.35];R;C[Pegs];C[20.5];C[3.35];R;C[Hubs];C[21.5];C[4.35];R;C[Rims];C[22.5];C[5.35];R;C[Tyre];C[23.5];C[6.35];"
                 "one table of fourteen rows (before: two tables of the stripes, and the rows between them paragraphs)")))

(defn ^I32 tt-amt [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^I32 style ^Blob label ^Blob a ^Blob b]
  (comment "A statement row at y: the label at x 7600, the amounts right-aligned at 26000 and 36000 (a statement's two year columns).")
  (tt-at wd ln et label 7600 y style 0)
  (tt-at wd ln et a 26000 y style 1)
  (tt-at wd ln et b 36000 y style 1)
  (return 0))

(defn ^I32 tt-stmt-head [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa]
  (comment "The head of a financial statement (the 10-K's balance sheet): `December 31,` in bold over the two year columns, a short rule under it that")
  (comment "spans both, the years `2023` and `2022` in bold, each with a short rule under it (y 12100), and the first body row at y 12800.")
  (tt-at wd ln et (text-blob "December 31,") 23500 10000 1 0)
  (tt-rule pa 19600 10850 36200 10950)
  (tt-at wd ln et (text-blob "2023") 26000 11200 1 1)
  (tt-at wd ln et (text-blob "2022") 36000 11200 1 1)
  (tt-rule pa 19600 12050 26000 12150)
  (tt-rule pa 29600 12050 36000 12150)
  (return 0))

(defn ^I32 tt-stmt-body [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 dollar]
  (comment "Five rows of a statement from y 12800 a pitch of 1600 apart; when `dollar` is 1 a dollar sign on the first row's amounts, set apart from them")
  (comment "(a statement sets it at the left of its column: at x 19800 and 29800).")
  (tt-amt wd ln et 12800 0 (text-blob "Cash and equivalents") (text-blob "33,672") (text-blob "32,260"))
  (if (== dollar 1)
    (do (tt-at wd ln et (text-blob "$") 19800 12800 0 0)
        (tt-at wd ln et (text-blob "$") 29800 12800 0 0)))
  (tt-amt wd ln et 14400 0 (text-blob "Short-term investments") (text-blob "129,619") (text-blob "92,774"))
  (tt-amt wd ln et 16000 0 (text-blob "Fixed maturity securities") (text-blob "23,758") (text-blob "25,128"))
  (tt-amt wd ln et 17600 0 (text-blob "Equity securities") (text-blob "353,842") (text-blob "308,793"))
  (tt-amt wd ln et 19200 0 (text-blob "Other") (text-blob "19,568") (text-blob "19,657"))
  (return 0))

(defn ^I32 tt-stmt-total [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa ^I32 dollar]
  (comment "The total of the statement: a blank pitch under the last body row (y 19200), a double rule over each amount column (y 21650 and 21850, which")
  (comment "cluster as one rule) and the total, in bold, at y 22400, a dollar sign on its amounts when `dollar` is 1.")
  (tt-rule pa 19600 21600 26000 21700)
  (tt-rule pa 19600 21800 26000 21900)
  (tt-rule pa 29600 21600 36000 21700)
  (tt-rule pa 29600 21800 36000 21900)
  (tt-amt wd ln et 22400 1 (text-blob "Total assets") (text-blob "259,419") (text-blob "251,300"))
  (if (== dollar 1)
    (do (tt-at wd ln et (text-blob "$") 19800 22400 1 0)
        (tt-at wd ln et (text-blob "$") 29800 22400 1 0)))
  (return 0))

(deftest test-a-header-over-a-short-rule-is-in-the-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Repro shape 3 (the 10-K's statements): `December 31,` over a short rule that spans the two year columns, the years under it with a short")
    (comment "rule each, then the rows: the label of the columns is a header row that spans them and the years are a header row.")
    (tt-stmt-head wd ln et pa)
    (tt-stmt-body wd ln et 0)
    (assert-eq (tt-run wd ln et pa t) 0 "head: well formed")
    (assert-text t "T3w;Gh;R;Ch[];Cc2he[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cs[Cash and equivalents];C[33,672];C[32,260];R;Cs[Short-term investments];C[129,619];C[92,774];R;Cs[Fixed maturity securities];C[23,758];C[25,128];R;Cs[Equity securities];C[353,842];C[308,793];R;Cs[Other];C[19,568];C[19,657];"
                 "the header is two rows, a spanning label over the year columns and the years (before: the label a paragraph over the table)")))

(defn ^I32 tt-wrapped [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^Blob date ^Blob a ^Blob b ^Blob c ^Blob d ^Blob amt]
  (comment "A row whose Details cell has four lines (x 14000, a pitch of 1200) with the date at x 7600 and the amount, right-aligned at 36000, on the first line")
  (comment "only: the next row begins 2400 under the fourth line (a gap of one line).")
  (tt-at wd ln et date 7600 y 0 0)
  (tt-at wd ln et a 14000 y 0 0)
  (tt-at wd ln et amt 36000 y 0 1)
  (tt-at wd ln et b 14000 (+ y 1200) 0 0)
  (tt-at wd ln et c 14000 (+ y 2400) 0 0)
  (tt-at wd ln et d 14000 (+ y 3600) 0 0)
  (return 0))

(deftest test-the-lines-of-a-wrapped-cell-are-in-one-row
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Repro shape 5 (the Agami statements): no rules, four-line Details cells with the date and the amount on the first line, a gap of a line between")
    (comment "the rows. The lines under the first have one chunk each (before: a header and no body, the last line a heading).")
    (tt-at wd ln et (text-blob "Date") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Details") 14000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 36000 10000 1 1)
    (tt-wrapped wd ln et 11600 (text-blob "05 Jan") (text-blob "Payment to Acme Supply") (text-blob "Invoice 4471 settled") (text-blob "Ref ABC 123") (text-blob "Thank you") (text-blob "120.50"))
    (tt-wrapped wd ln et 17600 (text-blob "12 Jan") (text-blob "Card purchase Bolt Co") (text-blob "Order 5512 shipped") (text-blob "Ref DEF 456") (text-blob "Paid in full") (text-blob "75.00"))
    (tt-wrapped wd ln et 23600 (text-blob "19 Jan") (text-blob "Transfer to savings") (text-blob "Monthly plan") (text-blob "Ref GHI 789") (text-blob "Standing order") (text-blob "300.00"))
    (assert-eq (tt-run wd ln et pa t) 0 "wrapped: well formed")
    (assert-text t "T3w;Gh;R;Ch[Date];Chs[Details];Ch[Amount];Gb;R;C[05 Jan];Cs[Payment to Acme Supply Invoice 4471 settled Ref ABC 123 Thank you];C[120.50];R;C[12 Jan];Cs[Card purchase Bolt Co Order 5512 shipped Ref DEF 456 Paid in full];C[75.00];R;C[19 Jan];Cs[Transfer to savings Monthly plan Ref GHI 789 Standing order];C[300.00];"
                 "three rows, each with its four lines in one cell (before: no table, a paragraph for each line, in the real statements a header and no body)")))

(deftest test-a-ruled-header-over-wrapped-unruled-rows-is-the-head-of-their-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The Agami statements: a title above the header, the header in two lines (a language each), a rule above the title and one under the header, the")
    (comment "rows unruled below it, their Details cells wrapped. The chain of the two rules reads the title, the header and a row or two under the rule; the")
    (comment "whitespace reads the header and every row: the head of the table beside the table (before: the table of the chain, its rows cut after the first).")
    (tt-rule pa 7200 7950 37200 8050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-at wd ln et (text-blob "Current Account") 7600 8600 1 0)
    (tt-at wd ln et (text-blob "Date") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Details") 14000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 36000 10000 1 1)
    (tt-at wd ln et (text-blob "Dt") 7600 11000 0 0)
    (tt-at wd ln et (text-blob "Dx") 14000 11000 0 0)
    (tt-at wd ln et (text-blob "Am") 36000 11000 0 1)
    (tt-wrapped wd ln et 12600 (text-blob "05 Jan") (text-blob "Payment to Acme Supply") (text-blob "Invoice 4471 settled") (text-blob "Ref ABC 123") (text-blob "Thank you") (text-blob "120.50"))
    (tt-wrapped wd ln et 18600 (text-blob "12 Jan") (text-blob "Card purchase Bolt Co") (text-blob "Order 5512 shipped") (text-blob "Ref DEF 456") (text-blob "Paid in full") (text-blob "75.00"))
    (tt-wrapped wd ln et 24600 (text-blob "19 Jan") (text-blob "Transfer to savings") (text-blob "Monthly plan") (text-blob "Ref GHI 789") (text-blob "Standing order") (text-blob "300.00"))
    (tt-wrapped wd ln et 30600 (text-blob "26 Jan") (text-blob "Interest paid") (text-blob "Quarterly") (text-blob "Ref JKL 012") (text-blob "Credit") (text-blob "4.20"))
    (tt-wrapped wd ln et 36600 (text-blob "28 Jan") (text-blob "Cash deposit") (text-blob "Branch 14") (text-blob "Ref MNO 345") (text-blob "Counter") (text-blob "50.00"))
    (tt-wrapped wd ln et 42600 (text-blob "31 Jan") (text-blob "Service charge") (text-blob "Monthly fee") (text-blob "Ref PQR 678") (text-blob "Account") (text-blob "8.00"))
    (assert-eq (tt-run wd ln et pa t) 0 "head: well formed")
    (assert-text t "P[Current Account];T3w;Gh;R;Chs[Date];Chs[Details];Ch[Amount];Gb;R;Cs[Dt];Cs[Dx];Ce[Am];R;Cs[05 Jan];Cs[Payment to Acme Supply Invoice 4471 settled Ref ABC 123 Thank you];Ce[120.50];R;Cs[12 Jan];Cs[Card purchase Bolt Co Order 5512 shipped Ref DEF 456 Paid in full];Ce[75.00];R;Cs[19 Jan];Cs[Transfer to savings Monthly plan Ref GHI 789 Standing order];Ce[300.00];R;Cs[26 Jan];Cs[Interest paid Quarterly Ref JKL 012 Credit];Ce[4.20];R;Cs[28 Jan];Cs[Cash deposit Branch 14 Ref MNO 345 Counter];Ce[50.00];R;Cs[31 Jan];Cs[Service charge Monthly fee Ref PQR 678 Account];Ce[8.00];"
                 "one table, the header and the six rows (before: the table of the rules, its header and one row, and the rest paragraphs)")))

(defn ^I32 tt-cols5 [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 page ^I32 y ^I32 style ^Blob date ^Blob what ^Blob debit ^Blob credit ^Blob bal]
  (comment "A row of a ledger on page `page` at y: the date at x 7600, the details at 14000, the debit, the credit and the balance right-aligned at 26000,")
  (comment "36000 and 46000 (an empty blob is no word).")
  (tt-atp wd ln et date 7600 y style 0 page)
  (tt-atp wd ln et what 14000 y style 0 page)
  (if (> (blob-len debit) 0) (tt-atp wd ln et debit 26000 y style 1 page))
  (if (> (blob-len credit) 0) (tt-atp wd ln et credit 36000 y style 1 page))
  (tt-atp wd ln et bal 46000 y style 1 page)
  (return 0))

(defn ^I32 tt-french [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^I32 style ^Blob what ^Blob d1 ^Blob d2 ^Blob b1 ^Blob b2]
  (comment "A row of a French statement at y: the details at x 7600, a debit `1 895,80 $` (three words, the sign after the amount) at 24000 and a balance")
  (comment "`11 732,54 $` at 38000, the signs set a gap from the amounts that is the width of a space (the amounts before the next column's).")
  (tt-at wd ln et what 7600 y style 0)
  (if (> (blob-len d1) 0)
    (do (tt-at wd ln et d1 24000 y style 0)
        (tt-at wd ln et d2 24900 y style 0)
        (tt-at wd ln et (text-blob "$") 28300 y style 0)))
  (tt-at wd ln et b1 38000 y style 0)
  (tt-at wd ln et b2 39400 y style 0)
  (tt-at wd ln et (text-blob "$") 42800 y style 0)
  (return 0))

(defn ^I32 tt-leader [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y ^Blob label ^Blob line ^Blob amt]
  (comment "An IRS-style row at y: the label at x 7600, six full stops of their own (every 1400 from x 22000, a gap each of 900), the line number at 33000 and the")
  (comment "amount right-aligned at 43000.")
  (tt-at wd ln et label 7600 y 0 0)
  (tt-at wd ln et (text-blob ".") 22000 y 0 0)
  (tt-at wd ln et (text-blob ".") 23400 y 0 0)
  (tt-at wd ln et (text-blob ".") 24800 y 0 0)
  (tt-at wd ln et (text-blob ".") 26200 y 0 0)
  (tt-at wd ln et (text-blob ".") 27600 y 0 0)
  (tt-at wd ln et (text-blob ".") 29000 y 0 0)
  (tt-at wd ln et line 33000 y 0 0)
  (tt-at wd ln et amt 43000 y 0 1)
  (return 0))

(deftest test-the-rows-above-the-first-row-of-amounts-are-the-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The BLS and BEA tables: a header of cells that wrap into lines (a group's name, `Aug.`, `2026`), in the type of the body and not bold, over rows of")
    (comment "amounts with a decimal point: the header is every row above the first of them (before: the first row alone, or none).")
    (tt-at wd ln et (text-blob "Raw") 20000 10000 0 0)
    (tt-at wd ln et (text-blob "Adj") 30000 10000 0 0)
    (tt-at wd ln et (text-blob "Aug.") 20000 11200 0 0)
    (tt-at wd ln et (text-blob "Jul.") 30000 11200 0 0)
    (tt-at wd ln et (text-blob "2026") 20000 12400 0 0)
    (tt-at wd ln et (text-blob "2026") 30000 12400 0 0)
    (tt-at wd ln et (text-blob "Category") 7600 12400 0 0)
    (tt-row3 wd ln et 14400 (text-blob "Food") (text-blob "13.5") (text-blob "2.7"))
    (tt-row3 wd ln et 16000 (text-blob "Fuel") (text-blob "11.5") (text-blob "3.1"))
    (tt-row3 wd ln et 17600 (text-blob "Rent") (text-blob "12.5") (text-blob "4.4"))
    (tt-row3 wd ln et 19200 (text-blob "Cars") (text-blob "14.5") (text-blob "5.9"))
    (tt-row3 wd ln et 20800 (text-blob "Tolls") (text-blob "15.5") (text-blob "6.2"))
    (tt-row3 wd ln et 22400 (text-blob "Power") (text-blob "16.5") (text-blob "7.7"))
    (assert-eq (tt-run wd ln et pa t) 0 "head: well formed")
    (assert-text t "T3w;Gh;R;Ch[];Ch[Raw];Ch[Adj];R;Ch[];Ch[Aug.];Ch[Jul.];R;Ch[Category];Ch[2026];Ch[2026];Gb;R;C[Food];C[13.5];C[2.7];R;C[Fuel];C[11.5];C[3.1];R;C[Rent];C[12.5];C[4.4];R;C[Cars];C[14.5];C[5.9];R;C[Tolls];C[15.5];C[6.2];R;C[Power];C[16.5];C[7.7];"
                 "the three lines above the first row of amounts are the header (before: the first of them, the others rows of the body)")))

(deftest test-a-block-of-totals-in-the-last-columns-is-no-part-of-a-whitespace-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The invoice (D559's guard, now for the whitespace reading, which has more rows than the ruled one that scored best): the rows and under them a")
    (comment "block of totals whose labels begin in the second column, no rule: a table of its rows, the totals paragraphs.")
    (tt-rule pa 7200 9550 32200 9650)
    (tt-rule pa 7200 11150 32200 11250)
    (tt-rule pa 7200 17550 32200 17650)
    (tt-row3 wd ln et 10000 (text-blob "Item") (text-blob "Desc") (text-blob "Qty"))
    (tt-row3 wd ln et 11600 (text-blob "A-100") (text-blob "Pipe") (text-blob "40.5"))
    (tt-row3 wd ln et 13200 (text-blob "B-220") (text-blob "Joint") (text-blob "12.5"))
    (tt-row3 wd ln et 14800 (text-blob "C-310") (text-blob "Paste") (text-blob "60.5"))
    (tt-row3 wd ln et 16400 (text-blob "D-005") (text-blob "Tape") (text-blob "70.5"))
    (tt-at wd ln et (text-blob "Subtotal") 30000 18000 0 0)
    (tt-at wd ln et (text-blob "46.4") 38000 18000 0 0)
    (tt-at wd ln et (text-blob "VAT 20%") 30000 19600 0 0)
    (tt-at wd ln et (text-blob "9.28") 38000 19600 0 0)
    (tt-at wd ln et (text-blob "Total due") 30000 21200 1 0)
    (tt-at wd ln et (text-blob "55.7") 38000 21200 1 0)
    (assert-eq (tt-run wd ln et pa t) 0 "totals: well formed")
    (assert-text t "T3p;Gh;R;Ch[Item];Ch[Desc];Ch[Qty];Gb;R;C[A-100];C[Pipe];C[40.5];R;C[B-220];C[Joint];C[12.5];R;C[C-310];C[Paste];C[60.5];R;C[D-005];C[Tape];C[70.5];P[Subtotal];P[46.4];P[VAT 20%];P[9.28];P[Total due];P[55.7];"
                 "the rows are the table and the totals are not (D559; before the guard of the whitespace run, the whitespace reading, with more rows, won and took them in)")))

(deftest test-the-dots-of-a-leader-are-no-cells
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The 1120's lines (D17, D18, D20): a label, a leader of full stops a gap apart, the line number, the amount. Each full stop is a chunk of its own to the")
    (comment "rows' words and the six of a row, in the same places in every row, are columns of the table (before: a table of nine columns, the dots cells).")
    (tt-at wd ln et (text-blob "Item") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Line") 33000 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 43000 10000 1 1)
    (tt-leader wd ln et 11600 (text-blob "Gross receipts") (text-blob "1a") (text-blob "1,200"))
    (tt-leader wd ln et 13200 (text-blob "Returns") (text-blob "1b") (text-blob "30"))
    (tt-leader wd ln et 14800 (text-blob "Cost of goods sold") (text-blob "2") (text-blob "450"))
    (tt-leader wd ln et 16400 (text-blob "Gross profit") (text-blob "3") (text-blob "720"))
    (tt-leader wd ln et 18000 (text-blob "Dividends") (text-blob "4") (text-blob "15"))
    (assert-eq (tt-run wd ln et pa t) 0 "leader: well formed")
    (assert-text t "T3w;Gh;R;Ch[Item];Ch[Line];Ch[Amount];Gb;R;C[Gross receipts . . . . . .];C[1a];Ce[1,200];R;C[Returns . . . . . .];C[1b];Ce[30];R;C[Cost of goods sold . . . . . .];C[2];Ce[450];R;C[Gross profit . . . . . .];C[3];Ce[720];R;C[Dividends . . . . . .];C[4];Ce[15];"
                 "the leader is the end of the label's cell: three columns (before: nine, the six full stops the cells of six of them)")))

(deftest test-a-row-span-does-not-cross-into-the-foot
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Repro shape 13 (the ICDAR table of savings): a label that spans three rows and the bold total that ends its group, a fourth row of the same span.")
    (comment "The total is the last row, bold under rows that are not, and would be the foot: but the span goes down into it, and a row group does not cross")
    (comment "from the body into the foot. The total stays in the body, the span whole (before: a foot of one row, the span four rows of it three).")
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 17200 13550 37200 13650)
    (tt-rule pa 17200 15150 37200 15250)
    (tt-rule pa 17200 16750 37200 16850)
    (tt-rule pa 7200 18350 37200 18450)
    (tt-rule pa 7150 10000 7250 18400)
    (tt-rule pa 17150 10000 17250 18400)
    (tt-rule pa 27150 10000 27250 18400)
    (tt-rule pa 37150 10000 37250 18400)
    (tt-at wd ln et (text-blob "Group") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "Level") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "Pct") 27600 10600 1 0)
    (tt-at wd ln et (text-blob "Combined") 7600 12200 0 0)
    (tt-at wd ln et (text-blob "Med-low") 17600 12200 0 0)
    (tt-at wd ln et (text-blob "1.5%") 27600 12200 0 0)
    (tt-at wd ln et (text-blob "Med-high") 17600 13800 0 0)
    (tt-at wd ln et (text-blob "2.3%") 27600 13800 0 0)
    (tt-at wd ln et (text-blob "Very high") 17600 15400 0 0)
    (tt-at wd ln et (text-blob "2.4%") 27600 15400 0 0)
    (tt-at wd ln et (text-blob "Total") 17600 17000 1 0)
    (tt-at wd ln et (text-blob "6%") 27600 17000 1 0)
    (assert-eq (tt-run wd ln et pa t) 0 "span: well formed")
    (assert-text t "T3r;Gh;R;Ch[Group];Ch[Level];Ch[Pct];Gb;R;Cr4[Combined];Cs[Med-low];Cs[1.5%];R;Cs[Med-high];Cs[2.3%];R;Cs[Very high];Cs[2.4%];R;Cs[Total];Cs[6%];"
                 "the total is in the body with the rows its label spans (before: `Gf;R;Cws[Total];Cw[6%];` under a label of four rows that began in the body)")))

(deftest test-a-currency-sign-after-its-amount-stays-with-it
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The Harbour statement writes `1 895,80 $` and `11 732,54 $`: the sign is the end of its amount and not the lead of the next one (a sign of a word")
    (comment "of its own before a figure is the figure's only when the row's signs go before the figures).")
    (tt-at wd ln et (text-blob "Details") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Debit") 24000 10000 1 0)
    (tt-at wd ln et (text-blob "Solde") 38000 10000 1 0)
    (tt-french wd ln et 11600 0 (text-blob "Uber") (text-blob "1") (text-blob "895,80") (text-blob "11") (text-blob "732,54"))
    (tt-french wd ln et 13200 0 (text-blob "La Baie") (text-blob "88") (text-blob "96") (text-blob "11") (text-blob "643,58"))
    (tt-french wd ln et 14800 0 (text-blob "Tim") (text-blob "53") (text-blob "50") (text-blob "11") (text-blob "590,08"))
    (tt-french wd ln et 16400 0 (text-blob "Apple") (text-blob "17") (text-blob "26") (text-blob "11") (text-blob "572,82"))
    (assert-eq (tt-run wd ln et pa t) 0 "french: well formed")
    (assert-text t "T3w;Gh;R;Chs[Details];Ch[Debit];Ch[Solde];Gb;R;Cs[Uber];C[1 895,80 $];C[11 732,54 $];R;Cs[La Baie];C[88 96 $];C[11 643,58 $];R;Cs[Tim];C[53 50 $];C[11 590,08 $];R;Cs[Apple];C[17 26 $];C[11 572,82 $];"
                 "each amount keeps its sign: three columns (a sign that went to the amount after it made the debit and the balance one cell)")))

(deftest test-a-table-whose-page-has-an-empty-column-is-one-with-the-page-before
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Repro shape 4 (the Harbour statement): five columns on the first page, the second page has only debits (its credit column is empty but for")
    (comment "the header the table repeats): the columns of the second are a subset of the first's, aligned by x, so it is the same table; its rows have the empty")
    (comment "cell (before: a table of four columns on the second page, the pages not linked).")
    (tt-cols5 wd ln et 1 10000 1 (text-blob "Date") (text-blob "Details") (text-blob "Debit") (text-blob "Credit") (text-blob "Balance"))
    (tt-cols5 wd ln et 1 11600 0 (text-blob "02 Jan") (text-blob "Skip Plats") (text-blob "151.30") (text-blob "") (text-blob "10,598.70"))
    (tt-cols5 wd ln et 1 13200 0 (text-blob "02 Jan") (text-blob "Salary") (text-blob "") (text-blob "10.33") (text-blob "10,609.03"))
    (tt-cols5 wd ln et 1 14800 0 (text-blob "03 Jan") (text-blob "Amazon") (text-blob "1,200.45") (text-blob "") (text-blob "9,408.58"))
    (tt-cols5 wd ln et 1 16400 0 (text-blob "06 Jan") (text-blob "Paie") (text-blob "") (text-blob "101.15") (text-blob "9,509.73"))
    (tt-cols5 wd ln et 1 18000 0 (text-blob "06 Jan") (text-blob "Petro") (text-blob "29.69") (text-blob "") (text-blob "9,480.04"))
    (tt-cols5 wd ln et 1 19600 0 (text-blob "06 Jan") (text-blob "Spotify") (text-blob "541.27") (text-blob "") (text-blob "8,938.77"))
    (tt-cols5 wd ln et 2 10000 1 (text-blob "Date") (text-blob "Details") (text-blob "Debit") (text-blob "Credit") (text-blob "Balance"))
    (tt-cols5 wd ln et 2 11600 0 (text-blob "21 Jan") (text-blob "Uber") (text-blob "1,895.80") (text-blob "") (text-blob "11,732.54"))
    (tt-cols5 wd ln et 2 13200 0 (text-blob "23 Jan") (text-blob "La Baie") (text-blob "88.96") (text-blob "") (text-blob "11,643.58"))
    (tt-cols5 wd ln et 2 14800 0 (text-blob "24 Jan") (text-blob "Tim") (text-blob "53.50") (text-blob "") (text-blob "11,590.08"))
    (tt-cols5 wd ln et 2 16400 0 (text-blob "25 Jan") (text-blob "Apple") (text-blob "17.26") (text-blob "") (text-blob "11,572.82"))
    (tt-cols5 wd ln et 2 18000 0 (text-blob "26 Jan") (text-blob "Gaz") (text-blob "422.11") (text-blob "") (text-blob "11,150.71"))
    (tt-cols5 wd ln et 2 19600 0 (text-blob "26 Jan") (text-blob "Netflix") (text-blob "17.11") (text-blob "") (text-blob "11,133.60"))
    (assert-eq (tt-run-n wd ln et pa t 2) 0 "ledger: well formed")
    (assert-text t "T5w;Gh;R;Ch[Date];Chs[Details];Che[Debit];Ch[Credit];Che[Balance];Gb;R;C[02 Jan];Cs[Skip Plats];Ce[151.30];C[];C[10,598.70];R;C[02 Jan];Cs[Salary];Ce[];C[10.33];C[10,609.03];R;C[03 Jan];Cs[Amazon];Ce[1,200.45];C[];C[9,408.58];R;C[06 Jan];Cs[Paie];Ce[];C[101.15];C[9,509.73];R;C[06 Jan];Cs[Petro];Ce[29.69];C[];C[9,480.04];R;C[06 Jan];Cs[Spotify];Ce[541.27];C[];C[8,938.77];R;C[21 Jan];Cs[Uber];Ce[1,895.80];C[];C[11,732.54];R;C[23 Jan];Cs[La Baie];Ce[88.96];C[];C[11,643.58];R;C[24 Jan];Cs[Tim];Ce[53.50];C[];C[11,590.08];R;C[25 Jan];Cs[Apple];Ce[17.26];C[];C[11,572.82];R;C[26 Jan];Cs[Gaz];Ce[422.11];C[];C[11,150.71];R;C[26 Jan];Cs[Netflix];Ce[17.11];C[];C[11,133.60];"
                 "one table of five columns across the two pages, the second page's rows with their empty credit cells (before: two tables, four columns on the second)")))

(deftest test-a-sections-label-in-a-table-is-a-row-that-spans-it
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "The 10-K's labels: `ASSETS` before the first row and `Railroad, Utilities and Energy:` between two groups of rows, each in bold, one cell,")
    (comment "no amount. They are rows of the table whose one cell spans the columns (before: a heading or a paragraph that split the table, or a cell of the")
    (comment "first column and cells that are empty).")
    (tt-stmt-head wd ln et pa)
    (tt-at wd ln et (text-blob "ASSETS") 7600 12800 1 0)
    (tt-amt wd ln et 14400 0 (text-blob "Cash and equivalents") (text-blob "33,672") (text-blob "32,260"))
    (tt-amt wd ln et 16000 0 (text-blob "Short-term investments") (text-blob "129,619") (text-blob "92,774"))
    (tt-at wd ln et (text-blob "Railroad, Utilities and Energy:") 7600 17600 1 0)
    (tt-amt wd ln et 19200 0 (text-blob "Receivables") (text-blob "7,086") (text-blob "4,795"))
    (tt-amt wd ln et 20800 0 (text-blob "Goodwill") (text-blob "33,758") (text-blob "26,597"))
    (assert-eq (tt-run wd ln et pa t) 0 "labels: well formed")
    (assert-text t "T3w;Gh;R;Ch[];Cc2he[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cc3[ASSETS];R;Cs[Cash and equivalents];Ce[33,672];C[32,260];R;Cs[Short-term investments];Ce[129,619];C[92,774];R;Cc3[Railroad, Utilities and Energy:];R;Cs[Receivables];Ce[7,086];C[4,795];R;Cs[Goodwill];Ce[33,758];C[26,597];"
                 "a label with no amount, in bold, is one cell that spans the row: the table is one table, `ASSETS` no header row")))

(deftest test-a-currency-sign-set-apart-from-its-amount-is-in-its-cell
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "A statement sets the dollar sign at the left of its column and the amount at the right of it (the first row's amounts here, 2700 apart): the")
    (comment "sign is part of its amount's cell, no cell of its own (before: a column of its own, or the end of the cell before it).")
    (tt-stmt-head wd ln et pa)
    (tt-stmt-body wd ln et 1)
    (assert-eq (tt-run wd ln et pa t) 0 "dollar: well formed")
    (assert-text t "T3w;Gh;R;Ch[];Cc2he[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cs[Cash and equivalents];Ce[$ 33,672];Ce[$ 32,260];R;Cs[Short-term investments];Ce[129,619];Ce[92,774];R;Cs[Fixed maturity securities];Ce[23,758];Ce[25,128];R;Cs[Equity securities];Ce[353,842];Ce[308,793];R;Cs[Other];Ce[19,568];Ce[19,657];"
                 "the signs are in the cells of the amounts after them: three columns")))

(deftest test-the-total-under-a-double-rule-is-a-row-of-the-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text)]
    (comment "Repro shape 3: the total stands a blank pitch under the body, under a double rule over the amount columns, its label in the first column:")
    (comment "the last row of the table (before: five paragraphs under it).")
    (tt-stmt-head wd ln et pa)
    (tt-stmt-body wd ln et 1)
    (tt-stmt-total wd ln et pa 1)
    (assert-eq (tt-run wd ln et pa t) 0 "total: well formed")
    (assert-text t "T3p;Gh;R;Ch[];Cc2h[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cs[Cash and equivalents];Ce[$ 33,672];Ce[$ 32,260];R;Cs[Short-term investments];Ce[129,619];Ce[92,774];R;Cs[Fixed maturity securities];Ce[23,758];Ce[25,128];R;Cs[Equity securities];Ce[353,842];Ce[308,793];R;Cs[Other];Ce[19,568];Ce[19,657];Gf;R;Cws[Total assets];Cwe[$ 259,419];Cwe[$ 251,300];"
                 "the total is a row of the table, in its foot")
    (comment "A block of totals in the last columns under it (an invoice's: its label is not in the first column) is no row of the table (D559).")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (cells-drop pa 0)
    (tt-stmt-head wd ln et pa)
    (tt-stmt-body wd ln et 1)
    (tt-rule pa 19600 21600 26000 21700)
    (tt-rule pa 19600 21800 26000 21900)
    (tt-rule pa 29600 21600 36000 21700)
    (tt-rule pa 29600 21800 36000 21900)
    (tt-at wd ln et (text-blob "Total due") 14000 22400 1 0)
    (tt-at wd ln et (text-blob "259,419") 26000 22400 1 1)
    (tt-at wd ln et (text-blob "251,300") 36000 22400 1 1)
    (assert-eq (tt-run wd ln et pa t2) 0 "block: well formed")
    (assert-text t2 "T3p;Gh;R;Ch[];Cc2he[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cs[Cash and equivalents];Ce[$ 33,672];Ce[$ 32,260];R;Cs[Short-term investments];Ce[129,619];Ce[92,774];R;Cs[Fixed maturity securities];Ce[23,758];Ce[25,128];R;Cs[Equity securities];Ce[353,842];Ce[308,793];R;Cs[Other];Ce[19,568];Ce[19,657];P[Total due];P[259,419];P[251,300];"
                 "a block of totals that does not begin in the first column is not the table's, whatever its rule")))

(deftest test-a-dense-four-column-table-needs-no-purely-numeric-column
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)
        ^:mut ^I32 r 0]
    (comment "E14: salary bands are categorical values (currency ranges, 'or less', 'Greater than'), not pure numbers. Four aligned, dense columns of short cells are a table without a numeric column or bold header.")
    (while (< r 5)
      (do (tt-at wd ln et (text-blob "Band") 7200 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "Low") 18000 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "Medium") 28000 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "High") 40000 (+ 10000 (* r 1600)) 0 0)
          (set r (+ r 1))))
    (assert-eq (tt-run wd ln et pa t) 0 "categorical table: well formed")
    (assert-text t "T4w;Gb;R;C[Band];C[Low];C[Medium];C[High];R;C[Band];C[Low];C[Medium];C[High];R;C[Band];C[Low];C[Medium];C[High];R;C[Band];C[Low];C[Medium];C[High];R;C[Band];C[Low];C[Medium];C[High];"
                 "a dense grid of four short categorical columns is a table")))

(deftest test-three-label-and-amount-rows-are-a-summary-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-at wd ln et (text-blob "Subtotal") 7200 10000 0 0)
    (tt-at wd ln et (text-blob "100.00") 30000 10000 0 1)
    (tt-at wd ln et (text-blob "Tax") 7200 11600 0 0)
    (tt-at wd ln et (text-blob "15.00") 30000 11600 0 1)
    (tt-at wd ln et (text-blob "Total") 7200 13200 1 0)
    (tt-at wd ln et (text-blob "115.00") 30000 13200 1 1)
    (assert-eq (tt-run wd ln et pa t) 0 "summary: well formed")
    (assert-text t "T2w;Gb;R;Cs[Subtotal];C[100.00];R;Cs[Tax];C[15.00];Gf;R;Cws[Total];Cw[115.00];"
                 "three numeric rows need no separate header to qualify as a summary table")))

(deftest test-an-ocr-only-categorical-grid-needs-its-own-table-evidence
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)
        ^:mut ^I32 r 0]
    (while (< r 5)
      (do (tt-at wd ln et (text-blob "Band") 7200 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "Low") 18000 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "Medium") 28000 (+ 10000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "High") 40000 (+ 10000 (* r 1600)) 0 0)
          (set r (+ r 1))))
    (set r 0)
    (while (< r (wd-count wd))
      (do (wd-set wd r (wf-src) 4)
          (set r (+ r 1))))
    (assert-eq (tt-run wd ln et pa t) 0 "OCR-only grid: well formed")
    (assert-text t "P[Band];P[Low];P[Medium];P[High];P[Band];P[Low];P[Medium];P[High];P[Band];P[Low];P[Medium];P[High];P[Band];P[Low];P[Medium];P[High];P[Band];P[Low];P[Medium];P[High];"
                 "the born-digital categorical rule does not relax an OCR-only grid's evidence threshold")))

(deftest test-an-unruled-body-can-span-the-headers-columns
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)
        ^:mut ^I32 r 0]
    (comment "E13: the ruled header has finer columns than the labels in the unruled body. A label crossing one undrawn boundary must span those columns without preventing the body's row cuts.")
    (tt-rule pa 7200 9950 37200 10050)
    (tt-rule pa 7200 11950 37200 12050)
    (tt-rule pa 7200 17950 37200 18050)
    (tt-rule pa 7150 10000 7250 18000)
    (tt-rule pa 37150 10000 37250 18000)
    (tt-rule pa 17150 10000 17250 12000)
    (tt-rule pa 27150 10000 27250 12000)
    (tt-at wd ln et (text-blob "Group") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "Label") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "Value") 27600 10600 1 0)
    (while (< r 3)
      (do (tt-word wd ln et (text-blob "Category") 7600 (+ 12600 (* r 1600)) 22000 (+ 13400 (* r 1600)) 0)
          (tt-at wd ln et (text-blob "12.50") 27600 (+ 12600 (* r 1600)) 0 0)
          (set r (+ r 1))))
    (assert-eq (tt-run wd ln et pa t) 0 "spanning unruled body: well formed")
    (assert-text t "T3r;Gh;R;Ch[Group];Ch[Label];Ch[Value];Gb;R;Cc2[Category];C[12.50];R;Cc2[Category];C[12.50];R;Cc2[Category];C[12.50];"
                 "body rows survive a label spanning the header's first two columns")))

(deftest test-a-prefix-currency-sign-starts-the-next-amount-even-with-a-small-gap
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "D28: the next year's dollar sign is close to the preceding negative amount, but the sign is a prefix of its own amount, not the end of a chunk spanning both years.")
    (tt-stmt-head wd ln et pa)
    (tt-amt wd ln et 12800 0 (text-blob "Income") (text-blob "(22,759)") (text-blob "89,937"))
    (tt-at wd ln et (text-blob "$") 19800 12800 0 0)
    (tt-at wd ln et (text-blob "$") 26100 12800 0 0)
    (tt-amt wd ln et 14400 0 (text-blob "Investments") (text-blob "129,619") (text-blob "92,774"))
    (tt-amt wd ln et 16000 0 (text-blob "Securities") (text-blob "23,758") (text-blob "25,128"))
    (tt-amt wd ln et 17600 0 (text-blob "Equity") (text-blob "353,842") (text-blob "308,793"))
    (tt-amt wd ln et 19200 0 (text-blob "Other") (text-blob "19,568") (text-blob "19,657"))
    (assert-eq (tt-run wd ln et pa t) 0 "prefix signs: well formed")
    (assert-text t "T3w;Gh;R;Ch[];Cc2he[December 31,];R;Ch[];Che[2023];Che[2022];Gb;R;Cs[Income];Ce[$ (22,759)];Ce[$ 89,937];R;Cs[Investments];Ce[129,619];Ce[92,774];R;Cs[Securities];Ce[23,758];Ce[25,128];R;Cs[Equity];Ce[353,842];Ce[308,793];R;Cs[Other];Ce[19,568];Ce[19,657];"
                 "a close prefix sign does not merge the two years into a spanning cell")))

;; --------------------------------------------------------------- real documents

(defn ^I32 tt-golden[^Blob pdf ^:mut ^Text t ^:mut ^Text tvt]
  (comment "PDF -> content -> tables -> paragraphs -> Model -> pretty JSON; answer 0 when every step answered 0, else a")
  (comment "code naming the step (1 open, 2 content, 3 the Model's check). The JSON is `t`. The tagged tree is read and joined (P5.5), and the")
  (comment "verdicts of its tables, as the evidence dump's `tb` writes them, are `tvt`.")
  (let [^Cells ar (new-cells) ^Cells dc (new-cells) ^Cells a (new-cells) ^Cells b (new-cells) ^Cells st (new-cells)
        ^Cells cx (new-cells) ^Cells ox (new-cells) ^Cells cs (new-cells) ^Cells out (new-cells)
        ^Cells f0 (new-cells) ^Cells f1 (new-cells) ^Cells f2 (new-cells) ^Cells f3 (new-cells)
        ^Cells gl (new-cells) ^Cells et (new-cells) ^Cells mk (new-cells) ^Cells fnt (new-cells) ^Cells pg (new-cells)
        ^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells pa (new-cells) ^Cells im (new-cells) ^Cells pts (new-cells)
        ^Cells gx (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells) ^Cells gp (new-cells)
        ^Cells lt (new-cells) ^Cells ls (new-cells) ^Cells sd (new-cells) ^Cells it (new-cells)
        ^Cells io (new-cells) ^Cells rw (new-cells) ^Cells gu (new-cells) ^Cells ac (new-cells)
        ^Cells tm (new-cells) ^Cells cf (new-cells) ^Cells lo (new-cells) ^Cells pr (new-cells) ^Cells dbg (new-cells) ^Cells hc (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tq (new-cells) ^Cells tx (new-cells)
        ^Cells s0 (new-cells) ^Cells s1 (new-cells) ^Cells s2 (new-cells) ^Cells s3 (new-cells) ^Cells s4 (new-cells)
        ^Cells s5 (new-cells) ^Cells s6 (new-cells) ^Cells s7 (new-cells) ^Cells s8 (new-cells) ^Cells s9 (new-cells)
        ^Cells s10 (new-cells) ^Cells s11 (new-cells) ^Cells s12 (new-cells) ^Cells s13 (new-cells) ^Cells s14 (new-cells)
        ^Cells s15 (new-cells) ^Cells s16 (new-cells) ^Cells s17 (new-cells) ^Cells s18 (new-cells)
        ^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells cand (new-cells)
        ^Cells t5e (new-cells) ^Cells t6e (new-cells) ^Cells t7e (new-cells) ^Cells t8e (new-cells) ^Cells t9e (new-cells) ^Cells t10e (new-cells) ^Cells t11e (new-cells) ^Cells t12e (new-cells)
        ^Cells idx (new-cells) ^Cells txt (new-cells) ^Cells wq (new-cells) ^Cells seen (new-cells) ^Cells md (new-cells) ^Cells xm (new-cells)
        ^Cells ol (new-cells) ^Cells lb (new-cells) ^Cells nd (new-cells) ^Cells nt (new-cells)
        ^Cells ss2 (new-cells) ^Cells se2 (new-cells) ^Cells sk2 (new-cells) ^Cells sc2 (new-cells) ^Cells so2 (new-cells) ^Cells sa2 (new-cells)
        ^Cells wk2 (new-cells) ^Cells ha (new-cells) ^Cells hb (new-cells) ^Cells hh (new-cells)
        ^Cells sf (new-cells) ^Cells sc (new-cells) ^Cells ws (new-cells) ^Cells htmp (new-cells)
        ^Cells hpr (new-cells) ^Cells hptxt (new-cells) ^Cells loc (new-cells) ^Cells ii (new-cells) ^Cells al (new-cells)
        ^Src src (src-of-blob pdf)
        ^I32 o (pd-open src ar dc a b st)]
    (if (!= o 0) (return 1))
    (if (!= (pc-document src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx) 0) (return 2))
    (px-index-build src ar dc a b st pg idx)
    (if (< (pm-run src ar dc a b st pg idx txt wq seen md xm ol lb nd nt) 0) (return 4))
    (if (< (tg-read src ar dc a b st pg idx txt wq seen ss2 se2 sk2 sc2 so2 wk2 md) 0) (return 5))
    (tg-join ss2 se2 sk2 sc2 so2 sa2 gl mk fnt pg ha hb hh)
    (model-init nodes attrs regions text pages ledger layout)
    (pa-pages pg pages)
    (let [^I32 np (quot (cells-len pages) 16)]
      (gf-doc pa pts mk im np (gfx-mode) grl gfl cand (new-cells))
      (tb-build wd ln et grl gfl np tb tc tw tq tx (new-cells) (new-cells) s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 pages gl mk se2 sc2 ss2 t5e t6e t7e t8e t9e t10e t11e t12e (new-cells))
      (if (!= (tt-body-audit wd et tb tc tw) 0) (return 7))
      (tt-emit tvt t12e)
      (lc-copy ln lt)
      (in-detect wd gl fnt et np loc lt ls lo tm ii)
      (hd-analyze wd lt et gl sf sc hc ws htmp hpr hptxt)
      (pa-build wd et np pages layout nodes attrs regions text ord raw tmp fr gp lt ls sd it io rw gu ac tm cf lo pr dbg hc tb tc tw tq ledger ii al))
    (if (!= (model-check nodes attrs regions text pages ledger layout st) 0) (return 3))
    (js-emit t 1 nodes attrs regions text pages ledger layout (new-cells) (new-cells))
    (return 0)))

;; --------------------------------------------------------------- tagged tables (P5.5)

(defn ^I32 tt-tagged [^TestT emon-t ^Blob pdf ^Blob golden ^:mut ^Text t ^:mut ^Text tvt]
  (comment "A tagged document through the stage: the Model, byte for byte, and the verdicts of its tables (the evidence dump's `tb`) in `tvt`.")
  (let [^I32 r (tt-golden pdf t tvt)]
    (if (!= r 0) (return r))
    (assert-text-span t golden 0 (jt-end golden) "the Model of a tagged-table fixture" 0)
    (return 0)))

(deftest test-tagged-tables-are-verified-against-the-page
  (let [^Text t0 (new-text) ^Text v0 (new-text) ^Text t1 (new-text) ^Text v1 (new-text) ^Text t2 (new-text) ^Text v2 (new-text) ^Text t3 (new-text) ^Text v3 (new-text) ^Text t4 (new-text) ^Text v4 (new-text) ^Text t5 (new-text) ^Text v5 (new-text) ^Text t6 (new-text) ^Text v6 (new-text) ^Text t7 (new-text) ^Text v7 (new-text) ^Text t8 (new-text) ^Text v8 (new-text)]
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-good.pdf") (test-file "table/ttab-good.json") t0 v0) 0 "ttab-good runs")
    (assert-text v0 "[{\"page\":1,\"se\":4,\"rows\":4,\"cols\":4,\"verdict\":\"confirmed\",\"score\":931,\"checks\":[900,1000,1000,1000,1000,1000],\"trust\":937}]"
                 "ttab-good: a correct grid, ruled, with spans and a header: confirmed, and the tags are among the table's sources")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-good-ws.pdf") (test-file "table/ttab-good-ws.json") t1 v1) 0 "ttab-good-ws runs")
    (assert-text v1 "[{\"page\":1,\"se\":4,\"rows\":4,\"cols\":4,\"verdict\":\"confirmed\",\"score\":1000,\"checks\":[1000,1000,1000,1000,1000,1000],\"trust\":937}]"
                 "ttab-good-ws: a table without a rule, correctly tagged: confirmed, and `struct` is among its sources")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-th-as-td.pdf") (test-file "table/ttab-th-as-td.json") t2 v2) 0 "ttab-th-as-td runs")
    (assert-text v2 "[{\"page\":1,\"se\":4,\"rows\":4,\"cols\":4,\"verdict\":\"confirmed\",\"score\":1000,\"checks\":[1000,1000,1000,1000,1000,1000],\"trust\":937}]"
                 "ttab-th-as-td: headers tagged TD are still a table that agrees with the page")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-bad-spans.pdf") (test-file "table/ttab-bad-spans.json") t3 v3) 0 "ttab-bad-spans runs")
    (assert-text v3 "[{\"page\":1,\"se\":4,\"rows\":4,\"cols\":5,\"verdict\":\"partial\",\"score\":821,\"checks\":[900,1000,1000,1000,1000,785],\"trust\":937}]"
                 "ttab-bad-spans: ColSpan 3 where the rules close at 2: the geometry agrees with 785 of the words, so the verdict is partial, flagged struct-disagree and tag-span-conflict")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-bad-rows.pdf") (test-file "table/ttab-bad-rows.json") t4 v4) 0 "ttab-bad-rows runs")
    (assert-text v4 "[{\"page\":1,\"se\":4,\"rows\":3,\"cols\":8,\"verdict\":\"contradicted\",\"score\":351,\"checks\":[923,1000,846,1000,1000,250],\"trust\":937}]"
                 "ttab-bad-rows: two visual rows in one TR: still contradicted, and the Model is the geometry's alone (D324: the two visual rows read as one row of two lines, so a quarter of the words agree)")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-layout.pdf") (test-file "table/ttab-layout.json") t5 v5) 0 "ttab-layout runs")
    (assert-text v5 "[{\"page\":1,\"se\":4,\"rows\":1,\"cols\":2,\"verdict\":\"contradicted\",\"score\":1000,\"checks\":[1000,-1,1000,1000,1000,-1],\"trust\":923}]"
                 "ttab-layout: prose in two columns tagged Table is a layout table: refused (D180), so contradicted, and there is no table in the Model")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-missing-row.pdf") (test-file "table/ttab-missing-row.json") t6 v6) 0 "ttab-missing-row runs")
    (assert-text v6 "[{\"page\":1,\"se\":4,\"rows\":4,\"cols\":4,\"verdict\":\"partial\",\"score\":864,\"checks\":[1000,1000,1000,800,1000,1000],\"trust\":118}]"
                 "ttab-missing-row: the last row is an artifact; the tree's trust is under 300, so it can confirm nothing: partial")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-allp.pdf") (test-file "table/ttab-allp.json") t7 v7) 0 "ttab-allp runs")
    (assert-text v7 "[]"
                 "ttab-allp: cells tagged P: the tree has no Table, so no verdict")
    (assert-eq (tt-tagged (test-t) (test-file "corpus/synth/pdf/ttab-good-ws-untagged.pdf") (test-file "table/ttab-good-ws-untagged.json") t8 v8) 0 "ttab-good-ws-untagged runs")
    (assert-text v8 "[]"
                 "the same table with no tree: no verdict")))

(deftest test-a-table-that-confirms-itself-is-read-in-a-tree-that-is-not-trusted
  (let [^Text t0 (new-text) ^Text v0 (new-text)]
    (comment "A ruled table correctly tagged (every check 1000) in a tree that tags nothing else: the text around it is set with no tag, the tree covers")
    (comment "a small part of the glyphs and its trust is 63, far under 300 (D150). The table confirms itself (D557): the verdict is confirmed, and `struct`")
    (comment "is among the Model's sources for it (before, it was `partial` and the tags were used for nothing).")
    (assert-eq (tt-tagged (test-t) (test-file "table/ttab-low-trust.pdf") (test-file "table/ttab-low-trust.json") t0 v0) 0 "ttab-low-trust runs")
    (assert-text v0 "[{\"page\":1,\"se\":2,\"rows\":4,\"cols\":4,\"verdict\":\"confirmed\",\"score\":1000,\"checks\":[1000,1000,1000,1000,1000,1000],\"trust\":63}]"
                 "ttab-low-trust: a table whose own checks all hold is confirmed whatever the tree's trust")))

(deftest test-real-documents-make-the-golden-models
  (let [^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text) ^Text t5 (new-text) ^Text t6 (new-text) ^Text t7 (new-text)]
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/table-simple-ruled.pdf") t1 (new-text)) 0 "table-simple-ruled runs")
    (assert-text-span t1 (test-file "table/table-simple-ruled.json") 0 (jt-end (test-file "table/table-simple-ruled.json")) "table-simple-ruled" 0)
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/table-shaded.pdf") t2 (new-text)) 0 "table-shaded runs")
    (assert-text-span t2 (test-file "table/table-shaded.json") 0 (jt-end (test-file "table/table-shaded.json")) "table-shaded" 0)
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/table-spans-partial.pdf") t3 (new-text)) 0 "table-spans-partial runs")
    (assert-text-span t3 (test-file "table/table-spans-partial.json") 0 (jt-end (test-file "table/table-spans-partial.json")) "table-spans-partial" 0)
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/table-whitespace.pdf") t4 (new-text)) 0 "table-whitespace runs")
    (assert-text-span t4 (test-file "table/table-whitespace.json") 0 (jt-end (test-file "table/table-whitespace.json")) "table-whitespace" 0)
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/align-table-numeric.pdf") t5 (new-text)) 0 "align-table-numeric runs")
    (assert-text-span t5 (test-file "table/align-table-numeric.json") 0 (jt-end (test-file "table/align-table-numeric.json")) "align-table-numeric" 0)
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/table-multipage-thead.pdf") t7 (new-text)) 0 "table-multipage-thead runs")
    (assert-text-span t7 (test-file "table/table-multipage-thead.json") 0 (jt-end (test-file "table/table-multipage-thead.json")) "table-multipage-thead: one table on four pages, the repeated header in the ledger" 0)
    (comment "A document of paragraphs and two columns has no table (the stage's other half: it must not make one).")
    (assert-eq (tt-golden (test-file "corpus/synth/pdf/h-plain.pdf") t6 (new-text)) 0 "h-plain runs")
    (assert-text-span t6 (test-file "para/h-plain.json") 0 (jt-end (test-file "para/h-plain.json")) "h-plain makes no table" 0)))

;; P12.10: D16's five bands, with one numeric band empty throughout the body.
(defn ^I32 tt-sparse-ledger [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 credit]
  (tt-at wd ln et (text-blob "Date") 4000 10000 1 0)
  (tt-at wd ln et (text-blob "Details") 8122 10000 1 0)
  (tt-at wd ln et (text-blob "Deposit") 33100 10000 1 1)
  (tt-at wd ln et (text-blob "Withdrawal") 40500 10000 1 1)
  (tt-at wd ln et (text-blob "Balance") 54928 10000 1 1)
  (let [^:mut ^I32 r 0 ^:mut ^I32 x 40500]
    (if (== credit 1) (set x 33100))
    (while (< r 8)
      (do (let [^I32 y (+ 11600 (* r 1600))]
            (tt-at wd ln et (text-blob "20 Sep") 4000 y 0 0)
            (if (== (rem r 2) 0)
              (do (tt-at wd ln et (text-blob "Transfer") 8122 y 0 0)
                  (tt-at wd ln et (text-blob "181.04") x y 0 1)
                  (tt-at wd ln et (text-blob "149,818.96") 54928 y 0 1))
              (do (tt-at wd ln et (text-blob "Electronic transfer") 8122 y 0 0)
                  (tt-at wd ln et (text-blob "1.00") x y 0 1)
                  (tt-at wd ln et (text-blob "999.99") 54928 y 0 1))))
          (set r (+ r 1))))
    (return 0)))

(deftest test-a-debit-only-row-keeps-its-empty-credit-cell
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells) ^Text t (new-text)]
    (tt-sparse-ledger wd ln et 0)
    (assert-eq (tt-run wd ln et pa t) 0 "sparse ledger is well formed")
    (assert-text t "T5w;Gh;R;Ch[Date];Chs[Details];Ch[Deposit];Ch[Withdrawal];Che[Balance];Gb;R;C[20 Sep];Cs[Transfer];C[];Ce[181.04];Ce[149,818.96];R;C[20 Sep];Cs[Electronic transfer];C[];Ce[1.00];Ce[999.99];R;C[20 Sep];Cs[Transfer];C[];Ce[181.04];Ce[149,818.96];R;C[20 Sep];Cs[Electronic transfer];C[];Ce[1.00];Ce[999.99];R;C[20 Sep];Cs[Transfer];C[];Ce[181.04];Ce[149,818.96];R;C[20 Sep];Cs[Electronic transfer];C[];Ce[1.00];Ce[999.99];R;C[20 Sep];Cs[Transfer];C[];Ce[181.04];Ce[149,818.96];R;C[20 Sep];Cs[Electronic transfer];C[];Ce[1.00];Ce[999.99];" "the empty band retains its header and every amount stays at its geometric anchor")))

(deftest test-a-credit-only-row-keeps-its-empty-debit-cell
