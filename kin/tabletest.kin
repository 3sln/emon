(deftest test-cell-text-keeps-the-logical-order-of-each-rtl-line
  (let [^Cells wd (new-cells) ^Cells et (new-cells) ^Cells tw (new-cells)
        ^Cells raw (new-cells) ^Text out (new-text) ^:mut ^I32 i 0]
    (tt-w wd et (text-blob "عدد") 5000 1000 7000 1800 0)
    (tt-w wd et (text-blob "الصفحات") 1000 1000 4500 1800 0)
    (tt-w wd et (text-blob "2026") 1000 2200 3000 3000 0)
    (wd-set wd 0 (hd-line) 0)
    (wd-set wd 1 (hd-line) 0)
    (wd-set wd 2 (hd-line) 1)
    (cells-push tw 1) (cells-push tw 0) (cells-push tw 2)
    (tb-words-raw wd et tw 0 3 raw (new-cells) 0)
    (while (< i (cells-len raw))
      (do (text-cp out (cells-at raw i)) (set i (+ i 1))))
    (assert-text out "عدد الصفحات 2026" "cell words follow logical line order without reversing letters or rows")))

(deftest test-a-caption-between-tables-belongs-to-the-following-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tq (new-cells) ^:mut ^I32 i 0]
    (while (< i 64) (do (cells-push tb 0) (set i (+ i 1))))
    (cells-set tb 0 1) (cells-set tb 1 1000) (cells-set tb 2 10000)
    (cells-set tb 3 15000) (cells-set tb 4 16000)
    (cells-set tb 32 1) (cells-set tb 33 1000) (cells-set tb 34 18000)
    (cells-set tb 35 15000) (cells-set tb 36 24000)
    (tt-line3 wd ln et (text-blob "Table") (text-blob "2") (text-blob "Results") 1000 16800)
    (assert-eq (tb-caption tb 0 wd et ln 0 1 tq) 0 "a preceding table cannot steal the next table's top caption")
    (assert-eq (tb-caption tb 1 wd et ln 0 1 tq) 1 "the following table owns the caption")))

(deftest test-an-indented-three-line-stub-does-not-end-a-numeric-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells) ^Text t (new-text)]
    (tt-at wd ln et (text-blob "Industry") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "2023") 32000 10000 1 1)
    (tt-at wd ln et (text-blob "2024") 43000 10000 1 1)
    (tt-at wd ln et (text-blob "Mining") 7600 12000 0 0)
    (tt-at wd ln et (text-blob "10.0") 32000 12000 0 1)
    (tt-at wd ln et (text-blob "11.0") 43000 12000 0 1)
    (tt-line3 wd ln et (text-blob "Manufacturing") (text-blob "and") (text-blob "reproducing") 8400 14000)
    (tt-line3 wd ln et (text-blob "magnetic") (text-blob "and") (text-blob "optical") 8400 15000)
    (tt-at wd ln et (text-blob "media") 9200 16000 0 0)
    (tt-at wd ln et (text-blob "20.0") 32000 16000 0 1)
    (tt-at wd ln et (text-blob "21.0") 43000 16000 0 1)
    (tt-at wd ln et (text-blob "Construction") 7600 18000 0 0)
    (tt-at wd ln et (text-blob "30.0") 32000 18000 0 1)
    (tt-at wd ln et (text-blob "31.0") 43000 18000 0 1)
    (assert-eq (tt-run wd ln et pa t) 0 "wrapped stub is well formed")
    (assert-text t "T3w;Gh;R;Ch[Industry];Ch[2023];Ch[2024];Gb;R;C[Mining];C[10.0];C[11.0];R;C[Manufacturing and reproducing magnetic and optical media];C[20.0];C[21.0];R;C[Construction];C[30.0];C[31.0];" "a wrapped stub joins the following numeric anchor")))

(deftest test-wrapped-stubs-keep-the-existing-wrapped-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells) ^Text t (new-text)]
