;; Laws for `emon.table` (P5.1-P5.3), on every target.
;;
;; TWO KINDS, as for the paragraph stage. (1) What the stage DECIDES, on evidence written by hand (a word is a row of
;; `words` with its own box and a line of its own; a rule is a thin filled rectangle of `paths`, a fill a large one):
;; a lattice and its spans, header and footer from bold, columns from whitespace, rules and fills, alignment of the
;; columns, the caption, and what is NOT a table (two columns of prose). The answer is written out as a brief, the
;; Model in document order:
;;
;;     T<columns><profile letter>;   a table: r ruled, p partial, s shaded, w whitespace
;;     K[<label>|<text>];            its caption          G<h|b|f>;   a row group        R;   a row
;;     C<r2><c2><h|w><s|c|e>[text];  a cell: row span, column span, header (h col, w row), alignment
;;     P[text];                      a paragraph
;;
;; (2) What it MAKES of real files: the Chrome-printed table documents of the synthetic corpus run PDF -> content ->
;; tables -> paragraphs -> Model -> pretty JSON, byte for byte against `test/table/NAME.json` (`kin/scripts/table-goldens`
;; wrote them; one of them is a table on four pages, P5.4), and a paragraph document, which has no table, makes none.
(ns emon.tabletest
  (:require [emon.lang :refer [I32 Blob Src Cells Text]]
            [emon.test :refer [deftest assert-eq assert-text assert-text-span new-cells new-text
                               test-file text-blob test-t TestT]]
            [emon.port :refer [blob-len cells-len cells-at cells-set cells-push cells-drop text-cp text-i32 src-of-blob]]
            [emon.mscript :refer [jt-end]]
            [emon.model :refer [model-init model-check page-new pk-vector node-count node-kind
                                node-text-start node-text-len node-sub node-attr node-attr-int-or
                                attr-value attr-len text-at text-append-utf8
                                nk-paragraph nk-note nk-table nk-rowgroup nk-row nk-cell nk-caption
                                fk-rowspan fk-colspan fk-columns fk-profile fk-label fk-align]]
            [emon.json :refer [js-emit]]
            [emon.evidence :refer [wd-new wd-set wd-count ln-new ln-count ln-set ln-get wd-get hd-page hd-x0 hd-y0 hd-x1 hd-y1 hd-tstart hd-tlen wf-size wf-font wf-style wf-src hd-line hd-rot
                                   pa-new pa-set pa-rect pf-flags pf-fill pf-falpha pg-filled]]
            [emon.pdfdoc :refer [pd-open]]
            [emon.pdfannot :refer [an-field]]
            [emon.pdfcontent :refer [pc-document]]
            [emon.pdfx :refer [px-index-build]]
            [emon.pdfmeta :refer [pm-run]]
            [emon.pdfstruct :refer [tg-read tg-join]]
            [emon.tagtable :refer [tt-emit]]
            [emon.para :refer [pa-pages pa-build]]
            [emon.columns :refer [lc-copy]]
            [emon.initial :refer [in-detect]]
            [emon.table :refer [tb-build tb-count tb-model-col tb-words-raw tb-caption]]
            [emon.gfuse :refer [gf-doc gfx-mode]]
            [emon.heading :refer [hd-analyze]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

;; ------------------------------------------------------------ hand-made evidence

(defn ^I32 tt-w [^:mut ^Cells wd ^:mut ^Cells et ^Blob b ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 style]
  (comment "One word with its own box (page 1, size 1000, baseline 200 above the bottom).")
  (let [^I32 ts (cells-len et)]
    (text-append-utf8 et b 0 (blob-len b))
    (let [^I32 r (wd-new wd 1 x0 y0 x1 y1 x0 (- y1 200) x1 (- y1 200) 0 0 ts (- (cells-len et) ts) -1 -1 -1)]
      (wd-set wd r (wf-size) 1000)
      (wd-set wd r (wf-font) 0)
      (wd-set wd r (wf-style) style))
    (return 0)))

(defn ^I32 tt-word [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 style]
  (comment "One word and a line of its own.")
  (let [^I32 w0 (wd-count wd)]
    (tt-w wd et b x0 y0 x1 y1 style)
    (ln-new ln 1 x0 y0 x1 y1 x0 (- y1 200) x1 (- y1 200) 0 0 w0 1)
    (return 0)))

(defn ^I32 tt-at [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 x ^I32 y ^I32 style ^I32 right]
  (comment "A word of 500 per character, its left edge at x (its right edge when `right` is 1), 800 tall from y.")
  (let [^I32 w (* 500 (blob-len b))]
    (if (== right 1)
      (tt-word wd ln et b (- x w) y x (+ y 800) style)
      (tt-word wd ln et b x y (+ x w) (+ y 800) style))
    (return 0)))

(defn ^I32 tt-line3 [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob a ^Blob b ^Blob c ^I32 x ^I32 y]
  (comment "One line of three words, 500 per character and a 500 gap, 800 tall from y.")
  (let [^I32 w0 (wd-count wd)
        ^I32 xb (+ (+ x (* 500 (blob-len a))) 500)
        ^I32 xc (+ (+ xb (* 500 (blob-len b))) 500)]
    (tt-w wd et a x y (+ x (* 500 (blob-len a))) (+ y 800) 0)
    (tt-w wd et b xb y (+ xb (* 500 (blob-len b))) (+ y 800) 0)
    (tt-w wd et c xc y (+ xc (* 500 (blob-len c))) (+ y 800) 0)
    (ln-new ln 1 x y (+ xc (* 500 (blob-len c))) (+ y 800) x (- (+ y 800) 200) (+ xc (* 500 (blob-len c))) (- (+ y 800) 200) 0 0 w0 3)
    (return 0)))

(defn ^I32 tt-rule [^:mut ^Cells pa ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "A black filled rectangle: a rule when it is thin.")
  (let [^I32 r (pa-new pa 1 (pa-rect) x0 y0 x1 y1)]
    (pa-set pa r (pf-flags) (pg-filled))
    (pa-set pa r (pf-fill) 0)
    (pa-set pa r (pf-falpha) 1000)
    (return 0)))

(defn ^I32 tt-fill [^:mut ^Cells pa ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 colour]
  (let [^I32 r (pa-new pa 1 (pa-rect) x0 y0 x1 y1)]
    (pa-set pa r (pf-flags) (pg-filled))
    (pa-set pa r (pf-fill) colour)
    (pa-set pa r (pf-falpha) 1000)
    (return 0)))

(defn ^I32 tt-atp [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 x ^I32 y ^I32 style ^I32 right ^I32 page]
  (comment "`tt-at` on page `page` (1 or 2): a word of 500 per character, its left edge at x (its right edge when `right` is 1), 800 tall from y.")
  (let [^I32 w (* 500 (blob-len b))
        ^I32 x0 (- x (* right w))
        ^I32 w0 (wd-count wd)
        ^I32 ts (cells-len et)]
    (text-append-utf8 et b 0 (blob-len b))
    (let [^I32 r (wd-new wd page x0 y (+ x0 w) (+ y 800) x0 (- (+ y 800) 200) (+ x0 w) (- (+ y 800) 200) 0 0 ts (- (cells-len et) ts) -1 -1 -1)]
      (wd-set wd r (wf-size) 1000)
      (wd-set wd r (wf-font) 0)
      (wd-set wd r (wf-style) style))
    (ln-new ln page x0 y (+ x0 w) (+ y 800) x0 (- (+ y 800) 200) (+ x0 w) (- (+ y 800) 200) 0 0 w0 1)
    (return 0)))

(defn ^I32 tt-grid [^:mut ^Cells pa ^I32 x0 ^I32 x1 ^I32 x2 ^I32 x3 ^I32 y0 ^I32 y1 ^I32 y2 ^I32 y3]
  (comment "The rules of a 3 x 3 lattice, the vertical at x2 missing between y2 and y3 (the last row's two cells are one).")
  (tt-rule pa x0 (- y0 50) x3 (+ y0 50))
  (tt-rule pa x0 (- y1 50) x3 (+ y1 50))
  (tt-rule pa x0 (- y2 50) x3 (+ y2 50))
  (tt-rule pa x0 (- y3 50) x3 (+ y3 50))
  (tt-rule pa (- x0 50) y0 (+ x0 50) y3)
  (tt-rule pa (- x1 50) y0 (+ x1 50) y3)
  (tt-rule pa (- x2 50) y0 (+ x2 50) y2)
  (tt-rule pa (- x3 50) y0 (+ x3 50) y3)
  (return 0))

(defn ^I32 tt-run-text [^Cells nodes ^I32 n ^Cells text ^:mut ^Text t]
  (let [^I32 s (node-text-start nodes n)
        ^:mut ^I32 k 0]
    (while (< k (node-text-len nodes n))
      (do (text-cp t (text-at text (+ s k)))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 tt-brief [^:mut ^Text t ^Cells nodes ^Cells attrs ^Cells text]
  (comment "The brief of the Model (see the head of this file): every node but the root, in id order.")
  (let [^I32 n (node-count nodes)
        ^:mut ^I32 i 1
        ^:mut ^I32 kind 0
        ^:mut ^I32 a 0
        ^:mut ^I32 v 0]
    (while (< i n)
      (do (set kind (node-kind nodes i))
          (if (== kind (nk-paragraph))
            (do (text-cp t 80) (text-cp t 91)
                (tt-run-text nodes i text t)
                (text-cp t 93) (text-cp t 59)))
          (if (== kind (nk-note))
            (do (text-cp t 78) (text-cp t 59)))
          (if (== kind (nk-table))
            (do (text-cp t 84)
                (text-i32 t (node-attr-int-or nodes attrs i (fk-columns) 0))
                (set a (node-attr nodes attrs i (fk-profile)))
                (if (>= a 0) (text-cp t (text-at text (attr-value attrs a))))
                (text-cp t 59)))
          (if (== kind (nk-caption))
            (do (text-cp t 75) (text-cp t 91)
                (set a (node-attr nodes attrs i (fk-label)))
                (if (>= a 0)
                  (do (set v 0)
                      (while (< v (attr-len attrs a))
                        (do (text-cp t (text-at text (+ (attr-value attrs a) v)))
                            (set v (+ v 1))))))
                (text-cp t 124)
                (tt-run-text nodes i text t)
                (text-cp t 93) (text-cp t 59)))
          (if (== kind (nk-rowgroup))
            (do (text-cp t 71)
                (if (== (node-sub nodes i) 1) (text-cp t 104))
                (if (== (node-sub nodes i) 2) (text-cp t 98))
                (if (== (node-sub nodes i) 3) (text-cp t 102))
                (text-cp t 59)))
          (if (== kind (nk-row))
            (do (text-cp t 82) (text-cp t 59)))
          (if (== kind (nk-cell))
            (do (text-cp t 67)
                (set v (node-attr-int-or nodes attrs i (fk-rowspan) 1))
                (if (> v 1) (do (text-cp t 114) (text-i32 t v)))
                (set v (node-attr-int-or nodes attrs i (fk-colspan) 1))
                (if (> v 1) (do (text-cp t 99) (text-i32 t v)))
                (if (== (node-sub nodes i) 1) (text-cp t 104))
                (if (== (node-sub nodes i) 2) (text-cp t 119))
                (set v (node-attr-int-or nodes attrs i (fk-align) 0))
                (if (== v 1) (text-cp t 115))
                (if (== v 2) (text-cp t 99))
                (if (== v 3) (text-cp t 101))
                (text-cp t 91)
                (tt-run-text nodes i text t)
                (text-cp t 93) (text-cp t 59)))
          (set i (+ i 1))))
    (return 0)))

;; Audit all retained text fixtures, independently of the page-local tbo arena.
(defn ^I32 tt-body-audit [^Cells wd ^Cells et ^Cells tb ^Cells tc ^Cells tw]
  (let [^:mut ^I32 w 0 ^:mut ^I32 k 0 ^:mut ^I32 c 0 ^:mut ^I32 j 0
        ^:mut ^I32 inside 0 ^:mut ^I32 owned 0 ^:mut ^I32 drop 0]
    (while (< w (wd-count wd))
      (do (set inside 0) (set owned 0) (set drop 0) (set k 0)
          (let [^I32 x (quot (+ (wd-get wd w (hd-x0)) (wd-get wd w (hd-x1))) 2)
                ^I32 y (quot (+ (wd-get wd w (hd-y0)) (wd-get wd w (hd-y1))) 2)
                ^I32 rot (wd-get wd w (hd-rot)) ^I32 wordlen (wd-get wd w (hd-tlen))]
            (if (or (== wordlen 0) (and (>= rot 100) (<= rot 35900))) (set drop 1))
            (if (== wordlen 1)
              (let [^I32 cp (cells-at et (wd-get wd w (hd-tstart)))]
                (if (or (== cp 46) (or (== cp 58) (or (== cp 45) (or (== cp 8211) (== cp 8212))))) (set drop 1))))
            (while (< k (quot (cells-len tb) 32))
              (do (let [^I32 b (* k 32)]
                    (if (and (== (wd-get wd w (hd-page)) (cells-at tb b))
                             (and (>= x (cells-at tb (+ b 1))) (and (<= x (cells-at tb (+ b 3)))
                                  (and (>= y (cells-at tb (+ b 2))) (<= y (cells-at tb (+ b 4)))))))
                      (if (and (!= (cells-at tb (+ b 5)) 1) (!= (cells-at tb (+ b 5)) 5)) (set inside 1)))
                    (set c (cells-at tb (+ b 9)))
                    (while (< c (+ (cells-at tb (+ b 9)) (cells-at tb (+ b 10))))
                      (do (set j 0)
                          (while (< j (cells-at tc (+ (* c 16) 9)))
                            (do (if (== (cells-at tw (+ (cells-at tc (+ (* c 16) 8)) j)) w) (set owned (+ owned 1)))
                                (set j (+ j 1))))
                          (set c (+ c 1)))))
                  (set k (+ k 1)))))
          (if (== inside 1)
            (if (> owned 1) (return 5)
              (if (and (== owned 0) (== drop 0)) (return 6))))
          (set w (+ w 1))))
    (return 0)))

(defn ^I32 tt-run-an [^Cells wd ^Cells ln ^Cells et ^Cells pa ^:mut ^Text t ^I32 np ^Cells an]
  (comment "`tt-run-n` over a document whose annotations (rows of `an`, `AN_STRIDE` cells) are `an`: the form fields' widgets (D583).")
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells) ^Cells ii (new-cells) ^Cells al (new-cells)
        ^Cells lt (new-cells) ^Cells ls (new-cells) ^Cells sd (new-cells) ^Cells it (new-cells)
        ^Cells io (new-cells) ^Cells rw (new-cells) ^Cells gu (new-cells) ^Cells ac (new-cells)
        ^Cells tm (new-cells) ^Cells cf (new-cells) ^Cells lo (new-cells) ^Cells pr (new-cells) ^Cells dbg (new-cells) ^Cells hc (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tq (new-cells) ^Cells tx (new-cells)
        ^Cells s0 (new-cells) ^Cells s1 (new-cells) ^Cells s2 (new-cells) ^Cells s3 (new-cells) ^Cells s4 (new-cells)
        ^Cells s5 (new-cells) ^Cells s6 (new-cells) ^Cells s7 (new-cells) ^Cells s8 (new-cells) ^Cells s9 (new-cells)
        ^Cells s10 (new-cells) ^Cells s11 (new-cells) ^Cells s12 (new-cells) ^Cells s13 (new-cells) ^Cells s14 (new-cells)
        ^Cells s15 (new-cells) ^Cells s16 (new-cells) ^Cells s17 (new-cells) ^Cells s18 (new-cells)
        ^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells cand (new-cells) ^Cells gpts (new-cells) ^Cells gmk (new-cells) ^Cells gim (new-cells) ^Cells t0e (new-cells) ^Cells t1e (new-cells) ^Cells t2e (new-cells) ^Cells t3e (new-cells) ^Cells t4e (new-cells) ^Cells t5e (new-cells) ^Cells t6e (new-cells) ^Cells t7e (new-cells) ^Cells t8e (new-cells) ^Cells t9e (new-cells) ^Cells t10e (new-cells) ^Cells t11e (new-cells) ^Cells t12e (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 61200 79200 0 (pk-vector))
    (if (== np 2) (page-new pages 2 61200 79200 0 (pk-vector)))
    (gf-doc pa gpts gmk gim np (gfx-mode) grl gfl cand (new-cells))
    (tb-build wd ln et grl gfl np tb tc tw tq tx (new-cells) (new-cells) s0 s1 s2 s3 s4 s5 s6 s7 s8 s9 s10 s11 s12 s13 s14 s15 s16 s17 s18 pages t0e t1e t2e t3e t4e t5e t6e t7e t8e t9e t10e t11e t12e an)
    (if (!= (tt-body-audit wd et tb tc tw) 0) (return 7))
    (lc-copy ln lt)
    (pa-build wd et np pages layout nodes attrs regions text ord raw tmp fr gp lt ls sd it io rw gu ac tm cf lo pr dbg hc tb tc tw tq ledger ii al)
    (tt-brief t nodes attrs text)
    (return (model-check nodes attrs regions text pages ledger layout st))))

(defn ^I32 tt-run-n [^Cells wd ^Cells ln ^Cells et ^Cells pa ^:mut ^Text t ^I32 np]
  (comment "Tables, then paragraphs, then the brief of the Model, of a document of `np` pages (1 or 2). Answers `model-check`'s verdict.")
  (return (tt-run-an wd ln et pa t np (new-cells))))

(defn ^I32 tt-run [^Cells wd ^Cells ln ^Cells et ^Cells pa ^:mut ^Text t]
  (comment "Tables, then paragraphs, then the brief of the Model. Answers `model-check`'s verdict.")
  (return (tt-run-n wd ln et pa t 1)))

;; ------------------------------------------------------------------- ruled

(deftest test-a-lattice-is-a-table-and-a-missing-rule-is-a-span
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (tt-word wd ln et (text-blob "Intro") 7200 7000 10200 7800 0)
    (tt-grid pa 7200 17200 27200 37200 10000 12000 14000 16000)
    (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
    (tt-at wd ln et (text-blob "Qty") 17600 10600 1 0)
    (tt-at wd ln et (text-blob "Price") 27600 10600 1 0)
    (tt-at wd ln et (text-blob "Bolt") 7600 12600 0 0)
    (tt-at wd ln et (text-blob "10") 17600 12600 0 0)
    (tt-at wd ln et (text-blob "2.50") 27600 12600 0 0)
    (tt-at wd ln et (text-blob "Total") 7600 14600 0 0)
    (tt-at wd ln et (text-blob "12.50") 17600 14600 0 0)
    (tt-word wd ln et (text-blob "Outro") 7200 17200 10200 18000 0)
    (assert-eq (tt-run wd ln et pa t) 0 "lattice: well formed")
    (assert-text t "P[Intro];T3r;Gh;R;Ch[Item];Ch[Qty];Ch[Price];Gb;R;C[Bolt];C[10];C[2.50];R;C[Total];Cc2[12.50];P[Outro];"
                 "a 3 x 3 lattice with its last row's two cells joined: header, body, and the paragraphs around it")))

(defn ^I32 tt-phrase-word [^:mut ^Cells wd ^:mut ^Cells et ^Blob b ^I32 x ^I32 y ^I32 line]
  (comment "A word of 500 a character, 800 tall from y at x, whose `line` field is `line` (the words of a line share it).")
  (let [^I32 r (wd-count wd)]
    (tt-w wd et b x y (+ x (* 500 (blob-len b))) (+ y 800) 0)
    (wd-set wd r (hd-line) line)
    (return 0)))

(defn ^I32 tt-lattice6 [^:mut ^Cells pa]
  (comment "The rules of a lattice of two rows and six columns, 38 pt wide each (x 72 pt to 300 pt, y 100 to 140 pt).")
  (let [^:mut ^I32 k 0]
    (while (< k 7)
      (do (tt-rule pa (- (+ 7200 (* 3800 k)) 50) 10000 (+ (+ 7200 (* 3800 k)) 50) 14000)
          (set k (+ k 1))))
    (tt-rule pa 7200 9950 30000 10050)
    (tt-rule pa 7200 11950 30000 12050)
    (tt-rule pa 7200 13950 30000 14050)
    (return 0)))

(deftest test-a-line-of-text-that-the-rules-cut-is-a-diagrams-label-and-no-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells wd2 (new-cells) ^Cells ln2 (new-cells) ^Cells et2 (new-cells) ^Cells pa2 (new-cells)
        ^Text t (new-text) ^Text t2 (new-text)]
    (comment "D583 (smoke review B issue 7): the boxes of a figure (the patches of the Vision Transformer's picture) make a lattice of rules, and `Linear Projection of Flattened Patches` is set across it,")
    (comment "a word a box: the words are one line, each 300 from the next, which a table's cells do not do (a cell is padded). Six words of a row far from each other in the same lattice are a table.")
    (tt-lattice6 pa)
    (tt-phrase-word wd et (text-blob "1") 8500 10600 0)
    (tt-phrase-word wd et (text-blob "2") 12300 10600 0)
    (tt-phrase-word wd et (text-blob "3") 16100 10600 0)
    (tt-phrase-word wd et (text-blob "4") 19900 10600 0)
    (tt-phrase-word wd et (text-blob "5") 23700 10600 0)
    (tt-phrase-word wd et (text-blob "6") 27500 10600 0)
    (ln-new ln 1 8500 10600 28000 11400 8500 11200 28000 11200 0 0 0 6)
    (tt-phrase-word wd et (text-blob "Project") 7350 12600 1)
    (tt-phrase-word wd et (text-blob "Flatten") 11150 12600 1)
    (tt-phrase-word wd et (text-blob "Patches") 14950 12600 1)
    (tt-phrase-word wd et (text-blob "Encoder") 18750 12600 1)
    (tt-phrase-word wd et (text-blob "Decoder") 22550 12600 1)
    (tt-phrase-word wd et (text-blob "Outputs") 26350 12600 1)
    (ln-new ln 1 7350 12600 29850 13400 7350 13200 29850 13200 0 0 6 6)
    (assert-eq (tt-run wd ln et pa t) 0 "diagram: well formed")
    (assert-text t "P[1 2 3 4 5 6 Project Flatten Patches Encoder Decoder Outputs];" "no table: the words are the page's text")
    (comment "the same grid with the words of the second row each in the middle of its cell, far from each other (a line is a line of their own): a table")
    (tt-lattice6 pa2)
    (tt-phrase-word wd2 et2 (text-blob "1") 8500 10600 0)
    (tt-phrase-word wd2 et2 (text-blob "2") 12300 10600 1)
    (tt-phrase-word wd2 et2 (text-blob "3") 16100 10600 2)
    (tt-phrase-word wd2 et2 (text-blob "4") 19900 10600 3)
    (tt-phrase-word wd2 et2 (text-blob "5") 23700 10600 4)
    (tt-phrase-word wd2 et2 (text-blob "6") 27500 10600 5)
    (tt-phrase-word wd2 et2 (text-blob "Ax") 8300 12600 6)
    (tt-phrase-word wd2 et2 (text-blob "Bx") 12100 12600 7)
    (tt-phrase-word wd2 et2 (text-blob "Cx") 15900 12600 8)
    (tt-phrase-word wd2 et2 (text-blob "Dx") 19700 12600 9)
    (tt-phrase-word wd2 et2 (text-blob "Ex") 23500 12600 10)
    (tt-phrase-word wd2 et2 (text-blob "Fx") 27300 12600 11)
    (let [^:mut ^I32 k 0]
      (while (< k 12)
        (do (ln-new ln2 1 7200 10600 28000 11400 7200 11200 28000 11200 0 0 k 1)
            (set k (+ k 1)))))
    (assert-eq (tt-run wd2 ln2 et2 pa2 t2) 0 "table: well formed")
    (assert-text t2 "T6r;Gb;R;C[1];C[2];C[3];C[4];C[5];C[6];R;C[Ax];C[Bx];C[Cx];C[Dx];C[Ex];C[Fx];" "a table")))

(deftest test-the-frame-of-a-page-is-no-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "D583 (smoke review B issue 7): the sheet of an engineering drawing, a frame 83 per cent of the page's width and 87 of its height, a title block of four cells under it and the words of the")
    (comment "drawing in the large cell above: the rules meet as a table's do and the words are in cells, but it is the page's frame, with a cell of 60 per cent of the page.")
    (tt-rule pa 5000 4950 56000 5050)
    (tt-rule pa 5000 61950 56000 62050)
    (tt-rule pa 5000 69950 56000 70050)
    (tt-rule pa 5000 73950 56000 74050)
    (tt-rule pa 4950 5000 5050 74000)
    (tt-rule pa 55950 5000 56050 74000)
    (tt-rule pa 29950 62000 30050 74000)
    (tt-at wd ln et (text-blob "Detail") 10000 10000 0 0)
    (tt-at wd ln et (text-blob "Grate") 30000 20000 0 0)
    (tt-at wd ln et (text-blob "Weld") 40000 30000 0 0)
    (tt-at wd ln et (text-blob "Plan") 12000 50000 0 0)
    (tt-at wd ln et (text-blob "Title") 7000 64000 0 0)
    (tt-at wd ln et (text-blob "Scale") 33000 64000 0 0)
    (tt-at wd ln et (text-blob "Material") 7000 71000 0 0)
    (tt-at wd ln et (text-blob "Item") 33000 71000 0 0)
    (assert-eq (tt-run wd ln et pa t) 0 "frame: well formed")
    (assert-text t "P[Detail];P[Grate];P[Weld];P[Plan];P[Title];P[Scale];P[Material];P[Item];" "no table: the words are the page's text")))

(defn ^I32 tt-widget [^:mut ^Cells an ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "One text field's widget of page 1 as a row of `an` (38 cells: 0 the page, 0 based, 1 the subtype `an-field`, 4-7 the rectangle).")
  (let [^:mut ^I32 k 0]
    (while (< k 38)
      (do (cells-push an 0)
          (set k (+ k 1))))
    (let [^I32 r (- (quot (cells-len an) 38) 1)]
      (cells-set an (+ (* r 38) 1) (an-field))
      (cells-set an (+ (* r 38) 4) x0)
      (cells-set an (+ (* r 38) 5) y0)
      (cells-set an (+ (* r 38) 6) x1)
      (cells-set an (+ (* r 38) 7) y1))
    (return 0)))

(defn ^I32 tt-form-page [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^:mut ^Cells pa]
  (comment "A form's page: a header row and a footer row of text across the page, and between them six labels in one open cell (no rule between them) and a column of six boxes, ruled.")
  (tt-rule pa 7200 9950 37200 10050)
  (tt-rule pa 7200 11950 37200 12050)
  (tt-rule pa 27200 13950 37200 14050)
  (tt-rule pa 27200 15950 37200 16050)
  (tt-rule pa 27200 17950 37200 18050)
  (tt-rule pa 27200 19950 37200 20050)
  (tt-rule pa 27200 21950 37200 22050)
  (tt-rule pa 7200 23950 37200 24050)
  (tt-rule pa 7200 25950 37200 26050)
  (tt-rule pa 7150 10000 7250 26000)
  (tt-rule pa 27150 10000 27250 26000)
  (tt-rule pa 37150 10000 37250 26000)
  (tt-at wd ln et (text-blob "Item") 7600 10600 1 0)
  (tt-at wd ln et (text-blob "Amount") 27600 10600 1 0)
  (tt-at wd ln et (text-blob "Wages") 7600 12600 0 0)
  (tt-at wd ln et (text-blob "Interest") 7600 14600 0 0)
  (tt-at wd ln et (text-blob "Rents") 7600 16600 0 0)
  (tt-at wd ln et (text-blob "Royalties") 7600 18600 0 0)
  (tt-at wd ln et (text-blob "Dividends") 7600 20600 0 0)
  (tt-at wd ln et (text-blob "Other") 7600 22600 0 0)
  (tt-at wd ln et (text-blob "Total") 7600 24600 0 0)
  (tt-at wd ln et (text-blob "Sum") 27600 24600 0 0)
  (return 0))

(deftest test-the-boxes-of-a-forms-fields-are-not-a-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells an (new-cells) ^Text t (new-text) ^Text t2 (new-text)]
    (comment "D583 (smoke review A issue 10): the page of a form: its labels in one open cell and a column of boxes, which are the fields' widgets. Without fields it is a table; with a widget in")
    (comment "each of its six empty cells (more than the cells with text) the rules are the fields' boxes and the labels are the page's lines, to which the fields go (`emon.fields`).")
    (tt-form-page wd ln et pa)
    (assert-eq (tt-run wd ln et pa t) 0 "no fields: well formed")
    (assert-text t "T2r;Gh;R;Ch[Item];Ch[Amount];Gb;R;Cr6s[Wages Interest Rents Royalties Dividends Other];C[];R;C[];R;C[];R;C[];R;C[];R;C[];R;Cs[Total];C[Sum];"
                 "a ruled grid: the label cell spans six rows")
    (tt-widget an 27800 12300 36600 13700)
    (tt-widget an 27800 14300 36600 15700)
    (tt-widget an 27800 16300 36600 17700)
    (tt-widget an 27800 18300 36600 19700)
    (tt-widget an 27800 20300 36600 21700)
    (tt-widget an 27800 22300 36600 23700)
    (assert-eq (tt-run-an wd ln et pa t2 1 an) 0 "fields: well formed")
    (assert-text t2 "T2p;Gh;R;Chs[Item];Ch[Amount];Gb;R;Cs[Wages];C[];R;Cs[Interest];C[];R;Cs[Rents];C[];R;Cs[Royalties];C[];R;Cs[Dividends];C[];R;Cs[Other];C[];R;Cs[Total];C[Sum];"
                 "the page's boxes are no lattice: each label has its own row and the field goes in it, not one cell that holds all the labels")))

;; --------------------------------------------------------------- whitespace

(deftest test-columns-of-whitespace-are-a-table-and-prose-columns-are-not
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text)]
    (comment "A header of bold words and four rows of a label and two numbers, right-aligned, no rule at all.")
    (tt-at wd ln et (text-blob "Fund") 7200 10000 1 0)
    (tt-at wd ln et (text-blob "Q1") 30000 10000 1 1)
    (tt-at wd ln et (text-blob "Q2") 40000 10000 1 1)
    (tt-at wd ln et (text-blob "Alpha") 7200 11600 0 0)
    (tt-at wd ln et (text-blob "3.0%") 30000 11600 0 1)
    (tt-at wd ln et (text-blob "111.5%") 40000 11600 0 1)
    (tt-at wd ln et (text-blob "Bo") 7200 13200 0 0)
    (tt-at wd ln et (text-blob "4.7%") 30000 13200 0 1)
    (tt-at wd ln et (text-blob "4.3%") 40000 13200 0 1)
    (tt-at wd ln et (text-blob "Gammarays") 7200 14800 0 0)
    (tt-at wd ln et (text-blob "12.1%") 30000 14800 0 1)
    (tt-at wd ln et (text-blob "9.5%") 40000 14800 0 1)
    (tt-at wd ln et (text-blob "Total") 7200 16400 1 0)
    (tt-at wd ln et (text-blob "6.4%") 30000 16400 1 1)
    (tt-at wd ln et (text-blob "6.6%") 40000 16400 1 1)
    (assert-eq (tt-run wd ln et pa t) 0 "whitespace: well formed")
    (assert-text t "T3w;Gh;R;Chs[Fund];Che[Q1];Che[Q2];Gb;R;Cs[Alpha];C[3.0%];Ce[111.5%];R;Cs[Bo];C[4.7%];Ce[4.3%];R;Cs[Gammarays];C[12.1%];Ce[9.5%];Gf;R;Cws[Total];Cw[6.4%];Cwe[6.6%];"
                 "a bold header, numeric columns right-aligned: header cells, body cells, alignment from the text extent")
    (comment "Two columns of prose, four words a line: columns, not a table.")
    (cells-drop wd 0)
    (cells-drop ln 0)
    (cells-drop et 0)
    (tt-at wd ln et (text-blob "the old") 7200 10000 0 0)
    (tt-at wd ln et (text-blob "was and") 30000 10000 0 0)
    (tt-at wd ln et (text-blob "of the") 7200 11200 0 0)
    (tt-at wd ln et (text-blob "that is") 30000 11200 0 0)
    (tt-at wd ln et (text-blob "and then") 7200 12400 0 0)
    (tt-at wd ln et (text-blob "went on") 30000 12400 0 0)
    (tt-at wd ln et (text-blob "she said") 7200 13600 0 0)
    (tt-at wd ln et (text-blob "to him") 30000 13600 0 0)
    (assert-eq (tt-run wd ln et pa t2) 0 "prose: well formed")
    (assert-text t2 "P[the old];P[was and];P[of the];P[that is];P[and then];P[went on];P[she said];P[to him];"
                 "lowercase text with half the cells empty is not a table")))

(deftest test-two-columns-of-russian-prose-are-no-table-either
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text) ^Text t2 (new-text)]
    (comment "D583 (smoke review B issue 14): the same two columns of lowercase words, four words a line, in Cyrillic: the lowercase test knew ASCII letters only, so the lines of a Russian paragraph set")
    (comment "beside an infobox were a table.")
    (tt-line3 wd ln et (text-blob "это") (text-blob "был") (text-blob "так") 7200 10000)
    (tt-line3 wd ln et (text-blob "когда") (text-blob "мы") (text-blob "все") 30000 10000)
    (tt-line3 wd ln et (text-blob "что") (text-blob "она") (text-blob "там") 7200 11200)
    (tt-line3 wd ln et (text-blob "вот") (text-blob "так") (text-blob "уже") 30000 11200)
    (tt-line3 wd ln et (text-blob "его") (text-blob "все") (text-blob "тут") 7200 12400)
    (tt-line3 wd ln et (text-blob "как") (text-blob "раз") (text-blob "ему") 30000 12400)
    (tt-line3 wd ln et (text-blob "или") (text-blob "нет") (text-blob "ещё") 7200 13600)
    (tt-line3 wd ln et (text-blob "для") (text-blob "тех") (text-blob "кто") 30000 13600)
    (assert-eq (tt-run wd ln et pa t) 0 "prose: well formed")
    (assert-text t "P[это был так что она там его все тут или нет ещё когда мы все вот так уже как раз ему для тех кто];" "lowercase Cyrillic text in two columns is not a table")
    (comment "and the same lines between rules (a link's underlines, a page's rules): the candidate of the rules and the channels, which the lowercase test is there for")
    (tt-rule pa 7200 9850 45000 9950)
    (tt-rule pa 7200 11050 45000 11150)
    (tt-rule pa 7200 12250 45000 12350)
    (tt-rule pa 7200 13450 45000 13550)
    (tt-rule pa 7200 14650 45000 14750)
    (assert-eq (tt-run wd ln et pa t2) 0 "ruled prose: well formed")
    (assert-text t2 "P[это был так что она там его все тут или нет ещё когда мы все вот так уже как раз ему для тех кто];" "no table")))

;; ------------------------------------------- whitespace runs on scans (D459)

(defn ^I32 tt-line2 [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob a ^Blob b ^I32 x ^I32 y]
  (comment "One line of two words, 500 per character and a 500 gap, 800 tall from y.")
  (let [^I32 w0 (wd-count wd)
        ^I32 xb (+ (+ x (* 500 (blob-len a))) 500)]
    (tt-w wd et a x y (+ x (* 500 (blob-len a))) (+ y 800) 0)
    (tt-w wd et b xb y (+ xb (* 500 (blob-len b))) (+ y 800) 0)
    (ln-new ln 1 x y (+ xb (* 500 (blob-len b))) (+ y 800) x (- (+ y 800) 200) (+ xb (* 500 (blob-len b))) (- (+ y 800) 200) 0 0 w0 2)
    (return 0)))

(defn ^I32 tt-prose-row [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 y
                         ^Blob a1 ^Blob a2 ^Blob b1 ^Blob b2 ^Blob c1 ^Blob c2]
  (comment "A row of three cells of two lowercase words each: text set in chunks.")
  (tt-line2 wd ln et a1 a2 7200 y)
  (tt-line2 wd ln et b1 b2 30000 y)
  (tt-line2 wd ln et c1 c2 40000 y)
  (return 0))

(defn ^I32 tt-tw [^:mut ^Cells wd ^:mut ^Cells et ^Blob b ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 tilt ^I32 size ^I32 line]
  (comment "One word whose baseline slopes by `tilt` parts per million from y1 - 200 at x 7200 (the line of a scan).")
  (let [^I32 ts (cells-len et)
        ^I32 base (- y1 200)]
    (text-append-utf8 et b 0 (blob-len b))
    (let [^I32 r (wd-new wd 1 x0 y0 x1 y1
                         x0 (+ base (quot (* tilt (- x0 7200)) 1000000)) x1 (+ base (quot (* tilt (- x1 7200)) 1000000))
                         0 0 ts (- (cells-len et) ts) line -1 -1)]
      (wd-set wd r (wf-size) size)
      (wd-set wd r (wf-font) 0)
      (wd-set wd r (wf-style) 0))
    (return 0)))

(defn ^I32 tt-trow [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob a ^Blob b ^Blob c ^I32 y ^I32 tilt ^I32 size]
  (comment "One line of three words (at x 7200, 20000 and 36000, 800 tall from y) with a baseline that slopes by `tilt` parts per")
  (comment "million, and the words' size `size`: a row of a scan, whose lines Tesseract fits one by one.")
  (let [^I32 w0 (wd-count wd)
        ^I32 l (ln-count ln)
        ^I32 xb 20000
        ^I32 xc 36000
        ^I32 x1 (+ xc (* 500 (blob-len c)))
        ^I32 base (+ y 600)]
    (tt-tw wd et a 7200 y (+ 7200 (* 500 (blob-len a))) (+ y 800) tilt size l)
    (tt-tw wd et b xb y (+ xb (* 500 (blob-len b))) (+ y 800) tilt size l)
    (tt-tw wd et c xc y x1 (+ y 800) tilt size l)
    (ln-new ln 1 7200 y x1 (+ y 800) 7200 base x1 (+ base (quot (* tilt (- x1 7200)) 1000000)) 0 0 w0 3)
    (return 0)))

(deftest test-a-tail-that-spoils-a-whitespace-run-is-let-go
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "A header, five rows of a label and two numbers, then three rows of lowercase text set in three chunks: as one run")
    (comment "they are prose in columns and the run is refused; without its last three rows it is the table.")
    (tt-at wd ln et (text-blob "Fund") 7200 10000 1 0)
    (tt-at wd ln et (text-blob "Q1") 30000 10000 1 1)
    (tt-at wd ln et (text-blob "Q2") 40000 10000 1 1)
    (tt-at wd ln et (text-blob "Alpha") 7200 11600 0 0)
    (tt-at wd ln et (text-blob "3.0%") 30000 11600 0 1)
    (tt-at wd ln et (text-blob "111.5%") 40000 11600 0 1)
    (tt-at wd ln et (text-blob "Bo") 7200 13200 0 0)
    (tt-at wd ln et (text-blob "4.7%") 30000 13200 0 1)
    (tt-at wd ln et (text-blob "4.3%") 40000 13200 0 1)
    (tt-at wd ln et (text-blob "Gammarays") 7200 14800 0 0)
    (tt-at wd ln et (text-blob "12.1%") 30000 14800 0 1)
    (tt-at wd ln et (text-blob "9.5%") 40000 14800 0 1)
    (tt-at wd ln et (text-blob "Delta") 7200 16400 0 0)
    (tt-at wd ln et (text-blob "5.1%") 30000 16400 0 1)
    (tt-at wd ln et (text-blob "2.2%") 40000 16400 0 1)
    (tt-prose-row wd ln et 19000 (text-blob "net") (text-blob "thirty") (text-blob "days") (text-blob "from") (text-blob "late") (text-blob "fees"))
    (tt-prose-row wd ln et 20600 (text-blob "pay") (text-blob "by") (text-blob "bank") (text-blob "transfer") (text-blob "sort") (text-blob "code"))
    (tt-prose-row wd ln et 22200 (text-blob "thank") (text-blob "you") (text-blob "for") (text-blob "your") (text-blob "custom") (text-blob "again"))
    (assert-eq (tt-run wd ln et pa t) 0 "tail: well formed")
    (assert-text t "T3w;Gh;R;Chs[Fund];Che[Q1];Che[Q2];Gb;R;Cs[Alpha];C[3.0%];Ce[111.5%];R;Cs[Bo];C[4.7%];Ce[4.3%];R;Cs[Gammarays];C[12.1%];Ce[9.5%];R;Cs[Delta];C[5.1%];Ce[2.2%];P[net thirty];P[days from];P[late fees];P[pay by];P[bank transfer];P[sort code];P[thank you];P[for your];P[custom again];"
                 "the three rows of text in chunks that spoil the run are not rows of the table: five rows and a header, then paragraphs")))

(deftest test-a-running-header-apart-from-a-whitespace-run-is-no-row-of-it
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Two chunks of a page header, more than two pitches above a table of numbers whose rows are a pitch (1200) apart.")
    (tt-at wd ln et (text-blob "Statement") 7200 5400 0 0)
    (tt-at wd ln et (text-blob "Page 2") 40000 5400 0 1)
    (tt-at wd ln et (text-blob "Fund") 7200 8000 1 0)
    (tt-at wd ln et (text-blob "Q1") 30000 8000 1 1)
    (tt-at wd ln et (text-blob "Q2") 40000 8000 1 1)
    (tt-at wd ln et (text-blob "Alpha") 7200 9200 0 0)
    (tt-at wd ln et (text-blob "3.0%") 30000 9200 0 1)
    (tt-at wd ln et (text-blob "111.5%") 40000 9200 0 1)
    (tt-at wd ln et (text-blob "Bo") 7200 10400 0 0)
    (tt-at wd ln et (text-blob "4.7%") 30000 10400 0 1)
    (tt-at wd ln et (text-blob "4.3%") 40000 10400 0 1)
    (tt-at wd ln et (text-blob "Gammarays") 7200 11600 0 0)
    (tt-at wd ln et (text-blob "12.1%") 30000 11600 0 1)
    (tt-at wd ln et (text-blob "9.5%") 40000 11600 0 1)
    (tt-at wd ln et (text-blob "Total") 7200 12800 1 0)
    (tt-at wd ln et (text-blob "6.4%") 30000 12800 1 1)
    (tt-at wd ln et (text-blob "6.6%") 40000 12800 1 1)
    (assert-eq (tt-run wd ln et pa t) 0 "header: well formed")
    (assert-text t "P[Statement];P[Page 2];T3w;Gh;R;Chs[Fund];Che[Q1];Che[Q2];Gb;R;Cs[Alpha];C[3.0%];Ce[111.5%];R;Cs[Bo];C[4.7%];Ce[4.3%];R;Cs[Gammarays];C[12.1%];Ce[9.5%];Gf;R;Cws[Total];Cw[6.4%];Cwe[6.6%];"
                 "the page header more than two pitches above is two paragraphs, not the first row of the table")))

(deftest test-the-rows-of-a-tilted-scan-are-told-apart-by-their-lines
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
    (comment "Five rows a pitch (1000) apart on a page tilted by 20000 parts per million, the third fitted flat by the OCR and with a size")
    (comment "four times the others' (a box that took in a dark band): its words' own baselines differ by 700 across the row, and the")
    (comment "chain tolerance of its size is more than the pitch; each line has one key, and the tolerance of two sizes is the smaller.")
    (tt-trow wd ln et (text-blob "Fund") (text-blob "Q1") (text-blob "Q2") 10000 20000 1000)
    (tt-trow wd ln et (text-blob "Alpha") (text-blob "3.0%") (text-blob "111.5%") 11000 20000 1000)
    (tt-trow wd ln et (text-blob "Bo") (text-blob "4.7%") (text-blob "4.3%") 12000 0 4000)
    (tt-trow wd ln et (text-blob "Gammarays") (text-blob "12.1%") (text-blob "9.5%") 13000 20000 1000)
    (tt-trow wd ln et (text-blob "Delta") (text-blob "5.1%") (text-blob "2.2%") 14000 20000 1000)
    (assert-eq (tt-run wd ln et pa t) 0 "tilt: well formed")
    (assert-text t "T3w;Gh;R;Chs[Fund];Ch[Q1];Chs[Q2];Gb;R;Cs[Alpha];C[3.0%];Cs[111.5%];R;Cs[Bo];C[4.7%];Cs[4.3%];R;Cs[Gammarays];C[12.1%];Cs[9.5%];R;Cs[Delta];C[5.1%];Cs[2.2%];"
                 "five rows of three cells on a tilted page, the row of the oversized flat line one row of its own")))

;; ------------------------------------------------------------ partial, shaded

(deftest test-rules-above-and-below-make-a-partial-table
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Text t (new-text)]
