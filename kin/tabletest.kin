    (wd-set wd 163 (wf-size) 1000)
    (tt-word wd ln et (text-blob "1,000") 51145 44725 54395 46072 0)
    (wd-set wd 164 (wf-size) 1000)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "the complete synthetic run has one table owner")
    (assert-eq (cells-at tb 8) 3 "the data columns have no empty leading column")
    (set hits 0)
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (set j 0)
          (while (< j (cells-at tc (+ (* c 16) 9)))
            (do (if (== (cells-at tw (+ (cells-at tc (+ (* c 16) 8)) j)) 31)
                  (do (set hits (+ hits 1))
                      (assert-eq (cells-at tc (+ (* c 16) 1)) 1 "value is under its year")
                      (assert-eq (cells-at tc (+ (* c 16) 3)) 1 "numeric cell cannot span columns")
                      (assert-eq (cells-at tc (+ (* c 16) 9)) 1 "value has no label words")))
                (set j (+ j 1))))
          (set c (+ c 1))))
    (assert-eq hits 1 "value has exactly one owner")
    (set hits 0)
    (set c (cells-at tb 9))
    (while (< c (+ (cells-at tb 9) (cells-at tb 10)))
      (do (set j 0)
          (while (< j (cells-at tc (+ (* c 16) 9)))
            (do (if (== (cells-at tw (+ (cells-at tc (+ (* c 16) 8)) j)) 32)
                  (do (set hits (+ hits 1))
                      (assert-eq (cells-at tc (+ (* c 16) 1)) 2 "value is under its year")
                      (assert-eq (cells-at tc (+ (* c 16) 3)) 1 "numeric cell cannot span columns")
                      (assert-eq (cells-at tc (+ (* c 16) 9)) 1 "value has no label words")))
                (set j (+ j 1))))
          (set c (+ c 1))))
    (assert-eq hits 1 "value has exactly one owner")))

