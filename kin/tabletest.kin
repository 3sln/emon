    (tt-at wd ln et (text-blob "817-001") 39500 11200 0 1)
    (tt-header-body wd ln et)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one ledger, with external context")
    (assert-eq (cells-at tb 22) 0 "an account code cannot bind as a short year header")))

(deftest test-a-short-title-is-not-a-column-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
    (tt-at wd ln et (text-blob "Summary of Assets") 7600 11200 0 0)
    (tt-header-body wd ln et)
