(defn ^I32 tt-ruled-build [^Cells wd ^:mut ^Cells ln ^Cells et ^Cells pa ^:mut ^Cells tb ^:mut ^Cells tc ^:mut ^Cells tw]
  (let [^Cells pages (new-cells) ^Cells grl (new-cells) ^Cells gfl (new-cells)]
    (page-new pages 1 61200 79200 0 (pk-vector))
    (gf-doc pa (new-cells) (new-cells) (new-cells) 1 (gfx-mode) grl gfl (new-cells) (new-cells))
    (tb-build wd ln et grl gfl 1 tb tc tw (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells)
                        pages (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                        (new-cells) (new-cells))
    (if (!= (tt-body-audit wd et tb tc tw) 0) (return -7))
    (return (quot (cells-len tb) 32))))

(deftest test-equivalent-full-candidates-do-not-let-the-header-hide-the-body
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0 ^:mut ^I32 x 0 ^:mut ^I32 w 0]
    (tt-rule pa 3592 6625 57473 6685)
    (tt-rule pa 3592 6705 57473 6765)
    (tt-rule pa 21376 7877 57473 7937)
    (tt-rule pa 3592 9848 57473 9908)
    (tt-rule pa 3592 19400 57473 19460)
    (tt-at wd ln et (text-blob "Not adjusted") 22000 6953 1 0)
    (tt-at wd ln et (text-blob "Adjusted") 39000 6953 1 0)
    (tt-at wd ln et (text-blob "Status") 10000 8076 1 0)
    (while (< q 9)
      (do (tt-at wd ln et (text-blob "Aug.") (+ 25119 (* q 4020)) 8076 1 1)
          (tt-at wd ln et (text-blob "2024") (+ 25119 (* q 4020)) 8924 0 1)
          (set q (+ q 1))))
    (tt-at wd ln et (text-blob "Sector") 4490 10190 1 0)
    (while (< r 8)
      (do (set x 4490) (if (== r 0) (set x 3792))
          (tt-at wd ln et (text-blob "Workers..........................") x (+ 11150 (* r 963)) 0 0)
          (set q 0)
          (while (< q 9)
            (do (tt-at wd ln et (text-blob "19,408") (+ 25119 (* q 4020)) (+ 11150 (* r 963)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (while (< w (wd-count wd)) (do (wd-set wd w (wf-size) 699) (set w (+ w 1))))
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "one complete table is selected")
    (assert-that (>= (cells-at tb 7) 11) "the three-row header cannot hide any of the eight numeric rows")))

(deftest test-an-unlabeled-numeric-subtotal-does-not-hide-the-rest-of-a-zebra
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0]
    (tt-fill pa 7200 11600 43500 13200 15000000)
    (tt-fill pa 7200 14800 43500 16400 15000000)
    (tt-fill pa 7200 18000 43500 19600 15000000)
    (tt-fill pa 7200 24400 43500 26000 15000000)
    (tt-fill pa 7200 27600 43500 29200 15000000)
    (tt-fill pa 7200 30800 43500 32400 15000000)
    (tt-at wd ln et (text-blob "Label") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Unit") 20000 10000 1 0)
    (tt-at wd ln et (text-blob "2023") 32000 10000 1 1)
    (tt-at wd ln et (text-blob "2024") 43000 10000 1 1)
    (while (< r 14)
      (do (if (!= r 6) (tt-at wd ln et (text-blob "Liability") 7600 (+ 12000 (* r 1600)) 0 0))
          (tt-at wd ln et (text-blob "12.5") 32000 (+ 12000 (* r 1600)) 0 1)
          (tt-at wd ln et (text-blob "9.25") 43000 (+ 12000 (* r 1600)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "a numeric-only subtotal is no indented invoice summary")
    (assert-eq (cells-at tb 7) 15 "both shaded stacks and all intervening rows survive")))

(defn ^I32 tt-short-gutter-invoice [^TestT emon-t ^I32 rows]
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0]
    (tt-rule pa 7200 9500 37800 9560)
    (tt-rule pa 7200 (+ 14000 (* (- rows 1) 1600)) 37800 (+ 14060 (* (- rows 1) 1600)))
    (tt-at wd ln et (text-blob "Item") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Price") 32000 10000 1 1)
    (tt-at wd ln et (text-blob "Worth") 35400 10000 1 1)
    (tt-at wd ln et (text-blob "VAT") 37300 10000 1 1)
    (tt-at wd ln et (text-blob "Unit") 32000 11000 1 1)
    (tt-at wd ln et (text-blob "Sum") 35400 11000 1 1)
    (tt-at wd ln et (text-blob "Tax") 37300 11000 1 1)
    (while (< r rows)
      (do (tt-at wd ln et (text-blob "Product") 7600 (+ 13000 (* r 1600)) 0 0)
          (tt-at wd ln et (text-blob "23,99") 32000 (+ 13000 (* r 1600)) 0 1)
          (tt-at wd ln et (text-blob "119,95") 35400 (+ 13000 (* r 1600)) 0 1)
          (tt-at wd ln et (text-blob "10%") 37300 (+ 13000 (* r 1600)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "one invoice table")
    (if (== (cells-len tb) 0) (return 1))
    (assert-eq (cells-at tb 8) 4 "price, worth and VAT keep separate data and header columns")
    (return 0)))

(deftest test-a-one-item-invoice-keeps-short-numeric-gutters
  (tt-short-gutter-invoice (test-t) 1))

(deftest test-a-five-item-invoice-keeps-the-same-short-numeric-gutters
  (tt-short-gutter-invoice (test-t) 5))

(deftest test-numeric-data-cuts-preserve-a-genuine-three-column-spanner
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells)
        ^:mut ^I32 r 0 ^:mut ^I32 q 0]
    (tt-rule pa 7200 9500 44800 9560)
    (tt-rule pa 7200 32000 44800 32060)
    (tt-at wd ln et (text-blob "Name") 7600 10000 1 0)
    (tt-line3 wd ln et (text-blob "Not") (text-blob "fully") (text-blob "adjusted") 23000 10000)
    (tt-line3 wd ln et (text-blob "Not") (text-blob "fully") (text-blob "adjusted") 35000 10000)
    (while (< q 6)
      (do (tt-at wd ln et (text-blob "2024") (+ 24000 (* q 4000)) 11000 1 1)
          (set q (+ q 1))))
    (while (< r 12)
      (do (tt-at wd ln et (text-blob "Workers") 7600 (+ 13000 (* r 1500)) 0 0)
          (set q 0)
          (while (< q 6)
            (do (tt-at wd ln et (text-blob "1.00") (+ 24000 (* q 4000)) (+ 13000 (* r 1500)) 0 1)
                (set q (+ q 1))))
          (set r (+ r 1))))
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 1 "one grouped table")
    (if (> (cells-len tb) 0)
      (do (assert-eq (cells-at tb 8) 7 "the six numeric columns keep their identities")
    (assert-eq (cells-at tc (+ (* (+ (cells-at tb 9) 1) 16) 3)) 3 "the first group remains one three-column header")))))

(deftest test-narrow-numeric-grids-do-not-take-words-from-crossing-prose
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells pa (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^:mut ^I32 r 0]
    (tt-rule pa 30000 9500 43500 9560)
    (tt-rule pa 30000 15800 43500 15860)
    (tt-rule pa 30000 20500 43500 20560)
    (tt-rule pa 30000 29000 43500 29060)
    (while (< r 4)
      (do (tt-at wd ln et (text-blob "10.0") 33000 (+ 10000 (* r 1600)) 0 1)
          (tt-at wd ln et (text-blob "20.0") 43000 (+ 10000 (* r 1600)) 0 1)
          (set r (+ r 1))))
    (tt-line3 wd ln et (text-blob "Pensionplanstatement") (text-blob "continuesintheprose") (text-blob "OutsideTableContent") 7600 17500)
    (set r 0)
    (while (< r 5)
      (do (if (!= r 1) (tt-at wd ln et (text-blob "30.0") 33000 (+ 21200 (* r 1600)) 0 1))
          (tt-at wd ln et (text-blob "40.0") 43000 (+ 21200 (* r 1600)) 0 1)
          (set r (+ r 1))))
    (assert-eq (tt-ruled-build wd ln et pa tb tc tw) 2 "prose across two narrow numeric grids is not their shared table body")))

(defn ^I32 tt-header-body [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et]
  (let [^:mut ^I32 r 0]
    (while (< r 4)
      (do (tt-at wd ln et (text-blob "Assets") 7600 (+ 14500 (* r 2200)) 0 0)
          (tt-at wd ln et (text-blob "100.00") 32000 (+ 14500 (* r 2200)) 0 1)
          (tt-at wd ln et (text-blob "200.00") 43000 (+ 14500 (* r 2200)) 0 1)
          (set r (+ r 1))))
    (return 0)))

(deftest test-two-short-header-rows-inside-model-bands-are-in-thead
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
    (tt-at wd ln et (text-blob "2023") 28500 10000 0 1)
    (tt-at wd ln et (text-blob "2024") 39500 10000 0 1)
    (tt-at wd ln et (text-blob "Period") 28500 11200 0 1)
    (tt-at wd ln et (text-blob "Period") 39500 11200 0 1)
    (tt-header-body wd ln et)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one numeric table")
    (assert-eq (cells-at tb 22) 2 "both short aligned header rows bind")
    (assert-eq (cells-at tb 11) 2 "both bound rows are thead")))

(deftest test-an-account-code-is-not-a-column-header
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
