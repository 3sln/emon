    (wd-set wd 298 (wf-size) 1000)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "the complete synthetic run has one table owner")
    (assert-eq (cells-at tb 8) 4 "the data columns have no empty leading column")
    (set hits 0)
