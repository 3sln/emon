    (tt-at wd ln et (text-blob "Item") 7600 10000 1 0)
    (tt-at wd ln et (text-blob "Amount") 43000 10000 1 1)
    (tt-at wd ln et (text-blob "Goods") 7600 11600 0 0)
    (tt-at wd ln et (text-blob "10.00") 43000 11600 0 1)
    (tt-at wd ln et (text-blob "Goods") 7600 13200 0 0)
    (tt-at wd ln et (text-blob "10.00") 43000 13200 0 1)
    (tt-at wd ln et (text-blob "Goods") 7600 14800 0 0)
    (tt-at wd ln et (text-blob "10.00") 43000 14800 0 1)
    (tt-at wd ln et (text-blob "Goods") 7600 16400 0 0)
    (tt-at wd ln et (text-blob "10.00") 43000 16400 0 1)
    (tt-at wd ln et (text-blob "Total") 7600 19600 0 0)
    (tt-at wd ln et (text-blob "40.00") 43000 19600 0 1)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one ledger with a separated total")
    (assert-eq (cells-at tb 7) 6 "the separated total is attached")
    (assert-eq (cells-at tb 12) 1 "an aligned total after a blank pitch is a foot")))

(deftest test-an-empty-word-inside-the-body-is-explicitly-dropped
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
    (tt-part-ledger wd ln et 10000)
    (tt-at wd ln et (text-blob "") 15000 13000 0 0)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "the empty token does not change the ledger")
    (assert-eq (cells-at tbo 12) -1 "row-builder-excluded empty evidence is explicitly dropped")))

(deftest test-a-partially-owned-body-line-keeps-its-box-claim
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
    (tt-part-ledger wd ln et 10000)
    (tt-at wd ln et (text-blob "Outside") 50000 5000 0 0)
    (tt-at wd ln et (text-blob "Outside") 50000 6500 0 0)
    (tt-at wd ln et (text-blob "Outside") 50000 8000 0 0)
    (ln-set ln 11 12 4)
    (assert-eq (tt-own-build wd ln et tb tc tw tbo) 1 "one retained table")
    (assert-eq (ln-get ln 11 15) 1073741824 "one owned word of four still keeps the original body box claim")
    (assert-eq (cells-at tbo 12) 0 "outside-body evidence stays unowned")))
(deftest test-an-attached-tail-with-an-imprecise-line-box-is-claimed
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tbo (new-cells)]
