;; Engine roles and OIL requested configurations (D883).
(ns emon.ocrengine
  (:require [emon.lang :refer [I32 I64 Cells Text emit-ascii i32 shr64]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop text-cp text-i32]]
            [emon.oil :refer [oil-obs-hash oen-emit-name]]
            [emon.evidence :refer [or-count or-get or-set orf-engine orf-eix orf-observed-hi orf-observed-lo ow-count ow-get ow-set owf-run owf-prov ol-count ol-get ol-set olf-run olf-prov]]
            [emon.plan :refer [pk-ocr]]
            [emon.ocridentity :refer [oi-default oi-tess-count oi-tess-at]]
            [kin.lang :refer [defn defdata return let set while if do comment + - * < > <= >= == != and or rem quot]]))

;; The version covers graph hashes, dictionary, ORT CPU settings, image and CTC
;; policy and the frozen calibration. Update on any observable adapter change.
(defdata ^:pub oe-identity
  :emitter kin.lang/flat-array
  :data [112 112 111 99 114 53 45 101 110 45 99 97 52 53 50 51 52 97 54 100 54 100 102 100 54 98 56 53 48 53 51 57 99 102 57 57 100 48 100 57 55 52 57 53 98 54 98 100 101 51 53 57 57 50 98 48 52 48 52 54 52 56 49 57 48 98 48 98 52 54 52 49 48 102]
  :accessors {^I32 oe-id-count [^I32 ignored]
              ^I32 oe-id-at [^I32 ignored ^I32 i]})

;; The requested configuration of the platform engines (K8, D901; D883 2.3): what makes two runs the same reading, as the transcript key holds it. Apple Vision: the
;; text recogniser at the accurate level with language correction, whatever revision the OS has (the revision it ran is the observed identity), reading with the request's languages
;; or, when the request names none, with Vision's own detection of the page's language and, when that reading is Latin, again with every language the OS supports (no language is assumed, D038; the Latin-only set of K8 misread CJK pages, P13.21b; detection alone read receipts worse, every language alone read CJK pages not at all). The observed identity's `locales=` says which strategy the OS allowed. Windows.Media.Ocr: the
;; engine of the installed language pack. Nothing the app can vary is left out, and nothing the OS decides is put in.
;;   apple-vision;VNRecognizeTextRequest;rev=latest;level=accurate;lc=1;lang=request-else-detect
;;   windows-media-ocr;Windows.Media.Ocr.OcrEngine;lang=installed
(defdata ^:pub oe-vision-config
  :emitter kin.lang/flat-array
  :data [97 112 112 108 101 45 118 105 115 105 111 110 59 86 78 82 101 99 111 103 110 105 122 101 84 101 120 116 82 101 113 117 101 115 116 59 114 101 118 61 108 97 116 101 115 116 59 108 101 118 101 108 61 97 99 99 117 114 97 116 101 59 108 99 61 49 59 108 97 110 103 61 114 101 113 117 101 115 116 45 101 108 115 101 45 100 101 116 101 99 116]
  :accessors {^I32 oe-vision-count [^I32 ignored]
              ^I32 oe-vision-at [^I32 ignored ^I32 i]})

(defdata ^:pub oe-winocr-config
  :emitter kin.lang/flat-array
  :data [119 105 110 100 111 119 115 45 109 101 100 105 97 45 111 99 114 59 87 105 110 100 111 119 115 46 77 101 100 105 97 46 79 99 114 46 79 99 114 69 110 103 105 110 101 59 108 97 110 103 61 105 110 115 116 97 108 108 101 100]
  :accessors {^I32 oe-winocr-count [^I32 ignored]
              ^I32 oe-winocr-at [^I32 ignored ^I32 i]})

;; ML Kit text recognition (K7): the Android plugin's engine, answered by the caller (the Dart plugin). Its recogniser is one for each script (Latin, Chinese, Japanese, Korean,
;; Devanagari: the ones the app included), chosen from the request's languages; a request that names none is read with the Latin one (no language is assumed, D038). Whether the model is
;; bundled or comes with Play services is the observed identity, not the configuration: nothing the app decides at build time is put in.
;;   mlkit-text;TextRecognition;recognizer=by-script;lang=request-else-latin
(defdata ^:pub oe-mlkit-config
  :emitter kin.lang/flat-array
  :data [109 108 107 105 116 45 116 101 120 116 59 84 101 120 116 82 101 99 111 103 110 105 116 105 111 110 59 114 101 99 111 103 110 105 122 101 114 61 98 121 45 115 99 114 105 112 116 59 108 97 110 103 61 114 101 113 117 101 115 116 45 101 108 115 101 45 108 97 116 105 110]
  :accessors {^I32 oe-mlkit-count [^I32 ignored]
              ^I32 oe-mlkit-at [^I32 ignored ^I32 i]})

;; The configuration text of an engine, as code points: PP's frozen policy hash, a platform engine's configuration. Tesseract's is `emon.ocridentity`'s (its policy hash
;; changes with the Tesseract inputs); 0 cells for an engine this does not configure.
(defn ^I32 oe-cfg-count [^I32 engine]
  (if (== engine 2) (return (oe-id-count 0)))
  (if (== engine 3) (return (oe-vision-count 0)))
  (if (== engine 4) (return (oe-mlkit-count 0)))
  (if (== engine 5) (return (oe-winocr-count 0)))
  (return 0))

(defn ^I32 oe-cfg-at [^I32 engine ^I32 i]
  (if (== engine 2) (return (oe-id-at 0 i)))
  (if (== engine 3) (return (oe-vision-at 0 i)))
  (if (== engine 4) (return (oe-mlkit-at 0 i)))
  (return (oe-winocr-at 0 i)))

;; For the adapters: what the request must say (flat-array accessors are not for hosts to call: kin may inline them).
(defn ^:pub ^I32 oe-config-len [^I32 engine] (return (oe-cfg-count engine)))
(defn ^:pub ^I32 oe-config-value [^I32 engine ^I32 i] (return (oe-cfg-at engine i)))

;; Host adapters cannot call flat-array accessors directly: kin may inline them.
(defn ^:pub ^I32 oe-id-len []
  (return (oe-id-count 0)))

(defn ^:pub ^I32 oe-id-value [^I32 i]
  (return (oe-id-at 0 i)))

;; Phase 1's hybrid role table. Request slots allocate work; the observed OIL
;; engine selects a reading's role. Unregistered engines have no insertion role.
(defdata ^:pub oe-roles
  :emitter kin.lang/flat-array
  :stride 2
  :data [1 1 2 2]
  :accessors {^I32 oe-role-count [^I32 ignored]
              ^I32 oe-role-at [^I32 ignored ^I32 row ^I32 col]})

(defn ^:pub ^I32 oe-role [^I32 engine]
  (let [^:mut ^I32 i 0]
    (while (< i (oe-role-count 0))
      (do (if (== (oe-role-at 0 i 0) engine) (return (oe-role-at 0 i 1)))
          (set i (+ i 1)))))
  (return 0))

(defn ^:pub ^I32 oe-request-slot [^I32 engine]
  (comment "Page-local slots 23..26 are reserved for at most four extra engines, outside the line/cell/witness ranges. The role table assigns their indices.")
  (let [^:mut ^I32 i 0 ^:mut ^I32 extra 0]
    (while (< i (oe-role-count 0))
      (do (if (== (oe-role-at 0 i 1) 2)
            (do (if (and (== (oe-role-at 0 i 0) engine) (< extra 4)) (return (+ 23 extra)))
                (set extra (+ extra 1))))
          (set i (+ i 1)))))
  (return -1))

(defn ^:pub ^I32 oe-select [^:mut ^Cells requests ^I32 at ^I32 engine]
  (comment "Select an engine immediately after closing the last request. Allocation slots never select engines.")
  (if (== (oe-cfg-count engine) 0) (return 0))
  (let [^I32 end (cells-len requests)
        ^:mut ^I32 k 10 ^:mut ^I32 first -1]
    (while (< (+ (+ at k) 3) end)
      (do (if (and (== (cells-at requests (+ at k)) -3100)
                   (== (cells-at requests (+ (+ at k) 1)) 2)
                   (== (cells-at requests (+ (+ at k) 3)) (- (- end (+ at k)) 4)))
            (set first (+ at k)))
          (set k (+ k 1))))
    (if (< first 0) (return -1))
    (cells-drop requests first)
    (cells-push requests -3100) (cells-push requests 2) (cells-push requests engine)
    (cells-push requests (oe-cfg-count engine))
    (set k 0)
    (while (< k (oe-cfg-count engine))
      (do (cells-push requests (oe-cfg-at engine k)) (set k (+ k 1))))
    (cells-set requests at (- (cells-len requests) at)))
  (return 0))

(defn ^I32 oe-context [^:mut ^Cells requests ^I32 at]
  (let [^I32 end (cells-len requests) ^:mut ^I32 k (+ at 10)]
    (while (< (+ k 3) end)
      (do (if (and (== (cells-at requests k) -3100) (== (cells-at requests (+ k 1)) 2)
                   (== (cells-at requests (+ k 2)) 1)
                   (== (cells-at requests (+ k 3)) (- (- end k) 4)))
            (do (cells-drop requests k)
                (oi-default requests)
                (cells-set requests (+ k 3) (+ (+ (oi-tess-count 0) 1) (oe-id-count 0)))
                (cells-push requests 59)
                (let [^:mut ^I32 i 0]
                  (while (< i (oe-id-count 0))
                    (do (cells-push requests (oe-id-at 0 i)) (set i (+ i 1)))))
                (cells-set requests at (- (cells-len requests) at))
                (return 0)))
          (set k (+ k 1)))))
  (return 0))

(defn ^:pub ^I32 oe-tag [^:mut ^Cells requests ^:mut ^Cells scratch ^I32 mode]
  (comment "Configuration context is part of every request key. The hybrid primary names its challenger policy, so replaying a hybrid with different options misses an actual request without a classifier.")
  (if (== mode 0) (return 0))
  (cells-drop scratch 0)
  (let [^:mut ^I32 at 0 ^:mut ^I32 i 0]
    (while (< at (cells-len requests))
      (let [^I32 n (cells-at requests at) ^I32 out (cells-len scratch)]
        (set i 0)
        (while (< i n)
          (do (cells-push scratch (cells-at requests (+ at i))) (set i (+ i 1))))
        (if (== (cells-at requests (+ at 1)) (pk-ocr))
          (do (if (== mode 1) (oe-select scratch out 2))
              (if (== mode 2) (oe-context scratch out))
              (if (== mode 4) (oe-select scratch out 3))
              (if (== mode 6) (oe-select scratch out 5))
              (if (== mode 8) (oe-select scratch out 4))))
        (set at (+ at n))))
    (cells-drop requests 0) (set i 0)
    (while (< i (cells-len scratch))
      (do (cells-push requests (cells-at scratch i)) (set i (+ i 1)))))
  (return 0))

(defn ^:pub ^I32 oe-tag-fb [^:mut ^Cells requests ^:mut ^Cells scratch ^I32 routed ^I32 slot-a ^I32 slot-b]
  (comment "`ocr-engine=apple-vision` with its Tesseract fallback (P13.21b, D907; `emon.ofall`): the page's OCR requests are Apple Vision's (engine 3) except the page's own fallback first pass")
  (comment "(page-local ids `slot-a`, `slot-b`: the first pass the rules ask and the one asked beside a doubtful reading), which stay as they were built, Tesseract's, and every request of a page the fallback took (`routed` 1).")
  (cells-drop scratch 0)
  (let [^:mut ^I32 at 0 ^:mut ^I32 i 0 ^:mut ^I32 id 0 ^:mut ^I32 k 0]
    (while (< at (cells-len requests))
      (let [^I32 n (cells-at requests at) ^I32 out (cells-len scratch)]
        (set i 0)
        (while (< i n)
          (do (cells-push scratch (cells-at requests (+ at i))) (set i (+ i 1))))
        (if (== (cells-at requests (+ at 1)) (pk-ocr))
          (do (set id (cells-at requests (+ at 2)))
              (set k (- id (* (quot id 256) 256)))
              (if (and (== routed 0) (and (!= k slot-a) (!= k slot-b)))
                (oe-select scratch out 3))))
        (set at (+ at n))))
    (cells-drop requests 0) (set i 0)
    (while (< i (cells-len scratch))
      (do (cells-push requests (cells-at scratch i)) (set i (+ i 1)))))
  (return 0))

;; Engine table: [engine requested-hi requested-lo observed-hi observed-lo class context].
(defn ^I32 oe-config [^:mut ^Cells out ^I32 engine ^I32 context]
  (cells-drop out 0)
  (let [^:mut ^I32 i 0]
    (if (== engine 1)
      (do (while (< i (oi-tess-count 0))
            (do (cells-push out (oi-tess-at 0 i)) (set i (+ i 1))))
          (if (== context 2) (cells-push out 59))))
    (if (or (== engine 2) (and (== engine 1) (== context 2)))
      (do (set i 0)
          (while (< i (oe-id-count 0))
            (do (cells-push out (oe-id-at 0 i)) (set i (+ i 1))))))
    (if (or (== engine 3) (or (== engine 4) (== engine 5)))
      (do (set i 0)
          (while (< i (oe-cfg-count engine))
            (do (cells-push out (oe-cfg-at engine i)) (set i (+ i 1)))))))
  (return 0))

(defn ^:pub ^I32 oe-register [^:mut ^Cells table ^:mut ^Cells runs ^:mut ^Cells lines ^:mut ^Cells words ^I32 context ^:mut ^Cells scratch]
  (cells-drop table 0)
  (let [^:mut ^I32 r 0 ^:mut ^I32 i 0 ^:mut ^I32 hit -1 ^:mut ^I32 engine 0
        ^:mut ^I32 hi 0 ^:mut ^I32 lo 0 ^:mut ^I32 bit 1 ^:mut ^I32 j 0]
    (while (< r (or-count runs))
      (do (set engine (or-get runs r (orf-engine)))
          (oe-config scratch engine context)
          (let [^I64 hash (oil-obs-hash scratch 0 (cells-len scratch))]
            (set hi (i32 (shr64 hash 32))) (set lo (i32 hash)))
          (set hit -1) (set i 0)
          (while (< i (quot (cells-len table) 7))
            (do (if (and (== (cells-at table (* i 7)) engine)
                         (== (cells-at table (+ (* i 7) 1)) hi) (== (cells-at table (+ (* i 7) 2)) lo)
                         (== (cells-at table (+ (* i 7) 3)) (or-get runs r (orf-observed-hi)))
                         (== (cells-at table (+ (* i 7) 4)) (or-get runs r (orf-observed-lo)))) (set hit i))
                (set i (+ i 1))))
          (if (< hit 0)
            (do (set hit (quot (cells-len table) 7))
                (if (>= hit 16) (return -1))
                (cells-push table engine) (cells-push table hi) (cells-push table lo)
                (cells-push table (or-get runs r (orf-observed-hi))) (cells-push table (or-get runs r (orf-observed-lo)))
                (cells-push table 0) (cells-push table context)))
          (or-set runs r (orf-eix) hit)
          (set bit 1) (set j 0)
          (while (< j hit) (do (set bit (* bit 2)) (set j (+ j 1))))
          (set i 0)
          (while (< i (ow-count words))
            (do (if (== (ow-get words i (owf-run)) r) (ow-set words i (owf-prov) bit)) (set i (+ i 1))))
          (set i 0)
          (while (< i (ol-count lines))
            (do (if (== (ol-get lines i (olf-run)) r) (ol-set lines i (olf-prov) bit)) (set i (+ i 1))))
          (set r (+ r 1)))))
  (return 0))

(defn ^:pub ^I32 oe-evidence [^Text out ^Cells table ^:mut ^Cells scratch]
  (emit-ascii out ",\"ocr-engines\":[")
  (let [^:mut ^I32 i 0 ^:mut ^I32 j 0]
    (while (< i (quot (cells-len table) 7))
      (do (if (> i 0) (emit-ascii out ","))
          (emit-ascii out "{\"engine\":\"")
          (oen-emit-name out (cells-at table (* i 7)))
          (emit-ascii out "\",\"config\":\"")
          (oe-config scratch (cells-at table (* i 7)) (cells-at table (+ (* i 7) 6)))
          (set j 0)
          (while (< j (cells-len scratch)) (do (text-cp out (cells-at scratch j)) (set j (+ j 1))))
          (emit-ascii out "\",\"observed\":[")
          (text-i32 out (cells-at table (+ (* i 7) 3))) (emit-ascii out ",")
          (text-i32 out (cells-at table (+ (* i 7) 4))) (emit-ascii out "]}")
          (set i (+ i 1)))))
  (emit-ascii out "]")
  (return 0))
