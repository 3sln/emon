      (do (let [^I32 end (oil-flat-word-end v p caps)]
            (if (< end 0) (return -1))
            (if (== (oil-flat-box-valid v p) 0) (return -1))
            (if (or (< (cells-at v (+ p 5)) -1) (> (cells-at v (+ p 5)) 1000)) (return -1))
            (if (or (< (cells-at v (+ p 4)) -1) (>= (cells-at v (+ p 4)) nl)) (return -1))
