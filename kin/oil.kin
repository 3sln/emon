;; OIL v1 (D883): emon's OCR interchange. Coordinates are request pixels;
;; confidence is raw per mille. The record envelope is [len 3 id status],
;; followed by the 24-cell header, blocks, lines, variable words and sidecars.
;; Optional groups occupy no cells when their capability is clear.
(ns emon.oil
  (:require [emon.ocrport :refer [op-names-count op-names-at]] [emon.oilregistry :refer [oil-key-find oil-key-field]] [emon.ocalib :refer [ocal-word]]
            [emon.lang :refer [I32 I64 Cells defenum i64 i32 mul64 shr64]]
            [emon.port :refer [cells-at cells-len cells-push cells-set cells-drop]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * quot rem < > <= >= == != and or bit-and bit-xor]]))

(defenum ^:pub oen
  [[oen-tesseract 1 "tesseract"] [oen-ppocr 2 "ppocr"]
   [oen-apple-vision 3 "apple-vision"] [oen-mlkit-text 4 "mlkit-text"]
   [oen-windows-media-ocr 5 "windows-media-ocr"]])
(defenum ^:pub sg
  [[sg-page-auto 1 "page-auto"] [sg-block 2 "block"]
   [sg-single-line 3 "single-line"] [sg-sparse 4 "sparse"]
   [sg-single-word 5 "single-word"]])
(defenum ^:pub po
  [[po-up 0 "up"] [po-right 1 "right"] [po-down 2 "down"] [po-left 3 "left"]])
(defenum ^:pub oil-ld
  [[oil-ld-ltr 0 "ltr"] [oil-ld-rtl 1 "rtl"] [oil-ld-ttb 2 "ttb"] [oil-ld-btt 3 "btt"]])
(defenum ^:pub lo
  [[lo-ttb 0 "ttb"] [lo-rtl 1 "rtl"] [lo-ltr 2 "ltr"]])
(defenum ^:pub bk
  [[bk-text 0 "text"] [bk-table 1 "table"] [bk-image 2 "image"]
   [bk-rule 3 "rule"] [bk-other 4 "other"]])
(defenum ^:pub lg
  [[lg-layout 0 "layout"] [lg-segment 1 "segment"] [lg-recognizer 2 "recognizer"]])
(defenum ^:pub oil-ck
  [[oil-ck-none 0 "none"] [oil-ck-word 1 "word"]
   [oil-ck-line 2 "line"] [oil-ck-quantized 3 "quantized"]])
(defenum ^:pub ag
  [[ag-solo 0 "solo"] [ag-agree 1 "agree"] [ag-box 2 "box"]
   [ag-confidence 3 "confidence"] [ag-text 4 "text"]
   [ag-segmentation 5 "segmentation"] [ag-absent 6 "contested-absent"]])

(defenum ^:pub oc
  [[oc-blocks 1 "blocks"] [oc-paras 2 "paras"] [oc-btype 4 "btype"]
   [oc-baseline 8 "baseline"] [oc-rowmetrics 16 "rowmetrics"]
   [oc-quad 32 "quad"] [oc-angle 64 "angle"] [oc-lconf 128 "lconf"]
   [oc-wconf 256 "wconf"] [oc-orient 512 "orient"] [oc-deskew 1024 "deskew"]
   [oc-script 2048 "script"] [oc-wdir 4096 "wdir"] [oc-wlang 8192 "wlang"]
   [oc-lexicon 16384 "lexicon"] [oc-style 32768 "style"] [oc-psize 65536 "psize"]
   [oc-symbols 131072 "symbols"] [oc-symconf 262144 "symconf"]
   [oc-alts 524288 "alts"] [oc-walts 1048576 "walts"]
   [oc-order 2097152 "order"] [oc-binary 4194304 "binary"]])

(defn ^:pub ^I32 oil-version [] (return 1))
(defn ^:pub ^I32 oil-header [] (return 24))
(defn ^:pub ^I32 oil-has [^I32 caps ^I32 bit]
  (if (!= (bit-and caps bit) 0) (return 1))
  (return 0))
(defn ^:pub ^I32 oil-native-check [^I32 caps ^I32 measured]
  (if (== (bit-and caps measured) measured) (return 1))
  (return 0))

(defn ^:pub ^I32 oil-pm [^I32 numerator ^I32 denominator]
  (comment "Round a rational raw per-mille value half away from zero. A positive denominator is required.")
  (if (<= denominator 0) (return 0))
  (let [^I64 n (i64 numerator) ^I64 d (i64 denominator)]
    (if (< n 0) (return (i32 (- 0 (quot (+ (- 0 n) (quot d 2)) d)))))
    (return (i32 (quot (+ n (quot d 2)) d)))))

(defn ^:pub ^I32 oil-order-dir [^I32 order]
  (comment "Wire lo is ttb=0 rtl=1 ltr=2; the evidence direction enum is ltr=0 rtl=1 ttb=2.")
  (if (== order 0) (return 2))
  (if (== order 2) (return 0))
  (return order))

(defn ^:pub ^I32 oil-order-from-tess [^I32 order]
  (comment "Tesseract TextlineOrder uses the direction enum's codes; swapping the endpoints is its inverse too.")
  (return (oil-order-dir order)))

(defn ^:pub ^I32 oil-block-stride [^I32 caps]
  (return (+ (+ 5 (* 3 (oil-has caps (oc-wdir)))) (oil-has caps (oc-btype)))))
(defn ^:pub ^I32 oil-line-stride [^I32 caps]
  (return (+ (+ (+ (+ (+ (+ 6 (oil-has caps (oc-lconf))) (oil-has caps (oc-paras)))
                       (* 4 (oil-has caps (oc-baseline)))) (* 3 (oil-has caps (oc-rowmetrics))))
                 (* 8 (oil-has caps (oc-quad)))) (oil-has caps (oc-angle)))))
(defn ^:pub ^I32 oil-word-base [^I32 caps]
  (return (+ (+ (+ (+ (+ 6 (oil-has caps (oc-wlang))) (oil-has caps (oc-style)))
                    (oil-has caps (oc-psize))) (oil-has caps (oc-lexicon))) (oil-has caps (oc-walts)))))

;; Header offsets are public so flat adapters and kin share the same layout.
(defn ^:pub ^I32 oh-engine [] (return 1))
(defn ^:pub ^I32 oh-obs-hi [] (return 2))
(defn ^:pub ^I32 oh-obs-lo [] (return 3))
(defn ^:pub ^I32 oh-caps [] (return 4))
(defn ^:pub ^I32 oh-native [] (return 5))
(defn ^:pub ^I32 oh-seg [] (return 6))
(defn ^:pub ^I32 oh-ck [] (return 7))
(defn ^:pub ^I32 oh-conf-max [] (return 8))
(defn ^:pub ^I32 oh-orient [] (return 9))
(defn ^:pub ^I32 oh-oconf [] (return 10))
(defn ^:pub ^I32 oh-deskew [] (return 11))
(defn ^:pub ^I32 oh-script [] (return 12))
(defn ^:pub ^I32 oh-sconf [] (return 13))
(defn ^:pub ^I32 oh-wdir [] (return 14))
(defn ^:pub ^I32 oh-lorder [] (return 15))
(defn ^:pub ^I32 oh-lang [] (return 16))
(defn ^:pub ^I32 oh-lg [] (return 17))
(defn ^:pub ^I32 oh-nblocks [] (return 18))
(defn ^:pub ^I32 oh-nlines [] (return 19))
(defn ^:pub ^I32 oh-nwords [] (return 20))
(defn ^:pub ^I32 oh-nsc [] (return 21))
(defn ^:pub ^I32 oh-binary [] (return 22))

(defn ^:pub ^I32 oil-begin [^:mut ^Cells c ^I32 id ^I32 engine ^I32 caps ^I32 measured
                            ^I32 seg ^I32 ck ^I32 lang ^I32 granularity]
  (if (== (oil-native-check caps measured) 0) (return -1))
  (let [^I32 at (cells-len c) ^:mut ^I32 k 0]
    (cells-push c 28)
    (cells-push c 3)
    (cells-push c id)
    (cells-push c 0)
    (while (< k 24) (do (cells-push c 0) (set k (+ k 1))))
    (cells-set c (+ at 4) (oil-version))
    (cells-set c (+ at 5) engine)
    (cells-set c (+ at 8) caps)
    (cells-set c (+ at 9) measured)
    (cells-set c (+ at 10) seg)
    (cells-set c (+ at 11) ck)
    (cells-set c (+ at 12) 1000)
    (cells-set c (+ at 20) lang)
    (cells-set c (+ at 21) granularity)
    (return at)))

(defn ^:pub ^I32 oil-get [^Cells c ^I32 at ^I32 k]
  (return (cells-at c (+ (+ at 4) k))))
(defn ^:pub ^I32 oil-set [^:mut ^Cells c ^I32 at ^I32 k ^I32 value]
  (cells-set c (+ (+ at 4) k) value)
  (return 0))
(defn ^:pub ^I32 oil-block-at [^Cells c ^I32 at ^I32 index]
  (return (+ (+ at 28) (* index (oil-block-stride (oil-get c at (oh-caps)))))))
(defn ^:pub ^I32 oil-line-at [^Cells c ^I32 at ^I32 index]
  (let [^I32 n (oil-get c at (oh-nblocks))
        ^I32 caps (oil-get c at (oh-caps))]
    (return (+ (oil-block-at c at n) (* index (oil-line-stride caps))))))
(defn ^:pub ^I32 oil-first-word [^Cells c ^I32 at]
  (let [^I32 n (oil-get c at (oh-nlines))]
    (return (oil-line-at c at n))))

;; Groups are always appended in schema order; these builders omit absent
;; fields. Counts refer to rows, including empty layout lines.
(defn ^:pub ^I32 oil-block [^:mut ^Cells c ^I32 at ^I32 x ^I32 y ^I32 w ^I32 h
                            ^I32 conf ^I32 orient ^I32 wdir ^I32 order ^I32 kind]
  (let [^I32 caps (oil-get c at (oh-caps))]
    (if (== (oil-has caps (oc-blocks)) 0) (return -1))
    (cells-push c x) (cells-push c y) (cells-push c w) (cells-push c h) (cells-push c conf)
    (if (!= (oil-has caps (oc-wdir)) 0)
      (do (cells-push c orient) (cells-push c wdir) (cells-push c order)))
    (if (!= (oil-has caps (oc-btype)) 0) (cells-push c kind))
    (let [^I32 n (oil-get c at (oh-nblocks))] (oil-set c at (oh-nblocks) (+ n 1))))
  (return 0))

(defn ^:pub ^I32 oil-tess-block [^:mut ^Cells c ^I32 at ^I32 x ^I32 y ^I32 w ^I32 h
                                 ^I32 conf ^I32 orient ^I32 wdir ^I32 order ^I32 kind]
  (return (oil-block c at x y w h conf orient wdir (oil-order-from-tess order) kind)))

(defn ^:pub ^I32 oil-line [^:mut ^Cells c ^I32 at ^I32 x ^I32 y ^I32 w ^I32 h
                           ^I32 block ^I32 nwords ^I32 conf ^I32 par
                           ^I32 bx0 ^I32 by0 ^I32 bx1 ^I32 by1
                           ^I32 xh ^I32 asc ^I32 desc
                           ^I32 qx0 ^I32 qy0 ^I32 qx1 ^I32 qy1
                           ^I32 qx2 ^I32 qy2 ^I32 qx3 ^I32 qy3 ^I32 angle]
  (let [^I32 caps (oil-get c at (oh-caps))]
    (cells-push c x) (cells-push c y) (cells-push c w) (cells-push c h)
    (if (== (oil-has caps (oc-blocks)) 0) (cells-push c -1) (cells-push c block))
    (cells-push c nwords)
    (if (!= (oil-has caps (oc-lconf)) 0) (cells-push c conf))
    (if (!= (oil-has caps (oc-paras)) 0) (cells-push c par))
    (if (!= (oil-has caps (oc-baseline)) 0)
      (do (cells-push c bx0) (cells-push c by0) (cells-push c bx1) (cells-push c by1)))
    (if (!= (oil-has caps (oc-rowmetrics)) 0)
      (do (cells-push c xh) (cells-push c asc) (cells-push c desc)))
    (if (!= (oil-has caps (oc-quad)) 0)
      (do (cells-push c qx0) (cells-push c qy0) (cells-push c qx1) (cells-push c qy1)
          (cells-push c qx2) (cells-push c qy2) (cells-push c qx3) (cells-push c qy3)))
    (if (!= (oil-has caps (oc-angle)) 0) (cells-push c angle))
    (let [^I32 n (oil-get c at (oh-nlines))] (oil-set c at (oh-nlines) (+ n 1))))
  (return 0))

(defn ^:pub ^I32 oil-word [^:mut ^Cells c ^I32 at ^I32 x ^I32 y ^I32 w ^I32 h
                           ^I32 line ^I32 conf ^I32 lang ^I32 style ^I32 psize ^I32 lex]
  (let [^I32 start (cells-len c) ^I32 caps (oil-get c at (oh-caps))]
    (cells-push c x) (cells-push c y) (cells-push c w) (cells-push c h)
    (cells-push c line)
    (if (== (oil-get c at (oh-ck)) (oil-ck-none)) (cells-push c -1) (cells-push c conf))
    (if (!= (oil-has caps (oc-wlang)) 0) (cells-push c lang))
    (if (!= (oil-has caps (oc-style)) 0) (cells-push c style))
    (if (!= (oil-has caps (oc-psize)) 0) (cells-push c psize))
    (if (!= (oil-has caps (oc-lexicon)) 0) (cells-push c lex))
    (if (!= (oil-has caps (oc-walts)) 0) (cells-push c 0))
    (cells-push c 0) ;; symbol count
    (cells-push c 0) ;; text length
    (let [^I32 n (oil-get c at (oh-nwords))] (oil-set c at (oh-nwords) (+ n 1)))
    (return start)))

(defn ^:pub ^I32 oil-word-text [^Cells c ^I32 at ^I32 word]
  (comment "Length cell, after optional word alternatives.")
  (let [^I32 caps (oil-get c at (oh-caps))
        ^:mut ^I32 p (+ word (oil-word-base caps))]
    (if (!= (oil-has caps (oc-walts)) 0)
      (let [^I32 count (cells-at c (- p 1)) ^:mut ^I32 i 0]
        (while (< i count)
          (do (set p (+ (+ p 2) (cells-at c (+ p 1)))) (set i (+ i 1))))))
    (return (+ p 1))))

(defn ^:pub ^I32 oil-word-cp [^:mut ^Cells c ^I32 at ^I32 word ^I32 cp]
  (let [^I32 p (oil-word-text c at word)]
    (cells-set c p (+ (cells-at c p) 1))
    (cells-push c cp))
  (return 0))

(defn ^:pub ^I32 oil-sym [^:mut ^Cells c ^I32 at ^I32 word
                          ^I32 x ^I32 y ^I32 w ^I32 h ^I32 conf]
  (if (== (oil-has (oil-get c at (oh-caps)) (oc-symbols)) 0) (return -1))
  (let [^I32 start (cells-len c) ^I32 p (- (oil-word-text c at word) 1)]
    (cells-set c p (+ (cells-at c p) 1))
    (cells-push c x) (cells-push c y) (cells-push c w) (cells-push c h)
    (if (== (oil-has (oil-get c at (oh-caps)) (oc-symconf)) 0)
      (cells-push c -1) (cells-push c conf))
    (cells-push c 0) (cells-push c 0)
    (return start)))

(defn ^:pub ^I32 oil-sym-cp [^:mut ^Cells c ^I32 sym ^I32 cp]
  (cells-set c (+ sym 5) (+ (cells-at c (+ sym 5)) 1))
  (cells-push c cp)
  (return 0))

(defn ^:pub ^I32 oil-alt [^:mut ^Cells c ^I32 at ^I32 sym ^I32 conf]
  (if (== (oil-has (oil-get c at (oh-caps)) (oc-alts)) 0) (return -1))
  (let [^I32 start (cells-len c)]
    (cells-set c (+ sym 6) (+ (cells-at c (+ sym 6)) 1))
    (cells-push c 0) (cells-push c conf)
    (return start)))

(defn ^:pub ^I32 oil-alt-cp [^:mut ^Cells c ^I32 alt ^I32 cp]
  (cells-set c alt (+ (cells-at c alt) 1))
  (cells-push c cp)
  (return 0))

(defn ^:pub ^I32 oil-sym-next [^Cells c ^I32 sym]
  (let [^:mut ^I32 p (+ (+ sym 7) (cells-at c (+ sym 5)))
        ^I32 n (cells-at c (+ sym 6)) ^:mut ^I32 i 0]
    (while (< i n)
      (do (set p (+ (+ p 2) (cells-at c p))) (set i (+ i 1))))
    (return p)))

;; The observed identity hash is FNV-1a-64 over canonical UTF-8 bytes. Encoding
;; code points here keeps non-ASCII model/OS names identical on every host.
(defn ^I64 oil-hash-byte [^I64 hash ^I32 b]
  (return (mul64 (bit-xor hash (i64 b)) 1099511628211)))

(defn ^:pub ^I64 oil-obs-hash [^Cells cps ^I32 start ^I32 count]
  (let [^:mut ^I64 hash -3750763034362895579 ^:mut ^I32 i 0]
    (while (< i count)
      (let [^:mut ^I32 cp (cells-at cps (+ start i))]
        (if (or (< cp 0) (or (> cp 1114111) (and (>= cp 55296) (<= cp 57343))))
          (set cp 65533))
        (if (< cp 128)
          (set hash (oil-hash-byte hash cp))
          (let [^:mut ^I32 divisor 64 ^:mut ^I32 prefix 192]
            (if (>= cp 2048) (do (set divisor 4096) (set prefix 224)))
            (if (>= cp 65536) (do (set divisor 262144) (set prefix 240)))
            (set hash (oil-hash-byte hash (+ prefix (quot cp divisor))))
            (while (> divisor 1)
              (do (set divisor (quot divisor 64))
                  (set hash (oil-hash-byte hash (+ 128 (rem (quot cp divisor) 64))))))))
        (set i (+ i 1))))
    (return hash)))

(defn ^:pub ^I32 oil-observed [^:mut ^Cells c ^I32 at ^Cells cps ^I32 start ^I32 count]
  (let [^I64 hash (oil-obs-hash cps start count)]
    (oil-set c at (oh-obs-hi) (i32 (shr64 hash 32)))
    (oil-set c at (oh-obs-lo) (i32 hash)))
  (return 0))

(defn ^:pub ^I32 oil-word-next [^Cells c ^I32 at ^I32 word]
  (let [^I32 text (oil-word-text c at word)
        ^I32 count (cells-at c (- text 1))
        ^:mut ^I32 p (+ (+ text 1) (cells-at c text)) ^:mut ^I32 i 0]
    (while (< i count) (do (set p (oil-sym-next c p)) (set i (+ i 1))))
    (return p)))

(defn ^I32 oil-insert [^:mut ^Cells c ^I32 p ^I32 value]
  (let [^:mut ^I32 i (cells-len c)]
    (cells-push c 0)
    (while (> i p) (do (cells-set c i (cells-at c (- i 1))) (set i (- i 1))))
    (cells-set c p value))
  (return 0))

(defn ^:pub ^I32 oil-walt [^:mut ^Cells c ^I32 at ^I32 word ^I32 conf]
  (comment "Append alternatives before symbols and before starting the next word; insertion shifts later cells.")
  (let [^I32 caps (oil-get c at (oh-caps))]
    (if (== (oil-has caps (oc-walts)) 0) (return -1))
    (let [^I32 count (+ (+ word (oil-word-base caps)) -1)
          ^I32 p (- (oil-word-text c at word) 1)]
      (oil-insert c p conf)
      (oil-insert c (+ p 1) 0)
      (cells-set c count (+ (cells-at c count) 1))
      (return p))))

(defn ^:pub ^I32 oil-walt-cp [^:mut ^Cells c ^I32 alt ^I32 cp]
  (let [^I32 n (cells-at c (+ alt 1))]
    (oil-insert c (+ (+ alt 2) n) cp)
    (cells-set c (+ alt 1) (+ n 1)))
  (return 0))

;; Guard before computing an optional column's address. Public field readers
;; return the policy fallback without touching storage when a group is absent.
(defn ^:pub ^I32 oil-line-field [^Cells c ^I32 at ^I32 index ^I32 field]
  (let [^I32 caps (oil-get c at (oh-caps))
        ^I32 row (oil-line-at c at index)
        ^:mut ^I32 p (+ row 6)]
    (if (< field 4) (return (cells-at c (+ row field))))
    (if (== field 8)
      (do (if (== (oil-has caps (oc-blocks)) 0) (return index))
          (return (cells-at c (+ row 4)))))
    (if (== field 10)
      (do (if (== (oil-has caps (oc-btype)) 0) (return 0))
          (let [^I32 block (cells-at c (+ row 4))]
            (if (< block 0) (return 0))
            (let [^I32 b (oil-block-at c at block)]
              (return (cells-at c (+ (+ b 5) (* 3 (oil-has caps (oc-wdir))))))))))
    (set p (+ p (oil-has caps (oc-lconf))))
    (if (== field 9)
      (do (if (== (oil-has caps (oc-paras)) 0) (return index))
          (return (cells-at c p))))
    (set p (+ p (oil-has caps (oc-paras))))
    (if (and (>= field 4) (<= field 7))
      (do (if (== (oil-has caps (oc-baseline)) 0) (return -1))
          (return (cells-at c (+ p (- field 4))))))
    (set p (+ p (* 4 (oil-has caps (oc-baseline)))))
    (if (and (>= field 11) (<= field 13))
      (do (if (== (oil-has caps (oc-rowmetrics)) 0) (return -1))
          (return (cells-at c (+ p (- field 11))))))
    (return -1)))

(defn ^:pub ^I32 oil-header-field [^Cells c ^I32 at ^I32 field ^I32 capability ^I32 fallback]
  (if (== (oil-has (oil-get c at (oh-caps)) capability) 0) (return fallback))
  (return (oil-get c at field)))

(defn ^:pub ^I32 oil-word-field [^Cells c ^I32 at ^I32 word ^I32 capability ^I32 fallback]
  (let [^I32 caps (oil-get c at (oh-caps)) ^:mut ^I32 p (+ word 6)]
    (if (== (oil-has caps capability) 0) (return fallback))
    (if (== capability (oc-wlang)) (return (cells-at c p)))
    (set p (+ p (oil-has caps (oc-wlang))))
    (if (== capability (oc-style)) (return (cells-at c p)))
    (set p (+ p (oil-has caps (oc-style))))
    (if (== capability (oc-psize)) (return (cells-at c p)))
    (set p (+ p (oil-has caps (oc-psize))))
    (return (cells-at c p))))

(defn ^:pub ^I32 oil-find [^Cells c ^I32 at]
  (if (< at 0) (return -1))
  (if (< (cells-at c at) 28) (return -1))
  (if (!= (oil-get c at 0) (oil-version)) (return -1))
  (return at))

(defn ^:pub ^I32 oil-orient [^Cells c ^I32 at]
  (return (oil-header-field c at 9 (oc-orient) 0)))

(defn ^:pub ^I32 oil-layout-orient [^Cells c ^I32 at]
  (comment "Layout and OSD are independent Tesseract measurements. Its page layout orientation is the first normalized block's, even when OSD is absent or disagrees.")
  (let [^I32 caps (oil-get c at (oh-caps))]
    (if (and (!= (oil-has caps (oc-blocks)) 0)
             (and (!= (oil-has caps (oc-wdir)) 0) (> (oil-get c at (oh-nblocks)) 0)))
      (let [^I32 block (oil-block-at c at 0)] (return (cells-at c (+ block 5)))))
    (if (== (oil-get c at (oh-engine)) (oen-tesseract)) (return 0))
    (return (oil-orient c at))))

(defn ^:pub ^I32 oil-oconf [^Cells c ^I32 at]
  (return (oil-header-field c at 10 (oc-orient) -1)))

(defn ^:pub ^I32 oil-deskew [^Cells c ^I32 at]
  (return (oil-header-field c at 11 (oc-deskew) 0)))

(defn ^:pub ^I32 oil-script [^Cells c ^I32 at]
  (return (oil-header-field c at 12 (oc-script) 0)))

(defn ^:pub ^I32 oil-sconf [^Cells c ^I32 at]
  (return (oil-header-field c at 13 (oc-script) -1)))

(defn ^:pub ^I32 oil-wdir [^Cells c ^I32 at]
  (return (oil-header-field c at 14 (oc-wdir) 0)))

(defn ^:pub ^I32 oil-tlorder [^Cells c ^I32 at]
  (if (== (oil-has (oil-get c at (oh-caps)) (oc-wdir)) 0) (return 0))
  (let [^I32 order (oil-get c at (oh-lorder))] (return (oil-order-dir order))))

(defn ^:pub ^I32 oil-binary [^Cells c ^I32 at]
  (return (oil-header-field c at 22 (oc-binary) 0)))

(defn ^:pub ^I32 oil-osd [^Cells c ^I32 at]
  (if (== (oil-has (oil-get c at (oh-caps)) (oc-orient)) 0) (return -1))
  (return (* 90 (oil-get c at (oh-orient)))))

(defn ^:pub ^I32 oil-nlines [^Cells c ^I32 at] (return (oil-get c at (oh-nlines))))

(defn ^:pub ^I32 oil-nblocks [^Cells c ^I32 at] (return (oil-get c at (oh-nblocks))))

(defn ^:pub ^I32 oil-nwords [^Cells c ^I32 at] (return (oil-get c at (oh-nwords))))

(defn ^:pub ^I32 oil-wflags [^Cells c ^I32 at ^I32 w] (return (oil-word-field c at w (oc-style) 0)))

(defn ^:pub ^I32 oil-wlang [^Cells c ^I32 at ^I32 w] (return (oil-word-field c at w (oc-wlang) 0)))

(defn ^:pub ^I32 oil-wpsize [^Cells c ^I32 at ^I32 w] (return (oil-word-field c at w (oc-psize) -1)))

(defn ^:pub ^I32 oil-wlex [^Cells c ^I32 at ^I32 w] (return (oil-word-field c at w (oc-lexicon) 0)))

(defn ^:pub ^I32 oil-nsym [^Cells c ^I32 at ^I32 w] (let [^I32 p (oil-word-text c at w)] (return (cells-at c (- p 1)))))
(defn ^:pub ^I32 oil-first-sym [^Cells c ^I32 at ^I32 w]
  (let [^I32 p (oil-word-text c at w)] (return (+ (+ p 1) (cells-at c p)))))
(defn ^:pub ^I32 oil-wlen [^Cells c ^I32 at ^I32 w] (let [^I32 p (oil-word-text c at w)] (return (cells-at c p))))
(defn ^:pub ^I32 oil-wcp [^Cells c ^I32 at ^I32 w ^I32 k] (let [^I32 p (oil-word-text c at w)] (return (cells-at c (+ (+ p 1) k)))))
(defn ^:pub ^I32 oil-sym-alts [^Cells c ^I32 sym] (return (+ (+ sym 7) (cells-at c (+ sym 5)))))
(defn ^:pub ^I32 oil-alt-next [^Cells c ^I32 alt] (return (+ (+ alt 2) (cells-at c alt))))

(defn ^:pub ^I32 oil-block-field [^Cells c ^I32 at ^I32 index ^I32 field]
  (if (== (oil-has (oil-get c at (oh-caps)) (oc-wdir)) 0) (return 0))
  (let [^I32 p (oil-block-at c at index)] (return (cells-at c (+ (+ p 5) field)))))

(defn ^:pub ^I32 oil-word-flags [^Cells c ^I32 at ^I32 word]
  (comment "Evidence dictionary and numeric bits. Numeric is derived from text, not an engine claim.")
  (let [^I32 n (oil-wlen c at word) ^:mut ^I32 i 0 ^:mut ^I32 digits 0 ^:mut ^I32 other 0
        ^:mut ^I32 flags 0]
    (if (!= (bit-and (oil-wlex c at word) 2) 0) (set flags 1))
    (while (< i n)
      (let [^I32 cp (oil-wcp c at word i)]
        (if (and (>= cp 48) (<= cp 57))
          (set digits (+ digits 1))
          (if (and (!= cp 46) (and (!= cp 44) (and (!= cp 45) (!= cp 43)))) (set other 1)))
        (set i (+ i 1))))
    (if (and (> digits 0) (== other 0)) (set flags (+ flags 2)))
    (return flags)))

(defn ^:pub ^I32 oil-seg-from-tess [^I32 psm]
  (if (== psm 6) (return (sg-block)))
  (if (== psm 7) (return (sg-single-line)))
  (if (== psm 11) (return (sg-sparse)))
  (if (== psm 8) (return (sg-single-word)))
  (return (sg-page-auto)))

(defn ^:pub ^I32 oil-tess-begin [^:mut ^Cells c ^I32 id ^I32 psm ^I32 symbols
                                ^I32 orient ^I32 wdir ^I32 order ^I32 deskew
                                ^I32 osd ^I32 script ^I32 sconf ^I32 oconf ^I32 binary]
  (let [^:mut ^I32 caps 2225423 ^:mut ^I32 at 0]
    ;; blocks, paragraphs, kind, baseline, raw word confidence, deskew,
    ;; direction, language, lexicon, style, size and measured reading order.
    (if (!= symbols 0) (set caps (+ caps 917504)))
    (if (>= osd 0) (set caps (+ caps 2560)))
    (if (!= binary 0) (set caps (+ caps (oc-binary))))
    (set at (oil-begin c id (oen-tesseract) caps caps (oil-seg-from-tess psm) (oil-ck-word) 0 (lg-layout)))
    (oil-set c at (oh-orient) (quot osd 90))
    (oil-set c at (oh-oconf) oconf)
    (oil-set c at (oh-deskew) deskew)
    (oil-set c at (oh-script) script)
    (oil-set c at (oh-sconf) sconf)
    (oil-set c at (oh-wdir) wdir)
    (oil-set c at (oh-lorder) (oil-order-from-tess order))
    (oil-set c at (oh-binary) binary)
    (return at)))

(defn ^I32 oil-flat-cps-valid [^Cells v ^I32 p ^I32 count]
  (let [^:mut ^I32 i 0]
    (while (< i count)
      (let [^I32 cp (cells-at v (+ p i))]
        (if (or (< cp 0) (or (> cp 1114111) (and (>= cp 55296) (<= cp 57343)))) (return 0))
        (set i (+ i 1)))))
  (return 1))

(defn ^I32 oil-flat-word-end [^Cells v ^I32 p ^I32 caps]
  (let [^I32 n (cells-len v) ^:mut ^I32 q (+ p 6) ^:mut ^I32 i 0 ^:mut ^I32 j 0
        ^:mut ^I32 count 0 ^:mut ^I32 alts 0]
    (set q (+ (+ (+ (+ q (oil-has caps (oc-wlang))) (oil-has caps (oc-style))) (oil-has caps (oc-psize))) (oil-has caps (oc-lexicon))))
    (if (!= (oil-has caps (oc-walts)) 0)
      (do (if (>= q n) (return -1))
          (set count (cells-at v q)) (set q (+ q 1))
          (if (< count 0) (return -1))
          (while (< i count)
            (do (if (>= (+ q 1) n) (return -1))
                (if (< (cells-at v (+ q 1)) 0) (return -1))
                (if (> (cells-at v (+ q 1)) (- (- n q) 2)) (return -1))
                (if (or (< (cells-at v q) -1) (> (cells-at v q) 1000)) (return -1))
                (if (== (oil-flat-cps-valid v (+ q 2) (cells-at v (+ q 1))) 0) (return -1))
                (set q (+ (+ q 2) (cells-at v (+ q 1))))
                (if (> q n) (return -1))
                (set i (+ i 1))))))
    (if (>= (+ q 1) n) (return -1))
    (set count (cells-at v q))
    (if (< count 0) (return -1))
    (if (and (== (oil-has caps (oc-symbols)) 0) (!= count 0)) (return -1))
    (if (< (cells-at v (+ q 1)) 0) (return -1))
    (if (> (cells-at v (+ q 1)) (- (- n q) 2)) (return -1))
    (if (== (oil-flat-cps-valid v (+ q 2) (cells-at v (+ q 1))) 0) (return -1))
    (set q (+ (+ q 2) (cells-at v (+ q 1))))
    (set i 0)
    (while (< i count)
      (do (if (>= (+ q 6) n) (return -1))
          (if (< (cells-at v (+ q 5)) 0) (return -1))
          (if (> (cells-at v (+ q 5)) (- (- n q) 7)) (return -1))
          (if (or (< (cells-at v (+ q 2)) 0) (< (cells-at v (+ q 3)) 0)) (return -1))
          (if (or (< (cells-at v (+ q 4)) -1) (> (cells-at v (+ q 4)) 1000)) (return -1))
          (if (== (oil-flat-cps-valid v (+ q 7) (cells-at v (+ q 5))) 0) (return -1))
          (set alts (cells-at v (+ q 6)))
          (if (< alts 0) (return -1))
          (if (and (== (oil-has caps (oc-alts)) 0) (!= alts 0)) (return -1))
          (set q (+ (+ q 7) (cells-at v (+ q 5))))
          (set j 0)
          (while (< j alts)
            (do (if (>= (+ q 1) n) (return -1))
                (if (< (cells-at v q) 0) (return -1))
                (if (> (cells-at v q) (- (- n q) 2)) (return -1))
                (if (or (< (cells-at v (+ q 1)) -1) (> (cells-at v (+ q 1)) 1000)) (return -1))
                (if (== (oil-flat-cps-valid v (+ q 2) (cells-at v q)) 0) (return -1))
                (set q (+ (+ q 2) (cells-at v q)))
                (if (> q n) (return -1))
                (set j (+ j 1))))
          (set i (+ i 1))))
    (if (> q n) (return -1))
    (return q)))


(defn ^I32 oil-flat-header-valid [^Cells v]
  (if (or (< (cells-at v 6) 1) (> (cells-at v 6) 5)) (return 0))
  (if (or (< (cells-at v 17) 0) (> (cells-at v 17) 2)) (return 0))
  (if (or (< (cells-at v 8) 0) (> (cells-at v 8) 1000)) (return 0))
  (if (!= (cells-at v 23) 0) (return 0))
  (let [^I32 caps (cells-at v 4)]
    (if (!= (oil-has caps (oc-orient)) 0)
      (if (or (< (cells-at v 9) 0) (> (cells-at v 9) 3)) (return 0)))
    (if (!= (oil-has caps (oc-wdir)) 0)
      (do (if (or (< (cells-at v 14) 0) (> (cells-at v 14) 3)) (return 0))
          (if (or (< (cells-at v 15) 0) (> (cells-at v 15) 2)) (return 0))))
    (if (!= (oil-has caps (oc-binary)) 0)
      (if (or (< (cells-at v 22) 0) (> (cells-at v 22) 1)) (return 0))))
  (return 1))

(defn ^I32 oil-flat-sidecar-end [^Cells v ^I32 p ^I32 ns ^I32 nb ^I32 nl ^I32 nw ^I32 nsym]
  (let [^I32 size (cells-len v) ^:mut ^I32 end 0 ^:mut ^I32 q (+ p 6)
        ^:mut ^I32 count 0 ^:mut ^I32 rows 0 ^:mut ^I32 i 0 ^:mut ^I32 j 0
        ^:mut ^I32 previous -1]
    (if (> p (- size 6)) (return -1))
    (if (< (cells-at v p) 6) (return -1))
    (if (> (cells-at v p) (- size p)) (return -1))
    (set end (+ p (cells-at v p)))
    (if (!= (cells-at v (+ p 1)) ns) (return -1))
    (let [^I32 key (cells-at v (+ p 2)) ^I32 subject (cells-at v (+ p 3))
          ^I32 dense (cells-at v (+ p 4)) ^I32 registry (oil-key-find ns key)]
      (if (< registry 0) (return -1))
      (if (!= subject (oil-key-field registry 4)) (return -1))
      (if (or (< dense 0) (> dense 1)) (return -1))
      (if (== subject 0) (set rows 1))
      (if (== subject 1) (set rows nb))
      (if (== subject 2) (set rows nl))
      (if (== subject 3) (set rows nw))
      (if (== subject 4) (set rows nsym))
      (set count (cells-at v (+ p 5)))
      (if (or (< count 0) (> count rows)) (return -1))
      (if (and (== dense 1) (!= count rows)) (return -1))
      (while (< i count)
        (do (if (== dense 0)
              (do (if (>= q end) (return -1))
                  ;; Canonical sparse entries have strictly increasing rows.
                  (if (or (<= (cells-at v q) previous) (>= (cells-at v q) rows)) (return -1))
                  (set previous (cells-at v q))
                  (set q (+ q 1))))
            (if (== (oil-key-field registry 2) 9)
              (do (if (>= q end) (return -1))
                  (set j (cells-at v q))
                  (set q (+ q 1))
                  (if (or (< j 0) (> j (- end q))) (return -1))
                  (while (> j 0)
                    (let [^I32 cp (cells-at v q)]
                      (if (or (< cp 0) (or (> cp 1114111) (and (>= cp 55296) (<= cp 57343)))) (return -1))
                      (set q (+ q 1)) (set j (- j 1)))))
              (do (set j (oil-key-field registry 3))
                  (if (> j (- end q)) (return -1))
                  (if (== (oil-key-field registry 2) 2)
                    (if (or (< (cells-at v q) -1) (> (cells-at v q) 1000)) (return -1)))
                  (set q (+ q j))))
            (set i (+ i 1)))))
    (if (!= q end) (return -1))
    (return end)))


(defn ^I32 oil-sc-sparse [^:mut ^Cells c ^I32 at]
  (comment "Expand dense rows before compaction. Inserting indices first avoids overwriting an unread payload when most rows survive sealing.")
  (let [^:mut ^I32 p (oil-first-word c at) ^:mut ^I32 i 0]
    (while (< i (oil-nwords c at)) (do (set p (oil-word-next c at p)) (set i (+ i 1))))
    (set i 0)
    (while (< i (oil-get c at (oh-nsc)))
      (let [^I32 length (cells-at c p) ^I32 count (cells-at c (+ p 5))
            ^I32 registry (oil-key-find (cells-at c (+ p 1)) (cells-at c (+ p 2)))
            ^:mut ^I32 q (+ p 6) ^:mut ^I32 k 0 ^:mut ^I32 width 0]
        (if (< registry 0) (return -1))
        (if (== (cells-at c (+ p 4)) 1)
          (do (while (< k count)
                (do (set width (oil-key-field registry 3))
                    (if (== (oil-key-field registry 2) 9) (set width (+ 1 (cells-at c q))))
                    (oil-insert c q k)
                    (set q (+ (+ q 1) width)) (set k (+ k 1))))
              (cells-set c p (+ length count)) (cells-set c (+ p 4) 0)))
        (set p (+ p (cells-at c p))) (set i (+ i 1)))))
  (return 0))

(defn ^I32 oil-sc-cps-equal [^Cells c ^I32 p ^I32 packed ^I32 tablekind]
  (let [^I32 count (cells-at c p) ^:mut ^I32 i 0 ^:mut ^I32 j 0
        ^:mut ^I32 d 16777216 ^:mut ^I32 cp 0 ^:mut ^I32 k 0]
    ;; OSD's canonical engine spelling is the registered name, not ISO 15924.
    ;; Chinese model names are the two request-name exceptions; other model
    ;; variants (eng_best, script models, kur_ara) remain informative.
    (if (or (== tablekind 2) (or (== packed 1667789568) (== packed 1667789824)))
      (while (< i (op-names-count 0))
        (do (set j (+ i 1))
            (while (!= (op-names-at 0 j) 0) (set j (+ j 1)))
            (if (and (== (op-names-at 0 i) tablekind) (== (op-names-at 0 (+ j 1)) packed))
              (do (if (!= count (- (- j i) 1)) (return 0))
                  (set i (+ i 1))
                  (while (< i j)
                    (do (if (!= (cells-at c (+ (+ p 1) k)) (op-names-at 0 i)) (return 0))
                        (set i (+ i 1)) (set k (+ k 1))))
                  (return 1)))
            (set i (+ j 2)))))
    (while (> d 0)
      (do (set cp (rem (quot packed d) 256))
          (if (!= cp 0)
            (do (if (>= k count) (return 0))
                (if (!= (cells-at c (+ (+ p 1) k)) cp) (return 0))
                (set k (+ k 1))))
          (set d (quot d 256))))
    (if (== k count) (return 1))
    (return 0)))

(defn ^I32 oil-sc-keep [^Cells c ^I32 at ^I32 ns ^I32 key ^I32 row ^I32 p ^I32 flags]
  (if (== ns (oen-tesseract))
    (do (if (== key 1)
          (let [^I32 caps (oil-get c at (oh-caps)) ^:mut ^I32 implied 0]
            (if (!= (oil-has caps (oc-btype)) 0)
              (let [^I32 b (oil-block-at c at row)
                    ^I32 kind (cells-at c (+ (+ b 5) (* 3 (oil-has caps (oc-wdir)))))]
                (if (== kind 0) (set implied 1))
                (if (== kind 1) (set implied 6))
                (if (== kind 2) (set implied 9))
                (if (== kind 3)
                  (if (>= (cells-at c (+ b 2)) (cells-at c (+ b 3))) (set implied 12) (set implied 13)))))
            (if (== (cells-at c p) implied) (return 0))))
        (if (== key 2)
          (let [^I32 script (oil-script c at)] (if (== (oil-sc-cps-equal c p script 2) 1) (return 0))))
        (if (== key 3)
          (let [^:mut ^I32 word (oil-first-word c at) ^:mut ^I32 i 0]
            (while (< i row) (do (set word (oil-word-next c at word)) (set i (+ i 1))))
            (let [^I32 language (oil-wlang c at word)] (if (== (oil-sc-cps-equal c p language 3) 1) (return 0)))))))
  (if (== ns (oen-ppocr))
    (do (if (and (== key 1) (== (cells-at c p) -1)) (return 0))
        (if (and (== key 2) (and (== (cells-at c p) 0) (< (cells-at c (+ p 1)) 500))) (return 0))
        (if (and (== key 3) (== (cells-at c p) 0)) (return 0))
        (if (and (== key 4) (== (bit-and flags 8) 0)) (return 0))))
  (return 1))

(defn ^:pub ^I32 oil-seal [^:mut ^Cells c ^I32 at ^I32 flags]
  (comment "Seal the last answer in place. All retained entries are canonical sparse rows; no normalized cell moves.")
  (if (< (oil-sc-sparse c at) 0) (return -1))
  (let [^I32 total (oil-get c at (oh-nsc)) ^:mut ^I32 p (oil-first-word c at)
        ^:mut ^I32 i 0 ^:mut ^I32 write 0 ^:mut ^I32 kept 0]
    (while (< i (oil-nwords c at)) (do (set p (oil-word-next c at p)) (set i (+ i 1))))
    (set write p) (set i 0)
    (while (< i total)
      (let [^I32 end (+ p (cells-at c p)) ^I32 ns (cells-at c (+ p 1))
            ^I32 key (cells-at c (+ p 2)) ^I32 subject (cells-at c (+ p 3))
            ^I32 dense (cells-at c (+ p 4)) ^I32 count (cells-at c (+ p 5))
            ^I32 registry (oil-key-find ns key) ^I32 entry write
            ^:mut ^I32 q (+ p 6) ^:mut ^I32 k 0 ^:mut ^I32 n 0
            ^:mut ^I32 row 0 ^:mut ^I32 width 0 ^:mut ^I32 j 0]
        (if (< registry 0) (return -1))
        ;; Header copying happens after reading it, so overlapping compaction
        ;; cannot overwrite the entry currently being examined.
        (cells-set c (+ entry 1) ns) (cells-set c (+ entry 2) key)
        (cells-set c (+ entry 3) subject) (cells-set c (+ entry 4) 0)
        (set write (+ entry 6))
        (while (< k count)
          (do (set row k)
              (if (== dense 0) (do (set row (cells-at c q)) (set q (+ q 1))))
              (set width (oil-key-field registry 3))
              (if (== (oil-key-field registry 2) 9) (set width (+ 1 (cells-at c q))))
              (if (!= (oil-sc-keep c at ns key row q flags) 0)
                (do (cells-set c write row) (set write (+ write 1))
                    (set j 0)
                    (while (< j width)
                      (do (cells-set c write (cells-at c (+ q j)))
                          (set write (+ write 1)) (set j (+ j 1))))
                    (set n (+ n 1))))
              (set q (+ q width)) (set k (+ k 1))))
        (if (== n 0)
          (set write entry)
          (do (cells-set c entry (- write entry)) (cells-set c (+ entry 5) n) (set kept (+ kept 1))))
        (set p end) (set i (+ i 1))))
    (cells-drop c write)
    (oil-set c at (oh-nsc) kept)
    (cells-set c at (- write at)))
  (return 0))

(defn ^:pub ^I32 oil-sc-put [^:mut ^Cells c ^I32 at ^I32 key ^I32 subject ^I32 row
                             ^Cells value ^I32 first ^I32 count]
  (comment "Append a sparse source value; registration and value framing are checked before incrementing nsc.")
  (let [^I32 start (cells-len c) ^I32 ns (oil-get c at (oh-engine))
        ^I32 registry (oil-key-find ns key) ^:mut ^I32 i 0]
    (if (< registry 0) (return -1))
    (if (!= subject (oil-key-field registry 4)) (return -1))
    (if (or (< first 0) (or (< count 0) (> count (- (cells-len value) first)))) (return -1))
    (if (== (oil-key-field registry 2) 9)
      (do (if (< count 1) (return -1))
          (if (!= (cells-at value first) (- count 1)) (return -1)))
      (if (!= count (oil-key-field registry 3)) (return -1)))
    (if (< row 0) (return -1))
    (if (and (== subject 0) (!= row 0)) (return -1))
    (if (and (== subject 1) (>= row (oil-nblocks c at))) (return -1))
    (if (and (== subject 2) (>= row (oil-nlines c at))) (return -1))
    (if (and (== subject 3) (>= row (oil-nwords c at))) (return -1))
    (cells-push c (+ 7 count)) (cells-push c ns) (cells-push c key)
    (cells-push c subject) (cells-push c 0) (cells-push c 1) (cells-push c row)
    (while (< i count) (do (cells-push c (cells-at value (+ first i))) (set i (+ i 1))))
    (let [^I32 nsc (oil-get c at (oh-nsc))] (oil-set c at (oh-nsc) (+ nsc 1)))
    (cells-set c at (- (cells-len c) at))
    (return start)))

(defn ^:pub ^I32 oil-end-source [^:mut ^Cells c ^I32 at ^I32 flags]
  (return (oil-seal c at flags)))

(defn ^:pub ^I32 oil-end [^:mut ^Cells c ^I32 at]
  (return (oil-end-source c at 0)))


(defn ^I32 oil-flat-box-valid [^Cells v ^I32 p]
  (if (or (< (cells-at v (+ p 2)) 0) (< (cells-at v (+ p 3)) 0)) (return 0))
  (return 1))

(defn ^I32 oil-flat-rows-valid [^Cells v ^I32 caps ^I32 nb ^I32 nl]
  (let [^:mut ^I32 p 24 ^:mut ^I32 i 0 ^:mut ^I32 q 0]
    (while (< i nb)
      (do (if (== (oil-flat-box-valid v p) 0) (return 0))
          (if (or (< (cells-at v (+ p 4)) -1) (> (cells-at v (+ p 4)) 1000)) (return 0))
          (set q (+ p 5))
          (if (!= (oil-has caps (oc-wdir)) 0)
            (do (if (or (< (cells-at v q) 0) (> (cells-at v q) 3)) (return 0))
                (if (or (< (cells-at v (+ q 1)) 0) (> (cells-at v (+ q 1)) 3)) (return 0))
                (if (or (< (cells-at v (+ q 2)) 0) (> (cells-at v (+ q 2)) 2)) (return 0))
                (set q (+ q 3))))
