    (if (or (< nb 0) (or (< nl 0) (< nw 0))) (return -1))
    (if (or (> nb n) (or (> nl n) (> nw n))) (return -1))
    (if (and (== (oil-has caps (oc-blocks)) 0) (!= nb 0)) (return -1))
    (set p (+ (+ p (* nb (oil-block-stride caps))) (* nl (oil-line-stride caps))))
    (if (> p n) (return -1))
    (if (== (oil-flat-rows-valid v caps nb nl) 0) (return -1))
