    (while (< i nl)
      (do (if (== (oil-flat-box-valid v p) 0) (return 0))
          (if (< (cells-at v (+ p 5)) 0) (return 0))
          (if (== (oil-has caps (oc-blocks)) 0)
            (if (!= (cells-at v (+ p 4)) -1) (return 0))
            (if (or (< (cells-at v (+ p 4)) 0) (>= (cells-at v (+ p 4)) nb)) (return 0)))
          (set q (+ p 6))
          (if (!= (oil-has caps (oc-lconf)) 0)
            (do (if (or (< (cells-at v q) -1) (> (cells-at v q) 1000)) (return 0))
                (set q (+ q 1))))
          (if (!= (oil-has caps (oc-paras)) 0)
            (do (if (< (cells-at v q) -1) (return 0)) (set q (+ q 1))))
          (set q (+ q (* 4 (oil-has caps (oc-baseline)))))
          (if (!= (oil-has caps (oc-rowmetrics)) 0)
            (if (or (< (cells-at v q) 0) (or (< (cells-at v (+ q 1)) 0) (< (cells-at v (+ q 2)) 0))) (return 0)))
          (set p (+ p (oil-line-stride caps))) (set i (+ i 1)))))
