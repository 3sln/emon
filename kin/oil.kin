(defn ^:pub ^I32 oil-flat-check [^Cells v]
  (comment "Validate the complete flat form without mutating any answer arena.")
  (let [^I32 n (cells-len v) ^:mut ^I32 p 24 ^:mut ^I32 i 0 ^:mut ^I32 caps 0
        ^:mut ^I32 nb 0 ^:mut ^I32 nl 0 ^:mut ^I32 nw 0 ^:mut ^I32 nsym 0]
    (if (< n 24) (return -1))
    (if (!= (cells-at v 0) (oil-version)) (return -1))
    (if (or (< (cells-at v 1) 1) (> (cells-at v 1) 5)) (return -1))
    (if (or (< (cells-at v 7) 0) (> (cells-at v 7) 3)) (return -1))
    (if (< (cells-at v 21) 0) (return -1))
    (set caps (cells-at v 4))
    (if (or (< caps 0) (> caps 8388607)) (return -1))
    (if (== (oil-native-check caps (cells-at v 5)) 0) (return -1))
    (if (== (oil-flat-header-valid v) 0) (return -1))
