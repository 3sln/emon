                  (while (< a count)
                    (do (set q (+ (+ q 2) (cells-at v (+ q 1)))) (set a (+ a 1))))))
              (set nsym (+ nsym (cells-at v q))))
            (set p end))
          (if (< p 0) (return -1))
          (set i (+ i 1))))
    ;; Sidecar rows are length framed; registration and sealing follow below.
    (set i 0)
    (while (< i (cells-at v 21))
      (do (set p (oil-flat-sidecar-end v p (cells-at v 1) nb nl nw nsym))
          (if (< p 0) (return -1))
          (set i (+ i 1))))
    (if (!= p n) (return -1))
    (return 0)))

(defn ^:pub ^I32 oil-flat [^Cells v ^I32 id ^:mut ^Cells out]
  (comment "Flat OIL is the header and rows without the four-cell answer envelope. Validate before writing.")
  (if (!= (oil-flat-check v) 0) (return -1))
  (let [^I32 n (cells-len v) ^I32 out-at (cells-len out) ^:mut ^I32 i 0]
    (cells-push out (+ n 4)) (cells-push out 3) (cells-push out id) (cells-push out 0)
    (set i 0)
    (while (< i n) (do (cells-push out (cells-at v i)) (set i (+ i 1))))
    (return (oil-end out out-at))))

(defn ^I32 oil-bitmap-box-valid [^Cells v ^I32 p ^I32 width ^I32 height]
  (let [^I32 x (cells-at v p) ^I32 y (cells-at v (+ p 1))
        ^I32 w (cells-at v (+ p 2)) ^I32 h (cells-at v (+ p 3))]
    ;; Subtraction, rather than x+w, cannot wrap on untrusted coordinates.
    (if (or (< x 0) (or (< y 0) (or (> x width) (> y height)))) (return 0))
    (if (or (> w (- width x)) (> h (- height y))) (return 0)))
  (return 1))

(defn ^:pub ^I32 oil-flat-in-bitmap [^Cells v ^I32 id ^I32 width ^I32 height ^:mut ^Cells out]
  (comment "At an adapter boundary the bitmap supplies the bounds absent from the wire header. Signed baselines are not boxes and may extend outside it.")
  (if (or (< width 0) (< height 0)) (return -1))
  (if (!= (oil-flat-check v) 0) (return -1))
  (let [^I32 caps (cells-at v 4) ^I32 nb (cells-at v 18) ^I32 nl (cells-at v 19)
        ^I32 nw (cells-at v 20) ^:mut ^I32 p 24 ^:mut ^I32 q 0
        ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 k 0 ^:mut ^I32 count 0]
    (while (< i nb)
      (do (if (== (oil-bitmap-box-valid v p width height) 0) (return -1))
          (set p (+ p (oil-block-stride caps))) (set i (+ i 1))))
    (set i 0)
    (while (< i nl)
      (do (if (== (oil-bitmap-box-valid v p width height) 0) (return -1))
          (if (!= (oil-has caps (oc-quad)) 0)
            (do (set q (+ (+ (+ (+ p 6) (oil-has caps (oc-lconf))) (oil-has caps (oc-paras)))
                          (+ (* 4 (oil-has caps (oc-baseline))) (* 3 (oil-has caps (oc-rowmetrics))))))
                (set j 0)
                (while (< j 4)
                  (do (if (or (< (cells-at v q) 0) (> (cells-at v q) width)) (return -1))
                      (if (or (< (cells-at v (+ q 1)) 0) (> (cells-at v (+ q 1)) height)) (return -1))
                      (set q (+ q 2)) (set j (+ j 1))))))
          (set p (+ p (oil-line-stride caps))) (set i (+ i 1))))
    (set i 0)
    (while (< i nw)
      (do (if (== (oil-bitmap-box-valid v p width height) 0) (return -1))
          (set q (+ p (oil-word-base caps)))
          (if (!= (oil-has caps (oc-walts)) 0)
            (do (set count (cells-at v (- q 1))) (set j 0)
                (while (< j count)
                  (do (set q (+ (+ q 2) (cells-at v (+ q 1)))) (set j (+ j 1))))))
          (set count (cells-at v q)) (set q (+ (+ q 2) (cells-at v (+ q 1))))
          (set j 0)
          (while (< j count)
            (do (if (== (oil-bitmap-box-valid v q width height) 0) (return -1))
                (set k (cells-at v (+ q 6)))
                (set q (+ (+ q 7) (cells-at v (+ q 5))))
                (while (> k 0) (do (set q (+ (+ q 2) (cells-at v q))) (set k (- k 1))))
                (set j (+ j 1))))
          (set p q) (set i (+ i 1)))))
  (return (oil-flat v id out)))

(defn ^:pub ^I32 oil-policy-conf [^Cells c ^I32 at ^I32 word]
  (return (ocal-word (oil-get c at (oh-engine)) 0 (cells-at c (+ word 5)))))
