;; P-ARB adversarial laws. Written before the implementation (D786).
(ns emon.oarbtest
  (:require [emon.lang :refer [I32 I64 Cells i64]]
            [emon.test :refer [deftest assert-eq assert-eq64 new-cells new-ctx TestT test-t]]
