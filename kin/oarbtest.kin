            [emon.ofmt :refer [fmt-value fmt-one-digit-sub]]
            [emon.oarbctx :refer [OaWork]]
            [emon.oarb :refer [oa-block oa-pct oa-line-merge oa-band-word oa-band-rule oa-view-factor oa-view-allowed oa-active]]
            [kin.lang :refer [defn return let set while if do + - * < ==]]))

