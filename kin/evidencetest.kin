    (gl-set glyphs 1 (gf-z) 1)
    (gl-set glyphs 1 (gf-mark) 1)
    (gl-new glyphs 1 9000 9000 10000 10200 102 t-fi 2 1)
    (gl-set glyphs 2 (gf-bx0) 9000)
    (gl-set glyphs 2 (gf-by0) 10000)
    (gl-set glyphs 2 (gf-bx1) 10000)
    (gl-set glyphs 2 (gf-by1) 10000)
    (gl-set glyphs 2 (gf-asc) 1000)
