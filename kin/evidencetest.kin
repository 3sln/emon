    (ln-new lines 1 7200 9000 10000 10200 7200 10000 10000 10000 0 0 0 2)
    (ln-set lines 0 (lf-order) 0)
    (ln-new lines 1 1000 2000 3000 4000 1000 4000 3000 2000 4500 0 2 1)
    (ln-set lines 1 (lf-order) 3)
    (comment "paths: a rule and a clip rectangle with its outline in pts; an image")
    (pa-new paths 1 (pa-line) 7200 11000 54000 11050)
    (pa-set paths 0 (pf-stroke) 3355443)
    (pa-set paths 0 (pf-width) 50)
    (pa-set paths 0 (pf-z) 4)
