    (tl-set tlines 0 (tlf-ink) 0)
    (tl-set tlines 0 (tlf-height) 1200)
    (tl-set tlines 0 (tlf-gap) 300)
    (tl-set tlines 0 (tlf-conf) 600)
    (comment "features: a text-layer word and an OCR word, one row each")
    (fe-new feats (ea-words) 0)
    (fe-set feats 0 (xt-trust) 1000)
    (wd-set words 0 (hd-feat) 0)
    (ev-feat-ocr feats epages etext olines owords osyms oalts 0 0 100)
    (return 0)))

(defn ^I32 et-end [^Blob b]
  (comment "A golden's end: its length less one final newline (see jsontest).")
  (let [^I32 n (blob-len b)]
    (if (and (> n 0) (== (blob-u8 b (- n 1)) 10)) (return (- n 1)))
    (return n)))

