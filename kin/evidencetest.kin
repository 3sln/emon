;; -------------------------------------------------------------- the page

(deftest test-the-hand-built-page-has-a-row-in-every-arena-and-is-well-formed
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-rows 1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "epages")
    (assert-eq (ev-rows 2 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "views")
    (assert-eq (ev-rows 3 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "pts")
    (assert-eq (ev-rows 4 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "refs")
    (assert-eq (ev-rows 5 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) (etx-len etext) "etext")
    (assert-eq (ev-rows 6 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "feats")
    (assert-eq (ev-rows 7 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 4 "glyphs")
    (assert-eq (ev-rows 8 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "words")
    (assert-eq (ev-rows 9 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "lines")
    (assert-eq (ev-rows 10 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 4 "marks")
    (assert-eq (ev-rows 11 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "fonts")
    (assert-eq (ev-rows 12 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "paths")
    (assert-eq (ev-rows 13 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "images")
    (assert-eq (ev-rows 14 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 2 "oruns")
    (assert-eq (ev-rows 15 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 4 "oblocks")
    (assert-eq (ev-rows 16 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "olines")
    (assert-eq (ev-rows 17 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "owords")
    (assert-eq (ev-rows 18 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 4 "osyms")
    (assert-eq (ev-rows 19 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 3 "oalts")
    (assert-eq (ev-rows 20 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "inks")
    (assert-eq (ev-rows 21 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "components")
    (assert-eq (ev-rows 22 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "rules")
    (assert-eq (ev-rows 23 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "prims")
    (assert-eq (ev-rows 24 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "tlines")
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0 "the page is well formed")
    (comment "the marks nest, and a glyph's chain finds its artifact")
    (assert-eq (mk-get marks 1 (mkf-parent)) 0 "the span is in the paragraph")
    (assert-eq (mk-get marks 3 (mkf-parent)) 2 "the optional-content span is in the artifact")
    (assert-eq (mk-artifact-of marks 3) 19 "glyph 3's nearest artifact: pagination (1) * 16 + watermark (3)")
    (assert-eq (mk-artifact-of marks 1) 0 "glyph 0's chain holds none")
    (assert-eq (mk-artifact-of marks -1) 0 "no mark, no artifact")
    (assert-eq (mk-ocg-of marks 3) 3 "the optional-content mark")
    (assert-eq (mk-ocg-of marks 1) -1 "none")
    (assert-eq (mk-get marks 0 (mkf-gcount)) 3 "the paragraph holds three glyphs")
    (assert-eq (mk-get marks 1 (mkf-gcount)) 2 "the span two")
    (assert-eq (mk-get marks 0 (mkf-zlast)) 2 "the paragraph's last paint number")
    (assert-eq (mk-get marks 3 (mkf-zfirst)) 3 "the optional-content span paints object 3")
    (assert-eq (mk-get marks 3 (mkf-zlast)) 3 "and only it")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-pagination) (as-watermark)) 2 "the D101 class: watermark")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-background) 0) 4 "background")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-pagination) 0) 1 "pagination")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-other) (as-header)) 1 "a header is pagination")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-layout) 0) 3 "layout")
    (assert-eq (mk-artifact-class (mk-artifact) (ar-page) 0) 5 "/Type /Page says nothing more: other")
    (assert-eq (mk-artifact-class (mk-tag) (ar-pagination) 0) 0 "a tag is no artifact")))

(defn ^I32 et-poke-check [^TestT emon-t ^I32 k ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "Break the page the way check row k says and require that code: the table is the spec of `ev-check`.")
  (let [^I32 code (ev-ck-at 0 k 0)
        ^I32 ea (ev-ck-at 0 k 1)
        ^I32 kind (ev-ck-at 0 k 2)
        ^I32 f1 (ev-ck-at 0 k 3)
        ^I32 f2 (ev-ck-at 0 k 4)
        ^I32 tg (ev-ck-at 0 k 5)
        ^:mut ^I32 row 0
        ^:mut ^I32 v 0
        ^:mut ^I32 off 0
        ^:mut ^I32 cand 0
        ^:mut ^I32 n 0]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq-at (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0 "the page is well formed before it is broken" code)
    (if (== kind 1)
      (do (set n (ev-rows ea epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (while (and (< row n) (< (ev-peek ea row f1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0))
            (set row (+ row 1)))
          (assert-that-at (< row n) "a row with the text run exists" code)
          (ev-poke ea row f2 99999 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)))
    (if (== kind 2) (ev-poke ea 0 f2 99999 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (if (== kind 3) (ev-poke ea 0 f1 99999 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (if (== kind 4) (ev-poke ea 0 f1 99999 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (if (== kind 5) (ev-poke ea 0 f1 0 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (if (== kind 8) (ev-poke ea 0 f1 1000000000 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
    (if (== kind 6)
      (do (set n (ev-rows ea epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (set row 0)
          (while (and (< row n) (< (ev-peek ea row f1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0))
            (set row (+ row 1)))
          (assert-that-at (< row n) "a row with a back pointer exists" code)
          (set v (ev-peek ea row f1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (set n (ev-rows tg epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
          (comment "another row of the target whose run does not hold this row")
          (set off 1)
          (set cand (rem (+ v 1) n))
          (while (and (< off n)
                      (and (>= row (ev-peek tg cand f2 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines))
                           (< row (+ (ev-peek tg cand f2 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) (ev-peek tg cand (+ f2 1) epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)))))
            (do (set off (+ off 1))
                (set cand (rem (+ v off) n))))
          (assert-that-at (< off n) "a row that does not hold it exists" code)
          (ev-poke ea row f1 cand epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)))
    (assert-eq-at (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) code "the code of the row that was broken" code)
    (return 0)))

(deftest test-ev-check-answers-every-code-of-its-table
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)
        ^:mut ^I32 k 0]
    (assert-eq (ev-ck-count 0) 88 "88 table checks, codes 2..89")
    (while (< k (ev-ck-count 0))
      (do (et-poke-check (test-t) k epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
          (set k (+ k 1))))))

(deftest test-ev-check-answers-the-codes-outside-its-table
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (cells-push glyphs 0)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 1 "a stride broken: a glyph arena that is not a whole number of rows")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (cells-push etext 0)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0 "an etext arena has no stride to break")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 4 1 0 99 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 100 "a reference to an arena that is none")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 4 1 1 99 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 100 "a reference to a row that is not there")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 6 0 0 7 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 101 "a feature row whose subject is a glyph")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 6 1 1 9 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 101 "a feature row whose subject is not there")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 8 0 15 1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 102 "a word whose feature row names another word")
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-poke 17 0 15 0 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 102 "an OCR word pointing at the text layer's feature row")))

;; ----------------------------------------------------------------- angles

(deftest test-ev-angle-is-exact-at-every-multiple-of-45-degrees
  (assert-eq (ev-angle 0 0) 0 "the zero vector")
  (assert-eq (ev-angle 100 0) 0 "east")
  (assert-eq (ev-angle 100 -100) 4500 "north-east (y is down: -dy is up)")
  (assert-eq (ev-angle 0 -100) 9000 "north")
  (assert-eq (ev-angle -100 -100) 13500 "north-west")
  (assert-eq (ev-angle -100 0) 18000 "west")
  (assert-eq (ev-angle -100 100) 22500 "south-west")
  (assert-eq (ev-angle 0 100) 27000 "south")
  (assert-eq (ev-angle 100 100) 31500 "south-east")
  (assert-eq (ev-angle 7 -7) 4500 "any length")
  (assert-eq (ev-angle 2147483647 -2147483647) 4500 "the largest")
  (assert-eq (ev-angle -2147483648 0) 18000 "the smallest does not overflow")
  (assert-eq (ev-angle 0 -2147483648) 9000 "nor -dy"))

(defn ^I32 et-sweep [^TestT emon-t]
  (comment "Every centi-degree: the angle of (cos, -sin) in 16.16 is within 3 of it, and never goes down.")
  (let [^:mut ^I32 a 0
        ^:mut ^I32 got 0
        ^:mut ^I32 prev 0
        ^:mut ^I32 d 0]
    (while (< a 36000)
      (do (set got (ev-angle (ev-cos a) (- 0 (ev-sin a))))
          (if (and (== got 0) (> a 18000)) (set got 36000))
          (set d (- got a))
          (if (< d 0) (set d (- 0 d)))
          (assert-that-at (<= d 3) "within 3 centi-degrees (0.03 degree)" a)
          (assert-that-at (>= got prev) "monotonic over the sweep" a)
          (set prev got)
          (set a (+ a 1))))
    (return 0)))

(deftest test-ev-angle-is-monotonic-and-within-3-centi-degrees-over-the-whole-circle
  (et-sweep (test-t)))

(deftest test-sine-and-cosine-come-from-a-table-and-symmetry
  (assert-eq (ev-sin 0) 0 "sin 0")
  (assert-eq (ev-sin 9000) 65536 "sin 90 degrees is 1.0")
  (assert-eq (ev-sin 4500) 46341 "sin 45 degrees")
  (assert-eq (ev-sin 3000) 32768 "sin 30 degrees is one half")
  (assert-eq (ev-sin 18000) 0 "sin 180")
  (assert-eq (ev-sin 27000) -65536 "sin 270")
  (assert-eq (ev-sin -9000) -65536 "sin -90")
  (assert-eq (ev-sin 45000) 65536 "sin 450 is sin 90")
  (assert-eq (ev-cos 0) 65536 "cos 0")
  (assert-eq (ev-cos 9000) 0 "cos 90")
  (assert-eq (ev-cos 18000) -65536 "cos 180")
  (assert-eq (ev-cos -4500) 46341 "cos -45")
  (assert-eq (ev-sin 12000) (ev-sin 6000) "sin 120 is sin 60")
  (assert-eq (ev-sin 24000) (- 0 (ev-sin 6000)) "sin 240 is -sin 60"))

(deftest test-floor-division-rounds-toward-minus-infinity
  (assert-eq (i32 (ev-floordiv (i64 7) (i64 2))) 3 "7 / 2")
  (assert-eq (i32 (ev-floordiv (i64 -7) (i64 2))) -4 "-7 / 2 floors to -4 where `quot` truncates to -3")
  (assert-eq (i32 (ev-floordiv (i64 -8) (i64 2))) -4 "exact")
  (assert-eq (i32 (ev-floordiv (i64 0) (i64 5))) 0 "0"))

(deftest test-overlap-and-baselines
  (assert-eq (ev-overlap-small 0 0 100 100 50 50 150 150) 250 "a quarter of the smaller")
  (assert-eq (ev-overlap-small 0 0 100 100 10 10 20 20) 1000 "a box inside another is all of the smaller")
  (assert-eq (ev-overlap-small 0 0 100 100 200 200 300 300) 0 "disjoint")
  (assert-eq (ev-overlap-small 0 0 100 100 100 0 200 100) 0 "touching is no overlap")
  (assert-eq (ev-overlap-small 0 0 0 0 0 0 100 100) 0 "an empty box overlaps nothing")
  (assert-eq (ev-baseline-at 0 100 1000 200 500) 150 "the middle of a rising segment")
  (assert-eq (ev-baseline-at 0 100 1000 100 777) 100 "a level one")
  (assert-eq (ev-baseline-at 0 100 1000 0 250) 75 "a falling one, truncating")
  (assert-eq (ev-baseline-at 50 70 50 90 50) 90 "a vertical segment answers its end"))

;; ------------------------------------------------------------------ views

(defn ^I32 et-abs [^I32 v]
  (if (< v 0) (return (- 0 v)))
  (return v))

(defn ^I32 et-view-grid [^TestT emon-t ^Cells views ^I32 dpi ^I32 deskew ^I32 turns]
  (comment "px -> cpt -> px lands within one pixel for a grid over a US Letter page, at every resolution (the 16.16")
  (comment "inverse is good to 2^-17 of the distance from the origin: 0.6 pixel at 792 points); and")
  (comment "EXACTLY at 150 and 300 dpi with no deskew (the scale is 48 or 24 centipoints a pixel, exactly).")
  (let [^I32 pw (quot (* dpi 17) 2)
        ^I32 ph (* dpi 11)
        ^I32 v (vw-new views 1 (vk-render) 1 -1 pw ph (* dpi 100) 0 -1 turns deskew 0 0 0)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 px 0
        ^:mut ^I32 py 0
        ^:mut ^I32 x 0
        ^:mut ^I32 y 0
        ^:mut ^I32 bx 0
        ^:mut ^I32 by 0
        ^:mut ^I32 dx 0
        ^:mut ^I32 dy 0]
    (while (< i 6)
      (do (set j 0)
          (while (< j 5)
            (do (set px (quot (* i pw) 5))
                (set py (quot (* j ph) 4))
                (set x (vw-px-to-cpt views v 0 px py))
                (set y (vw-px-to-cpt views v 1 px py))
                (set bx (vw-cpt-to-px views v 0 x y))
                (set by (vw-cpt-to-px views v 1 x y))
                (set dx (et-abs (- bx px)))
                (set dy (et-abs (- by py)))
                (assert-that-at (<= dx 1) "x within one pixel" (+ (* dpi 10) i))
                (assert-that-at (<= dy 1) "y within one pixel" (+ (* dpi 10) j))
                (if (and (== deskew 0) (or (== dpi 150) (== dpi 300)))
                  (do (assert-eq-at bx px "x exactly" (+ (* dpi 10) i))
                      (assert-eq-at by py "y exactly" (+ (* dpi 10) j))))
                (set j (+ j 1))))
          (set i (+ i 1))))
    (return 0)))

(deftest test-a-view-maps-pixels-to-centipoints-and-back
  (let [^Cells views (new-cells)
        ^:mut ^I32 di 0
        ^:mut ^I32 ki 0
        ^:mut ^I32 q 0
        ^:mut ^I32 dpi 0
        ^:mut ^I32 dsk 0]
    (while (< di 7)
      (do (if (== di 0) (set dpi 72))
          (if (== di 1) (set dpi 96))
          (if (== di 2) (set dpi 150))
          (if (== di 3) (set dpi 200))
          (if (== di 4) (set dpi 300))
          (if (== di 5) (set dpi 400))
          (if (== di 6) (set dpi 600))
          (set ki 0)
          (while (< ki 5)
            (do (set dsk 0)
                (if (== ki 1) (set dsk 85))
                (if (== ki 2) (set dsk -85))
                (if (== ki 3) (set dsk 300))
                (if (== ki 4) (set dsk -300))
                (set q 0)
                (while (< q 4)
                  (do (et-view-grid (test-t) views dpi dsk q)
                      (set q (+ q 1))))
                (set ki (+ ki 1))))
          (set di (+ di 1))))))

(deftest test-a-view-at-150-dpi-is-exactly-48-centipoints-a-pixel
  (let [^Cells views (new-cells)
        ^I32 v (vw-new views 1 (vk-render) 1 -1 1275 1650 15000 0 -1 0 0 0 0 0)
        ^I32 w (vw-new views 1 (vk-render) 1 -1 1275 1650 30000 0 -1 0 0 0 0 0)]
    (assert-eq (vw-get views v (vwf-a)) 3145728 "a = 48.0 in 16.16")
    (assert-eq (vw-get views v (vwf-b)) 0 "b = 0")
    (assert-eq (vw-get views v (vwf-c)) 0 "c = 0")
    (assert-eq (vw-get views v (vwf-d)) 3145728 "d = 48.0")
    (assert-eq (vw-get views v (vwf-e)) 0 "e = 0")
    (assert-eq (vw-px-to-cpt views v 0 100 200) 4800 "x = 100 * 48")
    (assert-eq (vw-px-to-cpt views v 1 100 200) 9600 "y = 200 * 48")
    (assert-eq (vw-cpt-to-px views v 0 4800 9600) 100 "and back")
    (assert-eq (vw-get views w (vwf-a)) 1572864 "at 300 dpi 24.0")
    (assert-eq (vw-px-to-cpt views w 0 100 200) 2400 "x = 100 * 24")
    (assert-eq (vw-box-to-cpt views v 0 10 20 30 40) 480 "a pixel box's x0")
    (assert-eq (vw-box-to-cpt views v 1 10 20 30 40) 960 "y0")
    (assert-eq (vw-box-to-cpt views v 2 10 20 30 40) 1920 "x1")
    (assert-eq (vw-box-to-cpt views v 3 10 20 30 40) 2880 "y1")))

(deftest test-quarter-turns-put-the-origin-at-the-right-corner-and-keep-boxes-boxes
  (let [^Cells views (new-cells)
        ^I32 t1 (vw-new views 1 (vk-render) 1 -1 100 200 15000 0 -1 1 0 1000 2000 0)
        ^I32 t2 (vw-new views 1 (vk-render) 1 -1 100 200 15000 0 -1 2 0 1000 2000 0)
        ^I32 t3 (vw-new views 1 (vk-render) 1 -1 100 200 15000 0 -1 3 0 1000 2000 0)]
    (comment "a raster turned a quarter clockwise: its (0,0) is the region's bottom-left; x grows up the page")
    (assert-eq (vw-px-to-cpt views t1 0 0 0) 1000 "t1 origin x")
    (assert-eq (vw-px-to-cpt views t1 1 0 0) 6800 "t1 origin y = cropy + 100 * 48")
    (assert-eq (vw-px-to-cpt views t1 0 10 0) 1000 "moving right on the raster moves up the page: x the same")
    (assert-eq (vw-px-to-cpt views t1 1 10 0) 6320 "and y less by 10 * 48")
    (assert-eq (vw-px-to-cpt views t1 0 0 10) 1480 "moving down the raster moves right on the page")
    (assert-eq (vw-px-to-cpt views t2 0 0 0) 5800 "t2 origin: the opposite corner")
    (assert-eq (vw-px-to-cpt views t2 1 0 0) 11600 "t2 origin y")
    (assert-eq (vw-px-to-cpt views t3 0 0 0) 10600 "t3 origin x = cropx + 200 * 48")
    (assert-eq (vw-px-to-cpt views t3 1 0 0) 2000 "t3 origin y")
    (assert-eq (vw-box-to-cpt views t1 0 0 0 10 20) 1000 "a box turned: its smallest box, x0")
    (assert-eq (vw-box-to-cpt views t1 2 0 0 10 20) 1960 "x1 = 1000 + 20 * 48")
    (assert-eq (vw-box-to-cpt views t1 1 0 0 10 20) 6320 "y0 = 6800 - 10 * 48, the smallest y of the four corners")
    (assert-eq (vw-box-to-cpt views t1 3 0 0 10 20) 6800 "y1")))

;; ---------------------------------------------------------------- features

(deftest test-stage-1-features-of-an-ocr-word
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (comment "owords[0] is Hi with H at 910 (alternatives H 900, ri 250) and i at 880 (alternative l 40)")
    (assert-eq (fe-get feats 1 0) 17 "the subject is an OCR word")
    (assert-eq (fe-get feats 1 1) 0 "word 0")
    (assert-eq (fe-get feats 1 (xo-conf)) 870 "the raw confidence, verbatim")
    (assert-eq (fe-get feats 1 (xo-sym-min)) 880 "the lowest symbol")
    (assert-eq (fe-get feats 1 (xo-sym-mean)) 895 "the mean of 910 and 880")
    (assert-eq (fe-get feats 1 (xo-margin)) 660 "the smallest margin: 910 less the differing alternative 'ri' at 250 is 660, 880 less 'l' at 40 is 840")
    (assert-eq (fe-get feats 1 (xo-ambiguous)) 0 "no margin within 100")
    (assert-eq (fe-get feats 1 (xo-engine-flags)) 1 "the dictionary flag")
    (assert-eq (fe-get feats 1 (xo-implausible)) 0 "Hi is plausible")
    (assert-eq (fe-get feats 1 (xo-length)) 2 "two code points")
    (assert-eq (fe-get feats 1 (xo-angle)) 0 "a level word on a level page")
    (assert-eq (fe-get feats 1 (xo-spacing)) 0 "two symbols of 1200 width with no gap between them")
    (assert-eq (fe-get feats 1 (xo-rel-height)) 1000 "the only word of its line")
    (assert-eq (fe-get feats 1 (xo-base-dev)) 0 "on its line's baseline")
    (assert-eq (fe-get feats 1 (xo-edge)) 7200 "the nearest page edge is the left one")
    (assert-eq (fe-get feats 1 9) -1 "a column of a later stage is -1")
    (assert-eq (fe-get feats 1 31) -1 "a spare column is -1")
    (assert-eq (ow-get owords 0 (hd-feat)) 1 "the word names its feature row")))

(deftest test-implausible-transitions-are-letter-digit-and-lower-to-upper
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (comment "a word r1Il0 (a letter, a digit, a capital, a lower-case letter, a digit): every adjacent pair but l-0")
    (etx-append-cp etext 114)
    (etx-append-cp etext 49)
    (etx-append-cp etext 73)
    (etx-append-cp etext 108)
    (etx-append-cp etext 48)
    (let [^I32 at (- (etx-len etext) 5)]
      (ow-set owords 1 (hd-tstart) at)
      (ow-set owords 1 (hd-tlen) 5)
      (ev-feat-ocr feats epages etext olines owords osyms oalts 1 0 100)
      (comment "pairs r1 (letter-digit), 1I (digit-letter), Il (upper-lower: fine), l0 (letter-digit): 3 of 4")
      (assert-eq (fe-get feats 2 (xo-implausible)) 750 "three of four pairs")
      (assert-eq (fe-get feats 2 (xo-length)) 5 "five code points"))))

;; ------------------------------------------------------------ the dump

(deftest test-every-cell-of-every-stride-is-printed-or-spare
  (comment "Count the cells each arena's field table prints (a box 4, a pair 2, a run 2, a text run 2) and")
  (comment "require the rest to be the spare cells SPEC 8.4 names: no cell is printed twice or forgotten.")
  (let [^:mut ^I32 ea 1
        ^:mut ^I32 r 0
        ^:mut ^I32 cells 0
        ^:mut ^I32 kind 0]
    (while (<= ea 24)
      (do (set cells 0)
          (set r (ev-fx-at 0 (- ea 1) 0))
          (while (< r (+ (ev-fx-at 0 (- ea 1) 0) (ev-fx-at 0 (- ea 1) 1)))
            (do (set kind (ev-fd-at 0 r 2))
                (if (or (== kind 3) (or (== kind 4) (== kind 10))) (set cells (+ cells 4)))
                (if (or (== kind 6) (or (== kind 7) (or (== kind 12) (== kind 13)))) (set cells (+ cells 2)))
                (if (or (== kind 1) (or (== kind 2) (or (== kind 5) (or (== kind 8) (or (== kind 9) (== kind 11))))))
                  (set cells (+ cells 1)))
                (set r (+ r 1))))
          (if (== ea 1) (assert-eq (- (ev-strides-at 0 0) cells) 6 "epages: six spare cells"))
          (if (== ea 2) (assert-eq cells 24 "views: every cell"))
          (if (== ea 3) (assert-eq cells 3 "pts: every cell"))
          (if (== ea 7) (assert-eq cells 32 "glyphs: every cell"))
          (if (== ea 8) (assert-eq cells 24 "words: every cell"))
          (if (== ea 9) (assert-eq (- (ev-strides-at 0 8) cells) 1 "lines: one spare"))
          (if (== ea 10) (assert-eq cells 24 "marks: every cell"))
          (if (== ea 11) (assert-eq cells 16 "fonts: every cell (D108 gave the two spare to /CapHeight and /XHeight)"))
          (if (== ea 12) (assert-eq (- (ev-strides-at 0 11) cells) 5 "paths: five spare"))
          (if (== ea 13) (assert-eq (- (ev-strides-at 0 12) cells) 1 "images: one spare"))
          (if (== ea 14) (assert-eq cells 28 "oruns: every cell"))
          (if (== ea 15) (assert-eq (- (ev-strides-at 0 14) cells) 2 "oblocks: two spare"))
          (if (== ea 16) (assert-eq (- (ev-strides-at 0 15) cells) 1 "olines: one spare"))
          (if (== ea 17) (assert-eq (- (ev-strides-at 0 16) cells) 1 "owords: one spare"))
          (if (== ea 18) (assert-eq (- (ev-strides-at 0 17) cells) 3 "osyms: three spare"))
          (if (== ea 19) (assert-eq cells 4 "oalts: every cell"))
          (if (== ea 20) (assert-eq (- (ev-strides-at 0 19) cells) 3 "inks: three spare"))
          (if (== ea 21) (assert-eq (- (ev-strides-at 0 20) cells) 1 "components: one spare"))
          (if (== ea 22) (assert-eq (- (ev-strides-at 0 21) cells) 2 "rules: two spare"))
          (if (== ea 23) (assert-eq (- (ev-strides-at 0 22) cells) 2 "prims: two spare"))
          (if (== ea 24) (assert-eq (- (ev-strides-at 0 23) cells) 3 "tlines: three spare"))
          (set ea (+ ea 1))))))

(deftest test-golden-page
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)
        ^Text compact (new-text)
        ^Text pretty (new-text)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-emit compact 0 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-emit pretty 1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-text-span compact (test-file "evidence/page1.json") 0 (et-end (test-file "evidence/page1.json")) "compact" 0)
    (assert-text-span pretty (test-file "evidence/page1.pretty.json") 0 (et-end (test-file "evidence/page1.pretty.json")) "pretty" 0)))

(deftest test-an-empty-evidence-dump
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)
        ^Text compact (new-text)
        ^Text pretty (new-text)]
    (ev-init epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-eq (ev-check epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines) 0 "nothing is well formed")
    (ev-emit compact 0 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (ev-emit pretty 1 epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (assert-text-span compact (test-file "evidence/empty.json") 0 (et-end (test-file "evidence/empty.json")) "compact" 0)
    (assert-text-span pretty (test-file "evidence/empty.pretty.json") 0 (et-end (test-file "evidence/empty.pretty.json")) "pretty" 0)))

(deftest test-evidence-text-is-scalar-values-only
  (let [^Cells etext (new-cells)]
    (assert-eq (etx-append-cp etext 65) 0 "index written")
    (etx-append-cp etext 55296)
    (etx-append-cp etext 128512)
    (assert-eq (etx-len etext) 3 "three cells")
    (assert-eq (cells-at etext 1) 65533 "a surrogate became U+FFFD")))
