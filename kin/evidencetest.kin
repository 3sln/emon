    (or-new oruns 1 0)
    (or-set oruns 0 (orf-bview) 1)
    (or-set oruns 0 (orf-request) 2)
    (or-set oruns 0 (orf-round) 1)
    (or-set oruns 0 (orf-pass) (op-first))
    (or-set oruns 0 (orf-psm) 3)
    (or-set oruns 0 (orf-lang) t-eng)
    (or-set oruns 0 (orf-langlen) 3)
    (or-set oruns 0 (orf-deskew) 35)
    (or-set oruns 0 (orf-osd) 0)
    (or-set oruns 0 (orf-script) 1281455214)
    (or-set oruns 0 (orf-sconf) 950)
