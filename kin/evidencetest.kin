    (assert-eq (gl-get glyphs 0 (gf-ocg)) -1 "no optional content")
    (assert-eq (gl-get glyphs 0 (gf-vis)) 0 "unchecked counts as visible")
    (assert-eq (gl-get glyphs 0 (gf-vby)) -1 "no occluder")
    (assert-eq (gl-get glyphs 0 (gf-vchk)) 0 "no check has run")
    (assert-eq (wd-new words 3 1 2 3 4 1 4 3 4 0 0 -1 0 -1 -1 -1) 0 "first word")
