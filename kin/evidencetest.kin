    (gl-set glyphs 3 (gf-font) 1)
    (gl-set glyphs 3 (gf-size) 1400)
    (gl-set glyphs 3 (gf-mode) 3)
    (gl-set glyphs 3 (gf-fill) 16711680)
    (gl-set glyphs 3 (gf-stroke) 255)
    (gl-set glyphs 3 (gf-falpha) 500)
    (gl-set glyphs 3 (gf-salpha) 250)
    (gl-set glyphs 3 (gf-z) 3)
    (gl-set glyphs 3 (gf-clip) 1)
    (gl-set glyphs 3 (gf-mark) 3)
    (gl-set glyphs 3 (gf-ocg) 3)
    (gl-set glyphs 3 (gf-vis) (vz-clipped))
    (gl-set glyphs 3 (gf-vby) 4)
    (gl-set glyphs 3 (gf-vchk) (vc-clip))
    (comment "words: Hi, the ligature, and the hidden one; two lines")
    (wd-new words 1 7200 9000 8400 10200 7200 10000 8400 10000 0 0 t-hi 2 0 -1 -1)
    (wd-set words 0 (wf-style) (sy-bold))
    (wd-set words 0 (wf-gfirst) 0)
    (wd-set words 0 (wf-gcount) 2)
    (wd-set words 0 (wf-font) 0)
    (wd-set words 0 (wf-size) 1200)
    (wd-set words 0 (wf-gap) 600)
    (wd-set words 0 (wf-wbreak) (wb-space))
    (wd-new words 1 9000 9000 10000 10200 9000 10000 10000 10000 0 0 t-fi 2 0 -1 -1)
    (wd-set words 1 (wf-gfirst) 2)
    (wd-set words 1 (wf-gcount) 1)
    (wd-set words 1 (wf-font) 0)
    (wd-set words 1 (wf-size) 1200)
    (wd-set words 1 (wf-wbreak) (wb-line-end))
    (wd-new words 1 1000 2000 3000 4000 1000 4000 3000 2000 4500 0 -1 0 1 -1 -1)
    (wd-set words 2 (wf-gfirst) 3)
