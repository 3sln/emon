    (gl-new glyphs 1 1000 2000 3000 4000 -1 -1 0 2)
    (gl-set glyphs 3 (gf-bx0) 1000)
    (gl-set glyphs 3 (gf-by0) 4000)
    (gl-set glyphs 3 (gf-bx1) 3000)
    (gl-set glyphs 3 (gf-by1) 2000)
    (gl-set glyphs 3 (gf-asc) 400)
