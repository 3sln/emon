(deftest test-every-arena-has-the-stride-the-spec-gives
  (assert-eq (ev-strides-count 0) 24 "24 arenas")
  (assert-eq (ev-strides-at 0 0) 12 "epages")
  (assert-eq (ev-strides-at 0 1) 24 "views")
  (assert-eq (ev-strides-at 0 2) 3 "pts")
  (assert-eq (ev-strides-at 0 3) 2 "refs")
  (assert-eq (ev-strides-at 0 4) 1 "etext")
  (assert-eq (ev-strides-at 0 5) 32 "feats")
  (assert-eq (ev-strides-at 0 6) 32 "glyphs")
  (assert-eq (ev-strides-at 0 7) 24 "words")
  (assert-eq (ev-strides-at 0 8) 16 "lines")
  (assert-eq (ev-strides-at 0 9) 24 "marks")
  (assert-eq (ev-strides-at 0 10) 16 "fonts")
  (assert-eq (ev-strides-at 0 11) 24 "paths")
  (assert-eq (ev-strides-at 0 12) 20 "images")
  (assert-eq (ev-strides-at 0 13) 28 "oruns")
  (assert-eq (ev-strides-at 0 14) 16 "oblocks")
  (assert-eq (ev-strides-at 0 15) 24 "olines")
  (assert-eq (ev-strides-at 0 16) 28 "owords")
  (assert-eq (ev-strides-at 0 17) 20 "osyms")
  (assert-eq (ev-strides-at 0 18) 4 "oalts")
  (assert-eq (ev-strides-at 0 19) 12 "inks")
  (assert-eq (ev-strides-at 0 20) 24 "components")
  (assert-eq (ev-strides-at 0 21) 20 "rules")
  (assert-eq (ev-strides-at 0 22) 24 "prims")
  (assert-eq (ev-strides-at 0 23) 20 "tlines"))

(deftest test-the-three-heads-are-one-layout
  (assert-eq (hd-page) 0 "word head: page")
  (assert-eq (hd-x0) 1 "x0")
  (assert-eq (hd-by1) 8 "baseline ends at 8")
  (assert-eq (hd-rot) 9 "rot")
  (assert-eq (hd-dir) 10 "dir")
  (assert-eq (hd-tstart) 11 "text start")
  (assert-eq (hd-line) 13 "line")
  (assert-eq (hd-conf) 14 "conf")
  (assert-eq (hd-feat) 15 "a word head is 16 cells")
  (assert-eq (lh-page) (hd-page) "line head: page")
  (assert-eq (lh-x0) (hd-x0) "x0")
  (assert-eq (lh-y1) (hd-y1) "y1")
  (assert-eq (lh-bx0) (hd-bx0) "baseline")
  (assert-eq (lh-by1) (hd-by1) "baseline end")
  (assert-eq (lh-rot) (hd-rot) "rot")
  (assert-eq (lh-dir) (hd-dir) "dir")
  (assert-eq (lh-first) 11 "first")
  (assert-eq (lh-count) 12 "a line head is 13 cells")
  (assert-eq (ch-page) 0 "char head: page")
  (assert-eq (ch-y1) 4 "box")
  (assert-eq (ch-cp) 5 "cp")
  (assert-eq (ch-tstart) 6 "text run")
  (assert-eq (ch-word) 8 "a char head is 9 cells"))

(defn ^I32 et-head-page [^Cells c ^I32 stride ^I32 row]
  (comment "ONE reader over (Cells, stride): a word-like or line-like row's page.")
  (return (cells-at c (+ (* row stride) (hd-page)))))

(defn ^I32 et-head-box [^Cells c ^I32 stride ^I32 row ^I32 k]
  (return (cells-at c (+ (* row stride) (+ (hd-x0) k)))))

(defn ^I32 et-head-base [^Cells c ^I32 stride ^I32 row ^I32 k]
  (return (cells-at c (+ (* row stride) (+ (hd-bx0) k)))))

(deftest test-one-reader-reads-the-head-of-every-word-like-and-line-like-arena
  (let [^Cells epages (new-cells)
        ^Cells views (new-cells)
        ^Cells pts (new-cells)
        ^Cells refs (new-cells)
        ^Cells etext (new-cells)
        ^Cells feats (new-cells)
        ^Cells glyphs (new-cells)
        ^Cells words (new-cells)
        ^Cells lines (new-cells)
        ^Cells marks (new-cells)
        ^Cells fonts (new-cells)
        ^Cells paths (new-cells)
        ^Cells images (new-cells)
        ^Cells oruns (new-cells)
        ^Cells oblocks (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^Cells osyms (new-cells)
        ^Cells oalts (new-cells)
        ^Cells inks (new-cells)
        ^Cells components (new-cells)
        ^Cells rules (new-cells)
        ^Cells prims (new-cells)
        ^Cells tlines (new-cells)]
    (et-build epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
    (comment "words (24), owords (28), lines (16), olines (24), tlines (20): row 0 of each shares the head layout")
    (assert-eq (et-head-page words 24 0) 1 "words page")
    (assert-eq (et-head-page owords 28 0) 1 "owords page")
    (assert-eq (et-head-page lines 16 0) 1 "lines page")
    (assert-eq (et-head-page olines 24 0) 1 "olines page")
    (assert-eq (et-head-page tlines 20 0) 1 "tlines page")
    (assert-eq (et-head-box words 24 0 0) 7200 "words x0")
    (assert-eq (et-head-box owords 28 0 0) 7200 "owords x0")
    (assert-eq (et-head-box lines 16 0 0) 7200 "lines x0")
    (assert-eq (et-head-box olines 24 0 0) 7200 "olines x0")
    (assert-eq (et-head-box tlines 20 0 0) 1000 "tlines x0")
    (assert-eq (et-head-box words 24 0 3) 10200 "words y1")
    (assert-eq (et-head-box owords 28 0 3) 10200 "owords y1")
    (assert-eq (et-head-box lines 16 0 3) 10200 "lines y1")
    (assert-eq (et-head-box olines 24 0 3) 10200 "olines y1")
    (assert-eq (et-head-box tlines 20 0 3) 4000 "tlines y1")
    (assert-eq (et-head-base words 24 0 2) 8400 "words baseline x1")
    (assert-eq (et-head-base owords 28 0 2) 9600 "owords baseline x1")
    (assert-eq (et-head-base lines 16 0 2) 10000 "lines baseline x1")
    (assert-eq (et-head-base olines 24 0 2) 9600 "olines baseline x1")
    (assert-eq (et-head-base tlines 20 0 2) 3000 "tlines baseline x1")
    (assert-eq (et-head-base tlines 20 0 3) 2000 "tlines baseline y1 (a diagonal)")
    (assert-eq (ev-angle (- (et-head-base tlines 20 0 2) (et-head-base tlines 20 0 0))
                         (- (et-head-base tlines 20 0 3) (et-head-base tlines 20 0 1))) 4500 "its angle is 45 degrees")))

