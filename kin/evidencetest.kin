    (co-set components 0 (cf-gray) 90)
    (rl-new rules 1 7200 11000 54000 11050 0)
    (rl-set rules 0 (rlf-lx0) 7200)
    (rl-set rules 0 (rlf-ly0) 11025)
    (rl-set rules 0 (rlf-lx1) 54000)
    (rl-set rules 0 (rlf-ly1) 11025)
    (rl-set rules 0 (rlf-thick) 50)
    (rl-set rules 0 (rlf-color) 3355443)
    (rl-set rules 0 (rlf-ink) 0)
    (rl-set rules 0 (rlf-style) (rs-dashed))
    (rl-set rules 0 (rlf-conf) 880)
    (rl-set rules 0 (rlf-rfirst) 0)
    (rl-set rules 0 (rlf-rcount) 1)
    (pm-new prims 1 17000 12000 23000 18000 (pm-circle))
    (pm-set prims 0 (pmf-view) 0)
    (pm-set prims 0 (pmf-cx) 20000)
    (pm-set prims 0 (pmf-cy) 15000)
