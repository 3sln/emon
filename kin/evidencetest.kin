;; Laws for `emon.evidence` v2 (P1.12, D096; SPEC 8.4): the layout and its builders, the integer trigonometry,
;; the views' transforms, the checker (every code), the features, and the dump of a hand-built page as a golden
;; (`test/evidence/`).
;;
;; THE HAND-BUILT PAGE has at least one row in EVERY arena and is well formed: two text-layer words and a
;; third, hidden and diagonal, over four glyphs (a ligature among them); two lines; marked content four deep
;; (a paragraph, a span nested in it, an artifact, an optional-content span nested in that); a clip path; two
;; fonts; an image; an OCR run with two blocks, two paragraphs, three lines, three words, four symbols and
;; three alternatives, one of them several code points; one feature row of each subject; and one row of each
;; of the tracer's arenas. The laws break it one cell at a time.
(ns emon.evidencetest
  (:require [emon.lang :refer [I32 I64 Blob Cells Text i64 i32]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that assert-that-at assert-text-span
                               test-file new-cells new-text TestT test-t Str]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-push]]
            [emon.evidence :refer [ar-background ar-layout ar-other ar-page ar-pagination as-header
                                   as-watermark cf-area cf-color cf-conf cf-fill cf-flags
                                   cf-gray cf-ink cf-kind cf-parent cf-pcount cf-pfirst
                                   cf-pxh cf-pxw cf-pxx cf-stroke cf-view ch-cp
                                   ch-page ch-tstart ch-word ch-y1 ck-rule-h co-get
                                   co-new co-set cs-rgb ea-components ea-glyphs ea-words
                                   eg-raster eg-text-layer ep-new ep-set epf-dpi epf-flags
                                   etx-append-cp etx-len ev-angle ev-baseline-at ev-check ev-ck-at
                                   ev-ck-count ev-cos ev-emit ev-fd-at ev-feat-ocr ev-floordiv
                                   ev-fx-at ev-init ev-overlap-small ev-peek ev-poke ev-rows
                                   ev-sin ev-strides-at ev-strides-count fe-get fe-new fe-set
                                   fnf-asc fnf-capheight fnf-desc fnf-enc fnf-flags fnf-italic
                                   fnf-space fnf-stemv fnf-style fnf-tlen fnf-tounicode fnf-tstart
                                   fnf-xheight fo-get fo-new fo-set ft-type0 ft-type1
                                   gf-asc gf-bx0 gf-bx1 gf-by0 gf-by1 gf-clip
                                   gf-cs gf-desc gf-falpha gf-fill gf-font gf-how
                                   gf-mark gf-mode gf-ocg gf-rot gf-salpha gf-size
                                   gf-stroke gf-vby gf-vchk gf-vis gf-z gh-glyphname
                                   gh-tounicode gl-count gl-get gl-new gl-set hd-bx0
                                   hd-by1 hd-conf hd-dir hd-feat hd-line hd-page
                                   hd-rot hd-tlen hd-tstart hd-x0 hd-y1 ik-get
                                   ik-new ik-set ikf-chroma ikf-color ikf-count ikf-light
                                   ikf-mask ikf-role ikf-spread im-get im-new im-set
                                   ir-body lf-order lf-src lh-bx0 lh-by1 lh-count
                                   lh-dir lh-first lh-page lh-rot lh-x0 lh-y1
                                   ln-get ln-new ln-set mc-inline mc-unterminated mf-alpha
                                   mf-flags mf-obj mf-vby mf-vchk mf-z mg-smask
                                   mk-artifact mk-artifact-class mk-artifact-of mk-close mk-get mk-new
                                   mk-ocg-of mk-open mk-optional-content mk-set mk-tag mkf-actual
                                   mkf-actuallen mkf-alt mkf-altlen mkf-arsub mkf-artype mkf-exp
                                   mkf-explen mkf-flags mkf-gcount mkf-gfirst mkf-lang mkf-langlen
                                   mkf-mcid mkf-ocg mkf-ocgdef mkf-parent mkf-stm mkf-zfirst
                                   mkf-zlast oa-add oa-get oaf-conf ob-block ob-get
                                   ob-new ob-paragraph ob-set obf-conf obf-count obf-first
                                   oe-dictionary ol-get ol-new ol-set olf-asc olf-desc
                                   olf-par olf-ph olf-pw olf-px olf-py olf-run
                                   olf-xheight op-first op-region or-get or-new or-set
                                   orf-bcount orf-bfirst orf-bview orf-deskew orf-flags orf-lang
                                   orf-langlen orf-lcount orf-lfirst orf-oconf orf-osd orf-pass
                                   orf-psm orf-request orf-round orf-sconf orf-script orf-wcount
                                   orf-wfirst os-get os-new os-set os-superscript osf-acount
                                   osf-afirst osf-conf osf-flags osf-ph osf-pw osf-px
                                   osf-py ow-get ow-new ow-set owf-flags owf-lang
                                   owf-ph owf-psize owf-pw owf-px owf-py owf-run
                                   owf-scount owf-sfirst owf-style pa-get pa-line pa-new
                                   pa-rect pa-set pf-clip pf-dash pf-falpha pf-fill
                                   pf-flags pf-pcount pf-pfirst pf-stroke pf-width pf-z
                                   pg-clip pg-closed pm-circle pm-get pm-new pm-set
                                   pmf-color pmf-conf pmf-cx pmf-cy pmf-ink pmf-pcount
                                   pmf-pfirst pmf-rcount pmf-rfirst pmf-rx pmf-ry pmf-stroke
                                   pmf-view po-close po-line po-move pt-add pt-new
                                   rf-add rf-get rl-get rl-new rl-set rlf-color
                                   rlf-conf rlf-ink rlf-lx0 rlf-lx1 rlf-ly0 rlf-ly1
                                   rlf-rcount rlf-rfirst rlf-style rlf-thick rs-dashed tl-get
                                   tl-new tl-set tlf-conf tlf-gap tlf-height tlf-ink
                                   vc-clip vg-engine-binary vk-engine-binary vk-render vw-box-to-cpt vw-cpt-to-px
                                   vw-get vw-new vw-px-to-cpt vwf-a vwf-b vwf-c
                                   vwf-d vwf-e vz-clipped wb-line-end wb-space wd-get
                                   wd-new wd-set wf-font wf-gap wf-gcount wf-gfirst
                                   wf-size wf-src wf-style wf-wbreak xo-ambiguous xo-angle
                                   xo-base-dev xo-conf xo-edge xo-engine-flags xo-implausible xo-length
                                   xo-margin xo-rel-height xo-spacing xo-sym-mean xo-sym-min xt-trust]]
            [emon.model :refer [sr-text sr-hidden-text fl-low-conf sy-bold sy-italic]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

;; ----------------------------------------------------------------- the page

(defn ^I32 et-txt [^:mut ^Cells etext ^I32 c0 ^I32 c1 ^I32 c2 ^I32 c3 ^I32 c4 ^I32 c5 ^I32 c6 ^I32 c7 ^I32 c8]
  (comment "Append the non-negative code points among the nine arguments; answer where the first went.")
  (let [^I32 at (etx-len etext)]
    (if (>= c0 0) (etx-append-cp etext c0))
    (if (>= c1 0) (etx-append-cp etext c1))
    (if (>= c2 0) (etx-append-cp etext c2))
    (if (>= c3 0) (etx-append-cp etext c3))
    (if (>= c4 0) (etx-append-cp etext c4))
    (if (>= c5 0) (etx-append-cp etext c5))
    (if (>= c6 0) (etx-append-cp etext c6))
    (if (>= c7 0) (etx-append-cp etext c7))
    (if (>= c8 0) (etx-append-cp etext c8))
    (return at)))

(defn ^:pub ^I32 et-build [^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tlines]
  (ev-init epages views pts refs etext feats glyphs words lines marks fonts paths images oruns oblocks olines owords osyms oalts inks components rules prims tlines)
  (let [^I32 t-hi (et-txt etext 72 105 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-fi (et-txt etext 102 105 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-p (et-txt etext 80 -1 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-span (et-txt etext 83 112 97 110 -1 -1 -1 -1 -1)
        ^I32 t-en (et-txt etext 101 110 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-art (et-txt etext 65 114 116 105 102 97 99 116 -1)
        ^I32 t-draft (et-txt etext 68 82 65 70 84 -1 -1 -1 -1)
        ^I32 t-oc (et-txt etext 79 67 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-alt (et-txt etext 65 108 116 -1 -1 -1 -1 -1 -1)
        ^I32 t-exp (et-txt etext 69 120 112 -1 -1 -1 -1 -1 -1)
        ^I32 t-arial (et-txt etext 65 114 105 97 108 -1 -1 -1 -1)
        ^I32 t-eng (et-txt etext 101 110 103 -1 -1 -1 -1 -1 -1)
        ^I32 t-ok (et-txt etext 111 107 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-ri (et-txt etext 114 105 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-bh (et-txt etext 72 -1 -1 -1 -1 -1 -1 -1 -1)
        ^I32 t-bl (et-txt etext 108 -1 -1 -1 -1 -1 -1 -1 -1)]
    (comment "shared: the page, two views, three points, three references")
    (ep-new epages 1 61200 79200)
    (ep-set epages 0 (epf-flags) (+ (eg-text-layer) (eg-raster)))
    (ep-set epages 0 (epf-dpi) 15000)
    (vw-new views 1 (vk-render) 7 -1 1275 1650 15000 0 -1 0 0 0 0 0)
    (vw-new views 1 (vk-engine-binary) 7 0 640 480 30000 0 -1 1 85 100 200 (vg-engine-binary))
    (pt-add pts 7200 12000 (po-move))
    (pt-add pts 20000 12000 (po-line))
    (pt-add pts 20000 14000 (po-close))
    (rf-add refs (ea-components) 0)
    (rf-add refs (ea-components) 0)
    (rf-add refs (ea-components) 0)
    (comment "fonts: a simple one and a composite one")
    (fo-new fonts 5 (ft-type1))
    (fo-set fonts 0 (fnf-flags) 32)
    (fo-set fonts 0 (fnf-tounicode) 1)
    (fo-set fonts 0 (fnf-enc) 1)
    (fo-set fonts 0 (fnf-tstart) t-arial)
    (fo-set fonts 0 (fnf-tlen) 5)
    (fo-set fonts 0 (fnf-asc) 905)
    (fo-set fonts 0 (fnf-desc) -212)
    (fo-set fonts 0 (fnf-space) 27800)
    (fo-set fonts 0 (fnf-italic) -1200)
    (fo-set fonts 0 (fnf-stemv) 80)
    (fo-set fonts 0 (fnf-style) (sy-bold))
    (fo-set fonts 0 (fnf-capheight) 716)
    (fo-set fonts 0 (fnf-xheight) 519)
    (fo-new fonts 7 (ft-type0))
    (comment "marks: a paragraph, a span in it, an artifact, an optional-content span in the artifact")
    (mk-open marks 1 (mk-tag) t-p 1 -1 0 0)
    (mk-set marks 0 (mkf-mcid) 0)
    (mk-set marks 0 (mkf-lang) t-en)
    (mk-set marks 0 (mkf-langlen) 2)
    (mk-set marks 0 (mkf-flags) (mc-inline))
    (mk-open marks 1 (mk-tag) t-span 4 0 0 0)
    (mk-set marks 1 (mkf-mcid) 1)
    (mk-set marks 1 (mkf-alt) t-alt)
    (mk-set marks 1 (mkf-altlen) 3)
    (mk-set marks 1 (mkf-exp) t-exp)
    (mk-set marks 1 (mkf-explen) 3)
    (mk-close marks 1 2 2)
    (mk-close marks 0 3 3)
    (mk-open marks 1 (mk-artifact) t-art 8 -1 3 3)
    (mk-set marks 2 (mkf-artype) (ar-pagination))
    (mk-set marks 2 (mkf-arsub) (as-watermark))
    (mk-set marks 2 (mkf-actual) t-draft)
    (mk-set marks 2 (mkf-actuallen) 5)
    (mk-set marks 2 (mkf-stm) 12)
    (mk-set marks 2 (mkf-flags) (mc-unterminated))
    (mk-open marks 1 (mk-optional-content) t-oc 2 2 3 3)
    (mk-set marks 3 (mkf-ocg) 42)
    (mk-set marks 3 (mkf-ocgdef) 0)
    (mk-close marks 3 4 4)
    (mk-close marks 2 4 4)
    (comment "glyphs: H, i, the ligature fi, and a hidden diagonal one inside the optional-content span")
    (gl-new glyphs 1 7200 9000 8000 10200 72 -1 0 0)
    (gl-set glyphs 0 (gf-bx0) 7200)
    (gl-set glyphs 0 (gf-by0) 10000)
    (gl-set glyphs 0 (gf-bx1) 8000)
    (gl-set glyphs 0 (gf-by1) 10000)
    (gl-set glyphs 0 (gf-asc) 1000)
    (gl-set glyphs 0 (gf-desc) -200)
    (gl-set glyphs 0 (gf-how) (gh-tounicode))
    (gl-set glyphs 0 (gf-font) 0)
    (gl-set glyphs 0 (gf-size) 1200)
    (gl-set glyphs 0 (gf-fill) 0)
    (gl-set glyphs 0 (gf-cs) (cs-rgb))
    (gl-set glyphs 0 (gf-z) 0)
    (gl-set glyphs 0 (gf-mark) 1)
    (gl-new glyphs 1 8000 9000 8400 10200 105 -1 0 0)
    (gl-set glyphs 1 (gf-bx0) 8000)
    (gl-set glyphs 1 (gf-by0) 10000)
    (gl-set glyphs 1 (gf-bx1) 8400)
    (gl-set glyphs 1 (gf-by1) 10000)
