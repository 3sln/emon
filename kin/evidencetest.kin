    (ob-new oblocks 1 7200 9000 12000 15000 (ob-block) -1 0)
    (ob-set oblocks 0 (obf-first) 1)
    (ob-set oblocks 0 (obf-count) 1)
    (ob-new oblocks 1 7200 9000 12000 12000 (ob-paragraph) 0 0)
    (ob-set oblocks 1 (obf-first) 0)
    (ob-set oblocks 1 (obf-count) 2)
    (ob-set oblocks 1 (obf-conf) 910)
    (ob-new oblocks 1 7200 13000 12000 15000 (ob-block) -1 0)
