  :accessors {^I32 in-follow-len [^I32 ignored]
              ^I32 in-follow-at [^I32 ignored ^I32 i]})

(defn ^I32 in-lower [^I32 cp]
  (if (and (>= cp 65) (<= cp 90)) (return (+ cp 32)))
  (return cp))

(defn ^:pub ^I32 in-lang [^Cells loc]
  (comment "The language of a locale tag held as code points (`en`, `en-US`, `DE_ch`): LG_NONE for no tag, else an LG_")
  (comment "code, LG_OTHER for a language without a table.")
  (let [^I32 n (cells-len loc)]
    (if (< n 2) (return LG_NONE))
    (let [^I32 a (in-lower (cells-at loc 0))
          ^I32 b (in-lower (cells-at loc 1))
          ^:mut ^I32 c 45]
      (if (> n 2) (set c (cells-at loc 2)))
      (if (and (!= c 45) (!= c 95)) (return LG_OTHER))
      (if (and (== a 101) (== b 110)) (return LG_EN))
      (if (and (== a 100) (== b 101)) (return LG_DE))
      (if (and (== a 102) (== b 114)) (return LG_FR))
      (if (and (== a 101) (== b 115)) (return LG_ES))
      (if (and (== a 112) (== b 116)) (return LG_PT))
      (if (and (== a 105) (== b 116)) (return LG_IT))
      (if (and (== a 110) (== b 108)) (return LG_NL))
      (return LG_OTHER))))

(defn ^Bool in-one-letter [^I32 lang ^I32 cp]
  (comment "Is the upper-case code point cp a word of its own in language `lang` (the union of the tables when LG_NONE or")
  (comment "LG_OTHER)?")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 cur -1]
    (while (< i (in-one-len 0))
      (do (let [^I32 v (in-one-at 0 i)]
            (if (< cur 0)
              (set cur v)
              (if (== v 0)
                (set cur -1)
                (if (and (== v cp) (or (== cur lang) (or (== lang LG_NONE) (== lang LG_OTHER))))
                  (return (== 1 1))))))
          (set i (+ i 1))))
    (return (== 0 1))))

(defn ^Bool in-follows [^I32 lang ^I32 kind ^I32 letter ^Cells et ^I32 ts ^I32 tl]
  (comment "Is the word et[ts, ts+tl) (lower-cased) in the list `kind` (1 the words a one-letter word is followed by, 2 the")
  (comment "rest of a word the letter begins) for (lang, letter)?")
  (let [^I32 n (in-follow-len 0)
        ^:mut ^I32 i 0
        ^:mut ^I32 inlang 0
        ^:mut ^I32 inlet 0
        ^:mut ^I32 w 0
        ^:mut ^I32 k 0
        ^:mut ^I32 same 0]
    (while (< i n)
      (do (let [^I32 v (in-follow-at 0 i)]
            (if (== inlang 0)
              (do (if (== v 0) (return (== 0 1)))
                  (set inlang v)
                  (set inlet 0)
                  (set i (+ i 1)))
              (if (== inlet 0)
                (do (if (== v 0)
                      (do (set inlang 0) (set i (+ i 1)))
                      (do (set inlet v) (set i (+ i 1)))))
                (do (if (== v 0)
                      (do (set inlet 0) (set i (+ i 1)))
                      (do (set w v)
                          (if (and (== inlang (+ (* lang 10) kind)) (== inlet letter) (== w tl))
                            (do (set same 1)
                                (set k 0)
                                (while (< k w)
                                  (do (if (!= (in-follow-at 0 (+ i (+ 1 k))) (in-lower (cells-at et (+ ts k))))
                                        (set same 0))
                                      (set k (+ k 1))))
                                (if (== same 1) (return (== 1 1)))))
                          (set i (+ i (+ 1 w)))))))))))
    (return (== 0 1))))

(defn ^:pub ^I32 in-join [^Cells loc ^I32 cp ^Cells et ^I32 ts ^I32 tl]
  (comment "How an initial whose whole text is the code point cp (upper case or not) meets the first word of its first")
  (comment "line, et[ts, ts+tl) (an empty word is tl 0): 0 joined and sure, 1 joined and flagged low-conf, 2 a space.")
  (let [^I32 lang (in-lang loc)
        ^:mut ^I32 up cp]
    (if (and (>= cp 97) (<= cp 122)) (set up (- cp 32)))
    (if (not (in-one-letter lang up)) (return 0))
    (if (and (== lang LG_EN) (> tl 0))
      (do (if (in-follows lang 1 up et ts tl) (return 2))
          (if (in-follows lang 2 up et ts tl) (return 0))))
    (return 1)))

(defn ^I32 in-join-of [^Cells wd ^Cells et ^Cells lt ^Cells loc ^Cells ii ^I32 r]
  (comment "How the initial of row r of `ii` meets the first word of its first line: 0 joined and sure, 1 joined and")
  (comment "flagged low-conf, 2 a space. One code point: `in-join`'s table and lists. Two or more that begin with a letter or")
  (comment "digit: a whole first word (`IT`), a space, unless it is of a script written without spaces; one that begins with")
  (comment "punctuation (`“N`) is joined. A raised initial is part of its word.")
  (let [^I32 rr (* r II_STRIDE)
        ^I32 il (cells-at ii (+ rr II_IL))
        ^I32 ncp (cells-at ii (+ rr II_NCP))
        ^I32 iw (cells-at ii (+ rr II_WORD))
        ^I32 w1 (ln-get lt (cells-at ii (+ rr II_TL)) (lh-first))]
    (if (and (< il 0) (< ncp (wd-get wd iw (hd-tlen)))) (return 0))
    (let [^I32 c0 (in-first-cp wd et iw)]
      (if (< c0 0) (return 0))
      (if (== ncp 1)
        (return (in-join loc c0 et (wd-get wd w1 (hd-tstart)) (wd-get wd w1 (hd-tlen)))))
      (if (not (in-alnum c0)) (return 0))
      (if (in-ideo c0) (return 0))
      (return 2))))

(defn ^:pub ^I32 in-detect [^Cells wd ^Cells gl ^Cells fo ^Cells et ^I32 npages ^Cells loc ^:mut ^Cells lt
                            ^:mut ^Cells sc ^:mut ^Cells sq ^:mut ^Cells tm ^:mut ^Cells ii]
  (comment "Every page's initials. `lt` is the lines' copy (`lc-copy`): rewritten as the header says. `ii` is the table")
  (comment "of initials (stride 12); `loc` the locale tag as code points (empty for none), which decides the join. `sc sq tm`")
  (comment "are scratch. Answers the initials found.")
  (let [^I32 nl (quot (cells-len lt) 16)
        ^:mut ^I32 p 1
        ^:mut ^I32 r 0
        ^:mut ^I32 q 0]
    (cells-drop ii 0)
    (comment "Cell 15 is this stage's alone, but for a line a table holds (IN_HELD and up, left as it is; such lines are not seen):")
    (comment "whatever else a producer left there is cleared.")
    (while (< r nl)
      (do (if (< (cells-at lt (+ (* r 16) 15)) IN_HELD) (cells-set lt (+ (* r 16) 15) 0))
          (set r (+ r 1))))
    (while (<= p npages)
      (do (in-page wd gl fo et lt p sc sq tm ii)
          (set p (+ p 1))))
    (set q (quot (cells-len ii) II_STRIDE))
    (set r 0)
    (while (< r q)
      (do (let [^I32 rr (* r II_STRIDE)
                ^I32 t (cells-at ii (+ rr II_TL))
                ^I32 jn (in-join-of wd et lt loc ii r)]
            (cells-set ii (+ rr II_JOIN) jn)
            (if (and (>= t 0) (< t nl))
              (let [^:mut ^I32 v (* (+ r 1) 4)]
                (if (< (cells-at ii (+ rr II_IL)) 0)
                  (do (set v (+ v 1))
                      (if (and (== (cells-at ii (+ rr II_NCP)) (wd-get wd (cells-at ii (+ rr II_WORD)) (hd-tlen)))
                               (!= jn 2))
                        (set v (+ v 2)))))
                (cells-set lt (+ (* t 16) 15) v))))
          (set r (+ r 1))))
    (return q)))

(defn ^:pub ^I32 in-retire [^:mut ^Cells lt ^Cells ii]
  (comment "The lines of their own that initials were found in (`ii`: an initial's line that holds no other text) leave the page, so")
  (comment "no stage that builds from the pages sees them. Answers how many.")
  (let [^I32 n (quot (cells-len ii) II_STRIDE)
        ^:mut ^I32 r 0
        ^:mut ^I32 got 0]
    (while (< r n)
      (do (let [^I32 il (cells-at ii (+ (* r II_STRIDE) II_IL))]
            (if (>= il 0)
              (if (>= (cells-at lt (+ (* il 16) 15)) 0)
                (do (cells-set lt (+ (* il 16) (lh-page)) 0)
                    (set got (+ got 1))))))
          (set r (+ r 1))))
    (return got)))

(defn ^:pub ^I32 in-get-ii [^Cells ii ^I32 r ^I32 f]
  (return (cells-at ii (+ (* r II_STRIDE) f))))

(defn ^:pub ^I32 in-row [^Cells lt ^I32 l]
  (comment "The row of `ii` whose target is row l of `lt`, -1 for none.")
  (if (or (< l 0) (> (* (+ l 1) 16) (cells-len lt))) (return -1))
  (let [^I32 c (cells-at lt (+ (* l 16) 15))]
    (if (or (< c 4) (>= c IN_HELD)) (return -1))
    (return (- (quot c 4) 1))))

(defn ^:pub ^I32 in-cell [^Cells lt ^I32 l]
  (comment "Cell 15 of row l as the initials' code: 0 for a line a table holds.")
  (let [^I32 c (cells-at lt (+ (* l 16) 15))]
    (if (>= c IN_HELD) (return 0))
    (return c)))
