;; PDF fonts, encodings and CMaps: code -> Unicode, and widths (P1.6). emon's
;; own module (D039), written from ISO 32000-1 section 9 (text), Annex D
;; (encodings), the Adobe Glyph List specification (glyph names) and Adobe
;; Technical Note #5014 (CMap files). THE POINT OF THIS MODULE IS ACCURACY:
;; what it answers decides whether the extracted text is the text on the page.
;;
;; ONE FONT IS ONE `Cells` (`f`; kin cannot allocate). Make it with
;; `(pfn-init f)` and fill it with `(pfn-load src ar dc a b st f out fh)`, where
;; `fh` is a font dictionary handle in the object arena `ar` and the rest is
;; `emon.pdfdoc`'s workspace (`out` is a scratch `Cells` a decoded stream goes
;; into). The loader resolves everything the font needs through the document
;; layer and keeps nothing of the file: decoded CMap streams are read as a
;; `Blob` (`pfn-cmap`), object values through the object accessors, so this
;; file reads no input of its own (only `pfn-load` and its helpers take `src`,
;; to hand to the document layer).
;;
;; THEN, PER CODE (a character code read from a content-stream string):
;;
;;   (pfn-code-len f b0 b1 b2 b3)   how many bytes the next code takes, given
;;                                  the next four bytes (-1 past the end)
;;   (pfn-map f code)               its Unicode: the count of code points (0 none);
;;                                  they are read back with pfn-cp, and how the
;;                                  value was obtained with pfn-how
;;   (pfn-width f code)             its advance in HUNDREDTHS of a thousandth of
;;                                  an em (w * 100: 27783 is 277.83 / 1000 em),
;;                                  -1 when the font says nothing
;;   (pfn-cid f code)               its CID (composite fonts; the code itself
;;                                  for a simple font)
;;
;; AND PER FONT: `pfn-ascent`, `pfn-descent` (thousandths of an em),
;; `pfn-vertical`, `pfn-kind`, `pfn-warn`.
;;
;; HOW A SIMPLE FONT'S CODE BECOMES UNICODE, in this order, per code, and the
;; first to answer wins (SPEC 8.1 records which, `pfn-how`):
;;   1. the ToUnicode CMap, when it gives the code a value that is not empty,
;;      U+0000 or U+FFFD                                              tounicode
;;   2. a /Differences entry: the glyph name through the AGL rules     glyphname
;;   3. the base encoding (/BaseEncoding or /Encoding name, else Standard,
;;      WinAnsi for a TrueType font with no /Encoding, the built-in encoding
;;      of Symbol and ZapfDingbats): code -> glyph name -> AGL        encoding
;;   When the PDF names no encoding (P3.4, D141) the EMBEDDED FONT PROGRAM'S
;;   built-in encoding replaces the base (`emon.fontprog`: a Type 1 /Encoding, a
;;   CFF Encoding, a symbolic TrueType font's cmap and `post` names); /Differences
;;   and ToUnicode still win. Only where nothing but a GUESS is possible (a symbolic
;;   font whose program says nothing, or is no program) the guess is given and the
;;   `how` is UNKNOWN, so a consumer can tell; a program that NAMES its glyphs and
;;   gives a code no Unicode name withdraws the guess (no value at all).
;;   MacExpertEncoding is read as TEXT (`emon.fontextra`): small capitals, old-style
;;   figures and superiors mean the letters and digits they are variants of.
;; A COMPOSITE (Type0) font's code is looked up in its ToUnicode CMap; with no
;; entry, an Encoding that is a predefined Uni...-UCS2/UTF16 CMap means the
;; code IS the Unicode value; else the CID goes through the Adobe collection's
;; CID-to-Unicode table (`emon.cjk`, D140) when the descendant's /CIDSystemInfo
;; /Ordering is Japan1, GB1, CNS1 or Korea1 or a predefined CMap of one is the
;; Encoding (`how` = cid); else it is unknown (Identity-H with no ToUnicode and
;; another ordering says nothing, and is flagged 1024: no mapping at all). A
;; predefined CMap gives the codespace, WMode and the CIDs (so /W is by the
;; right CID); an embedded CMap is parsed as before.
;;
;; GLYPH NAMES follow the AGL specification: drop the suffix from the first
;; `.`, split on `_`, each component is an AGL name, `uniXXXX...` (groups of
;; four hex digits) or `uXXXX`..`uXXXXXX`; `.notdef` and anything else is no
;; value. The table (`emon.agl`) and the encodings (`emon.encodings`) are
;; generated by `kin/scripts/fontdata.py` from Adobe's own files.
;;
;; CMAPS are parsed into sorted tables of ranges inside the font's `Cells`:
;; bfchar, bfrange (both forms), cidchar, cidrange, codespace ranges (up to
;; 16, kept per byte so multi-byte mixed-width spaces split correctly). Later
;; definitions win over earlier ones; overlaps resolve to the nearest range
;; start (see `pfn-find`). A destination is UTF-16BE, surrogate pairs joined,
;; up to four code points; a range increments the last one.
;;
;; THE STANDARD 14: a BaseFont that names one (or a common alias: Arial,
;; TimesNewRoman, CourierNew, with their Bold/Italic/MT spellings) supplies
;; AFM widths for codes the font's /Widths does not cover, and ascent/descent
;; when there is no descriptor.
;;
;; VERTICAL METRICS: /DW2 and /W2 (`pfn-vertical-metric`).
;;
;; WHAT IS NOT HERE: /CIDToGIDMap, and a glyph-to-Unicode table for the cmap of an
;; embedded CID-keyed TrueType or CFF font with no ToUnicode (D143).
;;
;; BOUNDS: a CMap holds at most 100000 ranges (a warning bit and the rest
;; dropped); a /W array at most 100000 entries; binary searches, a heap sort,
;; no recursion.
(ns emon.pdffont
  (:require [emon.lang :refer [I32 Blob Src Cells Text defenum emit-ascii]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop
                               cells-bytes blob-len blob-u8]]
            [emon.agl :refer [agl-count agl-at agl-pool-at agl-uni-at]]
            [emon.fontprog :refer [fp-simple fp-table-size fp-kind]]
            [emon.fontextra :refer [mac-expert-cp-at]]
            [emon.cjk :refer [cjk-find-name cjk-cmap-field cjk-cs cjk-cid cjk-uni]]
            [emon.pdfx :refer [px-dget px-blen px-bat]]
            [emon.pdfxnames :refer [px-font-file px-font-file2 px-font-file3 px-w2]]
            [emon.encodings :refer [enc-gid-at s14-count s14-at s14-metric-at
                                    s14-alias-count s14-alias-at s14-alias-pool-at
                                    cm-kw-count cm-kw-at cm-kw-pool-at]]
            [emon.pdfnames :refer [pn-subtype pn-w pn-font-descriptor pn-base-font
                                   pn-encoding pn-differences pn-base-encoding
                                   pn-to-unicode pn-widths pn-first-char pn-last-char
                                   pn-flags pn-missing-width pn-ascent pn-descent
                                   pn-font-b-box pn-font-matrix pn-descendant-fonts
                                   pn-dw pn-dw2 pn-type0 pn-type1 pn-mm-type1
                                   pn-true-type pn-type3 pn-win-ansi-encoding
                                   pn-mac-roman-encoding pn-standard-encoding
                                   pn-mac-expert-encoding pn-identity-h pn-identity-v
                                   pn-cid-system-info pn-ordering]]
            [emon.pdflex :refer [pl-kind-of pl-first pl-next pl-int-value pl-name-is
                                 pl-name-len pl-name-byte pl-num-cp pl-ref-gen
                                 pl-stream-dict]]
            [emon.pdfdoc :refer [pd-resolve pd-dget pd-dint pd-stream-data]]
            [emon.pdfsrc :refer [ps-missed]]
            [kin.lang :refer [defn defconst declarefn return let set while if comment do
                              + - * < > <= >= == != and or quot rem
                              bit-and bit-or]]))

;; `pfn-apply-tounicode` (loading) and `pfn-map` (lookup) share it.
(declarefn pfn-tu-load)

;; ------------------------------------------------------------ vocabulary

;; How a code's Unicode value was obtained: the codes of `emon.evidence`'s
;; `gh` (SPEC 8.1), which a law holds equal.
(defenum ^:pub pfn-how
  [[pfn-how-tounicode 1 "tounicode"]
   [pfn-how-encoding 2 "encoding"]
   [pfn-how-glyphname 3 "glyphname"]
   [pfn-how-cid 4 "cid"]
   [pfn-how-unknown 5 "unknown"]])

(defenum ^:pub pfn-status
  [[pfn-ok 0 "ok"]
   [pfn-not-a-font 1 "not-a-font"]
   [pfn-need-bytes 2 "need-bytes"]])

;; Bits of `(pfn-warn f)`: what was forgiven or not understood.
(defenum ^:pub pfn-warning
  [[pfn-w-predefined 1 "predefined CMap not supported"]
   [pfn-w-tounicode-damaged 2 "ToUnicode stream damaged or unreadable"]
   [pfn-w-limit 4 "a CMap or width table was cut at its limit"]
   [pfn-w-macexpert 8 "an unknown encoding name"]
   [pfn-w-no-widths 16 "no /Widths"]
   [pfn-w-no-descendant 32 "composite font without a descendant"]
   [pfn-w-usecmap 64 "usecmap ignored"]
   [pfn-w-long-dest 128 "a CMap destination had more than four code points"]
   [pfn-w-symbolic-guess 256 "symbolic font: built-in encoding guessed"]
   [pfn-w-encoding-cmap 512 "embedded encoding CMap damaged"]
   [pfn-w-no-mapping 1024 "no mapping at all: nothing in the PDF or the font program says what the codes are"]
   [pfn-w-program 2048 "the embedded font program was unreadable"]])

(defenum ^:pub pfn-kind
  [[pfn-k-none 0 "none"]
   [pfn-k-simple 1 "simple"]
   [pfn-k-composite 2 "composite"]])

;; ------------------------------------------------------------ the layout

(defconst ^I32 H_KIND 0)
(defconst ^I32 H_SUB 1)       ;; 1 Type1, 2 MMType1, 3 TrueType, 4 Type3, 5 Type0
(defconst ^I32 H_FLAGS 2)
(defconst ^I32 H_WARN 3)
(defconst ^I32 H_FIRST 4)
(defconst ^I32 H_LAST 5)
(defconst ^I32 H_MISSING 6)   ;; MissingWidth in hundredths of a unit, -1 unset
(defconst ^I32 H_DW 7)        ;; default CID width, same unit
(defconst ^I32 H_ASC 8)
(defconst ^I32 H_DESC 9)
(defconst ^I32 H_S14 10)      ;; the standard font it names, -1 none
(defconst ^I32 H_ENC 11)      ;; base encoding of a simple font, -1 none
(defconst ^I32 H_CMAP 12)     ;; 1 identity, 2 embedded, 3 predefined (unsupported), 4 Unicode direct
(defconst ^I32 H_WMODE 13)
(defconst ^I32 H_HASTU 14)    ;; a ToUnicode CMap was read
(defconst ^I32 H_NCS 15)      ;; codespace ranges
(defconst ^I32 H_TN 16)       ;; the last answer: how many code points
(defconst ^I32 H_T0 17)       ;; ... the code points (17..20)
(defconst ^I32 H_HOW 21)
(defconst ^I32 H_TU_START 22)
(defconst ^I32 H_TU_N 23)
(defconst ^I32 H_CID_START 24)
(defconst ^I32 H_CID_N 25)
(defconst ^I32 H_W_START 26)
(defconst ^I32 H_W_N 27)
(defconst ^I32 H_SEQ 28)
(defconst ^I32 H_DW2V 29)
(defconst ^I32 H_DW2W 30)
(defconst ^I32 H_T3SCALE 31)  ;; Type 3: FontMatrix a in millionths

(defconst ^I32 P_POS 32)      ;; the CMap tokenizer and parser
(defconst ^I32 P_KIND 33)
(defconst ^I32 P_S 34)
(defconst ^I32 P_E 35)
(defconst ^I32 P_NUM 36)
(defconst ^I32 P_SEC 37)
(defconst ^I32 P_ARGC 38)
(defconst ^I32 P_A1S 39)
(defconst ^I32 P_A1E 40)
(defconst ^I32 P_A2S 41)
(defconst ^I32 P_A2E 42)
(defconst ^I32 P_LASTNAME 43)
(defconst ^I32 P_LASTNUM 44)
(defconst ^I32 P_INARR 45)
(defconst ^I32 P_IDX 46)
(defconst ^I32 P_LO 47)
(defconst ^I32 P_HI 48)
(defconst ^I32 P_CSOK 49)
(defconst ^I32 P_MODE 50)
(defconst ^I32 P_COUNT 52)

(defconst ^I32 H_COLL 144)    ;; a predefined CJK CMap: its collection (0 jp, 1 gb, 2 cns, 3 kr), -1 none
(defconst ^I32 H_ROW 145)     ;; ... and its row in that collection
(defconst ^I32 H_ORD 146)     ;; the Adobe collection the CIDs belong to (CIDSystemInfo), -1 none
(defconst ^I32 H_W2_START 147)
(defconst ^I32 H_W2_N 148)
(defconst ^I32 H_PROGHOW 149) ;; what the font program gave: 0 nothing, else a count of codes + 1
(defconst ^I32 CS_BASE 64)    ;; 16 codespace ranges of [bytes lohi lolo hihi hilo]
(defconst ^I32 CS_MAX 16)
(defconst ^I32 CS_STRIDE 5)
(defconst ^I32 SIMPLE_BASE 160)
(defconst ^I32 ENTRY 8)       ;; simple table: [n cp0 cp1 cp2 how width gid cp3]
(defconst ^I32 TU_STRIDE 9)   ;; [lo hi n seq d0 d1 d2 d3 cummax]
(defconst ^I32 VAL_STRIDE 5)  ;; [lo hi value seq cummax]
(defconst ^I32 W2_STRIDE 7)   ;; [lo hi w1 seq vx vy cummax]
(defconst ^I32 CM_MAX 100000)

(defconst ^I32 SUB_TYPE1 1)
(defconst ^I32 SUB_MMTYPE1 2)
(defconst ^I32 SUB_TRUETYPE 3)
(defconst ^I32 SUB_TYPE3 4)
(defconst ^I32 SUB_TYPE0 5)

;; ------------------------------------------------------------ small parts

(defn ^:pub ^I32 pfn-init [^:mut ^Cells f]
  (comment "An empty font: a zeroed header with the unset values marked.")
  (let [^:mut ^I32 i 0]
    (cells-drop f 0)
    (while (< i SIMPLE_BASE)
      (do (cells-push f 0)
          (set i (+ i 1))))
    (cells-set f H_MISSING -1)
    (cells-set f H_S14 -1)
    (cells-set f H_ENC -1)
    (cells-set f H_DW 100000)
    (cells-set f H_DW2V 88000)
    (cells-set f H_DW2W -100000)
    (cells-set f H_T3SCALE 1000)
    (cells-set f H_COLL -1)
    (cells-set f H_ORD -1)
    (return 0)))

(defn ^I32 pfn-warn-set [^:mut ^Cells f ^I32 bit]
  (let [^I32 w (cells-at f H_WARN)]
    (if (== (rem (quot w bit) 2) 0)
      (cells-set f H_WARN (+ w bit)))
    (return 0)))

(defn ^:pub ^I32 pfn-warn [^Cells f] (return (cells-at f H_WARN)))
(defn ^:pub ^I32 pfn-kind-of [^Cells f] (return (cells-at f H_KIND)))
(defn ^:pub ^I32 pfn-subtype [^Cells f] (return (cells-at f H_SUB)))
(defn ^:pub ^I32 pfn-ascent [^Cells f] (return (cells-at f H_ASC)))
(defn ^:pub ^I32 pfn-descent [^Cells f] (return (cells-at f H_DESC)))
(defn ^:pub ^I32 pfn-vertical [^Cells f] (return (cells-at f H_WMODE)))
(defn ^:pub ^I32 pfn-standard-font [^Cells f] (return (cells-at f H_S14)))
(defn ^:pub ^I32 pfn-has-tounicode [^Cells f] (return (cells-at f H_HASTU)))
(defn ^:pub ^I32 pfn-flags [^Cells f] (return (cells-at f H_FLAGS)))       ;; the descriptor's /Flags, verbatim (P1.12)
(defn ^:pub ^I32 pfn-encoding [^Cells f] (return (cells-at f H_ENC)))      ;; a simple font's base encoding, -1 none (P1.12)
(defn ^:pub ^I32 pfn-dw2-v [^Cells f] (return (cells-at f H_DW2V)))
(defn ^:pub ^I32 pfn-dw2-w [^Cells f] (return (cells-at f H_DW2W)))
(defn ^:pub ^I32 pfn-cp [^Cells f ^I32 i]
  (comment "The i-th code point of the last `pfn-map` answer.")
  (return (cells-at f (+ H_T0 i))))
(defn ^:pub ^I32 pfn-how-of [^Cells f]
  (comment "How the last `pfn-map` answer was obtained (`pfn-how`).")
  (return (cells-at f H_HOW)))

(defn ^I32 pfn-hexv [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (if (and (>= c 65) (<= c 70)) (return (- c 55)))
  (return -1))

(defn ^I32 pfn-hex-ndig [^Blob d ^I32 s ^I32 e]
  (comment "The hex digits in d[s, e); anything else (white space) is skipped.")
  (let [^:mut ^I32 k s
        ^:mut ^I32 nd 0]
    (while (< k e)
      (do (if (>= (pfn-hexv (blob-u8 d k)) 0) (set nd (+ nd 1)))
          (set k (+ k 1))))
    (return nd)))

(defn ^I32 pfn-hex-win [^Blob d ^I32 s ^I32 e ^I32 from ^I32 to]
  (comment "The value of hex digits number from..to-1 (counted from the first")
  (comment "digit of d[s, e)), saturating at 2^31-1.")
  (let [^:mut ^I32 k s
        ^:mut ^I32 idx 0
        ^:mut ^I32 v 0
        ^:mut ^I32 hv 0]
    (while (< k e)
      (do (set hv (pfn-hexv (blob-u8 d k)))
          (if (>= hv 0)
            (do (if (and (>= idx from) (< idx to))
                  (do (if (> v 134217727)
                        (set v 2147483647)
                        (set v (+ (* v 16) hv)))))
                (set idx (+ idx 1))))
          (set k (+ k 1))))
    (return v)))

(defn ^I32 pfn-hex-val [^Blob d ^I32 s ^I32 e]
  (return (pfn-hex-win d s e 0 64)))

;; ------------------------------------------------------ sorted range tables

(defn ^I32 pfn-rec-less [^Cells f ^I32 base ^I32 stride ^I32 i ^I32 j]
  (comment "1 when record i sorts strictly before record j: by first code, then")
  (comment "by the order of definition.")
  (let [^I32 pi (+ base (* i stride))
        ^I32 pj (+ base (* j stride))
        ^I32 li (cells-at f pi)
        ^I32 lj (cells-at f pj)]
    (if (< li lj) (return 1))
    (if (> li lj) (return 0))
    (if (< (cells-at f (+ pi 3)) (cells-at f (+ pj 3))) (return 1))
    (return 0)))

(defn ^I32 pfn-rec-swap [^:mut ^Cells f ^I32 base ^I32 stride ^I32 i ^I32 j]
  (let [^I32 pi (+ base (* i stride))
        ^I32 pj (+ base (* j stride))
        ^:mut ^I32 k 0
        ^:mut ^I32 tmp 0]
    (while (< k stride)
      (do (set tmp (cells-at f (+ pi k)))
          (cells-set f (+ pi k) (cells-at f (+ pj k)))
          (cells-set f (+ pj k) tmp)
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 pfn-sift [^:mut ^Cells f ^I32 base ^I32 stride ^I32 start ^I32 end]
  (comment "Sift record `start` down in the max-heap of the first `end` records.")
  (let [^:mut ^I32 root start
        ^:mut ^I32 child 0
        ^:mut ^I32 more 1]
    (while (== more 1)
      (do (set child (+ (* root 2) 1))
          (if (>= child end)
            (set more 0)
            (do (if (< (+ child 1) end)
                  (if (== (pfn-rec-less f base stride child (+ child 1)) 1)
                    (set child (+ child 1))))
                (if (== (pfn-rec-less f base stride root child) 1)
                  (do (pfn-rec-swap f base stride root child)
                      (set root child))
                  (set more 0))))))
    (return 0)))

(defn ^I32 pfn-finish [^:mut ^Cells f ^I32 base ^I32 n ^I32 stride]
  (comment "Sort n records by (first code, definition order) with a heap sort, then")
  (comment "fill the last field of each with the largest `hi` so far, which bounds")
  (comment "how far back a lookup must look.")
  (let [^:mut ^I32 i (- (quot n 2) 1)
        ^:mut ^I32 end (- n 1)
        ^:mut ^I32 cm 0
        ^:mut ^I32 hi 0]
    (while (>= i 0)
      (do (pfn-sift f base stride i n)
          (set i (- i 1))))
    (while (> end 0)
      (do (pfn-rec-swap f base stride 0 end)
          (pfn-sift f base stride 0 end)
          (set end (- end 1))))
    (set i 0)
    (set cm -1)
    (while (< i n)
      (do (set hi (cells-at f (+ (+ base (* i stride)) 1)))
          (if (> hi cm) (set cm hi))
          (cells-set f (+ (+ base (* i stride)) (- stride 1)) cm)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 pfn-find [^Cells f ^I32 base ^I32 n ^I32 stride ^I32 code]
  (comment "The cell index of the record that covers `code`, or -1. The record")
  (comment "with the greatest first code <= code that covers it (the latest")
  (comment "definition among equals); at most 64 records back are looked at.")
  (let [^:mut ^I32 lo 0
        ^:mut ^I32 hi (- n 1)
        ^:mut ^I32 mid 0
        ^:mut ^I32 ans -1
        ^:mut ^I32 steps 0
        ^:mut ^I32 at 0
        ^:mut ^I32 more 1]
    (while (<= lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2)))
          (if (<= (cells-at f (+ base (* mid stride))) code)
            (do (set ans mid)
                (set lo (+ mid 1)))
            (set hi (- mid 1)))))
    (while (and (== more 1) (and (>= ans 0) (< steps 64)))
      (do (set at (+ base (* ans stride)))
          (if (< (cells-at f (+ at (- stride 1))) code)
            (set more 0)
            (if (>= (cells-at f (+ at 1)) code)
              (return at)
              (do (set ans (- ans 1))
                  (set steps (+ steps 1)))))))
    (return -1)))

;; ----------------------------------------------------------- CMap tokens

(defn ^I32 pfn-ws [^I32 c]
  (if (== c 32) (return 1))
  (if (== c 10) (return 1))
  (if (== c 13) (return 1))
  (if (== c 9) (return 1))
  (if (== c 12) (return 1))
  (if (== c 0) (return 1))
  (return 0))

(defn ^I32 pfn-delim [^I32 c]
  (if (== c 40) (return 1))
  (if (== c 41) (return 1))
  (if (== c 60) (return 1))
  (if (== c 62) (return 1))
  (if (== c 91) (return 1))
  (if (== c 93) (return 1))
  (if (== c 123) (return 1))
  (if (== c 125) (return 1))
  (if (== c 47) (return 1))
  (if (== c 37) (return 1))
  (return 0))

(defn ^I32 pfn-tok-set [^:mut ^Cells f ^I32 kind ^I32 s ^I32 e ^I32 nextpos]
  (cells-set f P_KIND kind)
  (cells-set f P_S s)
  (cells-set f P_E e)
  (cells-set f P_POS nextpos)
  (return kind))

(defn ^I32 pfn-tok [^:mut ^Cells f ^Blob d]
  (comment "The next token of a CMap program: 0 end, 1 hex string <..> (P_S..P_E")
  (comment "the digits), 2 name (P_S..P_E after the slash), 3 number (P_NUM, the")
  (comment "integer part), 4 keyword, 5 [, 6 ], 7 <<, 8 >>, 9 string, 10 { } or a")
  (comment "stray delimiter. Every token consumes at least one byte.")
  (let [^I32 n (blob-len d)
        ^:mut ^I32 pos (cells-at f P_POS)
        ^:mut ^I32 c 0
        ^:mut ^I32 more 1
        ^:mut ^I32 k 0
        ^:mut ^I32 dep 0
        ^:mut ^I32 c2 0
        ^:mut ^I32 neg 0
        ^:mut ^I32 val 0
        ^:mut ^I32 isnum 1
        ^:mut ^I32 seendig 0
        ^:mut ^I32 frac 0]
    (while (== more 1)
      (if (>= pos n)
        (set more 0)
        (do (set c (blob-u8 d pos))
            (if (== (pfn-ws c) 1)
              (set pos (+ pos 1))
              (if (== c 37)
                (while (and (< pos n) (and (!= (blob-u8 d pos) 10) (!= (blob-u8 d pos) 13)))
                  (set pos (+ pos 1)))
                (set more 0))))))
    (if (>= pos n) (return (pfn-tok-set f 0 n n n)))
    (set c (blob-u8 d pos))
    (if (== c 60)
      (do (if (and (< (+ pos 1) n) (== (blob-u8 d (+ pos 1)) 60))
            (return (pfn-tok-set f 7 pos (+ pos 2) (+ pos 2))))
          (set k (+ pos 1))
          (while (and (< k n) (!= (blob-u8 d k) 62))
            (set k (+ k 1)))
          (if (< k n)
            (return (pfn-tok-set f 1 (+ pos 1) k (+ k 1)))
            (return (pfn-tok-set f 1 (+ pos 1) n n)))))
    (if (== c 62)
      (do (if (and (< (+ pos 1) n) (== (blob-u8 d (+ pos 1)) 62))
            (return (pfn-tok-set f 8 pos (+ pos 2) (+ pos 2))))
          (return (pfn-tok-set f 10 pos (+ pos 1) (+ pos 1)))))
    (if (== c 91) (return (pfn-tok-set f 5 pos (+ pos 1) (+ pos 1))))
    (if (== c 93) (return (pfn-tok-set f 6 pos (+ pos 1) (+ pos 1))))
    (if (== c 40)
      (do (set k (+ pos 1))
          (set dep 1)
          (while (and (< k n) (> dep 0))
            (do (set c2 (blob-u8 d k))
                (if (== c2 92)
                  (set k (+ k 1))
                  (if (== c2 40)
                    (set dep (+ dep 1))
                    (if (== c2 41) (set dep (- dep 1)))))
                (set k (+ k 1))))
          (if (> k n) (set k n))
          (return (pfn-tok-set f 9 pos k k))))
    (if (or (== c 123) (or (== c 125) (== c 41)))
      (return (pfn-tok-set f 10 pos (+ pos 1) (+ pos 1))))
    (if (== c 47)
      (do (set k (+ pos 1))
          (while (and (< k n) (and (== (pfn-ws (blob-u8 d k)) 0) (== (pfn-delim (blob-u8 d k)) 0)))
            (set k (+ k 1)))
          (return (pfn-tok-set f 2 (+ pos 1) k k))))
    (comment "a run of regular characters: a number or a keyword")
    (set k pos)
    (while (and (< k n) (and (== (pfn-ws (blob-u8 d k)) 0) (== (pfn-delim (blob-u8 d k)) 0)))
      (set k (+ k 1)))
    (set isnum 1)
    (set c2 pos)
    (if (and (< c2 k) (or (== (blob-u8 d c2) 43) (== (blob-u8 d c2) 45)))
      (do (if (== (blob-u8 d c2) 45) (set neg 1))
          (set c2 (+ c2 1))))
    (while (< c2 k)
      (do (set c (blob-u8 d c2))
          (if (and (>= c 48) (<= c 57))
            (do (set seendig 1)
                (if (== frac 0)
                  (do (comment "Saturate at 2^31-1 (P2.12, D107): the old clamp to 214748364, then x10+d, overflowed for d of 8 or 9.")
                      (if (or (> val 214748364) (and (== val 214748364) (> c 55)))
                        (set val 2147483647)
                        (set val (+ (* val 10) (- c 48)))))))
            (if (== c 46)
              (set frac 1)
              (set isnum 0)))
          (set c2 (+ c2 1))))
    (if (and (== isnum 1) (== seendig 1))
      (do (if (== neg 1) (set val (- 0 val)))
          (cells-set f P_NUM val)
          (return (pfn-tok-set f 3 pos k k))))
    (return (pfn-tok-set f 4 pos k k))))

(defn ^I32 pfn-match [^Blob d ^I32 s ^I32 e]
  (comment "The id of the CMap token d[s, e) if it is one of `cm-kw`'s, else 0.")
  (let [^I32 cnt (cm-kw-count 0)
        ^:mut ^I32 r 0
        ^:mut ^I32 off 0
        ^:mut ^I32 ln 0
        ^:mut ^I32 j 0
        ^:mut ^I32 same 1]
    (while (< r cnt)
      (do (set ln (cm-kw-at 0 r 1))
          (if (== ln (- e s))
            (do (set off (cm-kw-at 0 r 0))
                (set j 0)
                (set same 1)
                (while (and (== same 1) (< j ln))
                  (do (if (!= (blob-u8 d (+ s j)) (cm-kw-pool-at 0 (+ off j)))
                        (set same 0))
                      (set j (+ j 1))))
                (if (== same 1) (return (cm-kw-at 0 r 2)))))
          (set r (+ r 1))))
    (return 0)))

;; ------------------------------------------------------ CMap destinations

(defn ^I32 pfn-tmp-add [^:mut ^Cells f ^I32 cp]
  (let [^I32 n (cells-at f H_TN)]
    (if (< n 4)
      (do (cells-set f (+ H_T0 n) cp)
          (cells-set f H_TN (+ n 1)))
      (pfn-warn-set f 128))
    (return 0)))

(defn ^I32 pfn-dst [^:mut ^Cells f ^Blob d ^I32 s ^I32 e]
  (comment "Decode the hex d[s, e) as UTF-16BE into the answer registers (up to")
  (comment "four code points). One or two digits are one byte-sized unit. A")
  (comment "lone surrogate is U+FFFD.")
  (let [^I32 nd (pfn-hex-ndig d s e)
        ^I32 units (quot (+ nd 3) 4)
        ^:mut ^I32 u 0
        ^:mut ^I32 v 0
        ^:mut ^I32 v2 0
        ^:mut ^I32 cp 0]
    (cells-set f H_TN 0)
    (if (== nd 0) (return 0))
    (if (<= nd 2)
      (do (pfn-tmp-add f (pfn-hex-win d s e 0 2))
          (return 1)))
    (while (< u units)
      (do (set v (pfn-hex-win d s e (* u 4) (+ (* u 4) 4)))
          (set cp v)
          (if (and (>= v 55296) (<= v 57343))
            (do (set cp 65533)
                (if (and (<= v 56319) (< (+ u 1) units))
                  (do (set v2 (pfn-hex-win d s e (* (+ u 1) 4) (+ (* (+ u 1) 4) 4)))
                      (if (and (>= v2 56320) (<= v2 57343))
                        (do (set cp (+ 65536 (+ (* (- v 55296) 1024) (- v2 56320))))
                            (set u (+ u 1))))))))
          (pfn-tmp-add f cp)
          (set u (+ u 1))))
    (return (cells-at f H_TN))))

(defn ^I32 pfn-add-tu [^:mut ^Cells f ^Blob d ^I32 lo ^I32 hi ^I32 ds ^I32 de]
  (if (< lo 0) (return 0))
  (if (< hi lo) (return 0))
  (if (>= (cells-at f P_COUNT) CM_MAX)
    (do (pfn-warn-set f 4) (return 0)))
  (pfn-dst f d ds de)
  (let [^I32 seq (cells-at f H_SEQ)]
    (cells-set f H_SEQ (+ seq 1))
    (cells-set f P_COUNT (+ (cells-at f P_COUNT) 1))
    (cells-push f lo)
    (cells-push f hi)
    (cells-push f (cells-at f H_TN))
    (cells-push f seq)
    (cells-push f (cells-at f (+ H_T0 0)))
    (cells-push f (cells-at f (+ H_T0 1)))
    (cells-push f (cells-at f (+ H_T0 2)))
    (cells-push f (cells-at f (+ H_T0 3)))
    (cells-push f 0)
    (return 1)))

(defn ^I32 pfn-sat [^I32 a ^I32 j]
  (comment "a + j for j >= 0, held at 2^31-1: a /W start of 2147483647 plus an index (P10.5, D703).")
  (if (> a (- 2147483647 j)) (return 2147483647))
  (return (+ a j)))

(defn ^I32 pfn-add-val [^:mut ^Cells f ^I32 lo ^I32 hi ^I32 v]
  (comment "A [lo hi value] record (a CID range or a width range).")
  (if (< lo 0) (return 0))
  (if (< hi lo) (return 0))
  (if (>= (cells-at f P_COUNT) CM_MAX)
    (do (pfn-warn-set f 4) (return 0)))
  (let [^I32 seq (cells-at f H_SEQ)]
    (cells-set f H_SEQ (+ seq 1))
    (cells-set f P_COUNT (+ (cells-at f P_COUNT) 1))
    (cells-push f lo)
    (cells-push f hi)
    (cells-push f v)
    (cells-push f seq)
    (cells-push f 0)
    (return 1)))

;; ------------------------------------------------------- codespace ranges

(defn ^I32 pfn-cs-put [^:mut ^Cells f ^I32 nb ^I32 lohi ^I32 lolo ^I32 hihi ^I32 hilo]
  (comment "Add a codespace range of nb bytes; each bound is two 16-bit halves.")
  (let [^I32 n (cells-at f H_NCS)
        ^I32 at (+ CS_BASE (* n CS_STRIDE))]
    (if (>= n CS_MAX) (return 0))
    (cells-set f at nb)
    (cells-set f (+ at 1) lohi)
    (cells-set f (+ at 2) lolo)
    (cells-set f (+ at 3) hihi)
    (cells-set f (+ at 4) hilo)
    (cells-set f H_NCS (+ n 1))
    (return 1)))

(defn ^I32 pfn-cs-add [^:mut ^Cells f ^Blob d ^I32 s1 ^I32 e1 ^I32 s2 ^I32 e2]
  (let [^I32 nd (pfn-hex-ndig d s1 e1)
        ^I32 nd2 (pfn-hex-ndig d s2 e2)
        ^:mut ^I32 nb (quot (+ nd 1) 2)
        ^:mut ^I32 lolo 0
        ^:mut ^I32 lohi 0
        ^:mut ^I32 hilo 0
        ^:mut ^I32 hihi 0
        ^:mut ^I32 a 0]
    (if (< nb 1) (set nb 1))
    (if (> nb 4) (set nb 4))
    (set a (- nd 4))
    (if (< a 0) (set a 0))
    (set lolo (pfn-hex-win d s1 e1 a nd))
    (set a (- nd 8))
    (if (< a 0) (set a 0))
    (if (> nd 4) (set lohi (pfn-hex-win d s1 e1 a (- nd 4))))
    (set a (- nd2 4))
    (if (< a 0) (set a 0))
    (set hilo (pfn-hex-win d s2 e2 a nd2))
    (set a (- nd2 8))
    (if (< a 0) (set a 0))
    (if (> nd2 4) (set hihi (pfn-hex-win d s2 e2 a (- nd2 4))))
    (return (pfn-cs-put f nb lohi lolo hihi hilo))))

(defn ^I32 pfn-cs-byte [^Cells f ^I32 r ^I32 which ^I32 k]
  (comment "Byte k (0 is the first) of the lower (which 0) or upper (1) bound of")
  (comment "codespace range r.")
  (let [^I32 at (+ CS_BASE (* r CS_STRIDE))
        ^I32 nb (cells-at f at)
        ^I32 sh (* 8 (- (- nb 1) k))
        ^:mut ^I32 half 0
        ^:mut ^I32 s2 sh]
    (if (>= sh 16)
      (do (set s2 (- sh 16))
          (set half (cells-at f (+ at (+ 1 (* which 2))))))
      (set half (cells-at f (+ at (+ 2 (* which 2))))))
    (if (== s2 8) (return (rem (quot half 256) 256)))
    (return (rem half 256))))

(defn ^I32 pfn-cs-match [^Cells f ^I32 r ^I32 b0 ^I32 b1 ^I32 b2 ^I32 b3]
  (comment "1 when the next bytes (-1 past the end) are a code of range r.")
  (let [^I32 nb (cells-at f (+ CS_BASE (* r CS_STRIDE)))
        ^:mut ^I32 k 0
        ^:mut ^I32 b 0]
    (while (< k nb)
      (do (set b b0)
          (if (== k 1) (set b b1))
          (if (== k 2) (set b b2))
          (if (== k 3) (set b b3))
          (if (< b 0) (return 0))
          (if (< b (pfn-cs-byte f r 0 k)) (return 0))
          (if (> b (pfn-cs-byte f r 1 k)) (return 0))
          (set k (+ k 1))))
    (return 1)))

(defn ^:pub ^I32 pfn-code-len [^Cells f ^I32 b0 ^I32 b1 ^I32 b2 ^I32 b3]
  (comment "The length in bytes of the character code that starts the bytes b0..b3")
  (comment "(-1 past the end of the string). A simple font's codes are one byte.")
  (comment "A composite font's are as its codespace ranges say; a first byte that")
  (comment "matches no range takes the length of the shortest range.")
  (if (!= (cells-at f H_KIND) 2) (return 1))
  (let [^I32 nr (cells-at f H_NCS)
        ^:mut ^I32 clen 1
        ^:mut ^I32 r 0
        ^:mut ^I32 nbx 0
        ^:mut ^I32 shortest 4]
    (if (== nr 0) (return 2))
    (while (<= clen 4)
      (do (set r 0)
          (while (< r nr)
            (do (if (== (cells-at f (+ CS_BASE (* r CS_STRIDE))) clen)
                  (if (== (pfn-cs-match f r b0 b1 b2 b3) 1)
                    (return clen)))
                (set r (+ r 1))))
          (set clen (+ clen 1))))
    (comment "no full match: a range whose first byte fits, else the shortest")
    (set r 0)
    (while (< r nr)
      (do (set nbx (cells-at f (+ CS_BASE (* r CS_STRIDE))))
          (if (< nbx shortest) (set shortest nbx))
          (if (>= b0 (pfn-cs-byte f r 0 0))
            (if (<= b0 (pfn-cs-byte f r 1 0))
              (return nbx)))
          (set r (+ r 1))))
    (return shortest)))

;; ------------------------------------------------------------ the CMap parser

(defn ^I32 pfn-cmap-tok [^:mut ^Cells f ^Blob d ^I32 kind]
  (comment "One token of a CMap program. State lives in the P_ cells.")
  (let [^I32 sec (cells-at f P_SEC)
        ^I32 mode (cells-at f P_MODE)
        ^I32 argc (cells-at f P_ARGC)
        ^:mut ^I32 id 0
        ^:mut ^I32 lo 0
        ^:mut ^I32 hi 0]
    (if (== kind 4)
      (do (set id (pfn-match d (cells-at f P_S) (cells-at f P_E)))
          (if (and (>= id 1) (<= id 12))
            (if (== (rem id 2) 1)
              (do (cells-set f P_SEC id)
                  (cells-set f P_ARGC 0)
                  (cells-set f P_INARR 0))
              (do (cells-set f P_SEC 0)
                  (cells-set f P_ARGC 0)
                  (cells-set f P_INARR 0))))
          (if (== id 13) (pfn-warn-set f 64))
          (if (== id 14)
            (if (== (cells-at f P_LASTNAME) 20)
              (if (== (cells-at f P_LASTNUM) 1)
                (cells-set f H_WMODE 1)
                (cells-set f H_WMODE 0))))
          (return 0)))
    (if (== kind 2)
      (do (cells-set f P_LASTNAME (pfn-match d (cells-at f P_S) (cells-at f P_E)))
          (comment "a glyph name as a bfchar destination is taken and ignored")
          (if (and (== sec 3) (== argc 1))
            (cells-set f P_ARGC 0))
          (return 0)))
    (if (== kind 3)
      (cells-set f P_LASTNUM (cells-at f P_NUM)))
    (comment "codespace ranges: two hex strings")
    (if (== sec 1)
      (do (if (== kind 1)
            (if (== argc 0)
              (do (cells-set f P_A1S (cells-at f P_S))
                  (cells-set f P_A1E (cells-at f P_E))
                  (cells-set f P_ARGC 1))
              (do (if (== (cells-at f P_CSOK) 1)
                    (pfn-cs-add f d (cells-at f P_A1S) (cells-at f P_A1E)
                                (cells-at f P_S) (cells-at f P_E)))
                  (cells-set f P_ARGC 0))))
          (return 0)))
    (comment "bfchar: source, then a hex destination (or a name, skipped)")
    (if (== sec 3)
      (do (if (== kind 1)
            (if (== argc 0)
              (do (cells-set f P_A1S (cells-at f P_S))
                  (cells-set f P_A1E (cells-at f P_E))
                  (cells-set f P_ARGC 1))
              (do (if (== mode 1)
                    (do (set lo (pfn-hex-val d (cells-at f P_A1S) (cells-at f P_A1E)))
                        (pfn-add-tu f d lo lo (cells-at f P_S) (cells-at f P_E))))
                  (cells-set f P_ARGC 0)))
            (if (== argc 1)
              (cells-set f P_ARGC 0)))
          (return 0)))
    (comment "bfrange: lo hi then a hex destination or an array of them")
    (if (== sec 5)
      (do (if (== (cells-at f P_INARR) 1)
            (do (if (== kind 1)
                  (do (set lo (+ (cells-at f P_LO) (cells-at f P_IDX)))
                      (if (and (== mode 1) (<= lo (cells-at f P_HI)))
                        (pfn-add-tu f d lo lo (cells-at f P_S) (cells-at f P_E)))
                      (cells-set f P_IDX (+ (cells-at f P_IDX) 1))))
                (if (== kind 6)
                  (do (cells-set f P_INARR 0)
                      (cells-set f P_ARGC 0))))
            (do (if (== kind 1)
                  (if (== argc 0)
                    (do (cells-set f P_A1S (cells-at f P_S))
                        (cells-set f P_A1E (cells-at f P_E))
                        (cells-set f P_ARGC 1))
                    (if (== argc 1)
                      (do (cells-set f P_A2S (cells-at f P_S))
                          (cells-set f P_A2E (cells-at f P_E))
                          (cells-set f P_ARGC 2))
                      (do (if (== mode 1)
                            (do (set lo (pfn-hex-val d (cells-at f P_A1S) (cells-at f P_A1E)))
                                (set hi (pfn-hex-val d (cells-at f P_A2S) (cells-at f P_A2E)))
                                (pfn-add-tu f d lo hi (cells-at f P_S) (cells-at f P_E))))
                          (cells-set f P_ARGC 0))))
                  (if (and (== kind 5) (== argc 2))
                    (do (cells-set f P_LO (pfn-hex-val d (cells-at f P_A1S) (cells-at f P_A1E)))
                        (cells-set f P_HI (pfn-hex-val d (cells-at f P_A2S) (cells-at f P_A2E)))
                        (cells-set f P_IDX 0)
                        (cells-set f P_INARR 1))))))
          (return 0)))
    (comment "cidrange: lo hi cid")
    (if (== sec 7)
      (do (if (== kind 1)
            (if (== argc 0)
              (do (cells-set f P_A1S (cells-at f P_S))
                  (cells-set f P_A1E (cells-at f P_E))
                  (cells-set f P_ARGC 1))
              (if (== argc 1)
                (do (cells-set f P_A2S (cells-at f P_S))
                    (cells-set f P_A2E (cells-at f P_E))
                    (cells-set f P_ARGC 2))))
            (if (and (== kind 3) (== argc 2))
              (do (if (== mode 2)
                    (do (set lo (pfn-hex-val d (cells-at f P_A1S) (cells-at f P_A1E)))
                        (set hi (pfn-hex-val d (cells-at f P_A2S) (cells-at f P_A2E)))
                        (pfn-add-val f lo hi (cells-at f P_NUM))))
                  (cells-set f P_ARGC 0))))
          (return 0)))
    (comment "cidchar: code cid")
    (if (== sec 9)
      (do (if (== kind 1)
            (do (cells-set f P_A1S (cells-at f P_S))
                (cells-set f P_A1E (cells-at f P_E))
                (cells-set f P_ARGC 1))
            (if (and (== kind 3) (== argc 1))
              (do (if (== mode 2)
                    (do (set lo (pfn-hex-val d (cells-at f P_A1S) (cells-at f P_A1E)))
                        (pfn-add-val f lo lo (cells-at f P_NUM))))
                  (cells-set f P_ARGC 0))))
          (return 0)))
    (return 0)))

(defn ^:pub ^I32 pfn-cmap [^:mut ^Cells f ^Blob d ^I32 mode]
  (comment "Parse a CMap program (decoded stream bytes). mode 1 (ToUnicode) reads")
  (comment "bfchar/bfrange into the ToUnicode table; mode 2 (an Encoding CMap)")
  (comment "reads cidchar/cidrange into the CID table and codespace ranges into the")
  (comment "font. Either way the records are appended to `f` from where it ends,")
  (comment "sorted, and the answer is their count; the caller records where they")
  (comment "start. Codespace ranges of a ToUnicode CMap are kept only when the font")
  (comment "has none yet. /WMode is read in both.")
  (let [^I32 start (cells-len f)
        ^:mut ^I32 kind 0
        ^:mut ^I32 stride TU_STRIDE]
    (cells-set f P_POS 0)
    (cells-set f P_SEC 0)
    (cells-set f P_ARGC 0)
    (cells-set f P_INARR 0)
    (cells-set f P_LASTNAME 0)
    (cells-set f P_LASTNUM 0)
    (cells-set f P_COUNT 0)
    (cells-set f P_MODE mode)
    (if (== mode 2)
      (do (cells-set f P_CSOK 1)
          (set stride VAL_STRIDE))
      (if (== (cells-at f H_NCS) 0)
        (cells-set f P_CSOK 1)
        (cells-set f P_CSOK 0)))
    (set kind (pfn-tok f d))
    (while (!= kind 0)
      (do (pfn-cmap-tok f d kind)
          (set kind (pfn-tok f d))))
    (pfn-finish f start (cells-at f P_COUNT) stride)
    (return (cells-at f P_COUNT))))

;; ------------------------------------------------------------- glyph names

(defn ^I32 pfn-agl-cmp [^Cells ar ^I32 nh ^I32 s ^I32 e ^I32 row]
  (comment "Compare the name's bytes [s, e) with glyph name `row`: -1, 0, 1.")
  (let [^I32 off (agl-at 0 row 0)
        ^I32 ln (agl-at 0 row 1)
        ^:mut ^I32 lim (- e s)
        ^:mut ^I32 j 0
        ^:mut ^I32 x 0
        ^:mut ^I32 y 0]
    (if (> lim ln) (set lim ln))
    (while (< j lim)
      (do (set x (pl-name-byte ar nh (+ s j)))
          (set y (agl-pool-at 0 (+ off j)))
          (if (< x y) (return -1))
          (if (> x y) (return 1))
          (set j (+ j 1))))
    (if (< (- e s) ln) (return -1))
    (if (> (- e s) ln) (return 1))
    (return 0)))

(defn ^I32 pfn-agl-find [^Cells ar ^I32 nh ^I32 s ^I32 e]
  (comment "The glyph id (row of the AGL table) of the name's bytes [s, e), or -1.")
  (let [^:mut ^I32 lo 0
        ^:mut ^I32 hi (- (agl-count 0) 1)
        ^:mut ^I32 mid 0
        ^:mut ^I32 c 0]
    (while (<= lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2)))
          (set c (pfn-agl-cmp ar nh s e mid))
          (if (== c 0) (return mid))
          (if (< c 0)
            (set hi (- mid 1))
            (set lo (+ mid 1)))))
    (return -1)))

(defn ^I32 pfn-name-gid [^Cells ar ^I32 nh]
  (comment "The glyph id of a name object, or -1: the whole name, else the part")
  (comment "before the first `.`.")
  (let [^I32 n (pl-name-len ar nh)
        ^:mut ^I32 g 0
        ^:mut ^I32 dot 0]
    (set g (pfn-agl-find ar nh 0 n))
    (if (>= g 0) (return g))
    (while (and (< dot n) (!= (pl-name-byte ar nh dot) 46))
      (set dot (+ dot 1)))
    (if (and (> dot 0) (< dot n))
      (return (pfn-agl-find ar nh 0 dot)))
    (return -1)))

(defn ^I32 pfn-all-hex [^Cells ar ^I32 nh ^I32 s ^I32 e]
  (let [^:mut ^I32 k s]
    (while (< k e)
      (do (if (< (pfn-hexv (pl-name-byte ar nh k)) 0) (return 0))
          (set k (+ k 1))))
    (return 1)))

(defn ^I32 pfn-name-hex [^Cells ar ^I32 nh ^I32 s ^I32 e]
  (let [^:mut ^I32 k s
        ^:mut ^I32 v 0]
    (while (< k e)
      (do (set v (+ (* v 16) (pfn-hexv (pl-name-byte ar nh k))))
          (set k (+ k 1))))
    (return v)))

(defn ^I32 pfn-gid-cps [^:mut ^Cells f ^I32 gid]
  (comment "Put glyph `gid`'s code points (AGL) in the answer registers.")
  (let [^I32 cnt (agl-at 0 gid 3)
        ^I32 off (agl-at 0 gid 2)
        ^:mut ^I32 i 0]
    (cells-set f H_TN 0)
    (while (< i cnt)
      (do (pfn-tmp-add f (agl-uni-at 0 (+ off i)))
          (set i (+ i 1))))
    (return cnt)))

(defn ^I32 pfn-component [^:mut ^Cells f ^Cells ar ^I32 nh ^I32 s ^I32 e ^I32 zapf]
  (comment "One `_`-separated component of a glyph name, appended to the answer:")
  (comment "an AGL name, `uniXXXX...` or `uXXXX`..`uXXXXXX`. The names a1..a206 are")
  (comment "ZapfDingbats' own (zapf 1); in any other font they are nothing.")
  (let [^I32 ln (- e s)
        ^I32 g (pfn-agl-find ar nh s e)
        ^:mut ^I32 i 0
        ^:mut ^I32 v 0
        ^:mut ^I32 c0 0
        ^:mut ^I32 c1 0
        ^:mut ^I32 c2 0]
    (if (<= ln 0) (return 0))
    (if (and (>= g 0) (and (== (agl-at 0 g 4) 1) (== zapf 0)))
      (return 0))
    (if (>= g 0)
      (do (set i 0)
          (while (< i (agl-at 0 g 3))
            (do (pfn-tmp-add f (agl-uni-at 0 (+ (agl-at 0 g 2) i)))
                (set i (+ i 1))))
          (return 1)))
    (set c0 (pl-name-byte ar nh s))
    (if (>= ln 7)
      (do (set c1 (pl-name-byte ar nh (+ s 1)))
          (set c2 (pl-name-byte ar nh (+ s 2)))
          (if (and (== c0 117) (and (== c1 110) (== c2 105)))
            (if (== (rem (- ln 3) 4) 0)
              (if (== (pfn-all-hex ar nh (+ s 3) e) 1)
                (do (set i (+ s 3))
                    (while (< i e)
                      (do (set v (pfn-name-hex ar nh i (+ i 4)))
                          (if (or (< v 55296) (> v 57343))
                            (pfn-tmp-add f v))
                          (set i (+ i 4))))
                    (return 1)))))))
    (if (and (== c0 117) (and (>= ln 5) (<= ln 7)))
      (if (== (pfn-all-hex ar nh (+ s 1) e) 1)
        (do (set v (pfn-name-hex ar nh (+ s 1) e))
            (if (and (<= v 1114111) (or (< v 55296) (> v 57343)))
              (pfn-tmp-add f v))
            (return 1))))
    (return 0)))

(defn ^I32 pfn-name-cps2 [^:mut ^Cells f ^Cells ar ^I32 nh ^I32 zapf]
  (comment "The Unicode value of a glyph NAME object by the AGL specification, into")
  (comment "the answer registers; answers the count of code points (0: none).")
  (let [^I32 n (pl-name-len ar nh)
        ^:mut ^I32 end 0
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0]
    (cells-set f H_TN 0)
    (while (and (< end n) (!= (pl-name-byte ar nh end) 46))
      (set end (+ end 1)))
    (if (== end 0) (return 0))
    (set s 0)
    (set k 0)
    (while (<= k end)
      (do (if (or (== k end) (== (pl-name-byte ar nh k) 95))
            (do (pfn-component f ar nh s k zapf)
                (set s (+ k 1))))
          (set k (+ k 1))))
    (return (cells-at f H_TN))))

(defn ^:pub ^I32 pfn-name-cps [^:mut ^Cells f ^Cells ar ^I32 nh]
  (comment "A glyph name's code points for a font that is not ZapfDingbats.")
  (return (pfn-name-cps2 f ar nh 0)))

(defn ^:pub ^I32 pfn-name-cps-zapf [^:mut ^Cells f ^Cells ar ^I32 nh]
  (comment "... and for ZapfDingbats, whose names a1..a206 are Unicode dingbats.")
  (return (pfn-name-cps2 f ar nh 1)))

;; ------------------------------------------------------------ standard 14

(defn ^I32 pfn-norm-at [^Cells ar ^I32 nh ^I32 from ^I32 want]
  (comment "The want-th letter or digit, lower-cased, of the name from index `from`")
  (comment "on (everything else skipped); -1 past the last.")
  (let [^I32 n (pl-name-len ar nh)
        ^:mut ^I32 k from
        ^:mut ^I32 idx 0
        ^:mut ^I32 c 0]
    (while (< k n)
      (do (set c (pl-name-byte ar nh k))
          (if (and (>= c 65) (<= c 90)) (set c (+ c 32)))
          (if (or (and (>= c 97) (<= c 122)) (and (>= c 48) (<= c 57)))
            (do (if (== idx want) (return c))
                (set idx (+ idx 1))))
          (set k (+ k 1))))
    (return -1)))

(defn ^I32 pfn-norm-len [^Cells ar ^I32 nh ^I32 from]
  (let [^:mut ^I32 cnt 0]
    (while (>= (pfn-norm-at ar nh from cnt) 0)
      (set cnt (+ cnt 1)))
    (return cnt)))

(defn ^I32 pfn-subset-prefix [^Cells ar ^I32 nh]
  (comment "7 when the name starts with a subset tag `ABCDEF+`, else 0.")
  (let [^:mut ^I32 k 0
        ^:mut ^I32 c 0]
    (if (< (pl-name-len ar nh) 8) (return 0))
    (if (!= (pl-name-byte ar nh 6) 43) (return 0))
    (while (< k 6)
      (do (set c (pl-name-byte ar nh k))
          (if (or (< c 65) (> c 90)) (return 0))
          (set k (+ k 1))))
    (return 7)))

(defn ^:pub ^I32 pfn-s14-of [^Cells ar ^I32 nh]
  (comment "Which of the fourteen standard fonts a BaseFont name means (0..13), or")
  (comment "-1. The subset tag, case, spaces, hyphens and commas do not count.")
  (let [^I32 from (pfn-subset-prefix ar nh)
        ^I32 nl (pfn-norm-len ar nh from)
        ^:mut ^I32 lo 0
        ^:mut ^I32 hi (- (s14-alias-count 0) 1)
        ^:mut ^I32 mid 0
        ^:mut ^I32 j 0
        ^:mut ^I32 x 0
        ^:mut ^I32 y 0
        ^:mut ^I32 lim 0
        ^:mut ^I32 cmp 0
        ^:mut ^I32 rl 0
        ^:mut ^I32 off 0]
    (if (== nl 0) (return -1))
    (while (<= lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2)))
          (set off (s14-alias-at 0 mid 0))
          (set rl (s14-alias-at 0 mid 1))
          (set lim nl)
          (if (> lim rl) (set lim rl))
          (set cmp 0)
          (set j 0)
          (while (and (== cmp 0) (< j lim))
            (do (set x (pfn-norm-at ar nh from j))
                (set y (s14-alias-pool-at 0 (+ off j)))
                (if (< x y) (set cmp -1))
                (if (> x y) (set cmp 1))
                (set j (+ j 1))))
          (if (== cmp 0)
            (do (if (< nl rl) (set cmp -1))
                (if (> nl rl) (set cmp 1))))
          (if (== cmp 0) (return (s14-alias-at 0 mid 2)))
          (if (< cmp 0)
            (set hi (- mid 1))
            (set lo (+ mid 1)))))
    (return -1)))

(defn ^I32 pfn-s14-width [^I32 font ^I32 gid]
  (comment "The AFM width of a glyph in a standard font, in hundredths of a unit, or -1.")
  (let [^I32 key (+ (* font 8192) gid)
        ^:mut ^I32 lo 0
        ^:mut ^I32 hi (- (s14-count 0) 1)
        ^:mut ^I32 mid 0
        ^:mut ^I32 kv 0]
    (if (< gid 0) (return -1))
    (while (<= lo hi)
      (do (set mid (+ lo (quot (- hi lo) 2)))
          (set kv (s14-at 0 mid 0))
          (if (== kv key) (return (* (s14-at 0 mid 1) 100)))
          (if (< key kv)
            (set hi (- mid 1))
            (set lo (+ mid 1)))))
    (return -1)))

;; ------------------------------------------------------------ simple fonts

(defn ^I32 pfn-entry-clear [^:mut ^Cells f ^I32 code]
  (let [^I32 at (+ SIMPLE_BASE (* code ENTRY))]
    (cells-set f at 0)
    (cells-set f (+ at 1) 0)
    (cells-set f (+ at 2) 0)
    (cells-set f (+ at 3) 0)
    (cells-set f (+ at 4) 5)
    (cells-set f (+ at 5) -2)
    (cells-set f (+ at 6) -1)
    (cells-set f (+ at 7) 0)
    (return 0)))

(defn ^I32 pfn-entry-put [^:mut ^Cells f ^I32 code ^I32 how]
  (comment "Store the answer registers as code's Unicode value, obtained `how`.")
  (let [^I32 at (+ SIMPLE_BASE (* code ENTRY))]
    (cells-set f at (cells-at f H_TN))
    (cells-set f (+ at 1) (cells-at f (+ H_T0 0)))
    (cells-set f (+ at 2) (cells-at f (+ H_T0 1)))
    (cells-set f (+ at 3) (cells-at f (+ H_T0 2)))
    (cells-set f (+ at 7) (cells-at f (+ H_T0 3)))
    (cells-set f (+ at 4) how)
    (return 0)))

(defn ^I32 pfn-enc-of-name [^Cells ar ^I32 h]
  (comment "0 Standard, 1 WinAnsi, 2 MacRoman, 5 MacExpert, -1 any other name.")
  (if (!= (pl-kind-of ar h) 4) (return -1))
  (if (== (pl-name-is ar h (pn-standard-encoding)) 1) (return 0))
  (if (== (pl-name-is ar h (pn-win-ansi-encoding)) 1) (return 1))
  (if (== (pl-name-is ar h (pn-mac-roman-encoding)) 1) (return 2))
  (if (== (pl-name-is ar h (pn-mac-expert-encoding)) 1) (return 5))
  (return -1))

(defn ^I32 pfn-isnum [^Cells ar ^I32 h]
  (if (== h 0) (return 0))
  (if (== (pl-kind-of ar h) 2) (return 1))
  (if (== (pl-kind-of ar h) 3) (return 1))
  (return 0))

(defn ^I32 pfn-micro [^Cells ar ^I32 h]
  (comment "A number times a million, saturating, for a FontMatrix entry. A real's")
  (comment "digit count is the cell `pl-ref-gen` reads (pdflex's record layout).")
  (let [^I32 kind (pl-kind-of ar h)
        ^:mut ^I32 m (pl-int-value ar h)
        ^:mut ^I32 sc (pl-ref-gen ar h)
        ^:mut ^I32 neg 0]
    (if (== kind 2)
      (do (if (> m 2000) (return 2000000000))
          (if (< m -2000) (return -2000000000))
          (return (* m 1000000))))
    (if (!= kind 3) (return 0))
    (if (< m 0) (do (set neg 1) (set m (- 0 m))))
    (while (> sc 6)
      (do (set m (quot (+ m 5) 10))
          (set sc (- sc 1))))
    (while (< sc 6)
      (do (if (> m 2000) (set m 2000))
          (set m (* m 10))
          (set sc (+ sc 1))))
    (if (== neg 1) (return (- 0 m)))
    (return m)))

(defn ^I32 pfn-round100 [^I32 cu]
  (comment "Hundredths to units, half away from zero.")
  (comment "The two ends are answered directly: cu + 50 overflowed for a saturated cu (P2.12, D107).")
  (if (> cu 2147483597) (return 21474836))
  (if (< cu -2147483597) (return -21474836))
  (if (< cu 0) (return (- 0 (quot (+ (- 0 cu) 50) 100))))
  (return (quot (+ cu 50) 100)))

(defn ^I32 pfn-descriptor [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                           ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f ^I32 fd]
  (comment "Flags, MissingWidth, Ascent and Descent (FontBBox when both are 0) from")
  (comment "a FontDescriptor.")
  (let [^I32 mw (pd-dget src ar dc a b st fd (pn-missing-width))
        ^I32 av (pd-dget src ar dc a b st fd (pn-ascent))
        ^I32 dv (pd-dget src ar dc a b st fd (pn-descent))
        ^I32 bb (pd-dget src ar dc a b st fd (pn-font-b-box))
        ^:mut ^I32 asc 0
        ^:mut ^I32 dsc 0
        ^:mut ^I32 el 0
        ^:mut ^I32 ev 0]
    (cells-set f H_FLAGS (pd-dint src ar dc a b st fd (pn-flags) 0))
    (if (== (pfn-isnum ar mw) 1)
      (cells-set f H_MISSING (pl-num-cp ar mw)))
    (if (== (pfn-isnum ar av) 1) (set asc (pfn-round100 (pl-num-cp ar av))))
    (if (== (pfn-isnum ar dv) 1) (set dsc (pfn-round100 (pl-num-cp ar dv))))
    (if (and (== asc 0) (== dsc 0))
      (if (and (!= bb 0) (== (pl-kind-of ar bb) 6))
        (do (set el (pl-first ar bb))
            (set el (pl-next ar el))
            (if (!= el 0)
              (do (set ev (pd-resolve src ar dc a b st el))
                  (if (== (pfn-isnum ar ev) 1)
                    (set dsc (pfn-round100 (pl-num-cp ar ev))))
                  (set el (pl-next ar el))
                  (set el (pl-next ar el))
                  (if (!= el 0)
                    (do (set ev (pd-resolve src ar dc a b st el))
                        (if (== (pfn-isnum ar ev) 1)
                          (set asc (pfn-round100 (pl-num-cp ar ev)))))))))))
    (if (> dsc 0) (set dsc (- 0 dsc)))
    (cells-set f H_ASC asc)
    (cells-set f H_DESC dsc)
    (return 0)))

(defn ^I32 pfn-scale-width [^Cells f ^I32 w]
  (comment "A Type 3 width in glyph space to hundredths of a thousandth em: times")
  (comment "the FontMatrix's a (millionths). Other fonts: unchanged.")
  (let [^I32 am (cells-at f H_T3SCALE)
        ^:mut ^I32 x w]
    (if (!= (cells-at f H_SUB) 4) (return w))
    (if (> x 2000000) (set x 2000000))
    (if (< x -2000000) (set x -2000000))
    (return (+ (* (quot x 1000) am) (quot (* (rem x 1000) am) 1000)))))

(defn ^I32 pfn-t3-bbox [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                        ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f ^I32 fh]
  (comment "A Type 3 font with no descriptor: its cell's height is its /FontBBox (glyph")
  (comment "space) times the FontMatrix, in thousandths of a text unit like every")
  (comment "other font's ascent and descent (P1.7 needs a glyph's box, D101).")
  (let [^I32 bb (pd-dget src ar dc a b st fh (pn-font-b-box))
        ^:mut ^I32 asc 0
        ^:mut ^I32 dsc 0
        ^:mut ^I32 el 0
        ^:mut ^I32 ev 0]
    (if (and (!= bb 0) (== (pl-kind-of ar bb) 6))
      (do (set el (pl-first ar bb))
          (set el (pl-next ar el))
          (if (!= el 0)
            (do (set ev (pd-resolve src ar dc a b st el))
                (if (== (pfn-isnum ar ev) 1)
                  (set dsc (pfn-round100 (pl-num-cp ar ev))))
                (set el (pl-next ar el))
                (set el (pl-next ar el))
                (if (!= el 0)
                  (do (set ev (pd-resolve src ar dc a b st el))
                      (if (== (pfn-isnum ar ev) 1)
                        (set asc (pfn-round100 (pl-num-cp ar ev))))))))))
    (if (> dsc 0) (set dsc (- 0 dsc)))
    (set asc (quot (pfn-scale-width f (* asc 100)) 100))
    (set dsc (quot (pfn-scale-width f (* dsc 100)) 100))
    (cells-set f H_ASC asc)
    (cells-set f H_DESC dsc)
    (return 0)))

(defn ^I32 pfn-load-widths [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                            ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f ^I32 fh]
  (comment "/FirstChar, /LastChar and /Widths of a simple font into the table.")
  (let [^I32 wa (pd-dget src ar dc a b st fh (pn-widths))
        ^I32 fc (pd-dint src ar dc a b st fh (pn-first-char) 0)
        ^:mut ^I32 code 0
        ^:mut ^I32 k 0
        ^:mut ^I32 w 0
        ^:mut ^I32 v 0]
    (cells-set f H_FIRST fc)
    (cells-set f H_LAST (pd-dint src ar dc a b st fh (pn-last-char) 255))
    (if (or (== wa 0) (!= (pl-kind-of ar wa) 6))
      (do (pfn-warn-set f 16) (return 0)))
    (set code fc)
    (set k (pl-first ar wa))
    (while (and (!= k 0) (<= code 255))
      (do (set v (pd-resolve src ar dc a b st k))
          (if (and (>= code 0) (== (pfn-isnum ar v) 1))
            (do (set w (pfn-scale-width f (pl-num-cp ar v)))
                (cells-set f (+ (+ SIMPLE_BASE (* code ENTRY)) 5) w)))
          (set code (+ code 1))
          (set k (pl-next ar k))))
    (return 0)))

(defn ^I32 pfn-width-fallbacks [^:mut ^Cells f]
  (comment "Codes /Widths does not cover: the standard font's AFM width, else")
  (comment "/MissingWidth, else -1.")
  (let [^I32 s14 (cells-at f H_S14)
        ^I32 mw (cells-at f H_MISSING)
        ^:mut ^I32 code 0
        ^:mut ^I32 at 0
        ^:mut ^I32 w 0]
    (while (< code 256)
      (do (set at (+ SIMPLE_BASE (* code ENTRY)))
          (if (== (cells-at f (+ at 5)) -2)
            (do (set w -1)
                (if (and (>= s14 0) (!= (cells-at f H_SUB) 4))
                  (set w (pfn-s14-width s14 (cells-at f (+ at 6)))))
                (if (and (< w 0) (>= mw 0))
                  (set w mw))
                (cells-set f (+ at 5) w)))
          (set code (+ code 1))))
    (return 0)))

(defn ^I32 pfn-apply-tounicode [^:mut ^Cells f ^I32 start ^I32 n]
  (comment "Override a simple font's entries with the ToUnicode table at start, n")
  (comment "records: a value that is not empty, U+0000 or U+FFFD wins.")
  (let [^:mut ^I32 code 0
        ^:mut ^I32 rec 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 ok 0]
    (while (< code 256)
      (do (set rec (pfn-find f start n TU_STRIDE code))
          (if (>= rec 0)
            (do (set cnt (pfn-tu-load f rec code))
                (set ok 1)
                (if (== cnt 0) (set ok 0))
                (if (and (== cnt 1) (or (== (cells-at f H_T0) 0) (== (cells-at f H_T0) 65533)))
                  (set ok 0))
                (if (== ok 1)
                  (pfn-entry-put f code 1))))
          (set code (+ code 1))))
    (return 0)))

;; ---------------------------------------------------------------- lookups

(defn ^I32 pfn-tu-load [^:mut ^Cells f ^I32 rec ^I32 code]
  (comment "Load ToUnicode record `rec`'s destination for `code` into the answer")
  (comment "registers: a range adds the code's offset to the last code point.")
  (let [^I32 cnt (cells-at f (+ rec 2))
        ^:mut ^I32 i 0]
    (cells-set f H_TN cnt)
    (while (< i 4)
      (do (cells-set f (+ H_T0 i) (cells-at f (+ rec (+ 4 i))))
          (set i (+ i 1))))
    (if (> cnt 0)
      (cells-set f (+ H_T0 (- cnt 1))
                 (+ (cells-at f (+ H_T0 (- cnt 1))) (- code (cells-at f rec)))))
    (return cnt)))

(defn ^:pub ^I32 pfn-cid [^Cells f ^I32 code]
  (comment "The CID of a code in a composite font: the code itself for Identity")
  (comment "and unsupported CMaps, else the embedded CMap's (0 when it has none).")
  (let [^:mut ^I32 rec 0]
    (if (!= (cells-at f H_KIND) 2) (return code))
    (if (and (>= (cells-at f H_COLL) 0) (or (== (cells-at f H_CMAP) 4) (== (cells-at f H_CMAP) 5)))
      (return (cjk-cid (cells-at f H_COLL) (cells-at f H_ROW) code)))
    (if (== (cells-at f H_CMAP) 2)
      (do (set rec (pfn-find f (cells-at f H_CID_START) (cells-at f H_CID_N) VAL_STRIDE code))
          (if (>= rec 0)
            (return (+ (cells-at f (+ rec 2)) (- code (cells-at f rec)))))
          (return 0)))
    (return code)))

(defn ^I32 pfn-sur-cp [^I32 code]
  (comment "The code point of a four-byte UTF-16 code (a surrogate pair; a first byte of 128")
  (comment "or more is a negative I32): 0 when the code is no pair.")
  (let [^I32 u (+ (+ code 1073741824) 1073741824)
        ^I32 hi (+ (quot u 65536) 32768)
        ^I32 lo (rem u 65536)]
    (if (>= code 0) (return 0))
    (if (< hi 55296) (return 0))
    (if (> hi 56319) (return 0))
    (if (< lo 56320) (return 0))
    (if (> lo 57343) (return 0))
    (return (+ 65536 (+ (* (- hi 55296) 1024) (- lo 56320))))))

(defn ^:pub ^I32 pfn-map [^:mut ^Cells f ^I32 code]
  (comment "The Unicode value of a character code: the number of code points")
  (comment "(0 when the font says nothing), which `pfn-cp` reads back, and how it")
  (comment "was obtained (`pfn-how-of`).")
  (let [^I32 kind (cells-at f H_KIND)
        ^:mut ^I32 at 0
        ^:mut ^I32 rec 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 cp 0]
    (cells-set f H_TN 0)
    (cells-set f H_HOW 5)
    (if (== kind 1)
      (do (if (or (< code 0) (> code 255)) (return 0))
          (set at (+ SIMPLE_BASE (* code ENTRY)))
          (cells-set f H_TN (cells-at f at))
          (cells-set f (+ H_T0 0) (cells-at f (+ at 1)))
          (cells-set f (+ H_T0 1) (cells-at f (+ at 2)))
          (cells-set f (+ H_T0 2) (cells-at f (+ at 3)))
          (cells-set f (+ H_T0 3) (cells-at f (+ at 7)))
          (cells-set f H_HOW (cells-at f (+ at 4)))
          (return (cells-at f at))))
    (if (== kind 2)
      (do (set rec (pfn-find f (cells-at f H_TU_START) (cells-at f H_TU_N) TU_STRIDE code))
          (if (>= rec 0)
            (do (set cnt (pfn-tu-load f rec code))
                (if (> cnt 0)
                  (do (cells-set f H_HOW 1)
                      (return cnt)))
                (cells-set f H_TN 0)))
          (if (== (cells-at f H_CMAP) 4)
            (do (set cp code)
                (if (< code 0) (set cp (pfn-sur-cp code)))
                (if (and (> cp 0) (and (<= cp 1114111) (or (< cp 55296) (> cp 57343))))
                  (do (cells-set f H_TN 1)
                      (cells-set f (+ H_T0 0) cp)
                      (cells-set f H_HOW 2)
                      (return 1)))))
          (comment "the Adobe collection's CID -> Unicode table (Identity-H with an Adobe-Japan1 font, a")
          (comment "predefined CMap's CIDs): what the CID is, by the collection's own table")
          (if (>= (cells-at f H_ORD) 0)
            (do (set cp (cjk-uni (cells-at f H_ORD) (pfn-cid f code)))
                (if (> cp 0)
                  (do (cells-set f H_TN 1)
                      (cells-set f (+ H_T0 0) cp)
                      (cells-set f H_HOW 4)
                      (return 1)))))
          (return 0)))
    (return 0)))

(defn ^:pub ^I32 pfn-width [^Cells f ^I32 code]
  (comment "The advance of a code in hundredths of a thousandth of an em, or -1")
  (comment "when the font says nothing (a simple font with no /Widths, no")
  (comment "/MissingWidth and no standard metrics).")
  (let [^:mut ^I32 rec 0
        ^:mut ^I32 cid 0
        ^:mut ^I32 w 0]
    (if (== (cells-at f H_KIND) 1)
      (do (if (or (< code 0) (> code 255)) (return -1))
          (set w (cells-at f (+ (+ SIMPLE_BASE (* code ENTRY)) 5)))
          (if (== w -2) (return -1))
          (return w)))
    (if (== (cells-at f H_KIND) 2)
      (do (set cid (pfn-cid f code))
          (set rec (pfn-find f (cells-at f H_W_START) (cells-at f H_W_N) VAL_STRIDE cid))
          (if (>= rec 0) (return (cells-at f (+ rec 2))))
          (return (cells-at f H_DW))))
    (return -1)))

(defn ^:pub ^I32 pfn-gid [^Cells f ^I32 code]
  (comment "A simple font's glyph id (an `emon.agl` row) for a code, -1 when the")
  (comment "encoding gives it no name.")
  (if (!= (cells-at f H_KIND) 1) (return -1))
  (if (or (< code 0) (> code 255)) (return -1))
  (return (cells-at f (+ (+ SIMPLE_BASE (* code ENTRY)) 6))))

;; ------------------------------------------------------------------ loading

(defn ^I32 pfn-load-tounicode [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                               ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                               ^:mut ^Cells out ^I32 fh]
  (comment "Read the font's /ToUnicode stream into a table at the end of `f`:")
  (comment "H_TU_START and H_TU_N say where. 1 when a stream was read.")
  (let [^I32 tu (pd-dget src ar dc a b st fh (pn-to-unicode))
        ^:mut ^I32 tun 0
        ^:mut ^I32 ps 0]
    (cells-set f H_TU_START (cells-len f))
    (cells-set f H_TU_N 0)
    (if (== tu 0) (return 0))
    (if (!= (pl-kind-of ar tu) 8) (return 0))
    (set ps (pd-stream-data src ar dc a b st tu out))
    (if (!= ps 0) (pfn-warn-set f 2))
    (set tun (pfn-cmap f (cells-bytes out) 1))
    (cells-set f H_TU_N tun)
    (cells-set f H_HASTU 1)
    (return 1)))

(defn ^I32 pfn-fill-macexpert [^:mut ^Cells f]
  (comment "MacExpertEncoding as TEXT (`emon.fontextra`, `fold-expert`): the small capitals, old-style")
  (comment "figures and superiors mean the characters they are variants of, not Adobe's private")
  (comment "use area code points the AGL gives them.")
  (let [^:mut ^I32 code 0
        ^:mut ^I32 c0 0
        ^:mut ^I32 c1 0]
    (while (< code 256)
      (do (set c0 (mac-expert-cp-at 0 code 0))
          (set c1 (mac-expert-cp-at 0 code 1))
          (if (>= c0 0)
            (do (cells-set f H_TN 1)
                (cells-set f (+ H_T0 0) c0)
                (if (> c1 0)
                  (do (cells-set f H_TN 2)
                      (cells-set f (+ H_T0 1) c1)))
                (pfn-entry-put f code 2)))
          (set code (+ code 1))))
    (return 0)))

(defn ^I32 pfn-font-stream [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                            ^:mut ^Cells b ^:mut ^Cells st ^I32 fd]
  (comment "The embedded font program stream of a FontDescriptor (FontFile, FontFile2 or")
  (comment "FontFile3), 0 when it has none.")
  (let [^:mut ^I32 v (px-dget src ar dc a b st fd (px-font-file))]
    (if (and (!= v 0) (== (pl-kind-of ar v) 8)) (return v))
    (set v (px-dget src ar dc a b st fd (px-font-file2)))
    (if (and (!= v 0) (== (pl-kind-of ar v) 8)) (return v))
    (set v (px-dget src ar dc a b st fd (px-font-file3)))
    (if (and (!= v 0) (== (pl-kind-of ar v) 8)) (return v))
    (return 0)))

(defn ^I32 pfn-apply-program [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                              ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                              ^:mut ^Cells out ^I32 pstm ^I32 zapf]
  (comment "Decode the font program stream and let it say what its codes are (`emon.fontprog`):")
  (comment "its built-in encoding replaces the base encoding wherever it names a glyph.")
  (let [^I32 tbl (cells-len f)
        ^I32 sz (fp-table-size)
        ^:mut ^I32 i 0
        ^:mut ^I32 n 0
        ^:mut ^I32 ps 0
        ^:mut ^I32 at 0
        ^:mut ^I32 code 0
        ^:mut ^I32 w 0]
    (set ps (pd-stream-data src ar dc a b st pstm out))
    (if (!= ps 0) (pfn-warn-set f 2048))
    (while (< i sz)
      (do (cells-push f 0)
          (set i (+ i 1))))
    (set n (fp-simple f H_TN tbl (cells-bytes out) zapf))
    (if (< n 0) (pfn-warn-set f 2048))
    (if (>= n 0)
      (do (set code 0)
          (while (< code 256)
            (do (set at (+ tbl (* code 6)))
                (comment "a program that NAMES its glyphs (Type 1, CFF) and gives this code no Unicode name")
                (comment "(`G12`, `a30`) has said what the code is not: the guess made without it goes")
                (if (and (== (cells-at f at) 0) (and (== (fp-kind f tbl) 1)
                         (== (cells-at f (+ (+ SIMPLE_BASE (* code ENTRY)) 4)) 5)))
                  (pfn-entry-clear f code))
                (if (> (cells-at f at) 0)
                  (do (cells-set f H_TN (cells-at f at))
                      (cells-set f (+ H_T0 0) (cells-at f (+ at 1)))
                      (cells-set f (+ H_T0 1) (cells-at f (+ at 2)))
                      (cells-set f (+ H_T0 2) (cells-at f (+ at 3)))
                      (cells-set f (+ H_T0 3) (cells-at f (+ at 4)))
                      (pfn-entry-put f code (cells-at f (+ at 5)))
                      (cells-set f (+ (+ SIMPLE_BASE (* code ENTRY)) 6) -1)))
                (set code (+ code 1))))
          (comment "a program that names its glyphs knows the built-in encoding: it is no longer a guess (a")
          (comment "TrueType font's cmap leaves the codes it does not cover to the guess)")
          (set w (cells-at f H_WARN))
          (if (and (== (fp-kind f tbl) 1) (== (rem (quot w 256) 2) 1))
            (cells-set f H_WARN (- w 256)))))
    (cells-drop f tbl)
    (cells-set f H_PROGHOW (+ n 1))
    (return n)))

(defn ^I32 pfn-count-known [^Cells f]
  (comment "How many of a simple font's codes have a value that is not a guess.")
  (let [^:mut ^I32 code 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 at 0]
    (while (< code 256)
      (do (set at (+ SIMPLE_BASE (* code ENTRY)))
          (if (and (> (cells-at f at) 0) (!= (cells-at f (+ at 4)) 5))
            (set cnt (+ cnt 1)))
          (set code (+ code 1))))
    (return cnt)))

(defn ^I32 pfn-load-simple [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                            ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                            ^:mut ^Cells out ^I32 fh ^I32 sub]
  (let [^I32 fd (pd-dget src ar dc a b st fh (pn-font-descriptor))
        ^I32 bf (pd-dget src ar dc a b st fh (pn-base-font))
        ^I32 enc (pd-dget src ar dc a b st fh (pn-encoding))
        ^:mut ^I32 code 0
        ^:mut ^I32 base -1
        ^:mut ^I32 guess 0
        ^:mut ^I32 diffs 0
        ^:mut ^I32 bn 0
        ^:mut ^I32 gid 0
        ^:mut ^I32 flags 0
        ^:mut ^I32 k 0
        ^:mut ^I32 ev 0
        ^:mut ^I32 tustart 0
        ^:mut ^I32 tun 0
        ^:mut ^I32 ncp 0
        ^:mut ^I32 given 0
        ^:mut ^I32 pstm 0
        ^:mut ^I32 zapfnames 0]
    (cells-set f H_KIND 1)
    (cells-set f H_SUB sub)
    (if (and (!= bf 0) (== (pl-kind-of ar bf) 4))
      (cells-set f H_S14 (pfn-s14-of ar bf)))
    (if (!= fd 0)
      (pfn-descriptor src ar dc a b st f fd))
    (set flags (cells-at f H_FLAGS))
    (if (== (cells-at f H_S14) 13) (set zapfnames 1))
    (if (and (== (cells-at f H_ASC) 0) (>= (cells-at f H_S14) 0))
      (do (cells-set f H_ASC (s14-metric-at 0 (cells-at f H_S14) 0))
          (cells-set f H_DESC (s14-metric-at 0 (cells-at f H_S14) 1))))
    (comment "the table, empty")
    (set code 0)
    (while (< code 256)
      (do (cells-push f 0) (cells-push f 0) (cells-push f 0) (cells-push f 0)
          (cells-push f 0) (cells-push f 0) (cells-push f 0) (cells-push f 0)
          (pfn-entry-clear f code)
          (set code (+ code 1))))
    (comment "the base encoding")
    (if (and (!= enc 0) (== (pl-kind-of ar enc) 4))
      (set base (pfn-enc-of-name ar enc)))
    (if (and (!= enc 0) (== (pl-kind-of ar enc) 7))
      (do (set bn (pd-dget src ar dc a b st enc (pn-base-encoding)))
          (if (!= bn 0) (set base (pfn-enc-of-name ar bn)))
          (set diffs (pd-dget src ar dc a b st enc (pn-differences)))))
    (if (and (== base -1) (and (!= enc 0) (== (pl-kind-of ar enc) 4)))
      (do (pfn-warn-set f 8) (set base 0) (set guess 1)))
    (if (== base -1)
      (do (if (== (cells-at f H_S14) 12) (set base 3))
          (if (== (cells-at f H_S14) 13) (set base 4))))
    (comment "an encoding the PDF names (or Symbol, ZapfDingbats): the font program's own is not asked")
    (if (and (>= base 0) (== guess 0)) (set given 1))
    (if (and (== base -1) (!= sub 4))
      (do (set base 0)
          (if (and (== sub 3) (== enc 0)) (set base 1))
          (if (and (== (rem (quot flags 4) 2) 1) (== (rem (quot flags 32) 2) 0))
            (do (set guess 1)
                (pfn-warn-set f 256)))))
    (cells-set f H_ENC base)
    (if (== base 5) (pfn-fill-macexpert f))
    (if (and (>= base 0) (< base 5))
      (do (set code 0)
          (while (< code 256)
            (do (set gid (enc-gid-at 0 (+ (* base 256) code)))
                (cells-set f (+ (+ SIMPLE_BASE (* code ENTRY)) 6) gid)
                (if (>= gid 0)
                  (do (set ncp (pfn-gid-cps f gid))
                      (if (and (> ncp 0) (== guess 0))
                        (pfn-entry-put f code 2)
                        (pfn-entry-put f code 5))))
                (set code (+ code 1))))))
    (comment "no encoding named: the font program's built-in encoding (a Type 1 /Encoding, a CFF")
    (comment "Encoding, a symbolic TrueType font's cmap), before /Differences, which still win")
    (if (and (== given 0) (and (!= sub 4) (!= fd 0)))
      (do (set pstm (pfn-font-stream src ar dc a b st fd))
          (if (!= pstm 0)
            (if (or (!= sub 3) (and (== (rem (quot flags 4) 2) 1) (== (rem (quot flags 32) 2) 0)))
              (pfn-apply-program src ar dc a b st f out pstm zapfnames)))))
    (comment "/Differences: a number sets the code, each name after it takes the next")
    (if (and (!= diffs 0) (== (pl-kind-of ar diffs) 6))
      (do (set code 0)
          (set k (pl-first ar diffs))
          (while (!= k 0)
            (do (set ev (pd-resolve src ar dc a b st k))
                (if (and (!= ev 0) (== (pl-kind-of ar ev) 2))
                  (set code (pl-int-value ar ev)))
                (if (and (!= ev 0) (== (pl-kind-of ar ev) 4))
                  (do (if (and (>= code 0) (<= code 255))
                        (do (set ncp (pfn-name-cps2 f ar ev zapfnames))
                            (cells-set f (+ (+ SIMPLE_BASE (* code ENTRY)) 6) (pfn-name-gid ar ev))
                            (if (> ncp 0)
                              (pfn-entry-put f code 3)
                              (pfn-entry-put f code 5))))
                      (comment "a code past 255 names nothing, and 2^31-1 + 1 must not wrap (P10.5, D701)")
                      (if (< code 2147483647) (set code (+ code 1)))))
                (set k (pl-next ar k))))))
    (comment "ToUnicode wins where it says something")
    (if (== (pfn-load-tounicode src ar dc a b st f out fh) 1)
      (do (set tustart (cells-at f H_TU_START))
          (set tun (cells-at f H_TU_N))
          (pfn-apply-tounicode f tustart tun)
          (cells-drop f tustart)
          (cells-set f H_TU_N 0)))
    (comment "Type 3: the FontMatrix's a scales the widths")
    (if (== sub 4)
      (do (set ev (pd-dget src ar dc a b st fh (pn-font-matrix)))
          (if (and (!= ev 0) (== (pl-kind-of ar ev) 6))
            (do (set k (pl-first ar ev))
                (set ev (pd-resolve src ar dc a b st k))
                (if (== (pfn-isnum ar ev) 1)
                  (cells-set f H_T3SCALE (pfn-micro ar ev)))))
          (if (and (== (cells-at f H_ASC) 0) (== (cells-at f H_DESC) 0))
            (pfn-t3-bbox src ar dc a b st f fh))))
    (pfn-load-widths src ar dc a b st f fh)
    (pfn-width-fallbacks f)
    (if (== (pfn-count-known f) 0) (pfn-warn-set f 1024))
    (return 0)))

;; --------------------------------------------------------- composite fonts

(defn ^I32 pfn-parse-w [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                        ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f ^I32 wa]
  (comment "A /W array: `c [w1 w2 ...]` and `c1 c2 w`, into the width table at the")
  (comment "end of `f`.")
  (let [^:mut ^I32 k (pl-first ar wa)
        ^:mut ^I32 k2 0
        ^:mut ^I32 k3 0
        ^:mut ^I32 v1 0
        ^:mut ^I32 v2 0
        ^:mut ^I32 v3 0
        ^:mut ^I32 j 0
        ^:mut ^I32 c1 0
        ^:mut ^I32 el 0
        ^:mut ^I32 ev 0]
    (cells-set f H_W_START (cells-len f))
    (cells-set f P_COUNT 0)
    (while (!= k 0)
      (do (set v1 (pd-resolve src ar dc a b st k))
          (set k2 (pl-next ar k))
          (if (== k2 0)
            (set k 0)
            (do (set c1 (pl-int-value ar v1))
                (if (!= (pfn-isnum ar v1) 1) (set c1 -1))
                (set v2 (pd-resolve src ar dc a b st k2))
                (if (and (!= v2 0) (== (pl-kind-of ar v2) 6))
                  (do (set j 0)
                      (set el (pl-first ar v2))
                      (while (!= el 0)
                        (do (set ev (pd-resolve src ar dc a b st el))
                            (if (== (pfn-isnum ar ev) 1)
                              (pfn-add-val f (pfn-sat c1 j) (pfn-sat c1 j) (pl-num-cp ar ev)))
                            (set j (+ j 1))
                            (set el (pl-next ar el))))
                      (set k (pl-next ar k2)))
                  (do (set k3 (pl-next ar k2))
                      (if (== k3 0)
                        (set k 0)
                        (do (set v3 (pd-resolve src ar dc a b st k3))
                            (if (and (== (pfn-isnum ar v2) 1) (== (pfn-isnum ar v3) 1))
                              (pfn-add-val f c1 (pl-int-value ar v2) (pl-num-cp ar v3)))
                            (set k (pl-next ar k3))))))))))
    (cells-set f H_W_N (cells-at f P_COUNT))
    (pfn-finish f (cells-at f H_W_START) (cells-at f H_W_N) VAL_STRIDE)
    (return 0)))

(defn ^I32 pfn-name-at [^Cells ar ^I32 nh ^I32 i]
  (if (< i 0) (return -1))
  (if (>= i (pl-name-len ar nh)) (return -1))
  (return (pl-name-byte ar nh i)))

(defn ^I32 pfn-name-has [^Cells ar ^I32 nh ^I32 c0 ^I32 c1 ^I32 c2 ^I32 c3 ^I32 c4]
  (comment "1 when the name contains the bytes c0 c1 c2 c3 (c4 too when it is")
  (comment ">= 0) in a row; c3 < 0 means three bytes.")
  (let [^I32 n (pl-name-len ar nh)
        ^:mut ^I32 k 0]
    (while (< k n)
      (do (if (and (== (pfn-name-at ar nh k) c0)
                   (and (== (pfn-name-at ar nh (+ k 1)) c1)
                        (== (pfn-name-at ar nh (+ k 2)) c2)))
            (if (or (< c3 0)
                    (and (== (pfn-name-at ar nh (+ k 3)) c3)
                         (or (< c4 0) (== (pfn-name-at ar nh (+ k 4)) c4))))
              (return 1)))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 pfn-encoding-cmap [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                              ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                              ^:mut ^Cells out ^I32 enc]
  (comment "A composite font's /Encoding: a name (Identity-H/V, a predefined")
  (comment "Unicode CMap, another predefined CMap we cannot read) or an embedded")
  (comment "CMap stream.")
  (let [^:mut ^I32 ps 0
        ^:mut ^I32 n 0
        ^:mut ^I32 vert 0
        ^:mut ^I32 hit -1
        ^:mut ^I32 coll 0
        ^:mut ^I32 row 0
        ^:mut ^I32 k 0
        ^:mut ^I32 at 0]
    (if (== enc 0)
      (do (cells-set f H_CMAP 1)
          (pfn-cs-put f 2 0 0 0 65535)
          (return 0)))
    (if (== (pl-kind-of ar enc) 8)
      (do (cells-set f H_CMAP 2)
          (cells-set f H_CID_START (cells-len f))
          (set ps (pd-stream-data src ar dc a b st enc out))
          (if (!= ps 0) (pfn-warn-set f 512))
          (set n (pfn-cmap f (cells-bytes out) 2))
          (cells-set f H_CID_N n)
          (return 0)))
    (if (!= (pl-kind-of ar enc) 4) (return 0))
    (cells-set f H_CMAP 1)
    (if (== (pl-name-is ar enc (pn-identity-h)) 1)
      (do (pfn-cs-put f 2 0 0 0 65535)
          (return 0)))
    (if (== (pl-name-is ar enc (pn-identity-v)) 1)
      (do (cells-set f H_WMODE 1)
          (pfn-cs-put f 2 0 0 0 65535)
          (return 0)))
    (set n (pl-name-len ar enc))
    (if (and (> n 2) (== (pl-name-byte ar enc (- n 1)) 86))
      (if (== (pl-name-byte ar enc (- n 2)) 45) (set vert 1)))
    (cells-set f H_WMODE vert)
    (comment "a predefined CMap whose tables we have (`emon.cjk`): codespace, CIDs, and the")
    (comment "collection the CIDs belong to; `Uni*-UCS2/UTF16` codes are Unicode as well")
    (set hit (cjk-find-name ar enc))
    (if (>= hit 0)
      (do (set coll (quot hit 1000))
          (set row (rem hit 1000))
          (cells-set f H_COLL coll)
          (cells-set f H_ROW row)
          (cells-set f H_ORD coll)
          (cells-set f H_WMODE (cjk-cmap-field coll row 3))
          (set k 0)
          (while (< k (cjk-cmap-field coll row 5))
            (do (set at (+ (cjk-cmap-field coll row 4) k))
                (pfn-cs-put f (cjk-cs coll at 0) (cjk-cs coll at 1) (cjk-cs coll at 2)
                            (cjk-cs coll at 3) (cjk-cs coll at 4))
                (set k (+ k 1))))
          (cells-set f H_CMAP 5)
          (if (and (== (pfn-name-at ar enc 0) 85)
                   (and (== (pfn-name-at ar enc 1) 110) (== (pfn-name-at ar enc 2) 105)))
            (if (or (== (pfn-name-has ar enc 85 67 83 50 -1) 1) (== (pfn-name-has ar enc 85 84 70 49 54) 1))
              (cells-set f H_CMAP 4)))
          (return 0)))
    (comment "Uni*-UCS2-* and Uni*-UTF16-*: the code is the Unicode value")
    (if (and (== (pfn-name-at ar enc 0) 85)
             (and (== (pfn-name-at ar enc 1) 110) (== (pfn-name-at ar enc 2) 105)))
      (do (if (== (pfn-name-has ar enc 85 67 83 50 -1) 1)
            (do (cells-set f H_CMAP 4)
                (pfn-warn-set f 1)
                (pfn-cs-put f 2 0 0 0 65535)
                (return 0)))
          (if (== (pfn-name-has ar enc 85 84 70 49 54) 1)
            (do (cells-set f H_CMAP 4)
                (pfn-warn-set f 1)
                (pfn-cs-put f 2 0 0 0 55295)
                (pfn-cs-put f 2 0 57344 0 65535)
                (pfn-cs-put f 4 55296 56320 56319 57343)
                (return 0)))))
    (cells-set f H_CMAP 3)
    (pfn-warn-set f 1)
    (return 0)))

(defn ^I32 pfn-ordering-coll [^Cells ar ^I32 sh]
  (comment "The Adobe collection a CIDSystemInfo /Ordering string names: 0 Japan1, 1 GB1, 2 CNS1,")
  (comment "3 Korea1, -1 anything else (Identity, or a foundry's own).")
  (let [^I32 n (px-blen ar sh)]
    (if (and (== n 6) (and (== (px-bat ar sh 0) 74) (and (== (px-bat ar sh 1) 97)
                       (and (== (px-bat ar sh 2) 112) (and (== (px-bat ar sh 3) 97)
                            (and (== (px-bat ar sh 4) 110) (== (px-bat ar sh 5) 49)))))))
      (return 0))
    (if (and (== n 3) (and (== (px-bat ar sh 0) 71) (and (== (px-bat ar sh 1) 66) (== (px-bat ar sh 2) 49))))
      (return 1))
    (if (and (== n 4) (and (== (px-bat ar sh 0) 67) (and (== (px-bat ar sh 1) 78)
                            (and (== (px-bat ar sh 2) 83) (== (px-bat ar sh 3) 49)))))
      (return 2))
    (if (and (== n 6) (and (== (px-bat ar sh 0) 75) (and (== (px-bat ar sh 1) 111)
                       (and (== (px-bat ar sh 2) 114) (and (== (px-bat ar sh 3) 101)
                            (and (== (px-bat ar sh 4) 97) (== (px-bat ar sh 5) 49)))))))
      (return 3))
    (return -1)))

(defn ^I32 pfn-composite-mapped [^Cells f]
  (comment "1 when something in the font can say what a code is: a ToUnicode CMap with entries, a")
  (comment "Unicode CMap name, or an Adobe collection's CID table.")
  (if (> (cells-at f H_TU_N) 0) (return 1))
  (if (== (cells-at f H_CMAP) 4) (return 1))
  (if (>= (cells-at f H_ORD) 0) (return 1))
  (return 0))

(defn ^I32 pfn-add-w2 [^:mut ^Cells f ^I32 lo ^I32 hi ^I32 w1 ^I32 vx ^I32 vy]
  (if (< lo 0) (return 0))
  (if (< hi lo) (return 0))
  (if (>= (cells-at f P_COUNT) CM_MAX)
    (do (pfn-warn-set f 4) (return 0)))
  (let [^I32 seq (cells-at f H_SEQ)]
    (cells-set f H_SEQ (+ seq 1))
    (cells-set f P_COUNT (+ (cells-at f P_COUNT) 1))
    (cells-push f lo)
    (cells-push f hi)
    (cells-push f w1)
    (cells-push f seq)
    (cells-push f vx)
    (cells-push f vy)
    (cells-push f 0)
    (return 1)))

(defn ^I32 pfn-num-or-zero [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                            ^:mut ^Cells b ^:mut ^Cells st ^I32 el]
  (comment "The number (hundredths) an array element is, 0 when it is none.")
  (let [^I32 ev (pd-resolve src ar dc a b st el)]
    (if (== (pfn-isnum ar ev) 1) (return (pl-num-cp ar ev)))
    (return 0)))

(defn ^I32 pfn-parse-w2 [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                         ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f ^I32 wa]
  (comment "A /W2 array: `c [w1 vx vy ...]` and `c1 c2 w1 vx vy`, into the table at the end of `f`")
  (comment "(vertical metrics, ISO 32000-1 9.7.4.3: the advance, then the position vector).")
  (let [^:mut ^I32 k (pl-first ar wa)
        ^:mut ^I32 k2 0
        ^:mut ^I32 v1 0
        ^:mut ^I32 v2 0
        ^:mut ^I32 el 0
        ^:mut ^I32 j 0
        ^:mut ^I32 c1 0
        ^:mut ^I32 x0 0
        ^:mut ^I32 x1 0
        ^:mut ^I32 x2 0
        ^:mut ^I32 e1 0
        ^:mut ^I32 e2 0]
    (cells-set f P_COUNT 0)
    (while (!= k 0)
      (do (set v1 (pd-resolve src ar dc a b st k))
          (set k2 (pl-next ar k))
          (if (== k2 0)
            (set k 0)
            (do (set c1 -1)
                (if (== (pfn-isnum ar v1) 1) (set c1 (pl-int-value ar v1)))
                (set v2 (pd-resolve src ar dc a b st k2))
                (if (and (!= v2 0) (== (pl-kind-of ar v2) 6))
                  (do (set j 0)
                      (set el (pl-first ar v2))
                      (while (!= el 0)
                        (do (set e1 (pl-next ar el))
                            (set e2 0)
                            (if (!= e1 0) (set e2 (pl-next ar e1)))
                            (if (== e2 0)
                              (set el 0)
                              (do (pfn-add-w2 f (pfn-sat c1 j) (pfn-sat c1 j)
                                              (pfn-num-or-zero src ar dc a b st el)
                                              (pfn-num-or-zero src ar dc a b st e1)
                                              (pfn-num-or-zero src ar dc a b st e2))
                                  (set j (+ j 1))
                                  (set el (pl-next ar e2))))))
                      (set k (pl-next ar k2)))
                  (do (comment "c1 c2 w1 vx vy")
                      (set x0 (pl-next ar k2))
                      (set x1 0)
                      (set x2 0)
                      (if (!= x0 0) (set x1 (pl-next ar x0)))
                      (if (!= x1 0) (set x2 (pl-next ar x1)))
                      (if (== x2 0)
                        (set k 0)
                        (do (if (and (== (pfn-isnum ar v1) 1) (== (pfn-isnum ar v2) 1))
                              (pfn-add-w2 f c1 (pl-int-value ar v2)
                                          (pfn-num-or-zero src ar dc a b st x0)
                                          (pfn-num-or-zero src ar dc a b st x1)
                                          (pfn-num-or-zero src ar dc a b st x2)))
                            (set k (pl-next ar x2))))))))))
    (cells-set f H_W2_N (cells-at f P_COUNT))
    (pfn-finish f (cells-at f H_W2_START) (cells-at f H_W2_N) W2_STRIDE)
    (return 0)))

(defn ^:pub ^I32 pfn-vertical-metric [^Cells f ^I32 code ^I32 which]
  (comment "A composite font's vertical metrics of a code, in hundredths of a thousandth of an em")
  (comment "(like widths): which 0 the vertical advance w1 (DW2's second number by default, -1000),")
  (comment "1 the position vector's x (half the width by default), 2 its y (DW2's first number, 880).")
  (let [^I32 cid (pfn-cid f code)
        ^I32 rec (pfn-find f (cells-at f H_W2_START) (cells-at f H_W2_N) W2_STRIDE cid)]
    (if (>= rec 0)
      (do (if (== which 0) (return (cells-at f (+ rec 2))))
          (if (== which 1) (return (cells-at f (+ rec 4))))
          (return (cells-at f (+ rec 5)))))
    (if (== which 0) (return (cells-at f H_DW2W)))
    (if (== which 2) (return (cells-at f H_DW2V)))
    (return (quot (pfn-width f code) 2))))

(defn ^I32 pfn-load-composite [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                               ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                               ^:mut ^Cells out ^I32 fh]
  (let [^I32 da (pd-dget src ar dc a b st fh (pn-descendant-fonts))
        ^I32 enc (pd-dget src ar dc a b st fh (pn-encoding))
        ^:mut ^I32 dd 0
        ^:mut ^I32 fd 0
        ^:mut ^I32 dwv 0
        ^:mut ^I32 d2 0
        ^:mut ^I32 d2e 0
        ^:mut ^I32 wa 0
        ^:mut ^I32 d2f 0
        ^:mut ^I32 dfirst 0
        ^:mut ^I32 d2v 0
        ^:mut ^I32 w2a 0
        ^:mut ^I32 csi 0
        ^:mut ^I32 ord 0
        ^:mut ^I32 oc -1]
    (cells-set f H_KIND 2)
    (cells-set f H_SUB 5)
    (if (and (!= da 0) (== (pl-kind-of ar da) 6))
      (do (set dfirst (pl-first ar da))
          (set dd (pd-resolve src ar dc a b st dfirst))))
    (if (and (!= dd 0) (!= (pl-kind-of ar dd) 7)) (set dd 0))
    (if (== dd 0)
      (pfn-warn-set f 32)
      (do (set fd (pd-dget src ar dc a b st dd (pn-font-descriptor)))
          (if (!= fd 0) (pfn-descriptor src ar dc a b st f fd))
          (set dwv (pd-dget src ar dc a b st dd (pn-dw)))
          (if (== (pfn-isnum ar dwv) 1)
            (cells-set f H_DW (pl-num-cp ar dwv)))
          (set d2 (pd-dget src ar dc a b st dd (pn-dw2)))
          (if (and (!= d2 0) (== (pl-kind-of ar d2) 6))
            (do (set d2f (pl-first ar d2))
                (set d2e (pd-resolve src ar dc a b st d2f))
                (if (== (pfn-isnum ar d2e) 1)
                  (cells-set f H_DW2V (pl-num-cp ar d2e)))
                (set d2e (pl-next ar d2f))
                (if (!= d2e 0)
                  (do (set d2v (pd-resolve src ar dc a b st d2e))
                      (if (== (pfn-isnum ar d2v) 1)
                        (cells-set f H_DW2W (pl-num-cp ar d2v)))))))
          (set wa (pd-dget src ar dc a b st dd (pn-w)))
          (set w2a (px-dget src ar dc a b st dd (px-w2)))
          (set csi (pd-dget src ar dc a b st dd (pn-cid-system-info)))
          (if (and (!= csi 0) (== (pl-kind-of ar csi) 7))
            (do (set ord (pd-dget src ar dc a b st csi (pn-ordering)))
                (if (and (!= ord 0) (== (pl-kind-of ar ord) 5))
                  (set oc (pfn-ordering-coll ar ord)))))))
    (pfn-encoding-cmap src ar dc a b st f out enc)
    (comment "the CIDSystemInfo says which Adobe collection the CIDs are; when it names none, none")
    (if (and (!= ord 0) (== (pl-kind-of ar ord) 5)) (cells-set f H_ORD oc))
    (pfn-load-tounicode src ar dc a b st f out fh)
    (if (== (cells-at f H_NCS) 0)
      (pfn-cs-put f 2 0 0 0 65535))
    (if (and (!= wa 0) (== (pl-kind-of ar wa) 6))
      (pfn-parse-w src ar dc a b st f wa))
    (cells-set f H_W2_START (cells-len f))
    (cells-set f H_W2_N 0)
    (if (and (!= w2a 0) (== (pl-kind-of ar w2a) 6))
      (pfn-parse-w2 src ar dc a b st f w2a))
    (if (== (pfn-composite-mapped f) 0) (pfn-warn-set f 1024))
    (return 0)))

(defn ^:pub ^I32 pfn-from-cmap [^:mut ^Cells f ^Blob data ^I32 mode]
  (comment "A composite font made from one CMap program alone (decoded bytes): mode")
  (comment "1 a ToUnicode CMap (codes -> Unicode), mode 2 an encoding CMap (codespace")
  (comment "and CIDs). For tools that hold a CMap and no font, and for the laws.")
  (let [^:mut ^I32 n 0]
    (pfn-init f)
    (cells-set f H_KIND 2)
    (cells-set f H_SUB 5)
    (if (== mode 1)
      (do (cells-set f H_CMAP 1)
          (cells-set f H_TU_START (cells-len f))
          (set n (pfn-cmap f data 1))
          (cells-set f H_TU_N n)
          (cells-set f H_HASTU 1)))
    (if (== mode 2)
      (do (cells-set f H_CMAP 2)
          (cells-set f H_CID_START (cells-len f))
          (set n (pfn-cmap f data 2))
          (cells-set f H_CID_N n)))
    (if (== (cells-at f H_NCS) 0)
      (pfn-cs-put f 2 0 0 0 65535))
    (return n)))

(defn ^I32 pfn-stop [^Src src]
  (comment "The status for a handle that is no font: need-bytes when the source")
  (comment "has missed (the handle may be 0 only because of the miss), else 1.")
  (if (ps-missed src) (return (pfn-need-bytes)))
  (return 1))

(defn ^:pub ^I32 pfn-load [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                           ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells f
                           ^:mut ^Cells out ^I32 fh0]
  (comment "Build the font whose dictionary is fh0 (a handle in `ar`, references")
  (comment "followed) into `f`, which this initializes. `out` is scratch for decoded")
  (comment "streams; `a` `b` `st` are the document layer's. Answers a `pfn-status`:")
  (comment "only a handle that is no dictionary fails (and `need-bytes` when the Src")
  (comment "missed, D075: then nothing built is kept); everything else is forgiven")
  (comment "and recorded in `(pfn-warn f)`.")
  (pfn-init f)
  (let [^I32 fh (pd-resolve src ar dc a b st fh0)
        ^:mut ^I32 sub 0
        ^:mut ^I32 sv 0]
    (if (== fh 0) (return (pfn-stop src)))
    (if (!= (pl-kind-of ar fh) 7) (return (pfn-stop src)))
    (set sv (pd-dget src ar dc a b st fh (pn-subtype)))
    (if (!= sv 0)
      (do (if (== (pl-name-is ar sv (pn-type1)) 1) (set sub 1))
          (if (== (pl-name-is ar sv (pn-mm-type1)) 1) (set sub 2))
          (if (== (pl-name-is ar sv (pn-true-type)) 1) (set sub 3))
          (if (== (pl-name-is ar sv (pn-type3)) 1) (set sub 4))
          (if (== (pl-name-is ar sv (pn-type0)) 1) (set sub 5))))
    (if (== sub 0)
      (do (set sub 1)
          (if (!= (pd-dget src ar dc a b st fh (pn-descendant-fonts)) 0)
            (set sub 5))))
    (if (== sub 5)
      (pfn-load-composite src ar dc a b st f out fh)
      (pfn-load-simple src ar dc a b st f out fh sub))
    (comment "CHECKPOINT (D075): a font read across a miss is not the font.")
    (if (ps-missed src) (return (pfn-need-bytes)))
    (return 0)))
