;; Captions, footnotes, endnotes and their references (P4.6; SPEC 10.6, 10.8; D229-D233). emon's own module (D039).
;;
;;   (nt-analyze wd ln et gl sf sc pages hc rf nb mk ws)   find captions, note bodies and the references that point at them
;;
;; THE SAME WAY AS `emon.lists` (which it shares its rows after `hc` and its groups in the text with): it decides, BEFORE
;; the paragraph stage, which lines begin a caption or a note body and where a note reference stands inside a word, and
;; tells the paragraph stage by a new text run for the first word of the line (`S_CAP`/`S_NOTE` group: kind or role, text:
;; the label or the marker) or for the word that holds a reference (`S_REF` group inside the word's text), and by the
;; line's row (`ls-f-cap`, `ls-f-note`). It runs before the list stage: a line it took is never an item.
;;
;; A CAPTION starts with a label: a keyword from the table of this module (`Figure`, `Fig.`, `Table`, `Abbildung`,
;; `Tableau`, `Рис.`, ...: a flat table of the languages P4.8 will name; the proper locale tables replace it) and a number
;; (`1`, `2.3`, `A.1`, `4b`, `IV`), and then a full stop, a colon, a dash or the line's own style (smaller than the body,
;; or italic or bold where the body is not): `Figure 2 shows how` set as body text is a sentence and not a caption. The
;; LABEL is the keyword and the number as printed, a dot kept that follows the number and a colon or dash left out
;; (D073.2: `Figure 1.`, `Table 3`), the rest of the line is the caption's text.
;;
;; A FOOTNOTE REFERENCE is a run of superscript glyphs (smaller than the line's text and raised off its baseline, or the
;; Unicode superscript digits): digits, a footnote symbol (`* † ‡ § ¶ ‖ #`) or a small letter. A reference is only
;; BELIEVED when a note body with the same marker stands where a footnote stands (the lower half of the same page, set
;; smaller than the body or marked in superscript) or, for an endnote, later in the document, among at least two others
;; whose markers the references call: `m²` and `10⁹` are not notes. A NOTE BODY starts with its marker: a leading
;; superscript run, or a lone number (`1`, `1.`, `1)`, `[1]`) or symbol at the start of the line. The marker, with its
;; punctuation, is not text; it is the `note`'s `marker`; the reference's `marker` is the same string, so the
;; stage after this one links them (`emon.restruct`).
(ns emon.notes
  (:require [emon.lang :refer [I32 Bool Cells]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop limit-of]]
            [emon.evidence :refer [wd-get wd-set ln-get ln-set ln-count gl-get
                                   lh-page lh-x0 lh-y0 lh-x1 lh-y1 lh-by0 lh-first lh-count
                                   hd-tstart hd-tlen hd-x0 wf-gfirst wf-gcount gf-size gf-by0 ch-cp ch-tstart ch-tlen]]
            [emon.style :refer [st-get st-hget sc-get sfk-size sfk-bits sfh-body sfh-size sck-bits sfk-below sfk-above sfk-gap-above sfk-gap-below sfk-sibline
                                sfh-gap sfk-height]]
            [emon.model :refer [page-h]]
            [emon.heading :refer [hd-level hd-rows-end]]
            [emon.lists :refer [ls-open ls-get ls-put ls-f-note ls-f-cap ls-f-ref ls-k-flags ls-upright ls-wl ls-wc
                                ls-first-word ls-second-word ls-line-size ls-abs ls-max ls-cap
                                ls-taint ls-s-cap ls-s-note ls-s-ref ls-wrap-begin ls-wrap-end ls-wrap-set ls-copy-word
                                ls-digit]]
            [kin.lang :refer [defn defconst defdata return let set while if do comment
                              + - * < > <= >= == != and or not quot rem bit-and]]))

(defconst ^I32 NT_RF 8)             ;; a reference candidate: word, first glyph, one past the last, line, page, marker start, length, state
(defconst ^I32 NT_NB 10)            ;; a body candidate: line, page, word, kind, last glyph + 1, marker start, length, state, size ok, band ok
;; THE CANDIDATES ARE A BUDGET (P10.4, D477): the reference candidates a document keeps are `limit-of` NOTE_REFS (8192 by default) and the body
;; candidates NOTE_BODIES (4096); one past it is dropped, not an error (`on-hit` 1 in `emon.limits`).

;; ------------------------------------------------------------------------- the caption keywords
;; generated by .tmp-free: the table below is `kw` entries of (offset, length, kind) into `nt-kw`; kind 1 a figure, 2 a table

(defdata ^:pub nt-kw
  :emitter kin.lang/flat-array
  :data [116 97 98 108 101 102 105 103 117 114 101 102 105 103 46 102 105 103 99 104 97 114 116 101 120 104 105 98 105 116 100 105 97 103 114 97 109 115 99 104 101 100 117 108 101 112 108 97 116 101 105 109 97 103 101 112 104 111 116 111 103 114 97 112 104 109 97 112 105 108 108 117 115 116 114 97 116 105 111 110 97 98 98 105 108 100 117 110 103 97 98 98 46 97 98 98 116 97 98 101 108 108 101 116 97 98 46 116 97 98 100 105 97 103 114 97 109 109 103 114 97 102 105 107 98 105 108 100 116 97 98 108 101 97 117 103 114 97 112 104 105 113 117 101 115 99 104 233 109 97 112 108 97 110 99 104 101 102 105 103 117 114 97 116 97 98 108 97 99 117 97 100 114 111 103 114 225 102 105 99 111 103 114 225 102 105 99 97 105 108 117 115 116 114 97 99 105 243 110 109 97 112 97 105 109 97 103 101 110 102 111 116 111 102 111 116 111 103 114 97 102 237 97 116 97 98 101 108 97 113 117 97 100 114 111 116 97 98 101 108 108 97 103 114 97 102 105 99 111 102 105 103 117 117 114 116 97 98 101 108 97 102 98 101 101 108 100 105 110 103 103 114 97 102 105 101 107 102 105 103 117 114 116 97 98 101 108 108 114 121 115 117 110 101 107 114 121 115 46 119 121 107 114 101 115 1088 1080 1089 1091 1085 1086 1082 1088 1080 1089 46 1090 1072 1073 1083 1080 1094 1072 1090 1072 1073 1083 46 1089 1093 1077 1084 1072 111 98 114 225 122 101 107 111 98 114 46 116 97 98 117 108 107 97 351 101 107 105 108 116 97 98 108 111]
  :accessors {^I32 nt-kw-at [^I32 ignored ^I32 i]})

(defdata ^:pub nt-kwi
  :emitter kin.lang/flat-array
  :data [0 5 2 5 6 1 11 4 1 15 3 1 18 5 1 23 7 1 30 7 1 37 8 2 45 5 1 50 5 1 55 5 1 60 5 1 65 3 1 68 12 1 80 9 1 89 4 1 93 3 1 96 7 2 103 4 2 107 3 2 110 8 1 118 6 1 124 4 1 128 7 2 135 9 1 144 6 1 150 7 1 157 6 1 163 5 2 168 6 2 174 7 1 181 7 1 188 11 1 199 4 1 203 6 1 209 4 1 213 10 1 223 6 2 229 6 2 235 7 2 242 7 1 249 6 1 255 5 2 260 10 1 270 7 1 277 5 1 282 6 2 288 7 1 295 4 1 299 6 1 305 7 1 312 4 1 316 7 2 323 5 2 328 5 1 333 7 1 340 4 1 344 7 2 351 5 1 356 5 2]
  :accessors {^I32 nt-kwi-at [^I32 ignored ^I32 i]})

(defconst ^I32 NT_NKW 60)

(defn ^I32 nt-lower [^I32 c]
  (comment "Lower case for ASCII, Latin-1 and Cyrillic (the keyword table is written in lower case).")
  (if (and (>= c 65) (<= c 90)) (return (+ c 32)))
  (if (and (>= c 192) (and (<= c 222) (!= c 215))) (return (+ c 32)))
  (if (== c 350) (return 351))
  (if (and (>= c 1040) (<= c 1071)) (return (+ c 32)))
  (return c))

(defn ^:pub ^I32 nt-keyword [^Cells wd ^Cells et ^I32 w]
  (comment "The kind of caption the word w is the keyword of: 1 a figure, 2 a table, 0 not a keyword.")
  (let [^I32 tl (ls-wl wd w)
        ^:mut ^I32 e 0]
    (if (or (< tl 3) (> tl 12)) (return 0))
    (while (< e NT_NKW)
      (do (let [^I32 off (nt-kwi-at 0 (* e 3))
                ^I32 n (nt-kwi-at 0 (+ (* e 3) 1))]
            (if (== n tl)
              (do (let [^:mut ^I32 i 0
                        ^:mut ^I32 ok 1]
                    (while (and (== ok 1) (< i n))
                      (do (if (!= (nt-lower (ls-wc wd et w i)) (nt-kw-at 0 (+ off i))) (set ok 0))
                          (set i (+ i 1))))
                    (if (== ok 1) (return (nt-kwi-at 0 (+ (* e 3) 2))))))))
          (set e (+ e 1))))
    (return 0)))

(defn ^Bool nt-upper [^I32 c]
  (return (and (>= c 65) (<= c 90))))

(defn ^:pub ^I32 nt-number-body [^Cells wd ^Cells et ^I32 w]
  (comment "How many code points of the word are a caption's number: `[A-Z]?` then digits (at most four a group) with")
  (comment "`.` or `-` and more digits, then at most one small letter; or a roman numeral of capitals (up to five). 0 when")
  (comment "the word does not start with one.")
  (let [^I32 tl (ls-wl wd w)
        ^:mut ^I32 i 0
        ^:mut ^I32 nd 0]
    (if (< tl 1) (return 0))
    (comment "a roman numeral: I, V, X, L, C and at least two of them, or a lone I V X")
    (let [^:mut ^I32 r 0]
      (while (and (< r tl) (< r 6)
                  (or (== (ls-wc wd et w r) 73) (or (== (ls-wc wd et w r) 86) (or (== (ls-wc wd et w r) 88)
                      (or (== (ls-wc wd et w r) 76) (== (ls-wc wd et w r) 67))))))
        (set r (+ r 1)))
      (if (and (>= r 1) (<= r 5) (or (== r tl) (not (nt-upper (ls-wc wd et w r)))))
        (do (if (or (>= r 2) (or (== (ls-wc wd et w 0) 73) (or (== (ls-wc wd et w 0) 86) (== (ls-wc wd et w 0) 88))))
              (do (if (or (== r tl) (not (>= (ls-digit (ls-wc wd et w r)) 0)))
                    (return r)))))))
    (if (and (nt-upper (ls-wc wd et w 0)) (> tl 1))
      (do (if (>= (ls-digit (ls-wc wd et w 1)) 0) (set i 1))
          (if (and (== i 0) (> tl 2) (== (ls-wc wd et w 1) 46) (>= (ls-digit (ls-wc wd et w 2)) 0)) (set i 2))))
    (set nd 0)
    (while (and (< i tl) (>= (ls-digit (ls-wc wd et w i)) 0))
      (do (set nd (+ nd 1))
          (set i (+ i 1))
          (if (> nd 4) (return 0))))
    (if (== nd 0) (return 0))
    (let [^:mut ^I32 more 1]
      (while (and (== more 1) (< (+ i 1) tl)
                  (or (== (ls-wc wd et w i) 46) (== (ls-wc wd et w i) 45))
                  (>= (ls-digit (ls-wc wd et w (+ i 1))) 0))
        (do (set i (+ i 1))
            (set nd 0)
            (while (and (< i tl) (>= (ls-digit (ls-wc wd et w i)) 0))
              (do (set nd (+ nd 1))
                  (set i (+ i 1))
                  (if (> nd 4) (return 0)))))))
    (if (and (< i tl) (>= (ls-wc wd et w i) 97) (<= (ls-wc wd et w i) 122))
      (set i (+ i 1)))
    (return i)))

(defn ^Bool nt-sep [^I32 c]
  (comment "What may stand between a caption's label and its text: a colon or a dash.")
  (return (or (== c 58) (or (== c 8211) (or (== c 8212) (or (== c 45) (== c 8722)))))))

(defn ^I32 nt-style-apart [^Cells sf ^Cells sc ^I32 l]
  (comment "1 when the line is set apart from the body: smaller by 4 per cent, or bold or italic where the body is not.")
  (let [^I32 body (st-hget sf (sfh-body))]
    (if (< body 0) (return 0))
    (let [^I32 bsz (st-hget sf (sfh-size))
          ^I32 sz (st-get sf l (sfk-size))
          ^I32 bits (st-get sf l (sfk-bits))
          ^I32 bbits (sc-get sc body (sck-bits))]
      (if (and (> sz 0) (> bsz 0) (<= (* sz 100) (* bsz 96))) (return 1))
      (if (!= (bit-and bits 3) (bit-and bbits 3)) (return 1))
      (return 0))))

(defn ^I32 nt-lastw [^Cells wd ^Cells ln ^I32 l]
  (comment "The last word with text of line l; -1 when there is none.")
  (let [^I32 w0 (ln-get ln l (lh-first))
        ^:mut ^I32 i (- (+ w0 (ln-get ln l (lh-count))) 1)]
    (while (>= i w0)
      (do (if (> (ls-wl wd i) 0) (return i))
          (set i (- i 1))))
    (return -1)))

(defn ^I32 nt-all-digits [^Cells wd ^Cells et ^I32 w]
  (comment "1 when word w is nothing but decimal digits (a page number).")
  (let [^I32 tl (ls-wl wd w)
        ^:mut ^I32 i 0]
    (if (< tl 1) (return 0))
    (while (< i tl)
      (do (if (< (ls-digit (ls-wc wd et w i)) 0) (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 nt-toc-like [^Cells wd ^Cells ln ^Cells et ^Cells sf ^I32 l]
  (comment "1 when caption candidate l is an entry of a list of figures or tables: a page number alone on its row to the right")
  (comment "(the text layer made it a line of its own), or at the end of the line after leader dots.")
  (let [^I32 lw (nt-lastw wd ln l)
        ^I32 n (ln-count ln)
        ^:mut ^I32 m (ls-max 0 (- l 40))]
    (while (and (< m n) (<= m (+ l 40)))
      (do (if (and (!= m l) (== (ln-get ln m (lh-page)) (ln-get ln l (lh-page))))
            (do (let [^I32 sw (ls-first-word wd ln m)]
                  (if (and (>= sw 0) (< (ls-second-word wd ln m) 0) (== (nt-all-digits wd et sw) 1)
                           (>= (ln-get ln m (lh-x0)) (ln-get ln l (lh-x1)))
                           (< (ln-get ln m (lh-y0)) (ln-get ln l (lh-y1)))
                           (> (ln-get ln m (lh-y1)) (ln-get ln l (lh-y0))))
                    (return 1)))))
          (set m (+ m 1))))
    (if (and (>= lw 0) (== (nt-all-digits wd et lw) 1))
      (do (let [^I32 w0 (ln-get ln l (lh-first))
                ^:mut ^I32 pw (- lw 1)]
            (while (and (>= pw w0) (== (ls-wl wd pw) 0))
              (set pw (- pw 1)))
            (if (>= pw w0)
              (do (let [^I32 pl (ls-wl wd pw)
                        ^I32 c (ls-wc wd et pw (- pl 1))]
                    (if (or (== c 46) (== c 8230)) (return 1))))))))
    (return 0)))

(defn ^I32 nt-in-run [^Cells sf ^Cells ln ^Cells hc ^I32 l]
  (comment "1 when caption candidate l has another (flag 8 or 64) directly above or below it, a line gap and a half away at")
  (comment "most: the entries of a list of figures or of tables, not captions. A real caption has its figure or its text between.")
  (let [^I32 sz (ls-line-size sf ln l)
        ^I32 b (st-get sf l (sfk-below))
        ^I32 a (st-get sf l (sfk-above))]
    (if (and (>= b 0) (!= (bit-and (ls-get hc b (ls-k-flags)) 72) 0)
             (<= (* (ls-cap (st-get sf l (sfk-gap-below))) 10) (* sz 15)))
      (return 1))
    (if (and (>= a 0) (!= (bit-and (ls-get hc a (ls-k-flags)) 72) 0)
             (<= (* (ls-cap (st-get sf l (sfk-gap-above))) 10) (* sz 15)))
      (return 1))
    (return 0)))

(defn ^I32 nt-in-prose [^Cells ln ^Cells sf ^Cells sc ^I32 l]
  (comment "D1630 (smoke review B issue 17): 1 when caption candidate l is a line in the middle of a paragraph of the body: set as the body is (not apart from it), with a line of")
  (comment "five words or more of its own size just above it and another just below it, both close (under 4/5 of its size). `Fig. 4. We find` that begins a line of running text is")
  (comment "a sentence, not a caption; a caption stands against its figure or its text with a gap, or is set apart.")
  (let [^I32 a (st-get sf l (sfk-above))
        ^I32 b (st-get sf l (sfk-below))
        ^I32 sz (ls-line-size sf ln l)]
    (if (== (nt-style-apart sf sc l) 1) (return 0))
    (if (or (< a 0) (< b 0)) (return 0))
    (if (or (not (ls-upright ln a)) (not (ls-upright ln b))) (return 0))
    (if (or (< (ln-get ln a (lh-count)) 5) (< (ln-get ln b (lh-count)) 2)) (return 0))
    (if (> (* (ls-cap (st-get sf l (sfk-gap-above))) 10) (* sz 8)) (return 0))
    (if (> (* (ls-cap (st-get sf l (sfk-gap-below))) 10) (* sz 8)) (return 0))
    (if (> (* (ls-abs (- (ls-line-size sf ln a) sz)) 25) sz) (return 0))
    (return 1)))

(defn ^I32 nt-after [^Cells wd ^Cells ln ^I32 l ^I32 w]
  (comment "The word with text that follows word w in line l; -1 when there is none.")
  (let [^I32 w0 (ln-get ln l (lh-first))
        ^I32 wn (ln-get ln l (lh-count))
        ^:mut ^I32 i (+ w 1)]
    (while (< i (+ w0 wn))
      (do (if (> (ls-wl wd i) 0) (return i))
          (set i (+ i 1))))
    (return -1)))

(defn ^I32 nt-caption [^:mut ^Cells wd ^:mut ^Cells et ^Cells ln ^Cells sf ^Cells sc ^:mut ^Cells hc ^I32 l ^I32 doit]
  (comment "With doit 0: does line l begin a caption (1 or 0), changing nothing. With doit 1, if it does: rewrite its words (the label becomes an `S_CAP` group in the first word's text, the")
  (comment "words it used are emptied), flag the line, and answer 1; else 0.")
  (let [^I32 w0 (ls-first-word wd ln l)
        ^I32 w1 (ls-second-word wd ln l)]
    (if (or (< w0 0) (< w1 0)) (return 0))
    (let [^I32 kind (nt-keyword wd et w0)]
      (if (== kind 0) (return 0))
      (let [^I32 bl (nt-number-body wd et w1)
            ^I32 tl1 (ls-wl wd w1)]
        (if (== bl 0) (return 0))
        (comment "the label token takes the dots that follow the number; then a separator; the rest of the word is text")
        (let [^:mut ^I32 tk bl
              ^:mut ^I32 sepn 0
              ^:mut ^I32 punct 0
              ^:mut ^I32 w2 -1
              ^:mut ^I32 next -1
              ^:mut ^I32 lone 0]
          (while (and (< tk tl1) (== (ls-wc wd et w1 tk) 46))
            (set tk (+ tk 1)))
          (if (> tk bl) (set punct 1))
          (if (and (< tk tl1) (nt-sep (ls-wc wd et w1 tk)))
            (do (set sepn 1)
                (set punct 1)))
          (if (and (< tk tl1) (== sepn 0)) (return 0))
          (comment "the next word may be a lone separator: `Figure 1 - text`")
          (set w2 (nt-after wd ln l w1))
          (set next w2)
          (if (and (== (+ tk sepn) tl1) (>= w2 0) (== (ls-wl wd w2) 1) (nt-sep (ls-wc wd et w2 0)))
            (do (set lone 1)
                (set punct 1)
                (set next (nt-after wd ln l w2))))
          (let [^I32 left (- tl1 (+ tk sepn))
                ^I32 apart (nt-style-apart sf sc l)]
            (if (and (== punct 0) (== apart 0)) (return 0))
            (if (and (<= left 0) (< next 0) (not (and (== punct 1) (== apart 1)))) (return 0))
            (if (== doit 0) (return 1))
            (comment "rewrite: the group in the first word, the label's other words emptied")
            (let [^I32 s (ls-wrap-begin et (ls-s-cap) kind -1)
                  ^I32 ts0 (wd-get wd w0 (hd-tstart))
                  ^I32 tl0 (wd-get wd w0 (hd-tlen))
                  ^I32 ts1 (wd-get wd w1 (hd-tstart))
                  ^:mut ^I32 j 0]
              (while (< j tl0)
                (do (cells-push et (cells-at et (+ ts0 j)))
                    (set j (+ j 1))))
              (cells-push et 32)
              (set j 0)
              (while (< j tk)
                (do (cells-push et (cells-at et (+ ts1 j)))
                    (set j (+ j 1))))
              (ls-wrap-end et)
              (set j (+ tk sepn))
              (while (< j tl1)
                (do (cells-push et (cells-at et (+ ts1 j)))
                    (set j (+ j 1))))
              (ls-wrap-set wd et w0 s)
              (wd-set wd w1 (hd-tlen) 0)
              (if (== lone 1) (wd-set wd w2 (hd-tlen) 0))
              (ls-put hc l (ls-k-flags) (ls-f-cap))))
          (return 1))))))

;; ---------------------------------------------------------------------- superscript runs

(defn ^I32 nt-ucs [^I32 c]
  (comment "The ASCII character a Unicode superscript digit stands for; -1 for any other.")
  (if (== c 185) (return 49))
  (if (== c 178) (return 50))
  (if (== c 179) (return 51))
  (if (== c 8304) (return 48))
  (if (and (>= c 8308) (<= c 8313)) (return (- c 8256)))
  (return -1))

(defn ^I32 nt-markc [^I32 c]
  (comment "The marker character a superscript glyph's code point is: a digit, a note symbol or a small letter; else -1.")
  (if (and (>= c 48) (<= c 57)) (return c))
  (if (or (== c 42) (or (== c 8224) (or (== c 8225) (or (== c 167) (or (== c 182) (or (== c 8214) (== c 35))))))) (return c))
  (if (and (>= c 97) (<= c 122)) (return c))
  (return -1))

(defn ^Bool nt-sup-styled [^Cells gl ^I32 g ^I32 sz0 ^I32 base]
  (comment "Is glyph g set smaller than the line's text (sz0) and raised off the line's baseline?")
  (let [^I32 sz (ls-cap (gl-get gl g (gf-size)))
        ^I32 by (ls-cap (gl-get gl g (gf-by0)))]
    (return (and (> sz0 0) (<= (* sz 100) (* sz0 88)) (>= (* (- (ls-cap base) by) 100) (* sz0 12))))))

(defn ^I32 nt-glyph-mark [^Cells gl ^Cells et ^I32 g ^I32 sz0 ^I32 base]
  (comment "The marker character of glyph g when it belongs to a reference: a Unicode superscript digit, or a digit, a")
  (comment "symbol or a letter that is set as a superscript; -1 when it does not.")
  (let [^I32 ts (gl-get gl g (ch-tstart))
        ^I32 tl (gl-get gl g (ch-tlen))
        ^:mut ^I32 c (gl-get gl g (ch-cp))]
    (if (>= ts 0)
      (do (if (!= tl 1) (return -1))
          (set c (cells-at et ts))))
    (let [^I32 u (nt-ucs c)]
      (if (>= u 0) (return u))
      (if (nt-sup-styled gl g sz0 base) (return (nt-markc c)))
      (return -1))))

(defn ^I32 nt-gchar [^Cells gl ^Cells et ^I32 g]
  (comment "The character of glyph g: its own code point, or the first of its text run when it has one.")
  (let [^I32 ts (gl-get gl g (ch-tstart))]
    (if (>= ts 0) (return (cells-at et ts)))
    (return (gl-get gl g (ch-cp)))))

(defn ^I32 nt-gpos [^Cells gl ^I32 g ^I32 wts ^I32 eq ^I32 i]
  (comment "Where glyph g (the i-th of its word, whose text starts at wts) begins in the text: its own run when it has one, else")
  (comment "the i-th code point of the word's text, which is where it is when the word has as many code points as glyphs")
  (comment "(eq 1); -1 when that cannot be known (a ligature in the word).")
  (let [^I32 ts (gl-get gl g (ch-tstart))]
    (if (>= ts 0) (return ts))
    (if (== eq 1) (return (+ wts i)))
    (return -1)))

(defn ^I32 nt-gend [^Cells gl ^I32 g ^I32 pos]
  (comment "Where the glyph whose text begins at pos ends.")
  (let [^I32 tl (gl-get gl g (ch-tlen))]
    (if (>= (gl-get gl g (ch-tstart)) 0) (return (+ pos tl)))
    (return (+ pos 1))))

(defn ^I32 nt-eq [^I32 a ^I32 b]
  (if (== a b) (return 1))
  (return 0))

(defn ^I32 nt-push-rf [^:mut ^Cells rf ^I32 w ^I32 g0 ^I32 g1 ^I32 l ^I32 page ^I32 ms ^I32 ml]
  (cells-push rf w)
  (cells-push rf g0)
  (cells-push rf g1)
  (cells-push rf l)
  (cells-push rf page)
  (cells-push rf ms)
  (cells-push rf ml)
  (cells-push rf 0)
  (return 0))

(defn ^I32 nt-push-nb [^:mut ^Cells nb ^I32 l ^I32 page ^I32 w ^I32 kind ^I32 g1 ^I32 ms ^I32 ml ^I32 szok ^I32 band]
  (cells-push nb l)
  (cells-push nb page)
  (cells-push nb w)
  (cells-push nb kind)
  (cells-push nb g1)
  (cells-push nb ms)
  (cells-push nb ml)
  (cells-push nb 0)
  (cells-push nb szok)
  (cells-push nb band)
  (return 0))

(defn ^Bool nt-letterish [^I32 c]
  (comment "A letter of Latin, Greek or Cyrillic (any case), or a character of the CJK blocks.")
  (if (and (>= c 65) (<= c 90)) (return (== 1 1)))
  (if (and (>= c 97) (<= c 122)) (return (== 1 1)))
  (if (and (>= c 192) (and (<= c 591) (and (!= c 215) (!= c 247)))) (return (== 1 1)))
  (if (and (>= c 880) (<= c 1327)) (return (== 1 1)))
  (if (>= c 12288) (return (== 1 1)))
  (return (== 0 1)))

(defn ^Bool nt-trailing-punct [^I32 c]
  (comment "Punctuation that may stand against a note reference on either side: a word's end, a comma, a closing bracket.")
  (if (or (== c 46) (or (== c 44) (or (== c 59) (or (== c 58) (or (== c 63) (== c 33)))))) (return (== 1 1)))
  (if (or (== c 41) (or (== c 93) (or (== c 8221) (or (== c 8217) (or (== c 34) (== c 39)))))) (return (== 1 1)))
  (return (== 0 1)))

(defn ^I32 nt-ref-context [^Cells gl ^Cells et ^I32 g0 ^I32 gn ^I32 i ^I32 j ^I32 pwc]
  (comment "Is the superscript run of glyphs i..j of a word a note reference and not an exponent or an index: what comes")
  (comment "before it (the word's glyph i-1, or when the run starts the word the last character of the word before) is a")
  (comment "letter or punctuation, never a digit or an operator, and what comes after it in the word is punctuation only.")
  (let [^:mut ^I32 before pwc
        ^:mut ^I32 k j]
    (if (> i 0) (set before (nt-gchar gl et (+ g0 (- i 1)))))
    (if (not (or (nt-letterish before) (nt-trailing-punct before))) (return 0))
    (while (< k gn)
      (do (if (not (nt-trailing-punct (nt-gchar gl et (+ g0 k)))) (return 0))
          (set k (+ k 1))))
    (return 1)))

(defn ^I32 nt-scan-word [^Cells wd ^Cells ln ^Cells et ^Cells gl ^:mut ^Cells rf ^:mut ^Cells nb ^:mut ^Cells mk
                         ^I32 l ^I32 w ^I32 first ^I32 pwc ^I32 sz0 ^I32 base ^I32 szok ^I32 band]
  (comment "The superscript runs of word w of line l: a run at the start of the line's first word is a note body's marker")
  (comment "(a row of `nb`), any other a reference (a row of `rf`). The marker characters go to `mk`.")
  (let [^I32 g0 (wd-get wd w (wf-gfirst))
        ^I32 gn (wd-get wd w (wf-gcount))
        ^I32 page (ln-get ln l (lh-page))
        ^I32 wts (wd-get wd w (hd-tstart))
        ^I32 eq (nt-eq (wd-get wd w (hd-tlen)) gn)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 m 0
        ^:mut ^I32 pa 0
        ^:mut ^I32 bs 0
        ^:mut ^I32 pb 0]
    (if (or (< g0 0) (<= gn 0) (> gn 4000)) (return 0))
    (comment "D1630 (smoke review B issue 9): the line's baseline is the first word's, which a word that STARTS with a superscript (a footnote's marker glued to its text) takes from the raised")
    (comment "glyph: the baseline the glyphs are raised off is the lowest of the word's own.")
    (set bs base)
    (while (< i gn)
      (do (if (> (ls-cap (gl-get gl (+ g0 i) (gf-by0))) bs) (set bs (ls-cap (gl-get gl (+ g0 i) (gf-by0)))))
          (set i (+ i 1))))
    (set i 0)
    (while (< i gn)
      (do (set m (nt-glyph-mark gl et (+ g0 i) sz0 bs))
          (if (< m 0)
            (set i (+ i 1))
            (do (set j i)
                (let [^I32 ms (cells-len mk)]
                  (while (and (< j gn) (< (- j i) 6)
                              (>= (nt-glyph-mark gl et (+ g0 j) sz0 bs) 0))
                    (do (cells-push mk (nt-glyph-mark gl et (+ g0 j) sz0 bs))
                        (set j (+ j 1))))
                  (comment "a comma between two markers belongs to them: `1,2`")
                  (if (and (< (+ j 1) gn) (< (- j i) 5)
                           (== (nt-gchar gl et (+ g0 j)) 44)
                           (nt-sup-styled gl (+ g0 j) sz0 bs)
                           (>= (nt-glyph-mark gl et (+ g0 j 1) sz0 bs) 0))
                    (do (cells-push mk 44)
                        (set j (+ j 1))
                        (while (and (< j gn) (< (- j i) 8)
                                    (>= (nt-glyph-mark gl et (+ g0 j) sz0 bs) 0))
                          (do (cells-push mk (nt-glyph-mark gl et (+ g0 j) sz0 bs))
                              (set j (+ j 1))))))
                  (set pa (nt-gpos gl (+ g0 i) wts eq i))
                  (set pb (nt-gpos gl (+ g0 (- j 1)) wts eq (- j 1)))
                  (if (>= pb 0) (set pb (nt-gend gl (+ g0 (- j 1)) pb)))
                  (if (and (>= pa 0) (>= pb 0))
                    (do (if (and (== i 0) (== first 1))
                          (do (if (< (quot (cells-len nb) NT_NB) (limit-of 11))
                                (nt-push-nb nb l page w 1 pb ms (- (cells-len mk) ms) szok band)))
                          (do (if (and (< (quot (cells-len rf) NT_RF) (limit-of 12))
                                       (== (nt-ref-context gl et g0 gn i j pwc) 1))
                                (nt-push-rf rf w pa pb l page ms (- (cells-len mk) ms)))))))
                  (set i j))))))
    (return 0)))

(defn ^I32 nt-plain-marker [^Cells wd ^Cells et ^I32 w ^:mut ^Cells mk]
  (comment "Is the whole word a plain note marker: one to three digits with at most a full stop or a parenthesis after them,")
  (comment "`[1]`, or a lone note symbol? Its characters go to `mk`; answers their count, 0 when it is not one.")
  (let [^I32 tl (ls-wl wd w)
        ^:mut ^I32 i 0
        ^:mut ^I32 nd 0]
    (if (< tl 1) (return 0))
    (let [^I32 c0 (ls-wc wd et w 0)]
      (if (and (== tl 1) (or (== c0 42) (or (== c0 8224) (or (== c0 8225) (or (== c0 167) (== c0 182))))))
        (do (cells-push mk c0)
            (return 1)))
      (if (and (>= tl 3) (<= tl 5) (== c0 91) (== (ls-wc wd et w (- tl 1)) 93))
        (do (set i 1)
            (while (and (< i (- tl 1)) (>= (ls-digit (ls-wc wd et w i)) 0))
              (do (set nd (+ nd 1))
                  (set i (+ i 1))))
            (if (and (== nd (- tl 2)) (>= nd 1))
              (do (set i 1)
                  (while (< i (- tl 1))
                    (do (cells-push mk (+ 48 (ls-digit (ls-wc wd et w i))))
                        (set i (+ i 1))))
                  (return nd)))
            (return 0)))
      (while (and (< i tl) (< i 4) (>= (ls-digit (ls-wc wd et w i)) 0))
        (do (set nd (+ nd 1))
            (set i (+ i 1))))
      (if (or (< nd 1) (> nd 3)) (return 0))
      (if (and (== i (- tl 1)) (or (== (ls-wc wd et w i) 46) (== (ls-wc wd et w i) 41))) (set i tl))
      (if (!= i tl) (return 0))
      (set i 0)
      (while (< i nd)
        (do (cells-push mk (+ 48 (ls-digit (ls-wc wd et w i))))
            (set i (+ i 1))))
      (return nd))))

(defn ^I32 nt-scan [^Cells wd ^Cells ln ^Cells et ^Cells gl ^Cells sf ^Cells pages ^Cells hc
                    ^:mut ^Cells rf ^:mut ^Cells nb ^:mut ^Cells mk]
  (comment "Collect the reference and the note body candidates of every upright line that is not a heading or already taken.")
  (let [^I32 n (ln-count ln)
        ^I32 bsz (st-hget sf (sfh-size))
        ^:mut ^I32 l 0
        ^:mut ^I32 w 0
        ^:mut ^I32 k 0
        ^:mut ^I32 nrow 0
        ^:mut ^I32 szok 0
        ^:mut ^I32 band 0
        ^:mut ^I32 sz0 0
        ^:mut ^I32 first 0
        ^:mut ^I32 pwc -1
        ^:mut ^I32 wl 0
        ^:mut ^I32 base 0
        ^:mut ^I32 ml 0
        ^:mut ^I32 ms 0]
    (cells-drop rf 0)
    (cells-drop nb 0)
    (cells-drop mk 0)
    (if (< (st-hget sf (sfh-body)) 0) (return 0))
    (while (< l n)
      (do (if (and (ls-upright ln l) (== (hd-level hc l) 0) (== (ls-get hc l (ls-k-flags)) 0))
            (do (set sz0 (ls-line-size sf ln l))
                (set base (ls-cap (ln-get ln l (lh-by0))))
                (set szok 0)
                (if (and (> bsz 0) (<= (* sz0 100) (* bsz 96))) (set szok 1))
                (set band 0)
                (let [^I32 pg (ln-get ln l (lh-page))]
                  (if (and (>= pg 1) (<= pg (quot (cells-len pages) 16)))
                    (if (>= (* (ls-cap (ln-get ln l (lh-y0))) 2) (ls-cap (page-h pages (- pg 1)))) (set band 1))))
                (set nrow (quot (cells-len nb) NT_NB))
                (set first 1)
                (set pwc -1)
                (let [^I32 w0 (ln-get ln l (lh-first))
                      ^I32 wn (ln-get ln l (lh-count))]
                  (set k 0)
                  (while (< k wn)
                    (do (set w (+ w0 k))
                        (if (> (ls-wl wd w) 0)
                          (do (nt-scan-word wd ln et gl rf nb mk l w first pwc sz0 base szok band)
                              (set first 0)
                              (set wl (ls-wl wd w))
                              (set pwc (ls-wc wd et w (- wl 1)))))
                        (set k (+ k 1)))))
                (comment "no sup marker led the line: a plain one may")
                (if (== (quot (cells-len nb) NT_NB) nrow)
                  (do (let [^I32 fw (ls-first-word wd ln l)]
                        (if (and (>= fw 0) (>= (ls-second-word wd ln l) 0))
                          (do (set ms (cells-len mk))
                              (set ml (nt-plain-marker wd et fw mk))
                              (if (and (> ml 0) (< (quot (cells-len nb) NT_NB) (limit-of 11)))
                                (nt-push-nb nb l (ln-get ln l (lh-page)) fw 2 0 ms ml szok band)))))))))
          (set l (+ l 1))))
    (return 0)))

;; ---------------------------------------------------------------------------------- matching

(defn ^Bool nt-same-mark [^Cells mk ^I32 s1 ^I32 l1 ^I32 s2 ^I32 l2]
  (if (!= l1 l2) (return (== 0 1)))
  (let [^:mut ^I32 i 0]
    (while (< i l1)
      (do (if (!= (cells-at mk (+ s1 i)) (cells-at mk (+ s2 i))) (return (== 0 1)))
          (set i (+ i 1))))
    (return (== 1 1))))

(defn ^I32 nt-find-ref [^Cells rf ^Cells nb ^Cells mk ^I32 i ^I32 same-page ^I32 before]
  (comment "The first reference not yet taken (state 0) with note body i's marker: on its page (same-page 1), on the page before")
  (comment "it (same-page 2: a footnote a column or a page break pushed on), or before it in the document (before 1). Its row, or -1.")
  (let [^I32 nr (quot (cells-len rf) NT_RF)
        ^I32 nl (cells-at nb (* i NT_NB))
        ^I32 np (cells-at nb (+ (* i NT_NB) 1))
        ^I32 ms (cells-at nb (+ (* i NT_NB) 5))
        ^I32 ml (cells-at nb (+ (* i NT_NB) 6))
        ^:mut ^I32 r 0]
    (while (< r nr)
      (do (if (and (== (cells-at rf (+ (* r NT_RF) 7)) 0)
                   (nt-same-mark mk ms ml (cells-at rf (+ (* r NT_RF) 5)) (cells-at rf (+ (* r NT_RF) 6))))
            (do (if (and (== same-page 1) (== (cells-at rf (+ (* r NT_RF) 4)) np)) (return r))
                (if (and (== same-page 2) (== (cells-at rf (+ (* r NT_RF) 4)) (- np 1))) (return r))
                (if (and (== before 1)
                         (or (< (cells-at rf (+ (* r NT_RF) 4)) np)
                             (and (== (cells-at rf (+ (* r NT_RF) 4)) np) (< (cells-at rf (+ (* r NT_RF) 3)) nl))))
                  (return r))))
          (set r (+ r 1))))
    (return -1)))

(defn ^I32 nt-small-to-end [^Cells ln ^Cells sf ^I32 l ^I32 bsz]
  (comment "D1630 (smoke review B issue 9): 1 when no line on line l's page, upright and at or below its top, is set in the body's size (over 96 per cent of `bsz`): everything from l to")
  (comment "the foot of the page is small type, the shape of a footnote block (the rule above it and the body above that are what the notes stage cannot see).")
  (let [^I32 n (ln-count ln)
        ^I32 p (ln-get ln l (lh-page))
        ^I32 y (ln-get ln l (lh-y0))
        ^:mut ^I32 q 0]
    (if (<= bsz 0) (return 0))
    (while (< q n)
      (do (if (and (!= q l) (== (ln-get ln q (lh-page)) p))
            (do (if (and (ls-upright ln q) (>= (ln-get ln q (lh-y0)) (- y 100)))
                  (do (if (> (* (ls-line-size sf ln q) 100) (* bsz 96)) (return 0))))))
          (set q (+ q 1))))
    (return 1)))

(defn ^I32 nt-foot [^Cells ln ^Cells sf ^:mut ^Cells rf ^:mut ^Cells nb ^Cells mk ^I32 i]
  (comment "Is note body candidate i a footnote? In the lower half of the page (the band) and small or marked in superscript,")
  (comment "with a reference on its page; or small, with a reference on the page before (a note a column or a page break pushed")
  (comment "on); or marked in superscript, small and in the band, with no reference at all. Marks the candidate (state 1) and the")
  (comment "reference it took.")
  (let [^I32 b (* i NT_NB)
        ^I32 kind (cells-at nb (+ b 3))
        ^I32 szok (cells-at nb (+ b 8))
        ^I32 band (cells-at nb (+ b 9))
        ^:mut ^I32 r -1]
    (if (!= (cells-at nb (+ b 7)) 0) (return 0))
    (if (and (== band 1) (or (== szok 1) (== kind 1)))
      (set r (nt-find-ref rf nb mk i 1 0)))
    (if (and (< r 0) (or (== szok 1) (and (== kind 1) (== band 1))))
      (set r (nt-find-ref rf nb mk i 2 0)))
    (if (>= r 0)
      (do (cells-set rf (+ (* r NT_RF) 7) 1)
          (cells-set nb (+ b 7) 1)
          (return 1)))
    (if (and (== kind 1) (== szok 1) (== band 1))
      (do (cells-set nb (+ b 7) 1)
          (return 1)))
    (comment "D1630: a plain marker (a lone number or symbol) on a small line in the lower half of the page, with only small type from it to the page's foot, is a footnote's whatever the text")
    (comment "says (a superscript the text layer did not mark, a reference no glyph run showed)")
    (if (and (== kind 2) (and (== szok 1) (== band 1)))
      (do (let [^I32 bsz (st-hget sf (sfh-size))]
            (if (== (nt-small-to-end ln sf (cells-at nb b) bsz) 1)
              (do (cells-set nb (+ b 7) 1)
                  (return 1))))))
    (return 0)))

(defn ^I32 nt-match [^Cells ln ^Cells sf ^:mut ^Cells rf ^:mut ^Cells nb ^Cells mk ^I32 nhl]
  (comment "Decide which candidates are notes. State 1: a footnote (a body in the lower half of the page, set smaller than")
  (comment "the body text or marked in superscript, with a reference on its page; a superscript marker alone is enough when")
  (comment "the line is also smaller). State 2: an endnote (a reference earlier in the document: for a superscript marker")
  (comment "at once; for a plain number when two or more of them match). The reference rows get the state of their note.")
  (let [^I32 nn (quot (cells-len nb) NT_NB)
        ^:mut ^I32 i 0
        ^:mut ^I32 r 0
        ^:mut ^I32 tent 0]
    (while (< i nn)
      (do (nt-foot ln sf rf nb mk i)
          (set i (+ i 1))))
    (comment "endnotes: a superscript marker with an earlier reference at once, a plain number when there are two")
    (set i 0)
    (while (< i nn)
      (do (let [^I32 b (* i NT_NB)]
            (if (== (cells-at nb (+ b 7)) 0)
              (do (set r (nt-find-ref rf nb mk i 0 1))
                  (if (>= r 0)
                    (do (if (== (cells-at nb (+ b 3)) 1)
                          (do (cells-set rf (+ (* r NT_RF) 7) 2)
                              (cells-set nb (+ b 7) 2))
                          (do (if (and (>= nhl 0) (> (cells-at nb b) nhl))
                                (do (cells-set rf (+ (* r NT_RF) 7) 4)
                                    (cells-set nb (+ b 7) 4)
                                    (set tent (+ tent 1)))))))))))
          (set i (+ i 1))))
    (set i 0)
    (while (< i nn)
      (do (if (== (cells-at nb (+ (* i NT_NB) 7)) 4)
            (do (if (>= tent 2)
                  (cells-set nb (+ (* i NT_NB) 7) 2)
                  (cells-set nb (+ (* i NT_NB) 7) 0))))
          (set i (+ i 1))))
    (set r 0)
    (while (< r (quot (cells-len rf) NT_RF))
      (do (if (== (cells-at rf (+ (* r NT_RF) 7)) 4)
            (do (if (>= tent 2)
                  (cells-set rf (+ (* r NT_RF) 7) 2)
                  (cells-set rf (+ (* r NT_RF) 7) 0))))
          (set r (+ r 1))))
    (return 0)))

;; ------------------------------------------------------------- notes with no printed marker

;; headings that say what follows is a list of notes (lower case; `nt-nhi`: offset and length of each)
(defdata ^:pub nt-nh
  :emitter kin.lang/flat-array
  :data [110 111 116 101 115 101 110 100 110 111 116 101 115 102 111 111 116 110 111 116 101 115 110 111 116 101 115 32 97 110 100 32 114 101 102 101 114 101 110 99 101 115 110 111 116 101 115 32 97 110 100 32 115 111 117 114 99 101 115 97 110 109 101 114 107 117 110 103 101 110 101 110 100 110 111 116 101 110 102 117 223 110 111 116 101 110 102 117 115 115 110 111 116 101 110 110 111 116 101 110 110 111 116 97 115 114 101 109 97 114 113 117 101 115 110 111 116 101 115 32 100 101 32 98 97 115 32 100 101 32 112 97 103 101 110 111 116 101 110 111 116 101 32 97 32 112 105 232 32 100 105 32 112 97 103 105 110 97 1087 1088 1080 1084 1077 1095 1072 1085 1080 1103 1089 1085 1086 1089 1082 1080 27880 37322 33050 27880 23614 27880 35387 37323 27880 35352 44033 51452 48120 51452]
  :accessors {^I32 nt-nh-at [^I32 ignored ^I32 i]})

(defdata ^:pub nt-nhi
  :emitter kin.lang/flat-array
  :data [0 5 5 8 13 9 22 20 42 17 59 11 70 8 78 8 86 9 95 5 100 5 105 9 114 20 134 4 138 20 158 10 168 6 174 2 176 2 178 2 180 2 182 2 184 2 186 2]
  :accessors {^I32 nt-nhi-at [^I32 ignored ^I32 i]})

(defconst ^I32 NT_NNH 24)

(defn ^I32 nt-last-word [^Cells wd ^Cells ln ^I32 l]
  (let [^I32 w0 (ln-get ln l (lh-first))
        ^:mut ^I32 i (- (+ w0 (ln-get ln l (lh-count))) 1)]
    (while (>= i w0)
      (do (if (> (ls-wl wd i) 0) (return i))
          (set i (- i 1))))
    (return -1)))

(defn ^I32 nt-nh-match [^Cells wd ^Cells ln ^Cells et ^I32 l ^I32 e]
  (comment "1 when the words of line l, joined by one space, with a colon or a full stop at their end dropped, spell entry e of")
  (comment "the notes headings, in any case.")
  (let [^I32 off (nt-nhi-at 0 (* e 2))
        ^I32 n (nt-nhi-at 0 (+ (* e 2) 1))
        ^I32 lw (nt-last-word wd ln l)
        ^I32 w0 (ln-get ln l (lh-first))
        ^I32 wn (ln-get ln l (lh-count))
        ^:mut ^I32 k 0
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 first 1]
    (if (< lw 0) (return 0))
    (while (< i wn)
      (do (let [^I32 w (+ w0 i)
                ^I32 tl (ls-wl wd w)]
            (if (> tl 0)
              (do (if (== first 0)
                    (do (if (or (>= k n) (!= (nt-nh-at 0 (+ off k)) 32)) (return 0))
                        (set k (+ k 1))))
                  (set first 0)
                  (set j 0)
                  (while (< j tl)
                    (do (let [^I32 c (ls-wc wd et w j)]
                          (if (and (== w lw) (== j (- tl 1)) (or (== c 58) (== c 46)))
                            (set j (+ j 1))
                            (do (if (or (>= k n) (!= (nt-lower c) (nt-nh-at 0 (+ off k)))) (return 0))
                                (set k (+ k 1))
                                (set j (+ j 1))))))))))
          (set i (+ i 1))))
    (if (== k n) (return 1))
    (return 0)))

(defn ^I32 nt-notes-heading [^Cells wd ^Cells ln ^Cells et ^I32 l]
  (let [^:mut ^I32 e 0]
    (while (< e NT_NNH)
      (do (if (== (nt-nh-match wd ln et l e) 1) (return 1))
          (set e (+ e 1))))
    (return 0)))

(defn ^I32 nt-first-notes-heading [^Cells wd ^Cells ln ^Cells et ^Cells hc ^Cells rf]
  (comment "The first heading line that says `Notes` after the first reference there is; -1 when there is none (or no reference).")
  (if (== (cells-len rf) 0) (return -1))
  (let [^I32 n (ln-count ln)
        ^:mut ^I32 h (+ (cells-at rf 3) 1)]
    (while (< h n)
      (do (if (and (ls-upright ln h) (> (hd-level hc h) 0) (== (nt-notes-heading wd ln et h) 1)) (return h))
          (set h (+ h 1))))
    (return -1)))

(defn ^I32 nt-nth-ref [^Cells rf ^I32 n]
  (comment "The row of the n-th (from 0) reference that nothing has claimed (state 0); -1 when there are fewer.")
  (let [^I32 nr (quot (cells-len rf) NT_RF)
        ^:mut ^I32 r 0
        ^:mut ^I32 seen 0]
    (while (< r nr)
      (do (if (== (cells-at rf (+ (* r NT_RF) 7)) 0)
            (do (if (== seen n) (return r))
                (set seen (+ seen 1))))
          (set r (+ r 1))))
    (return -1)))

(defn ^I32 nt-put-mark [^:mut ^Cells et ^Cells mk ^I32 ms ^I32 ml]
  (let [^:mut ^I32 i 0]
    (while (< i ml)
      (do (cells-push et (cells-at mk (+ ms i)))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 nt-wrap-note [^:mut ^Cells wd ^:mut ^Cells et ^Cells mk ^I32 w ^I32 ms ^I32 ml ^I32 role]
  (comment "Word w begins with an `S_NOTE` group (the role) whose text is the marker mk[ms, ms+ml), and keeps its own text.")
  (let [^I32 s (ls-wrap-begin et (ls-s-note) role -1)]
    (nt-put-mark et mk ms ml)
    (ls-wrap-end et)
    (ls-copy-word et wd w 0)
    (ls-wrap-set wd et w s)
    (return 0)))

(defn ^I32 nt-claim [^:mut ^Cells wd ^:mut ^Cells et ^Cells ln ^:mut ^Cells hc ^Cells rf ^Cells mk ^I32 b ^I32 k]
  (comment "Line b starts the k-th note under a heading: an endnote whose marker is the k-th reference nothing claimed.")
  (let [^I32 r (nt-nth-ref rf k)
        ^I32 w (ls-first-word wd ln b)]
    (if (and (>= r 0) (>= w 0))
      (do (nt-wrap-note wd et mk w (cells-at rf (+ (* r NT_RF) 5)) (cells-at rf (+ (* r NT_RF) 6)) 5)
          (ls-put hc b (ls-k-flags) (ls-f-note))))
    (return 0)))

(defn ^I32 nt-walk [^:mut ^Cells wd ^:mut ^Cells et ^Cells ln ^Cells sf ^:mut ^Cells hc ^Cells rf ^Cells mk ^I32 h ^I32 doit]
  (comment "The notes under the heading line h: the first line below it and every line below that starts after more than one and")
  (comment "a half line gaps of whitespace. With doit 1 each one is rewritten as an endnote whose marker is the next of the")
  (comment "references nothing has claimed. Answers how many there are.")
  (let [^I32 med (st-hget sf (sfh-gap))
        ^:mut ^I32 b (st-get sf h (sfk-below))
        ^:mut ^I32 k 0
        ^:mut ^I32 steps 0
        ^:mut ^I32 first 1
        ^:mut ^I32 start 0]
    (while (and (>= b 0) (< steps 400))
      (do (if (or (> (hd-level hc b) 0) (not (ls-upright ln b)) (!= (ls-get hc b (ls-k-flags)) 0)
                  (!= (ln-get ln b (lh-page)) (ln-get ln h (lh-page))))
            (set b -1)
            (do (set start first)
                (let [^I32 g (st-get sf b (sfk-gap-above))
                      ^I32 hb (st-get sf b (sfk-height))]
                  (if (and (> (* g 2) (* med 3)) (> (* (- g med) 8) hb)) (set start 1)))
                (if (== start 1)
                  (do (if (== doit 1) (nt-claim wd et ln hc rf mk b k))
                      (set k (+ k 1))))
                (set first 0)
                (set b (st-get sf b (sfk-below)))))
          (set steps (+ steps 1))))
    (return k)))

(defn ^I32 nt-markerless [^:mut ^Cells wd ^:mut ^Cells et ^Cells ln ^Cells sf ^:mut ^Cells hc ^:mut ^Cells rf ^Cells mk]
  (comment "References left over (a superscript marker no body claimed) and a heading that says `Notes` after them: the lines")
  (comment "under it that start a note, as many as there are references, are the endnotes, the printed marker being none; the")
  (comment "markers are the references' own, in order. A different count leaves everything as it is.")
  (let [^I32 nr (quot (cells-len rf) NT_RF)
        ^I32 n (ln-count ln)
        ^:mut ^I32 r 0
        ^:mut ^I32 un 0
        ^:mut ^I32 fl -1
        ^:mut ^I32 h 0
        ^:mut ^I32 k 0]
    (while (< r nr)
      (do (if (== (cells-at rf (+ (* r NT_RF) 7)) 0)
            (do (if (< fl 0) (set fl (cells-at rf (+ (* r NT_RF) 3))))
                (set un (+ un 1))))
          (set r (+ r 1))))
    (if (or (== un 0) (> un 400)) (return 0))
    (set h (+ fl 1))
    (while (< h n)
      (do (if (and (ls-upright ln h) (> (hd-level hc h) 0) (== (nt-notes-heading wd ln et h) 1))
            (do (set k (nt-walk wd et ln sf hc rf mk h 0))
                (if (== k un)
                  (do (nt-walk wd et ln sf hc rf mk h 1)
                      (set r 0)
                      (while (< r nr)
                        (do (if (== (cells-at rf (+ (* r NT_RF) 7)) 0) (cells-set rf (+ (* r NT_RF) 7) 2))
                            (set r (+ r 1))))
                      (return k)))))
          (set h (+ h 1))))
    (return 0)))

;; --------------------------------------------------------------------------------- rewriting

(defn ^I32 nt-apply-bodies [^:mut ^Cells wd ^:mut ^Cells et ^Cells gl ^Cells ln ^:mut ^Cells nb ^Cells mk ^:mut ^Cells rf ^:mut ^Cells hc]
  (comment "Rewrite the first word of every confirmed note body: its marker leaves the text, an `S_NOTE` group (the role: 4 a")
  (comment "footnote, 5 an endnote) takes its place. The line's row says a note starts there.")
  (let [^I32 nn (quot (cells-len nb) NT_NB)
        ^:mut ^I32 i 0]
    (while (< i nn)
      (do (let [^I32 b (* i NT_NB)
                ^I32 st (cells-at nb (+ b 7))]
            (if (or (== st 1) (== st 2))
              (do (let [^I32 l (cells-at nb b)
                        ^I32 w (cells-at nb (+ b 2))
                        ^I32 kind (cells-at nb (+ b 3))
                        ^I32 ts (wd-get wd w (hd-tstart))
                        ^I32 tl (wd-get wd w (hd-tlen))
                        ^I32 s (ls-wrap-begin et (ls-s-note) (+ st 3) -1)]
                    (nt-put-mark et mk (cells-at nb (+ b 5)) (cells-at nb (+ b 6)))
                    (ls-wrap-end et)
                    (if (== kind 1)
                      (do (let [^:mut ^I32 j (cells-at nb (+ b 4))]
                            (while (< j (+ ts tl))
                              (do (cells-push et (cells-at et j))
                                  (set j (+ j 1)))))))
                    (ls-wrap-set wd et w s)
                    (ls-put hc l (ls-k-flags) (ls-f-note))
                    (comment "references in this very word are left alone")
                    (let [^:mut ^I32 r 0]
                      (while (< r (quot (cells-len rf) NT_RF))
                        (do (if (== (cells-at rf (* r NT_RF)) w)
                              (cells-set rf (+ (* r NT_RF) 7) 9))
                            (set r (+ r 1)))))))))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 nt-apply-refs [^:mut ^Cells wd ^:mut ^Cells et ^Cells gl ^Cells rf ^Cells mk]
  (comment "Rewrite every word that holds a confirmed reference: each reference becomes an `S_REF` group inside the word's")
  (comment "text, the marker as the group's text.")
  (let [^I32 nr (quot (cells-len rf) NT_RF)
        ^:mut ^I32 i 0
        ^:mut ^I32 i1 0]
    (while (< i nr)
      (do (set i1 (+ i 1))
          (while (and (< i1 nr) (== (cells-at rf (* i1 NT_RF)) (cells-at rf (* i NT_RF))))
            (set i1 (+ i1 1)))
          (let [^I32 w (cells-at rf (* i NT_RF))
                ^I32 ts (wd-get wd w (hd-tstart))
                ^I32 tl (wd-get wd w (hd-tlen))
                ^:mut ^I32 any 0
                ^:mut ^I32 j i]
            (while (< j i1)
              (do (if (or (== (cells-at rf (+ (* j NT_RF) 7)) 1) (== (cells-at rf (+ (* j NT_RF) 7)) 2)) (set any 1))
                  (set j (+ j 1))))
            (if (== any 1)
              (do (let [^I32 s (cells-len et)
                        ^:mut ^I32 p ts]
                    (set j i)
                    (while (< j i1)
                      (do (if (or (== (cells-at rf (+ (* j NT_RF) 7)) 1) (== (cells-at rf (+ (* j NT_RF) 7)) 2))
                            (do (let [^I32 a (cells-at rf (+ (* j NT_RF) 1))
                                      ^I32 b (cells-at rf (+ (* j NT_RF) 2))]
                                  (if (and (>= a p) (<= b (+ ts tl)) (> b a))
                                    (do (let [^:mut ^I32 q p]
                                          (while (< q a)
                                            (do (cells-push et (cells-at et q))
                                                (set q (+ q 1)))))
                                        (ls-wrap-begin et (ls-s-ref) 0 -1)
                                        (nt-put-mark et mk (cells-at rf (+ (* j NT_RF) 5)) (cells-at rf (+ (* j NT_RF) 6)))
                                        (ls-wrap-end et)
                                        (set p b))))))
                          (set j (+ j 1))))
                    (while (< p (+ ts tl))
                      (do (cells-push et (cells-at et p))
                          (set p (+ p 1))))
                    (ls-wrap-set wd et w s)))))
          (set i i1)))
    (return 0)))

(defn ^:pub ^I32 nt-analyze [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Cells gl ^Cells sf ^Cells sc ^Cells pages
                             ^:mut ^Cells hc ^:mut ^Cells rf ^:mut ^Cells nb ^:mut ^Cells mk ^Cells tw]
  (comment "Find the captions, the note bodies and the references that point at them, and mark them (see the module's head).")
  (comment "`rf`, `nb`, `mk` are scratch. Answers the number of captions plus note bodies.")
  (if (== (ls-open hc) 0) (return 0))
  (ls-taint wd ln hc tw)
  (let [^I32 n (ln-count ln)
        ^:mut ^I32 l 0
        ^:mut ^I32 nhl -1
        ^:mut ^I32 found 0]
    (comment "captions first: a caption is never a note body. Found first (flag 8, nothing rewritten), then the candidates that")
    (comment "stand in a run (a list of figures: entries one under another, a line gap apart) are let go, then the rest rewritten.")
    (while (< l n)
      (do (if (and (ls-upright ln l) (== (hd-level hc l) 0) (== (ls-get hc l (ls-k-flags)) 0)
                   (== (nt-caption wd et ln sf sc hc l 0) 1))
            (ls-put hc l (ls-k-flags) (ls-f-cap)))
          (set l (+ l 1))))
    (set l 0)
    (while (< l n)
      (do (if (== (ls-get hc l (ls-k-flags)) (ls-f-cap))
            (do (if (or (== (nt-in-run sf ln hc l) 1) (or (== (nt-toc-like wd ln et sf l) 1) (== (nt-in-prose ln sf sc l) 1)))
                  (ls-put hc l (ls-k-flags) 64))))
          (set l (+ l 1))))
    (set l 0)
    (while (< l n)
      (do (let [^I32 fl (ls-get hc l (ls-k-flags))]
            (if (or (== fl (ls-f-cap)) (== fl 64))
              (do (ls-put hc l (ls-k-flags) 0)
                  (if (== fl (ls-f-cap))
                    (set found (+ found (nt-caption wd et ln sf sc hc l 1)))))))
          (set l (+ l 1))))
    (nt-scan wd ln et gl sf pages hc rf nb mk)
    (set nhl (nt-first-notes-heading wd ln et hc rf))
    (nt-match ln sf rf nb mk nhl)
    (nt-markerless wd et ln sf hc rf mk)
    (set l 0)
    (while (< l (quot (cells-len nb) NT_NB))
      (do (if (or (== (cells-at nb (+ (* l NT_NB) 7)) 1) (== (cells-at nb (+ (* l NT_NB) 7)) 2))
            (set found (+ found 1)))
          (set l (+ l 1))))
    (nt-apply-bodies wd et gl ln nb mk rf hc)
    (nt-apply-refs wd et gl rf mk)
    (return found)))
