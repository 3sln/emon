;; RC5 guarded decision primitive. The caller supplies distinct-reading votes,
;; maximum reading confidence per candidate and format/dictionary facts.
;; Rule codes: keep0 agree1 margin2 insert3 blocked-format4 blocked-lexicon5 blocked-slot6.
(ns emon.ofuse
  (:require [emon.lang :refer [I32 I64 Cells i64 i32]]
            [emon.ofmt :refer [ofmt-valid fmt-digit]]
            [emon.port :refer [cells-at cells-len cells-push cells-set cells-drop]]
            [emon.evidence :refer [ow-count ow-stride ow-get ow-set hd-page hd-x0 hd-y0 hd-x1 hd-y1 hd-bx0 hd-by0 hd-bx1 hd-by1 hd-rot hd-dir
                                   hd-line hd-tstart hd-tlen hd-conf hd-feat owf-flags oe-garbage oe-dictionary owf-run owf-from ev-overlap-small
                                   or-new or-count or-get or-set orf-page orf-view orf-pass orf-lfirst orf-lcount orf-wfirst orf-wcount
                                   ol-new ol-count ol-get ol-set lh-x0 lh-y0 lh-x1 lh-y1 lh-bx0 lh-by0 lh-bx1 lh-by1 lh-rot lh-dir lh-first lh-count olf-run
                                   op-first op-upscaled op-body-ink op-receipt op-receipt-rescue op-line op-cell op-fused
                                   oz-stride ozf-page ozf-x0 ozf-ifirst ozf-icount ozf-cfirst ozf-ccount ozf-rule ozf-votes ozf-ivotes ozf-nulls ozf-margin ozf-readings ozf-op]]
            [emon.scan :refer [sc-line-words sc-kept-words sc-fate-base sc-xtra-base sc-sel-base sc-sel-max]]
            [kin.lang :refer [defdata defn return let set while if do comment and or >= <= > < == != + - * quot bit-and bit-or]]))

(defn ^:pub ^I32 of-margin [] (return 300))
(defn ^:pub ^I32 of-insert-conf [] (return 700))
(defn ^:pub ^I32 of-slot-max [] (return 4))
(defn ^:pub ^I32 of-box-max [] (return 25))

(defn ^:pub ^I32 of-active [^I32 image ^I32 trigger ^I32 keyword]
  (if (and (== image 1) (and (or (== trigger 1) (== trigger 2)) (== keyword 1))) (return 1))
  (return 0))

(defn ^:pub ^I32 of-rule [^I32 incumbent ^I32 numeric ^I32 incumbent-valid ^I32 candidate-valid
                         ^I32 dictionary ^I32 votes ^I32 incumbent-votes ^I32 confidence ^I32 incumbent-confidence]
  (if (== votes 0) (return 0))
  (if (and (== incumbent 1) (== incumbent-valid 1)) (return 4))
  (if (and (== numeric 1) (== candidate-valid 0)) (return 4))
  (if (and (== numeric 0) (and (== dictionary 0) (> 2 votes))) (return 5))
  (if (== incumbent 0)
    (if (>= confidence (of-insert-conf)) (return 3) (return 0)))
  (if (and (>= votes 2) (> votes incumbent-votes)) (return 1))
  (if (>= (- confidence incumbent-confidence) (of-margin)) (return 2))
  (return 0))

(defn ^:pub ^I32 of-from [] (return (owf-from)))
(defn ^:pub ^I32 of-source [^Cells words ^I32 w]
  (comment "D731: the `owords` row a fused copy was copied from, or -1 for a recorded reading (`owf-from` holds the row + 1, so a recorded word's 0 is none).")
  (return (- (ow-get words w (owf-from)) 1)))
(defn ^:pub ^I32 of-copy [^:mut ^Cells words ^I32 source ^I32 run ^I32 line]
  (comment "Oword cell 27 (`owf-from`) holds the source row + 1. The etext span, box, flags, symbols and confidence are copied verbatim; no character is emitted here.")
  (comment "The copy has no `feats` row of its own (`ev-check` 102: a feature row names exactly one word).")
  (let [^I32 row (ow-count words) ^:mut ^I32 f 0 ^:mut ^I32 value 0]
    (while (< f (ow-stride))
      (do (set value (ow-get words source f)) (cells-push words value) (set f (+ f 1))))
    (ow-set words row (owf-from) (+ source 1))
    (ow-set words row (hd-feat) -1)
    (ow-set words row (owf-run) run)
    (ow-set words row (hd-line) line)
    (return row)))

(defn ^I64 of-area [^Cells words ^I32 row]
  (let [^I64 w (- (i64 (ow-get words row (hd-x1))) (i64 (ow-get words row (hd-x0))))
        ^I64 h (- (i64 (ow-get words row (hd-y1))) (i64 (ow-get words row (hd-y0))))]
    (if (or (<= w 0) (<= h 0)) (return (i64 0)))
    (return (* w h))))

(defn ^:pub ^I32 of-root [^Cells parents ^I32 node]
  (let [^:mut ^I32 p node]
    (if (< (cells-at parents p) 0) (return -1))
    (while (!= (cells-at parents p) p) (set p (cells-at parents p)))
    (return p)))

(defn ^:pub ^I32 of-align [^Cells words ^Cells rows ^:mut ^Cells parents ^:mut ^Cells sorted]
  (comment "rows names eligible source and incumbent words. The caller filters pass, garbage and non-alphanumeric words before alignment. Invalid or oversized boxes have parent -1. Labels are canonical minima; rows are never mutated.")
  (let [^I32 n (cells-len rows) ^:mut ^I32 i 0 ^:mut ^I32 j 0 ^:mut ^I32 a 0 ^:mut ^I32 b 0
        ^:mut ^I32 pa 0 ^:mut ^I32 pb 0 ^:mut ^I64 median (i64 1)]
    (cells-drop parents 0) (cells-drop sorted 0)
    (while (< i n)
      (do (cells-push parents i)
          (if (> (of-area words (cells-at rows i)) 0)
            (do (set j (cells-len sorted)) (cells-push sorted i)
                (while (and (> j 0) (> (of-area words (cells-at rows (cells-at sorted (- j 1))))
                                       (of-area words (cells-at rows i))))
                  (do (cells-set sorted j (cells-at sorted (- j 1))) (set j (- j 1))))
                (cells-set sorted j i)))
          (set i (+ i 1))))
    (if (> (cells-len sorted) 0)
      (set median (of-area words (cells-at rows (cells-at sorted (quot (cells-len sorted) 2))))))
    (set i 0)
    (while (< i n)
      (do (set a (cells-at rows i))
          (if (or (<= (of-area words a) 0) (> (of-area words a) (* median (i64 (of-box-max)))))
            (cells-set parents i -1))
          (set i (+ i 1))))
    (set i 0)
    (while (< i n)
      (do (if (>= (cells-at parents i) 0)
            (do (set a (cells-at rows i)) (set j 0)
                (while (< j i)
                  (do (if (>= (cells-at parents j) 0)
                        (do (set b (cells-at rows j))
                            (if (== (ow-get words a (hd-page)) (ow-get words b (hd-page)))
                              (if (>= (ev-overlap-small (ow-get words a (hd-x0)) (ow-get words a (hd-y0)) (ow-get words a (hd-x1)) (ow-get words a (hd-y1))
                                                       (ow-get words b (hd-x0)) (ow-get words b (hd-y0)) (ow-get words b (hd-x1)) (ow-get words b (hd-y1))) 500)
                                (do (set pa (of-root parents i)) (set pb (of-root parents j))
                                    (if (< pa pb) (cells-set parents pb pa) (cells-set parents pa pb)))))))
                      (set j (+ j 1))))))
          (set i (+ i 1))))
    (return n)))

