         6 116 117 110 97 105 46 0 0 0 0
         6 116 117 110 97 105 58 0 0 0 0]
  :accessors {^I32 of-kw-count [^I32 ignored]
              ^I32 of-kw-at [^I32 ignored ^I32 row ^I32 field]})

(defn ^:pub ^I32 of-keyword [^Cells text ^I32 start ^I32 count]
  (let [^:mut ^I32 r 0 ^:mut ^I32 i 0 ^:mut ^I32 cp 0 ^:mut ^I32 same 0]
    (if (or (< start 0) (or (<= count 0) (> count (- (cells-len text) start)))) (return 0))
    (while (< r (of-kw-count 0))
      (do (if (== count (of-kw-at 0 r 0))
            (do (set i 0) (set same 1)
                (while (and (< i count) (== same 1))
                  (do (set cp (cells-at text (+ start i)))
                      (if (and (>= cp 65) (<= cp 90)) (set cp (+ cp 32)))
                      (if (!= cp (of-kw-at 0 r (+ i 1))) (set same 0))
                      (set i (+ i 1))))
                (if (== same 1) (return 1))))
          (set r (+ r 1))))
    (return 0)))
