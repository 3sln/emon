  :accessors {^I32 of-kw-count [^I32 ignored]
              ^I32 of-kw-at [^I32 ignored ^I32 row ^I32 field]})

(defn ^:pub ^I32 of-keyword [^Cells text ^I32 start ^I32 count]
  (let [^:mut ^I32 r 0 ^:mut ^I32 i 0 ^:mut ^I32 cp 0 ^:mut ^I32 same 0]
    (if (or (< start 0) (or (<= count 0) (> count (- (cells-len text) start)))) (return 0))
    (while (< r (of-kw-count 0))
      (do (if (== count (of-kw-at 0 r 0))
            (do (set i 0) (set same 1)
                (while (and (< i count) (== same 1))
                  (do (set cp (cells-at text (+ start i)))
                      (if (and (>= cp 65) (<= cp 90)) (set cp (+ cp 32)))
                      (if (!= cp (of-kw-at 0 r (+ i 1))) (set same 0))
                      (set i (+ i 1))))
                (if (== same 1) (return 1))))
          (set r (+ r 1))))
    (return 0)))

;; Candidate table (stride 8): source run, source-ref start, source-ref count,
;; distinct-reading votes, maximum mean confidence, all dictionary,
;; all format-valid, any decimal digit. Row zero is always the incumbent.
;; A reading table (stride 3) holds run, source-ref start and source-ref count.
;; Scratch arenas are caller-owned. Nothing here writes source evidence/text.
(defn ^:pub ^I32 of-cstride [] (return 8))
(defn ^:pub ^I32 of-cget [^Cells c ^I32 row ^I32 field]
  (return (cells-at c (+ (* row (of-cstride)) field))))
(defn ^I32 of-fold [^I32 cp]
  (if (and (>= cp 65) (<= cp 90)) (return (+ cp 32)))
  (return cp))

(defn ^I32 of-word-same [^Cells words ^Cells text ^I32 a ^I32 b ^I32 fold]
  (let [^I32 n (ow-get words a (hd-tlen))
        ^I32 sa (ow-get words a (hd-tstart)) ^I32 sb (ow-get words b (hd-tstart))
        ^:mut ^I32 i 0 ^:mut ^I32 ca 0 ^:mut ^I32 cb 0]
    (if (!= n (ow-get words b (hd-tlen))) (return 0))
    (while (< i n)
      (do (set ca (cells-at text (+ sa i))) (set cb (cells-at text (+ sb i)))
          (if (== fold 1) (do (set ca (of-fold ca)) (set cb (of-fold cb))))
          (if (!= ca cb) (return 0))
          (set i (+ i 1))))
    (return 1)))

