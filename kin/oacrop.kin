;; Fixed x3 Lanczos view kernel. Coefficients are normalized sinc(x)*sinc(x/3)
;; at six rational phases, rounded to Q22. No host floating point or filtering.
(ns emon.oacrop
  (:require [emon.lang :refer [I32 Bitmap BitmapSet]]
            [emon.port :refer [bms-put bitmap-w bitmap-h bitmap-u8 bitmap-set-u8]]
            [kin.lang :refer [defn defdata return let set while if do + - * quot < >=]]))
(defdata oa-lanczos
  :emitter kin.lang/flat-array
  :data [0 0 4194304 0 0 0 104187 -440792 3991300 704301 -178503 13811 130930 -614324 3413641 1603887 -393168 53338 102578 -569878 2564452 2564452 -569878 102578 53338 -393168 1603887 3413641 -614324 130930 13811 -178503 704300 3991301 -440792 104187]
  :accessors {^I32 oa-weight [^I32 ignored ^I32 i]})
(defn ^I32 crop-floor [^I32 n]
  (if (>= n 0) (return (quot n 6))) (return (- 0 (quot (+ (- 0 n) 5) 6))))
(defn ^I32 crop-clamp [^I32 n]
  (let [^I32 v (quot (+ n 2097152) 4194304)]
    (if (< v 0) (return 0)) (if (>= v 256) (return 255)) (return v)))
(defn ^:pub ^I32 oa-three [^BitmapSet bms ^I32 vid ^I32 tid ^Bitmap src]
  (let [^I32 w (bitmap-w src) ^I32 h (bitmap-h src)
        ^Bitmap tmp (bms-put bms tid (* w 3) h 1)
        ^Bitmap dst (bms-put bms vid (* w 3) (* h 3) 1)
        ^:mut ^I32 x 0 ^:mut ^I32 y 0 ^:mut ^I32 n 0 ^:mut ^I32 base 0
        ^:mut ^I32 phase 0 ^:mut ^I32 j 0 ^:mut ^I32 p 0 ^:mut ^I32 sum 0]
    (while (< y h)
      (do (set x 0)
          (while (< x (* w 3))
            (do (set n (- (* x 2) 2)) (set base (crop-floor n)) (set phase (- n (* base 6)))
                (set sum 0) (set j 0)
                (while (< j 6)
                  (do (set p (+ base (- j 2))) (if (< p 0) (set p 0)) (if (>= p w) (set p (- w 1)))
                      (set sum (+ sum (* (oa-weight 0 (+ (* phase 6) j)) (bitmap-u8 src p y 0)))) (set j (+ j 1))))
                (bitmap-set-u8 tmp x y 0 (crop-clamp sum)) (set x (+ x 1))))
          (set y (+ y 1))))
    (set y 0)
    (while (< y (* h 3))
      (do (set x 0) (set n (- (* y 2) 2)) (set base (crop-floor n)) (set phase (- n (* base 6)))
          (while (< x (* w 3))
            (do (set sum 0) (set j 0)
                (while (< j 6)
                  (do (set p (+ base (- j 2))) (if (< p 0) (set p 0)) (if (>= p h) (set p (- h 1)))
                      (set sum (+ sum (* (oa-weight 0 (+ (* phase 6) j)) (bitmap-u8 tmp x p 0)))) (set j (+ j 1))))
                (bitmap-set-u8 dst x y 0 (crop-clamp sum)) (set x (+ x 1))))
          (set y (+ y 1))))
    (return 0)))
