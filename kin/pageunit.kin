;; PAGE UNITS (P7.U; SPEC 2.2, 7.3, 12.1; D195, D196, D199, D207). emon's own module (D039).
;;
;; A conversion is a DOCUMENT PASS (everything that reads the input: the text layer, the catalogue, the tagged tree, and
;; `pu-plan` below, which decides for every page what its unit will ask), then ONE PAGE UNIT PER PAGE, each its own
;; plan/fulfil loop with its own answers, requests and `BitmapSet` (so the host holds one page's bitmaps, not the
;; document's), then the DOCUMENT UNIT (stage 3). A page unit reads the document pass's arenas and NEVER the input: a scanned
;; page's `decode` names the input by index and byte span, and the host reads it.
;;
;; A page unit is re-run from scratch on every round, like every unit (SPEC 7.3), so it WRITES NOTHING until the round in
;; which every answer it asked for is in: a call that asks leaves the arenas as it found them.
;;
;; THE PAGE'S LAYER. A page's words and lines are the document's `words`/`lines` rows of that page, in the text layer's own
;; layouts (the flow `fw`/`fl` of P7.0 is their copy); a scanned page's OCR lines are appended to them by `sc-page` (D213). Stage 3
;; is handed the same arenas as before, so a run whose engines answer `unsupported` gives every gate the Model it always gave
;; (D195 (3)).
;;
;; FUSION (P7.3, switched on by P7.S). A BORN-DIGITAL page is OCR'd under `always` (D200: D212 (3) is superseded) and under `auto` when it calls for
;; it, as `emon.rasterplan`'s `rp-plan` decided in the document pass (`ask` in the page's plan row: SPEC 8.3's table): the page's two rasters
;; (`pu-ask-rasters`, one round), then, under `ocr-scope: full`, the OCR of the one with its text, or, under `witness`, the OCR of the one without it
;; and the witness lines (a second round; a round 3 reads the whole page when the witnesses disagree, `rp-weak`); and, when the answers are in and ok, it
;; writes the OCR's evidence (`sc-answer`) and aligns the page (`xa-page`: its correspondence groups in `cg`/`refs`) and scores it (`hl-page`). WHICH
;; SOURCE WINS is not decided here: arbitration needs the document's verdict on every font (`hl-doc`: an encoding is a document fact), so `emon.arbiter`
;; runs in the document unit (D285). A page whose renders or OCR came back `unsupported` or failed is left as the text layer made it, which is what a
;; run with no engine gives, byte for byte. (`fuse`, the Engines' flags: bit 2 is the hidden test setting `no-retarget`; bit 1 was `ocr-born-digital`,
;; removed when the policy was switched.)
;;
;; IDS are `emon.plan`'s `pu-id` (D207).
(ns emon.pageunit
  (:require [emon.lang :refer [I32 I64 Cells Src BitmapSet i64 i32 add64 mul64]]
            [emon.port :refer [cells-len cells-at cells-set cells-drop cells-push bms-has bms-get bitmap-w bitmap-h]]
            [emon.pdfsrc :refer [ps-missed]]
            [emon.plan :refer [rq-decode rq-render an-find an-ok an-arg flt-dct us-requests us-done
                               pu-id pi-render-text pi-render-no-text pi-decode pi-ocr lay-full lay-no-text]]
            [emon.evidence :refer [im-get im-count wd-get wd-count hd-page mf-page mf-x0 mf-y0 mf-x1 mf-y1 mf-obj vw-new vk-render ol-count ow-count ev-rot-median or-get orf-lcount
                                   ev-page-row ep-get epf-width epf-height
                                   or-count op-region op-first]]
            [emon.retarget :refer [rt-prep rt-plan rt-record rt-adopt rt-upright rt-witness rt-run-meta rt-pad]]
            [emon.rasterplan :refer [rp-w rp-f-ask rp-f-wat rp-f-wn rp-f-scripts rp-ww rp-ask-none rp-ask-full rp-ask-witness rp-plan rp-request rp-weak
                                     ri-escalate ri-witness ri-none]]
            [emon.player :refer [cg-count]]
            [emon.pdfdoc :refer [pd-pg-count pd-pg-crop pd-pg-rotate]]
            [emon.scan :refer [sc-eligible sc-dct-span sc-request sc-page sc-page-view sc-page-evidence sc-emit-sel sc-prep sc-lang sc-answer]]
            [emon.pageink :refer [pn-has pn-mark pn-undo pn-ink pn-features pn-k-text pn-k-clean]]
            [emon.sealpx :refer [sx-find sx-plan sx-record sx-drop-lines]]
            [emon.sigpx :refer [sp-find sp-record sp-drop-lines]]
            [emon.xalign :refer [xa-page]]
            [emon.health :refer [hl-page-fw]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot bit-and]]))

;; The resolution of a born-digital page's rasters (D199).
(defn ^:pub ^I32 pu-dpi [] (return 300))

;; The plan: PU-W cells a page. kind 0: no request of the page's own (no text layer, no image to read); 1: a scanned
;; page, one DCT image covering it (D212); 2: born digital (any word, hidden or not).
;; Cells 10-13 are `emon.rasterplan`'s (what a born-digital page asks, its witness lines, its scripts; the witness rows follow the page rows).
(defn ^:pub ^I32 pu-w [] (return (rp-w)))
(defn ^:pub ^I32 pu-kind [^Cells pl ^I32 i] (return (cells-at pl (* i (pu-w)))))
(defn ^:pub ^I32 pu-field [^Cells pl ^I32 i ^I32 k] (return (cells-at pl (+ (* i (pu-w)) k))))
;; fields: 1 object, 2 span start, 3 span length, 4-7 the image's box, 8-9 the page's size (centipoints)
(defn ^:pub ^I32 pk-none [] (return 0))
(defn ^:pub ^I32 pk-scan [] (return 1))
(defn ^:pub ^I32 pk-born [] (return 2))

(defn ^:pub ^I32 pu-plan [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                          ^Cells pg ^Cells im ^Cells words ^I32 policy ^I32 scope ^Cells fw ^Cells fl ^Cells et ^Cells hl
                          ^:mut ^Cells sp ^:mut ^Cells pl ^:mut ^Cells rs1 ^:mut ^Cells rs2]
  (comment "THE DOCUMENT PASS'S PLAN, one row of `pu-w` cells a page. A page with no `words` row at all and one image that")
  (comment "`sc-eligible` and `sc-dct-span` accept is a `pk-scan` page (its bytes are located here, the one place a page's work")
  (comment "reads the input); every other page is `pk-none` and is left as the text layer made it (D212). `policy` 0 plans")
  (comment "nothing. Then `emon.rasterplan`'s `rp-plan` says what each born-digital page asks (HOOK P7.S): by `policy` and `scope`,")
  (comment "from the text layer's flow `fw` `fl` `et` and health `hl` (`rs1` `rs2` are its scratch).")
  (comment "Loads objects, so `a`, `b`, `st` are overwritten and the source may miss (then the plan is not to be used).")
  (let [^I32 np (pd-pg-count pg)
        ^I32 nw (wd-count words)
        ^I32 nim (im-count im)
        ^:mut ^I32 i 0
        ^:mut ^I32 j 0
        ^:mut ^I32 jj 0
        ^:mut ^I32 w 0
        ^:mut ^I32 p 0
        ^:mut ^I32 best -1
        ^:mut ^I64 bestarea (i64 0)
        ^:mut ^I64 area (i64 0)
        ^:mut ^I32 px0 0
        ^:mut ^I32 py0 0
        ^:mut ^I32 px1 0
        ^:mut ^I32 py1 0
        ^:mut ^I32 k 0]
    (cells-drop pl 0)
    (while (< i np)
      (do (set k 0)
          (while (< k (pu-w))
            (do (cells-push pl 0)
                (set k (+ k 1))))
          (set i (+ i 1))))
    (if (== policy 0) (return 0))
    (comment "a page with any word, hidden or not, is born digital")
    (while (< w nw)
      (do (set p (wd-get words w (hd-page)))
          (if (and (>= p 1) (<= p np))
            (cells-set pl (* (- p 1) (pu-w)) 2))
          (set w (+ w 1))))
    (set i 0)
    (while (< i np)
      (do (while (and (< j nim) (< (im-get im j (mf-page)) (+ i 1)))
            (set j (+ j 1)))
          (if (and (== (pu-kind pl i) 0) (== (pd-pg-rotate pg i) 0))
            (do (set px0 (pd-pg-crop pg i 0))
                (set py0 (pd-pg-crop pg i 1))
                (set px1 (pd-pg-crop pg i 2))
                (set py1 (pd-pg-crop pg i 3))
                (set best -1)
                (set bestarea (i64 0))
                (set jj j)
                (while (and (< jj nim) (== (im-get im jj (mf-page)) (+ i 1)))
                  (do (if (== (sc-eligible im jj (- px1 px0) (- py1 py0)) 1)
                        (do (set area (mul64 (i64 (- (im-get im jj (mf-x1)) (im-get im jj (mf-x0))))
                                             (i64 (- (im-get im jj (mf-y1)) (im-get im jj (mf-y0))))))
                            (if (> area bestarea)
                              (do (set best jj)
                                  (set bestarea area)))))
                      (set jj (+ jj 1))))
                (if (>= best 0)
                  (do (if (== (sc-dct-span src ar dc a b st (im-get im best (mf-obj)) sp) 1)
                        (do (set k (* i (pu-w)))
                            (cells-set pl k 1)
                            (cells-set pl (+ k 1) (im-get im best (mf-obj)))
                            (cells-set pl (+ k 2) (cells-at sp 0))
                            (cells-set pl (+ k 3) (cells-at sp 1))
                            (cells-set pl (+ k 4) (im-get im best (mf-x0)))
                            (cells-set pl (+ k 5) (im-get im best (mf-y0)))
                            (cells-set pl (+ k 6) (im-get im best (mf-x1)))
                            (cells-set pl (+ k 7) (im-get im best (mf-y1)))
                            (cells-set pl (+ k 8) (- px1 px0))
                            (cells-set pl (+ k 9) (- py1 py0))))))
                (if (ps-missed src) (return 0))))
          (set i (+ i 1))))
    (comment ";; HOOK P7.S: the first-pass requests of the born-digital pages")
    (rp-plan np policy scope fw fl et hl im pg pl rs1 rs2)
    (return 0)))

;; The born-digital page's two rasters, asked in round 1 whenever the plan has the page ask for OCR (`ask` is not `rp-ask-none`): the page with its text and
;; without it, at 300 dpi, in one round. Answers `us-requests` when it asked, else `us-done`.
(defn ^:pub ^I32 pu-ask-rasters [^I32 i ^I32 input ^I32 ask ^Cells ans ^:mut ^Cells rq]
  (if (!= ask (rp-ask-none))
    (if (< (an-find ans (pu-id i (pi-render-text))) 0)
      (do (rq-render rq (pu-id i (pi-render-text)) input i (pu-dpi) (lay-full))
          (rq-render rq (pu-id i (pi-render-no-text)) input i (pu-dpi) (lay-no-text))
          (return (us-requests)))))
  (return (us-done)))

(defn ^I32 pu-wbox [^Cells pl ^I32 at ^I32 w ^I32 h ^I32 k]
  (comment "Witness row at cell `at`: the pixel box of its line on a render `w` x `h` at `pu-dpi`, padded by `rt-pad`, clamped to the render: k 0 x, 1 y, 2 width, 3 height.")
  (let [^I32 x0 (- (quot (* (cells-at pl (+ at 2)) (pu-dpi)) 7200) (rt-pad))
        ^I32 y0 (- (quot (* (cells-at pl (+ at 3)) (pu-dpi)) 7200) (rt-pad))
        ^I32 x1 (+ (quot (+ (* (cells-at pl (+ at 4)) (pu-dpi)) 7199) 7200) (rt-pad))
        ^I32 y1 (+ (quot (+ (* (cells-at pl (+ at 5)) (pu-dpi)) 7199) 7200) (rt-pad))
        ^:mut ^I32 bx0 x0
        ^:mut ^I32 by0 y0
        ^:mut ^I32 bx1 x1
        ^:mut ^I32 by1 y1]
    (if (< bx0 0) (set bx0 0))
    (if (< by0 0) (set by0 0))
    (if (> bx1 w) (set bx1 w))
    (if (> by1 h) (set by1 h))
    (if (== k 0) (return bx0))
    (if (== k 1) (return by0))
    (if (== k 2) (return (- bx1 bx0)))
    (return (- by1 by0))))

(defn ^:pub ^I32 pu-dry [^I32 fuse]
  (comment "1 when the page unit is asked for a DRY attempt (`fuse` bit 4; P10.2, SPEC 12.1): the part of an attempt that precedes its first write. A host that fulfils")
  (comment "in parallel runs it for the pages AHEAD of the one the loop is on, to learn what they will ask (a render, a decode, the OCR of the page) and have it answered")
  (comment "meanwhile; it asks exactly what the real attempt asks in those rounds, then answers `us-done` having changed nothing, whether or not the real attempt")
  (comment "would go on to ask more. Its result is never used but as the requests it wrote: the real unit runs afterwards, as it always did.")
  (return (quot (bit-and fuse 4) 4)))

(defn ^I32 pu-px [^BitmapSet bms ^I32 id ^I32 fuse]
  (comment "1 when the page unit may read the pixels of the bitmap under `id`: it has them, and the hidden setting `no-retarget` (`fuse` bit 2) does")
  (comment "not say to leave them (the Engine then does what it did before P7.4: no ink layers, no targeted pass; a measurement's baseline).")
  (if (== (bit-and fuse 2) 2) (return 0))
  (return (pn-has bms id)))

;; FUSION: a born-digital page's rasters, the OCR the plan asks (`full`: the whole render with the text; `witness`: the one without it and the witness lines,
;; and when they disagree the whole of the one with it), the ink layers of the rasters and the targeted passes the first pass calls for (`emon.retarget`), and
;; the page's alignment and health. Answers `us-requests` when it asked, else `us-done`; writes only in the round in which everything it asked for is in (see
;; the head of this file): an attempt that asks gives back the evidence it wrote to decide (`pn-undo`).
(defn ^I32 pu-run-born [^I32 i ^I32 input ^I32 fuse ^Cells pl ^Cells ans ^:mut ^Cells rq ^Cells loc ^BitmapSet bms
                        ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells etext ^:mut ^Cells feats
                        ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                        ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                        ^Cells fw ^Cells fl ^:mut ^Cells hl ^:mut ^Cells refs ^:mut ^Cells cg ^:mut ^Cells tlines
                        ^:mut ^Cells xscr ^:mut ^Cells xgp ^:mut ^Cells xdp ^:mut ^Cells xta ^:mut ^Cells xtb ^:mut ^Cells xtt
                        ^:mut ^Cells scr ^:mut ^Cells images ^:mut ^Cells words ^:mut ^Cells lines
                        ^:mut ^Cells inks ^:mut ^Cells comps ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tpts
                        ^:mut ^Cells ws ^:mut ^Cells ws2 ^:mut ^Cells sv ^:mut ^Cells aux ^:mut ^Cells snap ^:mut ^Cells rtp
                        ^:mut ^Cells rn ^:mut ^Cells ri ^:mut ^Cells cs ^:mut ^Cells vr ^:mut ^Cells pc ^:mut ^Cells sg ^:mut ^Cells mem
                        ^:mut ^Cells s1 ^:mut ^Cells s2 ^:mut ^Cells s3 ^:mut ^Cells s4 ^:mut ^Cells s5 ^:mut ^Cells s6]
  (let [^I32 ask (pu-field pl i (rp-f-ask))
        ^I32 scripts (pu-field pl i (rp-f-scripts))
        ^I32 nwit (pu-field pl i (rp-f-wn))
        ^I32 wat (pu-field pl i (rp-f-wat))
        ^I32 rid (pu-id i (pi-render-text))
        ^I32 nid (pu-id i (pi-render-no-text))
        ^I32 oid (pu-id i (pi-ocr))
        ^I32 eid (pu-id i (ri-escalate))
        ^I32 wid (pu-id i (ri-witness))
        ^I32 ar (an-find ans rid)
        ^I32 an2 (an-find ans nid)
        ^:mut ^I32 ao -1
        ^:mut ^I32 ae -1
        ^:mut ^I32 aw -1
        ^:mut ^I32 view 0
        ^:mut ^I32 nview 0
        ^:mut ^I32 w 0
        ^:mut ^I32 h 0
        ^:mut ^I32 dpi 0
        ^:mut ^I32 w0 0
        ^:mut ^I32 nw 0
        ^:mut ^I32 w1 0
        ^:mut ^I32 w2 0
        ^:mut ^I32 w3 0
        ^:mut ^I32 ne 0
        ^:mut ^I32 run 0
        ^:mut ^I32 esc -1
        ^:mut ^I32 r0 0
        ^:mut ^I32 r1 0
        ^:mut ^I32 wrun 0
        ^:mut ^I32 weak 0
        ^:mut ^I32 j 0
        ^:mut ^I32 at 0
        ^:mut ^I32 before 0
        ^:mut ^I32 asked 0
        ^:mut ^I32 pgrow 0
        ^:mut ^I32 pgw 0
        ^:mut ^I32 pgh 0
        ^:mut ^I32 g0 0]
    (if (== ask (rp-ask-none)) (return (us-done)))
    (if (== (pu-ask-rasters i input ask ans rq) (us-requests)) (return (us-requests)))
    (if (< ar 0) (return (us-done)))
    (if (!= (an-ok ans ar) 1) (return (us-done)))
    (set w (an-arg ans ar 0))
    (set h (an-arg ans ar 1))
    (set dpi (an-arg ans ar 3))
    (set ao (an-find ans oid))
    (comment "round 2: `full` reads the render with the text, `witness` the one without it and the witness lines around the text layer's own")
    (if (== ask (rp-ask-full))
      (if (< ao 0)
        (do (rp-request rq oid rid 3 (pu-dpi) 0 0 0 0 loc scripts)
            (return (us-requests)))))
    (if (== ask (rp-ask-witness))
      (do (if (< an2 0) (return (us-done)))
          (if (!= (an-ok ans an2) 1) (return (us-done)))
          (set before (cells-len rq))
          (if (< ao 0)
            (rp-request rq oid nid 3 (pu-dpi) 0 0 0 0 loc scripts))
          (set j 0)
          (while (< j nwit)
            (do (if (< (an-find ans (+ wid j)) 0)
                  (do (set at (+ wat (* j (rp-ww))))
                      (rp-request rq (+ wid j) rid 7 (pu-dpi) (pu-wbox pl at w h 0) (pu-wbox pl at w h 1) (pu-wbox pl at w h 2) (pu-wbox pl at w h 3) loc scripts)))
                (set j (+ j 1))))
          (if (> (cells-len rq) before) (return (us-requests)))))
    (set ao (an-find ans oid))
    (if (< ao 0) (return (us-done)))
    (if (!= (an-ok ans ao) 1) (return (us-done)))
    (comment "A DRY ATTEMPT (P10.2, `pu-dry`) is a prefix of an attempt: it stops here, before the first write, having asked what the rounds up to here ask")
    (if (== (pu-dry fuse) 1) (return (us-done)))
    (pn-mark snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
    (set view (vw-new views (+ i 1) (vk-render) rid -1 w h (* dpi 100) (lay-full) -1 0 0 0 0 0))
    (set w0 (ow-count owords))
    (if (== ask (rp-ask-full))
      (set run (sc-answer ans ao (+ i 1) view oid (sc-lang loc) views epages etext oruns oblocks olines owords osyms oalts feats))
      (do (set nview (vw-new views (+ i 1) (vk-render) nid -1 w h (* dpi 100) (lay-no-text) -1 0 0 0 0 0))
          (set run (sc-answer ans ao (+ i 1) nview oid (sc-lang loc) views epages etext oruns oblocks olines owords osyms oalts feats))))
    (set nw (- (ow-count owords) w0))
    (comment "the witness lines: each one's reading is a run of its own (pass `region`, round 2, `psm` 7, the pixel box asked)")
    (set w1 (ow-count owords))
    (set r0 (or-count oruns))
    (if (== ask (rp-ask-witness))
      (do (set j 0)
          (while (< j nwit)
            (do (set aw (an-find ans (+ wid j)))
                (if (>= aw 0)
                  (if (== (an-ok ans aw) 1)
                    (do (set at (+ wat (* j (rp-ww))))
                        (set wrun (sc-answer ans aw (+ i 1) view (+ wid j) (sc-lang loc) views epages etext oruns oblocks olines owords osyms oalts feats))
                        (rt-run-meta oruns wrun (op-region) 2 7 (pu-wbox pl at w h 0) (pu-wbox pl at w h 1) (pu-wbox pl at w h 2) (pu-wbox pl at w h 3)))))
                (set j (+ j 1))))
          (set r1 (or-count oruns))
          (set weak (rp-weak nwit wat pl fw fl etext wid r0 r1 owords oruns s2 s3 s4 s5))
          (if (== weak 1)
            (do (set ae (an-find ans eid))
                (if (< ae 0)
                  (do (pn-undo snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
                      (rp-request rq eid rid 3 (pu-dpi) 0 0 0 0 loc scripts)
                      (return (us-requests))))
                (comment "the page is read whole after all: the witness lines AND the render without the text are given up (the whole render with its text holds what they read, and two readings of one line would be two candidates of one group) and the page goes on as `full`")
                (if (== (an-ok ans ae) 1)
                  (do (pn-undo snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
                      (set view (vw-new views (+ i 1) (vk-render) rid -1 w h (* dpi 100) (lay-full) -1 0 0 0 0 0))
                      (set nview (vw-new views (+ i 1) (vk-render) nid -1 w h (* dpi 100) (lay-no-text) -1 0 0 0 0 0))
                      (set w0 (ow-count owords))
                      (set nw 0)
                      (set w1 w0)
                      (set w3 w1)
                      (set esc (sc-answer ans ae (+ i 1) view eid (sc-lang loc) views epages etext oruns oblocks olines owords osyms oalts feats))
                      (rt-run-meta oruns esc (op-first) 3 3 0 0 0 0)
                      (set ne (- (ow-count owords) w3))))))))
    (set w2 w1)
    (if (== ask (rp-ask-witness))
      (do (set w2 (ow-count owords))
          (if (>= esc 0) (set w2 w3))))
    (comment "the ink layers, where the transcript or the Renderer gave pixels: those of the raster the OCR read, then the tracer's on the text-free one")
    (if (== (pu-px bms rid fuse) 1)
      (do (pn-ink (+ i 1) view bms (pn-k-text) (bms-get bms rid) (* dpi 100) 0 views inks comps rules prims tpts tlines refs ws sv aux
                  rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6)
          (if (== (pu-px bms nid fuse) 1)
            (do (if (== ask (rp-ask-full))
                  (set nview (vw-new views (+ i 1) (vk-render) nid -1 w h (* dpi 100) (lay-no-text) -1 0 0 0 0 0)))
                (pn-ink (+ i 1) nview bms (pn-k-clean) (bms-get bms nid) (* dpi 100) 1 views inks comps rules prims tpts tlines refs ws2 sv aux
                        rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6)))
          (if (== ask (rp-ask-full))
            (pn-features (+ i 1) bms (pn-k-text) (bms-get bms rid) oid w0 nw ws comps owords feats scr)
            (do (if (== (pu-px bms nid fuse) 1)
                  (pn-features (+ i 1) bms (pn-k-clean) (bms-get bms nid) oid w0 nw ws2 comps owords feats scr))
                (comment "the witness lines' words and, when the page escalated, the whole render's: one span, one pass over the text raster (the engine's binary of the escalated run is not used)")
                (if (>= esc 0) (set w2 (+ w3 ne)))
                (pn-features (+ i 1) bms (pn-k-text) (bms-get bms rid) (pu-id i (ri-none)) w1 (- w2 w1) ws comps owords feats scr)))
          (sc-prep scr)
          (rt-prep rtp)
          (if (or (== ask (rp-ask-full)) (>= esc 0))
            (do (if (>= esc 0) (set run esc))
                (set asked (rt-plan i input 1 0 rid (pu-dpi) loc ans bms (pn-k-text) (bms-get bms rid) ws oruns run olines owords rules tlines rtp rq scr))
                (comment "the seals and stamps in the text-free render's pixels (P8.2): the strips and crops that are read, asked in the same round as the targeted passes")
                (if (== (pu-px bms nid fuse) 1)
                  (do (set pgrow (ev-page-row epages (+ i 1)))
                      (set pgw (ep-get epages pgrow (epf-width)))
                      (set pgh (ep-get epages pgrow (epf-height)))
                      (sx-find (+ i 1) views nview prims inks pgw pgh s1)
                      (set asked (+ asked (sx-plan i loc ans bms (bms-get bms nid) s1 s2 s3 rq)))))
                (if (> asked 0)
                  (do (pn-undo snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
                      (return (us-requests))))))))
    (set g0 (cg-count cg))
    (xa-page (+ i 1) epages fw owords tlines feats etext refs cg xscr xgp xdp xta xtb xtt)
    (hl-page-fw (+ i 1) cg refs fw etext feats oblocks olines owords hl)
    (comment "the targeted runs are written after the page is aligned and scored: evidence, and (the body-ink one) a witness for arbitration, no candidate")
    (if (== (pu-px bms rid fuse) 1)
      (if (or (== ask (rp-ask-full)) (>= esc 0))
        (do (rt-record i view (* dpi 100) loc ans rtp views epages etext oruns oblocks olines owords osyms oalts feats)
            (rt-witness g0 (cg-count cg) cg rtp oruns owords)
            (if (== (pu-px bms nid fuse) 1)
              (do (sx-record i nview (* dpi 100) loc ans s1 views epages etext oruns oblocks olines owords osyms oalts feats refs cg s4)
                  (comment "the pen strokes over a signature line in the text-free render (P8.3): no request, no view; the groups are written with the seals'")
                  (sp-find (+ i 1) views nview rules owords etext (bms-get bms nid) pgw s5 s6)
                  (sp-record i s5 cg))))))
    (return (us-done))))

(defn ^I32 pu-run-scan [^I32 i ^I32 input ^I32 fuse ^Cells pl ^Cells ans ^:mut ^Cells rq ^Cells loc ^BitmapSet bms ^:mut ^Cells mask ^:mut ^Cells scr
                        ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells etext ^:mut ^Cells feats
                        ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                        ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                        ^:mut ^Cells words ^:mut ^Cells lines ^:mut ^Cells refs ^:mut ^Cells tlines ^:mut ^Cells cg
                        ^:mut ^Cells inks ^:mut ^Cells comps ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tpts
                        ^:mut ^Cells ws ^:mut ^Cells sv ^:mut ^Cells aux ^:mut ^Cells snap ^:mut ^Cells rtp
                        ^:mut ^Cells rn ^:mut ^Cells ri ^:mut ^Cells cs ^:mut ^Cells vr ^:mut ^Cells pc ^:mut ^Cells sg ^:mut ^Cells mem
                        ^:mut ^Cells s1 ^:mut ^Cells s2 ^:mut ^Cells s3 ^:mut ^Cells s4 ^:mut ^Cells s5 ^:mut ^Cells s6]
  (comment "A SCANNED page: `decode` of its stream, the OCR of the bitmap, the ink layers of the bitmap and the targeted passes they and the")
  (comment "first pass call for, then the lines the pipeline reads (`rt-adopt`). With no pixel in the decode answer (a transcript recorded slim) the")
  (comment "page is what it always was: the first pass's lines.")
  (let [^I32 did (pu-id i (pi-decode))
        ^I32 oid (pu-id i (pi-ocr))
        ^I32 ad (an-find ans did)
        ^:mut ^I32 ao -1
        ^:mut ^I32 pxw 0
        ^:mut ^I32 pxh 0
        ^:mut ^I32 wp 0
        ^:mut ^I32 dpi100 0
        ^:mut ^I32 vdec 0
        ^:mut ^I32 l0 0
        ^:mut ^I32 w0 0
        ^:mut ^I32 nw 0
        ^:mut ^I32 run 0
        ^:mut ^I32 nl 0
        ^:mut ^I32 rotmed 0
        ^:mut ^I32 asked 0
        ^:mut ^I32 nsel 0]
    (if (< ad 0)
      (do (rq-decode rq did input (pu-field pl i 2) (pu-field pl i 3) (flt-dct) 0)
          (return (us-requests))))
    (if (!= (an-ok ans ad) 1) (return (us-done)))
    (set pxw (an-arg ans ad 0))
    (set pxh (an-arg ans ad 1))
    (set wp (- (pu-field pl i 6) (pu-field pl i 4)))
    (set dpi100 (i32 (quot (add64 (mul64 (i64 pxw) (i64 720000)) (i64 (quot wp 2))) (i64 wp))))
    (set ao (an-find ans oid))
    (if (< ao 0)
      (do (sc-request rq oid did (quot (+ dpi100 50) 100) loc)
          (return (us-requests))))
    (if (!= (an-ok ans ao) 1) (return (us-done)))
    (if (== (pu-dry fuse) 1) (return (us-done)))
    (sc-prep scr)
    (if (== (pu-px bms did fuse) 0)
      (do (sc-page ans ao (+ i 1) oid did (pu-field pl i 8) (pu-field pl i 9) pxw pxh dpi100
                   (pu-field pl i 4) (pu-field pl i 5) (pu-field pl i 1)
                   (pu-field pl i 4) (pu-field pl i 5) (pu-field pl i 6) (pu-field pl i 7) (sc-lang loc)
                   epages views etext feats images oruns oblocks olines owords osyms oalts words lines scr)
          (cells-set mask i 2)
          (return (us-done))))
    (pn-mark snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
    (set vdec (sc-page-view epages views images (+ i 1) did (pu-field pl i 8) (pu-field pl i 9) pxw pxh dpi100
                            (pu-field pl i 4) (pu-field pl i 5) (pu-field pl i 1)
                            (pu-field pl i 4) (pu-field pl i 5) (pu-field pl i 6) (pu-field pl i 7)))
    (pn-ink (+ i 1) vdec bms (pn-k-text) (bms-get bms did) dpi100 1 views inks comps rules prims tpts tlines refs ws sv aux
            rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6)
    (set l0 (ol-count olines))
    (set w0 (ow-count owords))
    (set run (sc-page-evidence ans ao (+ i 1) oid vdec dpi100 (sc-lang loc) views epages etext oruns oblocks olines owords osyms oalts feats))
    (set nw (- (ow-count owords) w0))
    (pn-features (+ i 1) bms (pn-k-text) (bms-get bms did) oid w0 nw ws comps owords feats scr)
    (rt-prep rtp)
    (set asked (rt-plan i input 0 0 did (quot (+ dpi100 50) 100) loc ans bms (pn-k-text) (bms-get bms did) ws oruns run olines owords rules tlines rtp rq scr))
    (comment "the seals and stamps in the page's pixels (P8.2): their strips and crops are asked in the same round as the targeted passes")
    (sx-find (+ i 1) views vdec prims inks (pu-field pl i 8) (pu-field pl i 9) s1)
    (set asked (+ asked (sx-plan i loc ans bms (bms-get bms did) s1 s2 s3 rq)))
    (if (> asked 0)
      (do (pn-undo snap epages views etext feats oruns oblocks olines owords osyms oalts inks comps rules prims tpts tlines refs images words lines)
          (return (us-requests))))
    (rt-record i vdec dpi100 loc ans rtp views epages etext oruns oblocks olines owords osyms oalts feats)
    (sx-record i vdec dpi100 loc ans s1 views epages etext oruns oblocks olines owords osyms oalts feats refs cg s4)
    (comment "the pen strokes over a signature line of the scan (P8.3): the lines the first pass made of them are not the page's text")
    (sp-find (+ i 1) views vdec rules owords etext (bms-get bms did) (pu-field pl i 8) s5 s6)
    (sp-record i s5 cg)
    (set nsel (rt-adopt rtp oruns run olines owords scr))
    (set nsel (sx-drop-lines scr nsel olines owords s1))
    (set nsel (sp-drop-lines scr nsel olines owords s5))
    (rt-upright rtp run epages (+ i 1))
    (set nl (or-get oruns run (orf-lcount)))
    (set rotmed (ev-rot-median olines l0 nl))
    (sc-emit-sel olines owords osyms nsel (+ i 1) rotmed scr words lines)
    (cells-set mask i 2)
    (return (us-done))))

(defn ^:pub ^I32 pu-run-pdf [^I32 i ^I32 input ^I32 policy ^Cells pl ^Cells ans ^:mut ^Cells rq ^Cells loc
                             ^BitmapSet bms ^:mut ^Cells mask ^:mut ^Cells scr
                             ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells etext ^:mut ^Cells feats
                             ^:mut ^Cells images ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                             ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                             ^:mut ^Cells words ^:mut ^Cells lines
                             ^I32 fuse ^Cells fw ^Cells fl ^:mut ^Cells hl ^:mut ^Cells refs ^:mut ^Cells cg ^:mut ^Cells tlines
                             ^:mut ^Cells xscr ^:mut ^Cells xgp ^:mut ^Cells xdp ^:mut ^Cells xta ^:mut ^Cells xtb ^:mut ^Cells xtt
                             ^:mut ^Cells inks ^:mut ^Cells comps ^:mut ^Cells rules ^:mut ^Cells prims ^:mut ^Cells tpts
                             ^:mut ^Cells ws ^:mut ^Cells ws2 ^:mut ^Cells sv ^:mut ^Cells aux ^:mut ^Cells snap ^:mut ^Cells rtp
                             ^:mut ^Cells rn ^:mut ^Cells ri ^:mut ^Cells cs ^:mut ^Cells vr ^:mut ^Cells pc ^:mut ^Cells sg ^:mut ^Cells mem
                             ^:mut ^Cells s1 ^:mut ^Cells s2 ^:mut ^Cells s3 ^:mut ^Cells s4 ^:mut ^Cells s5 ^:mut ^Cells s6]
  (comment "The unit of PDF page `i` (0-based). A `pk-scan` page asks `decode` of its stream's bytes (id `pi-decode`), then OCR")
  (comment "of the bitmap (id `pi-ocr`); where the answers are in its evidence and lines are appended to `words` and `lines`")
  (comment "and `mask[i]` is 2 (D212). A `pk-born` page asks what its plan says (`rp-plan`: `pu-run-born`). Any other page asks nothing and is")
  (comment "left as the text layer made it. Answers `us-requests` when it asked, else `us-done`. `mask` has one cell a page, zero until a")
  (comment "page is OCR'd (the caller sizes it).")
  (if (== policy 0) (return (us-done)))
  (if (== (pu-kind pl i) (pk-born))
    (return (pu-run-born i input fuse pl ans rq loc bms epages views etext feats oruns oblocks olines owords osyms oalts
                         fw fl hl refs cg tlines xscr xgp xdp xta xtb xtt scr images words lines
                         inks comps rules prims tpts ws ws2 sv aux snap rtp rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6)))
  (if (!= (pu-kind pl i) (pk-scan)) (return (us-done)))
  (return (pu-run-scan i input fuse pl ans rq loc bms mask scr epages views etext feats images oruns oblocks olines owords osyms oalts words lines refs tlines cg
                       inks comps rules prims tpts ws sv aux snap rtp rn ri cs vr pc sg mem s1 s2 s3 s4 s5 s6)))
