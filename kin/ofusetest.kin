    (cells-push text 84)
    (cells-push text 79)
    (cells-push text 84)
    (cells-push text 65)
    (cells-push text 76)
    (cells-push text 58)
    (assert-eq (of-keyword text 0 (cells-len text)) 1 "exact keyword boundary")))

