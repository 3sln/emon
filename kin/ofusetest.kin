;; RC5 policy laws precede implementation. No corpus inputs or OCR requests.
(ns emon.ofusetest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq new-cells]]
            [emon.port :refer [cells-push cells-at cells-len cells-set]]
            [emon.evidence :refer [ow-new ow-get ow-count hd-tstart hd-tlen hd-conf hd-x0 hd-line owf-run ow-set owf-flags or-new or-set orf-pass orf-wfirst orf-wcount]]
            [emon.ofmt :refer [ofmt-valid]]
            [emon.ofuse :refer [of-active of-rule of-margin of-insert-conf of-slot-max of-copy of-from of-align of-root of-keyword of-readings of-candidates of-choice of-cget of-cstride of-null-votes of-eligible]]
            [kin.lang :refer [defn return let + *]]))

