(deftest test-policy-settings
  (assert-eq (of-margin) 300 "margin is per mille")
  (assert-eq (of-insert-conf) 700 "insertion confidence")
  (assert-eq (of-slot-max) 4 "chained incumbent bound"))

(deftest test-no-fusion-outside-triggered-image-pages
  (assert-eq (of-active 0 1 1) 0 "PDF and born digital never fuse")
  (assert-eq (of-active 1 0 1) 0 "untriggered image never fuses")
  (assert-eq (of-active 1 1 0) 0 "keyword gate is stacked")
  (assert-eq (of-active 1 1 1) 1 "photo lane")
  (assert-eq (of-active 1 2 1) 1 "thermal lane"))

(deftest test-valid-numeric-incumbent-is-protected
  (assert-eq (of-rule 1 1 1 1 1 3 0 1000 0) 4 "even unanimous perfect alternate cannot replace a valid number"))

(deftest test-numeric-candidates-must-be-format-valid
  (assert-eq (of-rule 1 1 0 0 1 3 0 1000 0) 4 "confidence and votes cannot admit malformed numbers"))

(deftest test-alpha-candidates-need-dictionary-or-agreement
  (assert-eq (of-rule 1 0 0 0 0 1 0 1000 0) 5 "unflagged high confidence is insufficient")
  (assert-eq (of-rule 1 0 0 0 1 1 0 900 600) 2 "dictionary permits exact margin")
  (assert-eq (of-rule 1 0 0 0 0 2 0 500 900) 1 "agreement can replace despite negative margin"))

(deftest test-agreement-must-beat-incumbent-votes
  (assert-eq (of-rule 1 0 0 0 0 2 2 700 700) 0 "vote tie keeps incumbent")
  (assert-eq (of-rule 1 0 0 0 0 2 1 700 700) 1 "strictly more agreeing readings"))

(deftest test-single-reading-replacement-needs-margin-300
  (assert-eq (of-rule 1 1 0 1 0 1 0 899 600) 0 "299 keeps")
  (assert-eq (of-rule 1 1 0 1 0 1 0 900 600) 2 "300 replaces"))

(deftest test-insertion-needs-confidence-700
  (assert-eq (of-rule 0 0 0 0 0 2 0 699 0) 0 "agreement does not bypass insertion floor")
  (assert-eq (of-rule 0 0 0 0 0 2 0 700 0) 3 "700 inserts")
  (assert-eq (of-rule 0 0 0 0 1 1 0 700 0) 3 "dictionary permits single-reading alpha insertion")
  (assert-eq (of-rule 0 1 0 1 0 1 0 700 0) 3 "format permits single-reading numeric insertion"))

(deftest test-no-deletion-even-when-all-other-readings-are-null
  (assert-eq (of-rule 1 0 0 0 1 0 0 1000 0) 0 "zero candidate votes keeps the selected words"))

;; These laws cover raw source copies and adversarial overlap chains before integration.
(deftest test-fused-copy-cannot-invent-characters
  (let [^Cells words (new-cells)
        ^I32 source (ow-new words 1 10 20 110 40 10 40 110 40 0 0 123 7 2 876 -1)
        ^I32 copied (of-copy words source 9 8)]
    (assert-eq (ow-get words copied (hd-tstart)) 123 "same recorded text span")
    (assert-eq (ow-get words copied (hd-tlen)) 7 "same recorded character count")
    (assert-eq (ow-get words copied (hd-conf)) 876 "same source confidence")
    (assert-eq (ow-get words copied (hd-x0)) 10 "same source box")
    (assert-eq (of-source words copied) source "source row is explicit")
    (assert-eq (of-source words source) -1 "a recorded reading is no copy")
    (assert-eq (ow-get words copied (hd-feat)) -1 "a copy has no feature row of its own")
    (assert-eq (ow-get words copied (owf-run)) 9 "synthetic run")
    (assert-eq (ow-get words copied (hd-line)) 8 "synthetic line")
    (assert-eq (ow-count words) 2 "original remains for D699")
    (assert-eq (ow-get words source (hd-line)) 2 "source row remains unchanged")))

(deftest test-slots-use-half-of-the-smaller-box-and-transitive-links
  (let [^Cells words (new-cells) ^Cells rows (new-cells) ^Cells parents (new-cells) ^Cells sorted (new-cells)]
    (ow-new words 1 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 50 0 150 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 100 0 200 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 151 0 251 100 0 0 0 0 0 0 0 1 0 900 -1)
    (cells-push rows 0) (cells-push rows 1) (cells-push rows 2) (cells-push rows 3)
    (of-align words rows parents sorted)
    (assert-eq (of-root parents 0) (of-root parents 2) "half-overlap chain is one slot")
    (assert-eq (of-root parents 3) 3 "49 percent overlap stays separate")))

(deftest test-slots-never-link-different-pages
  (let [^Cells words (new-cells) ^Cells rows (new-cells) ^Cells parents (new-cells) ^Cells sorted (new-cells)]
    (ow-new words 1 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 2 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (cells-push rows 0) (cells-push rows 1)
    (of-align words rows parents sorted)
    (assert-eq (of-root parents 0) 0 "page one")
    (assert-eq (of-root parents 1) 1 "page two")))

(deftest test-oversized-and-empty-boxes-do-not-chain-slots
  (let [^Cells words (new-cells) ^Cells rows (new-cells) ^Cells parents (new-cells) ^Cells sorted (new-cells)]
    (ow-new words 1 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 200 0 300 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 0 0 10000 10000 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 0 0 0 100 0 0 0 0 0 0 0 1 0 900 -1)
    (cells-push rows 0) (cells-push rows 1) (cells-push rows 2) (cells-push rows 3)
    (of-align words rows parents sorted)
    (assert-eq (of-root parents 0) 0 "first word stays independent")
    (assert-eq (of-root parents 1) 1 "second word stays independent")
    (assert-eq (of-root parents 2) -1 "giant box cannot bridge words")
    (assert-eq (of-root parents 3) -1 "empty box is excluded")))

(deftest test-equal-box-permutation-does-not-change-slot-membership
  (let [^Cells words (new-cells) ^Cells rows (new-cells) ^Cells parents (new-cells) ^Cells sorted (new-cells)]
    (ow-new words 1 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (ow-new words 1 0 0 100 100 0 0 0 0 0 0 0 1 0 900 -1)
    (cells-push rows 1) (cells-push rows 0)
    (of-align words rows parents sorted)
    (assert-eq (of-root parents 0) (of-root parents 1) "reverse source order links the same source rows")))

(deftest test-keyword-sample-0
  (let [^Cells text (new-cells)]
    (cells-push text 84)
    (cells-push text 79)
    (cells-push text 84)
    (cells-push text 65)
    (cells-push text 76)
    (cells-push text 58)
    (assert-eq (of-keyword text 0 (cells-len text)) 1 "exact keyword boundary")))

