;; RC5 policy laws precede implementation. No corpus inputs or OCR requests.
(ns emon.ofusetest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.test :refer [deftest assert-eq assert-text new-cells new-text TestT test-t]]
            [emon.port :refer [cells-push cells-at cells-len cells-set]]
            [emon.evidence :refer [oe-garbage ow-new ow-get ow-count hd-tstart hd-tlen hd-conf hd-x0 hd-line hd-feat owf-run ow-set owf-flags or-new or-set or-get or-count orf-pass orf-wfirst orf-wcount
                                   orf-lfirst orf-lcount ol-new ol-set ol-get ol-count olf-run lh-first lh-count op-fused ev-check ev-row ev-emit-ofuse
                                   oz-stride ozf-ifirst ozf-icount ozf-cfirst ozf-ccount ozf-rule ozf-votes ozf-ivotes ozf-nulls ozf-margin ozf-readings ozf-op]]
            [emon.scan :refer [sc-prep sc-sel-base sc-xtra-base sc-admit-floor]]
            [emon.ofmt :refer [ofmt-valid]]
            [emon.ofuse :refer [of-active of-rule of-margin of-insert-conf of-slot-max of-copy of-from of-source of-align of-root of-keyword of-readings of-candidates of-choice of-cget of-cstride of-null-votes of-eligible of-fuse of-page-keyword]]
            [kin.lang :refer [defn return let set while if do comment + - * < > >= == != and or bit-and quot]]))

