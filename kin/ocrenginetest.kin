(ns emon.ocrenginetest
  (:require [emon.lang :refer [I32 Cells]]
            [emon.ofuse :refer [of-rule of-pp-choice of-pp-year of-pp-code]]
            [emon.ocrengine :refer [oe-tag oe-id-count]]
            [emon.plan :refer [rq-ocr rq-ocr-view rq-ocr-lang rq-ocr-end view-base]]
            [emon.ocrport :refer [op-lang-first op-lang-count op-lang-at op-identity-at op-pp-lang-first op-pp-lang-count op-pp-lang-at]]
            [emon.port :refer [cells-len cells-at cells-push]]
            [emon.test :refer [deftest assert-eq new-cells]]
            [kin.lang :refer [let + -]]))

(deftest test-default-ocr-request-is-unchanged
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 at (rq-ocr r 12 7 3 1 0 0 0 0)]
    (rq-ocr-lang r 101 110 103 0)
    (rq-ocr-end r at)
    (oe-tag r scratch 0)
    (assert-eq (cells-len r) 11 "legacy request length unchanged")
    (assert-eq (cells-at r 0) 11 "record header unchanged")
    (assert-eq (op-lang-count r) 1 "one legacy language")))

(deftest test-optional-engine-identity-is-in-the-request-not-the-language-list
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 at (rq-ocr r 12 7 3 1 0 0 0 0)]
    (rq-ocr-lang r 101 110 103 0)
    (rq-ocr-end r at)
    (oe-tag r scratch 1)
    (assert-eq (cells-len r) (+ 14 (oe-id-count 0)) "identity extends request key")
    (assert-eq (cells-at r 0) (cells-len r) "record length includes identity")
    (assert-eq (cells-at r 11) -3100 "identity marker")
    (assert-eq (cells-at r 12) 1 "PP-OCR engine")
    (assert-eq (op-lang-count r) 1 "identity is not a language")
    (assert-eq (op-lang-at r 0) 1701734144 "English language unchanged")))

(deftest test-queued-ocr-requests-are-tagged-idempotently
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 at (rq-ocr r 12 7 3 1 0 0 0 0)]
    (rq-ocr-lang r 101 110 103 0)
    (rq-ocr-end r at)
    (oe-tag r scratch 1)
    (oe-tag r scratch 1)
    (assert-eq (cells-len r) (+ 14 (oe-id-count 0)) "exactly one identity trailer")
    (assert-eq (cells-at r 0) (cells-len r) "canonical record length")
    (assert-eq (op-lang-count r) 1 "English remains the only language")))

(deftest test-mixed-queued-views-keep-hashes-and-exactly-one-trailer
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 first (+ 14 (oe-id-count 0))
        ^I32 at (rq-ocr r 12 7 3 1 0 0 0 0)]
    (rq-ocr-lang r 101 110 103 0)
    (rq-ocr-end r at)
    (let [^I32 view (rq-ocr-view r 13 (+ (view-base) 1) 99 -3100 3 1 0 0 0 0)]
      (rq-ocr-lang r 101 110 103 0)
      (rq-ocr-end r view))
    (oe-tag r scratch 1)
    (oe-tag r scratch 1)
    (assert-eq (cells-at r 0) first "first request length")
    (assert-eq (cells-at r first) (+ 16 (oe-id-count 0)) "view request length")
    (assert-eq (cells-len r) (+ (+ 30 (oe-id-count 0)) (oe-id-count 0)) "two canonical records")
    (assert-eq (cells-at r (+ first 11)) -3100 "hash cell is not a trailer marker")
    (assert-eq (cells-at r (+ first 13)) -3100 "view trailer follows its language")))

(deftest test-compact-crops-over-views-have-an-independent-identity-tail
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 at (rq-ocr r 12 (+ (view-base) 120) 7 1 1536 18 144 57)]
    (rq-ocr-end r at)
    (oe-tag r scratch 1)
    (oe-tag r scratch 1)
    (assert-eq (op-identity-at r) 10 "compact view has no hash cells or languages")
    (assert-eq (op-lang-first r) 7 "tagged compact layout")
    (assert-eq (op-lang-count r) 0 "shared helper excludes the trailer")
    (assert-eq (op-pp-lang-first r 123 456) 7 "compact layout")
    (assert-eq (op-pp-lang-count r 7) 0 "identity is not parsed as language")
    (assert-eq (cells-len r) (+ 13 (oe-id-count 0)) "one canonical trailer")))

(deftest test-actual-view-hash-disambiguates-language-shaped-hash-cells
  (let [^Cells compact (new-cells) ^Cells hashed (new-cells) ^Cells scratch (new-cells)
        ^I32 at (rq-ocr compact 12 (+ (view-base) 1) 7 1 0 0 0 0)]
    (rq-ocr-lang compact 76 97 116 110)
    (rq-ocr-lang compact 101 110 103 0)
    (rq-ocr-end compact at)
    (oe-tag compact scratch 1)
    (let [^I32 view (rq-ocr-view hashed 13 (+ (view-base) 1) 1281455214 1701734144 7 1 0 0 0 0)]
      (rq-ocr-end hashed view))
    (oe-tag hashed scratch 1)
    (assert-eq (op-pp-lang-first compact 123 456) 7 "two compact languages")
    (assert-eq (op-pp-lang-count compact 7) 2 "both languages retained")
    (assert-eq (op-pp-lang-at compact 7 1) 1701734144 "English retained")
    (assert-eq (op-pp-lang-first hashed 1281455214 1701734144) 9 "verified hashes are not languages")
    (assert-eq (op-pp-lang-count hashed 9) 0 "hashed view has no language")))

;; OP1b arbitration laws precede activation: calibrated scores share the
;; existing 0..1000 scale; a lone PP reading cannot erase guarded incumbents.
(deftest test-pp-calibrated-reading-obeys-incumbent-guards
  (assert-eq (of-rule 1 1 1 1 0 1 1 883 200) 4 "valid incumbent number stays")
  (assert-eq (of-rule 1 0 0 0 0 1 1 883 200) 5 "unknown lexical singleton stays")
  (assert-eq (of-rule 1 0 0 0 1 1 1 883 584) 0 "299 calibrated margin insufficient")
  (assert-eq (of-rule 1 0 0 0 1 1 1 883 583) 2 "300 calibrated margin sufficient")
  (assert-eq (of-rule 1 0 0 0 0 2 1 883 950) 1 "independent agreement can justify replacement")
  (assert-eq (of-rule 0 1 0 1 0 1 0 883 0) 3 "calibrated valid numeric insertion"))

(deftest test-optional-fusion-tags-only-the-additional-reading
  (let [^Cells r (new-cells) ^Cells scratch (new-cells)
        ^I32 first (rq-ocr r 272 260 3 1 0 0 0 0)]
    (rq-ocr-end r first)
    (let [^I32 extra (rq-ocr r 279 260 3 1 0 0 0 0)] (rq-ocr-end r extra))
    (oe-tag r scratch 2)
    (assert-eq (cells-at r 0) 10 "Tesseract request key unchanged")
    (assert-eq (cells-at r 10) (+ 13 (oe-id-count 0)) "only additional reading is tagged")
    (assert-eq (cells-at r 20) -3100 "PP identity on additional reading")
    (oe-tag r scratch 2)
    (assert-eq (cells-at r 0) 10 "repeated rounds preserve Tesseract")
    (assert-eq (cells-at r 10) (+ 13 (oe-id-count 0)) "PP tag remains canonical")))

;; A joined geometric slot is not permission to drop its incumbent tokens.
(deftest test-additional-reading-cannot-truncate-a-text-slot
  (let [^Cells c (new-cells)]
    ;; run/ref/count/votes/conf/dictionary/format/digit
    (cells-push c 0) (cells-push c 0) (cells-push c 2) (cells-push c 1)
    (cells-push c 100) (cells-push c 0) (cells-push c 0) (cells-push c 0)
    (cells-push c 1) (cells-push c 2) (cells-push c 1) (cells-push c 2)
    (cells-push c 883) (cells-push c 1) (cells-push c 0) (cells-push c 0)
    (assert-eq (of-pp-choice c 2) -1 "agreement cannot delete a header token")))

(deftest test-additional-reading-cannot-drop-a-split-number-token
  (let [^Cells c (new-cells)]
    (cells-push c 0) (cells-push c 0) (cells-push c 2) (cells-push c 1)
    (cells-push c 100) (cells-push c 0) (cells-push c 0) (cells-push c 1)
    (cells-push c 1) (cells-push c 2) (cells-push c 1) (cells-push c 2)
    (cells-push c 883) (cells-push c 0) (cells-push c 1) (cells-push c 1)
    (assert-eq (of-pp-choice c 2) -1 "format alone cannot delete a selected token")))

(deftest test-additional-reading-protects-an-existing-year-range
  (let [^Cells text (new-cells)]
    (cells-push text 50) (cells-push text 48) (cells-push text 48) (cells-push text 53)
    (cells-push text 45) (cells-push text 48) (cells-push text 54)
    (assert-eq (of-pp-year text 0 7) 1 "2005-06 is a protected incumbent format")
    (assert-eq (of-pp-year text 0 6) 0 "not a truncated year range")))

(deftest test-pp-lexicon-membership-alone-cannot-erase-a-dictionary-incumbent
  (let [^Cells c (new-cells)]
    (cells-push c 0) (cells-push c 0) (cells-push c 1) (cells-push c 1)
    (cells-push c 100) (cells-push c 1) (cells-push c 0) (cells-push c 0)
    (cells-push c 1) (cells-push c 1) (cells-push c 1) (cells-push c 1)
    (cells-push c 883) (cells-push c 1) (cells-push c 0) (cells-push c 0)
    (assert-eq (of-pp-choice c 1) -1 "an incumbent dictionary word needs independent agreement")))

;; OP1c: repeated identifiers can support an insertion, never a replacement.
;; Amounts, times and year ranges stay in their existing format policies.
(deftest test-repeated-code-grammar-does-not-reclassify-protected-formats
  (let [^Cells code (new-cells) ^Cells price (new-cells) ^Cells year (new-cells)
        ^Cells time (new-cells) ^Cells word (new-cells)]
    (cells-push code 65) (cells-push code 66) (cells-push code 45) (cells-push code 49)
    (cells-push price 82) (cells-push price 77) (cells-push price 53) (cells-push price 46) (cells-push price 48) (cells-push price 48)
    (cells-push year 50) (cells-push year 48) (cells-push year 48) (cells-push year 53) (cells-push year 45) (cells-push year 48) (cells-push year 54)
    (cells-push time 50) (cells-push time 49) (cells-push time 58) (cells-push time 50) (cells-push time 56)
    (cells-push word 80) (cells-push word 65) (cells-push word 78) (cells-push word 68)
    (assert-eq (of-pp-code code 0 4) 1 "alphanumeric identifier")
    (assert-eq (of-pp-code price 0 6) 0 "currency is not a repeated identifier")
    (assert-eq (of-pp-code year 0 7) 0 "source year range remains protected")
    (assert-eq (of-pp-code time 0 5) 0 "source time remains protected")
    (assert-eq (of-pp-code word 0 4) 0 "PAND/PANO failure band is not an identifier")))
