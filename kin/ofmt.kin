;; RC5 numeric grammar over recorded code points. This validates; it never repairs text.
(ns emon.ofmt
  (:require [emon.lang :refer [I32 I64 Cells i64]]
            [emon.port :refer [cells-at cells-len cells-drop cells-push cells-set]]
            [kin.lang :refer [defdata defn return let set while if do comment + - * < > <= >= == != and or quot rem]]))

;; Decimal digit ranges from the vendored UnicodeData.txt (same Nd class as regex \d).
(defdata fmt-decimal
  :emitter kin.lang/flat-array
  :stride 2
  :data [1632 1641
         1776 1785
         1984 1993
         2406 2415
         2534 2543
         2662 2671
         2790 2799
         2918 2927
         3046 3055
         3174 3183
         3302 3311
         3430 3439
         3558 3567
         3664 3673
         3792 3801
         3872 3881
         4160 4169
         4240 4249
         6112 6121
         6160 6169
         6470 6479
         6608 6617
         6784 6793
         6800 6809
         6992 7001
         7088 7097
         7232 7241
         7248 7257
         42528 42537
         43216 43225
         43264 43273
         43472 43481
         43504 43513
         43600 43609
         44016 44025
         65296 65305
         66720 66729
         68912 68921
         68928 68937
         69734 69743
         69872 69881
         69942 69951
         70096 70105
         70384 70393
         70736 70745
         70864 70873
         71248 71257
         71360 71369
         71376 71395
         71472 71481
         71904 71913
         72016 72025
         72688 72697
         72784 72793
         73040 73049
         73120 73129
         73184 73193
         73552 73561
         90416 90425
         92768 92777
         92864 92873
         93008 93017
         93552 93561
         118000 118009
         120782 120831
         123200 123209
         123632 123641
         124144 124153
         124401 124410
         125264 125273
         130032 130041]
  :accessors {^I32 fmt-decimal-count [^I32 ignored]
              ^I32 fmt-decimal-at [^I32 ignored ^I32 row ^I32 field]})

(defn ^:pub ^I32 fmt-digit [^I32 cp]
  (if (and (>= cp 48) (<= cp 57)) (return 1))
  (if (< cp 128) (return 0))
  (let [^:mut ^I32 r 0]
    (while (< r (fmt-decimal-count 0))
      (do (if (< cp (fmt-decimal-at 0 r 0)) (return 0))
          (if (<= cp (fmt-decimal-at 0 r 1)) (return 1))
          (set r (+ r 1))))
    (return 0)))
(defn ^I32 fmt-fold [^I32 cp]
  (if (and (>= cp 65) (<= cp 90)) (return (+ cp 32)))
  (return cp))
(defn ^I32 fmt-sep [^I32 cp]
  (if (or (== cp 46) (== cp 44)) (return 1))
  (return 0))
(defn ^I32 fmt-date-sep [^I32 cp]
  (if (or (== cp 47) (or (== cp 46) (== cp 45))) (return 1))
  (return 0))
(defn ^I32 fmt-digits [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i start]
    (while (< i end)
      (do (if (== (fmt-digit (cells-at text i)) 0) (return i)) (set i (+ i 1))))
    (return i)))

(defn ^I32 fmt-amount [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i start ^:mut ^I32 first 0 ^:mut ^I32 n 0 ^:mut ^I32 tail 0 ^:mut ^I32 groups 0]
    (if (>= i end) (return 0))
    (if (or (== (cells-at text i) 45) (== (cells-at text i) 8722)) (set i (+ i 1)))
    (if (< i end)
      (if (or (== (cells-at text i) 36) (or (== (cells-at text i) 8364) (== (cells-at text i) 163)))
        (set i (+ i 1))
        (if (< (+ i 1) end)
          (if (and (== (fmt-fold (cells-at text i)) 114)
                   (or (== (fmt-fold (cells-at text (+ i 1))) 109) (== (fmt-fold (cells-at text (+ i 1))) 112)))
            (set i (+ i 2))))))
    (set first i) (set i (fmt-digits text i end)) (set n (- i first))
    (if (== n 0) (return 0))
    (if (== i end) (return 1))
    (comment "A plain amount admits one or two decimal places, of any integer width.")
    (if (== (fmt-sep (cells-at text i)) 1)
      (do (set tail (fmt-digits text (+ i 1) end))
          (if (and (== tail end) (and (>= (- tail i) 2) (<= (- tail i) 3))) (return 1))))
    (comment "Grouped amounts start with one to three digits; each grouping is three digits, then optional decimals and trailing minus.")
    (if (> n 3) (return 0))
    (while (< i end)
      (do (if (== (cells-at text i) 45)
            (if (== (+ i 1) end) (return 1) (return 0)))
          (if (== (fmt-sep (cells-at text i)) 0) (return 0))
          (set first (+ i 1)) (set tail (fmt-digits text first end)) (set n (- tail first))
          (if (== n 3) (set groups (+ groups 1))
            (if (and (>= n 1) (<= n 2))
              (do (if (== tail end) (return 1))
                  (if (and (== (+ tail 1) end) (== (cells-at text tail) 45)) (return 1))
                  (return 0))
              (return 0)))
          (set i tail)))
    (if (>= groups 0) (return 1))
    (return 0)))

(defn ^I32 fmt-quantity [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i start ^:mut ^I32 first 0 ^:mut ^I32 n 0]
    (if (>= i end) (return 0))
    (if (== (fmt-fold (cells-at text i)) 120) (set i (+ i 1)))
    (set first i) (set i (fmt-digits text i end)) (set n (- i first))
    (if (or (< n 1) (> n 3)) (return 0))
    (if (< i end) (if (== (fmt-fold (cells-at text i)) 120) (set i (+ i 1))))
    (if (== i end) (return 1))
    (return 0)))

(defn ^I32 fmt-date [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i (fmt-digits text start end) ^:mut ^I32 a 0 ^:mut ^I32 b 0 ^:mut ^I32 c 0 ^:mut ^I32 first 0]
    (set a (- i start))
    (if (or (== a 0) (>= i end)) (return 0))
    (if (== (fmt-date-sep (cells-at text i)) 0) (return 0))
    (set first (+ i 1)) (set i (fmt-digits text first end)) (set b (- i first))
    (if (or (or (< b 1) (> b 2)) (>= i end)) (return 0))
    (if (== (fmt-date-sep (cells-at text i)) 0) (return 0))
    (set first (+ i 1)) (set i (fmt-digits text first end)) (set c (- i first))
    (if (!= i end) (return 0))
    (if (and (and (>= a 1) (<= a 2)) (and (>= c 2) (<= c 4))) (return 1))
    (if (and (== a 4) (and (>= c 1) (<= c 2))) (return 1))
    (return 0)))

(defn ^I32 fmt-time [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i (fmt-digits text start end) ^:mut ^I32 first 0]
    (if (or (< (- i start) 1) (> (- i start) 2)) (return 0))
    (if (>= i end) (return 0))
    (if (!= (cells-at text i) 58) (return 0))
    (set first (+ i 1)) (set i (fmt-digits text first end))
    (if (!= (- i first) 2) (return 0))
    (if (== i end) (return 1))
    (if (!= (cells-at text i) 58) (return 0))
    (set first (+ i 1)) (set i (fmt-digits text first end))
    (if (and (== i end) (== (- i first) 2)) (return 1))
    (return 0)))

(defn ^I32 fmt-percent [^Cells text ^I32 start ^I32 end]
  (let [^:mut ^I32 i (fmt-digits text start end) ^:mut ^I32 first 0]
    (if (or (< (- i start) 1) (> (- i start) 3)) (return 0))
    (if (>= i end) (return 0))
    (if (== (fmt-sep (cells-at text i)) 1)
      (do (set first (+ i 1)) (set i (fmt-digits text first end))
          (if (or (< (- i first) 1) (> (- i first) 2)) (return 0))))
    (if (>= i end) (return 0))
    (if (and (== (+ i 1) end) (== (cells-at text i) 37)) (return 1))
    (return 0)))

(defn ^:pub ^I32 ofmt-valid [^Cells text ^I32 start ^I32 count]
  (if (or (< start 0) (or (<= count 0) (> start (cells-len text)))) (return 0))
  (if (> count (- (cells-len text) start)) (return 0))
  (let [^I32 end (+ start count)]
    (if (== (fmt-amount text start end) 1) (return 1))
    (if (== (fmt-quantity text start end) 1) (return 1))
    (if (== (fmt-date text start end) 1) (return 1))
    (if (== (fmt-time text start end) 1) (return 1))
    (return (fmt-percent text start end))))

;; D786: arithmetic amounts have a deliberately narrower, unambiguous grammar
;; than ofmt-valid. Commas group; a dot is decimal; at most six decimals and
;; fifteen digits. No float, locale guess, normalization or generated OCR text.
;; meta: valid, decimals, grouped, sign-style (0/lead1/trail2/paren3), percent,
;; digit-count, prefix-start, prefix-count. Invalid values return 0 with valid=0.
(defn ^I32 fmt-ascii-digit [^I32 cp]
  (if (and (>= cp 48) (<= cp 57)) (return 1))
  (return 0))

(defn ^I32 fmt-currency-end [^Cells text ^I32 start ^I32 end]
  (if (>= start end) (return start))
  (let [^I32 cp (cells-at text start)]
    (if (or (or (== cp 36) (== cp 8364)) (or (== cp 163) (== cp 165))) (return (+ start 1)))
    (if (< (+ start 1) end)
      (if (== (fmt-fold cp) 114)
        (if (or (== (fmt-fold (cells-at text (+ start 1))) 109) (== (fmt-fold (cells-at text (+ start 1))) 112))
          (return (+ start 2))
          (if (and (< (+ start 2) end) (and (== (fmt-fold (cells-at text (+ start 1))) 115) (== (cells-at text (+ start 2)) 46)))
            (return (+ start 3))))))
    (if (< (+ start 2) end)
      (if (or (and (== (fmt-fold cp) 117) (and (== (fmt-fold (cells-at text (+ start 1))) 115) (== (fmt-fold (cells-at text (+ start 2))) 100)))
              (and (== (fmt-fold cp) 101) (and (== (fmt-fold (cells-at text (+ start 1))) 117) (== (fmt-fold (cells-at text (+ start 2))) 114))))
        (return (+ start 3))))
    (return start)))

(defn ^:pub ^I64 fmt-value [^Cells text ^I32 start ^I32 count ^:mut ^Cells meta]
  (cells-drop meta 0)
  (let [^:mut ^I32 z 0]
    (while (< z 8) (do (cells-push meta 0) (set z (+ z 1)))))
  (if (or (< start 0) (or (<= count 0) (> start (cells-len text)))) (return (i64 0)))
  (if (> count (- (cells-len text) start)) (return (i64 0)))
  (let [^:mut ^I32 i start ^:mut ^I32 end (+ start count)
        ^:mut ^I32 negative 0 ^:mut ^I32 style 0 ^:mut ^I32 paren 0
        ^:mut ^I32 prefix start ^:mut ^I32 pend start
        ^:mut ^I32 grouped 0 ^:mut ^I32 group 0 ^:mut ^I32 dec 0
        ^:mut ^I32 digits 0 ^:mut ^I32 cp 0 ^:mut ^I64 value (i64 0)]
    (if (== (cells-at text (- end 1)) 37)
      (do (cells-set meta 4 1) (set end (- end 1))))
    (if (>= i end) (return (i64 0)))
    (set pend (fmt-currency-end text i end))
    (if (> pend i) (do (set prefix i) (set i pend)))
    (if (>= i end) (return (i64 0)))
    (if (== (cells-at text i) 40)
      (do (set paren 1) (set negative 1) (set style 3) (set i (+ i 1))))
    (if (>= i end) (return (i64 0)))
    (if (or (or (== (cells-at text i) 45) (== (cells-at text i) 8722)) (== (cells-at text i) 43))
      (do (if (== paren 1) (return (i64 0)))
          (if (!= (cells-at text i) 43) (set negative 1))
          (set style 1) (set i (+ i 1))))
    (if (== pend prefix)
      (do (set prefix i) (set pend (fmt-currency-end text i end)) (set i pend)))
    (if (== paren 1)
      (do (if (or (>= i end) (!= (cells-at text (- end 1)) 41)) (return (i64 0)))
          (set end (- end 1)))
      (if (< i end)
        (if (== (cells-at text (- end 1)) 45)
          (do (if (!= style 0) (return (i64 0)))
              (set style 2) (set negative 1) (set end (- end 1))))))
    (while (< i end)
      (do (set cp (cells-at text i))
          (if (== (fmt-ascii-digit cp) 1)
            (do (set digits (+ digits 1))
                (if (> digits 15) (return (i64 0)))
                (set value (+ (* value (i64 10)) (i64 (- cp 48))))
                (set group (+ group 1)))
            (if (== cp 44)
              (do (if (or (== group 0) (and (== grouped 0) (> group 3))) (return (i64 0)))
                  (if (and (== grouped 1) (!= group 3)) (return (i64 0)))
                  (set grouped 1) (set group 0))
              (if (== cp 46)
                (do (if (or (== group 0) (and (== grouped 1) (!= group 3))) (return (i64 0)))
                    (set i (+ i 1))
                    (while (< i end)
                      (do (set cp (cells-at text i))
                          (if (== (fmt-ascii-digit cp) 0) (return (i64 0)))
                          (set digits (+ digits 1)) (set dec (+ dec 1))
                          (if (or (> digits 15) (> dec 6)) (return (i64 0)))
                          (set value (+ (* value (i64 10)) (i64 (- cp 48))))
                          (set i (+ i 1))))
                    (if (== dec 0) (return (i64 0))))
                (return (i64 0)))))
          (set i (+ i 1))))
    (if (or (== digits 0) (and (== dec 0) (or (== group 0) (and (== grouped 1) (!= group 3))))) (return (i64 0)))
    (cells-set meta 0 1) (cells-set meta 1 dec) (cells-set meta 2 grouped)
    (cells-set meta 3 style) (cells-set meta 5 digits)
    (cells-set meta 6 prefix) (cells-set meta 7 (- pend prefix))
    (if (== negative 1) (return (- (i64 0) value)))
    (return value)))

(defn ^:pub ^I32 fmt-one-digit-sub [^Cells text ^I32 a ^I32 an ^I32 b ^I32 bn]
  (if (or (!= an bn) (or (< a 0) (< b 0))) (return 0))
  (if (or (> an (- (cells-len text) a)) (> bn (- (cells-len text) b))) (return 0))
  (let [^:mut ^I32 i 0 ^:mut ^I32 diff 0 ^:mut ^I32 x 0 ^:mut ^I32 y 0]
    (while (< i an)
      (do (set x (cells-at text (+ a i))) (set y (cells-at text (+ b i)))
          (if (!= x y)
            (do (if (or (== (fmt-ascii-digit x) 0) (== (fmt-ascii-digit y) 0)) (return 0))
                (set diff (+ diff 1))))
          (set i (+ i 1))))
    (if (== diff 1) (return 1))
    (return 0)))

(defn ^:pub ^I32 fmt-col-type [^Cells meta ^I32 decimals ^I32 grouped ^I32 percent]
  (if (< (cells-len meta) 8) (return 0))
  (if (or (== (cells-at meta 0) 0) (!= (cells-at meta 1) decimals)) (return 0))
  (if (!= (cells-at meta 4) percent) (return 0))
  (if (and (== grouped 1) (and (>= (cells-at meta 5) (+ decimals 4)) (== (cells-at meta 2) 0))) (return 0))
  (return 1))
