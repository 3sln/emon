;; The plan/fulfil PROBE (P2.5, D089): a fake unit that exercises the protocol
;; end to end, because the slice itself issues zero requests.
;;
;; `pp-unit` is what a real unit will look like, in miniature. It reads a `Src`
;; (so an async source makes it answer `us-need-bytes`), and asks for
;;
;;   round 0   render  id 1  input 0 page 0 at 300 dpi, with text
;;             decode  id 2  input 1, bytes 0..64, no filter          (one round, two requests)
;;   round 1   ocr     id 3  the render's bitmap, psm 6, "eng"+"deu", the whole bitmap
;;             ocr     id 4  the decode's bitmap, psm 3, "eng", a region    (they need the bitmaps)
;;
;; and, once every answer is in, writes EVIDENCE (v2, D096): a `views` row per bitmap (its transform
;; computed once by `vw-new`), an image placement per bitmap (page 1 the render, page 2 the decode; the
;; box is the bitmap's size at its resolution, in centipoints; `obj` carries a byte read from the `Src`,
;; so the dump shows that a re-run after a miss read the true byte), and per answered OCR request an
;; `oruns` row and an `owords` row per word, its box mapped from bitmap pixels to centipoints through the
;; view and its text in `etext`. The fake answer carries no extension, so there are no lines, symbols or
;; alternatives: a word's `line` is -1 (the answer's own line and block ids are not evidence).
;; A failed answer contributes nothing. The host loop runs the unit by `us-requests` until it answers
;; `us-done`; the evidence is what the gate compares across hosts, recorded on one and replayed on another.
;;
;; THE UNIT MUST BE PURE: it restarts from `ev-init` every attempt and reads
;; only its `Src` and the answers, so a discarded attempt (a miss) leaves no
;; trace, and a replay sees what the recording saw.
(ns emon.planprobe
  (:require [emon.lang :refer [I32 Cells Src]]
            [emon.port :refer [src-len src-u8 src-missed]]
            [emon.plan :refer [us-done us-requests us-need-bytes lay-full flt-none
                               rq-render rq-decode rq-ocr rq-ocr-lang rq-ocr-end
                               an-find an-ok an-arg an-ocr-count an-ocr-first
                               aw-get aw-cp aw-next aw-x aw-y aw-w aw-h aw-conf
                               aw-len]]
            [emon.evidence :refer [ev-init im-new vw-new vw-box-to-cpt ow-new ow-set or-new or-set
                                   etx-append-cp etx-len owf-run
                                   orf-request orf-psm orf-wfirst orf-wcount ow-count
                                   vk-render vk-decode]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^I32 pp-words [^Cells an ^I32 at ^I32 page ^I32 view ^I32 request ^I32 psm
                     ^:mut ^Cells views ^:mut ^Cells oruns ^:mut ^Cells owords ^:mut ^Cells etext]
  (comment "One OCR answer as an OCR run and its words on `page`; `view` is the row of the bitmap's view.")
  (let [^I32 nw (an-ocr-count an at)
        ^I32 run (or-new oruns page view)
        ^I32 w0 (ow-count owords)
        ^:mut ^I32 w (an-ocr-first an at)
        ^:mut ^I32 i 0]
    (or-set oruns run (orf-request) request)
    (or-set oruns run (orf-psm) psm)
    (while (< i nw)
      (do (let [^I32 px (aw-get an w (aw-x))
                ^I32 py (aw-get an w (aw-y))
                ^I32 pw (aw-get an w (aw-w))
                ^I32 ph (aw-get an w (aw-h))
                ^I32 x0 (vw-box-to-cpt views view 0 px py pw ph)
                ^I32 y0 (vw-box-to-cpt views view 1 px py pw ph)
                ^I32 x1 (vw-box-to-cpt views view 2 px py pw ph)
                ^I32 y1 (vw-box-to-cpt views view 3 px py pw ph)
                ^I32 ts (etx-len etext)
                ^I32 nc (aw-get an w (aw-len))
                ^:mut ^I32 k 0]
            (while (< k nc)
              (do (etx-append-cp etext (aw-cp an w k))
                  (set k (+ k 1))))
            (let [^I32 ow (ow-new owords page x0 y0 x1 y1 x0 y1 x1 y1 0 0 ts nc -1
                                  (aw-get an w (aw-conf)) -1)]
              (ow-set owords ow (owf-run) run)))
          (set w (aw-next an w))
          (set i (+ i 1))))
    (or-set oruns run (orf-wfirst) w0)
    (or-set oruns run (orf-wcount) nw)
    (return 0)))

(defn ^:pub ^I32 pp-unit [^Src s ^Cells an ^:mut ^Cells rq
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "One attempt. Answers `us-done`, `us-requests` or `us-need-bytes`.")
  (ev-init epages views pts refs etext feats glyphs words lines marks fonts paths images
           oruns oblocks olines owords osyms oalts inks components rules prims tlines)
  (let [^I32 n (src-len s)
        ^I32 mid (src-u8 s (quot n 2))
        ^I32 tail (src-u8 s (- n 1))]
    (if (src-missed s) (return (us-need-bytes)))
    (let [^I32 r1 (an-find an 1)
          ^I32 r2 (an-find an 2)
          ^:mut ^I32 asked 0]
      (if (< r1 0)
        (do (rq-render rq 1 0 0 300 (lay-full))
            (set asked 1)))
      (if (< r2 0)
        (do (rq-decode rq 2 1 0 64 (flt-none) 0)
            (set asked 1)))
      (if (== asked 1) (return (us-requests)))
      (let [^I32 o3 (an-find an 3)
            ^I32 o4 (an-find an 4)]
        (if (and (== (an-ok an r1) 1) (< o3 0))
          (let [^I32 q3 (rq-ocr rq 3 1 6 0 0 0 0 0)]
            (rq-ocr-lang rq 101 110 103 0)
            (rq-ocr-lang rq 100 101 117 0)
            (rq-ocr-end rq q3)
            (set asked 1)))
        (if (and (== (an-ok an r2) 1) (< o4 0))
          (let [^I32 q4 (rq-ocr rq 4 2 3 0 10 20 30 40)]
            (rq-ocr-lang rq 101 110 103 0)
            (rq-ocr-end rq q4)
            (set asked 1)))
        (if (== asked 1) (return (us-requests)))
        (comment "Every answer is in: the evidence.")
        (if (== (an-ok an r1) 1)
          (let [^I32 w1 (an-arg an r1 0)
                ^I32 h1 (an-arg an r1 1)
                ^:mut ^I32 dd1 (* (an-arg an r1 3) 100)]
            (if (< dd1 1) (set dd1 7200))
            (let [^I32 v1 (vw-new views 1 (vk-render) 1 -1 w1 h1 dd1 (lay-full) -1 0 0 0 0 0)]
              (im-new images 1 0 0 (quot (* w1 720000) dd1) (quot (* h1 720000) dd1) mid w1 h1)
              (if (== (an-ok an o3) 1)
                (pp-words an o3 1 v1 3 6 views oruns owords etext)))))
        (if (== (an-ok an r2) 1)
          (let [^I32 w2 (an-arg an r2 0)
                ^I32 h2 (an-arg an r2 1)
                ^:mut ^I32 dd2 (an-arg an r2 3)]
            (if (< dd2 1) (set dd2 7200))
            (let [^I32 v2 (vw-new views 2 (vk-decode) 2 -1 w2 h2 dd2 (lay-full) -1 0 0 0 0 0)]
              (im-new images 2 0 0 (quot (* w2 720000) dd2) (quot (* h2 720000) dd2) tail w2 h2)
              (if (== (an-ok an o4) 1)
                (pp-words an o4 2 v2 4 3 views oruns owords etext))))))))
  (return (us-done)))
