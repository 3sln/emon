;; Tagged PDF (P3.7, D148-D150): the structure tree read into arenas, joined to the marked content the
;; content interpreter recorded, and scored for how much it can be believed. emon's own module (D039),
;; from ISO 32000-1 14.6-14.8 (marked content, the structure tree, standard structure types and
;; attributes) and ISO 14289-1 (PDF/UA). Evidence, not truth (D034): a tree is READ whole, JOINED to the
;; page by `(page, Form XObject, MCID)`, and then CHECKED against the geometry of the text it claims to
;; describe. Nothing here decides what a heading is; the score says how far the author's answer agrees
;; with the page.
;;
;;   (tg-read src ar dc a b st pg idx txt w seen ss se sk sc so wk md)   the tree (needs the document)
;;   (tg-join ss se sk sc so sa gl mk fnt pg ha hb hh)                    the join and the score (needs the
;;                                                                        text layer's `gl mk fnt`)
;;   (tg-dump t txt ss se sk sc so sa)                                    the canonical JSON dump
;;
;; THE ARENAS are `Cells`, rows of a fixed stride, strings as runs of `txt` (`emon.pdfx`); SPEC 8.4.7 says
;; the tree has arenas of its own, joined to the evidence by `marks.mcid`. Absent is -1.
;;
;;   `se`  structure elements, pre-order, `SE_STRIDE` (64) cells. ROW 0 IS THE StructTreeRoot. 0 object
;;         number (0: a direct dictionary), 1 parent row (-1), 2 depth, 3-4 /S as written (run), 5 role
;;         (`sr`, the standard type it resolves to, 0 none), 6 how (`sh`), 7 heading level of H1..Hn, 8
;;         heading level PRIOR (H1..Hn: n; plain H: the number of Sect ancestors, at least 1, at most
;;         6, bit 1 of `bits` says it was derived), 9 page (0-based; the element's /Pg or the nearest
;;         ancestor's, -1), 10 1 when the /Pg is its own, 11-12 its kids as `sk` rows first count, 13
;;         element kids, 14 marked-content kids, 15 object-reference kids, 16-17 /Alt, 18-19
;;         /ActualText, 20-21 /E, 22-23 /Lang as written, 24 the row that supplies its EFFECTIVE
;;         language (itself or the nearest ancestor with a /Lang, -1: the catalog's), 25-26 /ID, 27-28
;;         /T, 29 Scope (0 none, 1 Row, 2 Column, 3 Both), 30 RowSpan, 31 ColSpan (-1 absent), 32-33
;;         Headers (the /ID strings, a space between), 34-35 Summary, 36 ListNumbering (`ln`), 37 bits
;;         (1 heading level derived, 2 has /A, 4 has /C, 8 a direct dictionary, 16 /S is shadowed by
;;         the RoleMap, 32 kids not read, 64 has /K), 38 Sect ancestors, 39 inside a heading (1), 40
;;         subtree rows (itself included), then, filled by `tg-join`: 41 own glyphs, 42 their sizes
;;         summed in tenths of a point, 43 own bold glyphs, 44 glyphs in the subtree, 45 sizes, 46 bold,
;;         47 content rows (marked content and object references) in the subtree, 48 the first content
;;         row (in tree order) that holds text, 49 its page, 50-53 the box of the subtree's text on that
;;         page (cpt, page space), 54 table rows, 55 table columns (Table), 56 1 when every row has as
;;         many columns, 57 list items, 58 items with a label, 59 labels that agree with
;;         ListNumbering, 60 labels that do not, 61 what the first label looks like (`lk` bits).
;;   `sk`  kids in document order, 4 cells: 0 kind (`sk`: element, content, object reference, skipped),
;;         1 target row (`se`, `sc` or `so`), 2 why it was skipped (`kx`), 3 spare.
;;   `sc`  marked-content references (an /MCR or a bare MCID), `SC_STRIDE` (24): 0 element, 1 kind (1 /MCR
;;         dictionary, 2 bare integer), 2 page (0-based, -1), 3 MCID, 4 object number of the Form XObject
;;         (/Stm; 0 the page's own content), 5 the `marks` row it joined (-1), 6-7 that mark's first glyph
;;         and glyph count, 8 /StmOwn, 9 flags (`sf`), then `tg-join`: 10 glyphs it owns (the glyphs whose
;;         innermost marked content with an MCID is its mark), 11 their sizes in tenths of a point, 12
;;         bold glyphs, 13-16 their box, 17-18 the first and last glyph owned, 19-23 spare.
;;   `so`  object references (/OBJR), 8 cells: 0 element, 1 page, 2 object number, 3 what it is (`ok`),
;;         4 the ParentTree agrees (1), disagrees (2), has no entry (3), 5-7 spare.
;;   `sa`  furniture evidence, `SA_STRIDE` (16): one row per OUTERMOST artifact span: 0 `marks` row, 1 page
;;         (0-based), 2 /Type (`ar`), 3 /Subtype (`as`), 4 glyphs, 5-8 their box (page space), 9 where
;;         it sits (`ab`), 10 rotation of its first glyph (centi-degrees), 11 its mean size (cpt), 12
;;         the verdict (`av`), 13 mean luminance of its glyphs (0..255, -1), 14-15 spare.
;;   `ss`  the document: `SS_SIZE` (96) cells, named below and printed by `tg-dump`.
;;
;; THE JOIN is exact and has no tolerance: an MCR names `(page, stm, MCID)` and `marks` has at most one row
;; for it (`marks.stm` is the Form XObject, D101). Every glyph is then OWNED by the structure element of
;; its innermost marked content that carries an MCID, or is an artifact, or is neither.
;;
;; THE SCORE (D149) is a weighted harmonic mean of integer per-mille components, each a check of the
;; tree against the page: coverage, role diversity, reading order against geometry, headings against type
;; size, heading levels, artifacts against position, and the nesting of table and list roles.
;;
;; BOUNDS: 1,000,000 elements, depth 64, 2,000,000 marked-content references; a loop or a shared element
;; is read once and noted. Nothing here recurses without a depth.
(ns emon.pdfstruct
  (:require [emon.lang :refer [I32 Src Cells Text defenum emit-ascii]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop
                               text-cp text-i32]]
            [emon.pdfsrc :refer [ps-missed]]
            [emon.pdfsnames :refer [sn-k sn-s sn-p sn-pg sn-obj sn-stm sn-stm-own sn-mcid sn-type
                                    sn-struct-elem sn-mcr sn-objr sn-struct-tree-root sn-role-map
                                    sn-class-map sn-parent-tree sn-id sn-c sn-a sn-o sn-lang sn-alt
                                    sn-actual-text sn-e sn-t sn-nums sn-kids sn-mark-info sn-marked
                                    sn-suspects sn-user-properties sn-struct-parent sn-struct-parents
                                    sn-subtype sn-link sn-widget sn-form sn-image sn-scope sn-headers
                                    sn-row-span sn-col-span sn-summary sn-list-numbering sn-row
                                    sn-column sn-both sn-none sn-unordered sn-ordered sn-disc
                                    sn-circle sn-square sn-decimal sn-upper-roman sn-lower-roman
                                    sn-upper-alpha sn-lower-alpha sn-layout sn-list sn-print-field
                                    sn-table sn-hyperlink sn-span-at sn-chars-at
                                    sr-offs-count sr-offs-at sr-chars-at sr-emit-name]]
            [emon.pdflex :refer [pl-kind-of pl-first pl-next pl-int-value pl-count pl-dict-find
                                 pl-name-entry pl-name-len pl-name-byte pl-str-len pl-str-byte
                                 pl-stream-dict]]
            [emon.pdfdoc :refer [pd-get pd-resolve pd-root pd-pg-count pd-pg-node pd-pg-crop
                                 pd-pg-rotate pd-object-count]]
            [emon.pdfx :refer [px-int-of px-text-push px-seen-begin px-seen-mark px-page-of px-nth px-json-box
                               px-json-run px-json-cp]]
            [emon.evidence :refer [gl-count gl-get mk-count mk-get fo-get gf-mark gf-font gf-size gf-fill gf-rot ch-x0 ch-y0 ch-x1 ch-y1 ch-cp mkf-page mkf-kind mkf-parent mkf-mcid mkf-arsub mkf-artype mkf-gfirst mkf-gcount mkf-stm fnf-style]]
            [kin.lang :refer [defn defconst declarefn return let set while if comment do
                              + - * < > <= >= == != and or quot rem bit-and bit-or]]))

