;; The OCR-through-the-transcript PROBE UNIT (P2.6 spike, D095; evidence v2, P1.12, D096): what a real
;; unit does with a real engine's answer, in miniature.
;;
;;   round 0   render  id 1  input 0 page 0 at 150 dpi, with text
;;   round 1   ocr     id 2  the render's bitmap, psm 3 (automatic), symbols and OSD
;;                           wanted, NO LANGUAGE (D038: no locale is assumed)
;;   then      evidence, everything the D095 extension carries:
;;               epages    the page (its size at the render's resolution, `raster`)
;;               views     the render (its transform computed once by `vw-new`)
;;               images    the page's image placement
;;               oruns     one row: the request, the view read, psm, flags, orientation, writing
;;                         direction, line order, deskew, OSD degrees, script, both confidences
;;               oblocks   blocks and paragraphs, grouped from the lines' `block` and `par` ids (box =
;;                         union of their lines, `btype` from the first line, orientation and writing
;;                         direction from the run: the extension has no per-block value yet), each
;;                         block followed by its paragraphs so both child runs are contiguous
;;               olines    the pixel box mapped through the view, the two-point baseline mapped
;;               owords    the pixel box mapped, the LINE's baseline (already mapped) evaluated at the word's left
;;                         and right edge (D096: map first, then interpolate: one centipoint of error where
;;                         interpolating in whole pixels first could be a pixel), style, language, symbols
;;               osyms     boxes, text (a run of `etext` for a ligature), confidence
;;               oalts     every alternative's full text, a run per symbol, in engine order
;;               feats     the stage 1 features of every word (`ev-feat-ocr`)
;;
;; `op-unit` is pure (it restarts from `ev-init` on every attempt), so a replayed transcript produces
;; the recorded evidence byte for byte on every host. Raster-to-page arithmetic is `vw-new`'s and is
;; exact at 150 dpi (`px * 48`).
;;
;; THE ENGINE'S ORIENTATION ENUM is stored verbatim (Tesseract: page-up 0, right 1, down 2, left 3), as are
;; the writing direction and the line order; `olines` and `owords` turn the writing direction into `ld`
;; (left-to-right 0, right-to-left `ld-rtl`, top-to-bottom `ld-ttb`). The extension's confidences are x10.
(ns emon.ocrprobe
  (:require [emon.lang :refer [I32 Cells Src]]
            [emon.port :refer [src-len src-u8 src-missed cells-at]]
            [emon.plan :refer [us-done us-requests us-need-bytes lay-full
                               rq-render rq-ocr rq-ocr-end
                               an-find an-ok an-arg]]
            [emon.ocr :refer [ocf-symbols ocf-osd]]
            [emon.scan :refer [sc-answer]]
            [emon.evidence :refer [ev-init im-new ep-new ep-set vw-new
                                   epf-flags epf-dpi vk-render eg-raster]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^I32 op-cpt [^I32 px ^I32 dpi] (return (quot (* px 7200) dpi)))

(defn ^:pub ^I32 op-unit [^Src s ^Cells an ^:mut ^Cells rq
                          ^:mut ^Cells epages ^:mut ^Cells views ^:mut ^Cells pts
                          ^:mut ^Cells refs ^:mut ^Cells etext ^:mut ^Cells feats
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells marks ^:mut ^Cells fonts ^:mut ^Cells paths
                          ^:mut ^Cells images
                          ^:mut ^Cells oruns ^:mut ^Cells oblocks ^:mut ^Cells olines
                          ^:mut ^Cells owords ^:mut ^Cells osyms ^:mut ^Cells oalts
                          ^:mut ^Cells inks ^:mut ^Cells components ^:mut ^Cells rules
                          ^:mut ^Cells prims ^:mut ^Cells tlines]
  (comment "One attempt. Answers `us-done`, `us-requests` or `us-need-bytes`.")
  (ev-init epages views pts refs etext feats glyphs words lines marks fonts paths images
           oruns oblocks olines owords osyms oalts inks components rules prims tlines)
  (let [^I32 n (src-len s)
        ^I32 mid (src-u8 s (quot n 2))]
    (if (src-missed s) (return (us-need-bytes)))
    (let [^I32 r1 (an-find an 1)]
      (if (< r1 0)
        (do (rq-render rq 1 0 0 150 (lay-full))
            (return (us-requests))))
      (if (!= (an-ok an r1) 1) (return (us-done)))
      (let [^I32 o2 (an-find an 2)]
        (if (< o2 0)
          (let [^I32 q (rq-ocr rq 2 1 3 (+ (ocf-symbols) (ocf-osd)) 0 0 0 0)]
            (rq-ocr-end rq q)
            (return (us-requests))))
        (let [^I32 w1 (an-arg an r1 0)
              ^I32 h1 (an-arg an r1 1)
              ^:mut ^I32 dpi (an-arg an r1 3)]
          (if (< dpi 1) (set dpi 72))
          (ep-new epages 1 (op-cpt w1 dpi) (op-cpt h1 dpi))
          (ep-set epages 0 (epf-flags) (eg-raster))
          (ep-set epages 0 (epf-dpi) (* dpi 100))
          (vw-new views 1 (vk-render) 1 -1 w1 h1 (* dpi 100) (lay-full) -1 0 0 0 0 0)
          (im-new images 1 0 0 (op-cpt w1 dpi) (op-cpt h1 dpi) mid w1 h1)
          (if (== (an-ok an o2) 1)
            (sc-answer an o2 1 0 2 0 views epages etext oruns oblocks olines owords osyms oalts feats))))))
  (return (us-done)))
