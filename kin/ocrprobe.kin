;; The OCR-through-the-transcript PROBE UNIT (P2.6 spike, D095): what a real unit
;; does with a real engine's answer, in miniature.
;;
;;   round 0   render  id 1  input 0 page 0 at 150 dpi, with text
;;   round 1   ocr     id 2  the render's bitmap, psm 3 (automatic), symbols and OSD
;;                           wanted, NO LANGUAGE (D038: no locale is assumed)
;;   then      evidence: an image placement for the page and an `ocrwords` row per
;;             word, with its text, alternatives, line, block, baseline, style
;;             bits and language.
;;
;; `op-unit` is pure (it restarts from `ev-init` on every attempt), so a replayed
;; transcript produces the recorded evidence byte for byte on every host.
;; Boxes are converted bitmap pixels to centipoints with integer arithmetic only:
;; `px * 7200 / dpi` is exact to a centipoint and stays in 32 bits for any scan
;; under ~300,000 px.
(ns emon.ocrprobe
  (:require [emon.lang :refer [I32 Cells Src]]
            [emon.port :refer [src-len src-u8 src-missed cells-at]]
            [emon.plan :refer [us-done us-requests us-need-bytes lay-full
                               rq-render rq-ocr rq-ocr-end
                               an-find an-ok an-arg an-ocr-count an-ocr-first
                               aw-get aw-cp aw-next aw-x aw-y aw-w aw-h aw-conf
                               aw-line aw-block aw-len]]
            [emon.ocr :refer [ocf-symbols ocf-osd ox-find ox-line-at ox-first-word
                              ox-wflags ox-wlang ox-nsym ox-first-sym ox-sym-next
                              ox-sym-alts ox-alt-next ox-word-next ox-get]]
            [emon.evidence :refer [ev-init im-new ow-new ow-set alt-add etx-append-cp
                                   etx-len of-tstart of-tlen of-line of-block
                                   of-baseline of-flags of-lang]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^I32 op-cpt [^I32 px ^I32 dpi] (return (quot (* px 7200) dpi)))

(defn ^I32 op-baseline [^Cells an ^I32 ext ^I32 line ^I32 cx ^I32 dflt]
  (comment "The line's baseline at pixel column `cx` (two points, integer interpolation), or `dflt`.")
  (if (< ext 0) (return dflt))
  (let [^I32 l (ox-line-at an ext line)
        ^I32 bx0 (cells-at an (+ l 4))
        ^I32 by0 (cells-at an (+ l 5))
        ^I32 bx1 (cells-at an (+ l 6))
        ^I32 by1 (cells-at an (+ l 7))]
    (if (<= bx1 bx0) (return by1))
    (return (+ by0 (quot (* (- by1 by0) (- cx bx0)) (- bx1 bx0))))))

(defn ^I32 op-words [^Cells an ^I32 at ^I32 page ^I32 dpi
                     ^:mut ^Cells ocrwords ^:mut ^Cells alts ^:mut ^Cells etext]
  (let [^I32 nw (an-ocr-count an at)
        ^I32 ext (ox-find an at)
        ^:mut ^I32 wx -1
        ^:mut ^I32 w (an-ocr-first an at)
        ^:mut ^I32 i 0]
    (if (>= ext 0) (set wx (ox-first-word an ext)))
    (while (< i nw)
      (do (let [^I32 px (aw-get an w (aw-x))
                ^I32 py (aw-get an w (aw-y))
                ^I32 pw (aw-get an w (aw-w))
                ^I32 ph (aw-get an w (aw-h))
                ^I32 ln (aw-get an w (aw-line))
                ^I32 ow (ow-new ocrwords page (op-cpt px dpi) (op-cpt py dpi)
                                (op-cpt (+ px pw) dpi) (op-cpt (+ py ph) dpi)
                                (aw-get an w (aw-conf)))
                ^I32 ts (etx-len etext)
                ^I32 nc (aw-get an w (aw-len))
                ^:mut ^I32 k 0]
            (while (< k nc)
              (do (etx-append-cp etext (aw-cp an w k))
                  (set k (+ k 1))))
            (ow-set ocrwords ow (of-tstart) ts)
            (ow-set ocrwords ow (of-tlen) nc)
            (ow-set ocrwords ow (of-line) ln)
            (ow-set ocrwords ow (of-block) (aw-get an w (aw-block)))
            (if (>= wx 0)
              (do (ow-set ocrwords ow (of-baseline)
                          (op-cpt (op-baseline an ext ln (+ px (quot pw 2)) (+ py ph)) dpi))
                  (ow-set ocrwords ow (of-flags) (ox-wflags an wx))
                  (ow-set ocrwords ow (of-lang) (ox-wlang an wx))
                  (let [^I32 ns (ox-nsym an wx)
                        ^:mut ^I32 s (ox-first-sym an wx)
                        ^:mut ^I32 j 0
                        ^:mut ^I32 off 0]
                    (while (< j ns)
                      (do (let [^I32 ncp (cells-at an (+ s 5))
                                ^I32 nalt (cells-at an (+ s 6))
                                ^:mut ^I32 a (ox-sym-alts an s)
                                ^:mut ^I32 m 0]
                            (while (< m nalt)
                              (do (if (> (cells-at an a) 0)
                                    (alt-add ocrwords alts ow off (cells-at an (+ a 2))
                                             (cells-at an (+ a 1))))
                                  (set a (ox-alt-next an a))
                                  (set m (+ m 1))))
                            (set off (+ off ncp)))
                          (set s (ox-sym-next an s))
                          (set j (+ j 1))))
                    (set wx (ox-word-next an wx))))))
          (set w (aw-next an w))
          (set i (+ i 1))))
    (return 0)))

(defn ^:pub ^I32 op-unit [^Src s ^Cells an ^:mut ^Cells rq
                          ^:mut ^Cells glyphs ^:mut ^Cells words ^:mut ^Cells lines
                          ^:mut ^Cells paths ^:mut ^Cells images
                          ^:mut ^Cells components ^:mut ^Cells ocrwords
                          ^:mut ^Cells alts ^:mut ^Cells etext]
  (comment "One attempt. Answers `us-done`, `us-requests` or `us-need-bytes`.")
  (ev-init glyphs words lines paths images components ocrwords alts etext)
  (let [^I32 n (src-len s)
        ^I32 mid (src-u8 s (quot n 2))]
    (if (src-missed s) (return (us-need-bytes)))
    (let [^I32 r1 (an-find an 1)]
      (if (< r1 0)
        (do (rq-render rq 1 0 0 150 (lay-full))
            (return (us-requests))))
      (if (!= (an-ok an r1) 1) (return (us-done)))
      (let [^I32 o2 (an-find an 2)]
        (if (< o2 0)
          (let [^I32 q (rq-ocr rq 2 1 3 (+ (ocf-symbols) (ocf-osd)) 0 0 0 0)]
            (rq-ocr-end rq q)
            (return (us-requests))))
        (let [^I32 w1 (an-arg an r1 0)
              ^I32 h1 (an-arg an r1 1)
              ^:mut ^I32 dpi (an-arg an r1 3)]
          (if (< dpi 1) (set dpi 72))
          (im-new images 1 0 0 (op-cpt w1 dpi) (op-cpt h1 dpi) mid w1 h1)
          (if (== (an-ok an o2) 1)
            (op-words an o2 1 dpi ocrwords alts etext))))))
  (return (us-done)))
