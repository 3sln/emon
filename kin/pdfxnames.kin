;; GENERATED by tools/pdfxnames.clj -- do not edit.
;;
;; The 203 PDF names the catalogue readers compare by BYTES (P3.8, P3.9): not
;; interned in the object arena (that holds 192 and is shared), so a reader walks a
;; dictionary and compares a key's bytes with a row of this table. The id of a name is
;; its position; appending is safe, nothing else is.
(ns emon.pdfxnames
  (:require [emon.lang :refer [I32 defenum]]
            [kin.lang :refer [defdata]]))

