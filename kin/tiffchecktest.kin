;; Laws for `emon.tiffcheck` (P10.11, D396(4); D188, D189). GENERATED by a babashka script that is not kept (the laws are the record):
;; TIFFs written byte by byte, one fault or one feature at a time (the name of the law says which), the chain of directories
;; (loops, bad links), every tag's type and count, the strips, tiles and planes the report lists, the refusals by name; each TIFF
;; fixture of `test/image/` against the row of `test/image/expect.edn`; the CCITT decoder on the strips of the bilevel fixtures,
;; equal to the uncompressed picture; and the EXIF reader.
;; Arguments of `t-tiff`: the frame, deep, the status wanted, then the report's fields (-1: not looked at) and three extras as
;; (index, value): an index of 1000 + k is the offset of chunk k, 2000 + k its byte count and 3000 + k the k-th colour map value.
(ns emon.tiffchecktest
  (:require [emon.lang :refer [I32 Blob Cells Buf]]
            [emon.test :refer [deftest assert-eq new-cells new-buf test-t TestT Str hex-blob test-file]]
            [emon.port :refer [blob-len blob-u8 cells-at buf-len buf-at buf-push]]
            [emon.ccitt :refer [cc-decode]]
            [emon.tiffcheck :refer [tc-check tc-exif tr-status tr-frames tr-w tr-h tr-ow tr-oh tr-ch tr-dpi tr-bilevel tr-orient
                                    tr-limit tr-eo tr-ex tr-ey tr-spp tr-bps tr-comp tr-kind tr-nc tr-alpha tr-predictor
                                    tr-planar tr-fill2 tr-le tr-tiled tr-cw tr-band tr-across tr-down tr-hs tr-vs tr-planes
                                    tr-nchunks tr-cmap-at tr-offs-at tr-lens-at]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 t-field [^TestT emon-t ^Cells r ^I32 ix ^I32 want ^Str msg]
  (if (>= want 0) (assert-eq (cells-at r ix) want msg))
  (return 0))

(defn ^I32 t-extra [^TestT emon-t ^Cells r ^I32 ix ^I32 want ^Str msg]
  (comment "A report index, or 1000 + k (chunk k's offset), 2000 + k (its byte count), 3000 + k (the k-th colour map value).")
  (if (< ix 0) (return 0))
  (if (< ix 1000) (return (t-field emon-t r ix want msg)))
  (if (< ix 2000) (return (t-field emon-t r (+ (cells-at r (tr-offs-at)) (- ix 1000)) want msg)))
  (if (< ix 3000) (return (t-field emon-t r (+ (cells-at r (tr-lens-at)) (- ix 2000)) want msg)))
  (return (t-field emon-t r (+ (cells-at r (tr-cmap-at)) (- ix 3000)) want msg)))

(defn ^I32 t-tiff [^TestT emon-t ^Blob t ^I32 frame ^I32 deep ^I32 want ^I32 frames ^I32 w ^I32 h ^I32 ow ^I32 oh ^I32 ch ^I32 dpi
                   ^I32 orient ^I32 bilevel ^I32 i1 ^I32 v1 ^I32 i2 ^I32 v2 ^I32 i3 ^I32 v3 ^Str msg]
  (let [^Cells r (new-cells)
        ^I32 s (tc-check t frame deep r)]
    (assert-eq s want msg)
    (assert-eq (cells-at r (tr-status)) want msg)
    (if (== want 0)
      (do (t-field emon-t r (tr-frames) frames msg)
          (t-field emon-t r (tr-w) w msg)
          (t-field emon-t r (tr-h) h msg)
          (t-field emon-t r (tr-ow) ow msg)
          (t-field emon-t r (tr-oh) oh msg)
          (t-field emon-t r (tr-ch) ch msg)
          (t-field emon-t r (tr-dpi) dpi msg)
          (t-field emon-t r (tr-orient) orient msg)
          (t-field emon-t r (tr-bilevel) bilevel msg)
          (t-extra emon-t r i1 v1 msg)
          (t-extra emon-t r i2 v2 msg)
          (t-extra emon-t r i3 v3 msg)))
    (if (== want 3) (t-extra emon-t r i1 v1 msg))
    (return 0)))

