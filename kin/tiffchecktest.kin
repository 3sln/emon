;; ---------------------------------------------------------------- CCITT on real strips

(defn ^I32 t-zeros [^:mut ^Buf b ^I32 n]
  (comment "The caller's part of `cc-decode`'s contract: `n` zero bytes to paint on.")
  (let [^:mut ^I32 i 0]
    (while (< i n)
      (do (buf-push b 0)
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 t-strip [^TestT emon-t ^Blob t ^I32 k ^I32 flags ^Buf out ^Str msg]
  (comment "Decode the one strip of a 48 x 36 bilevel fixture; the status of the decoder.")
  (let [^Cells r (new-cells)
        ^Cells ws (new-cells)
        ^I32 s (tc-check t 0 1 r)]
    (assert-eq s 0 msg)
    (assert-eq (cells-at r (tr-nchunks)) 1 msg)
    (let [^I32 off (cells-at r (cells-at r (tr-offs-at)))
          ^I32 n (cells-at r (cells-at r (tr-lens-at)))]
      (t-zeros out 216)
      (return (cc-decode t off (+ off n) k 48 36 flags out ws)))))

(defn ^I32 t-same [^TestT emon-t ^Blob t ^I32 k ^Blob none ^Str msg]
  (comment "The strip of `t` decoded is the picture the uncompressed file `none` holds, bit for bit (libtiff reads a CCITT black run as 1 bits whatever the photometric: D188).")
  (let [^Buf got (new-buf)
        ^Cells r (new-cells)
        ^I32 s (tc-check none 0 1 r)
        ^I32 off (cells-at r (cells-at r (tr-offs-at)))
        ^:mut ^I32 i 0]
    (assert-eq (t-strip emon-t t k 0 got msg) 0 msg)
    (assert-eq s 0 msg)
    (assert-eq (buf-len got) 216 msg)
    (while (< i 216)
      (do (assert-eq (buf-at got i) (blob-u8 none (+ off i)) msg)
          (set i (+ i 1))))
    (return 0)))

(deftest test-ccitt-decodes-the-tiff-fixtures
  (t-same (test-t) (test-file "image/tiff-bilevel-g4.tif") -1 (test-file "image/tiff-bilevel-none.tif") "Group 4")
  (t-same (test-t) (test-file "image/tiff-bilevel-g3.tif") 0 (test-file "image/tiff-bilevel-none.tif") "Group 3, one-dimensional"))

(defn ^I32 t-raw-strip [^TestT emon-t ^Blob t ^I32 off ^I32 k ^Blob none ^Str msg]
  (comment "A refused TIFF (validator says no) whose strip starts at `off` and runs to the end of the strips: the decoder reads"
           "what the validator will not hand over: Group 3 two-dimensional, and EOLs padded with fill bits.")
  (let [^Buf got (new-buf)
        ^Cells ws (new-cells)
        ^Cells r (new-cells)
        ^I32 s (tc-check none 0 1 r)
        ^I32 woff (cells-at r (cells-at r (tr-offs-at)))
        ^:mut ^I32 i 0]
    (assert-eq s 0 msg)
    (t-zeros got 216)
    (assert-eq (cc-decode t off (blob-len t) k 48 36 0 got ws) 0 msg)
    (assert-eq (buf-len got) 216 msg)
    (while (< i 216)
      (do (assert-eq (buf-at got i) (blob-u8 none (+ woff i)) msg)
          (set i (+ i 1))))
    (return 0)))

(deftest test-ccitt-reads-what-the-validator-refuses
  (t-raw-strip (test-t) (test-file "image/tiff-bilevel-g3-2d.tif") 8 1 (test-file "image/tiff-bilevel-none.tif") "Group 3, two-dimensional")
  (t-raw-strip (test-t) (test-file "image/tiff-bilevel-g3-fill.tif") 8 0 (test-file "image/tiff-bilevel-none.tif") "Group 3 with fill bits before the EOLs"))

(deftest test-exif-reader
  (comment "The first directory of an EXIF blob: orientation 1..8 and the two resolutions; anything else says (1, 0, 0).")
  (let [^Cells r (new-cells)]
    (tc-exif (hex-blob "49492a000800000004001201030001000000060000001a010500010000003e0000001b010500010000003e000000280103000100000002000000000000002c01000001000000") 0 70 r)
    (assert-eq (cells-at r (tr-eo)) 6 "orientation")
    (assert-eq (cells-at r (tr-ex)) 30000 "horizontal resolution")
    (assert-eq (cells-at r (tr-ey)) 30000 "vertical resolution")
    (tc-exif (hex-blob "010203040549492a000800000004001201030001000000060000001a010500010000003e0000001b010500010000003e000000280103000100000002000000000000002c01000001000000") 5 70 r)
    (assert-eq (cells-at r (tr-eo)) 6 "orientation, in a blob that starts later")
    (assert-eq (cells-at r (tr-ex)) 30000 "... and its resolution")
    (tc-exif (hex-blob "49492a000800000004001201030001000000010000001a010500010000003e0000001b010500010000003e000000280103000100000002000000000000009600000001000000") 0 70 r)
    (assert-eq (cells-at r (tr-eo)) 1 "orientation 1")
    (assert-eq (cells-at r (tr-ex)) 15000 "150 dpi")
    (tc-exif (hex-blob "4d4d002b00080000") 0 8 r)
    (assert-eq (cells-at r (tr-eo)) 1 "BigTIFF says nothing")
    (assert-eq (cells-at r (tr-ex)) 0 "... of the resolution")
    (tc-exif (hex-blob "49492a00") 0 4 r)
    (assert-eq (cells-at r (tr-eo)) 1 "a blob of four bytes says nothing")
    (tc-exif (hex-blob "49492a00ffffffff0000") 0 10 r)
    (assert-eq (cells-at r (tr-eo)) 1 "a directory outside the blob says nothing")
    (assert-eq (cells-at r (tr-ey)) 0 "... of the resolution")))
