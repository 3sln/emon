;; Laws for `emon.html` (P1.9): golden files, byte for byte, on every target.
;;
;; A GOLDEN is a Model (the `test/json/NAME.model` line script that
;; `emon.jsontest` already builds, parsed by `emon.mscript`: one Model, two
;; serializations) and the exact bytes `html-emit` must write for it under one
;; option set: `test/html/NAME.html` (defaults, compact), `.pretty.html`,
;; `.full.html` (ids, geometry, confidence below 950, the ledger) and
;; `.bare.html` (no furniture, no milestones). `kin/scripts/html-check.py`,
;; run first by `bb unit`, writes them from the JSON goldens with an
;; independent renderer and parses each with html5lib (D067).
;;
;; `ht-golden` IS A HELPER THAT ASSERTS: it takes the test handle as its
;; first parameter, `emon-t` (Go spells it `emonT`), and the laws pass `(test-t)` (DEVLOG P0.5 audit:
;; `emon.test`). Before that a shared builder had to answer a code for each
;; law to assert.
(ns emon.htmltest
  (:require [emon.lang :refer [I32 Blob Cells Text emit-ascii]]
            [emon.test :refer [deftest assert-eq assert-text assert-text-span
                               test-file test-t new-cells new-text new-buf text-blob
                               Str TestT]]
            [emon.port :refer [blob-len]]
            [emon.mscript :refer [jt-build jt-end]]
            [emon.model :refer [model-init node-new node-set-text node-set-sub
                                node-set-conf node-add-region text-len
                                text-append-utf8 model-check max-depth node-add-attr-text
                                nk-section nk-heading nk-paragraph nk-quote nk-break
                                nk-furniture nk-figure fk-labels fg-chart]]
            [emon.html :refer [html-emit]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or]]))

;; ---------------------------------------------------------------- helpers

(defn ^I32 ht-golden [^TestT emon-t ^Str mfile ^Str hfile ^I32 opts ^I32 below]
  (comment "Build the Model `mfile`, emit it under `opts`, and require the")
  (comment "bytes of the golden `hfile`.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Cells st (new-cells)
        ^Text out (new-text)]
    (assert-eq (jt-build (test-file mfile) nodes attrs regions text pages ledger layout st) 0 "the script builds")
    (assert-eq (model-check nodes attrs regions text pages ledger layout st) 0 "the Model is well formed")
    (assert-eq (html-emit out opts below nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells)) 0 "it emits")
    (assert-text-span out (test-file hfile) 0 (jt-end (test-file hfile)) "the golden" 0)
    (return 0)))

(defn ^I32 ht-set [^:mut ^Cells nodes ^:mut ^Cells text ^I32 n ^Blob b]
  (comment "Give node n the UTF-8 bytes of b as its text.")
  (let [^I32 start (text-len text)]
    (text-append-utf8 text b 0 (blob-len b))
    (node-set-text nodes n start (- (text-len text) start))
    (return 0)))

;; ----------------------------------------------------------------- goldens

(deftest test-golden-minimal
  (ht-golden (test-t) "json/minimal.model" "html/minimal.html" 0 0)
  (ht-golden (test-t) "json/minimal.model" "html/minimal.pretty.html" 16 0)
  (ht-golden (test-t) "json/minimal.model" "html/minimal.full.html" 15 950)
  (ht-golden (test-t) "json/minimal.model" "html/minimal.bare.html" 96 0)
  (ht-golden (test-t) "json/minimal.model" "html/minimal.plain.html" 386 0))

