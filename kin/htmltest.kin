;; ------------------------------------------------------------- the corners

(deftest test-an-empty-document
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text out (new-text)]
    (model-init nodes attrs regions text pages ledger layout)
    (html-emit out 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main></main></body></html>" "the smallest document")))

(deftest test-heading-levels-and-escapes
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text out (new-text)
        ^:mut ^I32 h 0]
    (model-init nodes attrs regions text pages ledger layout)
    (set h (node-new nodes (nk-heading) 0))
    (node-set-sub nodes h 1)
    (ht-set nodes text h (text-blob "a & b"))
    (set h (node-new nodes (nk-heading) 0))
    (node-set-sub nodes h 6)
    (ht-set nodes text h (text-blob "<six>"))
    (set h (node-new nodes (nk-heading) 0))
    (node-set-sub nodes h 7)
    (ht-set nodes text h (text-blob "say \"seven\""))
    (html-emit out 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><h1>a &amp; b</h1><h6>&lt;six&gt;</h6><h6 aria-level=\"7\">say &quot;seven&quot;</h6></main></body></html>" "levels, and the four escapes")))

(deftest test-options-add-ids-geometry-and-confidence
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text all (new-text)
        ^Text none (new-text)
        ^Text edge (new-text)
        ^:mut ^I32 p 0]
    (model-init nodes attrs regions text pages ledger layout)
    (comment "A quote: the fit has no row for the kind yet (P10.1: the corpus has none), so its confidence is written as it is. A refit that gives")
    (comment "quotes a row moves the number of this law, not what it holds: the threshold is on the confidence as written.")
    (set p (node-new nodes (nk-quote) 0))
    (ht-set nodes text p (text-blob "x"))
    (node-add-region nodes regions p 1 7250 -5 54000 100)
    (node-set-conf nodes p 500)
    (html-emit all 7 600 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (html-emit none 0 600 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (html-emit edge 4 500 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (assert-text all "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><blockquote id=\"emon-1\" data-emon-at=\"1,72.5,-0.05,540,1\" data-emon-conf=\"500\">x</blockquote></main></body></html>" "all three options")
    (assert-text none "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><blockquote>x</blockquote></main></body></html>" "clean by default")
    (assert-text edge "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><blockquote>x</blockquote></main></body></html>" "conf is only written strictly below the threshold")))

(deftest test-furniture-drops-and-milestones-switch-off
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text kept (new-text)
        ^Text bare (new-text)
        ^:mut ^I32 n 0]
    (model-init nodes attrs regions text pages ledger layout)
    (set n (node-new nodes (nk-break) 0))
    (node-set-sub nodes n 2)
    (set n (node-new nodes (nk-furniture) -1))
    (node-set-sub nodes n 7)
    (html-emit kept 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (html-emit bare 96 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells))
    (assert-text kept "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><aside data-emon=\"furniture\" data-emon-role=\"header\"></aside><span data-emon-page=\"2\"></span></main></body></html>" "furniture once at the top, then the milestone")
    (assert-text bare "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main></main></body></html>" "both off")))

(defn ^I32 ht-label [^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells text ^I32 n ^Blob b]
  (comment "Add the UTF-8 bytes of b as one more `labels` value of node n.")
  (let [^I32 start (text-len text)]
    (text-append-utf8 text b 0 (blob-len b))
    (node-add-attr-text nodes attrs n (fk-labels) start (- (text-len text) start))
    (return 0)))

(deftest test-the-labels-of-a-figure-are-separate-tokens-in-the-text
  (comment "D1590: a chart's axis title and its tick labels are `labels`, each its own span; spans with nothing between them read as one run")
  (comment "(`(thousands)220165110550Q1Q2Q3Q4`), so a single space stands between two of them.")
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text out (new-text)
        ^:mut ^I32 f 0]
    (model-init nodes attrs regions text pages ledger layout)
    (set f (node-new nodes (nk-figure) 0))
    (node-set-sub nodes f (fg-chart))
    (ht-label nodes attrs text f (text-blob "Units (thousands)"))
    (ht-label nodes attrs text f (text-blob "220"))
    (ht-label nodes attrs text f (text-blob "0"))
    (ht-label nodes attrs text f (text-blob "Q1"))
    (ht-label nodes attrs text f (text-blob "Q2"))
    (assert-eq (html-emit out 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells)) 0 "it emits")
    (assert-text out "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><figure data-emon-kind=\"chart\" role=\"img\"><span data-emon=\"label\">Units (thousands)</span> <span data-emon=\"label\">220</span> <span data-emon=\"label\">0</span> <span data-emon=\"label\">Q1</span> <span data-emon=\"label\">Q2</span></figure></main></body></html>"
                 "five labels, a space between each two, none before the first or after the last")))

(deftest test-the-deepest-tree-emits
  (let [^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells regions (new-cells)
        ^Cells text (new-cells)
        ^Cells pages (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)
        ^Text compact (new-text)
        ^Text pretty (new-text)
        ^:mut ^I32 at 0]
    (model-init nodes attrs regions text pages ledger layout)
    (while (!= at -1)
      (set at (node-new nodes (nk-section) at)))
    (assert-eq (html-emit compact 0 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells)) 0 "compact")
    (assert-eq (html-emit pretty 16 0 nodes attrs regions text pages ledger layout (new-cells) (new-cells) (new-buf) (new-cells)) 0 "pretty")))
