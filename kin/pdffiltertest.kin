;; Laws and the row corpus for `emon.pdffilter` (P1.5).
;;
;; THE CORPUS is `test/pdf/filters.txt`, which `kin/scripts/pdf-fixtures.py`
;; writes from PYTHON encoders that share no code with emon (zlib, base64's
;; ASCII85, and LZW, run-length and PNG/TIFF-predictor encoders written in that
;; script): each row is a filter, its parameters, an encoded input, and the
;; status and bytes a decoder must give, damaged inputs included. The same file
;; is read by all four targets.
(ns emon.pdffiltertest
  (:require [emon.lang :refer [I32 Blob Cells Text emit-ascii shl32 sar32]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-that
                               assert-text assert-text-span hex-blob text-blob new-cells
                               new-text test-file cells-blob assert-cells-hex
                               TestT test-t Str]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-push
                               cells-drop cells-set]]
            [emon.pdffilter :refer [pf-run pf-predict pf-status-emit-name
                                    pf-hex pf-a85 pf-rl pf-lzw pf-flate
                                    pf-ok pf-truncated pf-bad-ascii85 pf-bad-lzw
                                    pf-bad-predictor pf-unsupported
                                    pf-image-filter pf-f-hex pf-f-a85 pf-f-lzw
                                    pf-f-flate pf-f-rl pf-f-crypt pf-f-dct]]
            [kin.lang :refer [defn return let set while if comment do
                              + - * < > <= >= == != and or quot rem bit-and]]))

(defn ^I32 ft-nl [^Blob b ^I32 i]
  (let [^:mut ^I32 k i]
    (while (and (< k (blob-len b)) (!= (blob-u8 b k) 10))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 ft-tab [^Blob b ^I32 i ^I32 lim]
  (let [^:mut ^I32 k i]
    (while (and (< k lim) (!= (blob-u8 b k) 9))
      (set k (+ k 1)))
    (return k)))

(defn ^I32 ft-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (return -1))

(defn ^I32 ft-hex-into [^Blob b ^I32 from ^I32 to ^:mut ^Cells c]
  (comment "Decode the hex pairs in b[from, to) into c (cleared first); `-` is")
  (comment "the empty string.")
  (let [^:mut ^I32 k from]
    (cells-drop c 0)
    (if (and (== (- to from) 1) (== (blob-u8 b from) 45))
      (return 0))
    (while (< (+ k 1) (+ to 0))
      (do (cells-push c (+ (* (ft-hexval (blob-u8 b k)) 16)
                           (ft-hexval (blob-u8 b (+ k 1)))))
          (set k (+ k 2))))
    (return (cells-len c))))

(defn ^I32 ft-compare [^Cells out ^Blob b ^I32 from ^I32 to]
  (comment "-1 when `out` is exactly the hex in b[from, to) (`-` is empty); -2")
  (comment "for a length difference; else the index of the first differing byte.")
  (let [^:mut ^I32 n (quot (- to from) 2)
        ^:mut ^I32 i 0]
    (if (and (== (- to from) 1) (== (blob-u8 b from) 45)) (set n 0))
    (if (!= (cells-len out) n) (return -2))
    (while (< i n)
      (do (if (!= (cells-at out i)
                  (+ (* (ft-hexval (blob-u8 b (+ from (* i 2)))) 16)
                     (ft-hexval (blob-u8 b (+ from (+ (* i 2) 1))))))
            (return i))
          (set i (+ i 1))))
    (return -1)))

(defn ^I32 ft-dec [^Blob b ^I32 from ^I32 to]
  (let [^:mut ^I32 k from
        ^:mut ^I32 v 0]
    (while (< k to)
      (do (set v (+ (* v 10) (- (blob-u8 b k) 48)))
          (set k (+ k 1))))
    (return v)))

(defn ^I32 ft-filter [^Blob b ^I32 from ^I32 to]
  (comment "The `pf-filter` code for a filter name, told apart by length.")
  (let [^I32 n (- to from)]
    (if (== n 14) (return (pf-f-hex)))
    (if (== n 13) (return (pf-f-a85)))
    (if (== n 9) (return (pf-f-lzw)))
    (if (== n 11) (return (pf-f-flate)))
    (if (== n 15) (return 5))
    (return 0)))

(defn ^I32 ft-parm [^Blob b ^I32 from ^I32 to ^I32 key ^I32 dflt]
  (comment "The value of `key` in `P=1,C=2` parameters (`-` for none): the key is")
  (comment "named by its first letter and, for C, its fourth (Columns / Colors).")
  (comment "Keys: 80 Predictor, 67 Columns, 99 Colors, 66 BitsPerComponent,")
  (comment "69 EarlyChange.")
  (let [^:mut ^I32 k from
        ^:mut ^I32 e 0
        ^:mut ^I32 eq 0
        ^:mut ^I32 id 0]
    (while (< k to)
      (do (set e k)
          (while (and (< e to) (!= (blob-u8 b e) 44))
            (set e (+ e 1)))
          (set eq k)
          (while (and (< eq e) (!= (blob-u8 b eq) 61))
            (set eq (+ eq 1)))
          (if (< eq e)
            (do (set id (blob-u8 b k))
                (if (== id 67)
                  (if (== (blob-u8 b (+ k 3)) 111) (set id 99)))
                (if (== id key)
                  (return (ft-dec b (+ eq 1) e)))))
          (set k (+ e 1))))
    (return dflt)))

(defn ^I32 ft-run [^Blob f ^I32 s1 ^I32 s2 ^I32 s3 ^I32 s4 ^:mut ^Cells inp
                   ^:mut ^Cells out ^:mut ^Cells tmp ^:mut ^Cells st]
  (comment "Run the row whose filter is f[s1+1, s2), parameters f[s2+1, s3) and")
  (comment "input hex f[s3+1, s4): the filter, then a predictor when /Predictor")
  (comment "says so. Answers the first non-zero status, with out filled.")
  (let [^I32 code (ft-filter f (+ s1 1) s2)
        ^I32 pred (ft-parm f (+ s2 1) s3 80 1)
        ^I32 early (ft-parm f (+ s2 1) s3 69 1)
        ^:mut ^I32 status 0
        ^:mut ^I32 n 0
        ^:mut ^I32 p 0]
    (set n (ft-hex-into f (+ s3 1) s4 inp))
    (cells-drop out 0)
    (cells-drop tmp 0)
    (if (> pred 1)
      (do (set status (pf-run code (cells-blob inp) 0 n tmp st early))
          (set p (pf-predict tmp 0 (cells-len tmp) out pred
                             (ft-parm f (+ s2 1) s3 99 1)
                             (ft-parm f (+ s2 1) s3 66 8)
                             (ft-parm f (+ s2 1) s3 67 1)))
          (if (== status 0) (set status p)))
      (set status (pf-run code (cells-blob inp) 0 n out st early)))
    (return status)))

(deftest test-every-row-of-the-filter-corpus
  (let [^Blob f (test-file "pdf/filters.txt")
        ^Cells inp (new-cells)
        ^Cells out (new-cells)
        ^Cells tmp (new-cells)
        ^Cells st (new-cells)
        ^I32 n (blob-len f)
        ^:mut ^I32 pos 0
        ^:mut ^I32 line 0
        ^:mut ^I32 rows 0
        ^:mut ^I32 e 0
        ^:mut ^I32 s1 0
        ^:mut ^I32 s2 0
        ^:mut ^I32 s3 0
        ^:mut ^I32 s4 0
        ^:mut ^I32 s5 0
        ^:mut ^I32 status 0]
    (while (< pos n)
      (do (set line (+ line 1))
          (set e (ft-nl f pos))
          (if (and (< pos e) (!= (blob-u8 f pos) 35))
            (do (set rows (+ rows 1))
                (set s1 (ft-tab f pos e))
                (set s2 (ft-tab f (+ s1 1) e))
                (set s3 (ft-tab f (+ s2 1) e))
                (set s4 (ft-tab f (+ s3 1) e))
                (set s5 (ft-tab f (+ s4 1) e))
                (set status (ft-run f s1 s2 s3 s4 inp out tmp st))
                (let [^Text t (new-text)]
                  (pf-status-emit-name t status)
                  (assert-text-span t f (+ s4 1) s5 "status" line))
                (assert-eq-at (ft-compare out f (+ s5 1) e) -1 "output" line)))
          (set pos (+ e 1))))
    (assert-that (> rows 60) "the corpus was read")))

(deftest test-filters-append-to-what-is-there
  (let [^Cells out (new-cells)]
    (cells-push out 33)
    (assert-eq (pf-hex (text-blob "4849>") 0 5 out) 0 "status")
    (assert-cells-hex out "214849" "appended after the existing byte")))

(deftest test-the-input-range-is-respected
  (let [^Cells out (new-cells)]
    (assert-eq (pf-a85 (text-blob "xx87cURDZ~>xx") 2 11 out) 0 "a85 status")
    (assert-cells-hex out "48656c6c6f" "a85 range")))

(deftest test-crypt-is-the-identity-and-image-filters-are-declined
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (pf-run (pf-f-crypt) (hex-blob "0102") 0 2 out st 1) 0 "crypt")
    (assert-cells-hex out "0102" "unchanged")
    (assert-eq (pf-run (pf-f-dct) (hex-blob "ffd8") 0 2 out st 1) (pf-image-filter) "dct declined")
    (assert-eq (cells-len out) 2 "out untouched by an image filter")
    (assert-eq (pf-run 99 (hex-blob "00") 0 1 out st 1) (pf-unsupported) "unknown")))

;; ------------------------------------------------- LZW as string copies
;;
;; (P10.3a, D422) The decoder's table is spans of its own output, so the laws
;; are about where a span can start: a string that is the code about to be
;; added (KwKwK), width changes at 511 / 512 entries, a table that is full.
;; The small streams are packed by a babashka encoder (kin/scripts/lzw-vectors)
;; and read back by an independent decoder (in the same script); the large ones are built
;; here, code by code, by a packer that takes the width from the entry count.

(defn ^I32 lz-width [^I32 j ^I32 early]
  (comment "The width of code number j (from 0) after a clear code: the table")
  (comment "then has 258 + max(0, j - 1) entries, 4096 at most, and codes are 10")
  (comment "bits from 512 entries, 11 from 1024 and 12 from 2048 (less `early`).")
  (let [^:mut ^I32 n (+ 258 (- j 1))
        ^:mut ^I32 w 9]
    (if (< j 1) (set n 258))
    (if (> n 4096) (set n 4096))
    (if (>= (+ n early) 512) (set w 10))
    (if (>= (+ n early) 1024) (set w 11))
    (if (>= (+ n early) 2048) (set w 12))
    (return w)))

(defn ^I32 lz-put [^:mut ^Cells z ^:mut ^Cells s ^I32 code ^I32 width]
  (comment "Append `code` in `width` bits, most significant first, to z; s holds")
  (comment "the bits not yet a byte (their value, then how many).")
  (let [^:mut ^I32 acc (+ (* (cells-at s 0) (shl32 1 width)) code)
        ^:mut ^I32 nb (+ (cells-at s 1) width)]
    (while (>= nb 8)
      (do (cells-push z (bit-and (sar32 acc (- nb 8)) 255))
          (set nb (- nb 8))
          (set acc (bit-and acc (- (shl32 1 nb) 1)))))
    (cells-set s 0 acc)
    (cells-set s 1 nb)
    (return 0)))

(defn ^I32 lz-end [^:mut ^Cells z ^:mut ^Cells s]
  (comment "Pad the last byte with zero bits.")
  (if (> (cells-at s 1) 0)
    (cells-push z (* (cells-at s 0) (shl32 1 (- 8 (cells-at s 1))))))
  (return 0))

(defn ^I32 lz-check-hex [^TestT emon-t ^Blob z ^I32 early ^Str want]
  (let [^Cells out (new-cells)
        ^Cells st (new-cells)]
    (assert-eq (pf-lzw z 0 (blob-len z) out st early) 0 "status")
    (assert-cells-hex out want "output")
    (return 0)))

(deftest test-lzw-a-code-that-is-the-entry-being-added
  (comment "KwKwK: a code equal to the next free one, whose string is the string")
  (comment "before it and that string's first byte. After a single byte (97, 258:")
  (comment "aaa), repeatedly (the chain 258..261 gives 2, 3, 4, 5 bytes), and after")
  (comment "a pair, with a copy from the middle of the output (A B, AB, ABA).")
  (lz-check-hex (test-t) (hex-blob "8018605010") 1 "616161")
  (lz-check-hex (test-t) (hex-blob "8018605038241602") 1 "616161616161616161616161616161")
  (lz-check-hex (test-t) (hex-blob "80104850282404") 1 "41424142414241"))

(defn ^I32 lz-check-literals [^TestT emon-t ^I32 early ^I32 n]
  (comment "n codes, every one the byte 97: the table grows by one entry for each")
  (comment "(until it is full), the width steps up when the rule says, and every")
  (comment "code must still be read as itself.")
  (let [^Cells z (new-cells)
        ^Cells s (new-cells)
        ^Cells out (new-cells)
        ^Cells st (new-cells)
        ^:mut ^I32 i 0]
    (cells-push s 0)
    (cells-push s 0)
    (lz-put z s 256 9)
    (while (< i n)
      (do (lz-put z s 97 (lz-width i early))
          (set i (+ i 1))))
    (lz-put z s 257 (lz-width n early))
    (lz-end z s)
    (assert-eq (pf-lzw (cells-blob z) 0 (cells-len z) out st early) 0 "status")
    (assert-eq (cells-len out) n "length")
    (set i 0)
    (while (< i n)
      (do (assert-eq-at (cells-at out i) 97 "a" i)
          (set i (+ i 1))))
    (return 0)))

(deftest test-lzw-code-width-boundaries
  (comment "Around 511 / 512 entries (9 to 10 bits), 1023 / 1024, 2047 / 2048 and")
  (comment "with the table full (4096 entries is 3838 codes after the first), for")
  (comment "EarlyChange 1 and 0.")
  (lz-check-literals (test-t) 1 253)
  (lz-check-literals (test-t) 1 254)
  (lz-check-literals (test-t) 0 254)
  (lz-check-literals (test-t) 0 255)
  (lz-check-literals (test-t) 1 766)
  (lz-check-literals (test-t) 0 767)
  (lz-check-literals (test-t) 1 1790)
  (lz-check-literals (test-t) 0 1791)
  (lz-check-literals (test-t) 1 3900)
  (lz-check-literals (test-t) 0 4300))

(defn ^I32 lz-check-chain [^TestT emon-t ^I32 early ^I32 m]
  (comment "The byte 97 and then m codes that are each the entry being added: the")
  (comment "strings are 2, 3, ... m + 1 bytes of 97, copied from the output just")
  (comment "written, across the width steps at 511 and 1023 entries.")
  (let [^Cells z (new-cells)
        ^Cells s (new-cells)
        ^Cells out (new-cells)
        ^Cells st (new-cells)
        ^:mut ^I32 i 0]
    (cells-push s 0)
    (cells-push s 0)
    (lz-put z s 256 9)
    (lz-put z s 97 9)
    (while (< i m)
      (do (lz-put z s (+ 258 i) (lz-width (+ i 1) early))
          (set i (+ i 1))))
    (lz-put z s 257 (lz-width (+ m 1) early))
    (lz-end z s)
    (assert-eq (pf-lzw (cells-blob z) 0 (cells-len z) out st early) 0 "status")
    (assert-eq (cells-len out) (+ (+ 1 m) (quot (* m (+ m 1)) 2)) "length")
    (set i 0)
    (while (< i (cells-len out))
      (do (assert-eq-at (cells-at out i) 97 "a" i)
          (set i (+ i 1))))
    (return 0)))

(deftest test-lzw-strings-grow-across-width-steps
  (lz-check-chain (test-t) 1 1100)
  (lz-check-chain (test-t) 0 1100))

(defn ^I32 pf-check-png [^TestT emon-t ^Blob in ^I32 colors ^I32 bpc ^I32 columns ^Str want]
  (comment "Predictor 15 over the bytes of `in`, against the pixels they encode.")
  (let [^Cells src (new-cells)
        ^Cells out (new-cells)
        ^:mut ^I32 i 0]
    (while (< i (blob-len in))
      (do (cells-push src (blob-u8 in i))
          (set i (+ i 1))))
    (assert-eq (pf-predict src 0 (cells-len src) out 15 colors bpc columns) 0 "status")
    (assert-cells-hex out want "pixels")
    (return 0)))

(deftest test-png-predictors-for-each-pixel-size
  (comment "Rows of every filter type (0 none, 1 sub, 2 up, 3 average, 4 Paeth) in")
  (comment "turn, for 1, 3 and 4 bytes a pixel and for sub-byte pixels (a pixel is")
  (comment "a byte when it is under 8 bits); made by a babashka filter from known")
  (comment "pixels, so the pixels are the answer.")
  (pf-check-png (test-t)
                (hex-blob "00b6806683818281fb80015a286699ff38fc13bb0227ff1d5294cacfacfe0341008ab1b1a80c0a610402097a3a851bef10af04fde83bfe02ff57a6020342d4f5130201deed4a02a8472346fafdc8dfc40183ff56aa906fffb84800818083bc6f818983d0")
                1 8 9
                "b6806683818281fb805a82e88180b8b4c782818105d314828373808181cd81fb668083e2838c47818081708091807482808281c76d82824f5d8183838365bd2a9680c77d804b44818382d8821281803880818083bc6f818983d0")
  (pf-check-png (test-t)
                (hex-blob "0482838113ff00ebff0203b8fd03424240932d030c53001ff10c0203fd03622200bdc6fe4b0bf90181d78234aa00cc69ffc9dd020034ad758a5f8380804e475883018082cc8801cb4d9b5058ff9a0428feb5790342026299ee01f5032f40e0ff02576e976baed6c802fe67610091b9626a720d8a79")
                3 8 4
                "8283819582818081838339808383801faf835beb838e838d86808381d18318b181d98e8681d782b5818281ea814ac78334ad758a5f8380804e4758838082cc088397551ee7ad1d81a880818183c38380809b81758380208183c8f0180f73220a81e78181148152828180ac83")
  (pf-check-png (test-t)
                (hex-blob "013982ed6a5b009316020b01932d64210101035e4198c775f18338045c01aa700261bacd0080d281818d83320b")
                4 8 2
                "3982ed6a9482808044838097f8a381818082d81231832f81dc83828282e4e94f80d281818d83320b")
  (pf-check-png (test-t)
                (hex-blob "0313a9046fd10200b2017c3004bf0500e1c3")
                1 1 12
                "13b2828382357cac3b81e1c3"))
