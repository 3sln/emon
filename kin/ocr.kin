;; The OCR answer's EXTENSION (P2.6 spike; SPEC 7.2 `Ocr`, 8.3; D094). emon's own
;; module (D039).
;;
;; `emon.plan` (D089) defines an OCR answer's WORDS: `status nwords word...`, each
;; word `x y w h conf line block len cp...`. That is enough to fill `ocrwords` with
;; boxes, text and confidences, and no more than that. What SPEC 8.3 and 9.5 ask
;; of an engine -- baselines, symbols, alternatives, orientation, script, the
;; line/paragraph/block hierarchy -- follows the words, in the SAME record, so the
;; record is still length-prefixed and every reader of the words is unchanged. An
;; answer with nothing after its last word has no extension (a fake, a failed
;; engine, an engine that cannot); `ox-find` says so by answering -1.
;;
;;   ext     version orient wdir tlorder deskew osd script sconf oconf nlines
;;           line * nlines   word-ext * nwords       (`ox-line-stride` = 11 per line)
;;   line    x y w h  bx0 by0 bx1 by1  block par btype
;;   wordext flags lang nsym  sym *
;;   sym     x y w h conf ncp nalt  cp * ncp  alt * nalt
;;   alt     ncp conf cp * ncp
;;
;; UNITS. Every coordinate is in the REQUEST BITMAP's pixels (x right, y down);
;; a box is x y w h; a baseline is two points, (bx0, by0) to (bx1, by1). `conf` is
;; x10 (0..1000), -1 absent. `orient`, `wdir` and `tlorder` are the engine's layout
;; enums VERBATIM (Tesseract: page-up 0, right 1, down 2, left 3; writing
;; left-to-right 0, right-to-left 1, top-to-bottom 2; line order the same three);
;; `deskew` is centi-degrees. `osd` is the OSD orientation in degrees (0, 90, 180,
;; 270 as the engine reports it, -1 when OSD did not run). `script` is the OSD
;; script name, up to four ASCII chars packed big-endian ("Latn"), 0 none; `sconf`
;; and `oconf` the OSD script and orientation confidences x10, -1 when it did not
;; run. `flags` are the Model's `sy` bits (bold 1,
;; italic 2, underline 4, mono 64, smallcaps 128); `lang` is the engine's language
;; for the word, packed like a request's ("eng"), 0 unknown. `btype` is the block
;; kind (`bt`): 0 text, 1 table, 2 image, 3 line, 4 other. A word's `line` is the
;; index of its line in the line list, and `par` a paragraph number unique in the
;; answer (-1 when the engine does not say).
;;
;; A symbol is what the engine read as ONE glyph: its box, its confidence, its
;; text (usually one code point; a ligature is several) and its other candidates.
;; The alternatives are the engine's own, unranked beyond their confidences.
;;
;; The builders are called by a host, the readers by kin. Symbols are LAST in the
;; word, so a host builds word, then its symbols; it must finish one word before
;; starting the next, and one symbol before the next (the counts are patched at the
;; start of the thing being built, which is why the start is handed back).
(ns emon.ocr
  (:require [emon.lang :refer [I32 Cells]]
            [emon.port :refer [cells-len cells-at cells-set cells-push]]
            [emon.plan :refer [an-ocr-count an-ocr-first aw-next]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(defn ^:pub ^I32 ocf-symbols [] (return 1))   ;; request flag: symbols and their alternatives
(defn ^:pub ^I32 ocf-osd [] (return 2))       ;; request flag: orientation and script detection

(defn ^:pub ^I32 bt-text [] (return 0))
(defn ^:pub ^I32 bt-table [] (return 1))
(defn ^:pub ^I32 bt-image [] (return 2))
(defn ^:pub ^I32 bt-line [] (return 3))
(defn ^:pub ^I32 bt-other [] (return 4))

(defn ^:pub ^I32 ox-version [] (return 1))
(defn ^:pub ^I32 ox-header [] (return 10))
(defn ^:pub ^I32 ox-line-stride [] (return 11))

;; ---------------------------------------------------------------- builders

(defn ^:pub ^I32 ox-begin [^:mut ^Cells c ^I32 orient ^I32 wdir ^I32 tlorder ^I32 deskew
                           ^I32 osd ^I32 script ^I32 sconf ^I32 oconf ^I32 nlines]
  (comment "Start the extension after the LAST word of an answer; then `nlines`")
  (comment "calls of `ox-line`, then per word `ox-word` and its `ox-sym`s. The")
  (comment "answer's own length is fixed by `an-ocr-end`, as ever.")
  (let [^I32 at (cells-len c)]
    (cells-push c (ox-version))
    (cells-push c orient)
    (cells-push c wdir)
    (cells-push c tlorder)
    (cells-push c deskew)
    (cells-push c osd)
    (cells-push c script)
    (cells-push c sconf)
    (cells-push c oconf)
    (cells-push c nlines)
    (return at)))

(defn ^:pub ^I32 ox-line [^:mut ^Cells c ^I32 x ^I32 y ^I32 w ^I32 h
                          ^I32 bx0 ^I32 by0 ^I32 bx1 ^I32 by1
                          ^I32 block ^I32 par ^I32 btype]
  (cells-push c x)
  (cells-push c y)
  (cells-push c w)
  (cells-push c h)
  (cells-push c bx0)
  (cells-push c by0)
  (cells-push c bx1)
  (cells-push c by1)
  (cells-push c block)
  (cells-push c par)
  (cells-push c btype)
  (return 0))

(defn ^:pub ^I32 ox-word [^:mut ^Cells c ^I32 flags ^I32 lang]
  (comment "Start a word's extension; answers its start, which `ox-sym` wants.")
  (let [^I32 at (cells-len c)]
    (cells-push c flags)
    (cells-push c lang)
    (cells-push c 0)
    (return at)))

(defn ^:pub ^I32 ox-sym [^:mut ^Cells c ^I32 word ^I32 x ^I32 y ^I32 w ^I32 h ^I32 conf]
  (comment "Start a symbol of the word begun at `word`; answers the symbol's start.")
  (comment "Add its code points with `ox-sym-cp` THEN its alternatives with `ox-alt`.")
  (let [^I32 at (cells-len c)]
    (cells-set c (+ word 2) (+ (cells-at c (+ word 2)) 1))
    (cells-push c x)
    (cells-push c y)
    (cells-push c w)
    (cells-push c h)
    (cells-push c conf)
    (cells-push c 0)
    (cells-push c 0)
    (return at)))

(defn ^:pub ^I32 ox-sym-cp [^:mut ^Cells c ^I32 sym ^I32 cp]
  (cells-set c (+ sym 5) (+ (cells-at c (+ sym 5)) 1))
  (cells-push c cp)
  (return 0))

(defn ^:pub ^I32 ox-alt [^:mut ^Cells c ^I32 sym ^I32 conf]
  (comment "Start an alternative of symbol `sym`; add its code points with `ox-alt-cp`.")
  (let [^I32 at (cells-len c)]
    (cells-set c (+ sym 6) (+ (cells-at c (+ sym 6)) 1))
    (cells-push c 0)
    (cells-push c conf)
    (return at)))

(defn ^:pub ^I32 ox-alt-cp [^:mut ^Cells c ^I32 alt ^I32 cp]
  (cells-set c alt (+ (cells-at c alt) 1))
  (cells-push c cp)
  (return 0))

;; ----------------------------------------------------------------- readers

(defn ^:pub ^I32 ox-find [^Cells c ^I32 at]
  (comment "The start of the extension of the OCR answer at `at`, or -1 when it has")
  (comment "none (or is not version 1). Walks the words to find it.")
  (let [^I32 end (+ at (cells-at c at))
        ^I32 n (an-ocr-count c at)
        ^:mut ^I32 w (an-ocr-first c at)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (set w (aw-next c w))
          (set i (+ i 1))))
    (if (>= (+ w (ox-header)) (+ end 1)) (return -1))
    (if (!= (cells-at c w) (ox-version)) (return -1))
    (return w)))

(defn ^:pub ^I32 ox-get [^Cells c ^I32 ext ^I32 k] (return (cells-at c (+ ext k))))
(defn ^:pub ^I32 ox-orient [^Cells c ^I32 ext] (return (cells-at c (+ ext 1))))
(defn ^:pub ^I32 ox-wdir [^Cells c ^I32 ext] (return (cells-at c (+ ext 2))))
(defn ^:pub ^I32 ox-tlorder [^Cells c ^I32 ext] (return (cells-at c (+ ext 3))))
(defn ^:pub ^I32 ox-deskew [^Cells c ^I32 ext] (return (cells-at c (+ ext 4))))
(defn ^:pub ^I32 ox-osd [^Cells c ^I32 ext] (return (cells-at c (+ ext 5))))
(defn ^:pub ^I32 ox-script [^Cells c ^I32 ext] (return (cells-at c (+ ext 6))))
(defn ^:pub ^I32 ox-sconf [^Cells c ^I32 ext] (return (cells-at c (+ ext 7))))
(defn ^:pub ^I32 ox-oconf [^Cells c ^I32 ext] (return (cells-at c (+ ext 8))))
(defn ^:pub ^I32 ox-nlines [^Cells c ^I32 ext] (return (cells-at c (+ ext 9))))

(defn ^:pub ^I32 ox-line-at [^Cells c ^I32 ext ^I32 k]
  (return (+ (+ ext (ox-header)) (* k (ox-line-stride)))))

(defn ^:pub ^I32 ox-first-word [^Cells c ^I32 ext]
  (comment "The start of the first word's extension.")
  (let [^I32 n (ox-nlines c ext)]
    (return (ox-line-at c ext n))))

(defn ^:pub ^I32 ox-wflags [^Cells c ^I32 w] (return (cells-at c w)))
(defn ^:pub ^I32 ox-wlang [^Cells c ^I32 w] (return (cells-at c (+ w 1))))
(defn ^:pub ^I32 ox-nsym [^Cells c ^I32 w] (return (cells-at c (+ w 2))))
(defn ^:pub ^I32 ox-first-sym [^Cells c ^I32 w] (return (+ w 3)))

(defn ^:pub ^I32 ox-alt-next [^Cells c ^I32 alt]
  (return (+ (+ alt 2) (cells-at c alt))))

(defn ^:pub ^I32 ox-sym-alts [^Cells c ^I32 sym]
  (comment "The start of the first alternative of a symbol.")
  (return (+ (+ sym 7) (cells-at c (+ sym 5)))))

(defn ^:pub ^I32 ox-sym-next [^Cells c ^I32 sym]
  (let [^I32 n (cells-at c (+ sym 6))
        ^:mut ^I32 a (ox-sym-alts c sym)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (set a (ox-alt-next c a))
          (set i (+ i 1))))
    (return a)))

(defn ^:pub ^I32 ox-word-next [^Cells c ^I32 w]
  (let [^I32 n (cells-at c (+ w 2))
        ^:mut ^I32 s (ox-first-sym c w)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (set s (ox-sym-next c s))
          (set i (+ i 1))))
    (return s)))
