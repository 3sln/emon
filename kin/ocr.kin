;; OCR request flags and normalized block kinds. OIL owns the answer.
(ns emon.ocr
  (:require [emon.lang :refer [I32]]
            [kin.lang :refer [defn return comment quot]]))

(defn ^:pub ^I32 ocf-symbols [] (return 1))   ;; request flag: symbols and their alternatives
(defn ^:pub ^I32 ocf-osd [] (return 2))       ;; request flag: orientation and script detection
(defn ^:pub ^I32 ocf-best [] (return 4)) ;; optional eng_best, explicit request only (D787)
(defn ^:pub ^I32 ocf-dpi-unit [] (return 256)) ;; the request's flags above the low byte are the resolution hint, dpi (D211)

(defn ^:pub ^I32 ocf-dpi [^I32 flags]
  (comment "The resolution the request says its bitmap has, dots per inch; 0 none. A hint for the engine's size")
  (comment "heuristics: the flags above the low byte.")
  (return (quot flags (ocf-dpi-unit))))

(defn ^:pub ^I32 ocw-dict [] (return 1))      ;; a word's `dflags`: from the engine's dictionary
(defn ^:pub ^I32 ocw-numeric [] (return 2))   ;; ... numeric

(defn ^:pub ^I32 bt-text [] (return 0))
(defn ^:pub ^I32 bt-table [] (return 1))
(defn ^:pub ^I32 bt-image [] (return 2))
(defn ^:pub ^I32 bt-line [] (return 3))
(defn ^:pub ^I32 bt-other [] (return 4))
