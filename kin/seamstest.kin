(ns emon.seamstest
  (:require [emon.lang :refer [I32 Cells Bitmap]]
            [emon.test :refer [deftest assert-eq new-cells new-bitmap-set TestT test-t]]
            [emon.port :refer [cells-push cells-at cells-set cells-len bms-put bitmap-set-u8]]
            [emon.evidence :refer [ln-new ln-count ln-set lf-order wd-new wd-get wd-set wd-count hd-conf hd-tstart
                                   ol-new ol-set olf-conf ow-new ow-set owf-flags oe-clipped]]
            [emon.model :refer [page-new pk-image ledger-count ledger-page model-init model-check
                                node-count node-kind node-flags nk-row nk-cell fl-seam-gap]]
            [emon.seams :refer [ms-run ms-ncc ms-sample-cut ms-similarity]]
            [emon.table :refer [tb-seam-gaps tb-emit]]
            [kin.lang :refer [defn let if do set while return + - * rem < == and or]]))

(defn ^I32 law-line [^:mut ^Cells fl ^:mut ^Cells fw ^:mut ^Cells et ^I32 page ^I32 y ^I32 cp]
  (let [^I32 start (cells-len et)
        ^I32 line (ln-count fl)
        ^I32 word (wd-new fw page 50 y 400 (+ y 12) 50 (+ y 12) 400 (+ y 12) 0 0 start 1 line 900 -1)]
    (cells-push et cp)
    (ln-new fl page 50 y 400 (+ y 12) 50 (+ y 12) 400 (+ y 12) 0 0 word 1)
    (return 0)))

(defn ^I32 law-seam [^TestT emon-t ^I32 capture ^I32 born ^I32 strong ^I32 middle ^I32 clip
                    ^I32 expected-drop ^I32 expected-kind]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells ol (new-cells)
        ^Cells decisions (new-cells) ^Cells ledger (new-cells) ^Cells text (new-cells)
        ^:mut ^I32 i 0 ^:mut ^I32 r 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1)
    (cells-push mask (- 1 born))
    (law-line fl fw et 1 400 81)
    (law-line fl fw et 2 295 32)
    (while (< i strong)
      (do (if (== i 2)
            (do (law-line fl fw et 1 (+ 500 (* 20 i)) 45)
                (law-line fl fw et 2 (+ 300 (* 20 i)) 61)))
          (law-line fl fw et 1 (+ 507 (* 20 i)) (+ 65 i))
          (law-line fl fw et 2 (+ 307 (* 20 i)) (+ 65 i))
          (set i (+ i 1))))
    (if (== middle 1) (law-line fl fw et 1 600 90))
    (if (== clip 1)
      (do (set r (ol-new ol 1 50 993 400 1000 50 993 400 993 0 0 -1 0))
          (ol-set ol r (olf-conf) 300)))
    (law-line fl fw et 2 400 82)
    (assert-eq (ms-run 2 capture mask pages ol (new-cells) et fl fw (new-cells) (new-cells) (new-cells) ledger text decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)) expected-drop "rows dropped")
    (assert-eq (ledger-count ledger) expected-drop "dropped rows retained in ledger")
    (if (== expected-kind 0)
      (assert-eq (cells-len decisions) 0 "no seam on an ordinary break")
      (assert-eq (cells-at decisions 2) expected-kind "expected seam decision"))
    (return 0)))

(deftest test-strong-anchored-seam-ignores-whitespace-and-deduplicates-separators
  (law-seam (test-t) 0 0 4 0 0 5 1))

(deftest test-three-anchored-content-rows-are-strong
  (law-seam (test-t) 0 0 3 0 0 4 1))

(deftest test-interior-match-is-not-a-seam
  (law-seam (test-t) 2 0 4 1 0 0 0))

(deftest test-single-copy-match-is-ambiguous
  (law-seam (test-t) 2 0 1 0 0 0 2))

(deftest test-a-linked-table-gap-emits-an-unread-row
  (let [^Cells tables (new-cells) ^Cells seams (new-cells) ^Cells empty (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells)
        ^Cells text (new-cells) ^Cells pages (new-cells) ^Cells ledger (new-cells)
        ^Cells layout (new-cells) ^:mut ^I32 i 0]
    (model-init nodes attrs regions text pages ledger layout)
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (while (< i 64) (do (cells-push tables 0) (set i (+ i 1))))
    (set i 0)
    (while (< i 2)
      (do (let [^I32 base (* i 32)]
            (cells-set tables base (+ i 1))
            (cells-set tables (+ base 3) 450)
            (cells-set tables (+ base 4) 1000)
            (cells-set tables (+ base 5) 4)
            (cells-set tables (+ base 8) 2))
          (set i (+ i 1))))
    (cells-set tables 18 2)
    (cells-set tables 19 2)
    (cells-set tables 53 1)
    (cells-push seams 1) (cells-push seams 2) (cells-push seams 3)
    (cells-push seams 0) (cells-push seams 0)
    (tb-seam-gaps tables seams)
    (tb-emit tables 0 0 empty empty empty empty empty empty nodes attrs regions text
             (new-cells) (new-cells) ledger)
    (assert-eq (model-check nodes attrs regions text pages ledger layout (new-cells)) 0 "the unread row is a valid Model")
    (assert-eq (node-count nodes) 6 "one row with two cells")
    (assert-eq (node-kind nodes 3) (nk-row) "the gap belongs to the table body")
    (assert-eq (node-flags nodes 3) (fl-seam-gap) "the row is unread")
    (assert-eq (node-kind nodes 4) (nk-cell) "the unread row keeps the table columns")
    (assert-eq (node-flags nodes 4) (fl-seam-gap) "the first cell is unread")
    (assert-eq (node-flags nodes 5) (fl-seam-gap) "the second cell is unread")))

(deftest test-clean-break-and-clipped-gap
  (law-seam (test-t) 2 0 0 0 0 0 0)
  (law-seam (test-t) 2 0 0 0 1 0 3))

(deftest test-an-overlap-does-not-hide-an-uncovered-cut
  (law-seam (test-t) 2 0 4 0 1 5 3))

(defn ^I32 law-shallow-cut [^TestT emon-t ^I32 confidence ^I32 expected-marks]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells cuts (new-cells)
        ^Cells ol (new-cells) ^Cells ow (new-cells) ^Cells decisions (new-cells)
        ^:mut ^I32 i 0 ^:mut ^I32 word 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (cells-push cuts 0) (cells-push cuts -1) (cells-push cuts 0) (cells-push cuts 0)
    (law-line fl fw et 1 600 65)
    (law-line fl fw et 2 100 66)
    (ol-new ol 1 50 988 400 1000 50 988 400 988 0 0 0 3)
    (ol-set ol 0 (olf-conf) 300)
    (while (< i 3)
      (do (set word (ow-new ow 1 50 988 80 1000 50 988 80 988 0 0
                            (cells-len et) 1 0 confidence 0))
          (ow-set ow word (owf-flags) (oe-clipped))
          (cells-push et (+ 67 i))
          (set i (+ i 1))))
    (assert-eq (ms-run 2 0 mask pages ol ow et fl fw (new-cells) (new-cells) cuts
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               0 "a cut warning never deletes a reading")
    (assert-eq (cells-len decisions) expected-marks "weak cut geometry needs uncertain OCR")
    (return 0)))

(deftest test-shallow-rule-strokes-do-not-make-a-confident-line-a-gap
  (law-shallow-cut (test-t) 900 0)
  (law-shallow-cut (test-t) 450 5))

(deftest test-scan-mode-and-born-digital-pass-through
  (law-seam (test-t) 1 0 4 0 0 0 0)
  (law-seam (test-t) 2 1 4 0 0 0 0))

(defn ^I32 law-reversed-link [^TestT emon-t ^I32 np ^I32 earlier]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells order (new-cells)
        ^Cells ledger (new-cells) ^Cells decisions (new-cells) ^:mut ^I32 i 0]
    (while (< i np)
      (do (page-new pages (+ i 1) 450 1000 0 (pk-image))
          (cells-push mask 1)
          (set i (+ i 1))))
    (set i 0)
    (while (< i 4)
      (do (law-line fl fw et 1 (+ 20 (* i 30)) (+ 65 i))
          (wd-set fw (- (ln-count fl) 1) (hd-conf) 950)
          (set i (+ i 1))))
    (law-line fl fw et 1 450 92)
    (if (== np 3) (law-line fl fw et 2 450 93))
    (law-line fl fw et earlier 50 91)
    (set i 0)
    (while (< i 4)
      (do (law-line fl fw et earlier (+ 700 (* i 30)) (+ 65 i))
          (set i (+ i 1))))
    (assert-eq (ms-run np 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       ledger (new-cells) decisions (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells) (new-cells) order (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               4 "remove the lower-confidence copy")
    (assert-eq (cells-at order 0) earlier "the earlier source page starts the document")
    (assert-eq (cells-at order 1) 1 "source page one follows")
    (if (== np 3) (assert-eq (cells-at order 2) 2 "the unrelated page remains in the document"))
    (assert-eq (cells-at decisions 0) earlier "the seam preserves upload provenance")
    (assert-eq (ledger-page ledger 0) earlier "the earlier photo supplied the lower-confidence copy")
    (assert-eq (ln-count fl) (+ np 4) "keep all distinct lines and one copy of the overlap")
    (return 0)))

(deftest test-reversed-photos-use-the-unique-anchored-order
  (law-reversed-link (test-t) 2 2))

(deftest test-a-confirmed-link-survives-a-disconnected-upload
  (law-reversed-link (test-t) 3 3))

(deftest test-the-stronger-of-two-anchored-links-resolves-the-order
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells order (new-cells)
        ^Cells decisions (new-cells) ^:mut ^I32 i 0]
    (while (< i 3)
      (do (page-new pages (+ i 1) 450 1000 0 (pk-image))
          (cells-push mask 1)
          (set i (+ i 1))))
    (set i 0)
    (while (< i 5)
      (do (law-line fl fw et 1 (+ 50 (* i 30)) (+ 65 i))
          (set i (+ i 1))))
    (law-line fl fw et 1 300 90)
    (law-line fl fw et 2 50 91)
    (set i 0)
    (while (< i 5)
      (do (law-line fl fw et 2 (+ 750 (* i 30)) (+ 65 i))
          (set i (+ i 1))))
    (set i 1)
    (while (< i 5)
      (do (law-line fl fw et 3 (+ 50 (* i 30)) (+ 65 i))
          (set i (+ i 1))))
    (law-line fl fw et 3 300 92)
    (assert-eq (ms-run 3 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) decisions (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells) (new-cells) order (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               5 "the five-line link wins over the four-line candidate")
    (assert-eq (cells-at order 0) 2 "the strongest link starts at photo two")
    (assert-eq (cells-at order 1) 1 "the strongest link ends at photo one")
    (assert-eq (cells-at order 2) 3 "leave the competing photo in the document")))

(deftest test-several-strokes-at-the-bitmap-edge-are-clipping-evidence
  (let [^Bitmap pixels (bms-put (new-bitmap-set) 1 50 12 1)
        ^Cells cuts (new-cells) ^:mut ^I32 x 0 ^:mut ^I32 y 0]
    (while (< y 12)
      (do (set x 0)
          (while (< x 50)
            (do (bitmap-set-u8 pixels x y 0 255) (set x (+ x 1))))
          (set y (+ y 1))))
    (set y 10)
    (while (< y 12)
      (do (set x 12)
          (while (< x 40)
            (do (bitmap-set-u8 pixels x y 0 20) (set x (+ x 12))))
          (set y (+ y 1))))
    (ms-sample-cut pixels 1 cuts)
    (assert-eq (cells-at cuts 1) -1 "a thin broken rule supplies shallow strokes only")
    (set y 7)
    (while (< y 10)
      (do (set x 12)
          (while (< x 40)
            (do (bitmap-set-u8 pixels x y 0 20) (set x (+ x 12))))
          (set y (+ y 1))))
    (ms-sample-cut pixels 1 cuts)
    (assert-eq (cells-at cuts 0) 0 "blank top")
    (assert-eq (cells-at cuts 1) 1 "glyphs continue through the lower edge")))

(defn ^I32 law-band-line [^:mut ^Cells fl ^:mut ^Cells fw ^:mut ^Cells et ^I32 page ^I32 y ^I32 n]
  (let [^I32 line (ln-count fl)
        ^:mut ^I32 i 0 ^:mut ^I32 first 0 ^:mut ^I32 word 0 ^:mut ^I32 start 0]
    (while (< i n)
      (do (set start (cells-len et))
          (cells-push et (+ 65 i))
          (if (== page 1) (cells-push et 46) (cells-push et 44))
          (set word (wd-new fw page (+ 50 (* 30 i)) y (+ 75 (* 30 i)) (+ y 12)
                            50 (+ y 12) 400 (+ y 12) 0 0 start 2 line 900 -1))
          (if (== i 0) (set first word))
          (set i (+ i 1))))
    (ln-new fl page 50 y 400 (+ y 12) 50 (+ y 12) 400 (+ y 12) 0 0 first n)
    (return 0)))

(deftest test-an-ocr-variant-needs-context-before-deduplication
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 50 91)
    (law-band-line fl fw et 1 900 3)
    (law-band-line fl fw et 2 50 4)
    (law-line fl fw et 2 500 92)
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) decisions (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               0 "punctuation and an extra tail token do not prove an overlap on their own")
    (assert-eq (cells-at decisions 2) 2 "the OCR variant is still reported as a possible duplicate")))

(deftest test-correlated-neighbors-cannot-confirm-a-shortened-word-band
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells offsets (new-cells) ^Cells pixels (new-cells) ^:mut ^I32 i 0
        ^:mut ^I32 first 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 50 91)
    (set first (wd-count fw))
    (wd-new fw 1 50 870 120 882 50 882 120 882 0 0 (cells-len et) 1 1 900 -1)
    (cells-push et 86)
    (wd-new fw 1 130 870 200 882 130 882 200 882 0 0 (cells-len et) 1 1 900 -1)
    (cells-push et 87)
    (ln-new fl 1 50 870 200 882 50 882 200 882 0 0 first 2)
    (law-line fl fw et 1 895 88)
    (law-line fl fw et 1 920 89)
    (law-line fl fw et 2 50 87)
    (law-line fl fw et 2 75 88)
    (law-line fl fw et 2 100 89)
    (law-line fl fw et 2 500 92)
    (while (< i (ln-count fl))
      (do (ln-set fl i (lf-order) i)
          (cells-push offsets -1)
          (set i (+ i 1))))
    (cells-set offsets 2 0)
    (cells-set offsets 5 384)
    (cells-set offsets 3 0)
    (cells-set offsets 6 384)
    (set i 0)
    (while (< i 768)
      (do (cells-push pixels (rem (* i 17) 128))
          (set i (+ i 1))))
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw offsets pixels (new-cells)
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               0 "correlated neighbors do not make up for a missing word")
    (assert-eq (cells-at decisions 2) 2 "retain both copies of a shortened word band")))

(defn ^I32 law-fragment-anchor [^:mut ^Cells fl ^:mut ^Cells fw ^:mut ^Cells et
                                ^I32 page ^I32 y ^I32 prefix ^I32 last]
  (let [^I32 start (cells-len et) ^I32 line (ln-count fl)
        ^:mut ^I32 i 0 ^:mut ^I32 word 0]
    (while (< i prefix)
      (do (cells-push et (+ 65 i))
          (set i (+ i 1))))
    (cells-push et last)
    (set word (wd-new fw page 50 y 400 (+ y 12) 50 y 400 y 0 0 start (+ prefix 1) line 900 -1))
    (ln-new fl page 50 y 400 (+ y 12) 50 y 400 y 0 0 word 1)
    (return 0)))

(deftest test-distinct-items-can-have-the-same-name-inside-a-fuzzy-run
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 50 91)
    (law-fragment-anchor fl fw et 1 870 7 49)
    (law-line fl fw et 1 900 88)
    (law-fragment-anchor fl fw et 1 930 7 50)
    (law-fragment-anchor fl fw et 2 50 7 51)
    (law-line fl fw et 2 80 88)
    (law-fragment-anchor fl fw et 2 110 7 52)
    (law-line fl fw et 2 400 92)
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               0 "one equal name and fuzzy neighbors leave both items in the Model")
    (assert-eq (ln-count fl) 8 "each item and all its amounts survive")
    (assert-eq (cells-at decisions 2) 2 "report the fuzzy overlap for review")))

(defn ^I32 law-covered-fragment [^TestT emon-t ^I32 shared]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells ol (new-cells) ^Cells ow (new-cells) ^Cells cuts (new-cells)
        ^:mut ^I32 i 0 ^:mut ^I32 w 0 ^:mut ^I32 first 0 ^:mut ^I32 expected 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (cells-push cuts 0) (cells-push cuts 1) (cells-push cuts 0) (cells-push cuts 0)
    (law-line fl fw et 1 50 91)
    (if (== shared 1)
      (do (law-line fl fw et 1 957 88)
          (law-line fl fw et 2 50 88)
          (set expected 1)))
    (if (== shared 2)
      (do (law-fragment-anchor fl fw et 1 957 7 88)
          (law-fragment-anchor fl fw et 2 50 7 89)))
    (set first (wd-count fw))
    (law-band-line fl fw et 2 80 5)
    (ol-new ol 1 50 993 400 1000 50 993 400 993 0 0 0 4)
    (ol-set ol 0 (olf-conf) 300)
    (while (< i 4)
      (do (set w (ow-new ow 1 50 993 80 1000 50 993 80 993 0 0
                         (wd-get fw (+ first i 1) (hd-tstart)) 2 0 300 0))
          (ow-set ow w (owf-flags) (oe-clipped))
          (set i (+ i 1))))
    (assert-eq (ms-run 2 0 mask pages ol ow et fl fw (new-cells) (new-cells) cuts
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               expected "the full copy of the fragment corroborates an exact shared edge line")
    (assert-eq (ln-count fl) (+ 2 shared) "keep every distinct complete line")
    (if (== shared 1)
      (assert-eq (cells-at decisions 2) 1 "report the confirmed overlap")
      (if (== shared 2)
        (assert-eq (cells-at decisions 2) 2 "a single fuzzy row remains ambiguous")
        (assert-eq (cells-len decisions) 0 "the full line covers the fragment")))
    (return 0)))

(deftest test-a-complete-neighboring-copy-covers-a-clipped-fragment
  (law-covered-fragment (test-t) 0))

(deftest test-a-covered-fragment-corroborates-a-single-line-overlap
  (law-covered-fragment (test-t) 1))

(deftest test-a-covered-fragment-keeps-a-single-fuzzy-match-ambiguous
  (law-covered-fragment (test-t) 2))

(defn ^I32 law-cut-and-pixel [^TestT emon-t ^I32 cut]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells offsets (new-cells) ^Cells pixels (new-cells) ^Cells cuts (new-cells)
        ^:mut ^I32 i 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (cells-push cuts 0) (cells-push cuts cut) (cells-push cuts cut) (cells-push cuts 0)
    (law-line fl fw et 1 50 91)
    (law-line fl fw et 1 920 88)
    (law-line fl fw et 2 50 88)
    (law-line fl fw et 2 450 92)
    (ln-set fl 1 (lf-order) 0)
    (ln-set fl 2 (lf-order) 1)
    (cells-push offsets 0) (cells-push offsets 384)
    (while (< i 768)
      (do (cells-push pixels (rem (* i 17) 128))
          (set i (+ i 1))))
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw offsets pixels cuts
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               0 "matching pixels and raster cuts do not prove single-row continuity")
    (assert-eq (cells-at decisions 2) 2 "keep a single-row candidate without textual continuity")
    (return 0)))

(deftest test-pixel-confirmation-of-a-single-line-needs-cut-context
  (law-cut-and-pixel (test-t) 0)
  (law-cut-and-pixel (test-t) 1))

(defn ^I32 law-word-seam [^TestT emon-t ^I32 variant ^I32 expected-drop ^I32 expected-kind]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^:mut ^I32 i 0 ^:mut ^I32 word 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 50 91)
    (while (< i 8)
      (do (law-line fl fw et 1 (+ 700 (* i 25)) (+ 65 i))
          (set i (+ i 1))))
    (set i 0)
    (while (< i 8)
      (do (set word (wd-new fw 2 50 (+ 40 (* i 13)) 90 (+ 53 (* i 13))
                            50 53 90 53 0 0 (cells-len et) 1 (ln-count fl) 900 -1))
          (cells-push et (+ 65 i))
          (wd-new fw 2 100 (+ 40 (* i 13)) 140 (+ 53 (* i 13))
                  100 53 140 53 0 0 (cells-len et) 1 (ln-count fl) 900 -1)
          (cells-push et (+ 66 i))
          (if (and (or (== i 2) (== i 4)) (== variant 1))
            (cells-set et (- (cells-len et) 1) 88))
          (ln-new fl 2 50 (+ 40 (* i 13)) 140 (+ 53 (* i 13)) 50 53 140 53 0 0 word 2)
          (set i (+ i 2))))
    (law-line fl fw et 2 450 89)
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               expected-drop "only a fully preserved word sequence can remove the later rows")
    (assert-eq (cells-at decisions 2) expected-kind "split and merged OCR lines share the same word band")
    (return 0)))

(deftest test-anchored-word-alignment-across-different-line-breaks
  (law-word-seam (test-t) 0 4 1)
  (law-word-seam (test-t) 1 0 2))

(deftest test-row-similarity-counts-more-than-one-edit
  (let [^Cells et (new-cells)]
    (cells-push et 97) (cells-push et 98) (cells-push et 99)
    (cells-push et 100) (cells-push et 101) (cells-push et 102)
    (cells-push et 97) (cells-push et 98) (cells-push et 104)
    (cells-push et 100) (cells-push et 101) (cells-push et 103)
    (assert-eq (ms-similarity et 0 6 6 6 (new-cells)) 666 "substitutions are graded")
    (assert-eq (ms-similarity et 0 6 0 5 (new-cells)) 833 "one missing character is an edit")))

(defn ^I32 law-priced-row [^:mut ^Cells fl ^:mut ^Cells fw ^:mut ^Cells et
                            ^I32 page ^I32 y ^I32 item]
  (let [^I32 line (ln-count fl) ^I32 first (wd-count fw)
        ^:mut ^I32 price-y y ^:mut ^I32 rot 0]
    (if (== page 2) (do (set price-y (+ y 24)) (set rot 35500)))
    (wd-new fw page 50 y 90 (+ y 12) 50 y 90 y rot 0 (cells-len et) 1 line 900 -1)
    (cells-push et item)
    (if (== page 2)
      (ln-new fl page 50 y 90 (+ y 12) 50 y 90 y rot 0 first 1))
    (wd-new fw page 320 price-y 360 (+ price-y 12) 320 price-y 360 price-y
                rot 0 (cells-len et) 1 (ln-count fl) 900 -1)
    (cells-push et 53)
    (if (== page 2)
      (ln-new fl page 320 price-y 360 (+ price-y 12) 320 price-y 360 price-y rot 0 (+ first 1) 1)
      (ln-new fl page 50 y 360 (+ y 12) 50 y 360 y rot 0 first 2))
    (return 0)))

(deftest test-tilt-aware-rows-join-item-and-price-segments-for-seam-matching
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^:mut ^I32 i 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 600 90)
    (while (< i 3)
      (do (law-priced-row fl fw et 1 (+ 700 (* i 40)) (+ 65 i))
          (set i (+ i 1))))
    (set i 0)
    (while (< i 3)
      (do (law-priced-row fl fw et 2 (+ 40 (* i 40)) (+ 65 i))
          (set i (+ i 1))))
    (law-line fl fw et 2 350 81)
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) decisions (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells) (new-cells))
               6 "drop the matching visual rows, including both segments on the later photo")
    (assert-eq (ln-count fl) 5 "each surviving item and price remains one original flow line")))

(deftest test-a-strong-run-preserves-a-divergent-item
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells ledger (new-cells) ^:mut ^I32 i 0 ^:mut ^I32 item 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1)
    (cells-push mask 1)
    (law-line fl fw et 1 600 90)
    (while (< i 4)
      (do (law-priced-row fl fw et 1 (+ 700 (* i 40)) (+ 65 i))
          (set i (+ i 1))))
    (set i 0)
    (while (< i 4)
      (do (set item (+ 65 i))
          (if (== i 1) (set item 88))
          (law-priced-row fl fw et 2 (+ 40 (* i 40)) item)
          (set i (+ i 1))))
    (law-line fl fw et 2 350 81)
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) (new-cells)
                       ledger (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               4 "only the equal rows with a second exact neighbor are removed")
    (assert-eq (ledger-count ledger) 4 "only supported equal rows go in the drop ledger")
    (assert-eq (ln-count fl) 10 "both versions of the divergent item and the isolated match survive")
    (assert-eq (cells-at decisions 2) 2 "the divergent item has a possible-duplicate mark")
    (assert-eq (cells-at decisions 7) 1 "the equal rows have an overlap mark")))

(defn ^I32 law-graded-neighbor [^TestT emon-t ^I32 sampled ^I32 priced ^I32 expected]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells offsets (new-cells) ^Cells pixels (new-cells) ^:mut ^I32 i 0]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (law-line fl fw et 1 50 90)
    (law-fragment-anchor fl fw et 1 840 7 65)
    (if (== priced 1) (law-fragment-anchor fl fw et 1 870 12 49) (law-line fl fw et 1 870 88))
    (law-fragment-anchor fl fw et 1 900 7 67)
    (law-fragment-anchor fl fw et 2 40 7 66)
    (if (== priced 1) (law-fragment-anchor fl fw et 2 70 12 50) (law-line fl fw et 2 70 88))
    (law-fragment-anchor fl fw et 2 100 7 68)
    (law-line fl fw et 2 500 89)
    (if (== sampled 1)
      (do (while (< i (ln-count fl))
            (do (ln-set fl i (lf-order) i)
                (cells-push offsets -1)
                (set i (+ i 1))))
          (cells-set offsets 2 0)
          (cells-set offsets 5 384)
          (set i 0)
          (while (< i 768)
            (do (cells-push pixels (rem (* i 17) 128))
                (set i (+ i 1))))))
    (assert-eq (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw offsets pixels (new-cells)
                       (new-cells) (new-cells) decisions
                       (new-cells) (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells)
                       (new-cells) (new-cells) (new-cells))
               expected "the matching row needs corroboration and its amounts must agree")
    (assert-eq (cells-at decisions 2) 2 "uncertain readings remain marked")
    (return 0)))

(deftest test-a-graded-neighbor-can-support-a-correlated-row
  (law-graded-neighbor (test-t) 1 0 1)
  (law-graded-neighbor (test-t) 0 0 0))

(deftest test-correlation-keeps-different-amounts-on-identical-item-text
  (law-graded-neighbor (test-t) 1 1 0))

(deftest test-correlation-threshold-separates-moderate-from-weak-agreement
  (let [^Cells pixels (new-cells)]
    (cells-push pixels 0) (cells-push pixels 0) (cells-push pixels 100) (cells-push pixels 100)
    (cells-push pixels 0) (cells-push pixels 50) (cells-push pixels 50) (cells-push pixels 100)
    (cells-push pixels 0) (cells-push pixels 100) (cells-push pixels 100) (cells-push pixels 100)
    (assert-eq (ms-ncc pixels 0 4 4) 1 "correlation about .71 corroborates")
    (assert-eq (ms-ncc pixels 0 8 4) 0 "correlation about .58 is too weak")))

(deftest test-reversed-cuts-can-report-a-gap-without-changing-upload-order
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells order (new-cells) ^Cells cuts (new-cells)]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1)
    (cells-push cuts 1) (cells-push cuts 0) (cells-push cuts 0) (cells-push cuts 1)
    (law-line fl fw et 1 140 66)
    (law-line fl fw et 2 320 65)
    (ms-run 2 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) cuts
            (new-cells) (new-cells) decisions (new-cells) (new-cells) (new-cells)
            (new-cells) (new-cells) (new-cells) (new-cells) order (new-cells) (new-cells)
            (new-cells) (new-cells) (new-cells))
    (assert-eq (cells-len order) 0 "unconfirmed order stays as uploaded")
    (assert-eq (cells-at decisions 0) 2 "first physical edge comes from source two")
    (assert-eq (cells-at decisions 1) 1 "second physical edge comes from source one")
    (assert-eq (cells-at decisions 2) 3 "two opposing cut edges give gap evidence")))

(defn ^I32 law-skipped-gap [^TestT emon-t ^I32 competing ^I32 left ^I32 right]
  (let [^Cells fl (new-cells) ^Cells fw (new-cells) ^Cells et (new-cells)
        ^Cells pages (new-cells) ^Cells mask (new-cells) ^Cells decisions (new-cells)
        ^Cells order (new-cells) ^Cells cuts (new-cells)]
    (page-new pages 1 450 1000 0 (pk-image))
    (page-new pages 2 450 1000 0 (pk-image))
    (page-new pages 3 450 1000 0 (pk-image))
    (cells-push mask 1) (cells-push mask 1) (cells-push mask 1)
    (cells-push cuts 1) (cells-push cuts 0)
    (cells-push cuts competing) (cells-push cuts 0)
    (cells-push cuts 0) (cells-push cuts 1)
    (law-line fl fw et 1 140 66)
    (law-line fl fw et 2 250 67)
    (law-line fl fw et 3 320 65)
    (ms-run 3 0 mask pages (new-cells) (new-cells) et fl fw (new-cells) (new-cells) cuts
            (new-cells) (new-cells) decisions (new-cells) (new-cells) (new-cells)
            (new-cells) (new-cells) (new-cells) (new-cells) order (new-cells) (new-cells)
            (new-cells) (new-cells) (new-cells))
    (assert-eq (cells-len order) 0 "the cuts alone do not establish order")
    (assert-eq (cells-len decisions) 5 "only the opposing cuts give gap evidence")
    (assert-eq (cells-at decisions 0) left "the reported source end")
    (assert-eq (cells-at decisions 1) right "the reported source start")
    (assert-eq (cells-at decisions 2) 3 "a corroborated cut gets a gap flag")
    (return 0)))

(deftest test-cut-edges-are-checked-across-an-intervening-photo
  (law-skipped-gap (test-t) 0 3 1))

(deftest test-competing-cut-edges-do-not-flag-every-pair
  (law-skipped-gap (test-t) 1 1 2))

(deftest test-pixel-correlation-needs-contrast-and-positive-covariance
  (let [^Cells pixels (new-cells)]
    (cells-push pixels 0) (cells-push pixels 128) (cells-push pixels 255)
    (cells-push pixels 60) (cells-push pixels 124) (cells-push pixels 188)
    (cells-push pixels 255) (cells-push pixels 128) (cells-push pixels 0)
    (cells-push pixels 180) (cells-push pixels 180) (cells-push pixels 180)
    (assert-eq (ms-ncc pixels 0 3 3) 1 "same signal with different exposure")
    (assert-eq (ms-ncc pixels 0 6 3) 0 "opposite signal")
    (assert-eq (ms-ncc pixels 0 9 3) 0 "flat area cannot corroborate")))
