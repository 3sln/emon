    (fl-line wd ln et (text-blob "Item") 1 7200 6000 15000 7000 0 1000)
    (fl-line wd ln et (text-blob "Amount") 1 30000 6000 38000 7000 0 1000)
    (fl-line wd ln et (text-blob "Pens") 1 7200 7300 15000 8300 0 1000)
    (fl-line wd ln et (text-blob "12.50") 1 30000 7300 38000 8300 0 1000)
    (fl-line wd ln et (text-blob "Ink") 1 7200 8600 15000 9600 0 1000)
    (fl-line wd ln et (text-blob "7.00") 1 30000 8600 38000 9600 0 1000)
    (fl-line wd ln et (text-blob "Item") 2 7200 6000 15000 7000 0 1000)
    (fl-line wd ln et (text-blob "Amount") 2 30000 6000 38000 7000 0 1000)
    (fl-line wd ln et (text-blob "Glue") 2 7200 7300 15000 8300 0 1000)
    (fl-line wd ln et (text-blob "3.10") 2 30000 7300 38000 8300 0 1000)
    (fl-line wd ln et (text-blob "Tape") 2 7200 8600 15000 9600 0 1000)
    (fl-line wd ln et (text-blob "4.20") 2 30000 8600 38000 9600 0 1000)
    (fl-line wd ln et (text-blob "Item") 3 7200 6000 15000 7000 0 1000)
    (fl-line wd ln et (text-blob "Amount") 3 30000 6000 38000 7000 0 1000)
    (fl-line wd ln et (text-blob "Cups") 3 7200 7300 15000 8300 0 1000)
    (fl-line wd ln et (text-blob "8.80") 3 30000 7300 38000 8300 0 1000)
    (fl-line wd ln et (text-blob "Mugs") 3 7200 8600 15000 9600 0 1000)
    (fl-line wd ln et (text-blob "6.40") 3 30000 8600 38000 9600 0 1000)
    (assert-eq (fl-run wd ln et 3 0 0 txt md lb t1) 0 "table: well formed")
    (assert-text t1 "P:Item;P:Amount;P:Pens;P:12.50;P:Ink;P:7.00 |Item;P:Amount;P:Glue;P:3.10;P:Tape;P:4.20 |Item;P:Amount;P:Cups;P:8.80;P:Mugs;P:6.40;"
                "nothing is taken out of a table")))

(deftest test-a-number-that-does-not-follow-the-pages-is-not-a-page-number
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^Text t1 (new-text)]
    (comment "`Report 2024` (the same on every page) is a constant: furniture, kept once. `No. 7`, `No. 3`, `No. 9` vary: kept per page.")
    (fl-pages wd ln et 3)
    (fl-top wd ln et (text-blob "Report 2024") 1 7200 20000)
    (fl-top wd ln et (text-blob "Report 2024") 2 7200 20000)
    (fl-top wd ln et (text-blob "Report 2024") 3 7200 20000)
    (fl-bottom wd ln et (text-blob "No. 7") 1 40000 45000)
    (fl-bottom wd ln et (text-blob "No. 3") 2 40000 45000)
    (fl-bottom wd ln et (text-blob "No. 9") 3 40000 45000)
    (assert-eq (fl-run wd ln et 3 0 0 txt md lb t1) 0 "not a page number: well formed")
    (assert-text t1 "Fh1,2,3:Report 2024;Ff1:No. 7;Ff2:No. 3;Ff3:No. 9;P:alpha beta. |alpha beta. |alpha beta.;"
                "a constant is one root, a number that varies is one per page, and neither is a label")))

(deftest test-odd-and-even-pages-have-their-own-headers
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^Text t1 (new-text)]
    (comment "Even pages say the book's title (the body's heading too: dropped), odd pages the chapter (kept), page numbers at the foot")
    (comment "of every page but the first.")
    (fl-pages wd ln et 5)
    (fl-line wd ln et (text-blob "The Handbook") 1 7200 8000 30000 9500 0 1800)
    (fl-top wd ln et (text-blob "The Handbook") 2 7200 20000)
    (fl-top wd ln et (text-blob "Employee Chapter") 3 40000 52000)
    (fl-top wd ln et (text-blob "The Handbook") 4 7200 20000)
    (fl-top wd ln et (text-blob "Employee Chapter") 5 40000 52000)
    (fl-bottom wd ln et (text-blob "2") 2 30000 31000)
    (fl-bottom wd ln et (text-blob "3") 3 30000 31000)
    (fl-bottom wd ln et (text-blob "4") 4 30000 31000)
    (fl-bottom wd ln et (text-blob "5") 5 30000 31000)
    (assert-eq (fl-run wd ln et 5 0 0 txt md lb t1) 0 "odd even: well formed")
    (assert-text t1 "L2=2;L3=3;L4=4;L5=5;Fh3,5:Employee Chapter;Dr@2:The Handbook;Dr@4:The Handbook;Dp@2:2;Dp@3:3;Dp@4:4;Dp@5:5;P:The Handbook;P:alpha beta. |alpha beta. |alpha beta. |alpha beta. |alpha beta.;"
                "the first page has no label; the chapter is kept; the book's title is dropped")))

(defn ^I32 fl-roots [^Cells nodes]
  (comment "How many `furniture` roots the Model has.")
  (let [^I32 nn (node-count nodes)
        ^:mut ^I32 i 0
        ^:mut ^I32 n 0]
    (while (< i nn)
      (do (if (and (== (node-kind nodes i) (nk-furniture)) (== (node-parent nodes i) -1))
            (set n (+ n 1)))
          (set i (+ i 1))))
    (return n)))

(defn ^I32 fl-cells [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 page ^I32 y ^Blob a ^Blob b ^Blob c ^Blob d ^Blob e]
  (comment "A row of five cells (one line each) at y, 10 pt high, 10 pt text, in columns from x 7200, 12000, 24000, 34000 and 42000.")
  (fl-line wd ln et a page 7200 y 9000 (+ y 1000) 0 1000)
  (fl-line wd ln et b page 12000 y 20000 (+ y 1000) 0 1000)
  (fl-line wd ln et c page 24000 y 32000 (+ y 1000) 0 1000)
  (fl-line wd ln et d page 34000 y 38000 (+ y 1000) 0 1000)
  (fl-line wd ln et e page 42000 y 50000 (+ y 1000) 0 1000)
  (return 0))

(defn ^I32 fl-statement-page [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^I32 page ^Blob r1 ^Blob r2 ^Blob r3]
  (comment "A continuation page of a statement: the header row (the same on every page) at 60 pt and three rows of cells under it, 13 pt apart, whose first column is `r1`, `r2`, `r3`.")
  (fl-cells wd ln et page 6000 (text-blob "No.") (text-blob "Txn ID") (text-blob "Posted") (text-blob "Cr/Dr") (text-blob "Amount"))
  (fl-cells wd ln et page 7300 r1 (text-blob "S88406266") (text-blob "06/01/2024") (text-blob "DR") (text-blob "33593.01"))
  (fl-cells wd ln et page 8600 r2 (text-blob "S82211394") (text-blob "06/01/2024") (text-blob "CR") (text-blob "38674.79"))
  (fl-cells wd ln et page 9900 r3 (text-blob "S94067070") (text-blob "06/01/2024") (text-blob "CR") (text-blob "67477.43"))
  (return 0))

(defn ^I32 fl-roots-of [^Cells wd ^Cells ln0 ^Cells et ^I32 npages]
  (comment "`fl-run` on Letter pages with no tree and the policy setting, answering how many `furniture` roots it made.")
  (let [^Cells ln (new-cells)
        ^Cells gl (new-cells) ^Cells mk (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells) ^Cells gp (new-cells)
        ^Cells cd (new-cells) ^Cells sl (new-cells) ^Cells gr (new-cells) ^Cells ford (new-cells) ^Cells tx (new-cells)
        ^Cells bh (new-cells) ^Cells fo (new-cells) ^Cells fp (new-cells) ^Cells ft (new-cells) ^Cells pl (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^:mut ^I32 p 1]
    (model-init nodes attrs regions text pages ledger layout)
    (while (<= p npages)
      (do (page-new pages p 61200 79200 0 (pk-vector))
          (set p (+ p 1))))
    (fl-copy ln0 ln)
    (fl-order ln)
    (fu-find wd ln et gl mk pages npages txt md lb 0 0 cd sl gr ford tx bh fo fp ft pl)
    (fl-build wd ln et npages pages layout nodes attrs regions text ord raw tmp fr gp)
    (fu-write fo fp ft pl npages nodes attrs regions text pages ledger tmp)
    (return (fl-roots nodes))))

(deftest test-the-first-row-under-a-repeated-table-header-is-no-furniture
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)]
    (comment "D583 (smoke review A issue 15): three pages of a statement, each the same header row and then rows whose cells (digits abstracted) are the same templates on every page. The")
    (comment "first row is the same size at the same height on every page, and the rows under it, which recur by their templates, do not count against its isolation: it passed as a header that")
    (comment "varies. It is a row of five cells on one baseline, which no running header is.")
    (fl-statement-page wd ln et 1 (text-blob "17") (text-blob "18") (text-blob "19"))
    (fl-statement-page wd ln et 2 (text-blob "52") (text-blob "53") (text-blob "54"))
    (fl-statement-page wd ln et 3 (text-blob "87") (text-blob "88") (text-blob "89"))
    (fl-body wd ln et (text-blob "Opening balance carried forward.") 1 8)
    (fl-body wd ln et (text-blob "Closing balance carried forward.") 2 8)
    (fl-body wd ln et (text-blob "Page total carried forward.") 3 8)
    (assert-eq (fl-roots-of wd ln et 3) 0 "no row of the table is furniture")))

(deftest test-a-two-line-running-header-is-furniture-whole
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)]
    (comment "D583 (smoke review B issue 11): a header of two lines, the second 8.6 pt over the first line of the body: only the first was set apart (the recurring second does not count")
    (comment "against it), so the second stayed in the flow. The second goes with the first. A heading (larger than the body) under it varies from page to page and stays.")
    (fl-pages wd ln et 4)
    (fl-line wd ln et (text-blob "Where To Download") 1 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Statistics Sixth Edition") 1 4250 3550 20000 4850 0 1000)
    (fl-line wd ln et (text-blob "Erie hospitals seek answers") 1 4500 5700 30000 7100 0 1400)
    (fl-line wd ln et (text-blob "Where To Download") 2 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Statistics Sixth Edition") 2 4250 3550 20000 4850 0 1000)
    (fl-line wd ln et (text-blob "Garland district fenced areas") 2 4500 5700 30000 7100 0 1400)
    (fl-line wd ln et (text-blob "Where To Download") 3 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Statistics Sixth Edition") 3 4250 3550 20000 4850 0 1000)
    (fl-line wd ln et (text-blob "Women account for research") 3 4500 5700 30000 7100 0 1400)
    (fl-line wd ln et (text-blob "Where To Download") 4 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Statistics Sixth Edition") 4 4250 3550 20000 4850 0 1000)
    (fl-line wd ln et (text-blob "Creativity comes from where") 4 4500 5700 30000 7100 0 1400)
    (assert-eq (fl-roots-of wd ln et 4) 2 "both lines of the header are furniture")))

(deftest test-a-footer-of-four-parts-on-one-baseline-is-still-a-footer
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)]
    (comment "D583: only a row in the TOP zone is a table's (the first data row under a repeated header): a footer of four parts on its baseline (the real statement's address, phone and notice) is furniture,")
    (comment "kept once, four roots")
    (fl-pages wd ln et 3)
    (fl-bottom wd ln et (text-blob "example.com") 1 7200 14000)
    (fl-bottom wd ln et (text-blob "Call 555 0100") 1 18000 26000)
    (fl-bottom wd ln et (text-blob "PO Box 85123") 1 30000 38000)
    (fl-bottom wd ln et (text-blob "Member FDIC") 1 42000 50000)
    (fl-bottom wd ln et (text-blob "example.com") 2 7200 14000)
    (fl-bottom wd ln et (text-blob "Call 555 0100") 2 18000 26000)
    (fl-bottom wd ln et (text-blob "PO Box 85123") 2 30000 38000)
    (fl-bottom wd ln et (text-blob "Member FDIC") 2 42000 50000)
    (fl-bottom wd ln et (text-blob "example.com") 3 7200 14000)
    (fl-bottom wd ln et (text-blob "Call 555 0100") 3 18000 26000)
    (fl-bottom wd ln et (text-blob "PO Box 85123") 3 30000 38000)
    (fl-bottom wd ln et (text-blob "Member FDIC") 3 42000 50000)
    (assert-eq (fl-roots-of wd ln et 3) 4 "four parts, four furniture roots")))

(deftest test-a-sideways-stamp-in-the-margin-of-one-page-is-furniture
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text)]
    (comment "D583 (smoke review B issue 9): the arXiv identifier set up the left edge of a paper's first page, a quarter turn, 20 to 36 pt from the edge: a margin stamp, kept as a `margin` root and")
    (comment "out of the body. The same line in the body's own place (an inch in) is text.")
    (fl-pages wd ln et 1)
    (fl-line wd ln et (text-blob "arXiv:2010.11929v2 [cs.CV] 3 Jun 2021") 1 2000 20000 3600 55000 9000 900)
    (assert-eq (fl-run wd ln et 1 0 0 txt md lb t1) 0 "stamp: well formed")
    (assert-text t1 "Fm1:arXiv:2010.11929v2 [cs.CV] 3 Jun 2021;P:alpha beta.;" "the stamp is a margin root, the body is the body")
    (fl-clear wd ln et)
    (fl-pages wd ln et 1)
    (fl-line wd ln et (text-blob "arXiv:2010.11929v2 [cs.CV] 3 Jun 2021") 1 7200 20000 8800 55000 9000 900)
    (assert-eq (fl-run wd ln et 1 0 0 txt md lb t2) 0 "inside: well formed")
    (assert-eq (fl-roots-of wd ln et 1) 0 "a sideways line inside the page is no stamp")))

(deftest test-a-footer-on-a-small-page-is-furniture
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Text t1 (new-text)]
    (comment "D583 (smoke review B issue 11): pages 297 x 210 pt: `Page 1/25` stands 28 pt from the foot (centre at 87 per cent of the height, short of the 89 per cent of the footer zone), and the header")
    (comment "18 pt from the top (11.7 per cent, past the 11 of the header zone). Both recur on every page, and the zones of a page that small are 36 pt deep.")
    (fl-line wd ln et (text-blob "alpha beta.") 1 2000 10000 12000 11100 0 1100)
    (fl-line wd ln et (text-blob "alpha beta.") 2 2000 10000 12000 11100 0 1100)
    (fl-line wd ln et (text-blob "alpha beta.") 3 2000 10000 12000 11100 0 1100)
    (fl-line wd ln et (text-blob "Where To Download") 1 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Where To Download") 2 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Where To Download") 3 4250 1800 17700 3100 0 1000)
    (fl-line wd ln et (text-blob "Page 1/25") 1 11500 17800 15100 18600 0 800)
    (fl-line wd ln et (text-blob "Page 2/25") 2 11500 17800 15100 18600 0 800)
    (fl-line wd ln et (text-blob "Page 3/25") 3 11500 17800 15100 18600 0 800)
    (assert-eq (fl-run-size wd ln et 3 29764 20976 t1) 0 "small pages: well formed")
    (assert-text t1 "L1=1;L2=2;L3=3;Fh1,2,3:Where To Download;Dp@1:Page 1/25;Dp@2:Page 2/25;Dp@3:Page 3/25;P:alpha beta. |alpha beta. |alpha beta.;"
                "the header is kept once, the page numbers are labels")))

(deftest test-a-diagonal-word-much-larger-than-the-text-is-a-watermark
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text)]
    (fl-pages wd ln et 2)
    (fl-line wd ln et (text-blob "DRAFT") 1 11000 22000 62600 60600 3000 15000)
    (fl-line wd ln et (text-blob "DRAFT") 2 11000 22000 62600 60600 3000 15000)
    (assert-eq (fl-run wd ln et 2 0 0 txt md lb t1) 0 "watermark: well formed")
    (assert-text t1 "Dw@1:DRAFT;Dw@2:DRAFT;P:alpha beta. |alpha beta.;"
                "a watermark is in the ledger and not in the flow")
    (comment "Turned the same way but no larger than the text: a diagram label, left alone.")
    (fl-clear wd ln et)
    (fl-pages wd ln et 1)
    (fl-line wd ln et (text-blob "label") 1 20000 30000 25000 31000 3000 1100)
    (assert-eq (fl-run wd ln et 1 0 0 txt md lb t2) 0 "label: well formed")
    (assert-text t2 "P:alpha beta.;P:label;" "a small turned word is content")))

;; ------------------------------------------------------------------------ /PageLabels

(deftest test-page-labels-of-the-catalogue-win-over-the-printed-numbers
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells txt (new-cells) ^Cells md (new-cells) ^Cells lb (new-cells)
        ^Text t1 (new-text) ^:mut ^I32 i 0]
    (comment "Two pages numbered 5 and 6 at the foot, and a catalogue that says lower roman from page 0 (ii at page 2): the labels")
    (comment "are the catalogue's, the printed numbers are still taken out of the flow.")
    (fl-pages wd ln et 2)
    (fl-bottom wd ln et (text-blob "5") 1 30000 31000)
    (fl-bottom wd ln et (text-blob "6") 2 30000 31000)
    (while (< i 60)
      (do (cells-push md 0)
          (set i (+ i 1))))
    (cells-set md 54 1)
    (comment "one range: first page 0, style r (3), no prefix, number 1 on the first page, 1 + the pages after the last, no bits")
    (cells-push lb 0)
    (cells-push lb 3)
    (cells-push lb -1)
    (cells-push lb 0)
    (cells-push lb 1)
    (cells-push lb 2)
    (cells-push lb 0)
    (cells-push lb 0)
    (assert-eq (fl-run wd ln et 2 0 0 txt md lb t1) 0 "labels: well formed")
    (assert-text t1 "L1=i;L2=ii;Dp@1:5;Dp@2:6;P:alpha beta. |alpha beta.;"
                "the catalogue's labels, the printed numbers dropped")))

;; ----------------------------------------------------------------- the tagged fixtures

(defn ^I32 fl-file [^Blob blob ^I32 mode ^:mut ^Text t]
  (comment "A real file through the whole pipeline as the Engine runs it, and the brief of the Model. Answers 0, or the open")
  (comment "status, or -1.")
  (let [^Cells ar (new-cells) ^Cells dc (new-cells) ^Cells a (new-cells) ^Cells b (new-cells) ^Cells st (new-cells)
        ^Cells pg (new-cells) ^Cells idx (new-cells) ^Cells txt (new-cells) ^Cells w (new-cells) ^Cells seen (new-cells)
        ^Cells md (new-cells) ^Cells xm (new-cells) ^Cells ol (new-cells) ^Cells lb (new-cells) ^Cells nd (new-cells)
        ^Cells nt (new-cells) ^Cells cx (new-cells) ^Cells ox (new-cells) ^Cells cs (new-cells) ^Cells out (new-cells)
        ^Cells f0 (new-cells) ^Cells f1 (new-cells) ^Cells f2 (new-cells) ^Cells f3 (new-cells) ^Cells gl (new-cells)
        ^Cells et (new-cells) ^Cells mk (new-cells) ^Cells fnt (new-cells) ^Cells wd (new-cells) ^Cells ln (new-cells)
        ^Cells ss (new-cells) ^Cells se (new-cells) ^Cells sk (new-cells) ^Cells sc (new-cells) ^Cells so (new-cells)
        ^Cells sa (new-cells) ^Cells wk (new-cells) ^Cells ha (new-cells) ^Cells hb (new-cells) ^Cells hh (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells) ^Cells gp (new-cells)
        ^Cells cd (new-cells) ^Cells sl (new-cells) ^Cells gr (new-cells) ^Cells ford (new-cells) ^Cells tx (new-cells)
        ^Cells bh (new-cells) ^Cells fo (new-cells) ^Cells fp (new-cells) ^Cells ft (new-cells) ^Cells pl (new-cells)
        ^Cells chk (new-cells) ^Cells pa (new-cells) ^Cells im (new-cells) ^Cells pts (new-cells) ^Cells gx (new-cells)
        ^Src pdf (src-of-blob blob)
        ^:mut ^I32 status 0
        ^:mut ^I32 r 0
        ^:mut ^I32 np 0]
    (set status (pd-open pdf ar dc a b st))
    (if (!= status 0) (return status))
    (set r (pc-document pdf ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx))
    (if (!= r 0) (return -1))
    (set np (pd-pg-count pg))
    (px-index-build pdf ar dc a b st pg idx)
    (set r (pm-run pdf ar dc a b st pg idx txt w seen md xm ol lb nd nt))
    (if (< r 0) (return -1))
    (set r (tg-read pdf ar dc a b st pg idx txt w seen ss se sk sc so wk md))
    (if (< r 0) (return -1))
    (set r (tg-join ss se sk sc so sa gl mk fnt pg ha hb hh))
    (model-init nodes attrs regions text pages ledger layout)
    (pa-pages pg pages)
    (fu-find wd ln et gl mk pages np txt md lb (tg-trust ss) mode cd sl gr ford tx bh fo fp ft pl)
    (fl-build wd ln et np pages layout nodes attrs regions text ord raw tmp fr gp)
    (fu-write fo fp ft pl np nodes attrs regions text pages ledger tmp)
    (fl-brief t nodes attrs text pages ledger 0)
    (set r (model-check nodes attrs regions text pages ledger layout chk))
    (return r)))

(deftest test-the-tagged-fixtures-lose-their-running-header-footer-and-watermark
  (comment "`good.pdf` is tagged (its running header, footer and DRAFT watermark are /Artifact marked content: the tree is trusted);")
  (comment "`bad.pdf` says the same page wrongly (the running header is tagged P, a heading is marked Footer): the geometry and the")
  (comment "repetition still find the furniture, whatever the tree says (D034, D076). Each page has `Page N` and `Quarterly Report`.")
  (let [^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text)]
    (assert-eq (fl-file (test-file "pdf/tagged/good.pdf") 0 t1) 0 "good: well formed")
    (assert-text t1 "L1=1;L2=2;Dr@1:Quarterly Report;Dr@2:Quarterly Report;Dp@1:Page 1;Dp@2:Page 2;Dw@1:DRAFT;"
                "good: header, footer, watermark out, the content as it was")
    (assert-eq (fl-file (test-file "pdf/tagged/bad.pdf") 0 t2) 0 "bad: well formed")
    (assert-text t2 "L1=1;L2=2;Dr@1:Quarterly Report;Dr@2:Quarterly Report;Dp@1:Page 1;Dp@2:Page 2;Dw@1:DRAFT;"
                "bad: the same page told wrongly by the tree is cleaned up the same way (D034: verified, not obeyed)")
    (assert-eq (fl-file (test-file "pdf/tagged/good.pdf") 1 t3) 0 "good, keep: well formed")
    (assert-text t3 "" "keep: nothing leaves the flow, and nothing is said")))
