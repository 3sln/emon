  :accessors {^I32 on-count [^I32 ignored]
              ^I32 on-at [^I32 ignored ^I32 i]})

(deftest test-numeric-classification-is-pinned-to-recorded-recorded-cases-and-reviewed-differences
  (let [^Cells c (new-cells) ^:mut ^I32 at 0 ^:mut ^I32 row 0 ^:mut ^I32 differences 0]
    (while (< at (on-count 0))
      (let [^I32 recorded (on-at 0 at) ^I32 expected (on-at 0 (+ at 1)) ^I32 n (on-at 0 (+ at 2))
            ^:mut ^I32 i 0 ^:mut ^I32 cp 0 ^:mut ^I32 latin 0]
        (cells-drop c 0)
        (let [^I32 answer (oil-begin c 12 1 256 256 1 1 0 0)
              ^I32 word (oil-word c answer 0 0 1 1 -1 500 0 0 -1 0)]
          (while (< i n)
            (do (set cp (on-at 0 (+ (+ at 3) i)))
                (oil-word-cp c answer word cp)
                (if (or (and (>= cp 65) (<= cp 90)) (and (>= cp 97) (<= cp 122))) (set latin (+ latin 1)))
                (set i (+ i 1))))
          (oil-end c answer)
          (assert-eq-at (bit-and (oil-word-flags c answer word) 2) expected "recorded numeric classification or reviewed difference" row))
        (if (!= recorded expected)
          (do (assert-that (< latin 3) "a numeric difference cannot change the dictionary penalty")
              (set differences (+ differences 1))))
        (set at (+ (+ at 3) n)) (set row (+ row 1))))
    (assert-eq row 952 "all captured numeric candidates")
    (assert-eq differences 81 "all deliberate differences are accounted for")))
