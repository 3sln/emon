;; The Model (P1.1; SPEC 3, D011). emon's own module (D039).
;;
;; THE MODEL IS THE PRODUCT: every stage after evidence writes into it and
;; every consumer reads it, so this module is the one whose codes are forever.
;; Kin cannot allocate, so the Model is SEVEN ARENAS OF INTEGERS -- `Cells` the
;; host allocates and this module fills. A node is its index; four languages
;; cannot disagree about an index.
;;
;;   nodes    stride 16   the tree
;;   attrs    stride 5    kind-specific fields that are not one integer
;;   regions  stride 6    where a node is: page, x0, y0, x1, y1 (centipoints)
;;   text     stride 1    one Unicode scalar value per cell; EVERY string in the
;;                        Model is a run (start, length) in here
;;   pages    stride 16   the page table
;;   ledger   stride 10   what was dropped, and why
;;   layout   stride 8    the column map (D111): page, band, col, role, x0 y0 x1 y1;
;;                        a page's cells are one contiguous run, named by two
;;                        spare cells of its `pages` row (first, count)
;;
;; NO LINK IS A POINTER. A missing link, run, or value is -1; a count is 0.
;; A field that is -1 is OMITTED from the JSON (SPEC 4.2), so "absent" has one
;; spelling in the arena and one in the output.
;;
;; THE NODE, slot by slot (SPEC 3.8):
;;   0 kind   1 parent   2 first-child   3 last-child   4 next   5 prev
;;   6 attr-head   7 text-start   8 text-len   9 region-head   10 region-count
;;   11 src (bitset)   12 conf (-1 absent, else 0..1000)   13 flags (bitset)
;;   14 sub   15 aux
;; `sub` and `aux` are the kind-specific small integers, and WHICH field they
;; are is fixed per kind (table at `nk-...` below and in D050): a level, a role,
;; a figure kind, a span's style bits. Everything else kind-specific is an
;; attribute, because a field with a string value cannot live in one cell.
;;
;; IDS. The `id` of a node IS ITS INDEX, and the builder appends, so ids are
;; assigned in creation order. SPEC 3.3 says ids are in DOCUMENT order; this
;; holds if every tree is built in pre-order, and `model-check` verifies that it
;; was (each tree's indices are consecutive in pre-order). A stage that builds
;; out of order gets `mc-not-preorder` from the check rather than an id that
;; is not stable.
;;
;; TREES. Node 0 is the `document`; its subtree is the body. A `furniture`
;; node is a SECOND ROOT (parent -1): it is not in the flow, it is a template
;; kept once (SPEC 3.7, 10.2), and the JSON lists it in `furniture`.
;;
;; ATTRIBUTE KEYS are the JSON field names (`fk`): one table spells the key in
;; the arena and the key in the output, so they cannot disagree.
(ns emon.model
  (:require [emon.lang :refer [I32 I64 Blob Cells Text Buf defenum i64 add64 mul64
                               shl32 sar32]]
            [emon.port :refer [cells-len cells-at cells-set cells-push
                               cells-drop blob-u8 buf-len buf-at]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or bit-and bit-or
                              bit-xor quot rem]]))

;; ------------------------------------------------------------ the tables
;;
;; Every code below is ASSIGNED ONCE and never reused (D050). New rows go on
;; the end of a table; a minor schema version may add, never renumber.

(defenum ^:pub nk
  [[nk-document 1 "document"]
   [nk-section 2 "section"]
   [nk-heading 3 "heading"]
   [nk-paragraph 4 "paragraph"]
   [nk-list 5 "list"]
   [nk-item 6 "item"]
   [nk-table 7 "table"]
   [nk-rowgroup 8 "rowgroup"]
   [nk-row 9 "row"]
   [nk-cell 10 "cell"]
   [nk-caption 11 "caption"]
   [nk-figure 12 "figure"]
   [nk-seal 13 "seal"]
   [nk-formula 14 "formula"]
   [nk-code 15 "code"]
   [nk-quote 16 "quote"]
   [nk-note 17 "note"]
   [nk-field 18 "field"]
   [nk-furniture 19 "furniture"]
   [nk-break 20 "break"]
   [nk-text 21 "text"]
   [nk-span 22 "span"]
   [nk-link 23 "link"]
   [nk-ref 24 "ref"]
   [nk-linebreak 25 "linebreak"]
   [nk-initial 26 "initial"]])

