;; Provenance bits (SPEC 3.5). The code IS the bit.
(defenum ^:pub sr
  [[sr-text 1 "text"]
   [sr-hidden-text 2 "hidden-text"]
   [sr-ocr 4 "ocr"]
   [sr-trace 8 "trace"]
   [sr-vector 16 "vector"]
   [sr-struct 32 "struct"]
   [sr-annot 64 "annot"]
   [sr-outline 128 "outline"]
   [sr-infer 256 "infer"]])

;; Warning bits (SPEC 3.3).
(defenum ^:pub fl
  [[fl-low-conf 1 "low-conf"]
   [fl-ocr-only 2 "ocr-only"]
   [fl-text-layer-suspect 4 "text-layer-suspect"]
   [fl-reconstructed 8 "reconstructed"]
   [fl-dpi-unknown 16 "dpi-unknown"]
   [fl-rotated 32 "rotated"]
   [fl-vertical 64 "vertical"]
   [fl-struct-disagree 128 "struct-disagree"]
   [fl-tag-span-conflict 256 "tag-span-conflict"]])

;; A span's `style` bits, stored in its `sub`.
(defenum ^:pub sy
  [[sy-bold 1 "bold"]
   [sy-italic 2 "italic"]
   [sy-underline 4 "underline"]
   [sy-strike 8 "strike"]
   [sy-sub 16 "sub"]
   [sy-sup 32 "sup"]
   [sy-mono 64 "mono"]
   [sy-smallcaps 128 "smallcaps"]])

;; An `align` (D110): a paragraph's is its `sub` (0 is "not informative", omitted);
;; a heading's, caption's and cell's is the attribute `fk-align` (their `sub` is
;; taken), and a cell is never `justify`. `node-set-align` is the one builder.
(defenum ^:pub al
  [[al-start 1 "start"]
   [al-center 2 "center"]
   [al-end 3 "end"]
   [al-justify 4 "justify"]])

;; `role`: a rowgroup's, a note's, a furniture's. One table, distinct codes.
(defenum ^:pub rl
  [[rl-head 1 "head"]
   [rl-body 2 "body"]
   [rl-foot 3 "foot"]
   [rl-footnote 4 "footnote"]
   [rl-endnote 5 "endnote"]
   [rl-margin 6 "margin"]
   [rl-header 7 "header"]
   [rl-footer 8 "footer"]
   [rl-sidebar 9 "sidebar"]])

;; An `initial` inline's form (D109; its `sub`; its `aux` is the lines, 0 absent).
(defenum ^:pub ifm
  [[ifm-drop 1 "drop"]
   [ifm-raised 2 "raised"]
   [ifm-margin 3 "margin"]])

;; A figure's `kind` (SPEC 10.6; its `sub`).
