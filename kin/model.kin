;; ASSETS (P3.13, D117, SPEC 10.11). Codes assigned once, never reused (D050).
;; An asset's origin: what its pixels are.
(defenum ^:pub ao
  [[ao-embedded 1 "embedded"]
   [ao-decoded 2 "decoded"]
   [ao-cropped 3 "cropped"]
   [ao-rendered 4 "rendered"]])

