   [nz-too-large 8 "too-large"]
   [nz-budget 9 "budget"]])

;; What a `model-check` found wrong. 0 is fine; the node is in `st[0]`.
(defenum ^:pub mc
  [[mc-ok 0 "ok"]
   [mc-bad-stride 1 "bad-stride"]
   [mc-no-root 2 "no-root"]
   [mc-bad-kind 3 "bad-kind"]
   [mc-bad-link 4 "bad-link"]
   [mc-bad-tree 5 "bad-tree"]
   [mc-bad-text 6 "bad-text"]
   [mc-bad-attr 7 "bad-attr"]
   [mc-bad-region 8 "bad-region"]
   [mc-bad-conf 9 "bad-conf"]
   [mc-not-preorder 10 "not-preorder"]
   [mc-bad-page 11 "bad-page"]
   [mc-bad-ledger 12 "bad-ledger"]
   [mc-bad-layout 13 "bad-layout"]
   [mc-bad-asset 14 "bad-asset"]])

;; Attribute value kinds. A `node` value is a node id (`caption.target`).
(defn ^:pub ^I32 av-int [] (return 0))
(defn ^:pub ^I32 av-text [] (return 1))
(defn ^:pub ^I32 av-node [] (return 2))
(defn ^:pub ^I32 av-bool [] (return 3))

;; Strides.
(defn ^:pub ^I32 nodes-stride [] (return 16))
(defn ^:pub ^I32 attrs-stride [] (return 5))
(defn ^:pub ^I32 regions-stride [] (return 6))
(defn ^:pub ^I32 pages-stride [] (return 16))
(defn ^:pub ^I32 ledger-stride [] (return 10))
(defn ^:pub ^I32 layout-stride [] (return 8))
(defn ^:pub ^I32 assets-stride [] (return 24))
(defn ^:pub ^I32 uses-stride [] (return 8))

;; The deepest a tree may nest. `node-new` refuses a deeper node (answers -1),
;; which is what lets every walker recurse without a stack of its own.
(defn ^:pub ^I32 max-depth [] (return 200))

;; ----------------------------------------------------------- node fields

(defn ^I32 nget [^Cells nodes ^I32 n ^I32 f]
  (return (cells-at nodes (+ (* n 16) f))))

(defn ^I32 nput [^:mut ^Cells nodes ^I32 n ^I32 f ^I32 v]
  (cells-set nodes (+ (* n 16) f) v)
  (return 0))

(defn ^:pub ^I32 node-count [^Cells nodes] (return (quot (cells-len nodes) 16)))
(defn ^:pub ^I32 node-kind [^Cells nodes ^I32 n] (return (nget nodes n 0)))
(defn ^:pub ^I32 node-parent [^Cells nodes ^I32 n] (return (nget nodes n 1)))
(defn ^:pub ^I32 node-first-child [^Cells nodes ^I32 n] (return (nget nodes n 2)))
(defn ^:pub ^I32 node-last-child [^Cells nodes ^I32 n] (return (nget nodes n 3)))
(defn ^:pub ^I32 node-next [^Cells nodes ^I32 n] (return (nget nodes n 4)))
(defn ^:pub ^I32 node-prev [^Cells nodes ^I32 n] (return (nget nodes n 5)))
(defn ^:pub ^I32 node-attr-head [^Cells nodes ^I32 n] (return (nget nodes n 6)))
(defn ^:pub ^I32 node-text-start [^Cells nodes ^I32 n] (return (nget nodes n 7)))
(defn ^:pub ^I32 node-text-len [^Cells nodes ^I32 n] (return (nget nodes n 8)))
(defn ^:pub ^I32 node-region-head [^Cells nodes ^I32 n] (return (nget nodes n 9)))
(defn ^:pub ^I32 node-region-count [^Cells nodes ^I32 n] (return (nget nodes n 10)))
(defn ^:pub ^I32 node-src [^Cells nodes ^I32 n] (return (nget nodes n 11)))
(defn ^:pub ^I32 node-conf [^Cells nodes ^I32 n] (return (nget nodes n 12)))
(defn ^:pub ^I32 node-flags [^Cells nodes ^I32 n] (return (nget nodes n 13)))
(defn ^:pub ^I32 node-sub [^Cells nodes ^I32 n] (return (nget nodes n 14)))
(defn ^:pub ^I32 node-aux [^Cells nodes ^I32 n] (return (nget nodes n 15)))

(defn ^:pub ^I32 node-has-text [^Cells nodes ^I32 n]
  (comment "1 when the node carries a text run (even an empty one).")
  (if (>= (nget nodes n 7) 0) (return 1))
  (return 0))

(defn ^:pub ^I32 nk-is-inline [^I32 kind]
  (comment "1 for the kinds that live inside a block's text: text, span, link,")
  (comment "ref, linebreak, initial (SPEC 3.2). A `break` is a milestone, not an")
  (comment "inline.")
  (if (== kind (nk-text)) (return 1))
  (if (== kind (nk-span)) (return 1))
  (if (== kind (nk-link)) (return 1))
  (if (== kind (nk-ref)) (return 1))
  (if (== kind (nk-linebreak)) (return 1))
  (if (== kind (nk-initial)) (return 1))
  (return 0))

(defn ^:pub ^I32 node-is-inline [^Cells nodes ^I32 n]
  (comment "1 when node n is an inline: an inline KIND, or a `break` with an inline neighbour (D134). A page")
  (comment "milestone INSIDE a paragraph (text, break, text) is an inline -- written in `inlines`, in order,")
  (comment "with no `id` -- and BETWEEN two blocks it is a block, as `nk-is-inline` of its kind says.")
  (let [^I32 kind (nget nodes n 0)
        ^I32 pv (nget nodes n 5)
        ^I32 nx (nget nodes n 4)]
    (if (== (nk-is-inline kind) 1) (return 1))
    (if (== kind (nk-break))
      (do (if (>= pv 0)
            (do (let [^I32 pkind (nget nodes pv 0)]
                  (if (== (nk-is-inline pkind) 1) (return 1)))))
          (if (>= nx 0)
            (do (let [^I32 nkind (nget nodes nx 0)]
                  (if (== (nk-is-inline nkind) 1) (return 1)))))))
    (return 0)))

(defn ^:pub ^I32 node-child-count [^Cells nodes ^I32 n]
  (let [^:mut ^I32 c (nget nodes n 2)
        ^:mut ^I32 k 0]
    (while (>= c 0)
      (do (set k (+ k 1))
          (set c (nget nodes c 4))))
    (return k)))

(defn ^:pub ^I32 node-depth [^Cells nodes ^I32 n]
  (comment "Edges from the node to its root: the root is 0.")
  (let [^:mut ^I32 p (nget nodes n 1)
        ^:mut ^I32 d 0]
    (while (>= p 0)
      (do (set d (+ d 1))
          (set p (nget nodes p 1))))
    (return d)))

;; --------------------------------------------------------------- builders

(defn ^:pub ^I32 node-new [^:mut ^Cells nodes ^I32 kind ^I32 parent]
  (comment "Append a node as the LAST child of `parent` (-1: a new root) and")
  (comment "answer its index, or -1 when `parent` is not a node, the kind is")
  (comment "unknown, or the node would nest deeper than `max-depth`. A new")
  (comment "node has no text, no regions, no attributes, `src` 0, `conf` -1")
  (comment "(absent), `flags` 0, `sub` 0, `aux` 0.")
  (let [^I32 n (quot (cells-len nodes) 16)
        ^:mut ^I32 last -1]
    (if (or (< kind 1) (> kind 26)) (return -1))
    (if (< parent -1) (return -1))
    (if (>= parent n) (return -1))
    (if (>= parent 0)
      (do (if (>= (node-depth nodes parent) (- (max-depth) 1)) (return -1))
          (set last (nget nodes parent 3))))
    (cells-push nodes kind)
    (cells-push nodes parent)
    (cells-push nodes -1)
    (cells-push nodes -1)
    (cells-push nodes -1)
    (cells-push nodes last)
    (cells-push nodes -1)
    (cells-push nodes -1)
    (cells-push nodes 0)
    (cells-push nodes -1)
    (cells-push nodes 0)
    (cells-push nodes 0)
    (cells-push nodes -1)
    (cells-push nodes 0)
    (cells-push nodes 0)
    (cells-push nodes 0)
    (if (>= parent 0)
      (do (if (< last 0)
            (nput nodes parent 2 n)
            (nput nodes last 4 n))
          (nput nodes parent 3 n)))
    (return n)))

(defn ^:pub ^I32 model-init [^:mut ^Cells nodes ^:mut ^Cells attrs
                             ^:mut ^Cells regions ^:mut ^Cells text
                             ^:mut ^Cells pages ^:mut ^Cells ledger
                             ^:mut ^Cells layout]
  (comment "Empty all seven arenas and create the `document` root, node 0.")
  (cells-drop nodes 0)
  (cells-drop attrs 0)
  (cells-drop regions 0)
  (cells-drop text 0)
  (cells-drop pages 0)
  (cells-drop ledger 0)
  (cells-drop layout 0)
  (node-new nodes (nk-document) -1)
  (return 0))

(defn ^:pub ^I32 node-set-text [^:mut ^Cells nodes ^I32 n ^I32 start ^I32 ln]
  (comment "The node's own text is the run [start, start+length) of the text arena.")
  (nput nodes n 7 start)
  (nput nodes n 8 ln)
  (return 0))

(defn ^:pub ^I32 node-set-sub [^:mut ^Cells nodes ^I32 n ^I32 v] (return (nput nodes n 14 v)))
(defn ^:pub ^I32 node-set-aux [^:mut ^Cells nodes ^I32 n ^I32 v] (return (nput nodes n 15 v)))
(defn ^:pub ^I32 node-set-src [^:mut ^Cells nodes ^I32 n ^I32 v] (return (nput nodes n 11 v)))
(defn ^:pub ^I32 node-set-flags [^:mut ^Cells nodes ^I32 n ^I32 v] (return (nput nodes n 13 v)))

(defn ^:pub ^I32 node-set-conf [^:mut ^Cells nodes ^I32 n ^I32 v]
  (comment "0..1000, or -1 for absent. Anything else is clamped to that range.")
  (if (< v -1) (return (nput nodes n 12 -1)))
  (if (> v 1000) (return (nput nodes n 12 1000)))
  (return (nput nodes n 12 v)))

(defn ^:pub ^I32 node-add-src [^:mut ^Cells nodes ^I32 n ^I32 bits]
  (let [^I32 old (nget nodes n 11)]
    (return (nput nodes n 11 (bit-or old bits)))))

(defn ^:pub ^I32 node-add-flag [^:mut ^Cells nodes ^I32 n ^I32 bits]
  (let [^I32 old (nget nodes n 13)]
    (return (nput nodes n 13 (bit-or old bits)))))

;; ---------------------------------------------------------------- text

(defn ^:pub ^I32 text-len [^Cells text] (return (cells-len text)))
(defn ^:pub ^I32 text-at [^Cells text ^I32 i] (return (cells-at text i)))

(defn ^:pub ^I32 text-append-cp [^:mut ^Cells text ^I32 cp]
  (comment "Append one Unicode scalar value; answer the index it went to.")
  (comment "Anything that is not a scalar value (negative, past U+10FFFF, a")
  (comment "surrogate) is stored as U+FFFD, so the arena only ever holds")
  (comment "what SPEC 3.6 says it holds.")
  (if (< cp 0) (return (cells-push text 65533)))
  (if (> cp 1114111) (return (cells-push text 65533)))
  (if (and (>= cp 55296) (<= cp 57343)) (return (cells-push text 65533)))
  (return (cells-push text cp)))

;; Decode one UTF-8 sequence. WHATWG's rule, because it is the one every
;; browser and `String::from_utf8_lossy` agree on: a lead byte fixes how many
;; continuation bytes follow and, for four leads, the range of the FIRST one
;; (E0 A0..BF, ED 80..9F, F0 90..BF, F4 80..8F -- which is what excludes
;; overlong forms, surrogates and values past U+10FFFF). The first byte that
;; is not acceptable ends the sequence WITHOUT being consumed.
(defn ^:pub ^I32 text-append-utf8 [^:mut ^Cells text ^Blob b ^I32 from ^I32 to]
  (comment "Decode b[from, to) as UTF-8 onto the text arena; answer the number")
  (comment "of code points appended. Invalid input becomes U+FFFD (SPEC 4.3:")
  (comment "'invalid input decodes to U+FFFD at the source'), ONE per maximal")
  (comment "invalid subpart: a stray continuation byte, a bad lead, or a")
  (comment "sequence cut short is a single replacement, and decoding resumes")
  (comment "at the first byte that was not part of it.")
  (let [^:mut ^I32 i from
        ^:mut ^I32 k 0
        ^:mut ^I32 c 0
        ^:mut ^I32 cp 0
        ^:mut ^I32 need 0
        ^:mut ^I32 lo 128
        ^:mut ^I32 hi 191
        ^:mut ^I32 ok 1
        ^:mut ^I32 x 0]
    (while (< i to)
      (do (set c (blob-u8 b i))
          (set i (+ i 1))
          (set need 0)
          (set lo 128)
          (set hi 191)
          (set ok 1)
          (set cp c)
          (if (>= c 128)
            (do (set ok 0)
                (if (and (>= c 194) (<= c 223))
                  (do (set need 1) (set cp (bit-and c 31)) (set ok 1)))
                (if (and (>= c 224) (<= c 239))
                  (do (set need 2) (set cp (bit-and c 15)) (set ok 1)
                      (if (== c 224) (set lo 160))
                      (if (== c 237) (set hi 159))))
                (if (and (>= c 240) (<= c 244))
                  (do (set need 3) (set cp (bit-and c 7)) (set ok 1)
                      (if (== c 240) (set lo 144))
                      (if (== c 244) (set hi 143))))))
          (while (and (== ok 1) (> need 0))
            (do (if (< i to)
                  (do (set x (blob-u8 b i))
                      (if (and (>= x lo) (<= x hi))
                        (do (set cp (+ (* cp 64) (bit-and x 63)))
                            (set i (+ i 1))
                            (set need (- need 1))
                            (set lo 128)
                            (set hi 191))
                        (set ok 0)))
                  (set ok 0))))
          (if (== ok 0) (set cp 65533))
          (text-append-cp text cp)
          (set k (+ k 1))))
    (return k)))

;; ---------------------------------------------------------------- regions

(defn ^:pub ^I32 node-add-region [^:mut ^Cells nodes ^:mut ^Cells regions ^I32 n
                                  ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "Append a region to the node's chain (in the order added: a node")
  (comment "spanning pages has one region per page, in page order) and answer")
  (comment "the region's index.")
  (let [^I32 r (quot (cells-len regions) 6)
        ^I32 cnt (nget nodes n 10)
        ^:mut ^I32 t (nget nodes n 9)]
    (cells-push regions page)
    (cells-push regions x0)
    (cells-push regions y0)
    (cells-push regions x1)
    (cells-push regions y1)
    (cells-push regions -1)
    (if (== cnt 0)
      (nput nodes n 9 r)
      (do (while (>= (cells-at regions (+ (* t 6) 5)) 0)
            (set t (cells-at regions (+ (* t 6) 5))))
          (cells-set regions (+ (* t 6) 5) r)))
    (nput nodes n 10 (+ cnt 1))
    (return r)))

(defn ^I32 rget [^Cells regions ^I32 r ^I32 f]
  (return (cells-at regions (+ (* r 6) f))))

(defn ^:pub ^I32 region-count [^Cells regions] (return (quot (cells-len regions) 6)))
(defn ^:pub ^I32 region-page [^Cells regions ^I32 r] (return (rget regions r 0)))
(defn ^:pub ^I32 region-x0 [^Cells regions ^I32 r] (return (rget regions r 1)))
(defn ^:pub ^I32 region-y0 [^Cells regions ^I32 r] (return (rget regions r 2)))
(defn ^:pub ^I32 region-x1 [^Cells regions ^I32 r] (return (rget regions r 3)))
(defn ^:pub ^I32 region-y1 [^Cells regions ^I32 r] (return (rget regions r 4)))
(defn ^:pub ^I32 region-next [^Cells regions ^I32 r] (return (rget regions r 5)))

;; ------------------------------------------------------------- attributes

(defn ^I32 aget [^Cells attrs ^I32 a ^I32 f]
  (return (cells-at attrs (+ (* a 5) f))))

(defn ^:pub ^I32 attr-count [^Cells attrs] (return (quot (cells-len attrs) 5)))
(defn ^:pub ^I32 attr-key [^Cells attrs ^I32 a] (return (aget attrs a 0)))
(defn ^:pub ^I32 attr-vkind [^Cells attrs ^I32 a] (return (aget attrs a 1)))
(defn ^:pub ^I32 attr-value [^Cells attrs ^I32 a] (return (aget attrs a 2)))
(defn ^:pub ^I32 attr-len [^Cells attrs ^I32 a] (return (aget attrs a 3)))
(defn ^:pub ^I32 attr-next [^Cells attrs ^I32 a] (return (aget attrs a 4)))

(defn ^:pub ^I32 attr-find [^Cells attrs ^I32 head ^I32 key]
  (comment "The first attribute with `key` in the chain from `head`, or -1.")
  (let [^:mut ^I32 a head]
    (while (>= a 0)
      (do (if (== (aget attrs a 0) key) (return a))
          (set a (aget attrs a 4))))
    (return -1)))

(defn ^:pub ^I32 attr-find-next [^Cells attrs ^I32 a ^I32 key]
  (comment "The next attribute with `key` AFTER a (a key may repeat: a")
  (comment "figure's `labels`, a furniture's `pages`), or -1.")
  (let [^I32 nx (aget attrs a 4)]
    (return (attr-find attrs nx key))))

(defn ^:pub ^I32 node-attr [^Cells nodes ^Cells attrs ^I32 n ^I32 key]
  (comment "The node's first attribute with `key`, or -1.")
  (return (attr-find attrs (nget nodes n 6) key)))

(defn ^:pub ^I32 node-attr-int-or [^Cells nodes ^Cells attrs ^I32 n ^I32 key ^I32 dflt]
  (comment "An int, bool or node attribute's value, or `dflt` when absent.")
  (let [^I32 a (attr-find attrs (nget nodes n 6) key)]
    (if (< a 0) (return dflt))
    (return (aget attrs a 2))))

(defn ^I32 attr-put [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key
                     ^I32 vkind ^I32 value ^I32 ln ^I32 replace]
  (comment "Set (replace = 1: overwrite the first attribute with the key, if")
  (comment "there is one) or add (replace = 0: always append) an attribute.")
  (let [^I32 head (nget nodes n 6)
        ^I32 found (attr-find attrs head key)
        ^I32 a (quot (cells-len attrs) 5)
        ^:mut ^I32 t head]
    (if (and (== replace 1) (>= found 0))
      (do (cells-set attrs (+ (* found 5) 1) vkind)
          (cells-set attrs (+ (* found 5) 2) value)
          (cells-set attrs (+ (* found 5) 3) ln)
          (return found)))
    (cells-push attrs key)
    (cells-push attrs vkind)
    (cells-push attrs value)
    (cells-push attrs ln)
    (cells-push attrs -1)
    (if (< head 0)
      (nput nodes n 6 a)
      (do (while (>= (cells-at attrs (+ (* t 5) 4)) 0)
            (set t (cells-at attrs (+ (* t 5) 4))))
          (cells-set attrs (+ (* t 5) 4) a)))
    (return a)))

(defn ^:pub ^I32 node-set-attr-int [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 v]
  (return (attr-put nodes attrs n key 0 v 0 1)))
(defn ^:pub ^I32 node-set-attr-bool [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 v]
  (comment "Any non-zero v is stored as 1.")
  (if (!= v 0) (return (attr-put nodes attrs n key 3 1 0 1)))
  (return (attr-put nodes attrs n key 3 0 0 1)))
(defn ^:pub ^I32 node-set-attr-node [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 target]
  (return (attr-put nodes attrs n key 2 target 0 1)))
(defn ^:pub ^I32 node-set-attr-text [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 start ^I32 ln]
  (comment "The value is the run [start, start+length) of the text arena.")
  (return (attr-put nodes attrs n key 1 start ln 1)))
(defn ^:pub ^I32 node-set-align [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 v]
  (comment "Set the alignment of a paragraph (its `sub`), heading, caption or cell")
  (comment "(the attribute `fk-align`), a logical `al` code (D110). Answers 0, or -1")
  (comment "when the value is not an `al` code, the node is not one of those kinds,")
  (comment "or it is a cell and the value is `justify`.")
  (let [^I32 kind (nget nodes n 0)]
    (if (or (< v 1) (> v 4)) (return -1))
    (if (== kind (nk-paragraph))
      (do (nput nodes n 14 v) (return 0)))
    (if (and (== kind (nk-cell)) (== v (al-justify))) (return -1))
    (if (or (== kind (nk-heading)) (== kind (nk-caption)) (== kind (nk-cell)))
      (do (attr-put nodes attrs n (fk-align) 0 v 0 1) (return 0)))
    (return -1)))

(defn ^:pub ^I32 node-add-attr-int [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 v]
  (comment "Append, even if the key is already there (a repeated key).")
  (return (attr-put nodes attrs n key 0 v 0 0)))
(defn ^:pub ^I32 node-add-attr-text [^:mut ^Cells nodes ^:mut ^Cells attrs ^I32 n ^I32 key ^I32 start ^I32 ln]
  (return (attr-put nodes attrs n key 1 start ln 0)))

;; ------------------------------------------------------------------ pages
;;
;;   0 number (1-based, as the JSON `n`)  1 label-start (-1 none)  2 label-len
;;   3 w  4 h (centipoints)  5 rot (0, 90, 180, 270)  6 kind (`pk`)
;;   7 health (0..1000, -1 absent)  8 dpi (0 unknown)  9 px-w  10 px-h
;;   11 layout-first (the first row of this page's run in the `layout` arena)
;;   12 layout-count (rows in the run; 0 = no layout, and 11 means nothing)
;;   13..15 reserved, 0 (D050): room for per-page fields without a new stride.

(defn ^:pub ^I32 page-new [^:mut ^Cells pages ^I32 number ^I32 w ^I32 h ^I32 rot ^I32 kind]
  (comment "Append a page-table row and answer its index. A new row has no")
  (comment "label, no health and no resolution.")
  (let [^I32 p (quot (cells-len pages) 16)
        ^:mut ^I32 i 0]
    (cells-push pages number)
    (cells-push pages -1)
    (cells-push pages 0)
    (cells-push pages w)
    (cells-push pages h)
    (cells-push pages rot)
    (cells-push pages kind)
    (cells-push pages -1)
    (cells-push pages 0)
    (cells-push pages 0)
    (cells-push pages 0)
    (while (< i 5)
      (do (cells-push pages 0)
          (set i (+ i 1))))
    (return p)))

(defn ^I32 pset [^:mut ^Cells pages ^I32 p ^I32 f ^I32 v]
  (cells-set pages (+ (* p 16) f) v)
  (return 0))

(defn ^I32 pget [^Cells pages ^I32 p ^I32 f]
  (return (cells-at pages (+ (* p 16) f))))

(defn ^:pub ^I32 page-set-label [^:mut ^Cells pages ^I32 p ^I32 start ^I32 ln]
  (pset pages p 1 start)
  (return (pset pages p 2 ln)))
(defn ^:pub ^I32 page-set-health [^:mut ^Cells pages ^I32 p ^I32 v]
  (return (pset pages p 7 v)))
(defn ^:pub ^I32 page-set-kind [^:mut ^Cells pages ^I32 p ^I32 kind]
  (comment "A page's source kind (`pk`), after the page is made: `scanned` once the unit finds its text came from OCR (D212).")
  (return (pset pages p 6 kind)))
(defn ^:pub ^I32 page-set-resolution [^:mut ^Cells pages ^I32 p ^I32 dpi ^I32 pxw ^I32 pxh]
  (pset pages p 8 dpi)
  (pset pages p 9 pxw)
  (return (pset pages p 10 pxh)))

(defn ^:pub ^I32 page-layout-first [^Cells pages ^I32 p] (return (pget pages p 11)))
(defn ^:pub ^I32 page-layout-count [^Cells pages ^I32 p] (return (pget pages p 12)))

(defn ^:pub ^I32 page-count [^Cells pages] (return (quot (cells-len pages) 16)))
(defn ^:pub ^I32 page-number [^Cells pages ^I32 p] (return (pget pages p 0)))
(defn ^:pub ^I32 page-label-start [^Cells pages ^I32 p] (return (pget pages p 1)))
(defn ^:pub ^I32 page-label-len [^Cells pages ^I32 p] (return (pget pages p 2)))
(defn ^:pub ^I32 page-w [^Cells pages ^I32 p] (return (pget pages p 3)))
(defn ^:pub ^I32 page-h [^Cells pages ^I32 p] (return (pget pages p 4)))
(defn ^:pub ^I32 page-rot [^Cells pages ^I32 p] (return (pget pages p 5)))
(defn ^:pub ^I32 page-kind [^Cells pages ^I32 p] (return (pget pages p 6)))
(defn ^:pub ^I32 page-health [^Cells pages ^I32 p] (return (pget pages p 7)))
(defn ^:pub ^I32 page-dpi [^Cells pages ^I32 p] (return (pget pages p 8)))
(defn ^:pub ^I32 page-px-w [^Cells pages ^I32 p] (return (pget pages p 9)))
(defn ^:pub ^I32 page-px-h [^Cells pages ^I32 p] (return (pget pages p 10)))

;; ----------------------------------------------------------------- ledger
;;
;;   0 reason (`dr`)  1 page  2 x0  3 y0  4 x1  5 y1  6 text-start (-1 none)
;;   7 text-len  8 conf (0..1000, -1 absent)  9 src (bitset)

(defn ^:pub ^I32 ledger-add [^:mut ^Cells ledger ^I32 reason ^I32 page
                             ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 conf ^I32 src]
  (comment "Append a ledger row (no text yet) and answer its index.")
  (let [^I32 l (quot (cells-len ledger) 10)]
    (cells-push ledger reason)
    (cells-push ledger page)
    (cells-push ledger x0)
    (cells-push ledger y0)
    (cells-push ledger x1)
    (cells-push ledger y1)
    (cells-push ledger -1)
    (cells-push ledger 0)
    (cells-push ledger conf)
    (cells-push ledger src)
    (return l)))

(defn ^I32 lget [^Cells ledger ^I32 l ^I32 f]
  (return (cells-at ledger (+ (* l 10) f))))

(defn ^:pub ^I32 ledger-set-text [^:mut ^Cells ledger ^I32 l ^I32 start ^I32 ln]
  (cells-set ledger (+ (* l 10) 6) start)
  (cells-set ledger (+ (* l 10) 7) ln)
  (return 0))

(defn ^:pub ^I32 ledger-count [^Cells ledger] (return (quot (cells-len ledger) 10)))
(defn ^:pub ^I32 ledger-reason [^Cells ledger ^I32 l] (return (lget ledger l 0)))
(defn ^:pub ^I32 ledger-page [^Cells ledger ^I32 l] (return (lget ledger l 1)))
(defn ^:pub ^I32 ledger-x0 [^Cells ledger ^I32 l] (return (lget ledger l 2)))
(defn ^:pub ^I32 ledger-y0 [^Cells ledger ^I32 l] (return (lget ledger l 3)))
(defn ^:pub ^I32 ledger-x1 [^Cells ledger ^I32 l] (return (lget ledger l 4)))
(defn ^:pub ^I32 ledger-y1 [^Cells ledger ^I32 l] (return (lget ledger l 5)))
(defn ^:pub ^I32 ledger-text-start [^Cells ledger ^I32 l] (return (lget ledger l 6)))
(defn ^:pub ^I32 ledger-text-len [^Cells ledger ^I32 l] (return (lget ledger l 7)))
(defn ^:pub ^I32 ledger-conf [^Cells ledger ^I32 l] (return (lget ledger l 8)))
(defn ^:pub ^I32 ledger-src [^Cells ledger ^I32 l] (return (lget ledger l 9)))

;; ----------------------------------------------------------------- layout
;;
;;   0 page (the page NUMBER, as a region's)  1 band  2 col
;;   3 role (`rl`: body 2, margin 6, sidebar 9)  4 x0  5 y0  6 x1  7 y1
;;
;; THE COLUMN MAP (D111). A page's cells are ONE CONTIGUOUS RUN, in reading
;; order, and its `pages` row names the run (cells 11 and 12: first, count).
;; `lay-add` keeps the run contiguous: it refuses (answers -1) a cell for a page
;; whose run is not the last one written, so a stage writes a page's map whole.

(defn ^:pub ^I32 lay-add [^:mut ^Cells layout ^:mut ^Cells pages ^I32 p
                          ^I32 band ^I32 col ^I32 role
                          ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "Append a cell to page index p's run and answer its row, or -1 when p")
  (comment "is not a page, the role is not body, margin or sidebar, or the page's")
  (comment "run is not at the end of the arena.")
  (let [^I32 r (quot (cells-len layout) 8)
        ^:mut ^I32 cnt 0
        ^:mut ^I32 num 0]
    (if (or (< p 0) (>= p (quot (cells-len pages) 16))) (return -1))
    (if (and (!= role (rl-body)) (!= role (rl-margin)) (!= role (rl-sidebar)))
      (return -1))
    (set cnt (pget pages p 12))
    (set num (pget pages p 0))
    (if (== cnt 0)
      (pset pages p 11 r)
      (if (!= (+ (pget pages p 11) cnt) r) (return -1)))
    (pset pages p 12 (+ cnt 1))
    (cells-push layout num)
    (cells-push layout band)
    (cells-push layout col)
    (cells-push layout role)
    (cells-push layout x0)
    (cells-push layout y0)
    (cells-push layout x1)
    (cells-push layout y1)
    (return r)))

(defn ^I32 yget [^Cells layout ^I32 r ^I32 f]
  (return (cells-at layout (+ (* r 8) f))))

(defn ^:pub ^I32 layout-count [^Cells layout] (return (quot (cells-len layout) 8)))
(defn ^:pub ^I32 layout-page [^Cells layout ^I32 r] (return (yget layout r 0)))
(defn ^:pub ^I32 layout-band [^Cells layout ^I32 r] (return (yget layout r 1)))
(defn ^:pub ^I32 layout-col [^Cells layout ^I32 r] (return (yget layout r 2)))
(defn ^:pub ^I32 layout-role [^Cells layout ^I32 r] (return (yget layout r 3)))
(defn ^:pub ^I32 layout-x0 [^Cells layout ^I32 r] (return (yget layout r 4)))
(defn ^:pub ^I32 layout-y0 [^Cells layout ^I32 r] (return (yget layout r 5)))
(defn ^:pub ^I32 layout-x1 [^Cells layout ^I32 r] (return (yget layout r 6)))
(defn ^:pub ^I32 layout-y1 [^Cells layout ^I32 r] (return (yget layout r 7)))

;; ------------------------------------------------------------------ check
;;
;; `model-check` answers 0 when the seven arenas are a well-formed Model and an
;; `mc` code when not, with the offending index in `st[0]` (`st` is any
;; `Cells`, cleared on entry). It is what a stage runs on its own output
;; before handing it on, and what a fuzzer asserts: a Model that passes cannot
;; make a walker or the serializer read out of range.

(defn ^I32 mc-fail [^:mut ^Cells st ^I32 code ^I32 at]
  (cells-set st 0 at)
  (return code))

(defn ^I32 mc-link-ok [^I32 v ^I32 n]
  (comment "1 when v is -1 or an index below n.")
  (if (< v -1) (return 0))
  (if (>= v n) (return 0))
  (return 1))

(defn ^I32 mc-run-ok [^I32 start ^I32 ln ^I32 tl]
  (comment "1 for an absent run (start -1, ln 0) or one inside [0, tl).")
  (if (== start -1)
    (do (if (== ln 0) (return 1))
        (return 0)))
  (if (< start 0) (return 0))
  (if (< ln 0) (return 0))
  (if (> start tl) (return 0))
  (if (> ln (- tl start)) (return 0))
  (return 1))

(defn ^I32 mc-check-node [^Cells nodes ^Cells attrs ^Cells regions
                          ^Cells text ^I32 n ^I32 nn]
  (comment "One node's own fields. 0 or an `mc` code.")
  (let [^I32 kind (nget nodes n 0)
        ^I32 cnt (nget nodes n 10)
        ^I32 conf (nget nodes n 12)
        ^:mut ^I32 a (nget nodes n 6)
        ^:mut ^I32 r (nget nodes n 9)
        ^:mut ^I32 steps 0
        ^I32 na (quot (cells-len attrs) 5)
        ^I32 nr (quot (cells-len regions) 6)
        ^I32 tl (cells-len text)]
    (if (or (< kind 1) (> kind 26)) (return (mc-bad-kind)))
    (if (== (mc-link-ok (nget nodes n 1) nn) 0) (return (mc-bad-link)))
    (if (== (mc-link-ok (nget nodes n 2) nn) 0) (return (mc-bad-link)))
    (if (== (mc-link-ok (nget nodes n 3) nn) 0) (return (mc-bad-link)))
    (if (== (mc-link-ok (nget nodes n 4) nn) 0) (return (mc-bad-link)))
    (if (== (mc-link-ok (nget nodes n 5) nn) 0) (return (mc-bad-link)))
    (if (== (mc-run-ok (nget nodes n 7) (nget nodes n 8) tl) 0) (return (mc-bad-text)))
    (if (or (< conf -1) (> conf 1000)) (return (mc-bad-conf)))
    (while (>= a 0)
      (do (if (>= a na) (return (mc-bad-attr)))
          (if (> steps na) (return (mc-bad-attr)))
          (set steps (+ steps 1))
          (if (== (aget attrs a 1) 1)
            (if (== (mc-run-ok (aget attrs a 2) (aget attrs a 3) tl) 0)
              (return (mc-bad-attr))))
          (if (== (mc-link-ok (aget attrs a 4) na) 0) (return (mc-bad-attr)))
          (if (or (< (aget attrs a 1) 0) (> (aget attrs a 1) 3)) (return (mc-bad-attr)))
          (set a (aget attrs a 4))))
    (set steps 0)
    (while (>= r 0)
      (do (if (>= r nr) (return (mc-bad-region)))
          (if (> steps nr) (return (mc-bad-region)))
          (set steps (+ steps 1))
          (if (== (mc-link-ok (rget regions r 5) nr) 0) (return (mc-bad-region)))
          (set r (rget regions r 5))))
    (if (!= steps cnt) (return (mc-bad-region)))
    (return 0)))

(defn ^I32 mc-check-children [^Cells nodes ^I32 n ^I32 nn]
  (comment "The child chain of n: every child points back at n, prev links")
  (comment "agree, `last-child` is the end of the chain. Answers the number of")
  (comment "children, or -1 when the chain is wrong.")
  (let [^:mut ^I32 c (nget nodes n 2)
        ^:mut ^I32 prev -1
        ^:mut ^I32 k 0]
    (while (>= c 0)
      (do (if (> k nn) (return -1))
          (if (!= (nget nodes c 1) n) (return -1))
          (if (!= (nget nodes c 5) prev) (return -1))
          (set k (+ k 1))
          (set prev c)
          (set c (nget nodes c 4))))
    (if (!= (nget nodes n 3) prev) (return -1))
    (return k)))

(defn ^I32 mc-check-order [^Cells nodes ^I32 nn ^:mut ^Cells st]
  (comment "Pre-order ids: walking each tree in pre-order, from its root,")
  (comment "visits the indices consecutively, and the trees follow each other")
  (comment "in index order. So an id is the node's position in document")
  (comment "order (SPEC 3.3).")
  (let [^:mut ^I32 i 0
        ^:mut ^I32 expect 0
        ^:mut ^I32 cur 0]
    (while (< i nn)
      (do (if (== (nget nodes i 1) -1)
            (do (if (!= i expect) (return (mc-fail st (mc-not-preorder) i)))
                (set cur i)
                (while (>= cur 0)
                  (do (if (!= cur expect) (return (mc-fail st (mc-not-preorder) cur)))
                      (set expect (+ expect 1))
                      (if (>= (nget nodes cur 2) 0)
                        (set cur (nget nodes cur 2))
                        (do (while (and (>= cur 0) (!= cur i) (< (nget nodes cur 4) 0))
                              (set cur (nget nodes cur 1)))
                            (if (== cur i)
                              (set cur -1)
                              (if (>= cur 0)
                                (set cur (nget nodes cur 4))))))))))
          (set i (+ i 1))))
    (if (!= expect nn) (return (mc-fail st (mc-not-preorder) expect)))
    (return 0)))

(defn ^:pub ^I32 model-check [^Cells nodes ^Cells attrs ^Cells regions ^Cells text
                              ^Cells pages ^Cells ledger ^Cells layout ^:mut ^Cells st]
  (let [^I32 nn (quot (cells-len nodes) 16)
        ^I32 nlay (quot (cells-len layout) 8)
        ^:mut ^I32 j 0
        ^:mut ^I32 i 0
        ^:mut ^I32 rc 0
        ^:mut ^I32 kids 0
        ^:mut ^I32 total 0
        ^:mut ^I32 nonroot 0
        ^I32 tl (cells-len text)]
    (cells-drop st 0)
    (cells-push st 0)
    (if (!= (rem (cells-len nodes) 16) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (!= (rem (cells-len attrs) 5) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (!= (rem (cells-len regions) 6) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (!= (rem (cells-len pages) 16) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (!= (rem (cells-len ledger) 10) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (!= (rem (cells-len layout) 8) 0) (return (mc-fail st (mc-bad-stride) 0)))
    (if (< nn 1) (return (mc-fail st (mc-no-root) 0)))
    (if (!= (nget nodes 0 0) (nk-document)) (return (mc-fail st (mc-no-root) 0)))
    (if (!= (nget nodes 0 1) -1) (return (mc-fail st (mc-no-root) 0)))
    (while (< i nn)
      (do (set rc (mc-check-node nodes attrs regions text i nn))
          (if (!= rc 0) (return (mc-fail st rc i)))
          (set i (+ i 1))))
    (set i 0)
    (while (< i nn)
      (do (set kids (mc-check-children nodes i nn))
          (if (< kids 0) (return (mc-fail st (mc-bad-tree) i)))
          (set total (+ total kids))
          (if (>= (nget nodes i 1) 0) (set nonroot (+ nonroot 1)))
          (set i (+ i 1))))
    (if (!= total nonroot) (return (mc-fail st (mc-bad-tree) 0)))
    (set rc (mc-check-order nodes nn st))
    (if (!= rc 0) (return rc))
    (set i 0)
    (while (< i (quot (cells-len pages) 16))
      (do (if (== (mc-run-ok (pget pages i 1) (pget pages i 2) tl) 0)
            (return (mc-fail st (mc-bad-page) i)))
          (set i (+ i 1))))
    (set i 0)
    (while (< i (quot (cells-len ledger) 10))
      (do (if (== (mc-run-ok (lget ledger i 6) (lget ledger i 7) tl) 0)
            (return (mc-fail st (mc-bad-ledger) i)))
          (if (or (< (lget ledger i 8) -1) (> (lget ledger i 8) 1000))
            (return (mc-fail st (mc-bad-ledger) i)))
          (set i (+ i 1))))
    (set i 0)
    (while (< i (quot (cells-len pages) 16))
      (do (if (< (pget pages i 12) 0) (return (mc-fail st (mc-bad-layout) i)))
          (if (> (pget pages i 12) 0)
            (do (if (< (pget pages i 11) 0) (return (mc-fail st (mc-bad-layout) i)))
                (if (> (pget pages i 11) (- nlay (pget pages i 12)))
                  (return (mc-fail st (mc-bad-layout) i)))
                (set j 0)
                (while (< j (pget pages i 12))
                  (do (if (!= (yget layout (+ (pget pages i 11) j) 0) (pget pages i 0))
                        (return (mc-fail st (mc-bad-layout) i)))
                      (if (and (!= (yget layout (+ (pget pages i 11) j) 3) (rl-body))
                               (!= (yget layout (+ (pget pages i 11) j) 3) (rl-margin))
                               (!= (yget layout (+ (pget pages i 11) j) 3) (rl-sidebar)))
                        (return (mc-fail st (mc-bad-layout) i)))
                      (set j (+ j 1))))))
          (set i (+ i 1))))
    (return 0)))

;; ------------------------------------------------------------------- hash

(defn ^I64 mh-fold [^I64 h ^Cells c]
  (comment "FNV-1a over the cells of one arena, each as a 32-bit pattern, then")
  (comment "the arena's length -- so two arenas that differ only in where one")
  (comment "ends and the next begins do not collide.")
  (let [^:mut ^I32 i 0
        ^:mut ^I64 acc h]
    (while (< i (cells-len c))
      (do (set acc (mul64 (bit-xor acc (i64 (cells-at c i))) 1099511628211))
          (set i (+ i 1))))
    (return (mul64 (bit-xor acc (i64 (cells-len c))) 1099511628211))))

(defn ^:pub ^I64 model-hash [^Cells nodes ^Cells attrs ^Cells regions ^Cells text
                             ^Cells pages ^Cells ledger ^Cells layout]
  (comment "A 64-bit fingerprint of the whole Model: the gate's proof that four")
  (comment "targets built the same seven arenas. FNV-1a, offset basis")
  (comment "14695981039346656037 (as a signed value) and prime 1099511628211.")
  (let [^:mut ^I64 h -3750763034362895579]
    (set h (mh-fold h nodes))
    (set h (mh-fold h attrs))
    (set h (mh-fold h regions))
    (set h (mh-fold h text))
    (set h (mh-fold h pages))
    (set h (mh-fold h ledger))
    (set h (mh-fold h layout))
    (return h)))

;; ----------------------------------------------------------------- assets
;;
;; THE ASSET TABLE (P3.13, D117, SPEC 10.11): two more arenas and a byte store, EMPTY unless the `assets` setting is on
;; (a Model built without it never touches them, and its JSON and HTML are byte for byte what they were).
;;
;;   assets   stride 24   0 type (`amt`)  1 origin (`ao`)  2 from (`afm`)  3 object (-1 none)  4 byte start  5 byte length
;;                        6..13 the SHA-256 of the encoded bytes (eight 32-bit words, big-endian)  14 w  15 h
;;                        16 dpi (0 none)  17 flags (`afg` bits)  18 first use  19 uses  20 last use  21..23 spare
;;   uses     stride 8    asset, node, page, x0, y0, x1, y1, next (-1 ends the asset's chain, in admission order)
;;   abytes   a `Buf`     every asset's encoded bytes, back to back; an asset is the span (byte start, byte length)
;;
;; A node with pixels has the attribute `fk-asset` (an asset id); one without has `fk-noasset` (an `nz` code). The asset
;; id is the row's index. `model-check-assets` and `model-hash-assets` cover all of it.

(defn ^I32 xget [^Cells assets ^I32 a ^I32 f]
  (return (cells-at assets (+ (* a 24) f))))

(defn ^I32 xset [^:mut ^Cells assets ^I32 a ^I32 f ^I32 v]
  (cells-set assets (+ (* a 24) f) v)
  (return 0))

(defn ^:pub ^I32 asset-add [^:mut ^Cells assets ^I32 mtype ^I32 origin ^I32 afrom ^I32 object
                            ^I32 bstart ^I32 blen ^I32 w ^I32 h ^I32 dpi ^I32 flags]
  (comment "Append an asset (no uses yet, the hash zero) and answer its id. `object` is -1 for none, `dpi` 0.")
  (let [^I32 id (quot (cells-len assets) 24)
        ^:mut ^I32 i 0]
    (cells-push assets mtype)
    (cells-push assets origin)
    (cells-push assets afrom)
    (cells-push assets object)
    (cells-push assets bstart)
    (cells-push assets blen)
    (while (< i 8)
      (do (cells-push assets 0)
          (set i (+ i 1))))
    (cells-push assets w)
    (cells-push assets h)
    (cells-push assets dpi)
    (cells-push assets flags)
    (cells-push assets -1)
    (cells-push assets 0)
    (cells-push assets -1)
    (cells-push assets 0)
    (cells-push assets 0)
    (cells-push assets 0)
    (return id)))

(defn ^:pub ^I32 asset-set-sha [^:mut ^Cells assets ^I32 a ^I32 i ^I32 v]
  (comment "Word i (0..7) of asset a's SHA-256.")
  (return (xset assets a (+ 6 i) v)))

(defn ^:pub ^I32 asset-set-flags [^:mut ^Cells assets ^I32 a ^I32 v] (return (xset assets a 17 v)))

(defn ^:pub ^I32 use-add [^:mut ^Cells assets ^:mut ^Cells uses ^I32 a ^I32 node ^I32 page
                          ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1]
  (comment "Append a use of asset a by `node`, at the page region given, to the END of the asset's chain; answers its index.")
  (let [^I32 u (quot (cells-len uses) 8)
        ^I32 tail (xget assets a 20)
        ^I32 cnt (xget assets a 19)]
    (cells-push uses a)
    (cells-push uses node)
    (cells-push uses page)
    (cells-push uses x0)
    (cells-push uses y0)
    (cells-push uses x1)
    (cells-push uses y1)
    (cells-push uses -1)
    (if (< tail 0)
      (xset assets a 18 u)
      (cells-set uses (+ (* tail 8) 7) u))
    (xset assets a 20 u)
    (xset assets a 19 (+ cnt 1))
    (return u)))

(defn ^:pub ^I32 asset-count [^Cells assets] (return (quot (cells-len assets) 24)))
(defn ^:pub ^I32 asset-type [^Cells assets ^I32 a] (return (xget assets a 0)))
(defn ^:pub ^I32 asset-origin [^Cells assets ^I32 a] (return (xget assets a 1)))
(defn ^:pub ^I32 asset-from [^Cells assets ^I32 a] (return (xget assets a 2)))
(defn ^:pub ^I32 asset-object [^Cells assets ^I32 a] (return (xget assets a 3)))
(defn ^:pub ^I32 asset-bstart [^Cells assets ^I32 a] (return (xget assets a 4)))
(defn ^:pub ^I32 asset-blen [^Cells assets ^I32 a] (return (xget assets a 5)))
(defn ^:pub ^I32 asset-sha [^Cells assets ^I32 a ^I32 i] (return (xget assets a (+ 6 i))))
(defn ^:pub ^I32 asset-w [^Cells assets ^I32 a] (return (xget assets a 14)))
(defn ^:pub ^I32 asset-h [^Cells assets ^I32 a] (return (xget assets a 15)))
(defn ^:pub ^I32 asset-dpi [^Cells assets ^I32 a] (return (xget assets a 16)))
(defn ^:pub ^I32 asset-flags [^Cells assets ^I32 a] (return (xget assets a 17)))
(defn ^:pub ^I32 asset-use-head [^Cells assets ^I32 a] (return (xget assets a 18)))
(defn ^:pub ^I32 asset-use-count [^Cells assets ^I32 a] (return (xget assets a 19)))

(defn ^I32 uget [^Cells uses ^I32 u ^I32 f]
  (return (cells-at uses (+ (* u 8) f))))

(defn ^:pub ^I32 use-count [^Cells uses] (return (quot (cells-len uses) 8)))
(defn ^:pub ^I32 use-asset [^Cells uses ^I32 u] (return (uget uses u 0)))
(defn ^:pub ^I32 use-node [^Cells uses ^I32 u] (return (uget uses u 1)))
(defn ^:pub ^I32 use-page [^Cells uses ^I32 u] (return (uget uses u 2)))
(defn ^:pub ^I32 use-x0 [^Cells uses ^I32 u] (return (uget uses u 3)))
(defn ^:pub ^I32 use-y0 [^Cells uses ^I32 u] (return (uget uses u 4)))
(defn ^:pub ^I32 use-x1 [^Cells uses ^I32 u] (return (uget uses u 5)))
(defn ^:pub ^I32 use-y1 [^Cells uses ^I32 u] (return (uget uses u 6)))
(defn ^:pub ^I32 use-next [^Cells uses ^I32 u] (return (uget uses u 7)))

(defn ^:pub ^I32 asset-ext-is-jpg [^Cells assets ^I32 a]
  (if (== (xget assets a 0) 1) (return 1))
  (return 0))

(defn ^:pub ^I32 asset-find [^Cells assets ^I32 blen ^I32 s0 ^I32 s1 ^I32 s2 ^I32 s3 ^I32 s4 ^I32 s5 ^I32 s6 ^I32 s7]
  (comment "The first asset whose encoded bytes are `blen` long with this SHA-256, or -1 (admission's dedup).")
  (let [^I32 n (quot (cells-len assets) 24)
        ^:mut ^I32 a 0]
    (while (< a n)
      (do (if (and (== (xget assets a 5) blen)
                   (and (== (xget assets a 6) s0) (== (xget assets a 7) s1)
                        (and (== (xget assets a 8) s2) (== (xget assets a 9) s3)
                             (and (== (xget assets a 10) s4) (== (xget assets a 11) s5)
                                  (and (== (xget assets a 12) s6) (== (xget assets a 13) s7))))))
            (return a))
          (set a (+ a 1))))
    (return -1)))

(defn ^:pub ^I32 model-check-assets [^Cells nodes ^Cells attrs ^Cells assets ^Cells uses ^Buf abytes ^:mut ^Cells st]
  (comment "Are the asset table, its uses and the nodes' `asset`/`noasset` well formed? 0, or `mc-bad-asset` (the index in")
  (comment "`st[0]`: the asset, the use or the node). Run it after `model-check` when `assets` is on.")
  (let [^I32 na (quot (cells-len assets) 24)
        ^I32 nu (quot (cells-len uses) 8)
        ^I32 nn (quot (cells-len nodes) 16)
        ^I32 bl (buf-len abytes)
        ^:mut ^I32 i 0
        ^:mut ^I32 u 0
        ^:mut ^I32 k 0
        ^:mut ^I32 a 0
        ^:mut ^I32 v 0
        ^:mut ^I32 total 0]
    (cells-drop st 0)
    (cells-push st 0)
    (if (!= (rem (cells-len assets) 24) 0) (return (mc-fail st (mc-bad-asset) 0)))
    (if (!= (rem (cells-len uses) 8) 0) (return (mc-fail st (mc-bad-asset) 0)))
    (while (< i na)
      (do (if (or (< (xget assets i 0) 1) (> (xget assets i 0) 2)) (return (mc-fail st (mc-bad-asset) i)))
          (if (or (< (xget assets i 1) 1) (> (xget assets i 1) 4)) (return (mc-fail st (mc-bad-asset) i)))
          (if (or (< (xget assets i 2) 1) (> (xget assets i 2) 12)) (return (mc-fail st (mc-bad-asset) i)))
          (if (or (< (xget assets i 4) 0) (< (xget assets i 5) 0)) (return (mc-fail st (mc-bad-asset) i)))
          (if (> (xget assets i 4) bl) (return (mc-fail st (mc-bad-asset) i)))
          (if (> (xget assets i 5) (- bl (xget assets i 4))) (return (mc-fail st (mc-bad-asset) i)))
          (if (or (< (xget assets i 14) 0) (< (xget assets i 15) 0)) (return (mc-fail st (mc-bad-asset) i)))
          (if (or (< (xget assets i 17) 0) (> (xget assets i 17) 63)) (return (mc-fail st (mc-bad-asset) i)))
          (set u (xget assets i 18))
          (set k 0)
          (while (>= u 0)
            (do (if (>= u nu) (return (mc-fail st (mc-bad-asset) i)))
                (if (> k nu) (return (mc-fail st (mc-bad-asset) i)))
                (if (!= (uget uses u 0) i) (return (mc-fail st (mc-bad-asset) i)))
                (if (or (< (uget uses u 1) 0) (>= (uget uses u 1) nn)) (return (mc-fail st (mc-bad-asset) u)))
                (if (== (mc-link-ok (uget uses u 7) nu) 0) (return (mc-fail st (mc-bad-asset) u)))
                (set k (+ k 1))
                (set u (uget uses u 7))))
          (if (!= k (xget assets i 19)) (return (mc-fail st (mc-bad-asset) i)))
          (set total (+ total k))
          (set i (+ i 1))))
    (if (!= total nu) (return (mc-fail st (mc-bad-asset) 0)))
    (set i 0)
    (while (< i nn)
      (do (set a (attr-find attrs (nget nodes i 6) (fk-asset)))
          (set v (attr-find attrs (nget nodes i 6) (fk-noasset)))
          (if (and (>= a 0) (>= v 0)) (return (mc-fail st (mc-bad-asset) i)))
          (if (>= a 0)
            (do (if (or (< (aget attrs a 2) 0) (>= (aget attrs a 2) na)) (return (mc-fail st (mc-bad-asset) i)))))
          (if (>= v 0)
            (do (if (or (< (aget attrs v 2) 1) (> (aget attrs v 2) 9)) (return (mc-fail st (mc-bad-asset) i)))))
          (set i (+ i 1))))
    (return 0)))

(defn ^:pub ^I64 model-hash-assets [^I64 h ^Cells assets ^Cells uses ^Buf abytes]
  (comment "Fold the asset table, its uses and the bytes into a `model-hash` value `h` (FNV-1a, as `model-hash`).")
  (let [^:mut ^I64 acc (mh-fold h assets)
        ^:mut ^I32 i 0
        ^I32 bl (buf-len abytes)]
    (set acc (mh-fold acc uses))
    (while (< i bl)
      (do (set acc (mul64 (bit-xor acc (i64 (buf-at abytes i))) 1099511628211))
          (set i (+ i 1))))
    (return (mul64 (bit-xor acc (i64 bl)) 1099511628211))))

