;; Laws for `emon.splitmix` (P0.4). The expected words are the reference
;; algorithm's (Steele, Lea & Flood; seed 0 begins E220A8397B1DCDAF), computed
;; independently in Python 64-bit integer arithmetic and written here as
;; (high, low) signed 32-bit halves, since a law compares I32s.
(ns emon.splitmixtest
  (:require [emon.lang :refer [I32 I64 Cells]]
            [emon.test :refer [deftest assert-eq assert-eq-at assert-eq64
                               assert-that assert-that-at new-cells]]
            [emon.splitmix :refer [sm-seed sm-next sm-at sm-hi sm-lo sm-below sm-mix]]
            [kin.lang :refer [let set while do comment + < >= !=]]))

(deftest test-the-stream-for-seed-0-is-splitmix64
  (let [^Cells st (new-cells)]
    (sm-seed st 0)
    (let [^I64 w0 (sm-next st)]
      (assert-eq-at (sm-hi w0) -501176263 "high half" 0)
      (assert-eq-at (sm-lo w0) 2065550767 "low half" 0))
    (let [^I64 w1 (sm-next st)]
      (assert-eq-at (sm-hi w1) 1853398634 "high half" 1)
      (assert-eq-at (sm-lo w1) -1581685260 "low half" 1))
    (let [^I64 w2 (sm-next st)]
      (assert-eq-at (sm-hi w2) 113532184 "high half" 2)
      (assert-eq-at (sm-lo w2) -2146876081 "low half" 2))
    (let [^I64 w3 (sm-next st)]
      (assert-eq-at (sm-hi w3) -125060952 "high half" 3)
      (assert-eq-at (sm-lo w3) 1917616620 "low half" 3))
    ))

(deftest test-random-access-for-seed-0-matches-the-stream
  (assert-eq64 (sm-at 0 0) -2152535657050944081 "word 0")
  (assert-eq64 (sm-at 0 1) 7960286522194355700 "word 1")
  (assert-eq64 (sm-at 0 2) 487617019471545679 "word 2")
  (assert-eq64 (sm-at 0 3) -537132696929009172 "word 3"))

(deftest test-the-stream-for-seed-1-is-splitmix64
  (let [^Cells st (new-cells)]
    (sm-seed st 1)
    (let [^I64 w0 (sm-next st)]
      (assert-eq-at (sm-hi w0) -1861603860 "high half" 0)
      (assert-eq-at (sm-lo w0) -1996333887 "low half" 0))
    (let [^I64 w1 (sm-next st)]
      (assert-eq-at (sm-hi w1) -1091859039 "high half" 1)
      (assert-eq-at (sm-lo w1) 1703865447 "low half" 1))
    (let [^I64 w2 (sm-next st)]
      (assert-eq-at (sm-hi w2) -124542226 "high half" 2)
      (assert-eq-at (sm-lo w2) -80587426 "low half" 2))
    (let [^I64 w3 (sm-next st)]
      (assert-eq-at (sm-hi w3) 1908508304 "high half" 3)
      (assert-eq-at (sm-lo w3) -297613045 "low half" 3))
    ))

(deftest test-random-access-for-seed-1-matches-the-stream
  (assert-eq64 (sm-at 1 0) -7995527694508729151 "word 0")
  (assert-eq64 (sm-at 1 1) -4689498862643123097 "word 1")
  (assert-eq64 (sm-at 1 2) -534904783426661026 "word 2")
  (assert-eq64 (sm-at 1 3) 8196980753821780235 "word 3"))

(deftest test-the-stream-for-seed-12345-is-splitmix64
  (let [^Cells st (new-cells)]
    (sm-seed st 12345)
    (let [^I64 w0 (sm-next st)]
      (assert-eq-at (sm-hi w0) 571572824 "high half" 0)
      (assert-eq-at (sm-lo w0) -1445916256 "low half" 0))
    (let [^I64 w1 (sm-next st)]
      (assert-eq-at (sm-hi w1) 879680741 "high half" 1)
      (assert-eq-at (sm-lo w1) -149686035 "low half" 1))
    (let [^I64 w2 (sm-next st)]
      (assert-eq-at (sm-hi w2) 513431484 "high half" 2)
      (assert-eq-at (sm-lo w2) -2132381155 "low half" 2))
    (let [^I64 w3 (sm-next st)]
      (assert-eq-at (sm-hi w3) 756420222 "high half" 3)
      (assert-eq-at (sm-lo w3) 1547649738 "low half" 3))
    ))

(deftest test-random-access-for-seed-12345-matches-the-stream
  (assert-eq64 (sm-at 12345 0) 2454886589211414944 "word 0")
  (assert-eq64 (sm-at 12345 1) 3778200017661327597 "word 1")
  (assert-eq64 (sm-at 12345 2) 2205171434679333405 "word 2")
  (assert-eq64 (sm-at 12345 3) 3248800117070709450 "word 3"))

(deftest test-the-stream-for-seed-minus-one-is-splitmix64
  (let [^Cells st (new-cells)]
    (sm-seed st -1)
    (let [^I64 w0 (sm-next st)]
      (assert-eq-at (sm-hi w0) -455511689 "high half" 0)
      (assert-eq-at (sm-lo w0) 459615264 "low half" 0))
    (let [^I64 w1 (sm-next st)]
      (assert-eq-at (sm-hi w1) -375392153 "high half" 1)
      (assert-eq-at (sm-lo w1) -604601655 "low half" 1))
    (let [^I64 w2 (sm-next st)]
      (assert-eq-at (sm-hi w2) 942667852 "high half" 2)
      (assert-eq-at (sm-lo w2) -1301118487 "low half" 2))
    (let [^I64 w3 (sm-next st)]
      (assert-eq-at (sm-hi w3) 1830663020 "high half" 3)
      (assert-eq-at (sm-lo w3) -878083374 "low half" 3))
    ))

(deftest test-random-access-for-seed-minus-one-matches-the-stream
  (assert-eq64 (sm-at -1 0) -1956407806741107680 "word 0")
  (assert-eq64 (sm-at -1 1) -1612297016619662647 "word 1")
  (assert-eq64 (sm-at -1 2) 4048727598324417001 "word 2")
  (assert-eq64 (sm-at -1 3) 7862637804313477842 "word 3"))

(deftest test-the-stream-for-seed-1311768467463790320-is-splitmix64
  (let [^Cells st (new-cells)]
    (sm-seed st 1311768467463790320)
    (let [^I64 w0 (sm-next st)]
      (assert-eq-at (sm-hi w0) 370746054 "high half" 0)
      (assert-eq-at (sm-lo w0) 1171149032 "low half" 0))
    (let [^I64 w1 (sm-next st)]
      (assert-eq-at (sm-hi w1) -1384772433 "high half" 1)
      (assert-eq-at (sm-lo w1) -1586922656 "low half" 1))
    (let [^I64 w2 (sm-next st)]
      (assert-eq-at (sm-hi w2) 889323332 "high half" 2)
      (assert-eq-at (sm-lo w2) -1876122355 "low half" 2))
    (let [^I64 w3 (sm-next st)]
      (assert-eq-at (sm-hi w3) 1098693032 "high half" 3)
      (assert-eq-at (sm-lo w3) 651702751 "low half" 3))
    ))

(deftest test-random-access-for-seed-1311768467463790320-matches-the-stream
  (assert-eq64 (sm-at 1311768467463790320 0) 1592342178222199016 "word 0")
  (assert-eq64 (sm-at 1311768467463790320 1) -5947552309429306528 "word 1")
  (assert-eq64 (sm-at 1311768467463790320 2) 3819614628928595213 "word 2")
  (assert-eq64 (sm-at 1311768467463790320 3) 4718850641434784223 "word 3"))

(deftest test-below-is-in-range-and-advances
  (let [^Cells st (new-cells)
        ^:mut ^I32 i 0]
    (sm-seed st 0)
    (assert-eq (sm-below st 1000) 516 "first below-1000 of seed 0")
    (assert-eq (sm-below st 0) 0 "n = 0 answers 0")
    (assert-eq (sm-below st -5) 0 "n < 0 answers 0")
    (sm-seed st 99)
    (while (< i 200)
      (do (assert-that-at (>= (sm-below st 7) 0) "non-negative" i)
          (set i (+ i 1))))))

(deftest test-a-reseed-restarts-the-stream
  (let [^Cells st (new-cells)]
    (sm-seed st 5)
    (let [^I64 w0 (sm-next st)
          ^I64 w1 (sm-next st)]
      (sm-seed st 5)
      (assert-eq64 (sm-next st) w0 "same seed, same first word")
      (assert-eq64 (sm-next st) w1 "and the same second word")
      (assert-that (!= w0 w1) "and the two differ"))))
