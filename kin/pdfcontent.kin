;; ------------------------------------------------------ the interpreter's cells
;; Document part: survives `pc-page`.
(defconst ^I32 C_NFONT 0)        ;; font ids handed out
(defconst ^I32 C_CLOCK 1)        ;; the slots' use counter
(defconst ^I32 C_SLOTS 8)        ;; four slots of SLOT_STRIDE cells
(defconst ^I32 SLOT_STRIDE 12)
(defconst ^I32 S_KEY 0)          ;; the font dictionary's handle, 0 empty
(defconst ^I32 S_ID 1)           ;; the font's id in the evidence
(defconst ^I32 S_USE 2)
(defconst ^I32 S_STATUS 3)       ;; `pfn-load`'s
(defconst ^I32 S_ASC 4)          ;; 1/1000 em
(defconst ^I32 S_DESC 5)
(defconst ^I32 S_VERT 6)
(defconst ^I32 S_DW2V 7)         ;; hundredths of 1/1000 em
(defconst ^I32 S_DW2W 8)
(defconst ^I32 C_FIDS 64)        ;; 512 font handles: a font's id is its index
(defconst ^I32 MAX_FIDS 512)     ;; the slab; the limit `fonts-per-doc` (kind 14) is ranged 0..MAX_FIDS (P10.4 close, D1260)
;; Page part, reset by `pc-page`.
(defconst ^I32 C_PAGE 576)
(defconst ^I32 C_WARN 577)
(defconst ^I32 C_OPS 578)
(defconst ^I32 C_OPLIM 579)
(defconst ^I32 C_ABORT 580)      ;; 1: the source missed
(defconst ^I32 C_POS 581)        ;; the lexer: where in `cs`, and where it ends
(defconst ^I32 C_END 582)
(defconst ^I32 C_OXN 583)        ;; operand entries now
(defconst ^I32 C_CDEPTH 584)     ;; open containers
(defconst ^I32 C_OP 585)         ;; the operator just read
(defconst ^I32 C_RES 586)        ;; the Resources dictionary in force (a handle, 0 none)
(defconst ^I32 C_SLOT 587)       ;; the slot of the current font
(defconst ^I32 C_DEPTH 588)      ;; graphics states saved
(defconst ^I32 C_FDEPTH 589)     ;; Form XObjects being run
(defconst ^I32 C_STM 590)        ;; the object number of the stream being run, 0 the page's
(defconst ^I32 C_MCTOP 591)      ;; the innermost open span, -1
(defconst ^I32 C_MCDEPTH 592)
(defconst ^I32 C_MCBASE 593)     ;; the depth this stream started at
(defconst ^I32 C_MCOVER 594)     ;; BDCs ignored for depth, waiting for their EMC
(defconst ^I32 C_CUROCG 595)      ;; the innermost optional-content mark, -1
(defconst ^I32 C_Z 596)           ;; the next paint number on the page
(defconst ^I32 C_FLIM 597)       ;; limit-of FORM_DEPTH
(defconst ^I32 C_INTEXT 598)
(defconst ^I32 C_GSBASE 599)
(defconst ^I32 C_SSTAT 633)      ;; the last non-zero status of a stream decode (`pf-status`)
(defconst ^I32 C_FIDLIM 634)     ;; limit-of FONTS_PER_DOC
(defconst ^I32 C_TOK 632)        ;; what `pc-lex-one` read
(defconst ^I32 C_FSTACK 600)     ;; 32 object numbers of the forms being run
(defconst ^I32 MAX_FORMS 32)
(defconst ^I32 C_CSTACK 640)     ;; 16 open containers' entry indices
(defconst ^I32 MAX_CONT 16)
(defconst ^I32 C_TM 664)         ;; the text matrix, 12 cells
(defconst ^I32 C_TLM 676)        ;; the text line matrix
(defconst ^I32 C_M 688)          ;; text matrix x CTM, kept current while a string is shown
(defconst ^I32 C_BASE 700)       ;; the page's base matrix
(defconst ^I32 C_TMP 712)        ;; scratch matrix
(defconst ^I32 C_CUR 728)        ;; the current graphics state (GS_STRIDE cells)
(defconst ^I32 C_STACK 800)      ;; 256 saved states
(defconst ^I32 MAX_GS 256)
(defconst ^I32 MAX_MC 256)
;; The path under construction and the page's counters (P3.5), after the saved states.
(defconst ^I32 C_PW 17184)       ;; the page's width and height in page space, centipoints
(defconst ^I32 C_PH 17185)
(defconst ^I32 C_PPTS 17186)     ;; the first `pts` row of the path under construction
(defconst ^I32 C_PN 17187)       ;; its points
(defconst ^I32 C_PCX 17188)      ;; the current point (Fx, page space)
(defconst ^I32 C_PCY 17190)
(defconst ^I32 C_PSX 17192)      ;; the current subpath's first point
(defconst ^I32 C_PSY 17194)
(defconst ^I32 C_PBX0 17196)     ;; its box, centipoints
(defconst ^I32 C_PBY0 17197)
(defconst ^I32 C_PBX1 17198)
(defconst ^I32 C_PBY1 17199)
(defconst ^I32 C_PFLAGS 17200)   ;; 1 has a curve, 4 more points than `pts` keeps
(defconst ^I32 C_PNSUB 17201)    ;; subpaths
(defconst ^I32 C_CLIPP 17202)    ;; a pending W (1) or W* (2)
(defconst ^I32 C_TCX0 17203)     ;; the union of the boxes of glyphs shown in a clipping render mode
(defconst ^I32 C_TCY0 17204)
(defconst ^I32 C_TCX1 17205)
(defconst ^I32 C_TCY1 17206)
(defconst ^I32 C_TCN 17207)
(defconst ^I32 C_NPATH 17208)    ;; `paths` rows this page made
(defconst ^I32 C_NIMG 17209)     ;; `images` rows this page made
(defconst ^I32 C_PKEEP 17210)    ;; rows of `pts` the path under construction has
(defconst ^I32 C_PTS0 17211)     ;; the first `pts` row this page may make (PTS_PAGE counts from it)
(defconst ^I32 C_BB 17212)       ;; a Form XObject's /BBox, four Fx
(defconst ^I32 C_SIZE 17248)
(defconst ^I32 PATH_KEEP 128)    ;; points a path WITH A CURVE keeps in `pts` (a longer one keeps its box only, flag `truncated`)
(defconst ^I32 PATH_KEEP_STRAIGHT 4096) ;; points a path of `m l h re` alone keeps (D219)
(defconst ^I32 PTS_PAGE 1000000) ;; rows of `pts` a page may make; past it every later path is truncated (warning 1024)
(defconst ^I32 PATH_ROWS 200000) ;; `paths` rows, and `images` rows, a page may make (the rest are counted in warning 1024)

;; A graphics state: what `q` saves.
(defconst ^I32 GS_STRIDE 64)
(defconst ^I32 G_CTM 0)          ;; 12 cells
(defconst ^I32 G_TC 12)          ;; Fx (2 cells each)
(defconst ^I32 G_TW 14)
(defconst ^I32 G_TH 16)          ;; horizontal scale as a ratio, 1.0
(defconst ^I32 G_TL 18)
(defconst ^I32 G_RISE 20)
(defconst ^I32 G_FS 22)
(defconst ^I32 G_MODE 24)
(defconst ^I32 G_FONT 25)        ;; the font dictionary's handle, 0 none
(defconst ^I32 G_COLOR 26)       ;; fill colour 0xRRGGBB
(defconst ^I32 G_ALPHA 27)       ;; per-mille
(defconst ^I32 G_FAM 28)         ;; fill colour space: 0 unknown, 1 gray, 2 rgb, 3 cmyk
(defconst ^I32 G_FOBJ 29)        ;; the object number of the current font dictionary, 0 when direct or none
(defconst ^I32 G_SCOLOR 30)      ;; stroking colour 0xRRGGBB, -1 unknown
(defconst ^I32 G_SALPHA 31)      ;; per-mille
(defconst ^I32 G_FCS 32)         ;; fill colour space: a key of `emon.pdfgfx` (-1 DeviceGray, -2 RGB, -3 CMYK, -4 Pattern, else a handle)
(defconst ^I32 G_SCS 33)         ;; stroking colour space
(defconst ^I32 G_SFAM 34)        ;; stroking colour class (`cs` code, 0 unknown)
(defconst ^I32 G_CLIP 35)        ;; the `paths` row of the clip in force, -1
(defconst ^I32 G_BM 36)          ;; blend mode code (0 Normal)
(defconst ^I32 G_SMASK 37)       ;; soft mask in force: 0 none, 1 alpha, 2 luminosity
(defconst ^I32 G_LW 38)          ;; line width, Fx (two cells)
(defconst ^I32 G_DASH 40)        ;; first dash length in centipoints, 0 solid

;; Operands: entries of four cells, then the bytes of names and strings.
(defconst ^I32 MAX_ENT 4096)
(defconst ^I32 OX_BASE 16384)    ;; MAX_ENT * 4: the first byte cell
(defconst ^I32 K_NUM 1)          ;; [1 hi lo isint]
(defconst ^I32 K_NAME 2)         ;; [2 start length 0]
(defconst ^I32 K_STR 3)
(defconst ^I32 K_ARR 4)          ;; [4 entries that follow, 0 0]
(defconst ^I32 K_DICT 5)
(defconst ^I32 K_BOOL 6)         ;; [6 value 0 0]; null is 0

;; Bits of the page's warnings (`pc-warn`).
(defconst ^I32 W_STREAM 1)       ;; a content stream did not decode cleanly
(defconst ^I32 W_OPERANDS 2)     ;; an operator had more operands than fit
(defconst ^I32 W_FONT 4)         ;; Tf named a font that is not there, or is no font
(defconst ^I32 W_FORM 8)         ;; a Form XObject was missing or damaged
(defconst ^I32 W_DEPTH 16)       ;; a form was too deep, or drew itself
(defconst ^I32 W_STATES 32)      ;; a `q` past 256 or a `Q` with nothing saved
(defconst ^I32 W_MC 64)          ;; an unbalanced EMC, too deep, or unterminated
(defconst ^I32 W_WIDTH 128)      ;; a glyph of unknown width took half an em
(defconst ^I32 W_TEXT 256)       ;; a show operator outside BT or with no font
(defconst ^I32 W_PROPS 512)      ;; a /Properties name was not found
(defconst ^I32 W_PATHS 1024)     ;; more paths or images than a page records (PATH_ROWS)
(defconst ^I32 W_FONTS 2048)     ;; text was shown in a font past `fonts-per-doc`: it has no evidence id (-1) and no `fonts` row

;; ------------------------------------------------------------- small things

(defn ^I32 pc-ws [^I32 c]
  (if (or (== c 32) (or (== c 10) (or (== c 13) (or (== c 9) (or (== c 12) (== c 0))))))
    (return 1))
  (return 0))

(defn ^I32 pc-delim [^I32 c]
  (if (or (== c 40) (or (== c 41) (or (== c 60) (or (== c 62) (or (== c 91) (== c 93))))))
    (return 1))
  (if (or (== c 123) (or (== c 125) (or (== c 47) (== c 37))))
    (return 1))
  (return 0))

(defn ^I32 pc-reg [^I32 c]
  (if (== (pc-ws c) 1) (return 0))
  (if (== (pc-delim c) 1) (return 0))
  (return 1))

(defn ^I32 pc-hexval [^I32 c]
  (if (and (>= c 48) (<= c 57)) (return (- c 48)))
  (if (and (>= c 97) (<= c 102)) (return (- c 87)))
  (if (and (>= c 65) (<= c 70)) (return (- c 55)))
  (return -1))

(defn ^I32 pc-copy-cells [^:mut ^Cells c ^I32 dst ^I32 src ^I32 n]
  (comment "n cells from src to dst within one Cells (the ranges do not overlap).")
  (let [^:mut ^I32 i 0]
    (while (< i n)
      (do (cells-set c (+ dst i) (cells-at c (+ src i)))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 pc-warn-set [^:mut ^Cells cx ^I32 bit]
  (let [^I32 w (cells-at cx C_WARN)]
    (if (== (rem (quot w bit) 2) 0)
      (cells-set cx C_WARN (+ w bit)))
    (return 0)))

(defn ^:pub ^I32 pc-warn [^Cells cx] (return (cells-at cx C_WARN)))
(defn ^:pub ^I32 pc-ops [^Cells cx] (return (cells-at cx C_OPS)))
(defn ^:pub ^I32 pc-fonts [^Cells cx] (return (cells-at cx C_NFONT)))
(defn ^:pub ^I32 pc-stream-status [^Cells cx] (return (cells-at cx C_SSTAT)))

;; --------------------------------------------------------------- the operands

(defn ^I32 pc-ox-push [^:mut ^Cells cx ^:mut ^Cells ox ^I32 kind ^I32 a1 ^I32 a2 ^I32 a3]
  (comment "Append an operand entry; answers its index, or -1 when they are full.")
  (let [^I32 n (cells-at cx C_OXN)]
    (if (>= n MAX_ENT)
      (do (pc-warn-set cx W_OPERANDS)
          (return -1)))
    (cells-set ox (* n 4) kind)
    (cells-set ox (+ (* n 4) 1) a1)
    (cells-set ox (+ (* n 4) 2) a2)
    (cells-set ox (+ (* n 4) 3) a3)
    (cells-set cx C_OXN (+ n 1))
    (return n)))

(defn ^I32 pc-ox-clear [^:mut ^Cells cx ^:mut ^Cells ox]
  (cells-drop ox OX_BASE)
  (cells-set cx C_OXN 0)
  (cells-set cx C_CDEPTH 0)
  (return 0))

(defn ^I32 pc-kind [^Cells ox ^I32 i] (return (cells-at ox (* i 4))))
(defn ^I32 pc-ea [^Cells ox ^I32 i] (return (cells-at ox (+ (* i 4) 1))))
(defn ^I32 pc-eb [^Cells ox ^I32 i] (return (cells-at ox (+ (* i 4) 2))))

(defn ^I64 pc-num [^Cells ox ^I32 n ^I32 i]
  (comment "Operand i as an Fx, 0 when it is absent or not a number.")
  (if (>= i n) (return (i64 0)))
  (if (!= (pc-kind ox i) K_NUM) (return (i64 0)))
  (return (fx-join (pc-ea ox i) (pc-eb ox i))))

(defn ^I32 pc-esize [^Cells ox ^I32 i]
  (comment "Entries taken by operand i and everything inside it.")
  (let [^I32 k (pc-kind ox i)]
    (if (or (== k K_ARR) (== k K_DICT))
      (return (+ 1 (pc-ea ox i))))
    (return 1)))

(defn ^I32 pc-name-eq [^Cells ox ^I32 start ^I32 ln ^I32 id]
  (comment "1 when the bytes ox[start, start+ln) are the name with `emon.pdfnames` id.")
  (let [^I32 s (pn-span-at 0 id 0)
        ^:mut ^I32 k 0]
    (if (!= (pn-span-at 0 id 1) ln) (return 0))
    (while (< k ln)
      (do (if (!= (cells-at ox (+ start k)) (pn-chars-at 0 (+ s k)))
            (return 0))
          (set k (+ k 1))))
    (return 1)))

(defn ^I32 pc-entry-name-is [^Cells ox ^I32 i ^I32 id]
  (comment "1 when operand i is the name with `emon.pdfnames` id `id`.")
  (let [^I32 s (pc-ea ox i)
        ^I32 ln (pc-eb ox i)]
    (if (!= (pc-kind ox i) K_NAME) (return 0))
    (return (pc-name-eq ox s ln id))))

;; ----------------------------------------------------------------- the lexer
;; The content stream is bytes in `cs`, one per cell. `pc-lex` reads ONE token:
;; 0 at the end, 1 when it pushed an operand (containers included, tracked so
;; that their entry counts are right), 2 when it read an operator, whose code
;; (up to three characters, the first in the low byte) is in C_OP.

(defn ^I32 pc-skip [^Cells cs ^I32 pos ^I32 end]
  (comment "Past white space and comments.")
  (let [^:mut ^I32 p pos
        ^:mut ^I32 c 0]
    (while (< p end)
      (do (set c (cells-at cs p))
          (if (== (pc-ws c) 1)
            (set p (+ p 1))
            (if (== c 37)
              (while (and (< p end) (and (!= (cells-at cs p) 10) (!= (cells-at cs p) 13)))
                (set p (+ p 1)))
              (return p)))))
    (return p)))

(defn ^I32 pc-lex-number [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^I32 s ^I32 end]
  (comment "A number at s as an operand; its end, or -1 when it is not one. As")
  (comment "`emon.pdflex` does: several signs are one, `.5` and `5.` are numbers, and a")
  (comment "run of digits too long for nine significant places saturates.")
  (let [^:mut ^I32 q s
        ^:mut ^I32 neg 0
        ^:mut ^I32 mant 0
        ^:mut ^I32 scale 0
        ^:mut ^I32 nd 0
        ^:mut ^I32 dot 0
        ^:mut ^I32 big 0
        ^:mut ^I32 d 0
        ^:mut ^I64 v (i64 0)]
    (while (and (< q end) (or (== (cells-at cs q) 43) (== (cells-at cs q) 45)))
      (do (if (== (cells-at cs q) 45) (set neg 1))
          (set q (+ q 1))))
    (while (and (< q end) (and (>= (cells-at cs q) 48) (<= (cells-at cs q) 57)))
      (do (set d (- (cells-at cs q) 48))
          (if (<= mant 99999999)
            (set mant (+ (* mant 10) d))
            (set big 1))
          (set nd (+ nd 1))
          (set q (+ q 1))))
    (if (and (< q end) (== (cells-at cs q) 46))
      (do (set dot 1)
          (set q (+ q 1))
          (while (and (< q end) (and (>= (cells-at cs q) 48) (<= (cells-at cs q) 57)))
            (do (set d (- (cells-at cs q) 48))
                (if (and (<= mant 99999999) (and (== big 0) (< scale 9)))
                  (do (set mant (+ (* mant 10) d))
                      (set scale (+ scale 1))))
                (set nd (+ nd 1))
                (set q (+ q 1))))))
    (if (== nd 0) (return -1))
    (if (== big 1)
      (do (set mant 999999999)
          (set scale 0)))
    (set v (fx-of-real mant scale))
    (if (== neg 1) (set v (- (i64 0) v)))
    (if (== dot 1)
      (pc-ox-push cx ox K_NUM (fx-hi v) (fx-lo v) 0)
      (pc-ox-push cx ox K_NUM (fx-hi v) (fx-lo v) 1))
    (return q)))

(defn ^I32 pc-lex-name [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^I32 s ^I32 end]
  (comment "A name; s is the byte after the slash. `#xx` is a byte. Answers its end.")
  (let [^I32 start (cells-len ox)
        ^:mut ^I32 q s
        ^:mut ^I32 c 0
        ^:mut ^I32 hi 0
        ^:mut ^I32 lo 0]
    (while (and (< q end) (== (pc-reg (cells-at cs q)) 1))
      (do (set c (cells-at cs q))
          (set q (+ q 1))
          (if (and (== c 35) (< (+ q 1) end))
            (do (set hi (pc-hexval (cells-at cs q)))
                (set lo (pc-hexval (cells-at cs (+ q 1))))
                (if (and (>= hi 0) (>= lo 0))
                  (do (set c (+ (* hi 16) lo))
                      (set q (+ q 2))))))
          (cells-push ox c)))
    (pc-ox-push cx ox K_NAME start (- (cells-len ox) start) 0)
    (return q)))

(defn ^I32 pc-lex-lit [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^I32 s ^I32 end]
  (comment "A literal string; s is the byte after the `(`. Escapes, octal, line")
  (comment "continuations and nesting as `emon.pdflex`; an unterminated string runs")
  (comment "to the end of the stream. Answers its end.")
  (let [^I32 start (cells-len ox)
        ^:mut ^I32 q s
        ^:mut ^I32 depth 1
        ^:mut ^I32 c 0
        ^:mut ^I32 v 0
        ^:mut ^I32 n 0]
    (while (and (< q end) (> depth 0))
      (do (set c (cells-at cs q))
          (set q (+ q 1))
          (if (== c 92)
            (do (if (< q end)
                  (do (set c (cells-at cs q))
                      (set q (+ q 1))
                      (if (== c 110) (cells-push ox 10)
                        (if (== c 114) (cells-push ox 13)
                          (if (== c 116) (cells-push ox 9)
                            (if (== c 98) (cells-push ox 8)
                              (if (== c 102) (cells-push ox 12)
                                (if (and (>= c 48) (<= c 55))
                                  (do (set v (- c 48))
                                      (set n 1)
                                      (while (and (< n 3) (and (< q end) (and (>= (cells-at cs q) 48) (<= (cells-at cs q) 55))))
                                        (do (set v (+ (* v 8) (- (cells-at cs q) 48)))
                                            (set q (+ q 1))
                                            (set n (+ n 1))))
                                      (cells-push ox (bit-and v 255)))
                                  (if (== c 13)
                                    (if (and (< q end) (== (cells-at cs q) 10))
                                      (set q (+ q 1)))
                                    (if (== c 10)
                                      (set n 0)
                                      (cells-push ox c))))))))))))
            (if (== c 40)
              (do (set depth (+ depth 1))
                  (cells-push ox 40))
              (if (== c 41)
                (do (set depth (- depth 1))
                    (if (> depth 0) (cells-push ox 41)))
                (if (== c 13)
                  (do (if (and (< q end) (== (cells-at cs q) 10))
                        (set q (+ q 1)))
                      (cells-push ox 10))
                  (cells-push ox c)))))))
    (pc-ox-push cx ox K_STR start (- (cells-len ox) start) 0)
    (return q)))

(defn ^I32 pc-lex-hex [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^I32 s ^I32 end]
  (comment "A hex string; s is the byte after the `<`. Non-hex bytes are skipped, an")
  (comment "odd last digit is followed by 0. Answers its end.")
  (let [^I32 start (cells-len ox)
        ^:mut ^I32 q s
        ^:mut ^I32 c 0
        ^:mut ^I32 v 0
        ^:mut ^I32 half -1
        ^:mut ^I32 done 0]
    (while (and (< q end) (== done 0))
      (do (set c (cells-at cs q))
          (set q (+ q 1))
          (if (== c 62)
            (set done 1)
            (do (set v (pc-hexval c))
                (if (>= v 0)
                  (if (< half 0)
                    (set half v)
                    (do (cells-push ox (+ (* half 16) v))
                        (set half -1))))))))
    (if (>= half 0) (cells-push ox (* half 16)))
    (pc-ox-push cx ox K_STR start (- (cells-len ox) start) 0)
    (return q)))

(defn ^I32 pc-open [^:mut ^Cells cx ^:mut ^Cells ox ^I32 kind]
  (comment "An array or dictionary opens: its entry, and a note of where it is.")
  (let [^I32 idx (pc-ox-push cx ox kind 0 0 0)
        ^I32 d (cells-at cx C_CDEPTH)]
    (if (and (>= idx 0) (< d MAX_CONT))
      (do (cells-set cx (+ C_CSTACK d) idx)
          (cells-set cx C_CDEPTH (+ d 1))))
    (return 0)))

(defn ^I32 pc-close [^:mut ^Cells cx ^:mut ^Cells ox]
  (comment "A container closes: its entry learns how many entries it holds.")
  (let [^I32 d (cells-at cx C_CDEPTH)]
    (if (> d 0)
      (do (let [^I32 idx (cells-at cx (+ C_CSTACK (- d 1)))
                ^I32 n (cells-at cx C_OXN)]
            (cells-set ox (+ (* idx 4) 1) (- (- n idx) 1))
            (cells-set cx C_CDEPTH (- d 1)))))
    (return 0)))

(defn ^I32 pc-close-all [^:mut ^Cells cx ^:mut ^Cells ox]
  (comment "An operator arrived with containers still open (a missing `]`): close them.")
  (while (> (cells-at cx C_CDEPTH) 0)
    (pc-close cx ox))
  (return 0))

(defn ^I32 pc-tok [^:mut ^Cells cx ^I32 tok ^I32 p]
  (comment "Note what kind of token was read (0 nothing: junk was skipped, 1 an operand,")
  (comment "2 an operator) and answer where reading goes on.")
  (cells-set cx C_TOK tok)
  (return p))

(defn ^I32 pc-lex-one [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^I32 p ^I32 end]
  (comment "One token at p (a byte that is neither white space nor the end).")
  (let [^I32 c (cells-at cs p)
        ^:mut ^I32 q 0
        ^:mut ^I32 s0 0
        ^:mut ^I32 k 0
        ^:mut ^I32 code 0]
    (if (== c 47)
      (do (set q (pc-lex-name cx ox cs (+ p 1) end))
          (return (pc-tok cx 1 q))))
    (if (== c 40)
      (do (set q (pc-lex-lit cx ox cs (+ p 1) end))
          (return (pc-tok cx 1 q))))
    (if (== c 91)
      (do (pc-open cx ox K_ARR)
          (return (pc-tok cx 1 (+ p 1)))))
    (if (== c 93)
      (do (pc-close cx ox)
          (return (pc-tok cx 1 (+ p 1)))))
    (if (== c 60)
      (do (if (and (< (+ p 1) end) (== (cells-at cs (+ p 1)) 60))
            (do (pc-open cx ox K_DICT)
                (return (pc-tok cx 1 (+ p 2)))))
          (set q (pc-lex-hex cx ox cs (+ p 1) end))
          (return (pc-tok cx 1 q))))
    (if (== c 62)
      (do (if (and (< (+ p 1) end) (== (cells-at cs (+ p 1)) 62))
            (do (pc-close cx ox)
                (return (pc-tok cx 1 (+ p 2)))))
          (return (pc-tok cx 0 (+ p 1)))))
    (if (or (== c 41) (or (== c 123) (== c 125)))
      (return (pc-tok cx 0 (+ p 1))))
    (if (or (or (== c 43) (== c 45)) (or (== c 46) (and (>= c 48) (<= c 57))))
      (do (set q (pc-lex-number cx ox cs p end))
          (if (>= q 0)
            (return (pc-tok cx 1 q)))))
    (comment "A keyword: the run of regular characters.")
    (set s0 p)
    (set q p)
    (while (and (< q end) (== (pc-reg (cells-at cs q)) 1))
      (set q (+ q 1)))
    (set k (- q s0))
    (if (<= k 3)
      (do (set code (cells-at cs s0))
          (if (>= k 2) (set code (+ code (* (cells-at cs (+ s0 1)) 256))))
          (if (>= k 3) (set code (+ code (* (cells-at cs (+ s0 2)) 65536))))))
    (comment "true, false and null are operands.")
    (if (and (== k 4) (and (== (cells-at cs s0) 116) (== (cells-at cs (+ s0 1)) 114)))
      (do (pc-ox-push cx ox K_BOOL 1 0 0)
          (return (pc-tok cx 1 q))))
    (if (and (== k 5) (== (cells-at cs s0) 102))
      (do (pc-ox-push cx ox K_BOOL 0 0 0)
          (return (pc-tok cx 1 q))))
    (if (and (== k 4) (== (cells-at cs s0) 110))
      (do (pc-ox-push cx ox K_BOOL 0 0 0)
          (return (pc-tok cx 1 q))))
    (pc-close-all cx ox)
    (cells-set cx C_OP code)
    (return (pc-tok cx 2 q))))

(defn ^I32 pc-lex [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs]
  (comment "Read tokens until one is an operand or an operator: 0 at the end of the")
  (comment "stream, 1 when an operand was pushed, 2 when an operator was read (its code,")
  (comment "up to three characters, the first in the low byte, is in C_OP).")
  (let [^I32 end (cells-at cx C_END)
        ^:mut ^I32 p (pc-skip cs (cells-at cx C_POS) end)
        ^:mut ^I32 tok 0]
    (while (and (< p end) (== tok 0))
      (do (set p (pc-lex-one cx ox cs p end))
          (set tok (cells-at cx C_TOK))
          (if (== tok 0)
            (set p (pc-skip cs p end)))))
    (cells-set cx C_POS p)
    (return tok)))

;; ------------------------------------------------------------ initialization

(defn ^:pub ^I32 pc-init [^:mut ^Cells cx ^:mut ^Cells ox]
  (comment "Empty the interpreter for a new document: zeroed cells, no fonts known.")
  (let [^:mut ^I32 i 0]
    (cells-drop cx 0)
    (while (< i C_SIZE)
      (do (cells-push cx 0)
          (set i (+ i 1))))
    (cells-drop ox 0)
    (set i 0)
    (while (< i OX_BASE)
      (do (cells-push ox 0)
          (set i (+ i 1))))
    (cells-set cx C_OPLIM (limit-of 5))
    (cells-set cx C_FLIM (limit-of 6))
    (cells-set cx C_FIDLIM (limit-of 14))
    (cells-set cx C_MCTOP -1)
    (return 0)))

(defn ^I32 pc-gs-reset [^:mut ^Cells cx]
  (comment "The initial graphics state: the base matrix, black, opaque, no font.")
  (mx-copy cx (+ C_CUR G_CTM) C_BASE)
  (fx-put cx (+ C_CUR G_TC) (i64 0))
  (fx-put cx (+ C_CUR G_TW) (i64 0))
  (fx-put cx (+ C_CUR G_TH) (fx-one))
  (fx-put cx (+ C_CUR G_TL) (i64 0))
  (fx-put cx (+ C_CUR G_RISE) (i64 0))
  (fx-put cx (+ C_CUR G_FS) (i64 0))
  (cells-set cx (+ C_CUR G_MODE) 0)
  (cells-set cx (+ C_CUR G_FONT) 0)
  (cells-set cx (+ C_CUR G_COLOR) 0)
  (cells-set cx (+ C_CUR G_ALPHA) 1000)
  (cells-set cx (+ C_CUR G_FAM) 1)
  (cells-set cx (+ C_CUR G_SCOLOR) 0)
  (cells-set cx (+ C_CUR G_SALPHA) 1000)
  (cells-set cx (+ C_CUR G_FCS) -1)
  (cells-set cx (+ C_CUR G_SCS) -1)
  (cells-set cx (+ C_CUR G_SFAM) 1)
  (cells-set cx (+ C_CUR G_CLIP) -1)
  (cells-set cx (+ C_CUR G_BM) 0)
  (cells-set cx (+ C_CUR G_SMASK) 0)
  (fx-put cx (+ C_CUR G_LW) (fx-one))
  (cells-set cx (+ C_CUR G_DASH) 0)
  (return 0))

(defn ^I32 pc-base-matrix [^:mut ^Cells cx ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 rot]
  (comment "The matrix from user space (points) to page space (centipoints, y down,")
  (comment "the crop box's corner at the origin, /Rotate applied). x0..y1 are the crop")
  (comment "box in centipoints.")
  (let [^I64 h (i64 1677721600)
        ^I64 nh (i64 -1677721600)]
    (if (== rot 90)
      (mx-set cx C_BASE (i64 0) h h (i64 0) (fx-of-int (- 0 y0)) (fx-of-int (- 0 x0))))
    (if (== rot 180)
      (mx-set cx C_BASE nh (i64 0) (i64 0) h (fx-of-int x1) (fx-of-int (- 0 y0))))
    (if (== rot 270)
      (mx-set cx C_BASE (i64 0) nh nh (i64 0) (fx-of-int y1) (fx-of-int x1)))
    (if (and (!= rot 90) (and (!= rot 180) (!= rot 270)))
      (mx-set cx C_BASE h (i64 0) (i64 0) nh (fx-of-int (- 0 x0)) (fx-of-int y1)))
    (return 0)))

;; ----------------------------------------------------- the graphics-state stack

(defn ^I32 pc-save [^:mut ^Cells cx]
  (let [^I32 d (cells-at cx C_DEPTH)]
    (if (>= d MAX_GS)
      (do (pc-warn-set cx W_STATES)
          (return 0)))
    (pc-copy-cells cx (+ C_STACK (* d GS_STRIDE)) C_CUR GS_STRIDE)
    (cells-set cx C_DEPTH (+ d 1))
    (return 1)))

(defn ^I32 pc-restore [^:mut ^Cells cx]
  (comment "Q: pops only what this stream pushed.")
  (let [^I32 d (cells-at cx C_DEPTH)
        ^I32 base (cells-at cx C_GSBASE)]
    (if (<= d base)
      (do (pc-warn-set cx W_STATES)
          (return 0)))
    (pc-copy-cells cx C_CUR (+ C_STACK (* (- d 1) GS_STRIDE)) GS_STRIDE)
    (cells-set cx C_DEPTH (- d 1))
    (return 1)))

;; ------------------------------------------------------------- the text state

(defn ^I32 pc-update-m [^:mut ^Cells cx]
  (comment "M = Tm x CTM, the matrix from text space to page space.")
  (mx-mul cx C_M C_TM (+ C_CUR G_CTM))
  (return 0))

(defn ^I32 pc-advance [^:mut ^Cells cx ^I64 dx ^I64 dy]
  (comment "Move the text position by (dx, dy) in TEXT space: Tm and M both translate")
  (comment "by the vector through their own linear parts.")
  (let [^I64 ta (fx-get cx C_TM)
        ^I64 tb (fx-get cx (+ C_TM 2))
        ^I64 tc (fx-get cx (+ C_TM 4))
        ^I64 td (fx-get cx (+ C_TM 6))
        ^I64 te (fx-get cx (+ C_TM 8))
        ^I64 tf (fx-get cx (+ C_TM 10))
        ^I64 ma (fx-get cx C_M)
        ^I64 mb (fx-get cx (+ C_M 2))
        ^I64 mc (fx-get cx (+ C_M 4))
        ^I64 md (fx-get cx (+ C_M 6))
        ^I64 me (fx-get cx (+ C_M 8))
        ^I64 mf (fx-get cx (+ C_M 10))]
    (fx-put cx (+ C_TM 8) (fx-clamp (add64 te (add64 (fx-mul dx ta) (fx-mul dy tc)))))
    (fx-put cx (+ C_TM 10) (fx-clamp (add64 tf (add64 (fx-mul dx tb) (fx-mul dy td)))))
    (fx-put cx (+ C_M 8) (fx-clamp (add64 me (add64 (fx-mul dx ma) (fx-mul dy mc)))))
    (fx-put cx (+ C_M 10) (fx-clamp (add64 mf (add64 (fx-mul dx mb) (fx-mul dy md)))))
    (return 0)))

(defn ^I32 pc-td [^:mut ^Cells cx ^I64 tx ^I64 ty]
  (comment "Td: the line matrix moves by (tx, ty) in its own space; the text matrix")
  (comment "starts over there.")
  (mx-translate cx C_TMP tx ty)
  (mx-mul cx C_TLM C_TMP C_TLM)
  (mx-copy cx C_TM C_TLM)
  (return 0))

(defn ^I32 pc-set-tm [^:mut ^Cells cx ^I64 a ^I64 b ^I64 c ^I64 d ^I64 e ^I64 f]
  (mx-set cx C_TM a b c d e f)
  (mx-copy cx C_TLM C_TM)
  (return 0))

(defn ^I32 pc-next-line [^:mut ^Cells cx]
  (comment "T*: down by the leading.")
  (let [^I64 tl (fx-get cx (+ C_CUR G_TL))]
    (pc-td cx (i64 0) (- (i64 0) tl))
    (return 0)))

;; ------------------------------------------------------------ colour bytes

(defn ^I32 pc-byte [^I64 v]
  (comment "A colour component in 0..1 (an Fx) as 0..255, rounded.")
  (let [^I32 n (fx-round (fx-mul v (fx-of-int 255)))]
    (if (< n 0) (return 0))
    (if (> n 255) (return 255))
    (return n)))

(defn ^I32 pc-rgb [^I32 r ^I32 g ^I32 bl]
  (return (+ (* r 65536) (+ (* g 256) bl))))

;; --------------------------------------------------- resources and dictionaries

(defn ^I32 pc-dict-lookup [^Cells ar ^I32 dict ^Cells ox ^I32 ns ^I32 nl]
  (comment "The value (unresolved) under the key spelled ox[ns, ns+nl), or 0. The")
  (comment "last of a repeated key wins.")
  (let [^:mut ^I32 k (pl-first ar dict)
        ^:mut ^I32 v 0
        ^:mut ^I32 found 0
        ^:mut ^I32 same 0
        ^:mut ^I32 i 0]
    (if (!= (pl-kind-of ar dict) 7) (return 0))
    (while (!= k 0)
      (do (set v (pl-next ar k))
          (if (and (== (pl-kind-of ar k) 4) (== (pl-name-len ar k) nl))
            (do (set same 1)
                (set i 0)
                (while (and (== same 1) (< i nl))
                  (do (if (!= (pl-name-byte ar k i) (cells-at ox (+ ns i)))
                        (set same 0))
                      (set i (+ i 1))))
                (if (== same 1) (set found v))))
          (if (== v 0)
            (set k 0)
            (set k (pl-next ar v)))))
    (return found)))

(defn ^I32 pc-res-entry [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                         ^:mut ^Cells b ^:mut ^Cells st ^Cells cx ^Cells ox
                         ^I32 kind-id ^I32 ei]
  (comment "The UNRESOLVED entry named by operand ei (a name) in the current Resources'")
  (comment "sub-dictionary `kind-id` (`(pn-font)`, `(pn-x-object)`, ...), 0 when none.")
  (let [^I32 res (cells-at cx C_RES)
        ^I32 ns (pc-ea ox ei)
        ^I32 nl (pc-eb ox ei)]
    (if (== res 0) (return 0))
    (let [^I32 sub (pd-dget src ar dc a b st res kind-id)]
      (if (== sub 0) (return 0))
      (return (pc-dict-lookup ar sub ox ns nl)))))

;; ---------------------------------------------------------------------- fonts

(defn ^I32 pc-f-load [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                      ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells out
                      ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                      ^I32 slot ^I32 fh]
  (if (== slot 0) (return (pfn-load src ar dc a b st f0 out fh)))
  (if (== slot 1) (return (pfn-load src ar dc a b st f1 out fh)))
  (if (== slot 2) (return (pfn-load src ar dc a b st f2 out fh)))
  (return (pfn-load src ar dc a b st f3 out fh)))

(defn ^I32 pc-f-q [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot ^I32 which]
  (comment "A font's metric: which 0 ascent, 1 descent, 2 vertical, 3 DW2 v, 4 DW2 w.")
  (if (== slot 0)
    (do (if (== which 0) (return (pfn-ascent f0)))
        (if (== which 1) (return (pfn-descent f0)))
        (if (== which 2) (return (pfn-vertical f0)))
        (if (== which 3) (return (pfn-dw2-v f0)))
        (return (pfn-dw2-w f0))))
  (if (== slot 1)
    (do (if (== which 0) (return (pfn-ascent f1)))
        (if (== which 1) (return (pfn-descent f1)))
        (if (== which 2) (return (pfn-vertical f1)))
        (if (== which 3) (return (pfn-dw2-v f1)))
        (return (pfn-dw2-w f1))))
  (if (== slot 2)
    (do (if (== which 0) (return (pfn-ascent f2)))
        (if (== which 1) (return (pfn-descent f2)))
        (if (== which 2) (return (pfn-vertical f2)))
        (if (== which 3) (return (pfn-dw2-v f2)))
        (return (pfn-dw2-w f2))))
  (if (== which 0) (return (pfn-ascent f3)))
  (if (== which 1) (return (pfn-descent f3)))
  (if (== which 2) (return (pfn-vertical f3)))
  (if (== which 3) (return (pfn-dw2-v f3)))
  (return (pfn-dw2-w f3)))

(defn ^I32 pc-f-code-len [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot
                          ^I32 b0 ^I32 b1 ^I32 b2 ^I32 b3]
  (if (== slot 0) (return (pfn-code-len f0 b0 b1 b2 b3)))
  (if (== slot 1) (return (pfn-code-len f1 b0 b1 b2 b3)))
  (if (== slot 2) (return (pfn-code-len f2 b0 b1 b2 b3)))
  (return (pfn-code-len f3 b0 b1 b2 b3)))

(defn ^I32 pc-f-map [^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                     ^I32 slot ^I32 code]
  (comment "The code points of a code: their count (`pfn-map`).")
  (if (== slot 0) (return (pfn-map f0 code)))
  (if (== slot 1) (return (pfn-map f1 code)))
  (if (== slot 2) (return (pfn-map f2 code)))
  (return (pfn-map f3 code)))

(defn ^I32 pc-f-cp [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot ^I32 i]
  (if (== slot 0) (return (pfn-cp f0 i)))
  (if (== slot 1) (return (pfn-cp f1 i)))
  (if (== slot 2) (return (pfn-cp f2 i)))
  (return (pfn-cp f3 i)))

(defn ^I32 pc-f-how [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot]
  (if (== slot 0) (return (pfn-how-of f0)))
  (if (== slot 1) (return (pfn-how-of f1)))
  (if (== slot 2) (return (pfn-how-of f2)))
  (return (pfn-how-of f3)))

(defn ^I32 pc-f-width [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot ^I32 code]
  (if (== slot 0) (return (pfn-width f0 code)))
  (if (== slot 1) (return (pfn-width f1 code)))
  (if (== slot 2) (return (pfn-width f2 code)))
  (return (pfn-width f3 code)))

(defn ^I32 pc-f-r [^Cells f0 ^Cells f1 ^Cells f2 ^Cells f3 ^I32 slot ^I32 which]
  (comment "A font's descriptor facts for the `fonts` row: which 0 subtype, 1 /Flags, 2 has a ToUnicode,")
  (comment "3 base encoding, 4 kind (1 simple).")
  (if (== slot 0)
    (do (if (== which 0) (return (pfn-subtype f0)))
        (if (== which 1) (return (pfn-flags f0)))
        (if (== which 2) (return (pfn-has-tounicode f0)))
        (if (== which 3) (return (pfn-encoding f0)))
        (return (pfn-kind-of f0))))
  (if (== slot 1)
    (do (if (== which 0) (return (pfn-subtype f1)))
        (if (== which 1) (return (pfn-flags f1)))
        (if (== which 2) (return (pfn-has-tounicode f1)))
        (if (== which 3) (return (pfn-encoding f1)))
        (return (pfn-kind-of f1))))
  (if (== slot 2)
    (do (if (== which 0) (return (pfn-subtype f2)))
        (if (== which 1) (return (pfn-flags f2)))
        (if (== which 2) (return (pfn-has-tounicode f2)))
        (if (== which 3) (return (pfn-encoding f2)))
        (return (pfn-kind-of f2))))
  (if (== which 0) (return (pfn-subtype f3)))
  (if (== which 1) (return (pfn-flags f3)))
  (if (== which 2) (return (pfn-has-tounicode f3)))
  (if (== which 3) (return (pfn-encoding f3)))
  (return (pfn-kind-of f3)))

(defn ^I32 pc-name-find [^Cells ar ^I32 nh ^I32 n ^I32 c0 ^I32 c1 ^I32 c2 ^I32 c3 ^I32 c4 ^I32 c5 ^I32 c6]
  (comment "1 when the name nh contains the n (1..7) characters c0.. in a row.")
  (let [^I32 ln (pl-name-len ar nh)
        ^:mut ^I32 i 0
        ^:mut ^I32 ok 1]
    (while (<= (+ i n) ln)
      (do (set ok 1)
          (if (!= (pl-name-byte ar nh i) c0) (set ok 0))
          (if (and (> n 1) (!= (pl-name-byte ar nh (+ i 1)) c1)) (set ok 0))
          (if (and (> n 2) (!= (pl-name-byte ar nh (+ i 2)) c2)) (set ok 0))
          (if (and (> n 3) (!= (pl-name-byte ar nh (+ i 3)) c3)) (set ok 0))
          (if (and (> n 4) (!= (pl-name-byte ar nh (+ i 4)) c4)) (set ok 0))
          (if (and (> n 5) (!= (pl-name-byte ar nh (+ i 5)) c5)) (set ok 0))
          (if (and (> n 6) (!= (pl-name-byte ar nh (+ i 6)) c6)) (set ok 0))
          (if (== ok 1) (return 1))
          (set i (+ i 1))))
    (return 0)))

(defn ^I32 pc-font-row [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                        ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx
                        ^:mut ^Cells fnt ^:mut ^Cells et
                        ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                        ^I32 slot ^I32 status ^I32 key]
  (comment "The `fonts` row of a font the document shows for the first time (its row is its id): object")
  (comment "number, subtype, /Flags, whether it has a ToUnicode, base encoding, /BaseFont, ascent, descent,")
  (comment "the width of a space (simple fonts), and a style from the flags and the name. P1.6 reads no")
  (comment "font programs, /ItalicAngle or /StemV (`pdfnames` has no such names): program 0, italic angle 0,")
  (comment "stem -1. A font that would not load has subtype 0 and no metrics.")
  (let [^I32 row (fo-new fnt (cells-at cx (+ C_CUR G_FOBJ)) 0)
        ^I32 nh (pd-dget src ar dc a b st key (pn-base-font))
        ^:mut ^I32 flags 0
        ^:mut ^I32 sty 0
        ^:mut ^I32 i 0
        ^:mut ^I32 start 0
        ^:mut ^I32 ln 0]
    (if (== status 0)
      (do (fo-set fnt row (fnf-subtype) (pc-f-r f0 f1 f2 f3 slot 0))
          (set flags (pc-f-r f0 f1 f2 f3 slot 1))
          (fo-set fnt row (fnf-flags) flags)
          (fo-set fnt row (fnf-tounicode) (pc-f-r f0 f1 f2 f3 slot 2))
          (fo-set fnt row (fnf-enc) (pc-f-r f0 f1 f2 f3 slot 3))
          (fo-set fnt row (fnf-asc) (pc-f-q f0 f1 f2 f3 slot 0))
          (fo-set fnt row (fnf-desc) (pc-f-q f0 f1 f2 f3 slot 1))
          (if (== (pc-f-r f0 f1 f2 f3 slot 4) 1)
            (fo-set fnt row (fnf-space) (pc-f-width f0 f1 f2 f3 slot 32)))))
    (if (and (!= nh 0) (== (pl-kind-of ar nh) 4))
      (do (set ln (pl-name-len ar nh))
          (set start (cells-len et))
          (while (< i ln)
            (do (etx-append-cp et (pl-name-byte ar nh i))
                (set i (+ i 1))))
          (fo-set fnt row (fnf-tstart) start)
          (fo-set fnt row (fnf-tlen) ln)
          (if (== (pc-name-find ar nh 4 66 111 108 100 0 0 0) 1) (set sty (bit-or sty (sy-bold))))
          (if (== (pc-name-find ar nh 6 73 116 97 108 105 99 0) 1) (set sty (bit-or sty (sy-italic))))
          (if (== (pc-name-find ar nh 7 79 98 108 105 113 117 101) 1) (set sty (bit-or sty (sy-italic))))))
    (if (!= (bit-and flags 1) 0) (set sty (bit-or sty (sy-mono))))
    (if (!= (bit-and flags 64) 0) (set sty (bit-or sty (sy-italic))))
    (if (!= (bit-and flags 131072) 0) (set sty (bit-or sty (sy-smallcaps))))
    (if (!= (bit-and flags 262144) 0) (set sty (bit-or sty (sy-bold))))
    (fo-set fnt row (fnf-style) sty)
    (return row)))

(defn ^I32 pc-font-id [^:mut ^Cells cx ^I32 key]
  (comment "The evidence id of a font dictionary: its index in the order the")
  (comment "document first showed it. THE BUDGET `fonts-per-doc` (kind 14, at most MAX_FIDS = 512): the font past it has no id, -1, which is the")
  (comment "evidence's 'no font' (its glyphs carry -1 and it has no `fonts` row); the text is still read in the font's own encoding, and the page")
  (comment "that shows it is flagged (W_FONTS). The same on every host, since the decision is made here.")
  (let [^I32 n (cells-at cx C_NFONT)
        ^:mut ^I32 i 0]
    (while (< i n)
      (do (if (== (cells-at cx (+ C_FIDS i)) key) (return i))
          (set i (+ i 1))))
    (if (>= n (cells-at cx C_FIDLIM)) (return -1))
    (cells-set cx (+ C_FIDS n) key)
    (cells-set cx C_NFONT (+ n 1))
    (return n)))

(defn ^I32 pc-ensure-font [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                           ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx
                           ^:mut ^Cells out
                           ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                           ^:mut ^Cells fnt ^:mut ^Cells et]
  (comment "Make the current font (the graphics state's) resident in a slot and set")
  (comment "C_SLOT to it, -1 when there is none. A font is loaded once and kept; the")
  (comment "slot that has gone unused longest is the one replaced.")
  (let [^I32 key (cells-at cx (+ C_CUR G_FONT))
        ^:mut ^I32 i 0
        ^:mut ^I32 at 0
        ^:mut ^I32 pick 0
        ^:mut ^I32 best 2147483647
        ^:mut ^I32 status 0
        ^:mut ^I32 fid 0
        ^I32 nbefore (cells-at cx C_NFONT)
        ^:mut ^I32 clock (cells-at cx C_CLOCK)]
    (if (== key 0)
      (do (cells-set cx C_SLOT -1)
          (return 0)))
    (set clock (+ clock 1))
    (cells-set cx C_CLOCK clock)
    (while (< i 4)
      (do (set at (+ C_SLOTS (* i SLOT_STRIDE)))
          (if (== (cells-at cx (+ at S_KEY)) key)
            (do (cells-set cx (+ at S_USE) clock)
                (cells-set cx C_SLOT i)
                (return 0)))
          (if (< (cells-at cx (+ at S_USE)) best)
            (do (set best (cells-at cx (+ at S_USE)))
                (set pick i)))
          (set i (+ i 1))))
    (set at (+ C_SLOTS (* pick SLOT_STRIDE)))
    (set status (pc-f-load src ar dc a b st out f0 f1 f2 f3 pick key))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (cells-set cx (+ at S_KEY) 0)
          (cells-set cx C_SLOT -1)
          (return 0)))
    (cells-set cx (+ at S_KEY) key)
    (cells-set cx (+ at S_USE) clock)
    (cells-set cx (+ at S_STATUS) status)
    (set fid (pc-font-id cx key))
    (cells-set cx (+ at S_ID) fid)
    (comment "A font the document has not shown before gets its `fonts` row, which is its id.")
    (if (and (>= fid 0) (== fid nbefore))
      (pc-font-row src ar dc a b st cx fnt et f0 f1 f2 f3 pick status key))
    (if (== status 0)
      (do (cells-set cx (+ at S_ASC) (pc-f-q f0 f1 f2 f3 pick 0))
          (cells-set cx (+ at S_DESC) (pc-f-q f0 f1 f2 f3 pick 1))
          (cells-set cx (+ at S_VERT) (pc-f-q f0 f1 f2 f3 pick 2))
          (cells-set cx (+ at S_DW2V) (pc-f-q f0 f1 f2 f3 pick 3))
          (cells-set cx (+ at S_DW2W) (pc-f-q f0 f1 f2 f3 pick 4)))
      (do (cells-set cx (+ at S_ASC) 0)
          (cells-set cx (+ at S_DESC) 0)
          (cells-set cx (+ at S_VERT) 0)))
    (cells-set cx C_SLOT pick)
    (if (ps-missed src) (cells-set cx C_ABORT 1))
    (return 0)))

(defn ^I32 pc-tf [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                  ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^Cells ox ^I32 n]
  (comment "Tf: the font named by operand 0 from the current Resources, at the size of")
  (comment "operand 1. The dictionary is resolved here and loaded at the first glyph.")
  (let [^I64 size (pc-num ox n 1)
        ^:mut ^I32 fh 0
        ^:mut ^I32 raw 0]
    (fx-put cx (+ C_CUR G_FS) size)
    (if (and (>= n 1) (== (pc-kind ox 0) K_NAME))
      (do (set raw (pc-res-entry src ar dc a b st cx ox (pn-font) 0))
          (if (!= raw 0)
            (set fh (pd-resolve src ar dc a b st raw)))))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (== fh 0)
      (pc-warn-set cx W_FONT)
      (if (!= (pl-kind-of ar fh) 7)
        (do (set fh 0)
            (pc-warn-set cx W_FONT))))
    (cells-set cx (+ C_CUR G_FONT) fh)
    (cells-set cx (+ C_CUR G_FOBJ) 0)
    (if (and (!= fh 0) (!= raw 0))
      (if (== (pl-kind-of ar raw) 9)
        (cells-set cx (+ C_CUR G_FOBJ) (pl-int-value ar raw))))
    (return 0)))

;; ------------------------------------------------------------------- glyphs

(defn ^I64 pc-min4 [^I64 p ^I64 q ^I64 r ^I64 s]
  (let [^:mut ^I64 m p]
    (if (< q m) (set m q))
    (if (< r m) (set m r))
    (if (< s m) (set m s))
    (return m)))

(defn ^I64 pc-max4 [^I64 p ^I64 q ^I64 r ^I64 s]
  (let [^:mut ^I64 m p]
    (if (> q m) (set m q))
    (if (> r m) (set m r))
    (if (> s m) (set m s))
    (return m)))

(defn ^I32 pc-dir-angle [^I64 a ^I64 b]
  (comment "The angle of the direction (a, b) in page space (y down), by `ev-angle`: halve both until the")
  (comment "larger fits 30 bits, so the angle of a matrix axis in 24-bit fixed point keeps all its precision.")
  (let [^:mut ^I64 x a
        ^:mut ^I64 y b
        ^:mut ^I64 m (i64 0)]
    (if (< x (i64 0)) (set m (- (i64 0) x)) (set m x))
    (if (< y (i64 0))
      (if (> (- (i64 0) y) m) (set m (- (i64 0) y)))
      (if (> y m) (set m y)))
    (while (> m (i64 1073741824))
      (do (set x (quot x (i64 2)))
          (set y (quot y (i64 2)))
          (set m (quot m (i64 2)))))
    (return (ev-angle (i32 x) (i32 y)))))

(defn ^I32 pc-glyph [^:mut ^Cells cx ^:mut ^Cells gl ^:mut ^Cells et
                     ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                     ^I32 code ^I32 ncode]
  (comment "One shown glyph: look the code up, put its cell in page space, record it,")
  (comment "advance the text position by its width, the character and word spacing.")
  (comment "Recorded (SPEC 8.4.3): the box of its cell; its baseline segment from its origin to its origin plus")
  (comment "its advance without Tc and Tw (text space +x, so the spacing stays measurable); `asc` and `desc`")
  (comment "(signed distances from the baseline along the up vector, from the font's ascent and descent); `rot`")
  (comment "by `ev-angle` from the exact direction of the text matrix's x axis; its fill colour and alpha; the")
  (comment "colour-space class when the colour operators said (gray, rgb, cmyk); `z`, the page's paint counter;")
  (comment "`mark` (the innermost open mark) and `ocg` (the innermost optional-content mark).")
  (let [^I32 slot (cells-at cx C_SLOT)
        ^I64 fs (fx-get cx (+ C_CUR G_FS))
        ^I64 th (fx-get cx (+ C_CUR G_TH))
        ^I64 tc (fx-get cx (+ C_CUR G_TC))
        ^I64 tw (fx-get cx (+ C_CUR G_TW))
        ^I64 rise (fx-get cx (+ C_CUR G_RISE))
        ^:mut ^I32 sat 0
        ^:mut ^I32 cnt 0
        ^:mut ^I32 cp0 -1
        ^:mut ^I32 how 5
        ^:mut ^I32 w -1
        ^:mut ^I32 asc 0
        ^:mut ^I32 desc 0
        ^:mut ^I32 vert 0
        ^:mut ^I32 dwv -100000
        ^:mut ^I32 fid -1
        ^:mut ^I32 tstart -1
        ^:mut ^I32 i 0
        ^:mut ^I32 vch 0
        ^:mut ^I32 idx 0]
    (if (>= slot 0)
      (do (set sat (+ C_SLOTS (* slot SLOT_STRIDE)))
          (set fid (cells-at cx (+ sat S_ID)))
          (if (< fid 0) (pc-warn-set cx W_FONTS))
          (if (== (cells-at cx (+ sat S_STATUS)) 0)
            (do (set cnt (pc-f-map f0 f1 f2 f3 slot code))
                (set how (pc-f-how f0 f1 f2 f3 slot))
                (set w (pc-f-width f0 f1 f2 f3 slot code))
                (set asc (cells-at cx (+ sat S_ASC)))
                (set desc (cells-at cx (+ sat S_DESC)))
                (set vert (cells-at cx (+ sat S_VERT)))
                (set dwv (cells-at cx (+ sat S_DW2W)))))))
    (if (> cnt 0) (set cp0 (pc-f-cp f0 f1 f2 f3 slot 0)))
    (comment "A composite font's ToUnicode may say U+0000 or U+FFFD for a glyph it has no value")
    (comment "for (Skia does, for the parts of a Devanagari conjunct): that is no value.")
    (if (and (== cnt 1) (or (== cp0 0) (== cp0 65533)))
      (do (set cnt 0)
          (set cp0 -1)
          (set how 5)))
    (if (< w 0)
      (do (set w 50000)
          (pc-warn-set cx W_WIDTH)))
    (if (and (== asc 0) (== desc 0))
      (do (set asc 800)
          (set desc -200)))
    (let [^I64 wfx (fx-muldiv (i64 w) fs (i64 100000))
          ^:mut ^I64 x0t (i64 0)
          ^:mut ^I64 x1t (i64 0)
          ^:mut ^I64 y0t (i64 0)
          ^:mut ^I64 y1t (i64 0)]
      (if (== vert 0)
        (do (set x1t (fx-mul wfx th))
            (set y0t (add64 (fx-muldiv (i64 desc) fs (i64 1000)) rise))
            (set y1t (add64 (fx-muldiv (i64 asc) fs (i64 1000)) rise)))
        (do (set x0t (- (i64 0) (quot wfx (i64 2))))
            (set x1t (quot wfx (i64 2)))
            (set y0t (add64 (fx-muldiv (i64 dwv) fs (i64 100000)) rise))
            (set y1t rise)))
      (let [^I64 p0x (mx-x cx C_M x0t y0t)
            ^I64 p0y (mx-y cx C_M x0t y0t)
            ^I64 p1x (mx-x cx C_M x1t y0t)
            ^I64 p1y (mx-y cx C_M x1t y0t)
            ^I64 p2x (mx-x cx C_M x0t y1t)
            ^I64 p2y (mx-y cx C_M x0t y1t)
            ^I64 p3x (mx-x cx C_M x1t y1t)
            ^I64 p3y (mx-y cx C_M x1t y1t)
            ^I64 ma (fx-get cx C_M)
            ^I64 mb (fx-get cx (+ C_M 2))
            ^I64 mc (fx-get cx (+ C_M 4))
            ^I64 md (fx-get cx (+ C_M 6))
            ^I64 hyp (fx-hypot mc md)
            ^I32 size (fx-round (fx-mul hyp (fx-abs fs)))
            ^I32 rot (pc-dir-angle ma mb)
            ^I32 bx0 (fx-round (mx-x cx C_M (i64 0) rise))
            ^I32 by0 (fx-round (mx-y cx C_M (i64 0) rise))
            ^I32 bx1 (fx-round (mx-x cx C_M (fx-mul wfx th) rise))
            ^I32 by1 (fx-round (mx-y cx C_M (fx-mul wfx th) rise))
            ^I32 up (fx-round (fx-mul (- y1t rise) hyp))
            ^I32 down (fx-round (fx-mul (- y0t rise) hyp))
            ^I32 fam (cells-at cx (+ C_CUR G_FAM))
            ^I32 z (cells-at cx C_Z)
            ^I32 g (gl-new gl (cells-at cx C_PAGE)
                           (fx-round (pc-min4 p0x p1x p2x p3x)) (fx-round (pc-min4 p0y p1y p2y p3y))
                           (fx-round (pc-max4 p0x p1x p2x p3x)) (fx-round (pc-max4 p0y p1y p2y p3y))
                           cp0 -1 0 -1)]
        (gl-set gl g (gf-how) how)
        (gl-set gl g (gf-font) fid)
        (gl-set gl g (gf-size) size)
        (gl-set gl g (gf-bx0) bx0)
        (gl-set gl g (gf-by0) by0)
        (gl-set gl g (gf-bx1) bx1)
        (gl-set gl g (gf-by1) by1)
        (if (>= up down)
          (do (gl-set gl g (gf-asc) up)
              (gl-set gl g (gf-desc) down))
          (do (gl-set gl g (gf-asc) down)
              (gl-set gl g (gf-desc) up)))
        (gl-set gl g (gf-rot) rot)
        (gl-set gl g (gf-fill) (cells-at cx (+ C_CUR G_COLOR)))
        (gl-set gl g (gf-falpha) (cells-at cx (+ C_CUR G_ALPHA)))
        (gl-set gl g (gf-stroke) (cells-at cx (+ C_CUR G_SCOLOR)))
        (gl-set gl g (gf-salpha) (cells-at cx (+ C_CUR G_SALPHA)))
        (gl-set gl g (gf-clip) (cells-at cx (+ C_CUR G_CLIP)))
        (gl-set gl g (gf-mode) (cells-at cx (+ C_CUR G_MODE)))
        (if (and (> fam 0) (!= (cells-at cx (+ C_CUR G_MODE)) 1) (!= (cells-at cx (+ C_CUR G_MODE)) 5))
          (gl-set gl g (gf-cs) fam))
        (if (and (> (cells-at cx (+ C_CUR G_SFAM)) 0) (or (== (cells-at cx (+ C_CUR G_MODE)) 1) (== (cells-at cx (+ C_CUR G_MODE)) 5)))
          (gl-set gl g (gf-cs) (cells-at cx (+ C_CUR G_SFAM))))
        (if (!= (cells-at cx (+ C_CUR G_BM)) 0) (set vch (vc-blend)))
        (if (!= (cells-at cx (+ C_CUR G_SMASK)) 0) (set vch (+ vch (vc-softmask))))
        (gl-set gl g (gf-vchk) vch)
        (if (>= (cells-at cx (+ C_CUR G_MODE)) 4)
          (do (if (== (cells-at cx C_TCN) 0)
                (do (cells-set cx C_TCX0 (gl-get gl g (ch-x0)))
                    (cells-set cx C_TCY0 (gl-get gl g (ch-y0)))
                    (cells-set cx C_TCX1 (gl-get gl g (ch-x1)))
                    (cells-set cx C_TCY1 (gl-get gl g (ch-y1))))
                (do (if (< (gl-get gl g (ch-x0)) (cells-at cx C_TCX0)) (cells-set cx C_TCX0 (gl-get gl g (ch-x0))))
                    (if (< (gl-get gl g (ch-y0)) (cells-at cx C_TCY0)) (cells-set cx C_TCY0 (gl-get gl g (ch-y0))))
                    (if (> (gl-get gl g (ch-x1)) (cells-at cx C_TCX1)) (cells-set cx C_TCX1 (gl-get gl g (ch-x1))))
                    (if (> (gl-get gl g (ch-y1)) (cells-at cx C_TCY1)) (cells-set cx C_TCY1 (gl-get gl g (ch-y1))))))
              (cells-set cx C_TCN (+ (cells-at cx C_TCN) 1))))
        (gl-set gl g (gf-z) z)
        (cells-set cx C_Z (+ z 1))
        (gl-set gl g (gf-mark) (cells-at cx C_MCTOP))
        (gl-set gl g (gf-ocg) (cells-at cx C_CUROCG))
        (if (> cnt 1)
          (do (set i 0)
              (while (< i cnt)
                (do (set idx (etx-append-cp et (pc-f-cp f0 f1 f2 f3 slot i)))
                    (if (== i 0) (set tstart idx))
                    (set i (+ i 1))))
              (gl-set gl g (ch-tstart) tstart)
              (gl-set gl g (ch-tlen) cnt))))
      (comment "The advance: tx = (w0 * Tfs + Tc + Tw) * Th, or ty = w1 * Tfs + Tc + Tw.")
      (let [^:mut ^I64 adv (i64 0)]
        (if (== vert 0)
          (set adv (add64 wfx tc))
          (set adv (add64 (fx-muldiv (i64 dwv) fs (i64 100000)) tc)))
        (if (and (== code 32) (== ncode 1))
          (set adv (add64 adv tw)))
        (if (== vert 0)
          (pc-advance cx (fx-mul adv th) (i64 0))
          (pc-advance cx (i64 0) adv))
        (return 0)))))

(defn ^I32 pc-show-str [^:mut ^Cells cx ^Cells ox ^:mut ^Cells gl ^:mut ^Cells et
                        ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                        ^I32 s]
  (comment "Show the string operand s: split it into codes by the font's codespace.")
  (let [^I32 start (pc-ea ox s)
        ^I32 ln (pc-eb ox s)
        ^I32 slot (cells-at cx C_SLOT)
        ^:mut ^I32 okfont 0
        ^:mut ^I32 i 0
        ^:mut ^I32 n 1
        ^:mut ^I32 code 0
        ^:mut ^I32 k 0
        ^:mut ^I32 b0 0
        ^:mut ^I32 b1 -1
        ^:mut ^I32 b2 -1
        ^:mut ^I32 b3 -1]
    (if (>= slot 0)
      (if (== (cells-at cx (+ (+ C_SLOTS (* slot SLOT_STRIDE)) S_STATUS)) 0)
        (set okfont 1)))
    (while (< i ln)
      (do (set b0 (cells-at ox (+ start i)))
          (set b1 -1)
          (set b2 -1)
          (set b3 -1)
          (if (< (+ i 1) ln) (set b1 (cells-at ox (+ start (+ i 1)))))
          (if (< (+ i 2) ln) (set b2 (cells-at ox (+ start (+ i 2)))))
          (if (< (+ i 3) ln) (set b3 (cells-at ox (+ start (+ i 3)))))
          (set n 1)
          (if (== okfont 1)
            (set n (pc-f-code-len f0 f1 f2 f3 slot b0 b1 b2 b3)))
          (if (< n 1) (set n 1))
          (if (> n 4) (set n 4))
          (if (> (+ i n) ln) (set n (- ln i)))
          (set code 0)
          (set k 0)
          (while (< k n)
            (do (if (and (== n 4) (and (== k 0) (>= (cells-at ox (+ start i)) 128)))
                  (set code (* (- (cells-at ox (+ start i)) 256) 16777216))
                  (set code (+ (* code 256) (cells-at ox (+ start (+ i k))))))
                (set k (+ k 1))))
          (pc-glyph cx gl et f0 f1 f2 f3 code n)
          (set i (+ i n))))
    (return 0)))

(defn ^I32 pc-show-arr [^:mut ^Cells cx ^Cells ox ^:mut ^Cells gl ^:mut ^Cells et
                        ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                        ^I32 s]
  (comment "TJ: strings and adjustments. An adjustment n moves the position by")
  (comment "-n/1000 of the font size (along x, scaled by Th; along y in vertical mode).")
  (let [^I32 cnt (pc-ea ox s)
        ^I32 slot (cells-at cx C_SLOT)
        ^I64 fs (fx-get cx (+ C_CUR G_FS))
        ^I64 th (fx-get cx (+ C_CUR G_TH))
        ^:mut ^I32 vert 0
        ^:mut ^I32 j (+ s 1)
        ^:mut ^I32 k 0
        ^:mut ^I64 delta (i64 0)]
    (if (>= slot 0)
      (set vert (cells-at cx (+ (+ C_SLOTS (* slot SLOT_STRIDE)) S_VERT))))
    (while (< j (+ (+ s 1) cnt))
      (do (set k (pc-kind ox j))
          (if (== k K_STR)
            (pc-show-str cx ox gl et f0 f1 f2 f3 j))
          (if (== k K_NUM)
            (do (set delta (- (i64 0) (fx-muldiv (fx-mul (fx-join (pc-ea ox j) (pc-eb ox j)) fs) (i64 1) (i64 1000))))
                (if (== vert 0)
                  (pc-advance cx (fx-mul delta th) (i64 0))
                  (pc-advance cx (i64 0) delta))))
          (set j (+ j (pc-esize ox j)))))
    (return 0)))

;; ------------------------------------------------------ marked content (D076)

(defdata pc-pdfdoc-tab
  :emitter kin.lang/flat-array
  :data [728 711 710 729 733 731 730 732 8226 8224 8225 8230 8212 8211 402 8260
         8249 8250 8722 8240 8222 8220 8221 8216 8217 8218 8482 64257 64258 321 338 352
         376 381 305 322 339 353 382 65533 8364]
  :accessors {^I32 pc-pdfdoc-at [^I32 ignored ^I32 i]})

(defn ^I32 pc-pdfdoc [^I32 c]
  (comment "PDFDocEncoding (Annex D.2) to Unicode: Latin-1 except 0x18-0x1F, 0x80-0xA0.")
  (if (and (>= c 24) (<= c 31)) (return (pc-pdfdoc-at 0 (- c 24))))
  (if (and (>= c 128) (<= c 160)) (return (pc-pdfdoc-at 0 (+ 8 (- c 128)))))
  (return c))

(defn ^I32 pc-push-bytes [^:mut ^Cells et ^Cells ox ^I32 start ^I32 ln]
  (comment "A name's bytes as code points (Latin-1), into the evidence text. Answers")
  (comment "the index of the first.")
  (let [^I32 at (cells-len et)
        ^:mut ^I32 k 0]
    (while (< k ln)
      (do (etx-append-cp et (cells-at ox (+ start k)))
          (set k (+ k 1))))
    (return at)))

(defn ^I32 pc-push-entry [^:mut ^Cells et ^Cells ox ^I32 i]
  (comment "The bytes of name operand i into the evidence text; the index of the first.")
  (let [^I32 s (pc-ea ox i)
        ^I32 ln (pc-eb ox i)]
    (return (pc-push-bytes et ox s ln))))

(defn ^I32 pc-push-utf16 [^:mut ^Cells et ^Cells ox ^I32 start ^I32 ln ^I32 little]
  (comment "UTF-16 text from ox[start, start+ln) (after the byte order mark), into")
  (comment "the evidence text: surrogate pairs joined, a lone surrogate U+FFFD, and")
  (comment "the language escapes of PDF 2.0 (U+001B ... U+001B) dropped.")
  (let [^:mut ^I32 k 0
        ^:mut ^I32 u 0
        ^:mut ^I32 u2 0
        ^:mut ^I32 skip 0]
    (while (< (+ k 1) ln)
      (do (if (== little 1)
            (set u (+ (cells-at ox (+ start k)) (* (cells-at ox (+ start (+ k 1))) 256)))
            (set u (+ (* (cells-at ox (+ start k)) 256) (cells-at ox (+ start (+ k 1))))))
          (set k (+ k 2))
          (if (and (>= u 55296) (<= u 56319) (< (+ k 1) ln))
            (do (if (== little 1)
                  (set u2 (+ (cells-at ox (+ start k)) (* (cells-at ox (+ start (+ k 1))) 256)))
                  (set u2 (+ (* (cells-at ox (+ start k)) 256) (cells-at ox (+ start (+ k 1))))))
                (if (and (>= u2 56320) (<= u2 57343))
                  (do (set u (+ 65536 (+ (* (- u 55296) 1024) (- u2 56320))))
                      (set k (+ k 2))))))
          (if (== u 27)
            (set skip (- 1 skip))
            (if (== skip 0)
              (etx-append-cp et u)))))
    (return 0)))

(defn ^I32 pc-push-utf8 [^:mut ^Cells et ^Cells ox ^I32 start ^I32 ln]
  (let [^:mut ^I32 k 0
        ^:mut ^I32 c 0
        ^:mut ^I32 need 0
        ^:mut ^I32 v 0
        ^:mut ^I32 j 0
        ^:mut ^I32 ok 0]
    (while (< k ln)
      (do (set c (cells-at ox (+ start k)))
          (set k (+ k 1))
          (set need 0)
          (set v c)
          (if (>= c 240) (do (set need 3) (set v (- c 240)))
            (if (>= c 224) (do (set need 2) (set v (- c 224)))
              (if (>= c 192) (do (set need 1) (set v (- c 192))))))
          (set ok 1)
          (if (and (>= c 128) (< c 192)) (set ok 0))
          (if (> c 247) (set ok 0))
          (set j 0)
          (while (and (== ok 1) (< j need))
            (do (if (and (< k ln) (and (>= (cells-at ox (+ start k)) 128) (< (cells-at ox (+ start k)) 192)))
                  (do (set v (+ (* v 64) (- (cells-at ox (+ start k)) 128)))
                      (set k (+ k 1)))
                  (set ok 0))
                (set j (+ j 1))))
          (if (== ok 1)
            (etx-append-cp et v)
            (etx-append-cp et 65533))))
    (return 0)))

(defn ^I32 pc-push-text [^:mut ^Cells et ^Cells ox ^I32 start ^I32 ln]
  (comment "A PDF text string (UTF-16BE or LE with a byte order mark, UTF-8 with its")
  (comment "BOM, else PDFDocEncoding) into the evidence text. Answers the first index.")
  (let [^I32 at (cells-len et)
        ^:mut ^I32 k 0]
    (if (and (>= ln 2) (and (== (cells-at ox start) 254) (== (cells-at ox (+ start 1)) 255)))
      (do (pc-push-utf16 et ox (+ start 2) (- ln 2) 0)
          (return at)))
    (if (and (>= ln 2) (and (== (cells-at ox start) 255) (== (cells-at ox (+ start 1)) 254)))
      (do (pc-push-utf16 et ox (+ start 2) (- ln 2) 1)
          (return at)))
    (if (and (>= ln 3) (and (== (cells-at ox start) 239) (and (== (cells-at ox (+ start 1)) 187) (== (cells-at ox (+ start 2)) 191))))
      (do (pc-push-utf8 et ox (+ start 3) (- ln 3))
          (return at)))
    (while (< k ln)
      (do (etx-append-cp et (pc-pdfdoc (cells-at ox (+ start k))))
          (set k (+ k 1))))
    (return at)))

(defn ^I64 pc-ar-fx64 [^Cells ar ^I32 h]
  (let [^I32 kind (pl-kind-of ar h)]
    (if (== kind 2) (return (fx-of-int (pl-int-value ar h))))
    (if (== kind 3) (return (fx-of-real (pl-int-value ar h) (pl-ref-gen ar h))))
    (return (i64 0))))

(defn ^I32 pc-ingest-props [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                            ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                            ^I32 dict]
  (comment "Copy the pairs of a /Properties dictionary that marked content reads")
  (comment "into the operand entries as a dictionary entry, so one reader serves an")
  (comment "inline property list and a named one. Answers the entry's index.")
  (let [^I32 d (pc-ox-push cx ox K_DICT 0 0 0)
        ^:mut ^I32 k (pl-first ar dict)
        ^:mut ^I32 v 0
        ^:mut ^I32 vr 0
        ^:mut ^I32 want 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 at 0
        ^:mut ^I32 j 0
        ^:mut ^I32 ln 0
        ^:mut ^I64 fxv (i64 0)]
    (if (< d 0) (return -1))
    (while (!= k 0)
      (do (set v (pl-next ar k))
          (set want 0)
          (if (== (pl-kind-of ar k) 4)
            (if (or (== (pl-name-is ar k (pn-mcid)) 1) (or (== (pl-name-is ar k (pn-actual-text)) 1) (or (== (pl-name-is ar k (pn-alt)) 1) (or (== (pl-name-is ar k (pn-e)) 1) (or (== (pl-name-is ar k (pn-lang)) 1) (or (== (pl-name-is ar k (pn-type)) 1) (== (pl-name-is ar k (pn-subtype)) 1)))))))
              (set want 1)))
          (if (and (== want 1) (!= v 0))
            (do (set vr (pd-resolve src ar dc a b st v))
                (set kind 0)
                (if (!= vr 0) (set kind (pl-kind-of ar vr)))
                (if (or (== kind 2) (== kind 3))
                  (do (set fxv (pc-ar-fx64 ar vr))
                      (comment "The key, then the number.")
                      (set ln (pl-name-len ar k))
                      (set at (cells-len ox))
                      (set j 0)
                      (while (< j ln)
                        (do (cells-push ox (pl-name-byte ar k j))
                            (set j (+ j 1))))
                      (pc-ox-push cx ox K_NAME at ln 0)
                      (pc-ox-push cx ox K_NUM (fx-hi fxv) (fx-lo fxv) 1)))
                (if (or (== kind 4) (== kind 5))
                  (do (set ln (pl-name-len ar k))
                      (set at (cells-len ox))
                      (set j 0)
                      (while (< j ln)
                        (do (cells-push ox (pl-name-byte ar k j))
                            (set j (+ j 1))))
                      (pc-ox-push cx ox K_NAME at ln 0)
                      (set ln (pl-str-len ar vr))
                      (set at (cells-len ox))
                      (set j 0)
                      (if (== kind 4)
                        (while (< j ln)
                          (do (cells-push ox (pl-name-byte ar vr j))
                              (set j (+ j 1))))
                        (while (< j ln)
                          (do (cells-push ox (pl-str-byte ar vr j))
                              (set j (+ j 1)))))
                      (if (== kind 4)
                        (pc-ox-push cx ox K_NAME at ln 0)
                        (pc-ox-push cx ox K_STR at ln 0))))))
          (if (== v 0)
            (set k 0)
            (set k (pl-next ar v)))))
    (cells-set ox (+ (* d 4) 1) (- (- (cells-at cx C_OXN) d) 1))
    (return d)))

(defn ^I32 pc-read-props [^:mut ^Cells et ^:mut ^Cells mk ^Cells ox ^I32 span ^I32 d ^I32 isart]
  (comment "Fill the mark's fields from the dictionary entry d of the operands: MCID, ActualText, Alt, E, Lang;")
  (comment "and, for an /Artifact, its /Type and /Subtype as codes (`ar`: pagination, layout, background, page,")
  (comment "else `other`; `as`: header, footer, watermark, else `other`). A name that is none of the known ones")
  (comment "is not kept (SPEC 8.4.3 holds codes, D101 held the name).")
  (let [^I32 end (+ (+ d 1) (pc-ea ox d))
        ^:mut ^I32 j (+ d 1)
        ^:mut ^I32 v 0
        ^:mut ^I32 ks 0
        ^:mut ^I32 kl 0
        ^:mut ^I32 vs 0
        ^:mut ^I32 vl 0
        ^:mut ^I32 vk 0
        ^:mut ^I32 at 0]
    (while (< j end)
      (do (set v (+ j 1))
          (if (and (== (pc-kind ox j) K_NAME) (< v end))
            (do (set ks (pc-ea ox j))
                (set kl (pc-eb ox j))
                (set vk (pc-kind ox v))
                (set vs (pc-ea ox v))
                (set vl (pc-eb ox v))
                (if (and (== (pc-name-eq ox ks kl (pn-mcid)) 1) (== vk K_NUM))
                  (mk-set mk span (mkf-mcid) (fx-round (fx-join vs vl))))
                (if (and (== isart 1) (and (== (pc-name-eq ox ks kl (pn-type)) 1) (== vk K_NAME)))
                  (do (mk-set mk span (mkf-artype) (ar-other))
                      (if (== (pc-name-eq ox vs vl (pn-pagination)) 1) (mk-set mk span (mkf-artype) (ar-pagination)))
                      (if (== (pc-name-eq ox vs vl (pn-layout)) 1) (mk-set mk span (mkf-artype) (ar-layout)))
                      (if (== (pc-name-eq ox vs vl (pn-background)) 1) (mk-set mk span (mkf-artype) (ar-background)))
                      (if (== (pc-name-eq ox vs vl (pn-page)) 1) (mk-set mk span (mkf-artype) (ar-page)))))
                (if (and (== isart 1) (and (== (pc-name-eq ox ks kl (pn-subtype)) 1) (== vk K_NAME)))
                  (do (mk-set mk span (mkf-arsub) (as-other))
                      (if (== (pc-name-eq ox vs vl (pn-header)) 1) (mk-set mk span (mkf-arsub) (as-header)))
                      (if (== (pc-name-eq ox vs vl (pn-footer)) 1) (mk-set mk span (mkf-arsub) (as-footer)))
                      (if (== (pc-name-eq ox vs vl (pn-watermark)) 1) (mk-set mk span (mkf-arsub) (as-watermark)))))
                (if (or (== vk K_STR) (== vk K_NAME))
                  (do (if (== (pc-name-eq ox ks kl (pn-actual-text)) 1)
                        (do (set at (pc-push-text et ox vs vl))
                            (mk-set mk span (mkf-actual) at)
                            (mk-set mk span (mkf-actuallen) (- (cells-len et) at))))
                      (if (== (pc-name-eq ox ks kl (pn-alt)) 1)
                        (do (set at (pc-push-text et ox vs vl))
                            (mk-set mk span (mkf-alt) at)
                            (mk-set mk span (mkf-altlen) (- (cells-len et) at))))
                      (if (== (pc-name-eq ox ks kl (pn-e)) 1)
                        (do (set at (pc-push-text et ox vs vl))
                            (mk-set mk span (mkf-exp) at)
                            (mk-set mk span (mkf-explen) (- (cells-len et) at))))
                      (if (== (pc-name-eq ox ks kl (pn-lang)) 1)
                        (do (set at (pc-push-text et ox vs vl))
                            (mk-set mk span (mkf-lang) at)
                            (mk-set mk span (mkf-langlen) (- (cells-len et) at))))))
                (set j (+ v (pc-esize ox v))))
            (set j (+ j (pc-esize ox j))))))
    (return 0)))

(defn ^I32 pc-mc-pop [^:mut ^Cells cx ^:mut ^Cells mk ^Cells gl ^I32 unterminated]
  (comment "Close the innermost open mark: its glyphs are those shown since it opened, its painted objects")
  (comment "those numbered since (`mk-close`).")
  (let [^I32 t (cells-at cx C_MCTOP)]
    (if (< t 0) (return 0))
    (let [^I32 g (gl-count gl)
          ^I32 par (mk-get mk t (mkf-parent))]
      (mk-close mk t g (cells-at cx C_Z))
      (if (== unterminated 1)
        (do (let [^I32 fl (mk-get mk t (mkf-flags))]
              (mk-set mk t (mkf-flags) (bit-or fl (mc-unterminated))))))
      (cells-set cx C_MCTOP par)
      (cells-set cx C_MCDEPTH (- (cells-at cx C_MCDEPTH) 1))
      (if (== (cells-at cx C_CUROCG) t)
        (cells-set cx C_CUROCG (mk-ocg-of mk par)))
      (return 0))))

(defn ^I32 pc-mc-begin [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                        ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                        ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt ^:mut ^Cells gx
                        ^I32 n ^I32 props]
  (comment "BMC / BDC: open a mark with the tag of operand 0 and, for BDC, the properties of operand 1 (an")
  (comment "inline dictionary, or a name in /Properties). Its kind is `artifact` for /Artifact,")
  (comment "`optional-content` for /OC (its object number is the /Properties entry's, when that is a")
  (comment "reference), else `tag`.")
  (let [^I32 depth (cells-at cx C_MCDEPTH)
        ^:mut ^I32 tstart 0
        ^:mut ^I32 tlen 0
        ^:mut ^I32 span 0
        ^:mut ^I32 d -1
        ^:mut ^I32 raw 0
        ^:mut ^I32 dh 0
        ^:mut ^I32 isart 0
        ^:mut ^I32 isoc 0
        ^:mut ^I32 t0 0
        ^:mut ^I32 kind 3
        ^:mut ^I32 flags 0]
    (if (>= depth MAX_MC)
      (do (cells-set cx C_MCOVER (+ (cells-at cx C_MCOVER) 1))
          (pc-warn-set cx W_MC)
          (return 0)))
    (set tstart (cells-len et))
    (if (and (>= n 1) (== (pc-kind ox 0) K_NAME))
      (do (set tstart (pc-push-entry et ox 0))
          (set tlen (pc-eb ox 0))
          (if (== (pc-entry-name-is ox 0 (pn-artifact)) 1)
            (set isart 1))
          (set t0 (pc-ea ox 0))
          (if (and (== tlen 2) (and (== (cells-at ox t0) 79) (== (cells-at ox (+ t0 1)) 67)))
            (set isoc 1))))
    (if (== isart 1) (set kind (mk-artifact)))
    (if (== isoc 1) (set kind (mk-optional-content)))
    (set span (mk-open mk (cells-at cx C_PAGE) kind tstart tlen (cells-at cx C_MCTOP) (gl-count gl) (cells-at cx C_Z)))
    (mk-set mk span (mkf-stm) (cells-at cx C_STM))
    (if (== isart 1) (mk-set mk span (mkf-artype) (ar-other)))
    (if (and (== props 1) (>= n 2))
      (do (if (== (pc-kind ox 1) K_DICT)
            (do (set d 1)
                (set flags (mc-inline))))
          (if (== (pc-kind ox 1) K_NAME)
            (do (set raw (pc-res-entry src ar dc a b st cx ox (pn-properties) 1))
                (if (!= raw 0)
                  (set dh (pd-resolve src ar dc a b st raw)))
                (if (ps-missed src)
                  (cells-set cx C_ABORT 1))
                (if (and (== isoc 1) (!= raw 0))
                  (do (if (== (pl-kind-of ar raw) 9)
                        (mk-set mk span (mkf-ocg) (pl-int-value ar raw)))
                      (mk-set mk span (mkf-ocgdef) (gx-oc-state src ar dc a b st gx raw 0))))
                (if (and (!= dh 0) (== (pl-kind-of ar dh) 7))
                  (do (set d (pc-ingest-props src ar dc a b st cx ox dh))
                      (set flags (mc-resource)))
                  (do (set flags (mc-unresolved))
                      (pc-warn-set cx W_PROPS)))))
          (mk-set mk span (mkf-flags) flags)
          (if (>= d 0)
            (pc-read-props et mk ox span d isart))))
    (cells-set cx C_MCTOP span)
    (cells-set cx C_MCDEPTH (+ depth 1))
    (if (== isoc 1) (cells-set cx C_CUROCG span))
    (return 0)))

(defn ^I32 pc-mc-end [^:mut ^Cells cx ^:mut ^Cells mk ^Cells gl]
  (comment "EMC: close the innermost mark this stream opened; a BDC that was too deep")
  (comment "to record is balanced first; an EMC with nothing to close is ignored.")
  (let [^I32 over (cells-at cx C_MCOVER)]
    (if (> over 0)
      (do (cells-set cx C_MCOVER (- over 1))
          (return 0)))
    (if (<= (cells-at cx C_MCDEPTH) (cells-at cx C_MCBASE))
      (do (pc-warn-set cx W_MC)
          (return 0)))
    (return (pc-mc-pop cx mk gl 0))))

;; ------------------------------------------------------------ inline images

(defn ^I32 pc-skip-inline [^:mut ^Cells cx ^Cells cs]
  (comment "BI: skip to the end of the inline image: find `ID` and its one white")
  (comment "space, then the first `EI` that stands alone (white space before and white")
  (comment "space or the end after). Binary data rarely contains one; if it does the")
  (comment "rest is read as operators and skipped as unknown ones.")
  (let [^I32 end (cells-at cx C_END)
        ^:mut ^I32 p (cells-at cx C_POS)
        ^:mut ^I32 found 0]
    (while (and (< (+ p 2) end) (== found 0))
      (do (if (and (== (pc-ws (cells-at cs p)) 1)
                   (and (== (cells-at cs (+ p 1)) 73)
                        (and (== (cells-at cs (+ p 2)) 68)
                             (or (>= (+ p 3) end) (== (pc-ws (cells-at cs (+ p 3))) 1)))))
            (do (set found 1)
                (set p (+ p 4)))
            (set p (+ p 1)))))
    (if (== found 0)
      (do (cells-set cx C_POS end)
          (return 0)))
    (set found 0)
    (while (and (< (+ p 1) end) (== found 0))
      (do (if (and (== (cells-at cs p) 69)
                   (and (== (cells-at cs (+ p 1)) 73)
                        (and (or (== p 0) (== (pc-ws (cells-at cs (- p 1))) 1))
                             (or (>= (+ p 2) end) (== (pc-ws (cells-at cs (+ p 2))) 1)))))
            (do (set found 1)
                (set p (+ p 2)))
            (set p (+ p 1)))))
    (if (== found 0) (set p end))
    (cells-set cx C_POS p)
    (return 0)))

;; --------------------------------------------- paths, clipping, images, colours (P3.5)
;;
;; A path under construction lives in the page cells (C_P*) and, point by point, in the evidence's `pts` arena
;; (page space, centipoints: the first PATH_KEEP points of a path; a longer one keeps its box and no geometry).
;; A paint operator ends it: a `paths` row when it paints (SPEC 8.4.3), then a pending `W`/`W*` makes the clip.
;; A CLIP is a `paths` row whose box is the INTERSECTION of the new clip and the one in force (D152): the
;; clip row a glyph, path or image names is therefore the whole clip region's bounding box, and P3.6 never has
;; to walk a chain. A clip that would not shrink the region makes no row.

(defn ^I64 pc-tx [^Cells cx ^I64 x ^I64 y]
  (comment "The user-space point (x, y) in page space: x of it (Fx).")
  (return (fx-clamp (mx-x cx (+ C_CUR G_CTM) x y))))

(defn ^I64 pc-ty [^Cells cx ^I64 x ^I64 y]
  (return (fx-clamp (mx-y cx (+ C_CUR G_CTM) x y))))

(defn ^I32 pc-flag-or [^I32 v ^I32 bit]
  (comment "v with the one-bit flag `bit` set.")
  (if (!= (bit-and v bit) 0) (return v))
  (return (+ v bit)))

(defn ^I32 pc-path-reset [^:mut ^Cells cx ^:mut ^Cells pts]
  (comment "No path: the next point starts one. The pts arena keeps what an earlier row of the evidence put there.")
  (let [^I32 n (pt-count pts)]
    (cells-set cx C_PPTS n)
    (cells-set cx C_PN 0)
    (cells-set cx C_PKEEP 0)
    (cells-set cx C_PBX0 2147483647)
    (cells-set cx C_PBY0 2147483647)
    (cells-set cx C_PBX1 -2147483647)
    (cells-set cx C_PBY1 -2147483647)
    (cells-set cx C_PFLAGS 0)
    (cells-set cx C_PNSUB 0)
    (return 0)))

(defn ^I32 pc-path-add [^:mut ^Cells cx ^:mut ^Cells pts ^I64 px ^I64 py ^I32 op]
  (comment "Append the page-space point (px, py) to the path: its box, the current point, and (for the first")
  (comment "PATH_KEEP points) a row of `pts`.")
  (let [^I32 x (fx-round px)
        ^I32 y (fx-round py)
        ^I32 keep (cells-at cx C_PKEEP)]
    (if (< x (cells-at cx C_PBX0)) (cells-set cx C_PBX0 x))
    (if (< y (cells-at cx C_PBY0)) (cells-set cx C_PBY0 y))
    (if (> x (cells-at cx C_PBX1)) (cells-set cx C_PBX1 x))
    (if (> y (cells-at cx C_PBY1)) (cells-set cx C_PBY1 y))
    (if (and (< keep PATH_KEEP_STRAIGHT) (< (- (pt-count pts) (cells-at cx C_PTS0)) PTS_PAGE))
      (do (pt-add pts x y op)
          (cells-set cx C_PKEEP (+ keep 1)))
      (do (if (< keep PATH_KEEP_STRAIGHT) (pc-warn-set cx W_PATHS))
          (cells-set cx C_PFLAGS (pc-flag-or (cells-at cx C_PFLAGS) 4))))
    (cells-set cx C_PN (+ (cells-at cx C_PN) 1))
    (fx-put cx C_PCX px)
    (fx-put cx C_PCY py)
    (return 0)))

(defn ^I32 pc-op-move [^:mut ^Cells cx ^:mut ^Cells pts ^Cells ox ^I32 n]
  (if (< n 2) (return 0))
  (let [^I64 x (pc-num ox n 0)
        ^I64 y (pc-num ox n 1)
        ^I64 px (pc-tx cx x y)
        ^I64 py (pc-ty cx x y)]
    (cells-set cx C_PNSUB (+ (cells-at cx C_PNSUB) 1))
    (pc-path-add cx pts px py (po-move))
    (fx-put cx C_PSX px)
    (fx-put cx C_PSY py)
    (return 0)))

(defn ^I32 pc-op-line [^:mut ^Cells cx ^:mut ^Cells pts ^Cells ox ^I32 n]
  (if (< n 2) (return 0))
  (if (== (cells-at cx C_PN) 0) (return 0))
  (let [^I64 x (pc-num ox n 0)
        ^I64 y (pc-num ox n 1)
        ^I64 px (pc-tx cx x y)
        ^I64 py (pc-ty cx x y)]
    (pc-path-add cx pts px py (po-line))
    (return 0)))

(defn ^I32 pc-op-curve [^:mut ^Cells cx ^:mut ^Cells pts ^Cells ox ^I32 n ^I32 kind]
  (comment "c (kind 0, six numbers), v (kind 1: the first control point is the current point) and y (kind 2: the")
  (comment "second control point is the end point). Each puts three curve points in the path.")
  (if (== (cells-at cx C_PN) 0) (return 0))
  (let [^:mut ^I64 x1 (i64 0)
        ^:mut ^I64 y1 (i64 0)
        ^:mut ^I64 x2 (i64 0)
        ^:mut ^I64 y2 (i64 0)
        ^:mut ^I64 x3 (i64 0)
        ^:mut ^I64 y3 (i64 0)
        ^:mut ^I64 q1x (i64 0)
        ^:mut ^I64 q1y (i64 0)]
    (if (== kind 0)
      (do (if (< n 6) (return 0))
          (set x1 (pc-num ox n 0))
          (set y1 (pc-num ox n 1))
          (set x2 (pc-num ox n 2))
          (set y2 (pc-num ox n 3))
          (set x3 (pc-num ox n 4))
          (set y3 (pc-num ox n 5))))
    (if (== kind 1)
      (do (if (< n 4) (return 0))
          (set x2 (pc-num ox n 0))
          (set y2 (pc-num ox n 1))
          (set x3 (pc-num ox n 2))
          (set y3 (pc-num ox n 3))))
    (if (== kind 2)
      (do (if (< n 4) (return 0))
          (set x1 (pc-num ox n 0))
          (set y1 (pc-num ox n 1))
          (set x3 (pc-num ox n 2))
          (set y3 (pc-num ox n 3))
          (set x2 x3)
          (set y2 y3)))
    (if (== kind 1)
      (do (set q1x (fx-get cx C_PCX))
          (set q1y (fx-get cx C_PCY)))
      (do (set q1x (pc-tx cx x1 y1))
          (set q1y (pc-ty cx x1 y1))))
    (pc-path-add cx pts q1x q1y (po-curve))
    (let [^I64 q2x (pc-tx cx x2 y2)
          ^I64 q2y (pc-ty cx x2 y2)
          ^I64 q3x (pc-tx cx x3 y3)
          ^I64 q3y (pc-ty cx x3 y3)]
      (pc-path-add cx pts q2x q2y (po-curve))
      (pc-path-add cx pts q3x q3y (po-curve)))
    (cells-set cx C_PFLAGS (pc-flag-or (cells-at cx C_PFLAGS) 1))
    (return 0)))

(defn ^I32 pc-op-close [^:mut ^Cells cx ^:mut ^Cells pts]
  (comment "h: a close row at the subpath's start, which is the current point again.")
  (if (== (cells-at cx C_PN) 0) (return 0))
  (let [^I64 sx (fx-get cx C_PSX)
        ^I64 sy (fx-get cx C_PSY)]
    (pc-path-add cx pts sx sy (po-close))
    (return 0)))

(defn ^I32 pc-rect-path [^:mut ^Cells cx ^:mut ^Cells pts ^I64 x ^I64 y ^I64 w ^I64 h]
  (comment "The rectangle x y w h (user space) as a closed subpath of four corners, each through the CTM.")
  (let [^I64 xw (fx-clamp (add64 x w))
        ^I64 yh (fx-clamp (add64 y h))
        ^I64 ax (pc-tx cx x y)
        ^I64 ay (pc-ty cx x y)
        ^I64 bx (pc-tx cx xw y)
        ^I64 by (pc-ty cx xw y)
        ^I64 dx (pc-tx cx xw yh)
        ^I64 dy (pc-ty cx xw yh)
        ^I64 ex (pc-tx cx x yh)
        ^I64 ey (pc-ty cx x yh)]
    (cells-set cx C_PNSUB (+ (cells-at cx C_PNSUB) 1))
    (pc-path-add cx pts ax ay (po-move))
    (fx-put cx C_PSX ax)
    (fx-put cx C_PSY ay)
    (pc-path-add cx pts bx by (po-line))
    (pc-path-add cx pts dx dy (po-line))
    (pc-path-add cx pts ex ey (po-line))
    (pc-path-add cx pts ax ay (po-close))
    (return 0)))

(defn ^I32 pc-op-rect [^:mut ^Cells cx ^:mut ^Cells pts ^Cells ox ^I32 n]
  (comment "re: the rectangle x y w h.")
  (if (< n 4) (return 0))
  (let [^I64 x (pc-num ox n 0)
        ^I64 y (pc-num ox n 1)
        ^I64 w (pc-num ox n 2)
        ^I64 h (pc-num ox n 3)]
    (pc-rect-path cx pts x y w h)
    (return 0)))

(defn ^I32 pc-near [^I32 p ^I32 q]
  (comment "1 when two centipoint coordinates differ by at most one (a corner rounded two ways).")
  (let [^I32 d (- p q)]
    (if (and (<= d 1) (>= d -1)) (return 1))
    (return 0)))

(defn ^I32 pc-is-rect [^:mut ^Cells cx ^:mut ^Cells pts]
  (comment "1 when the path is one subpath of four corners (a line back to the first corner, and a close, allowed)")
  (comment "whose sides are axis-aligned to a centipoint.")
  (let [^I32 n (cells-at cx C_PN)
        ^I32 s (cells-at cx C_PPTS)
        ^:mut ^I32 k 0
        ^:mut ^I32 np 0
        ^:mut ^I32 opk 0
        ^:mut ^I32 x0 0
        ^:mut ^I32 y0 0
        ^:mut ^I32 x1 0
        ^:mut ^I32 y1 0
        ^:mut ^I32 x2 0
        ^:mut ^I32 y2 0
        ^:mut ^I32 x3 0
        ^:mut ^I32 y3 0
        ^:mut ^I32 px 0
        ^:mut ^I32 py 0]
    (if (or (< n 4) (> n 6)) (return 0))
    (if (!= (cells-at cx C_PNSUB) 1) (return 0))
    (if (!= (bit-and (cells-at cx C_PFLAGS) 5) 0) (return 0))
    (comment "The points that are not a close row, in order; the first must be a move.")
    (while (< k n)
      (do (set opk (pt-get pts (+ s k) (ptf-op)))
          (set px (pt-get pts (+ s k) (ptf-x)))
          (set py (pt-get pts (+ s k) (ptf-y)))
          (if (== k 0)
            (if (!= opk (po-move)) (return 0)))
          (if (and (> k 0) (== opk (po-move))) (return 0))
          (if (!= opk (po-close))
            (do (if (== np 0) (do (set x0 px) (set y0 py)))
                (if (== np 1) (do (set x1 px) (set y1 py)))
                (if (== np 2) (do (set x2 px) (set y2 py)))
                (if (== np 3) (do (set x3 px) (set y3 py)))
                (if (== np 4)
                  (do (if (or (== (pc-near px x0) 0) (== (pc-near py y0) 0)) (return 0))))
                (set np (+ np 1))))
          (set k (+ k 1))))
    (if (and (!= np 4) (!= np 5)) (return 0))
    (if (and (== (pc-near x0 x1) 1) (and (== (pc-near y1 y2) 1) (and (== (pc-near x2 x3) 1) (== (pc-near y3 y0) 1))))
      (return 1))
    (if (and (== (pc-near y0 y1) 1) (and (== (pc-near x1 x2) 1) (and (== (pc-near y2 y3) 1) (== (pc-near x3 x0) 1))))
      (return 1))
    (return 0)))

(defn ^I32 pc-scale-cpt [^Cells cx ^I64 w]
  (comment "A length in user units (an Fx) as centipoints under the current CTM: through the length of its x axis.")
  (let [^I64 a (fx-get cx (+ C_CUR G_CTM))
        ^I64 b (fx-get cx (+ (+ C_CUR G_CTM) 2))
        ^I64 hyp (fx-hypot a b)
        ^I32 v (fx-round (fx-mul (fx-abs w) hyp))]
    (if (> v 10000000) (return 10000000))
    (return v)))

(defn ^I32 pc-dash-op [^:mut ^Cells cx ^Cells ox ^I32 n]
  (comment "d: the dash array's first length (centipoints under the CTM), 0 for a solid line.")
  (cells-set cx (+ C_CUR G_DASH) 0)
  (if (< n 1) (return 0))
  (if (!= (pc-kind ox 0) K_ARR) (return 0))
  (if (< (pc-ea ox 0) 1) (return 0))
  (if (!= (pc-kind ox 1) K_NUM) (return 0))
  (let [^I64 v (pc-num ox n 1)
        ^I32 sc (pc-scale-cpt cx v)]
    (cells-set cx (+ C_CUR G_DASH) sc)
    (return 0)))

(defn ^I32 pc-clip-box [^:mut ^Cells cx ^:mut ^Cells pa ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1 ^I32 kind
                        ^I32 flags ^I32 pfirst ^I32 pcount]
  (comment "Clip to the box (x0, y0, x1, y1) of a shape of `kind`: the region becomes its intersection with the clip in")
  (comment "force. When that does not shrink the region there is nothing to record; else a `paths` row (a clip, SPEC")
  (comment "8.4.3: z -1) holds the intersection, naming the clip it was cut from, and becomes the clip in force.")
  (let [^I32 cur (cells-at cx (+ C_CUR G_CLIP))
        ^:mut ^I32 ix0 x0
        ^:mut ^I32 iy0 y0
        ^:mut ^I32 ix1 x1
        ^:mut ^I32 iy1 y1
        ^:mut ^I32 same 0
        ^:mut ^I32 cb 0
        ^:mut ^I32 r 0]
    (if (>= cur 0)
      (do (set cb (pa-get pa cur (pf-x0)))
          (if (> cb ix0) (set ix0 cb))
          (set cb (pa-get pa cur (pf-y0)))
          (if (> cb iy0) (set iy0 cb))
          (set cb (pa-get pa cur (pf-x1)))
          (if (< cb ix1) (set ix1 cb))
          (set cb (pa-get pa cur (pf-y1)))
          (if (< cb iy1) (set iy1 cb))
          (if (and (== ix0 (pa-get pa cur (pf-x0)))
                   (and (== iy0 (pa-get pa cur (pf-y0)))
                        (and (== ix1 (pa-get pa cur (pf-x1))) (== iy1 (pa-get pa cur (pf-y1))))))
            (set same 1))))
    (if (== same 1) (return 0))
    (if (>= (cells-at cx C_NPATH) PATH_ROWS)
      (do (pc-warn-set cx W_PATHS)
          (return 0)))
    (set r (pa-new pa (cells-at cx C_PAGE) kind ix0 iy0 ix1 iy1))
    (pa-set pa r (pf-flags) (+ (pg-clip) flags))
    (pa-set pa r (pf-clip) cur)
    (pa-set pa r (pf-mark) (cells-at cx C_MCTOP))
    (pa-set pa r (pf-ocg) (cells-at cx C_CUROCG))
    (pa-set pa r (pf-pfirst) pfirst)
    (pa-set pa r (pf-pcount) pcount)
    (cells-set cx C_NPATH (+ (cells-at cx C_NPATH) 1))
    (cells-set cx (+ C_CUR G_CLIP) r)
    (return 0)))

(defn ^I32 pc-kind-of-path [^:mut ^Cells cx ^:mut ^Cells pts]
  (comment "The `pa` kind of the path: a rectangle, a curve, a single line, else other.")
  (if (== (pc-is-rect cx pts) 1) (return (pa-rect)))
  (if (!= (bit-and (cells-at cx C_PFLAGS) 1) 0) (return (pa-curve)))
  (if (and (== (cells-at cx C_PN) 2) (== (cells-at cx C_PNSUB) 1)) (return (pa-line)))
  (return (pa-other)))

(defn ^I32 pc-geom-kept [^Cells cx]
  (comment "1 when the whole path is in `pts`: a path of `m l h re` alone had no more than PATH_KEEP_STRAIGHT points (and the")
  (comment "page's `pts` was not full), a path with a curve no more than PATH_KEEP (D219).")
  (if (!= (bit-and (cells-at cx C_PFLAGS) 4) 0) (return 0))
  (if (and (!= (bit-and (cells-at cx C_PFLAGS) 1) 0) (> (cells-at cx C_PN) PATH_KEEP)) (return 0))
  (return 1))

(defn ^I32 pc-end-path [^:mut ^Cells cx ^:mut ^Cells pa ^:mut ^Cells pts ^I32 fill ^I32 stroke ^I32 evenodd ^I32 closed]
  (comment "A paint operator (or `n`) ends the path. If it filled or stroked, a `paths` row records it; then a pending")
  (comment "`W` or `W*` clips to it. The row's box is the path's box, grown by half the stroke width when it strokes;")
  (comment "its geometry is the path's rows of `pts` (kept when the path was short enough, else dropped).")
  (let [^I32 n (cells-at cx C_PN)
        ^I32 start (cells-at cx C_PPTS)
        ^I32 kept (pc-geom-kept cx)
        ^I32 pend (cells-at cx C_CLIPP)
        ^:mut ^I32 kind 0
        ^:mut ^I32 half 0
        ^:mut ^I32 r 0
        ^:mut ^I32 fl 0
        ^:mut ^I32 wd 0
        ^:mut ^I64 lwv (i64 0)
        ^:mut ^I32 nrows 0
        ^:mut ^I32 pfst -1
        ^:mut ^I32 geom 0
        ^:mut ^I32 painted 0
        ^:mut ^I32 tr 0]
    (cells-set cx C_CLIPP 0)
    (if (== n 0)
      (do (pc-path-reset cx pts)
          (return 0)))
    (set kind (pc-kind-of-path cx pts))
    (set nrows n)
    (if (== kept 0) (set nrows 0))
    (if (== kept 0) (set tr (pg-truncated)))
    (if (> nrows 0) (set pfst start))
    (if (and (== kept 0) (> (cells-at cx C_PKEEP) 0))
      (cells-drop pts (* start 3)))
    (set geom nrows)
    (if (or (== fill 1) (== stroke 1))
      (do (if (>= (cells-at cx C_NPATH) PATH_ROWS)
            (pc-warn-set cx W_PATHS)
            (do (set painted 1)
                (set fl tr)
                (if (!= closed 0) (set fl (+ fl (pg-closed))))
                (if (== evenodd 1) (set fl (+ fl (pg-evenodd))))
                (if (== stroke 1)
                  (do (set lwv (fx-get cx (+ C_CUR G_LW)))
                      (set wd (pc-scale-cpt cx lwv))
                      (set half (quot (+ wd 1) 2))
                      (set fl (+ fl (pg-stroked)))))
                (if (== fill 1)
                  (do (set fl (+ fl (pg-filled)))
                      (if (== (cells-at cx (+ C_CUR G_FAM)) 5) (set fl (+ fl (pg-pattern))))))
                (if (!= (cells-at cx (+ C_CUR G_BM)) 0) (set fl (+ fl (pg-blend))))
                (if (!= (cells-at cx (+ C_CUR G_SMASK)) 0) (set fl (+ fl (pg-softmask))))
                (set r (pa-new pa (cells-at cx C_PAGE) kind
                               (- (cells-at cx C_PBX0) half) (- (cells-at cx C_PBY0) half)
                               (+ (cells-at cx C_PBX1) half) (+ (cells-at cx C_PBY1) half)))
                (pa-set pa r (pf-flags) fl)
                (if (== fill 1) (pa-set pa r (pf-fill) (cells-at cx (+ C_CUR G_COLOR))))
                (if (== stroke 1)
                  (do (pa-set pa r (pf-stroke) (cells-at cx (+ C_CUR G_SCOLOR)))
                      (pa-set pa r (pf-width) wd)
                      (pa-set pa r (pf-dash) (cells-at cx (+ C_CUR G_DASH)))))
                (pa-set pa r (pf-falpha) (cells-at cx (+ C_CUR G_ALPHA)))
                (pa-set pa r (pf-salpha) (cells-at cx (+ C_CUR G_SALPHA)))
                (pa-set pa r (pf-z) (cells-at cx C_Z))
                (cells-set cx C_Z (+ (cells-at cx C_Z) 1))
                (pa-set pa r (pf-clip) (cells-at cx (+ C_CUR G_CLIP)))
                (pa-set pa r (pf-mark) (cells-at cx C_MCTOP))
                (pa-set pa r (pf-ocg) (cells-at cx C_CUROCG))
                (pa-set pa r (pf-pfirst) pfst)
                (pa-set pa r (pf-pcount) geom)
                (cells-set cx C_NPATH (+ (cells-at cx C_NPATH) 1))))))
    (if (!= pend 0)
      (do (set fl tr)
          (if (== pend 2) (set fl (+ fl (pg-evenodd))))
          (pc-clip-box cx pa (cells-at cx C_PBX0) (cells-at cx C_PBY0) (cells-at cx C_PBX1) (cells-at cx C_PBY1)
                       kind fl pfst geom)))
    (comment "A path whose geometry nobody kept leaves no rows behind.")
    (if (and (== painted 0) (== pend 0))
      (cells-drop pts (* start 3)))
    (pc-path-reset cx pts)
    (return 0)))

(defn ^I32 pc-paint-op [^:mut ^Cells cx ^:mut ^Cells pa ^:mut ^Cells pts ^I32 op]
  (comment "S s f F f* B B* b b* n: which of fill, stroke, even-odd and close each one means.")
  (let [^:mut ^I32 fill 0
        ^:mut ^I32 stroke 0
        ^:mut ^I32 eo 0
        ^:mut ^I32 shut 0]
    (if (== op OP_STROKE) (set stroke 1))
    (if (== op OP_CLOSESTROKE) (do (set stroke 1) (set shut 1)))
    (if (or (== op OP_FILL) (== op OP_FILL2)) (set fill 1))
    (if (== op OP_FILLEO) (do (set fill 1) (set eo 1)))
    (if (== op OP_FS) (do (set fill 1) (set stroke 1)))
    (if (== op OP_FSEO) (do (set fill 1) (set stroke 1) (set eo 1)))
    (if (== op OP_CFS) (do (set fill 1) (set stroke 1) (set shut 1)))
    (if (== op OP_CFSEO) (do (set fill 1) (set stroke 1) (set shut 1) (set eo 1)))
    (if (== shut 1) (pc-op-close cx pts))
    (pc-end-path cx pa pts fill stroke eo shut)
    (return 0)))

;; ---------------------------------------------------------------- colours

(defn ^I32 pc-set-ink [^:mut ^Cells cx ^I32 stroke ^I32 key ^I32 cls ^I32 rgb]
  (comment "Make (key, class, colour) the fill (stroke 0) or stroking (stroke 1) colour of the current state.")
  (if (== stroke 1)
    (do (cells-set cx (+ C_CUR G_SCS) key)
        (cells-set cx (+ C_CUR G_SFAM) cls)
        (cells-set cx (+ C_CUR G_SCOLOR) rgb))
    (do (cells-set cx (+ C_CUR G_FCS) key)
        (cells-set cx (+ C_CUR G_FAM) cls)
        (cells-set cx (+ C_CUR G_COLOR) rgb)))
  (return 0))

(defn ^I32 pc-device-rgb [^Cells ox ^:mut ^Cells gx ^I32 n ^I32 space]
  (comment "The colour of the first operands under DeviceGray (space 1), DeviceRGB (2) or DeviceCMYK (3): -1 when there are")
  (comment "too few. The conversion is the colour module's, so a colour is the same however it was set.")
  (let [^:mut ^I32 need 1
        ^:mut ^I32 i 0
        ^:mut ^I64 v (i64 0)]
    (if (== space 2) (set need 3))
    (if (== space 3) (set need 4))
    (if (< n need) (return -1))
    (while (< i need)
      (do (set v (pc-num ox n i))
          (gx-input gx i v)
          (set i (+ i 1))))
    (return (gx-entry-rgb gx (- space 1) need))))

(defn ^I32 pc-color-device [^:mut ^Cells cx ^Cells ox ^:mut ^Cells gx ^I32 n ^I32 stroke ^I32 space]
  (comment "g rg k G RG K: the device space, its class, and the colour.")
  (let [^I32 rgb (pc-device-rgb ox gx n space)]
    (if (< rgb 0) (return 0))
    (pc-set-ink cx stroke (- 0 space) space rgb)
    (return 0)))

(defn ^I32 pc-cs-op [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                     ^:mut ^Cells out ^:mut ^Cells cx ^Cells ox ^:mut ^Cells gx ^I32 n ^I32 stroke]
  (comment "cs, CS: the colour space named by operand 0: a device space, Pattern, or a /ColorSpace resource. The colour")
  (comment "becomes the space's initial colour. A space this reader cannot read leaves an unknown colour (-1) and no class.")
  (if (< n 1) (return 0))
  (if (!= (pc-kind ox 0) K_NAME) (return 0))
  (let [^:mut ^I32 key 0
        ^:mut ^I32 raw 0
        ^:mut ^I32 h 0
        ^:mut ^I32 e -1]
    (if (== (pc-entry-name-is ox 0 (pn-device-gray)) 1) (set key -1))
    (if (== (pc-entry-name-is ox 0 (pn-device-rgb)) 1) (set key -2))
    (if (== (pc-entry-name-is ox 0 (pn-device-cmyk)) 1) (set key -3))
    (if (== (pc-entry-name-is ox 0 (pn-pattern)) 1) (set key -4))
    (if (== key 0)
      (do (set raw (pc-res-entry src ar dc a b st cx ox (pn-color-space) 0))
          (if (!= raw 0) (set h (pd-resolve src ar dc a b st raw)))
          (if (ps-missed src)
            (do (cells-set cx C_ABORT 1)
                (return 0)))
          (if (!= h 0) (set key (gx-key-of src ar dc a b st h)))))
    (if (!= key 0) (set e (gx-lookup src ar dc a b st out gx key)))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (< e 0)
      (do (pc-set-ink cx stroke key 0 -1)
          (return 0)))
    (let [^I32 cls (gx-class gx e)
          ^I32 rgb (gx-initial gx e)]
      (pc-set-ink cx stroke key cls rgb)
      (return 0))))

(defn ^I32 pc-sc-op [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                     ^:mut ^Cells out ^:mut ^Cells cx ^Cells ox ^:mut ^Cells gx ^I32 n ^I32 stroke]
  (comment "sc, scn, SC, SCN: a colour in the current space. A pattern space takes no components (its colour is")
  (comment "unknown); a colour whose component count is not the space's is read by its count, as a device colour.")
  (let [^:mut ^I32 key 0
        ^:mut ^I32 e -1
        ^:mut ^I32 nn 0
        ^:mut ^I32 i 0
        ^:mut ^I32 ncomp 0
        ^:mut ^I32 rgb -1
        ^:mut ^I32 cls 0
        ^:mut ^I64 v (i64 0)]
    (if (== stroke 1)
      (set key (cells-at cx (+ C_CUR G_SCS)))
      (set key (cells-at cx (+ C_CUR G_FCS))))
    (if (!= key 0) (set e (gx-lookup src ar dc a b st out gx key)))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (while (and (< nn n) (== (pc-kind ox nn) K_NUM))
      (set nn (+ nn 1)))
    (if (== e -1)
      (do (comment "A space that is not known: whatever colour was set is not.")
          (pc-set-ink cx stroke key 0 -1)
          (return 0)))
    (if (== (gx-is-pattern gx e) 1)
      (do (pc-set-ink cx stroke key 5 -1)
          (return 0)))
    (set ncomp (gx-ncomp gx e))
    (if (> nn 32) (set nn 32))
    (if (and (> nn 0) (== nn ncomp))
      (do (set i 0)
          (while (< i nn)
            (do (set v (pc-num ox n i))
                (gx-input gx i v)
                (set i (+ i 1))))
          (set rgb (gx-entry-rgb gx e nn))
          (set cls (gx-class gx e))
          (pc-set-ink cx stroke key cls rgb)
          (return 0)))
    (comment "The operands do not fit the space: read them by count, as a device colour, and keep the space.")
    (if (and (> nn 0) (or (== nn 1) (or (== nn 3) (== nn 4))))
      (do (if (== nn 1) (set rgb (pc-device-rgb ox gx n 1)))
          (if (== nn 3) (set rgb (pc-device-rgb ox gx n 2)))
          (if (== nn 4) (set rgb (pc-device-rgb ox gx n 3)))
          (if (== stroke 1)
            (cells-set cx (+ C_CUR G_SCOLOR) rgb)
            (cells-set cx (+ C_CUR G_COLOR) rgb))))
    (return 0)))

;; ------------------------------------------------------ the extended graphics state

(defn ^I32 pc-bm-code [^Cells ar ^I32 h]
  (comment "A blend mode name's code: 0 Normal and Compatible, 1 Multiply, 2 Screen, 3 Overlay, 4 Darken, 5 Lighten,")
  (comment "6 ColorDodge, 7 ColorBurn, 8 HardLight, 9 SoftLight, 10 Difference, 11 Exclusion, 12 Hue, 13 Saturation,")
  (comment "14 Color, 15 Luminosity, 99 a name that is none of those.")
  (if (== h 0) (return 0))
  (if (!= (pl-kind-of ar h) 4) (return 0))
  (if (or (== (px-is ar h (px-normal)) 1) (== (px-is ar h (px-compatible)) 1)) (return 0))
  (if (== (px-is ar h (px-multiply)) 1) (return 1))
  (if (== (px-is ar h (px-screen)) 1) (return 2))
  (if (== (px-is ar h (px-overlay)) 1) (return 3))
  (if (== (px-is ar h (px-darken)) 1) (return 4))
  (if (== (px-is ar h (px-lighten)) 1) (return 5))
  (if (== (px-is ar h (px-color-dodge)) 1) (return 6))
  (if (== (px-is ar h (px-color-burn)) 1) (return 7))
  (if (== (px-is ar h (px-hard-light)) 1) (return 8))
  (if (== (px-is ar h (px-soft-light)) 1) (return 9))
  (if (== (px-is ar h (px-difference)) 1) (return 10))
  (if (== (px-is ar h (px-exclusion)) 1) (return 11))
  (if (== (px-is ar h (px-hue)) 1) (return 12))
  (if (== (px-is ar h (px-saturation)) 1) (return 13))
  (if (== (px-is ar h (px-color)) 1) (return 14))
  (if (== (px-is ar h (px-luminosity)) 1) (return 15))
  (return 99))

(defn ^I32 pc-alpha-of [^Cells ar ^I32 h]
  (comment "A constant alpha as per-mille, clamped to 0..1000.")
  (let [^I32 al (fx-round (fx-mul (pc-ar-fx64 ar h) (fx-of-int 1000)))]
    (if (< al 0) (return 0))
    (if (> al 1000) (return 1000))
    (return al)))

(defn ^I32 pc-gs-op [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                     ^:mut ^Cells cx ^Cells ox ^I32 n]
  (comment "gs: the entries of the named ExtGState that matter here: /ca and /CA (alpha), /BM (the blend mode, the first")
  (comment "name of an array), /SMask (/None, or a dictionary: its /S, Alpha or Luminosity) and /LW (the line width).")
  (if (< n 1) (return 0))
  (if (!= (pc-kind ox 0) K_NAME) (return 0))
  (let [^I32 raw (pc-res-entry src ar dc a b st cx ox (pn-ext-g-state) 0)
        ^:mut ^I32 gd 0
        ^:mut ^I32 v 0
        ^:mut ^I32 s 0]
    (if (== raw 0) (return 0))
    (set gd (pd-resolve src ar dc a b st raw))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (== gd 0) (return 0))
    (set v (pd-dget src ar dc a b st gd (pn-ca)))
    (if (!= v 0) (cells-set cx (+ C_CUR G_ALPHA) (pc-alpha-of ar v)))
    (set v (px-dget src ar dc a b st gd (px-ca)))
    (if (!= v 0) (cells-set cx (+ C_CUR G_SALPHA) (pc-alpha-of ar v)))
    (set v (px-dget src ar dc a b st gd (px-bm)))
    (if (!= v 0)
      (do (if (== (pl-kind-of ar v) 6)
            (do (set s (pl-first ar v))
                (set v (pd-resolve src ar dc a b st s))))
          (cells-set cx (+ C_CUR G_BM) (pc-bm-code ar v))))
    (set v (px-dget src ar dc a b st gd (px-s-mask)))
    (if (!= v 0)
      (do (if (== (pl-kind-of ar v) 4)
            (cells-set cx (+ C_CUR G_SMASK) 0))
          (if (== (pl-kind-of ar v) 7)
            (do (set s (px-dget src ar dc a b st v (px-s)))
                (cells-set cx (+ C_CUR G_SMASK) 2)
                (if (== (px-is ar s (px-alpha)) 1) (cells-set cx (+ C_CUR G_SMASK) 1))))))
    (set v (px-dget src ar dc a b st gd (px-lw)))
    (if (!= v 0)
      (if (== (px-is-num ar v) 1)
        (fx-put cx (+ C_CUR G_LW) (pc-ar-fx64 ar v))))
    (if (ps-missed src) (cells-set cx C_ABORT 1))
    (return 0)))

;; ------------------------------------------------------------------- images

(defn ^I32 pc-image-place [^:mut ^Cells cx ^:mut ^Cells im ^I32 obj ^I32 pxw ^I32 pxh ^I32 flags]
  (comment "One image placement (SPEC 8.4.3): the unit square through the CTM. Its box is that parallelogram's, its `rot` the")
  (comment "angle of the image's x axis, `skewed` 1 when its axes are not at a right angle (to half a degree).")
  (let [^I64 one (fx-one)
        ^I64 zero (i64 0)
        ^I64 ma (fx-get cx (+ C_CUR G_CTM))
        ^I64 mb (fx-get cx (+ (+ C_CUR G_CTM) 2))
        ^I64 mc (fx-get cx (+ (+ C_CUR G_CTM) 4))
        ^I64 md (fx-get cx (+ (+ C_CUR G_CTM) 6))
        ^I64 ax (pc-tx cx zero zero)
        ^I64 ay (pc-ty cx zero zero)
        ^I64 bx (pc-tx cx one zero)
        ^I64 by (pc-ty cx one zero)
        ^I64 dx (pc-tx cx one one)
        ^I64 dy (pc-ty cx one one)
        ^I64 ex (pc-tx cx zero one)
        ^I64 ey (pc-ty cx zero one)
        ^I32 rot (pc-dir-angle ma mb)
        ^I32 roty (pc-dir-angle mc md)
        ^:mut ^I32 diff 0
        ^:mut ^I32 skew 1
        ^:mut ^I32 fl flags
        ^:mut ^I32 chk 0
        ^:mut ^I32 ori 0
        ^:mut ^I32 r 0]
    (if (!= (cells-at cx (+ C_CUR G_BM)) 0) (set fl (+ fl (mg-blend))))
    (if (!= (cells-at cx (+ C_CUR G_SMASK)) 0) (set fl (+ fl (mg-softmask))))
    (if (!= (cells-at cx (+ C_CUR G_BM)) 0) (set chk (+ chk (vc-blend))))
    (if (!= (cells-at cx (+ C_CUR G_SMASK)) 0) (set chk (+ chk (vc-softmask))))
    (set diff (- roty rot))
    (if (< diff 0) (set diff (+ diff 36000)))
    (if (and (>= diff 8950) (<= diff 9050)) (set skew 0))
    (if (and (>= diff 26950) (<= diff 27050)) (set skew 0))
    (if (>= (cells-at cx C_NIMG) PATH_ROWS)
      (do (pc-warn-set cx W_PATHS)
          (return 0)))
    (set r (im-new im (cells-at cx C_PAGE)
                   (fx-round (pc-min4 ax bx dx ex)) (fx-round (pc-min4 ay by dy ey))
                   (fx-round (pc-max4 ax bx dx ex)) (fx-round (pc-max4 ay by dy ey))
                   obj pxw pxh))
    (im-set im r (mf-alpha) (cells-at cx (+ C_CUR G_ALPHA)))
    (im-set im r (mf-flags) fl)
    (im-set im r (mf-rot) rot)
    (im-set im r (mf-skewed) skew)
    (comment "The CTM here maps to the displayed page, whose y runs down: `pi-orient` reads a y-up matrix, so the y axis is flipped")
    (comment "back (b and d change sign). 0 is upright on the page AS DISPLAYED (a page's /Rotate is in it), 8 not rectilinear.")
    (set ori (pi-orient ma (mul64 mb (i64 -1)) mc (mul64 md (i64 -1))))
    (if (< ori 0) (set ori 8))
    (im-set im r (mf-placement) ori)
    (im-set im r (mf-z) (cells-at cx C_Z))
    (cells-set cx C_Z (+ (cells-at cx C_Z) 1))
    (im-set im r (mf-clip) (cells-at cx (+ C_CUR G_CLIP)))
    (im-set im r (mf-mark) (cells-at cx C_MCTOP))
    (im-set im r (mf-ocg) (cells-at cx C_CUROCG))
    (im-set im r (mf-vchk) chk)
    (cells-set cx C_NIMG (+ (cells-at cx C_NIMG) 1))
    (return 0)))

(defn ^I32 pc-oc-open [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                       ^:mut ^Cells cx ^:mut ^Cells gx ^Cells gl ^Cells et ^:mut ^Cells mk ^I32 raw]
  (comment "Open an optional-content span for the /OC entry `raw` of a Form XObject or an image (a `marks` row, kind")
  (comment "optional-content, flagged `xobject`): its state is `gx-oc-state`'s. Answers 1 when opened, 0 when spans are")
  (comment "too deep. The caller closes it with `pc-mc-pop`.")
  (let [^I32 depth (cells-at cx C_MCDEPTH)
        ^:mut ^I32 span 0
        ^:mut ^I32 state 1]
    (if (>= depth MAX_MC) (return 0))
    (set state (gx-oc-state src ar dc a b st gx raw 0))
    (set span (mk-open mk (cells-at cx C_PAGE) (mk-optional-content) (cells-len et) 0
                       (cells-at cx C_MCTOP) (gl-count gl) (cells-at cx C_Z)))
    (mk-set mk span (mkf-stm) (cells-at cx C_STM))
    (mk-set mk span (mkf-flags) (mc-xobject))
    (mk-set mk span (mkf-ocgdef) state)
    (if (== (pl-kind-of ar raw) 9) (mk-set mk span (mkf-ocg) (pl-int-value ar raw)))
    (cells-set cx C_MCTOP span)
    (cells-set cx C_MCDEPTH (+ depth 1))
    (cells-set cx C_CUROCG span)
    (return 1)))

(defn ^I32 pc-image-do [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                        ^:mut ^Cells cx ^:mut ^Cells gx ^Cells gl ^Cells et ^:mut ^Cells mk ^:mut ^Cells im
                        ^I32 objnum ^I32 xh]
  (comment "Do of an image XObject: a placement row. Its width and height are the dictionary's; the mask flags say what")
  (comment "could make it translucent (a stencil mask, an /SMask, a /Mask); an /OC makes it a span of its own.")
  (let [^I32 w (pd-dint src ar dc a b st xh (pn-width) 0)
        ^I32 h (pd-dint src ar dc a b st xh (pn-height) 0)
        ^:mut ^I32 fl 0
        ^:mut ^I32 v 0
        ^:mut ^I32 ocraw 0
        ^:mut ^I32 opened 0]
    (set v (px-dget src ar dc a b st xh (px-image-mask)))
    (if (!= v 0)
      (if (and (== (pl-kind-of ar v) 1) (== (pl-int-value ar v) 1)) (set fl (+ fl (mg-mask)))))
    (set v (px-dget src ar dc a b st xh (px-s-mask)))
    (if (!= v 0) (set fl (+ fl (mg-smask))))
    (set v (px-dget src ar dc a b st xh (px-mask)))
    (if (!= v 0) (set fl (+ fl (mg-masked))))
    (set ocraw (px-get ar xh (px-oc)))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (!= ocraw 0)
      (set opened (pc-oc-open src ar dc a b st cx gx gl et mk ocraw)))
    (pc-image-place cx im objnum w h fl)
    (if (== opened 1) (pc-mc-pop cx mk gl 0))
    (return 0)))

(defn ^I32 pc-name-px [^Cells ox ^I32 s ^I32 l ^I32 id]
  (comment "1 when the name operand bytes ox[s, s+l) are row `id` of the catalogue name table (emon.pdfxnames).")
  (let [^I32 n (px-span-at 0 id 1)
        ^I32 o (px-span-at 0 id 0)
        ^:mut ^I32 i 0]
    (if (!= l n) (return 0))
    (while (< i n)
      (do (if (!= (cells-at ox (+ s i)) (px-chars-at 0 (+ o i))) (return 0))
          (set i (+ i 1))))
    (return 1)))

(defn ^I32 pc-find-id [^Cells cx ^Cells cs]
  (comment "BI: where the `ID` that ends the inline image's dictionary starts (the index of its `I`), or -1.")
  (let [^I32 end (cells-at cx C_END)
        ^:mut ^I32 p (cells-at cx C_POS)]
    (while (< (+ p 2) end)
      (do (if (and (== (pc-ws (cells-at cs p)) 1)
                   (and (== (cells-at cs (+ p 1)) 73)
                        (and (== (cells-at cs (+ p 2)) 68)
                             (or (>= (+ p 3) end) (== (pc-ws (cells-at cs (+ p 3))) 1)))))
            (return (+ p 1)))
          (set p (+ p 1))))
    (return -1)))

(defn ^I32 pc-inline-image [^:mut ^Cells cx ^:mut ^Cells ox ^Cells cs ^:mut ^Cells im]
  (comment "BI: read the dictionary up to `ID` (width, height, whether it is a stencil mask), record the placement, then")
  (comment "leave the lexer where it was for `pc-skip-inline` to find the end of the data.")
  (let [^I32 start (cells-at cx C_POS)
        ^I32 end (cells-at cx C_END)
        ^I32 idp (pc-find-id cx cs)
        ^:mut ^I32 w 0
        ^:mut ^I32 h 0
        ^:mut ^I32 fl 0
        ^:mut ^I32 j 0
        ^:mut ^I32 v 0
        ^:mut ^I32 ks 0
        ^:mut ^I32 kl 0
        ^:mut ^I32 r 1
        ^:mut ^I32 total 0
        ^:mut ^I32 nxt 0]
    (if (< idp 0)
      (do (pc-image-place cx im 0 0 0 (mg-inline))
          (return 0)))
    (cells-set cx C_END idp)
    (pc-ox-clear cx ox)
    (while (== r 1)
      (do (set r (pc-lex cx ox cs))
          (if (== r 2) (set r 0))))
    (set total (cells-at cx C_OXN))
    (set j 0)
    (while (< j total)
      (do (set nxt (+ j 1))
          (if (and (== (pc-kind ox j) K_NAME) (< nxt total))
            (do (set ks (pc-ea ox j))
                (set kl (pc-eb ox j))
                (if (== (pc-kind ox nxt) K_NUM)
                  (do (set v (fx-round (fx-join (pc-ea ox nxt) (pc-eb ox nxt))))
                      (if (or (== (pc-name-eq ox ks kl (pn-width)) 1) (== (pc-name-eq ox ks kl (pn-w)) 1)) (set w v))
                      (if (or (== (pc-name-eq ox ks kl (pn-height)) 1) (== (pc-name-px ox ks kl (px-h)) 1)) (set h v))))
                (if (== (pc-kind ox nxt) K_BOOL)
                  (if (or (== (pc-name-px ox ks kl (px-im)) 1) (== (pc-name-px ox ks kl (px-image-mask)) 1))
                    (if (== (pc-ea ox nxt) 1) (set fl (mg-mask)))))
                (set j (+ nxt (pc-esize ox nxt))))
            (set j (+ j (pc-esize ox j))))))
    (cells-set cx C_END end)
    (cells-set cx C_POS start)
    (pc-ox-clear cx ox)
    (pc-image-place cx im 0 w h (+ (mg-inline) fl))
    (return 0)))

;; ---------------------------------------------------------------- shading fills

(defn ^I32 pc-sh-op [^:mut ^Cells cx ^:mut ^Cells pa]
  (comment "sh: a shading fills the whole clip region. A row of kind `other`, flagged `shading`, whose box is the region's")
  (comment "(the page when nothing clips) and whose colour is unknown: P3.6 reads it as paint that is not exactly known.")
  (let [^I32 cur (cells-at cx (+ C_CUR G_CLIP))
        ^:mut ^I32 r 0
        ^:mut ^I32 bx0 0
        ^:mut ^I32 by0 0
        ^:mut ^I32 bx1 0
        ^:mut ^I32 by1 0
        ^:mut ^I32 fl 0]
    (if (>= (cells-at cx C_NPATH) PATH_ROWS)
      (do (pc-warn-set cx W_PATHS)
          (return 0)))
    (set bx0 0)
    (set by0 0)
    (set bx1 (cells-at cx C_PW))
    (set by1 (cells-at cx C_PH))
    (if (>= cur 0)
      (do (set bx0 (pa-get pa cur (pf-x0)))
          (set by0 (pa-get pa cur (pf-y0)))
          (set bx1 (pa-get pa cur (pf-x1)))
          (set by1 (pa-get pa cur (pf-y1)))))
    (set r (pa-new pa (cells-at cx C_PAGE) (pa-other) bx0 by0 bx1 by1))
    (set fl (+ (pg-filled) (pg-shading)))
    (if (!= (cells-at cx (+ C_CUR G_BM)) 0) (set fl (+ fl (pg-blend))))
    (if (!= (cells-at cx (+ C_CUR G_SMASK)) 0) (set fl (+ fl (pg-softmask))))
    (pa-set pa r (pf-flags) fl)
    (pa-set pa r (pf-falpha) (cells-at cx (+ C_CUR G_ALPHA)))
    (pa-set pa r (pf-z) (cells-at cx C_Z))
    (cells-set cx C_Z (+ (cells-at cx C_Z) 1))
    (pa-set pa r (pf-clip) cur)
    (pa-set pa r (pf-mark) (cells-at cx C_MCTOP))
    (pa-set pa r (pf-ocg) (cells-at cx C_CUROCG))
    (cells-set cx C_NPATH (+ (cells-at cx C_NPATH) 1))
    (return 0)))

;; ----------------------------------------------------------- Form XObjects

(defn ^I32 pc-append-stream [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                             ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx
                             ^:mut ^Cells out ^:mut ^Cells cs ^I32 sh]
  (comment "Decode stream sh and append its bytes (and a line feed) to `cs`. Answers")
  (comment "the filter chain's status (0 ok), or -1 when the source missed.")
  (let [^I32 status (pd-stream-data src ar dc a b st sh out)
        ^I32 n (cells-len out)
        ^:mut ^I32 i 0]
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return -1)))
    (if (!= status 0)
      (do (pc-warn-set cx W_STREAM)
          (cells-set cx C_SSTAT status)))
    (while (< i n)
      (do (cells-push cs (cells-at out i))
          (set i (+ i 1))))
    (cells-push cs 10)
    (return status)))

(defn ^I32 pc-do [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                  ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                  ^:mut ^Cells cs ^:mut ^Cells out
                  ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                  ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt
                  ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx ^I32 n]
  (comment "Do: an image XObject is a placement (`pc-image-do`); a Form XObject is run. The form's /Matrix is")
  (comment "concatenated to the CTM, its /BBox clips (a rectangle in its own space), its /Resources replace the current")
  (comment "ones (else they are inherited), an /OC makes it an optional-content span, and it runs inside its own `q`/`Q`.")
  (if (< n 1) (return 0))
  (if (!= (pc-kind ox 0) K_NAME) (return 0))
  (let [^I32 raw (pc-res-entry src ar dc a b st cx ox (pn-x-object) 0)
        ^:mut ^I32 objnum 0
        ^:mut ^I32 xh 0
        ^:mut ^I32 sub 0
        ^:mut ^I32 fd 0
        ^:mut ^I32 i 0
        ^:mut ^I32 mat 0
        ^:mut ^I32 el 0
        ^:mut ^I32 got 0
        ^:mut ^I32 res 0
        ^:mut ^I32 oldres 0
        ^:mut ^I32 oldstm 0
        ^:mut ^I32 start 0
        ^:mut ^I32 endcs 0
        ^:mut ^I32 status 0
        ^:mut ^I32 bb 0
        ^:mut ^I32 ocraw 0
        ^:mut ^I32 opened 0
        ^:mut ^I64 bx0 (i64 0)
        ^:mut ^I64 by0 (i64 0)
        ^:mut ^I64 bx1 (i64 0)
        ^:mut ^I64 by1 (i64 0)]
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (== raw 0)
      (do (pc-warn-set cx W_FORM)
          (return 0)))
    (if (== (pl-kind-of ar raw) 9)
      (set objnum (pl-int-value ar raw)))
    (set xh (pd-resolve src ar dc a b st raw))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (== xh 0)
      (do (pc-warn-set cx W_FORM)
          (return 0)))
    (if (!= (pl-kind-of ar xh) 8) (return 0))
    (set sub (pd-dget src ar dc a b st xh (pn-subtype)))
    (if (ps-missed src)
      (do (cells-set cx C_ABORT 1)
          (return 0)))
    (if (== sub 0) (return 0))
    (if (== (pl-name-is ar sub (pn-image)) 1)
      (do (pc-image-do src ar dc a b st cx gx gl et mk im objnum xh)
          (return 0)))
    (if (== (pl-name-is ar sub (pn-form)) 0) (return 0))
    (comment "Depth and cycles: a form deeper than FORM_DEPTH, or already running, is skipped.")
    (set fd (cells-at cx C_FDEPTH))
    (if (or (>= fd MAX_FORMS) (>= fd (cells-at cx C_FLIM)))
      (do (pc-warn-set cx W_DEPTH)
          (return 0)))
    (if (!= objnum 0)
      (while (< i fd)
        (do (if (== (cells-at cx (+ C_FSTACK i)) objnum)
              (do (pc-warn-set cx W_DEPTH)
                  (return 0)))
            (set i (+ i 1)))))
    (comment "Its /Matrix (six numbers, else the identity).")
    (mx-ident cx C_TMP)
    (set mat (pd-dget src ar dc a b st xh (pn-matrix)))
    (if (and (!= mat 0) (== (pl-kind-of ar mat) 6))
      (do (set el (pl-first ar mat))
          (set got 0)
          (while (and (!= el 0) (< got 6))
            (do (fx-put cx (+ C_TMP (* got 2)) (pc-ar-fx64 ar el))
                (set el (pl-next ar el))
                (set got (+ got 1))))
          (if (< got 6) (mx-ident cx C_TMP))))
    (comment "Its /BBox, kept as four Fx until the form's state is made.")
    (set bb (pd-dget src ar dc a b st xh (pn-b-box)))
    (set got 0)
    (if (and (!= bb 0) (== (pl-kind-of ar bb) 6))
      (do (set el (pl-first ar bb))
          (while (and (!= el 0) (< got 4))
            (do (set sub (pd-resolve src ar dc a b st el))
                (if (== (px-is-num ar sub) 0)
                  (do (set got 0)
                      (set el 0))
                  (do (fx-put cx (+ C_BB (* got 2)) (pc-ar-fx64 ar sub))
                      (set el (pl-next ar el))
                      (set got (+ got 1))))))))
    (set ocraw (px-get ar xh (px-oc)))
    (set res (pd-dget src ar dc a b st xh (pn-resources)))
    (set oldres (cells-at cx C_RES))
    (set oldstm (cells-at cx C_STM))
    (if (and (!= res 0) (== (pl-kind-of ar res) 7))
      (cells-set cx C_RES res))
    (set start (cells-len cs))
    (set status (pc-append-stream src ar dc a b st cx out cs xh))
    (if (== status -1) (return 0))
    (pc-save cx)
    (mx-mul cx (+ C_CUR G_CTM) C_TMP (+ C_CUR G_CTM))
    (if (== got 4)
      (do (comment "The form's box clips what it paints: a rectangle through the CTM.")
          (pc-path-reset cx pts)
          (set bx0 (fx-get cx C_BB))
          (set by0 (fx-get cx (+ C_BB 2)))
          (set bx1 (fx-get cx (+ C_BB 4)))
          (set by1 (fx-get cx (+ C_BB 6)))
          (pc-rect-path cx pts bx0 by0 (- bx1 bx0) (- by1 by0))
          (cells-set cx C_CLIPP 1)
          (pc-end-path cx pa pts 0 0 0 1)))
    (if (!= ocraw 0)
      (set opened (pc-oc-open src ar dc a b st cx gx gl et mk ocraw)))
    (cells-set cx (+ C_FSTACK fd) objnum)
    (cells-set cx C_FDEPTH (+ fd 1))
    (cells-set cx C_STM objnum)
    (set endcs (cells-len cs))
    (pc-run src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pa im pts gx start endcs)
    (if (== opened 1) (pc-mc-pop cx mk gl 0))
    (cells-set cx C_FDEPTH fd)
    (cells-set cx C_STM oldstm)
    (cells-set cx C_RES oldres)
    (pc-restore cx)
    (cells-drop cs start)
    (return 0)))

;; ------------------------------------------------------------------- operators

(defn ^I32 pc-prep [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                    ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells out
                    ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                    ^:mut ^Cells fnt ^:mut ^Cells et]
  (comment "Before a string is shown: the font resident, and M = Tm x CTM current.")
  (pc-ensure-font src ar dc a b st cx out f0 f1 f2 f3 fnt et)
  (pc-update-m cx)
  (if (< (cells-at cx C_SLOT) 0)
    (pc-warn-set cx W_TEXT))
  (return 0))

(defn ^I32 pc-op [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                  ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                  ^:mut ^Cells cs ^:mut ^Cells out
                  ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                  ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt
                  ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx ^I32 op ^I32 n]
  (comment "Execute one operator; `ox` holds its n operands. Unknown operators do")
  (comment "nothing (their operands are dropped by the caller).")
  (if (== op OP_SAVE)
    (do (pc-save cx) (return 0)))
  (if (== op OP_RESTORE)
    (do (pc-restore cx) (return 0)))
  (if (== op OP_CM)
    (do (if (>= n 6)
          (do (mx-set cx C_TMP (pc-num ox n 0) (pc-num ox n 1) (pc-num ox n 2)
                      (pc-num ox n 3) (pc-num ox n 4) (pc-num ox n 5))
              (mx-mul cx (+ C_CUR G_CTM) C_TMP (+ C_CUR G_CTM))))
        (return 0)))
  (if (== op OP_BT)
    (do (mx-ident cx C_TM)
        (mx-ident cx C_TLM)
        (cells-set cx C_INTEXT 1)
        (cells-set cx C_TCN 0)
        (return 0)))
  (if (== op OP_ET)
    (do (cells-set cx C_INTEXT 0)
        (if (> (cells-at cx C_TCN) 0)
          (do (comment "Glyphs shown in a clipping render mode (4 to 7) clip to their boxes' union (a superset of the glyphs).")
              (pc-clip-box cx pa (cells-at cx C_TCX0) (cells-at cx C_TCY0) (cells-at cx C_TCX1) (cells-at cx C_TCY1)
                           (pa-other) 0 -1 0)
              (cells-set cx C_TCN 0)))
        (return 0)))
  (if (== op OP_TF)
    (do (pc-tf src ar dc a b st cx ox n) (return 0)))
  (if (== op OP_TCHAR)
    (do (fx-put cx (+ C_CUR G_TC) (pc-num ox n 0)) (return 0)))
  (if (== op OP_TWORD)
    (do (fx-put cx (+ C_CUR G_TW) (pc-num ox n 0)) (return 0)))
  (if (== op OP_TSCALE)
    (do (fx-put cx (+ C_CUR G_TH) (fx-muldiv (pc-num ox n 0) (i64 1) (i64 100))) (return 0)))
  (if (== op OP_TLEAD)
    (do (fx-put cx (+ C_CUR G_TL) (pc-num ox n 0)) (return 0)))
  (if (== op OP_TRISE)
    (do (fx-put cx (+ C_CUR G_RISE) (pc-num ox n 0)) (return 0)))
  (if (== op OP_TMODE)
    (do (cells-set cx (+ C_CUR G_MODE) (fx-round (pc-num ox n 0))) (return 0)))
  (if (== op OP_TD)
    (do (pc-td cx (pc-num ox n 0) (pc-num ox n 1)) (return 0)))
  (if (== op OP_TDL)
    (do (fx-put cx (+ C_CUR G_TL) (- (i64 0) (pc-num ox n 1)))
        (pc-td cx (pc-num ox n 0) (pc-num ox n 1))
        (return 0)))
  (if (== op OP_TM)
    (do (if (>= n 6)
          (pc-set-tm cx (pc-num ox n 0) (pc-num ox n 1) (pc-num ox n 2)
                     (pc-num ox n 3) (pc-num ox n 4) (pc-num ox n 5)))
        (return 0)))
  (if (== op OP_TSTAR)
    (do (pc-next-line cx) (return 0)))
  (if (== op OP_SHOW)
    (do (if (and (>= n 1) (== (pc-kind ox 0) K_STR))
          (do (pc-prep src ar dc a b st cx out f0 f1 f2 f3 fnt et)
              (pc-show-str cx ox gl et f0 f1 f2 f3 0)))
        (return 0)))
  (if (== op OP_SHOWARR)
    (do (if (and (>= n 1) (== (pc-kind ox 0) K_ARR))
          (do (pc-prep src ar dc a b st cx out f0 f1 f2 f3 fnt et)
              (pc-show-arr cx ox gl et f0 f1 f2 f3 0)))
        (return 0)))
  (if (== op OP_QUOTE)
    (do (if (and (>= n 1) (== (pc-kind ox 0) K_STR))
          (do (pc-next-line cx)
              (pc-prep src ar dc a b st cx out f0 f1 f2 f3 fnt et)
              (pc-show-str cx ox gl et f0 f1 f2 f3 0)))
        (return 0)))
  (if (== op OP_DQUOTE)
    (do (if (and (>= n 3) (== (pc-kind ox 2) K_STR))
          (do (fx-put cx (+ C_CUR G_TW) (pc-num ox n 0))
              (fx-put cx (+ C_CUR G_TC) (pc-num ox n 1))
              (pc-next-line cx)
              (pc-prep src ar dc a b st cx out f0 f1 f2 f3 fnt et)
              (pc-show-str cx ox gl et f0 f1 f2 f3 2)))
        (return 0)))
  (if (== op OP_DO)
    (do (pc-do src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pa im pts gx n) (return 0)))
  (if (== op OP_BDC)
    (do (pc-mc-begin src ar dc a b st cx ox gl et mk fnt gx n 1) (return 0)))
  (if (== op OP_BMC)
    (do (pc-mc-begin src ar dc a b st cx ox gl et mk fnt gx n 0) (return 0)))
  (if (== op OP_EMC)
    (do (pc-mc-end cx mk gl) (return 0)))
  (if (== op OP_BI)
    (do (pc-inline-image cx ox cs im)
        (pc-skip-inline cx cs)
        (return 0)))
  (comment "Colour: the device operators, the named spaces, the components.")
  (if (== op OP_GRAY)
    (do (pc-color-device cx ox gx n 0 1) (return 0)))
  (if (== op OP_RGB)
    (do (pc-color-device cx ox gx n 0 2) (return 0)))
  (if (== op OP_CMYK)
    (do (pc-color-device cx ox gx n 0 3) (return 0)))
  (if (== op OP_GRAY_S)
    (do (pc-color-device cx ox gx n 1 1) (return 0)))
  (if (== op OP_RGB_S)
    (do (pc-color-device cx ox gx n 1 2) (return 0)))
  (if (== op OP_CMYK_S)
    (do (pc-color-device cx ox gx n 1 3) (return 0)))
  (if (or (== op OP_SC) (== op OP_SCN))
    (do (pc-sc-op src ar dc a b st out cx ox gx n 0) (return 0)))
  (if (or (== op OP_SC_S) (== op OP_SCN_S))
    (do (pc-sc-op src ar dc a b st out cx ox gx n 1) (return 0)))
  (if (== op OP_CS)
    (do (pc-cs-op src ar dc a b st out cx ox gx n 0) (return 0)))
  (if (== op OP_CS_S)
    (do (pc-cs-op src ar dc a b st out cx ox gx n 1) (return 0)))
  (if (== op OP_GS)
    (do (pc-gs-op src ar dc a b st cx ox n) (return 0)))
  (comment "Paths: construction, painting, clipping.")
  (if (== op OP_MOVE)
    (do (pc-op-move cx pts ox n) (return 0)))
  (if (== op OP_LINE)
    (do (pc-op-line cx pts ox n) (return 0)))
  (if (== op OP_CURVE)
    (do (pc-op-curve cx pts ox n 0) (return 0)))
  (if (== op OP_CURVE_V)
    (do (pc-op-curve cx pts ox n 1) (return 0)))
  (if (== op OP_CURVE_Y)
    (do (pc-op-curve cx pts ox n 2) (return 0)))
  (if (== op OP_CLOSE)
    (do (pc-op-close cx pts) (return 0)))
  (if (== op OP_RECT)
    (do (pc-op-rect cx pts ox n) (return 0)))
  (if (or (== op OP_STROKE) (or (== op OP_CLOSESTROKE) (or (== op OP_FILL) (or (== op OP_FILL2) (or (== op OP_FILLEO)
          (or (== op OP_FS) (or (== op OP_FSEO) (or (== op OP_CFS) (== op OP_CFSEO)))))))))
    (do (pc-paint-op cx pa pts op) (return 0)))
  (if (== op OP_ENDPATH)
    (do (pc-end-path cx pa pts 0 0 0 0) (return 0)))
  (if (== op OP_CLIP)
    (do (cells-set cx C_CLIPP 1) (return 0)))
  (if (== op OP_CLIPEO)
    (do (cells-set cx C_CLIPP 2) (return 0)))
  (if (== op OP_SH)
    (do (pc-sh-op cx pa) (return 0)))
  (if (== op OP_LW)
    (do (fx-put cx (+ C_CUR G_LW) (pc-num ox n 0)) (return 0)))
  (if (== op OP_DASH)
    (do (pc-dash-op cx ox n) (return 0)))
  (return 0))

;; ------------------------------------------------------------------ the loop

(defn ^I32 pc-run [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                   ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                   ^:mut ^Cells cs ^:mut ^Cells out
                   ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                   ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt
                   ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx
                   ^I32 start ^I32 end]
  (comment "Run the content bytes cs[start, end): read operands, then execute each")
  (comment "operator. The caller's lexer position, graphics-state floor and marked-")
  (comment "content floor are kept and restored, so a form can run inside an operator.")
  (let [^I32 oldpos (cells-at cx C_POS)
        ^I32 oldend (cells-at cx C_END)
        ^I32 oldgs (cells-at cx C_GSBASE)
        ^I32 oldmcb (cells-at cx C_MCBASE)
        ^I32 oldover (cells-at cx C_MCOVER)
        ^I32 oldtop (cells-at cx C_MCTOP)
        ^:mut ^I32 r 1
        ^:mut ^I32 opc 0
        ^:mut ^I32 nop 0
        ^:mut ^I32 ops 0]
    (cells-set cx C_POS start)
    (cells-set cx C_END end)
    (cells-set cx C_GSBASE (cells-at cx C_DEPTH))
    (cells-set cx C_MCBASE (cells-at cx C_MCDEPTH))
    (cells-set cx C_MCOVER 0)
    (pc-ox-clear cx ox)
    (while (and (!= r 0) (== (cells-at cx C_ABORT) 0))
      (do (set r (pc-lex cx ox cs))
          (if (== r 2)
            (do (set ops (+ (cells-at cx C_OPS) 1))
                (cells-set cx C_OPS ops)
                (if (> ops (cells-at cx C_OPLIM))
                  (limit-breach 5 ops))
                (set opc (cells-at cx C_OP))
                (set nop (cells-at cx C_OXN))
                (pc-op src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pa im pts gx opc nop)
                (pc-ox-clear cx ox)))))
    (comment "What the stream left open: spans, graphics states.")
    (while (> (cells-at cx C_MCDEPTH) (cells-at cx C_MCBASE))
      (do (pc-warn-set cx W_MC)
          (pc-mc-pop cx mk gl 1)))
    (while (> (cells-at cx C_DEPTH) (cells-at cx C_GSBASE))
      (cells-set cx C_DEPTH (- (cells-at cx C_DEPTH) 1)))
    (cells-set cx C_MCTOP oldtop)
    (cells-set cx C_CUROCG (mk-ocg-of mk oldtop))
    (cells-set cx C_MCOVER oldover)
    (cells-set cx C_MCBASE oldmcb)
    (cells-set cx C_GSBASE oldgs)
    (cells-set cx C_POS oldpos)
    (cells-set cx C_END oldend)
    (return 0)))

;; --------------------------------------------------------- words and lines
;; Grouping is done in page space from the glyph boxes, after the page is read,
;; in the order the content stream showed the glyphs (SPEC 8.1: the stream order is
;; kept as one weak reading-order signal; ordering the lines on the page is P1.8's).
;; The four WRITING AXES are the multiples of 90 degrees the glyphs' rotation is
;; nearest to: 0 runs left to right, 1 bottom to top (rot 90), 2 right to left,
;; 3 top to bottom. A glyph's DISPLACEMENT is measured along the axis, and its
;; OFFSET across it: the baseline's y for 0 and 2, the box's right edge (the
;; baseline, since the glyph's top points left) for 1, its left edge for 3.

(defconst ^I32 WORD_GAP_PM 160)      ;; a gap wider than this per-mille of the size ends a word
(defconst ^I32 WORD_BACK_PM 400)     ;; going back further than this per-mille of the size ends a word
(defconst ^I32 OFFSET_PM 450)        ;; an offset across the axis beyond this ends a word or a line
(defconst ^I32 LINE_BACK_PM 600)
(defconst ^I32 LINE_GAP_PM 2000)     ;; a gap beyond 2 sizes ends a line (as pdfminer's char_margin)

(defn ^I32 pc-axis [^I32 rot]
  (comment "The writing axis a rotation is within three degrees of, else -1 (a glyph run")
  (comment "at another angle is measured along its own direction, `pc-rot-gap`).")
  (let [^I32 a (rem (quot (+ rot 4500) 9000) 4)
        ^:mut ^I32 d (- rot (* a 9000))]
    (if (< d 0) (set d (- 0 d)))
    (if (> d 18000) (set d (- 36000 d)))
    (if (<= d 300) (return a))
    (return -1)))

(defn ^I32 pc-offset [^Cells gl ^I32 j ^I32 axis]
  (comment "Where glyph j's baseline is across its writing axis, in centipoints.")
  (if (== axis 1) (return (gl-get gl j (ch-x1))))
  (if (== axis 3) (return (gl-get gl j (ch-x0))))
  (return (gl-get gl j (gf-by0))))

(defn ^I32 pc-gap [^Cells gl ^I32 p ^I32 g ^I32 axis]
  (comment "The space along the axis between glyph p and the glyph g after it")
  (comment "(negative when they overlap or g is before p).")
  (if (== axis 0) (return (- (gl-get gl g (ch-x0)) (gl-get gl p (ch-x1)))))
  (if (== axis 2) (return (- (gl-get gl p (ch-x0)) (gl-get gl g (ch-x1)))))
  (if (== axis 1) (return (- (gl-get gl p (ch-y0)) (gl-get gl g (ch-y1)))))
  (return (- (gl-get gl g (ch-y0)) (gl-get gl p (ch-y1)))))

(defn ^I32 pc-rot-gap [^Cells gl ^I32 p ^I32 g ^I32 size]
  (comment "For text at an arbitrary angle: the distance between glyph p's centre and")
  (comment "glyph g's, along the writing direction, less 60 percent of the size (the")
  (comment "two half-advances of adjacent letters), so it reads as `pc-gap` does.")
  (let [^I32 rot (gl-get gl p (gf-rot))
        ^I64 ux (fx-cos rot)
        ^I64 uy (- (i64 0) (fx-sin rot))
        ^I32 dx2 (- (+ (gl-get gl g (ch-x0)) (gl-get gl g (ch-x1))) (+ (gl-get gl p (ch-x0)) (gl-get gl p (ch-x1))))
        ^I32 dy2 (- (+ (gl-get gl g (ch-y0)) (gl-get gl g (ch-y1))) (+ (gl-get gl p (ch-y0)) (gl-get gl p (ch-y1))))
        ^I64 al2 (add64 (fx-mul (fx-of-int dx2) ux) (fx-mul (fx-of-int dy2) uy))]
    (return (- (fx-round (quot al2 (i64 2))) (quot (* size 600) 1000)))))

(defn ^I32 pc-rot-off [^Cells gl ^I32 p ^I32 g]
  (comment "The distance between the two glyphs' centres across the writing direction.")
  (let [^I32 rot (gl-get gl p (gf-rot))
        ^I64 sn (fx-sin rot)
        ^I64 cs (fx-cos rot)
        ^I32 dx2 (- (+ (gl-get gl g (ch-x0)) (gl-get gl g (ch-x1))) (+ (gl-get gl p (ch-x0)) (gl-get gl p (ch-x1))))
        ^I32 dy2 (- (+ (gl-get gl g (ch-y0)) (gl-get gl g (ch-y1))) (+ (gl-get gl p (ch-y0)) (gl-get gl p (ch-y1))))
        ^I32 pe (fx-round (quot (add64 (fx-mul (fx-of-int dx2) sn) (fx-mul (fx-of-int dy2) cs)) (i64 2)))]
    (if (< pe 0) (return (- 0 pe)))
    (return pe)))

(defn ^I32 pc-pair-gap [^Cells gl ^I32 p ^I32 g ^I32 axis ^I32 size]
  (if (< axis 0) (return (pc-rot-gap gl p g size)))
  (return (pc-gap gl p g axis)))

(defn ^I32 pc-pair-off [^Cells gl ^I32 p ^I32 g ^I32 axis]
  (comment "How far glyph g's baseline is from glyph p's, across the writing axis.")
  (if (< axis 0) (return (pc-rot-off gl p g)))
  (let [^I32 d (- (pc-offset gl p axis) (pc-offset gl g axis))]
    (if (< d 0) (return (- 0 d)))
    (return d)))

(defn ^I32 pc-space-cp [^I32 cp]
  (comment "1 for a code point that separates words: the spaces (U+0020, U+00A0,")
  (comment "U+1680, U+2000..200A, U+202F, U+205F, U+3000) and the tab.")
  (if (or (== cp 32) (or (== cp 160) (or (== cp 9) (or (== cp 5760) (or (== cp 8239) (or (== cp 8287) (== cp 12288)))))))
    (return 1))
  (if (and (>= cp 8192) (<= cp 8202)) (return 1))
  (return 0))

(defn ^I32 pc-cl [^I32 v]
  (comment "Clamp a distance to +-1,000,000 centipoints so a per-mille product fits an I32.")
  (if (> v 1000000) (return 1000000))
  (if (< v -1000000) (return -1000000))
  (return v))

(defn ^I32 pc-rot-same [^I32 r1 ^I32 r2]
  (comment "1 when two rotations (centi-degrees) agree to half a degree.")
  (let [^:mut ^I32 d (- r1 r2)]
    (if (< d 0) (set d (- 0 d)))
    (if (> d 18000) (set d (- 36000 d)))
    (if (<= d 50) (return 1))
    (return 0)))

(defn ^I32 pc-hidden-mode [^I32 mode]
  (comment "1 for the invisible render modes, 3 and 7.")
  (if (or (== mode 3) (== mode 7)) (return 1))
  (return 0))

(defn ^I32 pc-continues [^Cells gl ^I32 p ^I32 g]
  (comment "1 when glyph g continues the word glyph p is in: the same rotation, on the")
  (comment "same baseline (to 45 percent of the size: sub- and superscripts stay), and")
  (comment "the gap along the axis neither a word space nor a step back.")
  (let [^I32 rot (gl-get gl p (gf-rot))
        ^I32 axis (pc-axis rot)
        ^I32 size (gl-get gl g (gf-size))
        ^I32 sizep (gl-get gl p (gf-size))
        ^:mut ^I32 sz size
        ^:mut ^I32 gap 0
        ^:mut ^I32 off 0]
    (if (== (pc-rot-same rot (gl-get gl g (gf-rot))) 0) (return 0))
    (comment "A word is one thing to see: a glyph of another visibility, or one that is hidden (mode 3, 7) where the other")
    (comment "is not, starts a new word (P3.6).")
    (if (!= (gl-get gl p (gf-vis)) (gl-get gl g (gf-vis))) (return 0))
    (if (!= (pc-hidden-mode (gl-get gl p (gf-mode))) (pc-hidden-mode (gl-get gl g (gf-mode)))) (return 0))
    (if (> sizep sz) (set sz sizep))
    (if (> sz 200000) (set sz 200000))
    (if (< sz (- 0 200000)) (set sz (- 0 200000)))
    (set off (pc-cl (pc-pair-off gl p g axis)))
    (if (> (* off 1000) (* sz OFFSET_PM)) (return 0))
    (set gap (pc-cl (pc-pair-gap gl p g axis sz)))
    (if (> (* gap 1000) (* sz WORD_GAP_PM)) (return 0))
    (if (< (* gap 1000) (- 0 (* sz WORD_BACK_PM))) (return 0))
    (return 1)))

(defn ^I32 pc-gcls [^Cells gl ^I32 j]
  (comment "1 when glyph j stands for a strong right-to-left LETTER (Hebrew, Arabic, Syriac, ...: the Unicode class R or")
  (comment "AL), 2 for a strong left-to-right letter, else 0. Letters decide the direction of a word and of a line (D162);")
  (comment "a digit, a separator or a mark does not.")
  (return (bd-strong (gl-get gl j (ch-cp)))))

(defn ^I32 pc-glyph-out [^:mut ^Cells et ^Cells gl ^I32 j ^I32 lvl]
  (comment "Append glyph j's text (every code point it stands for, or U+FFFD) to the evidence text. At bidi level 1")
  (comment "(lvl, L4) a text of ONE code point whose character is mirrored (a bracket) is the mirror: the glyph on the")
  (comment "page was drawn as the mirror image of the character it stands for.")
  (let [^I32 ts (gl-get gl j (ch-tstart))
        ^I32 tl (gl-get gl j (ch-tlen))
        ^:mut ^I32 cp (gl-get gl j (ch-cp))
        ^:mut ^I32 k 0
        ^:mut ^I32 cpv 0]
    (if (and (>= ts 0) (> tl 0))
      (do (while (< k tl)
            (do (set cpv (cells-at et (+ ts k)))
                (if (and (== lvl 1) (== tl 1)) (set cpv (bd-mirror cpv)))
                (etx-append-cp et cpv)
                (set k (+ k 1))))
          (return 0)))
    (if (>= cp 0)
      (do (if (== lvl 1) (set cp (bd-mirror cp)))
          (etx-append-cp et cp))
      (etx-append-cp et 65533))
    (return 0)))

(defn ^I32 pc-bidi-text [^:mut ^Cells et ^Cells gl ^I32 gfst ^I32 glst]
  (comment "Append the text of glyphs [gfst, glst], which were SHOWN left to right, in LOGICAL order of a right-to-left")
  (comment "paragraph (`emon.bidi`, D162): the order the Bidirectional Algorithm would display them in. It is written")
  (comment "where the arena ended, moved down over the scratch the algorithm used, and the index it starts at is the")
  (comment "answer. (The scratch is the arena's own tail: the algorithm owns no memory.)")
  (let [^I32 n (+ (- glst gfst) 1)
        ^I32 b (cells-len et)
        ^:mut ^I32 j 0
        ^:mut ^I32 o 0
        ^:mut ^I32 e 0
        ^:mut ^I32 i 0
        ^:mut ^I32 lv 0
        ^:mut ^I32 k 0]
    (while (< j n)
      (do (cells-push et (gl-get gl (+ gfst j) (ch-cp)))
          (set j (+ j 1))))
    (set o (bd-order-of et b n))
    (set e (cells-len et))
    (set j 0)
    (while (< j n)
      (do (set i (cells-at et (+ o j)))
          (set lv (cells-at et (+ (- o n) i)))
          (pc-glyph-out et gl (+ gfst i) lv)
          (set j (+ j 1))))
    (set k 0)
    (while (< k (- (cells-len et) e))
      (do (cells-set et (+ b k) (cells-at et (+ e k)))
          (set k (+ k 1))))
    (cells-drop et (+ b (- (cells-len et) e)))
    (return b)))

(defn ^I32 pc-emit-word [^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells wd ^:mut ^Cells fnt
                         ^I32 page ^I32 gfst ^I32 glst ^I32 wbk]
  (comment "Record glyphs [gfst, glst] as a word: the union of their boxes, their text, the")
  (comment "dominant font and size of the first, and `hidden-text` as its source when every")
  (comment "glyph is render mode 3. A right-to-left word whose glyphs run left to right on the")
  (comment "page (visual order, as Skia and most producers write them) has its TEXT written in")
  (comment "logical order by the Bidirectional Algorithm (`pc-bidi-text`, D162): numbers and their separators,")
  (comment "Latin runs, brackets and the neutrals between them as UAX #9 resolves them, not letter by letter. A word")
  (comment "with no letter to say so (\"2026,\") is put right once its line is known to be right to left")
  (comment "(`pc-word-fix`). The glyphs themselves stay as they were shown.")
  (let [^:mut ^I32 x0 (gl-get gl gfst (ch-x0))
        ^:mut ^I32 y0 (gl-get gl gfst (ch-y0))
        ^:mut ^I32 x1 (gl-get gl gfst (ch-x1))
        ^:mut ^I32 y1 (gl-get gl gfst (ch-y1))
        ^:mut ^I32 j gfst
        ^:mut ^I32 tstart -1
        ^:mut ^I32 visible 0
        ^:mut ^I32 nr 0
        ^:mut ^I32 nl 0
        ^:mut ^I32 cl 0
        ^:mut ^I32 rtlw 0]
    (while (<= j glst)
      (do (if (< (gl-get gl j (ch-x0)) x0) (set x0 (gl-get gl j (ch-x0))))
          (if (< (gl-get gl j (ch-y0)) y0) (set y0 (gl-get gl j (ch-y0))))
          (if (> (gl-get gl j (ch-x1)) x1) (set x1 (gl-get gl j (ch-x1))))
          (if (> (gl-get gl j (ch-y1)) y1) (set y1 (gl-get gl j (ch-y1))))
          (if (and (!= (gl-get gl j (gf-mode)) 3) (!= (gl-get gl j (gf-mode)) 7)) (set visible 1))
          (set cl (pc-gcls gl j))
          (if (== cl 1) (set nr (+ nr 1)))
          (if (== cl 2) (set nl (+ nl 1)))
          (set j (+ j 1))))
    (if (and (> nr nl) (> glst gfst))
      (if (== (pc-axis (gl-get gl gfst (gf-rot))) 0)
        (if (>= (gl-get gl glst (ch-x0)) (gl-get gl gfst (ch-x0)))
          (set rtlw 1))))
    (set tstart (cells-len et))
    (if (== rtlw 0)
      (do (set j gfst)
          (while (<= j glst)
            (do (pc-glyph-out et gl j 2)
                (set j (+ j 1)))))
      (set tstart (pc-bidi-text et gl gfst glst)))
    (let [^I32 w (wd-new wd page x0 y0 x1 y1
                         (gl-get gl gfst (gf-bx0)) (gl-get gl gfst (gf-by0))
                         (gl-get gl glst (gf-bx1)) (gl-get gl glst (gf-by1))
                         (gl-get gl gfst (gf-rot)) 0 tstart (- (cells-len et) tstart) -1 -1 -1)
          ^I32 fo (gl-get gl gfst (gf-font))]
      (if (== rtlw 1) (wd-set wd w (hd-dir) (ld-rtl)))
      (wd-set wd w (wf-gfirst) gfst)
      (wd-set wd w (wf-gcount) (+ (- glst gfst) 1))
      (wd-set wd w (wf-font) fo)
      (wd-set wd w (wf-size) (gl-get gl gfst (gf-size)))
      (if (and (>= fo 0) (< fo (fo-count fnt)))
        (wd-set wd w (wf-style) (fo-get fnt fo (fnf-style))))
      (wd-set wd w (wf-wbreak) wbk)
      (if (== visible 0) (wd-set wd w (wf-src) (sr-hidden-text)))
      (set j gfst)
      (while (<= j glst)
        (do (gl-set gl j (ch-word) w)
            (set j (+ j 1))))
      (return w))))

;; right-to-left lines: the words in logical order

(defn ^I32 pc-swap-rows [^:mut ^Cells wd ^I32 i ^I32 j]
  (let [^:mut ^I32 k 0
        ^:mut ^I32 u 0
        ^:mut ^I32 v 0]
    (while (< k 24)
      (do (set u (cells-at wd (+ (* i 24) k)))
          (set v (cells-at wd (+ (* j 24) k)))
          (cells-set wd (+ (* i 24) k) v)
          (cells-set wd (+ (* j 24) k) u)
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 pc-rev-rows [^:mut ^Cells wd ^I32 a ^I32 b]
  (let [^:mut ^I32 i a
        ^:mut ^I32 j b]
    (while (< i j)
      (do (pc-swap-rows wd i j)
          (set i (+ i 1))
          (set j (- j 1))))
    (return 0)))

(defn ^I32 pc-wcls [^Cells gl ^Cells wd ^I32 w]
  (comment "What a word is to the order of the words of a right-to-left line: 1 when it has a right-to-left letter,")
  (comment "2 when it has a left-to-right letter and no right-to-left one, 3 when it is only numbers (and what goes")
  (comment "with them), 0 when it is only neutrals (a dash, a bullet).")
  (let [^I32 g0 (wd-get wd w (wf-gfirst))
        ^I32 gn (wd-get wd w (wf-gcount))
        ^:mut ^I32 j 0
        ^:mut ^I32 nr 0
        ^:mut ^I32 nl 0
        ^:mut ^I32 nn 0
        ^:mut ^I32 cl 0]
    (while (< j gn)
      (do (set cl (pc-gcls gl (+ g0 j)))
          (if (== cl 1) (set nr (+ nr 1)))
          (if (== cl 2) (set nl (+ nl 1)))
          (set cl (bd-class (gl-get gl (+ g0 j) (ch-cp))))
          (if (or (== cl 3) (== cl 4)) (set nn (+ nn 1)))
          (set j (+ j 1))))
    (if (> nr 0) (return 1))
    (if (> nl 0) (return 2))
    (if (> nn 0) (return 3))
    (return 0)))

(defn ^I32 pc-word-fix [^Cells gl ^:mut ^Cells et ^Cells wd ^I32 w]
  (comment "A word of a right-to-left line that `pc-emit-word` left in the order it was shown, because nothing in it")
  (comment "said it was right to left (\"2026,\", \"50%\", \"(1)\", \"ROI-\" before a Hebrew letter): when its glyphs run")
  (comment "left to right on the page they are in visual order, so its text is put in logical order, as a word that")
  (comment "says so is. Done in place: the same code points, in the order the algorithm gives; nothing moves if the")
  (comment "order does not change. Answers 1 when it changed the text.")
  (let [^I32 g0 (wd-get wd w (wf-gfirst))
        ^I32 gn (wd-get wd w (wf-gcount))
        ^I32 ts (wd-get wd w (hd-tstart))
        ^I32 tl (wd-get wd w (hd-tlen))
        ^I32 b (cells-len et)
        ^:mut ^I32 j 0
        ^:mut ^I32 o 0
        ^:mut ^I32 e 0
        ^:mut ^I32 i 0
        ^:mut ^I32 lv 0
        ^:mut ^I32 changed 0]
    (if (< gn 2) (return 0))
    (if (== (wd-get wd w (hd-dir)) (ld-rtl)) (return 0))
    (if (!= (pc-axis (gl-get gl g0 (gf-rot))) 0) (return 0))
    (if (< (gl-get gl (+ g0 (- gn 1)) (ch-x0)) (gl-get gl g0 (ch-x0))) (return 0))
    (while (< j gn)
      (do (cells-push et (gl-get gl (+ g0 j) (ch-cp)))
          (set j (+ j 1))))
    (set o (bd-order-of et b gn))
    (set j 0)
    (while (< j gn)
      (do (set i (cells-at et (+ o j)))
          (set lv (cells-at et (+ (- o gn) i)))
          (if (or (!= i j) (== lv 1)) (set changed 1))
          (set j (+ j 1))))
    (if (== changed 0)
      (do (cells-drop et b)
          (return 0)))
    (set e (cells-len et))
    (set j 0)
    (while (< j gn)
      (do (set i (cells-at et (+ o j)))
          (set lv (cells-at et (+ (- o gn) i)))
          (pc-glyph-out et gl (+ g0 i) lv)
          (set j (+ j 1))))
    (if (!= (- (cells-len et) e) tl)
      (do (cells-drop et b)
          (return 0)))
    (set j 0)
    (while (< j tl)
      (do (cells-set et (+ ts j) (cells-at et (+ e j)))
          (set j (+ j 1))))
    (cells-drop et b)
    (return 1)))

(defn ^I32 pc-line-bidi [^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells wd ^:mut ^Cells ln ^I32 lidx
                         ^I32 wfst ^I32 wlst]
  (comment "Line lidx holds words [wfst, wlst]. When more of its letters are right-to-left than left-to-right")
  (comment "it is a right-to-left line (`ld-rtl`). Its words that no letter put in logical order are put in it")
  (comment "(`pc-word-fix`); if the words run left to right on the page, their ORDER is made logical: reversed,")
  (comment "with each group of words that make one left-to-right run (Latin words, and the numbers and neutrals")
  (comment "between them, W7 and N1) turned back; each word's glyphs are re-pointed at it and its gap is the")
  (comment "space to the word that follows it in that order.")
  (let [^:mut ^I32 w wfst
        ^:mut ^I32 nr 0
        ^:mut ^I32 nl 0
        ^:mut ^I32 j 0
        ^:mut ^I32 cl 0
        ^:mut ^I32 a 0
        ^:mut ^I32 z 0
        ^:mut ^I32 s 0
        ^:mut ^I32 hasl 0
        ^:mut ^I32 rtl 0
        ^:mut ^I32 g0 0
        ^:mut ^I32 gn 0]
    (while (<= w wlst)
      (do (set g0 (wd-get wd w (wf-gfirst)))
          (set gn (wd-get wd w (wf-gcount)))
          (set j 0)
          (while (< j gn)
            (do (set cl (pc-gcls gl (+ g0 j)))
                (if (== cl 1) (set nr (+ nr 1)))
                (if (== cl 2) (set nl (+ nl 1)))
                (set j (+ j 1))))
          (set w (+ w 1))))
    (comment "A paragraph's direction is its own, not each line's: a short last line that is mostly Latin (a")
    (comment "product name, an acronym) after a right-to-left line is still right to left (UAX #9, P2 and P3 read")
    (comment "the paragraph, and the lines of one run on). So a line is right to left when its right-to-left")
    (comment "letters outnumber the left-to-right ones, or when the line before it (same page) is and this one has a")
    (comment "right-to-left letter or no left-to-right one (a number, a bullet).")
    (set rtl 0)
    (if (> nr nl) (set rtl 1))
    (if (and (> lidx 0) (== rtl 0))
      (if (== (ln-get ln (- lidx 1) (lh-page)) (ln-get ln lidx (lh-page)))
        (if (== (ln-get ln (- lidx 1) (lh-dir)) (ld-rtl))
          (if (or (> nr 0) (== nl 0))
            (set rtl 1)))))
    (if (== rtl 0) (return 0))
    (ln-set ln lidx (lh-dir) (ld-rtl))
    (set w wfst)
    (while (<= w wlst)
      (do (pc-word-fix gl et wd w)
          (set w (+ w 1))))
    (if (!= (pc-axis (gl-get gl (wd-get wd wfst (wf-gfirst)) (gf-rot))) 0) (return 0))
    (if (< (wd-get wd wlst (hd-x0)) (wd-get wd wfst (hd-x0))) (return 0))
    (if (== wfst wlst) (return 0))
    (pc-rev-rows wd wfst wlst)
    (comment "Now the rows are in logical order but for the left-to-right runs, which are backwards: a run is a")
    (comment "maximal stretch of words that are not right-to-left, holding at least one left-to-right word, less")
    (comment "the neutral-only words at its ends (they are between a left-to-right and a right-to-left word: N2).")
    (set a wfst)
    (while (<= a wlst)
      (if (== (pc-wcls gl wd a) 1)
        (set a (+ a 1))
        (do (set z a)
            (while (and (< z wlst) (!= (pc-wcls gl wd (+ z 1)) 1))
              (set z (+ z 1)))
            (set hasl 0)
            (set s a)
            (while (<= s z)
              (do (if (== (pc-wcls gl wd s) 2) (set hasl 1))
                  (set s (+ s 1))))
            (if (== hasl 1)
              (do (set s a)
                  (while (== (pc-wcls gl wd s) 0)
                    (set s (+ s 1)))
                  (set j z)
                  (while (== (pc-wcls gl wd j) 0)
                    (set j (- j 1)))
                  (pc-rev-rows wd s j)))
            (set a (+ z 1)))))
    (set w wfst)
    (while (<= w wlst)
      (do (set g0 (wd-get wd w (wf-gfirst)))
          (set gn (wd-get wd w (wf-gcount)))
          (set j 0)
          (while (< j gn)
            (do (gl-set gl (+ g0 j) (ch-word) w)
                (set j (+ j 1))))
          (set z -1)
          (if (< w wlst)
            (set z (- (wd-get wd w (hd-x0)) (wd-get wd (+ w 1) (hd-x1)))))
          (wd-set wd w (wf-gap) z)
          (set w (+ w 1))))
    (return 0)))

(defn ^:pub ^I32 pc-group [^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells wd ^:mut ^Cells ln
                           ^:mut ^Cells fnt ^I32 page ^I32 g0 ^I32 w0]
  (comment "Group the glyphs from g0 on into words, and the words from w0 on into lines.")
  (let [^I32 g1 (gl-count gl)
        ^:mut ^I32 i g0
        ^:mut ^I32 cur -1]
    (while (< i g1)
      (do (if (== (pc-space-cp (gl-get gl i (ch-cp))) 1)
            (do (if (>= cur 0)
                  (do (pc-emit-word gl et wd fnt page cur (- i 1) (wb-space))
                      (set cur -1))))
            (do (if (>= cur 0)
                  (if (== (pc-continues gl (- i 1) i) 0)
                    (do (pc-emit-word gl et wd fnt page cur (- i 1) (wb-gap))
                        (set cur -1))))
                (if (< cur 0) (set cur i))))
          (set i (+ i 1))))
    (if (>= cur 0)
      (do (pc-emit-word gl et wd fnt page cur (- g1 1) (wb-line-end))
          (set cur -1)))
    (comment "Lines: consecutive words on one baseline, in order.")
    (let [^I32 nw (wd-count wd)
          ^:mut ^I32 j w0
          ^:mut ^I32 lfirst -1
          ^:mut ^I32 prev -1
          ^:mut ^I32 lnx 0
          ^:mut ^I32 x0 0
          ^:mut ^I32 y0 0
          ^:mut ^I32 x1 0
          ^:mut ^I32 y1 0
          ^:mut ^I32 gf0 0
          ^:mut ^I32 gfp 0
          ^:mut ^I32 glast 0
          ^:mut ^I32 axis 0
          ^:mut ^I32 joins 0
          ^:mut ^I32 gap 0
          ^:mut ^I32 sz 0
          ^:mut ^I32 ord 0
          ^:mut ^I32 off 0]
      (while (<= j nw)
        (do (set joins 0)
            (if (and (< j nw) (>= prev 0))
              (do (set gf0 (wd-get wd j (wf-gfirst)))
                  (set gfp (wd-get wd prev (wf-gfirst)))
                  (set axis (pc-axis (gl-get gl gfp (gf-rot))))
                  (if (== (pc-rot-same (gl-get gl gfp (gf-rot)) (gl-get gl gf0 (gf-rot))) 1)
                    (do (set sz (gl-get gl gf0 (gf-size)))
                        (if (> (gl-get gl gfp (gf-size)) sz) (set sz (gl-get gl gfp (gf-size))))
                        (if (> sz 200000) (set sz 200000))
                        (if (< sz (- 0 200000)) (set sz (- 0 200000)))
                        (set glast (- (+ (wd-get wd prev (wf-gfirst)) (wd-get wd prev (wf-gcount))) 1))
                        (set off (pc-cl (pc-pair-off gl glast gf0 axis)))
                        (comment "The gap is between the previous word's LAST glyph and this word's first.")
                        (set gap (pc-cl (pc-pair-gap gl glast gf0 axis sz)))
                        (if (<= (* off 1000) (* sz OFFSET_PM))
                          (if (>= (* gap 1000) (- 0 (* sz LINE_BACK_PM)))
                            (if (<= (* gap 1000) (* sz LINE_GAP_PM))
                              (set joins 1))))))))
            (if (== joins 1)
              (do (wd-set wd prev (wf-gap) gap)
                  (set prev j))
              (do (comment "The line so far ends at `prev`: record it, then start a new one at j.")
                  (if (>= lfirst 0)
                    (do (set x0 (wd-get wd lfirst (hd-x0)))
                        (set y0 (wd-get wd lfirst (hd-y0)))
                        (set x1 (wd-get wd lfirst (hd-x1)))
                        (set y1 (wd-get wd lfirst (hd-y1)))
                        (set lnx lfirst)
                        (while (<= lnx prev)
                          (do (if (< (wd-get wd lnx (hd-x0)) x0) (set x0 (wd-get wd lnx (hd-x0))))
                              (if (< (wd-get wd lnx (hd-y0)) y0) (set y0 (wd-get wd lnx (hd-y0))))
                              (if (> (wd-get wd lnx (hd-x1)) x1) (set x1 (wd-get wd lnx (hd-x1))))
                              (if (> (wd-get wd lnx (hd-y1)) y1) (set y1 (wd-get wd lnx (hd-y1))))
                              (set lnx (+ lnx 1))))
                        (set gfp (wd-get wd lfirst (wf-gfirst)))
                        (set axis (pc-axis (gl-get gl gfp (gf-rot))))
                        (set ord (wd-get wd lfirst (wf-gfirst)))
                        (set lnx lfirst)
                        (while (<= lnx prev)
                          (do (if (< (wd-get wd lnx (wf-gfirst)) ord) (set ord (wd-get wd lnx (wf-gfirst))))
                              (set lnx (+ lnx 1))))
                        (comment "The baseline runs from the first word's start to the last word's end, in the")
                        (comment "order the words were SHOWN (the bidi step below re-orders the rows, not the page).")
                        (set lnx (ln-new ln page x0 y0 x1 y1
                                         (wd-get wd lfirst (hd-bx0)) (wd-get wd lfirst (hd-by0))
                                         (wd-get wd prev (hd-bx1)) (wd-get wd prev (hd-by1))
                                         (gl-get gl gfp (gf-rot)) 0 lfirst (+ (- prev lfirst) 1)))
                        (ln-set ln lnx (lf-order) ord)
                        (pc-line-bidi gl et wd ln lnx lfirst prev)
                        (wd-set wd prev (wf-wbreak) (wb-line-end))
                        (set gfp lfirst)
                        (while (<= gfp prev)
                          (do (wd-set wd gfp (hd-line) lnx)
                              (set gfp (+ gfp 1))))))
                  (set lfirst j)
                  (set prev j)))
            (set j (+ j 1))))
      (return 0))))

;; ------------------------------------------------------------- pages and documents

(defn ^I32 pc-begin-page [^:mut ^Cells cx ^I32 page]
  (comment "Reset everything a page owns; the fonts (the document's) stay.")
  (cells-set cx C_PAGE page)
  (cells-set cx C_WARN 0)
  (cells-set cx C_OPS 0)
  (cells-set cx C_ABORT 0)
  (cells-set cx C_POS 0)
  (cells-set cx C_END 0)
  (cells-set cx C_OXN 0)
  (cells-set cx C_CDEPTH 0)
  (cells-set cx C_OP 0)
  (cells-set cx C_RES 0)
  (cells-set cx C_SLOT -1)
  (cells-set cx C_DEPTH 0)
  (cells-set cx C_FDEPTH 0)
  (cells-set cx C_STM 0)
  (cells-set cx C_MCTOP -1)
  (cells-set cx C_MCDEPTH 0)
  (cells-set cx C_MCBASE 0)
  (cells-set cx C_MCOVER 0)
  (cells-set cx C_CUROCG -1)
  (cells-set cx C_Z 0)
  (cells-set cx C_INTEXT 0)
  (cells-set cx C_CLIPP 0)
  (cells-set cx C_TCN 0)
  (cells-set cx C_NPATH 0)
  (cells-set cx C_NIMG 0)
  (cells-set cx C_GSBASE 0)
  (mx-ident cx C_TM)
  (mx-ident cx C_TLM)
  (mx-ident cx C_M)
  (return 0))

(defn ^:pub ^I32 pc-page [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                          ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                          ^:mut ^Cells cs ^:mut ^Cells out
                          ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                          ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt
                          ^Cells pg ^I32 pi ^I32 page ^:mut ^Cells wd ^:mut ^Cells ln
                          ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx]
  (comment "Interpret page index pi of the page table pg (page number `page`, 1-based, is")
  (comment "what the evidence records): its content streams, then the words and lines.")
  (comment "Answers 0, or 7 (`need-bytes`) when the source missed: then nothing written is")
  (comment "to be used and the caller re-runs on a fresh view (D075).")
  (let [^I32 con (pd-pg-contents pg pi)
        ^I32 g0 (gl-count gl)
        ^I32 w0 (wd-count wd)
        ^I32 p0 (pa-count pa)
        ^I32 i0 (im-count im)
        ^I32 rot (pd-pg-rotate pg pi)
        ^I32 cw (- (pd-pg-crop pg pi 2) (pd-pg-crop pg pi 0))
        ^I32 ch (- (pd-pg-crop pg pi 3) (pd-pg-crop pg pi 1))
        ^:mut ^I32 el 0
        ^:mut ^I32 eh 0
        ^:mut ^I32 endcs 0]
    (pc-begin-page cx page)
    (cells-set cx C_PTS0 (pt-count pts))
    (pc-base-matrix cx (pd-pg-crop pg pi 0) (pd-pg-crop pg pi 1) (pd-pg-crop pg pi 2)
                    (pd-pg-crop pg pi 3) (pd-pg-rotate pg pi))
    (pc-gs-reset cx)
    (gx-page gx)
    (gx-oc-read src ar dc a b st gx)
    (if (or (== rot 90) (== rot 270))
      (do (cells-set cx C_PW ch)
          (cells-set cx C_PH cw))
      (do (cells-set cx C_PW cw)
          (cells-set cx C_PH ch)))
    (pc-path-reset cx pts)
    (cells-set cx C_RES (pd-pg-resources pg pi))
    (cells-drop cs 0)
    (if (!= con 0)
      (do (if (== (pl-kind-of ar con) 8)
            (pc-append-stream src ar dc a b st cx out cs con))
          (if (== (pl-kind-of ar con) 6)
            (do (set el (pl-first ar con))
                (while (and (!= el 0) (== (cells-at cx C_ABORT) 0))
                  (do (set eh (pd-resolve src ar dc a b st el))
                      (if (ps-missed src)
                        (cells-set cx C_ABORT 1))
                      (if (and (!= eh 0) (== (pl-kind-of ar eh) 8))
                        (pc-append-stream src ar dc a b st cx out cs eh))
                      (set el (pl-next ar el))))))))
    (if (== (cells-at cx C_ABORT) 1) (return 7))
    (set endcs (cells-len cs))
    (pc-run src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pa im pts gx 0 endcs)
    (if (== (cells-at cx C_ABORT) 1) (return 7))
    (if (ps-missed src) (return 7))
    (comment "The path in progress when the page ended never painted: its points are dropped.")
    (cells-drop pts (* (cells-at cx C_PPTS) 3))
    (pv-page gl mk pa im (cells-at cx C_PW) (cells-at cx C_PH) g0 p0 i0)
    (pc-group gl et wd ln fnt page g0 w0)
    (return 0)))

(defn ^:pub ^I32 pc-document [^Src src ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a
                              ^:mut ^Cells b ^:mut ^Cells st ^:mut ^Cells cx ^:mut ^Cells ox
                              ^:mut ^Cells cs ^:mut ^Cells out
                              ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                              ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt
                              ^:mut ^Cells pg ^:mut ^Cells wd ^:mut ^Cells ln
                              ^:mut ^Cells pa ^:mut ^Cells im ^:mut ^Cells pts ^:mut ^Cells gx]
  (comment "Every page of an opened document (`pd-open` has answered 0): clears `cx`,")
  (comment "then `pc-page` for each page. Answers 0, or 7 when the source missed.")
  (pc-init cx ox)
  (cells-drop fnt 0)
  (cells-drop gx 0)
  (let [^I32 n (pd-pages src ar dc a b st pg)
        ^:mut ^I32 i 0
        ^:mut ^I32 status 0]
    (if (< n 0) (return 7))
    (while (< i n)
      (do (set status (pc-page src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg i (+ i 1) wd ln pa im pts gx))
          (if (== status 7) (return 7))
          (set i (+ i 1))))
    (return 0)))
