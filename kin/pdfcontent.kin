;; The content-stream interpreter, text subset (P1.7; SPEC 3.4, 8.1; D076, D101-D104), writing evidence v2 (P1.12, D127).
;; emon's own module (D039), written from ISO 32000-1 section 8 (graphics) and
;; 9 (text), 14.6-14.8 (marked content, tagged PDF) and Annex D.
;;
;;   (pc-init cx ox)                        once per document (fonts forgotten)
;;   (pc-page W pg pi page wd ln)           one page: glyphs, marks, fonts, words, lines
;;   (pc-document W pg wd ln)               every page of an opened document
;;
;; `W` is the workspace every function takes, in this order (kin cannot allocate
;; and a Rust `Cells` cannot be borrowed twice, so every array is a parameter):
;;
;;   src ar dc a b st       the file and the document layer's workspace (`emon.pdfdoc`)
;;   cx                     the interpreter: one `Cells` of scalars, the graphics-state
;;                          stack, the font slots (layout below)
;;   ox                     the operands of the operator being read
;;   cs                     the decoded content bytes, one cell each: the page's
;;                          streams, then each Form XObject being run, on top
;;   out                    scratch for a decoded stream and for `pfn-load`
;;   f0 f1 f2 f3            FOUR FONT SLOTS (`emon.pdffont` keeps a font in one
;;                          `Cells`); least-recently-used replacement, so a page
;;                          that alternates among more than four fonts reloads them
;;   gl et mk fnt           the evidence's `glyphs`, `etext`, `marks` (D101's spans, folded in by D127) and `fonts`
;;                          (a row the first time the document shows a font; its index is its id) (SPEC 8.4.3)
;;
;; P3.5, P3.6 (D152-D157) ADD, to the text layer below: the whole graphics state (the clip in force as a `paths` row, the
;; stroking colour, colour spaces by `emon.pdfgfx`, `ca` and `CA`, the blend mode, a soft mask in force, the line width and
;; dash), paths and their painting as `paths` rows (geometry in `pts`), image placements (`Do` and inline) as `images`
;; rows, shadings as filled regions, optional-content spans for the state an `/OC` names, Form XObject `/BBox` clips, and
;; at the end of each page the visibility classification of `emon.pdfvis`. The arenas it writes are the evidence's `pa`
;; (`paths`), `im` (`images`), `pts` and the colour/optional-content workspace `gx` (all after `ln`).
;;
;; WHAT IT DOES, per operator. `q Q cm` (the graphics-state stack, depth 256),
;; `BT ET Tf Tc Tw Tz TL Ts Tr Td TD Tm T* Tj TJ ' "` (the text state and every
;; glyph shown, with its code point(s) and how they were obtained, from
;; `emon.pdffont`), `Do` on a Form XObject (recursive to FORM_DEPTH, its `/Matrix`
;; and `/Resources` applied, and a cycle skipped), `BDC BMC EMC` (every
;; marked-content span recorded with its tag, `/MCID`, `/Artifact` Type and
;; Subtype, `/ActualText`, `/Alt`, `/E`, `/Lang`, from an inline property list or
;; through `/Properties`, D076/D101), `g rg k sc scn cs` (the fill colour of a
;; glyph) and `gs` (`/ca`). Everything else (paths, images, shading, clipping, the
;; stroking colours, compatibility sections) is skipped with its operands
;; dropped; an inline image is skipped whole.
;;
;; THE PAGE SPACE is D009's: the crop box applied, `/Rotate` applied, origin at
;; the top left, y down, centipoints. It is done ONCE, in the base matrix the
;; current transformation matrix starts as, so every later coordinate is already
;; a page coordinate. Matrices are fixed point in `I64`, 24 fractional bits (`emon.fx`, D103).
;; A glyph's box is the bounding box, in page space, of its cell: its width from
;; the font, its height from the font's ascent and descent (NOT from the size).
;;
;; WHAT A GLYPH SAYS. Its code point is what `emon.pdffont` answers for the code, and `how` says how it
;; knew (`gh`); a code the font says nothing of, or says U+0000 or U+FFFD for (Skia writes <0000> for the
;; parts of a Devanagari conjunct), has no value: cp -1, how unknown. A glyph of unknown width takes half
;; an em (warning bit 128). The font's cell is its ascent and descent, a Type 3 font's its /FontBBox
;; times its /FontMatrix. Text in a font that cannot be loaded is shown all the same, with no values.
;;
;; WORDS AND LINES (`pc-group`, after the page is read; stream order kept). A glyph continues the word of
;; the one before it when their rotation agrees to half a degree, their baselines are within 45 per cent of
;; the size (sub- and superscripts stay), and the gap along the writing direction is at most 16 per cent of
;; the size and the step back at most 40: a space glyph (U+0020, U+00A0, the tab, ...) always ends a word.
;; Words join into a line while the next starts within 2 sizes of the last one's end (60 per cent of a size
;; back) on the same baseline: a wider gap is a column gutter or a table cell, the next stage's to decide.
;; Text at an angle off the four axes is measured along its own direction from the glyph centres. A
;; RIGHT-TO-LEFT word written in visual order has its text put in logical order, and the words of a
;; right-to-left line likewise (D104); the glyphs stay as they were shown.
;;
;; A SOURCE THAT MISSES (D058, D074, D075): after every object the document layer
;; loads for this module (a font, a resource, a stream) the view is checked, and on
;; a miss the run stops and answers `need-bytes` (7): nothing it wrote is to be
;; used, the caller re-runs on a fresh view. A miss is never taken for a missing
;; font or a short stream.
;;
;; BOUNDS: operands per operator 4,096 (the rest dropped, warning bit 2);
;; containers nest 16 deep; graphics states 256; marked-content spans 256 deep;
;; forms FORM_DEPTH (`limit-of` kind 6, 32 by default; deeper ones, and a form that draws itself, are
;; skipped with warning bit 16, since a cycle in a damaged file is not a reason to refuse the page);
;; operators per page OPERATORS (kind 5; a breach never returns).
(ns emon.pdfcontent
  (:require [emon.lang :refer [I32 I64 Src Cells i64 i32 add64 mul64]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop
                               limit-of limit-breach]]
            [emon.pdfsrc :refer [ps-missed]]
            [emon.pdfgfx :refer [gx-page gx-key-of gx-lookup gx-entry-rgb gx-initial gx-class gx-ncomp
                                 gx-is-pattern gx-input gx-oc-read gx-oc-state]]
            [emon.pdfvis :refer [pv-page]]
            [emon.pdfimage :refer [pi-orient]]
            [emon.pdfx :refer [px-dget px-get px-is px-nth px-int-of px-is-num]]
            [emon.pdfxnames :refer [px-ca px-bm px-s-mask px-s px-lw px-image-mask px-mask px-oc px-h px-im
                                    px-alpha px-normal px-compatible px-multiply px-screen px-overlay
                                    px-darken px-lighten px-color-dodge px-color-burn px-hard-light
                                    px-soft-light px-difference px-exclusion px-hue px-saturation
                                    px-color px-luminosity px-chars-at px-span-at]]
            [emon.pdfnames :refer [pn-font pn-x-object pn-ext-g-state pn-properties
                                   pn-subtype pn-form pn-matrix pn-resources pn-type
                                   pn-lang pn-mcid pn-actual-text pn-alt pn-e
                                   pn-artifact pn-pagination pn-layout pn-background
                                   pn-watermark pn-header pn-footer pn-page
                                   pn-device-gray pn-device-rgb pn-device-cmyk pn-ca
                                   pn-span-at pn-chars-at pn-base-font pn-color-space pn-image pn-b-box pn-pattern pn-width pn-height
                                   pn-w]]
            [emon.pdflex :refer [pl-kind-of pl-first pl-next pl-count pl-int-value
                                 pl-name-is pl-name-len pl-name-byte pl-str-len
                                 pl-str-byte pl-stream-dict pl-dict-get pl-num-cp pl-ref-gen]]
            [emon.pdfdoc :refer [pd-resolve pd-dget pd-dint pd-get pd-stream-data pd-pg-count
                                 pd-pg-crop pd-pg-rotate pd-pg-resources
                                 pd-pg-contents pd-pages]]
            [emon.pdffont :refer [pfn-init pfn-load pfn-map pfn-cp pfn-how-of
                                  pfn-width pfn-code-len pfn-ascent pfn-descent
                                  pfn-vertical pfn-dw2-v pfn-dw2-w pfn-kind-of pfn-subtype pfn-flags
                                  pfn-has-tounicode pfn-encoding]]
            [emon.model :refer [sr-hidden-text sy-bold sy-italic sy-mono sy-smallcaps]]
            [emon.bidi :refer [bd-class bd-strong bd-mirror bd-order-of]]
            [emon.evidence :refer [gl-new gl-set gl-get gl-count etx-append-cp
                                   wd-new wd-get wd-set wd-count ln-new ln-set ln-get lh-page
                                   mk-open mk-close mk-get mk-set mk-ocg-of
                                   fo-new fo-get fo-set fo-count
                                   ev-angle
                                   wf-gfirst wf-gcount wf-font wf-size wf-src wf-gap wf-style wf-wbreak
                                   hd-x0 hd-y0 hd-x1 hd-y1 hd-tstart hd-tlen hd-line
                                   lh-rot lh-dir lf-src lf-order ld-rtl hd-dir hd-x0 hd-bx0 hd-by0 hd-bx1 hd-by1 fnf-style
                                   ch-page ch-x0 ch-y0 ch-x1 ch-y1 ch-cp ch-tstart ch-tlen ch-word
                                   gf-bx0 gf-by0 gf-bx1 gf-by1 gf-asc gf-desc gf-rot gf-how gf-font gf-size gf-mode
                                   gf-fill gf-falpha gf-cs gf-z gf-mark gf-ocg gf-stroke gf-salpha gf-clip gf-vchk gf-vis
                                   pa-new pa-get pa-set pa-count im-new im-set im-count pt-add pt-get pt-count
                                   ptf-x ptf-y ptf-op po-move po-line po-curve po-close
                                   pf-x0 pf-y0 pf-x1 pf-y1 pf-fill pf-stroke pf-width pf-falpha pf-salpha pf-flags
                                   pf-z pf-clip pf-mark pf-ocg pf-pfirst pf-pcount pf-dash
                                   pa-line pa-rect pa-curve pa-other
                                   pg-closed pg-evenodd pg-clip pg-filled pg-stroked pg-shading pg-pattern pg-blend pg-softmask pg-truncated
                                   mf-alpha mf-flags mf-rot mf-skewed mf-placement mf-z mf-clip mf-mark mf-ocg mf-vchk
                                   mg-mask mg-smask mg-inline mg-masked mg-blend mg-softmask
                                   vc-blend vc-softmask mc-xobject mkf-ocgdef
                                   mkf-parent mkf-mcid mkf-artype mkf-arsub mkf-actual mkf-actuallen mkf-alt mkf-altlen
                                   mkf-exp mkf-explen mkf-lang mkf-langlen mkf-flags mkf-stm mkf-ocg
                                   fnf-obj fnf-subtype fnf-flags fnf-program fnf-tounicode fnf-enc fnf-tstart fnf-tlen
                                   fnf-asc fnf-desc fnf-space fnf-style
                                   mc-inline mc-resource mc-unresolved mc-unterminated
                                   mk-artifact mk-optional-content mk-tag
                                   ar-pagination ar-layout ar-background ar-other ar-page
                                   as-header as-footer as-watermark as-other
                                   wb-space wb-gap wb-line-end]]
            [emon.fx :refer [fx-of-int fx-mul fx-div fx-muldiv fx-of-real fx-round
                             fx-abs fx-one fx-hypot fx-atan2 fx-cos fx-sin fx-get fx-put fx-push fx-join
                             fx-clamp fx-hi fx-lo mx-set mx-ident mx-mul mx-x mx-y mx-translate mx-copy]]
            [kin.lang :refer [defn defconst defdata declarefn return let set while if do comment
                              + - * < > <= >= == != and or quot rem bit-and bit-or]]))

;; `pc-do` runs a form's stream, which `pc-run` reads, and `pc-op` calls `pc-do`.
(declarefn pc-run)

