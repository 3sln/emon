;; Laws for `emon.rasterin` (P6.1, D187): the signature sniff, the unit's two rounds of `decode` requests (frame 0,
;; then every other frame, ids `f + 1`), the header-only form, the page table it builds from the answers (pixels to
;; centipoints at the stated resolution, 300 dpi and a flag when there is none), and its failure statuses.
(ns emon.rasterintest
  (:require [emon.lang :refer [I32 Cells Src Bitmap BitmapSet]]
            [emon.test :refer [deftest assert-eq assert-that new-cells new-bitmap-set hex-blob]]
            [emon.port :refer [cells-len cells-at cells-push src-of-blob bms-put bms-get bitmap-w bitmap-h bitmap-set-u8]]
            [emon.ocr :refer [ox-begin ox-line ox-block ox-word ox-sym ox-sym-cp ocf-dpi]]
            [emon.evidence :refer [wd-count wd-get ln-count ln-get ol-count ow-count or-count or-get ep-new wf-size hd-tstart hd-tlen
                                   lh-first lh-count lh-rot lh-y0 lh-y1 orf-pass op-upscaled op-re-rotated]]
            [emon.plan :refer [pu-id pu-view-id pi-decode pi-ocr rec-id rec-kind rec-find rq-arg rq-nargs an-decode an-fail ps-failed ps-unsupported
                               us-requests us-done pk-decode pk-ocr flt-none an-ocr an-ocr-word an-ocr-cp an-ocr-end]]
            [emon.retarget :refer [ri-rotated rv-rotated]]
            [emon.upscale :refer [ri-upscale rv-upscaled]]
            [emon.model :refer [model-init node-flags node-attr-int-or page-count page-number page-w page-h
                                page-kind page-dpi page-px-w page-px-h pk-image fl-dpi-unknown fk-pages]]
            [emon.rasterin :refer [rs-sniff rs-none rs-png rs-jpeg rs-tiff rs-doc rs-page rs-cpt rs-undecodable
                                   rs-unsupported]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot]]))

(deftest test-the-sniff-reads-the-signature-and-nothing-else
  (assert-eq (rs-sniff (src-of-blob (hex-blob "89504e470d0a1a0a0000000d"))) (rs-png) "PNG")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "ffd8ffe000104a46"))) (rs-jpeg) "JPEG")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "49492a0008000000"))) (rs-tiff) "TIFF, little endian")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "4d4d002a00000008"))) (rs-tiff) "TIFF, big endian")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "255044462d312e37"))) (rs-none) "a PDF is none of them")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "89504e470d0a1a0b"))) (rs-none) "a PNG signature with one byte wrong")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "89504e47"))) (rs-none) "a PNG signature cut short")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "4949"))) (rs-none) "too short to say")
  (assert-eq (rs-sniff (src-of-blob (hex-blob "49492b0008000000"))) (rs-none) "BigTIFF is not read")
  (assert-eq (rs-cpt 463 20000) 16668 "463 px at 200 dpi is 166.68 pt")
  (assert-eq (rs-cpt 2481 30000) 59544 "A4 at 300 dpi, rounded")
  (assert-eq (rs-cpt 1 100000000) 1 "never zero"))

(defn ^I32 doc-of [^Cells ans ^Cells rq ^Cells nodes ^Cells attrs ^Cells text ^Cells pages ^Cells mask]
  (let [^Cells regions (new-cells)
        ^Cells ledger (new-cells)
        ^Cells layout (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (return (rs-doc (src-of-blob (hex-blob "49492a0008000000")) 7 (rs-tiff) ans rq nodes attrs text pages mask))))

(defn ^I32 page-pol [^I32 f ^Cells ans ^Cells rq ^I32 policy ^Cells loc ^Cells mask ^Cells et ^Cells wd ^Cells ln
                     ^Cells oruns ^Cells olines ^Cells owords]
  (comment "no pixel in the bitmap set: the unit is the slim one, the first pass's lines (D564: with pixels it is `emon.pageunit`'s scan unit, whose laws are there)")
  (return (rs-page f 7 8 policy 0 ans rq loc (new-bitmap-set) mask (new-cells) (new-cells) (new-cells) et (new-cells) (new-cells)
                   oruns (new-cells) olines owords (new-cells) (new-cells) wd ln
                   (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells))))

(deftest test-the-document-pass-asks-for-frame-zeros-header-and-nothing-more
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)]
    (assert-eq (doc-of ans rq (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks")
    (assert-eq (cells-len rq) 8 "one request of eight cells")
    (assert-eq (rec-kind rq 0) (pk-decode) "a decode")
    (assert-eq (rec-id rq 0) 1 "frame 0 is id 1")
    (assert-eq (rq-arg rq 0 0) 7 "the input's index")
    (assert-eq (rq-arg rq 0 1) 0 "from its first byte")
    (assert-eq (rq-arg rq 0 2) 8 "the whole input")
    (assert-eq (rq-arg rq 0 3) (flt-none) "a whole image file, not a PDF filter")
    (assert-eq (rq-arg rq 0 4) -1 "frame 0, header only (D187)")))

(deftest test-the-second-round-asks-for-every-other-frames-header
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)]
    (an-decode ans 1 463 894 1 20000 1 3)
    (assert-eq (doc-of ans rq (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks again")
    (assert-eq (cells-len rq) 16 "two more requests")
    (assert-eq (rec-id rq 0) 2 "frame 1 is id 2")
    (assert-eq (rq-arg rq 0 4) -2 "frame 1, header only")
    (assert-eq (rec-id rq 8) 3 "frame 2 is id 3")
    (assert-eq (rq-arg rq 8 4) -3 "frame 2, header only")))

(deftest test-with-every-header-in-the-document-pass-builds-the-pages
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells nodes (new-cells)
        ^Cells attrs (new-cells)
        ^Cells pages (new-cells)
        ^Cells mask (new-cells)]
    (an-decode ans 1 463 894 1 20000 1 2)
    (an-decode ans 2 992 1403 3 0 0 2)
    (assert-eq (doc-of ans rq nodes attrs (new-cells) pages mask) 0 "done")
    (assert-eq (cells-len rq) 0 "asks for nothing")
    (assert-eq (cells-len mask) 2 "a mask cell a page")
    (assert-eq (page-count pages) 2 "one page a frame")
    (assert-eq (page-number pages 1) 2 "numbered from 1 in frame order")
    (assert-eq (page-kind pages 0) (pk-image) "an image page")
    (assert-eq (page-w pages 0) 16668 "463 px at 200 dpi")
    (assert-eq (page-h pages 0) 32184 "894 px at 200 dpi")
    (assert-eq (page-dpi pages 0) 200 "the stated resolution")
    (assert-eq (page-px-w pages 0) 463 "the pixel width is kept")
    (assert-eq (page-px-h pages 0) 894 "and the height")
    (assert-eq (page-w pages 1) 23808 "992 px at the assumed 300 dpi")
    (assert-eq (page-dpi pages 1) 0 "no resolution is stated, and none is claimed")
    (assert-eq (node-attr-int-or nodes attrs 0 (fk-pages) -1) 2 "the root says how many pages")
    (assert-eq (node-flags nodes 0) (fl-dpi-unknown) "and that one of them has no stated resolution")))

(deftest test-a-failed-header-is-the-units-failure
  (let [^Cells a1 (new-cells)
        ^Cells a2 (new-cells)
        ^Cells a3 (new-cells)]
    (an-fail a1 (pk-decode) 1 (ps-failed))
    (assert-eq (doc-of a1 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (rs-undecodable) "damaged")
    (an-fail a2 (pk-decode) 1 (ps-unsupported))
    (assert-eq (doc-of a2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (rs-unsupported) "not read")
    (an-decode a3 1 10 10 1 0 0 2)
    (an-fail a3 (pk-decode) 2 (ps-failed))
    (assert-eq (doc-of a3 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (rs-undecodable) "a later frame that fails fails the unit")))

;; ------------------------------------------------------------------------------------------------ page units (P7.U, D207)

(deftest test-a-frames-unit-asks-for-its-pixels-first-under-its-own-id
  (let [^Cells rq (new-cells)]
    (assert-eq (page-pol 0 (new-cells) rq 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks")
    (assert-eq (cells-len rq) 8 "one request")
    (assert-eq (rec-kind rq 0) (pk-decode) "a decode")
    (assert-eq (rec-id rq 0) 260 "page 0, k 4: (0 + 1) * 256 + 4")
    (assert-eq (rq-arg rq 0 4) 0 "the whole frame, not a header"))
  (let [^Cells rq2 (new-cells)]
    (assert-eq (page-pol 2 (new-cells) rq2 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks")
    (assert-eq (rec-id rq2 0) 772 "page 2: 3 * 256 + 4")
    (assert-eq (rq-arg rq2 0 4) 2 "frame 2")))

(deftest test-a-frames-unit-that-asked-the-same-again-asks-the-same
  (let [^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)]
    (page-pol 1 (new-cells) rq1 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells))
    (page-pol 1 (new-cells) rq2 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells))
    (assert-eq (cells-len rq1) (cells-len rq2) "the same length")
    (assert-eq (cells-at rq1 2) (cells-at rq2 2) "the same id")))

(deftest test-a-failed-frame-decode-is-the-units-failure
  (let [^Cells a1 (new-cells)]
    (an-fail a1 (pk-decode) 260 (ps-failed))
    (assert-eq (page-pol 0 a1 (new-cells) 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (rs-undecodable) "damaged"))
  (let [^Cells a2 (new-cells)]
    (an-fail a2 (pk-decode) 260 (ps-unsupported))
    (assert-eq (page-pol 0 a2 (new-cells) 0 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (rs-unsupported) "not read, whatever the policy")))

;; ------------------------------------------------------------------------------------------------ OCR (P6.5, D211)

(defn ^I32 fake-ocr [^Cells ans ^I32 id]
  (comment "An OCR answer for one line holding the word \"Hi\": 10,20 30x40 pixels, baseline y 55, row attributes 20 + 14 / 6.")
  (let [^I32 at (an-ocr ans id)
        ^I32 w (an-ocr-word ans at 10 20 30 40 900 0 0)]
    (an-ocr-cp ans w 72)
    (an-ocr-cp ans w 105)
    (ox-begin ans 0 0 0 0 -1 0 -1 -1 1 1 0 0 0)
    (ox-line ans 10 20 30 40 10 55 40 55 0 0 0 20 14 6)
    (ox-block ans 10 20 30 40 0 0 0)
    (let [^I32 x (ox-word ans 0 0 -1 0)
          ^I32 s0 (ox-sym ans x 10 20 15 40 900)]
      (ox-sym-cp ans s0 72)
      (let [^I32 s1 (ox-sym ans x 25 20 15 40 900)]
        (ox-sym-cp ans s1 105)))
    (an-ocr-end ans at)
    (return at)))

(deftest test-with-the-policy-the-frames-second-round-asks-for-ocr-of-its-bitmap
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)]
    (an-decode ans 260 463 894 1 0 1 1)
    (assert-eq (page-pol 0 ans rq 2 (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks")
    (assert-eq (rec-kind rq 0) (pk-ocr) "an OCR request")
    (assert-eq (rec-id rq 0) (pu-id 0 (pi-ocr)) "page 0's OCR id")
    (assert-eq (rec-id rq 0) 272 "256 + 16")
    (assert-eq (rq-arg rq 0 0) 260 "of the bitmap of the decode")
    (assert-eq (rq-arg rq 0 1) 3 "psm 3")
    (assert-eq (rq-arg rq 0 2) (+ 3 (* 300 256)) "symbols, OSD, and the 300 dpi it assumed as a hint")
    (assert-eq (ocf-dpi (rq-arg rq 0 2)) 300 "read back")
    (assert-eq (rq-arg rq 0 5) 0 "the whole bitmap")
    (assert-eq (rq-nargs rq 0) 7 "and no language: no locale was given")))

(deftest test-a-locale-hint-names-the-language
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells loc (new-cells)]
    (cells-push loc 100)
    (cells-push loc 101)
    (cells-push loc 45)
    (cells-push loc 67)
    (cells-push loc 72)
    (an-decode ans 260 463 894 1 20000 1 1)
    (assert-eq (page-pol 0 ans rq 2 loc (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "it asks")
    (assert-eq (rq-arg rq 0 2) (+ 3 (* 200 256)) "the stated 200 dpi")
    (assert-eq (rq-nargs rq 0) 8 "one language")
    (assert-eq (rq-arg rq 0 7) 1684370688 "`de-CH` is `deu`")))

(deftest test-never-asks-for-no-ocr
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells mask (new-cells)]
    (cells-push mask 0)
    (an-decode ans 260 463 894 1 20000 1 1)
    (assert-eq (page-pol 0 ans rq 0 (new-cells) mask (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) 0 "never: done")
    (assert-eq (cells-len rq) 0 "no request")
    (assert-eq (cells-at mask 0) 0 "the page was not OCR'd")))

(deftest test-an-ocr-answer-becomes-evidence-and-the-pipelines-lines
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells mask (new-cells)
        ^Cells et (new-cells)
        ^Cells wd (new-cells)
        ^Cells ln (new-cells)
        ^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)]
    (cells-push mask 0)
    (an-decode ans 260 600 800 1 30000 1 1)
    (fake-ocr ans 272)
    (assert-eq (page-pol 0 ans rq 2 (new-cells) mask et wd ln oruns olines owords) 0 "done")
    (assert-eq (cells-at mask 0) 1 "the page's text came from OCR")
    (assert-eq (or-count oruns) 1 "one OCR run")
    (assert-eq (ol-count olines) 1 "one OCR line")
    (assert-eq (ow-count owords) 1 "one OCR word")
    (assert-eq (ln-count ln) 1 "one line for the pipeline")
    (assert-eq (wd-count wd) 1 "one word for the pipeline")
    (assert-eq (wd-get wd 0 (hd-tlen)) 2 "its text is `Hi`")
    (assert-eq (wd-get wd 0 (wf-size)) 1117 "the line's size: (x-height 20 + ascenders 14 px at 24 cpt) / 0.73")
    (assert-eq (ln-get ln 0 (lh-first)) 0 "the line's first word")
    (assert-eq (ln-get ln 0 (lh-count)) 1 "and its one word")
    (assert-eq (ln-get ln 0 (lh-rot)) 0 "upright")
    (assert-eq (ln-get ln 0 (lh-y0)) (- (* 55 24) (* 34 24)) "the box's top is the baseline less x-height and ascenders")
    (assert-eq (ln-get ln 0 (lh-y1)) (+ (* 55 24) (* 6 24)) "and its bottom the baseline plus descenders")))

;; ------------------------------------------------------------------------------------------------ the scan unit's passes for an image (D564)

(defn ^I32 fake-lines [^:mut ^Cells ans ^I32 id ^I32 nlines ^I32 scale ^I32 xh ^I32 osd ^I32 oconf]
  (comment "An OCR answer of `nlines` lines, each of one word \"Hi\" (60 x 40 pixels at `scale`, x-height `xh` at `scale`, the line 60 pixels below the one before)")
  (comment "that OSD says is turned `osd` degrees at the confidence `oconf` (x10; -1: no OSD).")
  (let [^I32 at (an-ocr ans id)
        ^:mut ^I32 k 0
        ^:mut ^I32 word 0]
    (while (< k nlines)
      (do (set word (an-ocr-word ans at (* 10 scale) (* (+ 20 (* k 60)) scale) (* 60 scale) (* 40 scale) 900 k 0))
          (an-ocr-cp ans word 72)
          (an-ocr-cp ans word 105)
          (set k (+ k 1))))
    (ox-begin ans 0 0 0 0 osd 1281455214 100 oconf nlines 1 0 0 0)
    (set k 0)
    (while (< k nlines)
      (do (ox-line ans (* 10 scale) (* (+ 20 (* k 60)) scale) (* 60 scale) (* 40 scale)
                   (* 10 scale) (* (+ 55 (* k 60)) scale) (* 70 scale) (* (+ 55 (* k 60)) scale) 0 0 0 (* xh scale) 14 6)
          (set k (+ k 1))))
    (ox-block ans (* 10 scale) (* 20 scale) (* 60 scale) (* (* nlines 60) scale) 0 0 0)
    (set k 0)
    (while (< k nlines)
      (do (ox-word ans 0 0 -1 0)
          (set k (+ k 1))))
    (an-ocr-end ans at)
    (return at)))

(defn ^I32 white-frame [^BitmapSet bms ^I32 id ^I32 w ^I32 h]
  (comment "A decoded frame of paper (255) under the id of its decode request, as the host puts one in the set.")
  (let [^Bitmap b (bms-put bms id w h 1)
        ^:mut ^I32 y 0
        ^:mut ^I32 x 0]
    (while (< y h)
      (do (set x 0)
          (while (< x w)
            (do (bitmap-set-u8 b x y 0 255)
                (set x (+ x 1))))
          (set y (+ y 1))))
    (return 0)))

(defn ^I32 page-px [^Cells ans ^:mut ^Cells rq ^BitmapSet bms ^I32 fuse ^:mut ^Cells mask ^Cells et ^Cells wd ^Cells ln ^Cells oruns ^Cells olines ^Cells owords]
  (comment "Frame 0 of an input of one frame under the policy `always`, with the pixels of its decode in `bms` and `fuse` the page unit's flags.")
  (return (rs-page 0 7 8 2 fuse ans rq (new-cells) bms mask (new-cells) (new-cells) (new-cells) et (new-cells) (new-cells)
                   oruns (new-cells) olines owords (new-cells) (new-cells) wd ln
                   (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)
                   (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells))))

(deftest test-a-frame-fed-sideways-is-read-from-its-turned-view
  (comment "P12.3 I-5: an image page went through `rs-page`, which wrote the first pass's lines and never looked at what OSD said, so a PNG turned a quarter or a half was")
  (comment "read as garbage and no second pass ran. It is the scan unit's now: OSD sure that the page is turned (`nm-orient`) has the unit ask for the turned view.")
  (let [^Cells ans (new-cells)
        ^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)
        ^Cells mask (new-cells)
        ^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^BitmapSet bms (new-bitmap-set)
        ^BitmapSet bms2 (new-bitmap-set)]
    (comment "a unit's attempt has a set of its own (what kin made in one is dropped with it): the frame's pixels are put in each")
    (cells-push mask 0)
    (white-frame bms 260 100 300)
    (white-frame bms2 260 100 300)
    (an-decode ans 260 100 300 1 0 1 1)
    (fake-lines ans 272 5 1 6 90 100)
    (assert-eq (page-px ans rq1 bms 0 mask (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "the first pass is in and the page is turned: it asks")
    (let [^I32 at (rec-find rq1 (pu-id 0 (ri-rotated)))]
      (assert-that (>= at 0) "the OCR of the turned view")
      (assert-eq (rec-kind rq1 at) (pk-ocr) "an OCR request")
      (assert-eq (rq-arg rq1 at 0) (pu-view-id 0 (rv-rotated)) "of the kin-made view")
      (assert-eq (bitmap-w (bms-get bms (pu-view-id 0 (rv-rotated)))) 300 "turned a quarter: as wide as the frame is high")
      (assert-eq (bitmap-h (bms-get bms (pu-view-id 0 (rv-rotated)))) 100 "and as high as it is wide"))
    (assert-eq (cells-at mask 0) 0 "an attempt that asks writes nothing: the page is not yet read")
    (comment "the turned view read: the page is done, and the evidence says the turned view was read")
    (fake-lines ans 274 5 1 6 -1 -1)
    (assert-eq (page-px ans rq2 bms2 0 mask (new-cells) (new-cells) (new-cells) oruns olines owords) (us-done) "done")
    (assert-eq (cells-at mask 0) 1 "the page was OCR'd")
    (assert-eq (or-count oruns) 2 "the first pass and the turned view's reading")
    (assert-eq (or-get oruns 1 (orf-pass)) (op-re-rotated) "the second run is the re-rotated pass")))

(deftest test-the-hidden-setting-no-retarget-leaves-a-turned-frame-as-the-first-pass-read-it
  (let [^Cells ans (new-cells)
        ^Cells rq (new-cells)
        ^Cells mask (new-cells)
        ^BitmapSet bms (new-bitmap-set)]
    (cells-push mask 0)
    (white-frame bms 260 100 300)
    (an-decode ans 260 100 300 1 0 1 1)
    (fake-lines ans 272 5 1 6 90 100)
    (assert-eq (page-px ans rq bms 2 mask (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-done) "`no-retarget`: done")
    (assert-eq (cells-len rq) 0 "no request")
    (assert-eq (cells-at mask 0) 1 "the first pass's lines")))

(deftest test-a-frame-of-small-text-is-read-again-enlarged
  (comment "P12.3 I-3: a 72 dpi page was read once, at the size it was; whole words and decimal points were lost and nothing said so. Its first pass shows the text is under 16 pixels")
  (comment "high (x-height 6): the unit makes the frame 4 times as large as a view and asks for the OCR of THAT, and reads the enlargement when it reads as much.")
  (let [^Cells ans (new-cells)
        ^Cells rq1 (new-cells)
        ^Cells rq2 (new-cells)
        ^Cells rq3 (new-cells)
        ^Cells mask (new-cells)
        ^Cells oruns (new-cells)
        ^Cells olines (new-cells)
        ^Cells owords (new-cells)
        ^BitmapSet bms (new-bitmap-set)
        ^BitmapSet bms2 (new-bitmap-set)
        ^BitmapSet bms3 (new-bitmap-set)]
    (cells-push mask 0)
    (white-frame bms 260 100 300)
    (white-frame bms2 260 100 300)
    (white-frame bms3 260 100 300)
    (an-decode ans 260 100 300 1 0 1 1)
    (fake-lines ans 272 5 1 6 -1 -1)
    (assert-eq (page-px ans rq1 bms 0 mask (new-cells) (new-cells) (new-cells) (new-cells) (new-cells) (new-cells)) (us-requests) "the first pass is in and the text is small: it asks")
    (let [^I32 at (rec-find rq1 (pu-id 0 (ri-upscale)))]
      (assert-that (>= at 0) "the OCR of the enlarged view")
      (assert-eq (rec-kind rq1 at) (pk-ocr) "an OCR request")
      (assert-eq (rq-arg rq1 at 0) (pu-view-id 0 (rv-upscaled)) "of the kin-made view")
      (assert-eq (rq-arg rq1 at 1) 3 "psm 3")
      (assert-eq (ocf-dpi (rq-arg rq1 at 2)) 346 "told the resolution the text says it has, 4 times: ten point type at an x-height of 6 pixels is 86 dpi")
      (assert-eq (bitmap-w (bms-get bms (pu-view-id 0 (rv-upscaled)))) 400 "4 times as wide")
      (assert-eq (bitmap-h (bms-get bms (pu-view-id 0 (rv-upscaled)))) 1200 "and as high"))
    (assert-eq (cells-at mask 0) 0 "nothing is written yet")
    (comment "the enlargement read as much: it is the page's reading, and the dump says so")
    (fake-lines ans 277 5 4 6 -1 -1)
    (assert-eq (page-px ans rq2 bms2 0 mask (new-cells) (new-cells) (new-cells) oruns olines owords) (us-done) "done")
    (assert-eq (cells-len rq2) 0 "nothing more asked")
    (assert-eq (cells-at mask 0) 1 "the page was OCR'd")
    (assert-eq (or-count oruns) 1 "one run: the enlargement's replaces the first pass")
    (assert-eq (or-get oruns 0 (orf-pass)) (op-upscaled) "the upscaled pass")
    (comment "a first pass that read nothing of what the enlargement read: the same")
    (let [^Cells ans2 (new-cells)
          ^Cells oruns2 (new-cells)
          ^Cells mask2 (new-cells)]
      (cells-push mask2 0)
      (an-decode ans2 260 100 300 1 0 1 1)
      (fake-lines ans2 272 5 1 6 -1 -1)
      (fake-lines ans2 277 1 4 6 -1 -1)
      (assert-eq (page-px ans2 rq3 bms3 0 mask2 (new-cells) (new-cells) (new-cells) oruns2 (new-cells) (new-cells)) (us-done) "done")
      (assert-eq (or-get oruns2 0 (orf-pass)) 1 "an enlargement that read less than the first pass is not adopted: the first pass stands"))))
