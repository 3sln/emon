;; Laws for `emon.glayer` (P5.5a; SPEC 9.7, 9.9; D218, D255), on every target.
;;
;; A HAND-BUILT GRAPHICS LAYER: two rules and a fill on a page, one group whose member runs point into `refs`, one region. Two such pages are
;; appended (what is re-based: every group, every member run; what is not: a region's subject), `gl-check` is satisfied and notices every way
;; of being broken, every cell of every stride is printed by the dump or named spare, and the dump of a small layer is what it should be.
(ns emon.glayertest
  (:require [emon.lang :refer [I32 Cells Text]]
            [emon.test :refer [deftest assert-eq assert-that assert-text new-cells new-text]]
            [emon.port :refer [cells-len cells-at cells-set cells-push cells-drop]]
            [emon.evidence :refer [rf-add ea-paths ea-pts]]
            [emon.glayer :refer [grl-new grl-set grl-get grl-count gfl-new gfl-set gfl-get gfl-count ggp-new ggp-set ggp-get ggp-count
                                 grg-new grg-set grg-get grg-count gl-check gl-append gl-emit gl-fd-at gl-fx-at
                                 go-h go-v gq-box-edge gqf-shading gk-rule rk-table-in-image gs-vector]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 gt-page [^:mut ^Cells grl ^:mut ^Cells gfl ^:mut ^Cells ggp ^:mut ^Cells grg ^:mut ^Cells refs ^I32 page]
  (comment "One page: a group of one vector member (the path 7, its first point 3), two rules in it, a fill in it, and a region.")
  (let [^:mut ^I32 g 0
        ^:mut ^I32 r 0]
    (cells-drop grl 0)
    (cells-drop gfl 0)
    (cells-drop ggp 0)
    (cells-drop grg 0)
    (cells-drop refs 0)
    (rf-add refs (ea-paths) 7)
    (rf-add refs (ea-pts) 3)
    (set g (ggp-new ggp page (gk-rule)))
    (ggp-set ggp g 2 0)
    (ggp-set ggp g 3 2)
    (set r (grl-new grl page 1000 4950 21000 5050 1000 5000 21000 5000 100 (go-h)))
    (grl-set grl r 14 (gs-vector))
    (grl-set grl r 15 (gs-vector))
    (grl-set grl r 16 501)
    (grl-set grl r 17 900)
    (grl-set grl r 12 0)
    (grl-set grl r 19 g)
    (set r (grl-new grl page 1000 5000 1100 8000 1050 5000 1050 8000 100 (go-v)))
    (grl-set grl r 18 (gq-box-edge))
    (grl-set grl r 19 g)
    (set r (gfl-new gfl page 2000 2000 9000 3000 16711680))
    (gfl-set gfl r 6 299)
    (gfl-set gfl r 11 (gqf-shading))
    (gfl-set gfl r 12 g)
    (set r (grg-new grg page 0 0 30000 40000 (rk-table-in-image)))
    (grg-set grg r 7 13)
    (grg-set grg r 8 4)
    (grg-set grg r 9 2)
    (grg-set grg r 10 1)
    (return 0)))

(deftest test-a-hand-built-layer-is-sound
  (let [^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells ggp (new-cells) ^Cells grg (new-cells) ^Cells refs (new-cells)]
    (gt-page grl gfl ggp grg refs 1)
    (assert-eq (gl-check grl gfl ggp grg refs) 0 "sound")
    (assert-eq (grl-count grl) 2 "two rules")
    (assert-eq (gfl-count gfl) 1 "one fill")
    (assert-eq (ggp-get ggp 0 4) -1 "an absent run is first -1")
    (assert-eq (grl-get grl 0 12) 0 "a colour set")
    (assert-eq (grl-get grl 1 12) -1 "a colour not set is -1")
    (assert-eq (grl-get grl 1 20) -1 "no z")))

(deftest test-the-checker-notices-every-way-of-being-broken
  (let [^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells ggp (new-cells) ^Cells grg (new-cells) ^Cells refs (new-cells)]
    (gt-page grl gfl ggp grg refs 1)
    (cells-push grl 0)
    (assert-eq (gl-check grl gfl ggp grg refs) 1 "a stride")
    (cells-drop grl 48)
    (grl-set grl 1 19 5)
    (assert-eq (gl-check grl gfl ggp grg refs) 2 "a rule's group outside ggp")
    (grl-set grl 1 19 0)
    (gfl-set gfl 0 12 3)
    (assert-eq (gl-check grl gfl ggp grg refs) 2 "a fill's group outside ggp")
    (gfl-set gfl 0 12 0)
    (ggp-set ggp 0 3 9)
    (assert-eq (gl-check grl gfl ggp grg refs) 3 "a member run outside refs")
    (ggp-set ggp 0 3 2)
    (grl-set grl 0 10 4)
    (assert-eq (gl-check grl gfl ggp grg refs) 4 "an orientation outside go")
    (grl-set grl 0 10 1)
    (grl-set grl 0 9 -1)
    (assert-eq (gl-check grl gfl ggp grg refs) 4 "a negative thickness")
    (grl-set grl 0 9 100)
    (grl-set grl 0 1 99999)
    (assert-eq (gl-check grl gfl ggp grg refs) 4 "a box upside down")
    (grl-set grl 0 1 1000)
    (grg-set grg 0 5 9)
    (assert-eq (gl-check grl gfl ggp grg refs) 5 "a region of an unknown kind")
    (grg-set grg 0 5 1)
    (grg-set grg 0 8 -1)
    (assert-eq (gl-check grl gfl ggp grg refs) 5 "a half subject")
    (grg-set grg 0 8 4)
    (rf-add refs 41 9)
    (assert-eq (gl-check grl gfl ggp grg refs) 6 "a reference into a rule that is not there")
    (cells-drop refs 4)
    (assert-eq (gl-check grl gfl ggp grg refs) 0 "sound again")))

(deftest test-two-pages-append-and-rebase
  (let [^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells ggp (new-cells) ^Cells grg (new-cells) ^Cells refs (new-cells)
        ^Cells pgrl (new-cells) ^Cells pgfl (new-cells) ^Cells pggp (new-cells) ^Cells pgrg (new-cells) ^Cells prefs (new-cells)]
    (gt-page pgrl pgfl pggp pgrg prefs 1)
    (gl-append grl gfl ggp grg pgrl pgfl pggp pgrg 0)
    (rf-add refs (ea-paths) 7)
    (rf-add refs (ea-pts) 3)
    (gt-page pgrl pgfl pggp pgrg prefs 2)
    (gl-append grl gfl ggp grg pgrl pgfl pggp pgrg 2)
    (rf-add refs (ea-paths) 7)
    (rf-add refs (ea-pts) 3)
    (assert-eq (gl-check grl gfl ggp grg refs) 0 "two pages are sound")
    (assert-eq (grl-count grl) 4 "rules")
    (assert-eq (gfl-count gfl) 2 "fills")
    (assert-eq (ggp-count ggp) 2 "groups")
    (assert-eq (grg-count grg) 2 "regions")
    (assert-eq (grl-get grl 2 19) 1 "the second page's rule is in the document's second group")
    (assert-eq (gfl-get gfl 1 12) 1 "and its fill")
    (assert-eq (grl-get grl 0 19) 0 "the first page's is not moved")
    (assert-eq (ggp-get ggp 1 2) 2 "the second group's member run starts after the first page's refs")
    (assert-eq (ggp-get ggp 1 4) -1 "an absent run stays absent")
    (assert-eq (grg-get grg 1 7) 13 "a region's subject, an evidence row, is not re-based")
    (assert-eq (grg-get grg 1 8) 4 "nor its index")
    (assert-eq (grl-get grl 3 0) 2 "pages are kept")))

(defn ^I32 gt-width [^I32 kind ^I32 arg]
  (comment "How many cells a field of the dump table covers.")
  (if (== kind 3) (return 4))
  (if (or (== kind 4) (== kind 5)) (return 2))
  (return 1))

(deftest test-every-cell-is-printed-or-named-spare
  (comment "per arena of the field table: the cells its rows cover, plus its spare cells, are its stride, and no two rows overlap")
  (let [^:mut ^I32 a 0
        ^:mut ^I32 k 0
        ^:mut ^I32 covered 0
        ^:mut ^I32 next 0
        ^:mut ^I32 f 0]
    (while (< a 4)
      (do (set covered 0)
          (set next 0)
          (set k 0)
          (while (< k (gl-fx-at 0 a 1))
            (do (set f (gl-fd-at 0 (+ (gl-fx-at 0 a 0) k) 1))
                (assert-that (>= f next) "the fields are in stride order and do not overlap")
                (set covered (+ covered (gt-width (gl-fd-at 0 (+ (gl-fx-at 0 a 0) k) 2) (gl-fd-at 0 (+ (gl-fx-at 0 a 0) k) 5))))
                (set next (+ f (gt-width (gl-fd-at 0 (+ (gl-fx-at 0 a 0) k) 2) (gl-fd-at 0 (+ (gl-fx-at 0 a 0) k) 5))))
                (set k (+ k 1))))
          (assert-eq (+ covered (gl-fx-at 0 a 3)) (gl-fx-at 0 a 2) "printed plus spare is the stride")
          (set a (+ a 1))))
    (assert-eq a 4 "four arenas")))

(deftest test-the-graphics-dump
  (let [^Cells grl (new-cells) ^Cells gfl (new-cells) ^Cells ggp (new-cells) ^Cells grg (new-cells) ^Cells refs (new-cells)
        ^Text t (new-text)]
    (gt-page grl gfl ggp grg refs 1)
    (gl-emit t 0 0 grl gfl ggp grg)
    (assert-text t "\"grl\":[{\"page\":1,\"box\":[10,49.5,210,50.5],\"ex0\":10,\"ey0\":50,\"ex1\":210,\"ey1\":50,\"thickness\":1,\"orient\":\"h\",\"color\":0,\"sources\":[\"vector\"],\"source\":[\"vector\"],\"rule\":501,\"conf\":900,\"group\":0},{\"page\":1,\"box\":[10,50,11,80],\"ex0\":10.5,\"ey0\":50,\"ex1\":10.5,\"ey1\":80,\"thickness\":1,\"orient\":\"v\",\"flags\":[\"box-edge\"],\"group\":0}],\"gfl\":[{\"page\":1,\"box\":[20,20,90,30],\"color\":16711680,\"lightness\":299,\"flags\":[\"shading\"],\"group\":0}],\"ggp\":[{\"page\":1,\"kind\":\"rule\",\"vector\":[0,2]}],\"grg\":[{\"page\":1,\"box\":[0,0,300,400],\"kind\":\"table-in-image\",\"subject\":[\"images\",4],\"rules\":2,\"fills\":1}]" "the dump")))
