;; Laws for `emon.columns` (P4.1; D1630), on every target: what the column stage decides about two things a text-only reading missed. Every line is written by hand (a row of `lines` with its words,
;; in centipoints, 11 pt type; a word is 3000 from the one before and 2250 wide), the stage is run on the page (`lc-page`) and the fragments it wrote are counted.
;;
;;   * TWO BLOCKS of short lines a long way apart (an invoice's Seller and Client, a form's left and right boxes) are two columns, though a side has two words a line and not three;
;;   * an INFOBOX: a shaded box beside the body, whose rows are a word or two, is a region of its own (a side region, a sidebar), with the box said by the graphics layer (`lc-mark-asides`) and not by the words.
(ns emon.columnstest
  (:require [emon.lang :refer [I32 Blob Cells]]
            [emon.test :refer [deftest assert-eq new-cells text-blob]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-push]]
            [emon.model :refer [page-new pk-vector text-append-utf8 rl-body rl-sidebar]]
            [emon.evidence :refer [wd-new wd-set wd-count ln-new ln-count wf-size wf-font]]
            [emon.glayer :refer [gfl-new]]
            [emon.columns :refer [lc-copy lc-page lc-mark-asides lc-cf-stride]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

(defn ^I32 ct-line [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 x ^I32 y]
  (comment "One line on page 1 from x at y: the words of b (split at spaces) 3000 apart, 2250 wide, 1100 tall, in 11 pt type.")
  (let [^I32 w0 (wd-count wd)
        ^I32 n (blob-len b)
        ^I32 y1 (+ y 1100)
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0
        ^:mut ^I32 i 0
        ^:mut ^I32 xe x]
    (while (<= k n)
      (do (if (or (== k n) (== (blob-u8 b k) 32))
            (do (if (> k s)
                  (do (let [^I32 ts (cells-len et)
                            ^I32 wx (+ x (* i 3000))
                            ^I32 wx1 (+ wx 2250)]
                        (text-append-utf8 et b s k)
                        (let [^I32 tl (- (cells-len et) ts)
                              ^I32 r (wd-new wd 1 wx y wx1 y1 wx (- y1 200) wx1 (- y1 200) 0 0 ts tl -1 -1 -1)]
                          (wd-set wd r (wf-size) 1100)
                          (wd-set wd r (wf-font) 0))
                        (set xe wx1)
                        (set i (+ i 1)))))
                (set s (+ k 1))))
          (set k (+ k 1))))
    (ln-new ln 1 x y xe y1 x (- y1 200) xe (- y1 200) 0 0 w0 (- (wd-count wd) w0))
    (return 0)))

(defn ^I32 ct-page [^Cells wd ^Cells et ^Cells ln ^Cells gfl ^I32 marks]
  (comment "The fragments the column stage writes for page 1 of the evidence: `lc-copy`, the boxes of the graphics layer (when `marks` is 1) and `lc-page`. Answers how many; the rows of `cf`")
  (comment "are in the scratch `cf` the caller reads, so this answers the count of the first and the role of the last in one number: fragments * 10 + the last fragment's role.")
  (let [^Cells lt (new-cells) ^Cells ls (new-cells) ^Cells sd (new-cells) ^Cells it (new-cells)
        ^Cells io (new-cells) ^Cells rw (new-cells) ^Cells gu (new-cells) ^Cells ac (new-cells)
        ^Cells tm (new-cells) ^Cells cf (new-cells) ^Cells lo (new-cells) ^Cells pr (new-cells)
        ^Cells pages (new-cells)
        ^:mut ^I32 i 0
        ^:mut ^I32 n 0]
    (page-new pages 1 61200 79200 0 (pk-vector))
    (lc-copy ln lt)
    (if (== marks 1) (lc-mark-asides lt gfl pages 1))
    (while (< i (ln-count lt))
      (do (cells-push ls i)
          (set i (+ i 1))))
    (set n (lc-page wd et lt 1 ls sd it io rw gu ac tm cf lo pr))
    (return (+ (* n 10) (cells-at cf (+ (* (- n 1) (lc-cf-stride)) 3))))))

(deftest test-two-blocks-of-short-lines-far-apart-are-two-columns
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells gfl (new-cells)]
    (comment "D1630 (smoke review A issue 14): an invoice's two blocks, Seller and Client, 238 pt apart, with 1 to 3 words a line (2.3 and 2.6 a line on average, short of three): two columns, not")
    (comment "lines that alternate. (The roles are body, body: the last fragment's role is 0.)")
    (ct-line wd ln et (text-blob "Seller:") 7200 10000)
    (ct-line wd ln et (text-blob "Client:") 40000 10000)
    (ct-line wd ln et (text-blob "Dunn Campbell") 7200 11400)
    (ct-line wd ln et (text-blob "Ramirez Donaldson Lane") 40000 11400)
    (ct-line wd ln et (text-blob "36709 Santiago Viaduct") 7200 12800)
    (ct-line wd ln et (text-blob "567 Ortiz Valley") 40000 12800)
    (ct-line wd ln et (text-blob "Dianaland MN 12512") 7200 14200)
    (ct-line wd ln et (text-blob "Kellyfort GA 69454") 40000 14200)
    (ct-line wd ln et (text-blob "Tax Id 986-74-6578") 7200 17000)
    (ct-line wd ln et (text-blob "Tax Id 948-74-8143") 40000 17000)
    (ct-line wd ln et (text-blob "IBAN GB37QZVP50159087754233") 7200 18400)
    (assert-eq (ct-page wd et ln gfl 0) (+ 20 (rl-body)) "two body fragments")))

(deftest test-a-shaded-box-beside-the-body-is-a-region-of-its-own
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells) ^Cells gfl (new-cells)
        ^Cells wd2 (new-cells) ^Cells ln2 (new-cells) ^Cells et2 (new-cells)]
    (comment "D1630 (smoke review B issue 14): the body's lines are seven words, 210 pt wide; an infobox of three rows of two words stands to their right on a shaded ground, 55 pt from them. Two words a row")
    (comment "are short of the gutter's three, so the words alone find no gutter and the rows alternate. With the box (a fill 20000 wide: a third of the page's width) the rows are a sidebar, a fragment")
    (comment "of its own after the body's.")
    (ct-line wd ln et (text-blob "one two three four five six seven") 7200 10000)
    (ct-line wd ln et (text-blob "Born Moscow") 33000 10000)
    (ct-line wd ln et (text-blob "eight nine ten eleven twelve thirteen fourteen") 7200 11400)
    (ct-line wd ln et (text-blob "Area 2561") 33000 11400)
    (ct-line wd ln et (text-blob "fifteen sixteen seventeen eighteen nineteen twenty twentyone") 7200 12800)
    (ct-line wd ln et (text-blob "Pop 13274") 33000 12800)
    (ct-line wd ln et (text-blob "alpha beta gamma delta epsilon zeta eta") 7200 14200)
    (ct-line wd ln et (text-blob "Founded 1147") 33000 14200)
    (ct-line wd ln et (text-blob "theta iota kappa lambda mu nu xi") 7200 15600)
    (ct-line wd ln et (text-blob "Time UTC+3") 33000 15600)
    (assert-eq (ct-page wd et ln gfl 1) (+ 10 (rl-body)) "no box: one fragment, the lines alternating")
    (gfl-new gfl 1 32800 9800 53200 17000 16316664)
    (ct-line wd2 ln2 et2 (text-blob "one two three four five six seven") 7200 10000)
    (ct-line wd2 ln2 et2 (text-blob "Born Moscow") 33000 10000)
    (ct-line wd2 ln2 et2 (text-blob "eight nine ten eleven twelve thirteen fourteen") 7200 11400)
    (ct-line wd2 ln2 et2 (text-blob "Area 2561") 33000 11400)
    (ct-line wd2 ln2 et2 (text-blob "fifteen sixteen seventeen eighteen nineteen twenty twentyone") 7200 12800)
    (ct-line wd2 ln2 et2 (text-blob "Pop 13274") 33000 12800)
    (ct-line wd2 ln2 et2 (text-blob "alpha beta gamma delta epsilon zeta eta") 7200 14200)
    (ct-line wd2 ln2 et2 (text-blob "Founded 1147") 33000 14200)
    (ct-line wd2 ln2 et2 (text-blob "theta iota kappa lambda mu nu xi") 7200 15600)
    (ct-line wd2 ln2 et2 (text-blob "Time UTC+3") 33000 15600)
    (assert-eq (ct-page wd2 et2 ln2 gfl 1) (+ 20 (rl-sidebar)) "the box: the body and a sidebar")))
