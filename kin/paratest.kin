;; Laws for `emon.para` (P1.8), on every target.
;;
;; TWO KINDS. (1) What the stage DECIDES, on evidence written by hand (a line is a row of `lines` with
;; its words, in centipoints): where a paragraph ends (a gap, an indent), the reading order of lines
;; given out of order (Chrome paints a drop cap first, D108 (a)), the line-end hyphen rule, NFC and
;; the ligatures, a rotated line standing alone, and what a page's end does (a milestone between blocks, an
;; inline one when the paragraph goes on). The expected answer is written out as a brief:
;;
;;     P<regions>:<text>;      a paragraph (its own text; empty when it has inline children)
;;     T:<text>;               a text inline          B<page>;   a page milestone
;;
;; in document order. (2) What it MAKES of real files: six Chrome-printed documents of the synthetic corpus run
;; PDF -> content -> paragraphs -> Model -> pretty JSON, byte for byte against `test/para/NAME.json`
;; (`kin/scripts/para-goldens` wrote them; `kin/scripts/para-check` holds them to the HTML they were printed from).
(ns emon.paratest
  (:require [emon.lang :refer [I32 Blob Src Cells Text]]
            [emon.test :refer [deftest assert-eq assert-text assert-text-span new-cells new-text
                               test-file text-blob]]
            [emon.port :refer [blob-len blob-u8 cells-len cells-at cells-drop text-cp text-i32 src-of-blob]]
            [emon.mscript :refer [jt-end]]
            [emon.model :refer [model-init model-check page-new pk-vector node-count node-kind
                                node-text-start node-text-len node-region-count node-sub text-at
                                text-append-utf8 nk-paragraph nk-break nk-text nk-note nk-initial node-aux node-flags
                                ifm-drop ifm-margin fl-low-conf al-start al-center al-end al-justify
                                page-layout-count page-layout-first layout-band layout-col layout-role layout-x0]]
            [emon.json :refer [js-emit]]
            [emon.html :refer [html-emit]]
            [emon.evidence :refer [wd-new wd-set wd-get wd-count ln-new wf-size wf-font hd-x0 hd-x1]]
            [emon.pdfdoc :refer [pd-open]]
            [emon.pdfcontent :refer [pc-document]]
            [emon.para :refer [pa-pages pa-build pa-dump]]
            [emon.columns :refer [lc-copy]]
            [emon.initial :refer [in-detect]]
            [emon.heading :refer [hd-analyze]]
            [kin.lang :refer [defn return let set while if do comment
                              + - * < > <= >= == != and or quot rem]]))

;; ------------------------------------------------------------ hand-made evidence

(defn ^I32 pt-line [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 page ^I32 x0 ^I32 y0 ^I32 x1 ^I32 y1
                    ^I32 rot ^I32 dir ^I32 size]
  (comment "Append one line: the words of the UTF-8 text b (split at spaces), each a row of `words` whose box")
  (comment "is the line's, and the line (page, box, baseline 2 pt above the box's bottom, rot, dir).")
  (let [^I32 w0 (wd-count wd)
        ^I32 n (blob-len b)
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0]
    (while (<= k n)
      (do (if (or (== k n) (== (blob-u8 b k) 32))
            (do (if (> k s)
                  (do (let [^I32 ts (cells-len et)]
                        (text-append-utf8 et b s k)
                        (let [^I32 tl (- (cells-len et) ts)
                              ^I32 r (wd-new wd page x0 y0 x1 y1 x0 (- y1 200) x1 (- y1 200) rot dir ts tl -1 -1 -1)]
                          (wd-set wd r (wf-size) size)
                          (wd-set wd r (wf-font) 0)))))
                (set s (+ k 1))))
          (set k (+ k 1))))
    (ln-new ln page x0 y0 x1 y1 x0 (- y1 200) x1 (- y1 200) rot dir w0 (- (wd-count wd) w0))
    (return 0)))

(defn ^I32 pt-words [^:mut ^Cells wd ^:mut ^Cells et ^Blob b ^I32 page ^I32 x ^I32 y ^I32 step ^I32 size]
  (comment "The words of b (split at spaces) from x, `step` apart, appended to `words`, as `pt-cline`'s.")
  (let [^I32 n (blob-len b)
        ^I32 y1 (+ y (+ size 200))
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0
        ^:mut ^I32 i 0]
    (while (<= k n)
      (do (if (or (== k n) (== (blob-u8 b k) 32))
            (do (if (> k s)
                  (do (let [^I32 ts (cells-len et)
                            ^I32 wx (+ x (* i step))
                            ^I32 wx1 (+ wx (quot (* step 3) 4))]
                        (text-append-utf8 et b s k)
                        (let [^I32 tl (- (cells-len et) ts)
                              ^I32 r (wd-new wd page wx y wx1 y1 wx (- y1 200) wx1 (- y1 200) 0 0 ts tl -1 -1 -1)]
                          (wd-set wd r (wf-size) size)
                          (wd-set wd r (wf-font) 0))
                        (set i (+ i 1)))))
                (set s (+ k 1))))
          (set k (+ k 1))))
    (return 0)))

(defn ^I32 pt-mline [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b1 ^Blob b2 ^I32 page ^I32 x1 ^I32 x2 ^I32 y
                     ^I32 step ^I32 size]
  (comment "ONE line holding two runs of words, as a producer that writes the rows across the columns does: the")
  (comment "words of b1 from x1 and of b2 from x2, a gap between that no wider than D104's two sizes would keep apart.")
  (let [^I32 w0 (wd-count wd)]
    (pt-words wd et b1 page x1 y step size)
    (pt-words wd et b2 page x2 y step size)
    (let [^I32 wl (- (wd-count wd) 1)
          ^I32 lx0 (wd-get wd w0 (hd-x0))
          ^I32 lx1 (wd-get wd wl (hd-x1))
          ^I32 y1 (+ y (+ size 200))]
      (ln-new ln page lx0 y lx1 y1 lx0 (- y1 200) lx1 (- y1 200) 0 0 w0 (- (wd-count wd) w0))
      (return 0))))

(defn ^I32 pt-cline-dir [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 page ^I32 x ^I32 y
                         ^I32 step ^I32 size ^I32 dir]
  (comment "One line whose words stand apart (`step` from each word's left edge to the next's; a word is three")
  (comment "quarters of that wide): what the column stage reads, its words' own boxes. Its box is the words', the")
  (comment "baseline 2 pt above the bottom.")
  (let [^I32 w0 (wd-count wd)
        ^I32 n (blob-len b)
        ^I32 y1 (+ y (+ size 200))
        ^:mut ^I32 s 0
        ^:mut ^I32 k 0
        ^:mut ^I32 i 0
        ^:mut ^I32 xe x]
    (while (<= k n)
      (do (if (or (== k n) (== (blob-u8 b k) 32))
            (do (if (> k s)
                  (do (let [^I32 ts (cells-len et)
                            ^I32 wx (+ x (* i step))
                            ^I32 wx1 (+ wx (quot (* step 3) 4))]
                        (text-append-utf8 et b s k)
                        (let [^I32 tl (- (cells-len et) ts)
                              ^I32 r (wd-new wd page wx y wx1 y1 wx (- y1 200) wx1 (- y1 200) 0 dir ts tl -1 -1 -1)]
                          (wd-set wd r (wf-size) size)
                          (wd-set wd r (wf-font) 0))
                        (set xe wx1)
                        (set i (+ i 1)))))
                (set s (+ k 1))))
          (set k (+ k 1))))
    (ln-new ln page x y xe y1 x (- y1 200) xe (- y1 200) 0 dir w0 (- (wd-count wd) w0))
    (return 0)))

(defn ^I32 pt-cline [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob b ^I32 page ^I32 x ^I32 y
                     ^I32 step ^I32 size]
  (return (pt-cline-dir wd ln et b page x y step size 0)))

(defn ^I32 pt-clear [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et]
  (cells-drop wd 0)
  (cells-drop ln 0)
  (cells-drop et 0)
  (return 0))

(defn ^I32 pt-prep [^Cells wd ^Cells ln ^Cells et ^I32 npages ^Cells gl ^Cells fo ^:mut ^Cells lt ^:mut ^Cells ii]
  (comment "The lines' copy `lt` and the initials found in it (`in-detect`), as the Engine prepares them before the heading")
  (comment "analysis; no locale. Answers the initials found.")
  (let [^Cells loc (new-cells) ^Cells ls (new-cells) ^Cells lo (new-cells) ^Cells tm (new-cells)]
    (lc-copy ln lt)
    (return (in-detect wd gl fo et npages loc lt ls lo tm ii))))

(defn ^I32 pt-build [^Cells wd ^Cells et ^I32 npages ^:mut ^Cells pages ^:mut ^Cells layout
                    ^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells regions ^:mut ^Cells text
                    ^:mut ^Cells ord ^:mut ^Cells raw ^:mut ^Cells tmp ^:mut ^Cells fr ^:mut ^Cells gp ^:mut ^Cells hc
                    ^:mut ^Cells lt ^:mut ^Cells ii]
  (comment "`pa-build`, with the column stage's scratch (`emon.columns`) and the alignment's made here; `hc` is the heading")
  (comment "analysis (`emon.heading`), empty for the paragraphs alone; `lt` and `ii` are the lines' copy and the initials' table,")
  (comment "prepared by `pt-prep` (the heading analysis reads the same copy).")
  (let [^Cells ls (new-cells) ^Cells sd (new-cells) ^Cells it (new-cells)
        ^Cells io (new-cells) ^Cells rw (new-cells) ^Cells gu (new-cells) ^Cells ac (new-cells)
        ^Cells tm (new-cells) ^Cells cf (new-cells) ^Cells lo (new-cells) ^Cells pr (new-cells) ^Cells dbg (new-cells)
        ^Cells al (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tq (new-cells) ^Cells ledger (new-cells)]
    (return (pa-build wd et npages pages layout nodes attrs regions text ord raw tmp fr gp
                      lt ls sd it io rw gu ac tm cf lo pr dbg hc tb tc tw tq ledger ii al))))

(defn ^I32 pt-dump [^Cells wd ^Cells ln ^Cells et ^I32 npages ^:mut ^Text t]
  (comment "`pa-build` over the evidence on a fresh Model and the stage's debug lines (`pa-dump`) in t.")
  (let [^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells) ^Cells gp (new-cells)
        ^Cells lt (new-cells) ^Cells ls (new-cells) ^Cells sd (new-cells) ^Cells it (new-cells)
        ^Cells io (new-cells) ^Cells rw (new-cells) ^Cells gu (new-cells) ^Cells ac (new-cells)
        ^Cells tm (new-cells) ^Cells cf (new-cells) ^Cells lo (new-cells) ^Cells pr (new-cells) ^Cells dbg (new-cells)
        ^Cells hc (new-cells) ^Cells g0 (new-cells) ^Cells f0 (new-cells) ^Cells ii (new-cells) ^Cells al (new-cells)
        ^Cells tb (new-cells) ^Cells tc (new-cells) ^Cells tw (new-cells) ^Cells tq (new-cells)
        ^:mut ^I32 p 1]
    (model-init nodes attrs regions text pages ledger layout)
    (while (<= p npages)
      (do (page-new pages p 61200 79200 0 (pk-vector))
          (set p (+ p 1))))
    (pt-prep wd ln et npages g0 f0 lt ii)
    (pa-build wd et npages pages layout nodes attrs regions text ord raw tmp fr gp
              lt ls sd it io rw gu ac tm cf lo pr dbg hc tb tc tw tq ledger ii al)
    (pa-dump t cf dbg)
    (return 0)))

(defn ^I32 pt-run [^Cells wd ^Cells ln ^Cells et ^I32 npages
                   ^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells regions ^:mut ^Cells text
                   ^:mut ^Cells pages ^:mut ^Cells ledger ^:mut ^Cells layout
                   ^:mut ^Cells ord ^:mut ^Cells raw ^:mut ^Cells tmp ^:mut ^Cells fr ^:mut ^Cells gp ^:mut ^Cells st]
  (comment "Make the Model of the evidence: `npages` Letter pages, `pa-build`; answer `model-check`'s verdict.")
  (let [^:mut ^I32 p 1
        ^Cells hc (new-cells) ^Cells g0 (new-cells) ^Cells f0 (new-cells) ^Cells lt (new-cells) ^Cells ii (new-cells)]
    (model-init nodes attrs regions text pages ledger layout)
    (while (<= p npages)
      (do (page-new pages p 61200 79200 0 (pk-vector))
          (set p (+ p 1))))
    (pt-prep wd ln et npages g0 f0 lt ii)
    (pt-build wd et npages pages layout nodes attrs regions text ord raw tmp fr gp hc lt ii)
    (return (model-check nodes attrs regions text pages ledger layout st))))

(defn ^I32 pt-brief [^:mut ^Text t ^Cells nodes ^Cells regions ^Cells text]
  (comment "The brief of the Model (see the head of this file): every node but the root, in id order.")
  (let [^I32 n (node-count nodes)
        ^:mut ^I32 i 1
        ^:mut ^I32 k 0
        ^:mut ^I32 kind 0
        ^:mut ^I32 s 0]
    (while (< i n)
      (do (set kind (node-kind nodes i))
          (if (== kind (nk-paragraph))
            (do (text-cp t 80)
                (text-i32 t (node-region-count nodes i))
                (text-cp t 58)))
          (if (== kind (nk-text))
            (do (text-cp t 84)
                (text-cp t 58)))
          (if (== kind (nk-note))
            (do (text-cp t 78)
                (text-i32 t (node-sub nodes i))))
          (if (== kind (nk-break))
            (do (text-cp t 66)
                (text-i32 t (node-sub nodes i))))
          (if (or (== kind (nk-paragraph)) (== kind (nk-text)))
            (do (set s (node-text-start nodes i))
                (set k 0)
                (while (< k (node-text-len nodes i))
                  (do (text-cp t (text-at text (+ s k)))
                      (set k (+ k 1))))))
          (text-cp t 59)
          (set i (+ i 1))))
    (return 0)))

;; ----------------------------------------------------- where a paragraph ends

(deftest test-a-gap-and-an-indent-end-a-paragraph
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text)]
    (comment "A vertical gap above 1.5 times the median: five lines, a tight run of three, a jump, two.")
    (pt-line wd ln et (text-blob "alpha beta") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "gamma delta") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "epsilon") 1 7200 13000 30000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "zeta eta") 1 7200 15400 50000 16600 0 0 1000)
    (pt-line wd ln et (text-blob "theta") 1 7200 16900 20000 18100 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "gap: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:alpha beta gamma delta epsilon;P1:zeta eta theta;" "a gap of 12 pt after lines 3 pt apart starts a paragraph")
    (comment "An indent: more than half the size, from a line at the margin. The first line of a paragraph is")
    (comment "indented, the rest are not: a LESS indented line goes on (a hanging or ordinary paragraph).")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "one two") 1 9600 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "three four") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "five") 1 7200 13000 30000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "six seven") 1 9600 14500 50000 15700 0 0 1000)
    (pt-line wd ln et (text-blob "eight") 1 7200 16000 20000 17200 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "indent: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P1:one two three four five;P1:six seven eight;" "an indented line after one at the margin starts a paragraph")
    (comment "Centred lines start anywhere: a line that does not start at the page's margin is not an indent. The")
    (comment "first line is at the margin (and ends the first paragraph with its gap), the three centred lines go on.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "left") 1 7200 10000 20000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "mid a") 1 9000 13000 40000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "mid bb") 1 11000 14500 38000 15700 0 0 1000)
    (pt-line wd ln et (text-blob "mid c") 1 10000 16000 39000 17200 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "centred: well formed")
    (pt-brief t3 nodes regions text)
    (assert-text t3 "P1:left;P1:mid a mid bb mid c;" "centred lines are one paragraph")
    (comment "Lines on one row (two columns, a table row) do not follow one another: the second is not below the first.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "left col") 1 7200 10000 25000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "right col") 1 30000 10000 50000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "row: well formed")
    (pt-brief t4 nodes regions text)
    (assert-text t4 "P1:left col;P1:right col;" "two lines on one row are two paragraphs")))

;; ------------------------------------------------------------------ the order

(deftest test-lines-are-read-top-to-bottom-whatever-order-they-were-painted
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text)]
    (comment "Painted last line first and the first line in the middle (a float is painted before the page's text).")
    (pt-line wd ln et (text-blob "three") 1 7200 13000 30000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "one") 1 7200 10000 30000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "two") 1 7200 11500 30000 12700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "order: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:one two three;" "the reading order is the page's, not the painting's")
    (comment "A rotated line is not in the column of upright ones: it stands alone, after them (a watermark")
    (comment "across the middle of a paragraph does not cut it), and does not stop the paragraph that goes on.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "first line") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "DRAFT") 1 20000 11000 30000 12500 4500 0 3000)
    (pt-line wd ln et (text-blob "second line") 1 7200 11500 50000 12700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "rotated: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P1:first line second line;P1:DRAFT;" "a rotated line stands alone, after the upright ones")))

;; ---------------------------------------------------------------------- the text

(deftest test-line-ends-join-per-spec-3-6
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text)]
    (comment "A hyphen at a line end before a lowercase letter joins with no space and is KEPT (no dehyphenation without a")
    (comment "locale); before a capital it is a dash, and a space follows; a soft hyphen goes, with no space.")
    (pt-line wd ln et (text-blob "a multi-") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "page one infor­") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "mation and Smith-") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "Jones end") 1 7200 14500 50000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "hyphen: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:a multi-page one information and Smith- Jones end;" "hyphens at line ends")
    (comment "NFC and the ligatures: U+FB01 is `fi`, `e` and U+0301 are U+00E9; a soft hyphen inside a line stays.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "oﬀice étﬆ ⼀") 1 7200 10000 50000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "nfc: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P1:office étst 一;" "normalization (radical U+2F00 folds, D142)")))

;; ------------------------------------------------------------- across a page's end

(deftest test-a-page-end-is-a-milestone-between-blocks-or-inside-a-paragraph
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text) ^Text t5 (new-text)]
    (comment "A paragraph that closes its sentence at the end of page 1: the milestone is BETWEEN the blocks.")
    (pt-line wd ln et (text-blob "a long first line of text") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "ends here.") 1 7200 11500 20000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "A new page starts") 2 7200 10000 50000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 2 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "end: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:a long first line of text ends here.;B2;P1:A new page starts;" "a milestone between two blocks")
    (comment "A long last line that does not close a sentence, and a first line at the margin: the paragraph goes on,")
    (comment "as `text`, `break`, `text` (one region each).")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "first line of text") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "a long line that runs on") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "and carries over") 2 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "to its end.") 2 7200 11500 25000 12700 0 0 1000)
    (assert-eq (pt-run wd ln et 2 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "inline: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P2:;T:first line of text a long line that runs on ;B2;T:and carries over to its end.;" "a milestone inside a paragraph")
    (comment "A short last line: not a continuation. An indented first line: not one either.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "a long first line of text") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "short") 1 7200 11500 12000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "Next page") 2 7200 10000 30000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 2 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "short: well formed")
    (pt-brief t3 nodes regions text)
    (assert-text t3 "P1:a long first line of text short;B2;P1:Next page;" "a short last line ends the paragraph")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "a long line that runs on") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "and a long last line to go") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "Indented start") 2 9600 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "then the rest of it") 2 7200 11500 50000 12700 0 0 1000)
    (assert-eq (pt-run wd ln et 2 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "indent page: well formed")
    (pt-brief t4 nodes regions text)
    (assert-text t4 "P1:a long line that runs on and a long last line to go;B2;P1:Indented start then the rest of it;" "an indented first line starts a paragraph")
    (comment "An empty page between: nothing continues across it, and it still has its milestone.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "a long line that runs on") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "on the third") 3 7200 10000 50000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 3 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "empty page: well formed")
    (pt-brief t5 nodes regions text)
    (assert-text t5 "P1:a long line that runs on;B2;B3;P1:on the third;" "an empty page keeps its milestone")))

;; ------------------------------------------------------------- the whole Model

;; ------------------------------------------------------------------------- columns

(defn ^I32 pt-columns-at [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob first-l ^Blob last-l ^Blob first-r
                           ^I32 dy ^I32 dir]
  (comment "Six rows of two columns of four words, `dy` below the top of the page: the left column from x = 72 pt,")
  (comment "the right from 318 pt, 15 pt apart in y; the first and last lines of the left column and the first of the")
  (comment "right are the arguments.")
  (pt-cline-dir wd ln et first-l 1 7200 (+ dy 10000) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "l2a l2b l2c l2d") 1 7200 (+ dy 11500) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "l3a l3b l3c l3d") 1 7200 (+ dy 13000) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "l4a l4b l4c l4d") 1 7200 (+ dy 14500) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "l5a l5b l5c l5d") 1 7200 (+ dy 16000) 1200 1000 dir)
  (pt-cline-dir wd ln et last-l 1 7200 (+ dy 17500) 1200 1000 dir)
  (pt-cline-dir wd ln et first-r 1 31860 (+ dy 10000) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "r2a r2b r2c r2d") 1 31860 (+ dy 11500) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "r3a r3b r3c r3d") 1 31860 (+ dy 13000) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "r4a r4b r4c r4d") 1 31860 (+ dy 14500) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "r5a r5b r5c r5d") 1 31860 (+ dy 16000) 1200 1000 dir)
  (pt-cline-dir wd ln et (text-blob "r6a r6b r6c r6d.") 1 31860 (+ dy 17500) 1200 1000 dir)
  (return 0))

(defn ^I32 pt-two-columns-dir [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob last-l ^Blob first-r ^I32 dir]
  (return (pt-columns-at wd ln et (text-blob "l1a l1b l1c l1d") last-l first-r 0 dir)))

(defn ^I32 pt-two-columns [^:mut ^Cells wd ^:mut ^Cells ln ^:mut ^Cells et ^Blob last-l ^Blob first-r]
  (return (pt-two-columns-dir wd ln et last-l first-r 0)))

(deftest test-columns-are-read-one-after-the-other-and-joined-by-their-signals
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text)]
    (comment "A gutter between two columns: the left column first, whole, then the right (not row by row). The left")
    (comment "column ends in a full line with a full stop: no join. The page's `layout` is two cells, band 0, cols 0, 1.")
    (pt-two-columns wd ln et (text-blob "l6a l6b.") (text-blob "R1a R1b R1c R1d"))
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "columns: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b.;P1:R1a R1b R1c R1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;" "the left column, then the right")
    (assert-eq (page-layout-count pages 0) 2 "two cells")
    (assert-eq (layout-band layout (page-layout-first pages 0)) 0 "band 0")
    (assert-eq (layout-col layout (page-layout-first pages 0)) 0 "left column is col 0")
    (assert-eq (layout-col layout (+ (page-layout-first pages 0) 1)) 1 "right column is col 1")
    (assert-eq (layout-role layout (page-layout-first pages 0)) 2 "role body")
    (comment "The left column ends mid-sentence in a full line and the right starts in lowercase: one paragraph, one")
    (comment "region per column fragment; the column break is a space.")
    (pt-clear wd ln et)
    (pt-two-columns wd ln et (text-blob "l6a l6b l6c l6d") (text-blob "r1a r1b r1c r1d"))
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "join: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P2:l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b l6c l6d r1a r1b r1c r1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;" "a paragraph goes on in the next column")
    (comment "A hyphen at the break, a lowercase start: joined without a space, the hyphen kept (no locale, SPEC 3.6).")
    (pt-clear wd ln et)
    (pt-two-columns wd ln et (text-blob "l6a l6b l6c con-") (text-blob "tinues r1b r1c r1d"))
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "hyphen: well formed")
    (pt-brief t3 nodes regions text)
    (assert-text t3 "P2:l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b l6c con-tinues r1b r1c r1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;" "the hyphen at the break")))

(deftest test-a-line-written-across-the-gutter-is-split-at-it
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text)]
    (comment "Producers that write a row across two columns give one line with a gap in it: the words, not the")
    (comment "lines, find the gutter, and the lines are split at it (SPEC 10.1.1 steps 1-2).")
    (pt-mline wd ln et (text-blob "l1a l1b l1c l1d") (text-blob "R1a R1b R1c R1d") 1 7200 14400 10000 1200 1000)
    (pt-mline wd ln et (text-blob "l2a l2b l2c l2d") (text-blob "r2a r2b r2c r2d") 1 7200 14400 11500 1200 1000)
    (pt-mline wd ln et (text-blob "l3a l3b l3c l3d") (text-blob "r3a r3b r3c r3d") 1 7200 14400 13000 1200 1000)
    (pt-mline wd ln et (text-blob "l4a l4b l4c l4d.") (text-blob "r4a r4b r4c r4d") 1 7200 14400 14500 1200 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "split: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d.;P1:R1a R1b R1c R1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d;" "the left column, then the right")
    (assert-eq (page-layout-count pages 0) 2 "two cells")))

(deftest test-the-stage-says-what-it-decided-in-debug-lines
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Text t1 (new-text)]
    (comment "The fragments (the cut tree's leaves, body ones in reading order) and every join decision, as lines: the left")
    (comment "column ends in a full line without a full stop and the right starts in lowercase: score 9 (the edge 2, no")
    (comment "full stop 2, lowercase 3, the column is full 1, the words follow in the stream 1), against `join-min` 4.")
    (pt-two-columns wd ln et (text-blob "l6a l6b l6c l6d") (text-blob "r1a r1b r1c r1d"))
    (assert-eq (pt-dump wd ln et 1 t1) 0 "dump")
    (assert-text-span t1 (test-file "para/two-columns.dump") 0 (jt-end (test-file "para/two-columns.dump")) "the debug lines" 0)))

(deftest test-a-table-spans-the-gutter-and-a-gap-ends-the-columns
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text)]
    (comment "Two columns, a table of four short cells across both (a row of four runs, none of more than three")
    (comment "words, far apart, spans the gutter), and two columns again: the table is read row by row between them,")
    (comment "the columns above first, then the columns below; three bands of cells.")
    (pt-columns-at wd ln et (text-blob "L1a l1b l1c l1d") (text-blob "l6a l6b.") (text-blob "R1a R1b R1c R1d") 0 0)
    (pt-cline wd ln et (text-blob "A1.") 1 7200 21000 1200 1000)
    (pt-cline wd ln et (text-blob "B1.") 1 20000 21000 1200 1000)
    (pt-cline wd ln et (text-blob "C1.") 1 33000 21000 1200 1000)
    (pt-cline wd ln et (text-blob "D1.") 1 45000 21000 1200 1000)
    (pt-cline wd ln et (text-blob "A2.") 1 7200 22500 1200 1000)
    (pt-cline wd ln et (text-blob "B2.") 1 20000 22500 1200 1000)
    (pt-cline wd ln et (text-blob "C2.") 1 33000 22500 1200 1000)
    (pt-cline wd ln et (text-blob "D2.") 1 45000 22500 1200 1000)
    (pt-columns-at wd ln et (text-blob "M1a m1b m1c m1d") (text-blob "m6a m6b.") (text-blob "N1a N1b N1c N1d") 17000 0)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "table: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:L1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b.;P1:R1a R1b R1c R1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;P1:A1.;P1:B1.;P1:C1.;P1:D1.;P1:A2.;P1:B2.;P1:C2.;P1:D2.;P1:M1a m1b m1c m1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d m6a m6b.;P1:N1a N1b N1c N1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;" "the table between the column blocks")
    (assert-eq (page-layout-count pages 0) 5 "five cells")
    (assert-eq (layout-band layout (+ (page-layout-first pages 0) 2)) 1 "the table is band 1")
    (assert-eq (layout-band layout (+ (page-layout-first pages 0) 4)) 2 "the columns below are band 2")))

(deftest test-a-right-to-left-page-is-read-right-column-first
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text)]
    (comment "The same page, its lines running right to left: the right column is read first (SPEC 10.1.1 step 5), and the")
    (comment "paragraph that fills it goes on, in the left column.")
    (pt-two-columns-dir wd ln et (text-blob "l6a l6b l6c l6d.") (text-blob "R1a R1b R1c R1d") 1)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "rtl: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P2:R1a R1b R1c R1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d. l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b l6c l6d.;" "the right column first")
    (assert-eq (layout-x0 layout (page-layout-first pages 0)) 31860 "the first cell is the right column")))

(deftest test-a-title-across-the-gutter-is-its-own-band-and-margin-notes-are-notes
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text)]
    (comment "A title whose words stand across the gutter ends it: the title is band 0, the columns band 1.")
    (pt-cline wd ln et (text-blob "Title a b c d e f g h i j k l m n o p q r s t u v w.") 1 7200 6000 1200 1400)
    (pt-two-columns wd ln et (text-blob "l6a l6b.") (text-blob "R1a R1b R1c R1d"))
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "title: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:Title a b c d e f g h i j k l m n o p q r s t u v w.;P1:l1a l1b l1c l1d l2a l2b l2c l2d l3a l3b l3c l3d l4a l4b l4c l4d l5a l5b l5c l5d l6a l6b.;P1:R1a R1b R1c R1d r2a r2b r2c r2d r3a r3b r3c r3d r4a r4b r4c r4d r5a r5b r5c r5d r6a r6b r6c r6d.;" "the title first")
    (assert-eq (page-layout-count pages 0) 3 "three cells")
    (assert-eq (layout-band layout (page-layout-first pages 0)) 0 "the title is band 0")
    (assert-eq (layout-band layout (+ (page-layout-first pages 0) 1)) 1 "the columns are band 1")
    (comment "Two short notes in small type right of a column of body lines: margin notes (role 6), each after the")
    (comment "paragraph where it begins, never inside it.")
    (pt-clear wd ln et)
    (pt-cline wd ln et (text-blob "b1a b1b b1c b1d b1e b1f") 1 7200 10000 1200 1000)
    (pt-cline wd ln et (text-blob "b2a b2b b2c b2d b2e b2f") 1 7200 11500 1200 1000)
    (pt-cline wd ln et (text-blob "b3a b3b b3c b3d b3e b3f.") 1 7200 13000 1200 1000)
    (pt-cline wd ln et (text-blob "b4a b4b b4c b4d b4e b4f") 1 7200 16500 1200 1000)
    (pt-cline wd ln et (text-blob "b5a b5b b5c b5d b5e b5f") 1 7200 18000 1200 1000)
    (pt-cline wd ln et (text-blob "b6a b6b b6c b6d b6e b6f.") 1 7200 19500 1200 1000)
    (pt-cline wd ln et (text-blob "note one") 1 40000 10200 700 800)
    (pt-cline wd ln et (text-blob "note two") 1 40000 16700 700 800)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "margin: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P1:b1a b1b b1c b1d b1e b1f b2a b2b b2c b2d b2e b2f b3a b3b b3c b3d b3e b3f.;N6;P1:note one;P1:b4a b4b b4c b4d b4e b4f b5a b5b b5c b5d b5e b5f b6a b6b b6c b6d b6e b6f.;N6;P1:note two;" "each note after the paragraph it begins beside")))

(deftest test-the-model-of-one-paragraph-on-two-pages-in-json
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t (new-text) ^Text h (new-text)]
    (pt-line wd ln et (text-blob "Hello wide world") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "and so on") 2 7200 10000 50000 11200 0 0 1000)
    (assert-eq (pt-run wd ln et 2 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "json: well formed")
    (js-emit t 0 nodes attrs regions text pages ledger layout)
    (html-emit h 0 0 nodes attrs regions text pages ledger layout)
    (assert-text t "{\"emon\":\"1.1\",\"settings\":{\"locale\":null},\"conf\":\"uncalibrated\",\"pages\":[{\"n\":1,\"w\":612,\"h\":792,\"rot\":0,\"kind\":\"vector\",\"layout\":[{\"band\":0,\"col\":0,\"role\":\"body\",\"box\":[72,100,500,112]}]},{\"n\":2,\"w\":612,\"h\":792,\"rot\":0,\"kind\":\"vector\",\"layout\":[{\"band\":0,\"col\":0,\"role\":\"body\",\"box\":[72,100,500,112]}]}],\"body\":{\"id\":0,\"kind\":\"document\",\"children\":[{\"id\":1,\"kind\":\"paragraph\",\"text\":\"Hello wide world and so on\",\"inlines\":[{\"kind\":\"text\",\"text\":\"Hello wide world \",\"at\":[[1,72,100,500,112]],\"src\":[\"text\"],\"conf\":1000},{\"kind\":\"break\",\"page\":2,\"src\":[\"infer\"],\"conf\":500},{\"kind\":\"text\",\"text\":\"and so on\",\"at\":[[2,72,100,500,112]],\"src\":[\"text\"],\"conf\":1000}],\"at\":[[1,72,100,500,112],[2,72,100,500,112]],\"src\":[\"text\",\"infer\"],\"conf\":500}]},\"furniture\":[],\"dropped\":[]}" "a paragraph on two pages, in JSON")
    (assert-text h "<!doctype html><html><head><meta charset=\"utf-8\"><title></title></head><body><main><p>Hello wide world <span data-emon-page=\"2\"></span>and so on</p></main></body></html>" "and in HTML: the milestone inside the paragraph, in order")))

;; --------------------------------------------------------------- real documents

(defn ^I32 pt-golden [^Blob pdf ^:mut ^Text t
                      ^:mut ^Cells ar ^:mut ^Cells dc ^:mut ^Cells a ^:mut ^Cells b ^:mut ^Cells st
                      ^:mut ^Cells cx ^:mut ^Cells ox ^:mut ^Cells cs ^:mut ^Cells out
                      ^:mut ^Cells f0 ^:mut ^Cells f1 ^:mut ^Cells f2 ^:mut ^Cells f3
                      ^:mut ^Cells gl ^:mut ^Cells et ^:mut ^Cells mk ^:mut ^Cells fnt ^:mut ^Cells pg
                      ^:mut ^Cells wd ^:mut ^Cells ln
                      ^:mut ^Cells nodes ^:mut ^Cells attrs ^:mut ^Cells regions ^:mut ^Cells text
                      ^:mut ^Cells pages ^:mut ^Cells ledger ^:mut ^Cells layout
                      ^:mut ^Cells ord ^:mut ^Cells raw ^:mut ^Cells tmp ^:mut ^Cells fr ^:mut ^Cells gp ^:mut ^Cells mst]
  (comment "PDF -> content -> paragraphs -> Model -> pretty JSON; answer 0 when every step answered 0, else a")
  (comment "code naming the step (1 open, 2 content, 3 the Model's check). The JSON is `t`.")
  (cells-drop gl 0)
  (cells-drop et 0)
  (cells-drop mk 0)
  (cells-drop fnt 0)
  (cells-drop wd 0)
  (cells-drop ln 0)
  (let [^Src src (src-of-blob pdf)
        ^Cells pa (new-cells)
        ^Cells im (new-cells)
        ^Cells pts (new-cells)
        ^Cells gx (new-cells)
        ^I32 o (pd-open src ar dc a b st)]
    (if (!= o 0) (return 1))
    (if (!= (pc-document src ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln pa im pts gx) 0) (return 2))
    (model-init nodes attrs regions text pages ledger layout)
    (pa-pages pg pages)
    (let [^I32 np (quot (cells-len pages) 16)
          ^Cells sf (new-cells) ^Cells sc (new-cells) ^Cells hc (new-cells) ^Cells ws (new-cells)
          ^Cells htmp (new-cells) ^Cells hpr (new-cells) ^Cells hptxt (new-cells)
          ^Cells lt (new-cells) ^Cells ii (new-cells)]
      (pt-prep wd ln et np gl fnt lt ii)
      (hd-analyze wd lt et gl sf sc hc ws htmp hpr hptxt)
      (pt-build wd et np pages layout nodes attrs regions text ord raw tmp fr gp hc lt ii))
    (if (!= (model-check nodes attrs regions text pages ledger layout mst) 0) (return 3))
    (js-emit t 1 nodes attrs regions text pages ledger layout)
    (return 0)))

(deftest test-real-documents-make-the-golden-models
  (let [^Cells ar (new-cells) ^Cells dc (new-cells) ^Cells a (new-cells) ^Cells b (new-cells) ^Cells st (new-cells)
        ^Cells cx (new-cells) ^Cells ox (new-cells) ^Cells cs (new-cells) ^Cells out (new-cells)
        ^Cells f0 (new-cells) ^Cells f1 (new-cells) ^Cells f2 (new-cells) ^Cells f3 (new-cells)
        ^Cells gl (new-cells) ^Cells et (new-cells) ^Cells mk (new-cells) ^Cells fnt (new-cells) ^Cells pg (new-cells)
        ^Cells wd (new-cells) ^Cells ln (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells mst (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text) ^Text t5 (new-text) ^Text t6 (new-text)]
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/h-plain.pdf") t1 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "h-plain runs")
    (assert-text-span t1 (test-file "para/h-plain.json") 0 (jt-end (test-file "para/h-plain.json")) "h-plain" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/h-keyword.pdf") t2 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "h-keyword runs")
    (assert-text-span t2 (test-file "para/h-keyword.json") 0 (jt-end (test-file "para/h-keyword.json")) "h-keyword" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/h-inverted-numbered.pdf") t3 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "h-inverted-numbered runs")
    (assert-text-span t3 (test-file "para/h-inverted-numbered.json") 0 (jt-end (test-file "para/h-inverted-numbered.json")) "h-inverted-numbered" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/h-numbered.pdf") t4 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "h-numbered runs")
    (assert-text-span t4 (test-file "para/h-numbered.json") 0 (jt-end (test-file "para/h-numbered.json")) "h-numbered" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-image.pdf") t5 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-image runs")
    (assert-text-span t5 (test-file "para/initial-image.json") 0 (jt-end (test-file "para/initial-image.json")) "initial-image" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-vector.pdf") t6 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-vector runs")
    (assert-text-span t6 (test-file "para/initial-vector.json") 0 (jt-end (test-file "para/initial-vector.json")) "initial-vector" 0)))

(deftest test-real-initial-documents-make-the-golden-models
  (comment "P4.10 and P4.11 on files: the raised, first-word, column and right-to-left initials (D183; a CJK one is in the accuracy gate: its lines join with a space, which is not this stage's), each with its")
  (comment "initial inline, and the `align` of the paragraphs (D184), byte for byte (`para-check` holds them to the HTML).")
  (let [^Cells ar (new-cells) ^Cells dc (new-cells) ^Cells a (new-cells) ^Cells b (new-cells) ^Cells st (new-cells)
        ^Cells cx (new-cells) ^Cells ox (new-cells) ^Cells cs (new-cells) ^Cells out (new-cells)
        ^Cells f0 (new-cells) ^Cells f1 (new-cells) ^Cells f2 (new-cells) ^Cells f3 (new-cells)
        ^Cells gl (new-cells) ^Cells et (new-cells) ^Cells mk (new-cells) ^Cells fnt (new-cells) ^Cells pg (new-cells)
        ^Cells wd (new-cells) ^Cells ln (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells mst (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text) ^Text t4 (new-text)]
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-raised.pdf") t1 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-raised runs")
    (assert-text-span t1 (test-file "para/initial-raised.json") 0 (jt-end (test-file "para/initial-raised.json")) "initial-raised" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-firstword.pdf") t2 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-firstword runs")
    (assert-text-span t2 (test-file "para/initial-firstword.json") 0 (jt-end (test-file "para/initial-firstword.json")) "initial-firstword" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-columns.pdf") t3 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-columns runs")
    (assert-text-span t3 (test-file "para/initial-columns.json") 0 (jt-end (test-file "para/initial-columns.json")) "initial-columns" 0)
    (assert-eq (pt-golden (test-file "corpus/synth/pdf/initial-rtl.pdf") t4 ar dc a b st cx ox cs out f0 f1 f2 f3 gl et mk fnt pg wd ln nodes attrs regions text pages ledger layout ord raw tmp fr gp mst) 0 "initial-rtl runs")
    (assert-text-span t4 (test-file "para/initial-rtl.json") 0 (jt-end (test-file "para/initial-rtl.json")) "initial-rtl" 0)))

;; ------------------------------------------------------------------- initials (P4.10)

(defn ^I32 pt-find [^Cells nodes ^I32 kind ^I32 after]
  (comment "The first node of that kind with an index above `after`, -1 for none.")
  (let [^I32 n (node-count nodes)
        ^:mut ^I32 i (+ after 1)]
    (while (< i n)
      (do (if (== (node-kind nodes i) kind) (return i))
          (set i (+ i 1))))
    (return -1)))

(deftest test-a-drop-initial-joins-its-first-word-and-the-paragraph-is-one
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text) ^Text t2 (new-text) ^Text t3 (new-text)]
    (comment "An `O` 36 pt on 10 pt text: its cap top is the first line's (within half a size), its baseline in line 2's band,")
    (comment "lines 1 and 2 start after it, line 3 back at its start edge. One paragraph, `Once upon ...`, the initial an")
    (comment "inline `initial` (a drop of two lines) holding `O`, then the rest as text; justified, since lines 1 and 2 count")
    (comment "from the initial's edge. Without a locale the join is flagged: `O` is a word in some language.")
    (pt-line wd ln et (text-blob "O") 1 7200 10200 9400 13000 0 0 3600)
    (pt-line wd ln et (text-blob "nce upon a time") 1 9800 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "there was a mill") 1 9800 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "that nobody saw") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "the end of it") 1 7200 14500 30000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "drop: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:Once upon a time there was a mill that nobody saw the end of it;;T:O;T:nce upon a time there was a mill that nobody saw the end of it;" "a drop initial: one paragraph, joined, no space")
    (let [^I32 ini (pt-find nodes (nk-initial) 0)]
      (assert-eq (node-sub nodes ini) (ifm-drop) "the form is drop")
      (assert-eq (node-aux nodes ini) 2 "of two lines")
      (assert-eq (node-flags nodes ini) (fl-low-conf) "and the join is in doubt")
      (assert-eq (node-sub nodes 1) (al-justify) "justified: lines 1 and 2 start at the initial's edge"))
    (comment "A letter divider: a big letter with nothing wrapping it. The line below starts at the same edge, not after the")
    (comment "letter, so it is no initial and stays a block of its own.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "A") 1 7200 10000 9500 13400 0 0 3000)
    (pt-line wd ln et (text-blob "Aardvark an animal here") 1 7200 14000 50000 15200 0 0 1000)
    (pt-line wd ln et (text-blob "that digs at night") 1 7200 15500 50000 16700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "divider: well formed")
    (pt-brief t2 nodes regions text)
    (assert-text t2 "P1:A;P1:Aardvark an animal here that digs at night;" "a letter divider is no initial")
    (assert-eq (pt-find nodes (nk-initial) 0) -1 "no initial inline")
    (comment "A margin initial: it hangs left of the column (its end edge before the lines' start), the lines are not")
    (comment "indented, and there are lines after its two.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "Q") 1 3000 10200 6200 13000 0 0 3600)
    (pt-line wd ln et (text-blob "uiet nights in town") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "were rare that year") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "and the lamps burned") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "low until dawn") 1 7200 14500 40000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "margin: well formed")
    (pt-brief t3 nodes regions text)
    (assert-text t3 "P1:Quiet nights in town were rare that year and the lamps burned low until dawn;;T:Q;T:uiet nights in town were rare that year and the lamps burned low until dawn;" "a margin initial")
    (let [^I32 ini2 (pt-find nodes (nk-initial) 0)]
      (assert-eq (node-sub nodes ini2) (ifm-margin) "the form is margin")
      (assert-eq (node-aux nodes ini2) 2 "of two lines")
      (assert-eq (node-flags nodes ini2) 0 "a `Q` is no word: the join is sure"))))

(deftest test-a-right-to-left-initial-is-mirrored
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)
        ^Text t1 (new-text)]
    (comment "The initial at the right (a start edge of -x1), the first two lines to its left, the third back at the right edge.")
    (pt-line wd ln et (text-blob "B") 1 43000 10200 45000 13000 0 1 3600)
    (pt-line wd ln et (text-blob "ab cd ef gh") 1 7200 10000 42500 11200 0 1 1000)
    (pt-line wd ln et (text-blob "ij kl mn op") 1 7200 11500 42500 12700 0 1 1000)
    (pt-line wd ln et (text-blob "qr st uv wx") 1 7200 13000 45000 14200 0 1 1000)
    (pt-line wd ln et (text-blob "yz ab cd ef") 1 7200 14500 45000 15700 0 1 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "rtl: well formed")
    (pt-brief t1 nodes regions text)
    (assert-text t1 "P1:Bab cd ef gh ij kl mn op qr st uv wx yz ab cd ef;;T:B;T:ab cd ef gh ij kl mn op qr st uv wx yz ab cd ef;" "a right-to-left initial")
    (let [^I32 ini3 (pt-find nodes (nk-initial) 0)]
      (assert-eq (node-sub nodes ini3) (ifm-drop) "a drop"))))

;; ------------------------------------------------------------------ alignment (P4.11)

(deftest test-a-paragraphs-alignment-is-measured-against-its-fragment
  (let [^Cells wd (new-cells) ^Cells ln (new-cells) ^Cells et (new-cells)
        ^Cells nodes (new-cells) ^Cells attrs (new-cells) ^Cells regions (new-cells) ^Cells text (new-cells)
        ^Cells pages (new-cells) ^Cells ledger (new-cells) ^Cells layout (new-cells)
        ^Cells ord (new-cells) ^Cells raw (new-cells) ^Cells tmp (new-cells) ^Cells fr (new-cells)
        ^Cells gp (new-cells) ^Cells st (new-cells)]
    (comment "Justified: three lines flush at both edges of the fragment, the last short.")
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 7200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 7200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 7200 14500 20000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "justify: well formed")
    (assert-eq (node-sub nodes 1) (al-justify) "justify")
    (comment "Left-aligned: a ragged end edge, every start at the edge (the fragment's box is the widest line's).")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 7200 10000 45000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 7200 11500 42000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 7200 14500 30000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "start: well formed")
    (assert-eq (node-sub nodes 1) (al-start) "start")
    (comment "Right-aligned: a ragged start edge, every end at the edge.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 12200 10000 50000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 15200 11500 50000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 33000 14500 50000 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "end: well formed")
    (assert-eq (node-sub nodes 1) (al-end) "end")
    (comment "Centred: equal gaps either side, and the lines differ in width.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 17200 10000 40000 11200 0 0 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 12200 11500 45000 12700 0 0 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 0 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 25000 14500 32200 15700 0 0 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "center: well formed")
    (assert-eq (node-sub nodes 1) (al-center) "center")
    (comment "Right to left, every line ending at the box's LEFT edge (a right-to-left line's end): LOGICALLY `end`, though these")
    (comment "are the lines the left-to-right case calls `start`; and the same page set flush right is `start`.")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 7200 10000 45000 11200 0 1 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 7200 11500 42000 12700 0 1 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 1 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 7200 14500 30000 15700 0 1 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "rtl end: well formed")
    (assert-eq (node-sub nodes 1) (al-end) "right-to-left, flush left: end")
    (pt-clear wd ln et)
    (pt-line wd ln et (text-blob "aa bb cc dd") 1 12200 10000 50000 11200 0 1 1000)
    (pt-line wd ln et (text-blob "ee ff gg hh") 1 15200 11500 50000 12700 0 1 1000)
    (pt-line wd ln et (text-blob "ii jj kk ll") 1 7200 13000 50000 14200 0 1 1000)
    (pt-line wd ln et (text-blob "mm nn") 1 33000 14500 50000 15700 0 1 1000)
    (assert-eq (pt-run wd ln et 1 nodes attrs regions text pages ledger layout ord raw tmp fr gp st) 0 "rtl start: well formed")
    (assert-eq (node-sub nodes 1) (al-start) "right-to-left, flush right: start")))
