{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emon.dev/schema/emon-1.json",
  "title": "emon document model, JSON form, versions 1.0 and 1.1 (SPEC 4; D012, D055; 1.1 adds the initial inline, a `break` milestone inside a paragraph (D134), align on heading, caption and cell, note role sidebar and page layout, D108-D113; a `field` is also an inline of the block that holds its label, D548)",
  "description": "Canonical JSON for an emon Model. Every field not listed in `required` is omitted when absent (SPEC 4.2). Closed: an unknown key is a failure of THIS version's output; consumers of a later minor version must ignore what they do not know (SPEC 4.4), which is why a minor version edits this file additively.",
  "type": "object",
  "required": [
    "emon",
    "settings",
    "conf",
    "pages",
    "body",
    "furniture",
    "dropped"
  ],
  "additionalProperties": false,
  "properties": {
    "emon": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "format": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "tagged": {
          "type": "boolean"
        },
        "encrypted": {
          "type": "boolean"
        },
        "lang": {
          "type": "string"
        }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "locale"
      ],
      "additionalProperties": false,
      "properties": {
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "ocr": {
          "enum": [
            "always",
            "auto",
            "never"
          ]
        },
        "ocr-scope": {
          "enum": [
            "full",
            "witness"
          ]
        },
        "detail": {
          "enum": [
            "blocks",
            "lines",
            "words"
          ]
        },
        "assets": {
          "enum": [
            "images",
            "figures"
          ]
        },
        "asset-dpi": {
          "type": "integer",
          "minimum": 36,
          "maximum": 600
        },
        "asset-pixels": {
          "type": "integer",
          "minimum": 1
        },
        "asset-bytes": {
          "type": "integer",
          "minimum": 1
        },
        "assets-bytes": {
          "type": "integer",
          "minimum": 1
        },
        "asset-signatures": {
          "enum": [
            "off",
            "on"
          ]
        }
      }
    },
    "conf": {
      "const": "calibrated"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "subject": {
          "type": "string"
        },
        "keywords": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "producer": {
          "type": "string"
        },
        "created": {
          "type": "string"
        },
        "modified": {
          "type": "string"
        }
      }
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "body": {
      "$ref": "#/$defs/document"
    },
    "furniture": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/furnitureItem"
      }
    },
    "dropped": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/droppedItem"
      }
    },
    "assets": {
      "type": "array",
      "description": "Only when the `assets` setting is on (SPEC 10.11); then always, `[]` when empty.",
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "cpt": {
      "type": "number",
      "description": "Points, at most two decimals (converted from centipoints in integers, SPEC 3.4)."
    },
    "at": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/region"
      }
    },
    "region": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "$ref": "#/$defs/cpt"
        },
        {
          "$ref": "#/$defs/cpt"
        },
        {
          "$ref": "#/$defs/cpt"
        },
        {
          "$ref": "#/$defs/cpt"
        }
      ],
      "description": "[page, x0, y0, x1, y1] in page space (SPEC 3.4)."
    },
    "src": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "text",
          "hidden-text",
          "ocr",
          "trace",
          "vector",
          "struct",
          "annot",
          "outline",
          "infer"
        ]
      }
    },
    "flags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "low-conf",
          "ocr-only",
          "text-layer-suspect",
          "reconstructed",
          "dpi-unknown",
          "rotated",
          "vertical",
          "struct-disagree",
          "tag-span-conflict",
          "in-table-image",
          "script-unread"
        ]
      }
    },
    "conf": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "page": {
      "type": "object",
      "required": [
        "n",
        "w",
        "h",
        "rot"
      ],
      "additionalProperties": false,
      "properties": {
        "n": {
          "type": "integer",
          "minimum": 1
        },
        "label": {
          "type": "string"
        },
        "w": {
          "$ref": "#/$defs/cpt"
        },
        "h": {
          "$ref": "#/$defs/cpt"
        },
        "rot": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "kind": {
          "enum": [
            "vector",
            "scanned",
            "mixed",
            "image"
          ]
        },
        "health": {
          "$ref": "#/$defs/conf"
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        },
        "px": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "layout": {
          "type": "array",
          "minItems": 1,
          "description": "The column map reading order was decided over (SPEC 3.4, 10.1.1, D111): one cell per column fragment. Absent when the page is one plain column.",
          "items": {
            "type": "object",
            "required": [
              "band",
              "col",
              "role",
              "box"
            ],
            "additionalProperties": false,
            "properties": {
              "band": {
                "type": "integer",
                "minimum": 0
              },
              "col": {
                "type": "integer",
                "minimum": 0
              },
              "role": {
                "enum": [
                  "body",
                  "sidebar",
                  "margin"
                ]
              },
              "box": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "$ref": "#/$defs/cpt"
                }
              }
            }
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "description": "One pixel asset (SPEC 10.11, D117): metadata only, the bytes are out of band. `name` is a<id>.jpg or a<id>.png; `sha256` is over the encoded bytes.",
      "required": [
        "id",
        "name",
        "type",
        "origin",
        "from",
        "bytes",
        "sha256",
        "w",
        "h",
        "uses"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "type": "string",
          "pattern": "^a[0-9]+\\.(jpg|png)$"
        },
        "type": {
          "enum": [
            "image/jpeg",
            "image/png"
          ]
        },
        "origin": {
          "enum": [
            "embedded",
            "decoded",
            "cropped",
            "rendered"
          ]
        },
        "from": {
          "enum": [
            "dct",
            "jpx",
            "jbig2",
            "ccitt",
            "flate",
            "lzw",
            "runlength",
            "raw",
            "png",
            "jpeg",
            "tiff",
            "render"
          ]
        },
        "object": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "w": {
          "type": "integer",
          "minimum": 0
        },
        "h": {
          "type": "integer",
          "minimum": 0
        },
        "dpi": {
          "type": "integer",
          "minimum": 1
        },
        "flags": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "overlaid",
              "clip-bbox",
              "transformed",
              "icc",
              "scaled",
              "text-overlap"
            ]
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "node",
              "at"
            ],
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "integer",
                "minimum": 0
              },
              "at": {
                "$ref": "#/$defs/region"
              }
            }
          }
        }
      }
    },
    "droppedItem": {
      "type": "object",
      "required": [
        "reason",
        "page",
        "at"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "watermark",
            "background",
            "page-number",
            "running-title",
            "bleed-through",
            "duplicate-header-row",
            "ocr-ghost",
            "clipped",
            "offpage",
            "invisible",
            "rule-ghost",
            "unwitnessed-uncertain-paint"
          ]
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "at": {
          "$ref": "#/$defs/region"
        },
        "text": {
          "type": "string"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "src": {
          "$ref": "#/$defs/src"
        }
      }
    },
    "furnitureItem": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "enum": [
            "header",
            "footer",
            "margin"
          ]
        },
        "template": {
          "type": "string"
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "flags": {
          "$ref": "#/$defs/flags"
        }
      }
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": 0
        },
        "kind": {
          "const": "document"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "text": {
          "type": "string"
        },
        "inlines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 1
        }
      }
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "document",
            "section",
            "heading",
            "paragraph",
            "list",
            "item",
            "table",
            "rowgroup",
            "row",
            "cell",
            "caption",
            "figure",
            "seal",
            "formula",
            "code",
            "quote",
            "note",
            "field",
            "furniture",
            "break"
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "$ref": "#/$defs/at"
        },
        "src": {
          "$ref": "#/$defs/src"
        },
        "conf": {
          "$ref": "#/$defs/conf"
        },
        "flags": {
          "$ref": "#/$defs/flags"
        },
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "inlines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/inline"
          },
          "minItems": 1
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          },
          "minItems": 1
        },
        "align": {
          "enum": [
            "start",
            "center",
            "end",
            "justify"
          ]
        },
        "alt": {
          "type": "string"
        },
        "asset": {
          "type": "integer",
          "minimum": 0
        },
        "noasset": {
          "enum": [
            "withheld",
            "part",
            "vector",
            "composite",
            "colorspace",
            "codec",
            "render",
            "too-large",
            "budget"
          ]
        },
        "checked": {
          "type": "boolean"
        },
        "color": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "signed": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "colspan": {
          "type": "integer",
          "minimum": 1
        },
        "columns": {
          "type": "integer",
          "minimum": 1
        },
        "continued": {
          "type": "integer",
          "minimum": 1
        },
        "date": {
          "type": "string"
        },
        "display": {
          "enum": [
            "block",
            "inline"
          ]
        },
        "empty": {
          "type": "boolean"
        },
        "header": {
          "enum": [
            "col",
            "row"
          ]
        },
        "label": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "level": {
          "type": "integer",
          "minimum": 1
        },
        "marker": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "number": {
          "type": "string"
        },
        "numbering": {
          "type": "string"
        },
        "ordered": {
          "type": "boolean"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1
        },
        "profile": {
          "enum": [
            "ruled",
            "partial",
            "shaded",
            "whitespace",
            "form",
            "struct"
          ]
        },
        "repeated": {
          "type": "boolean"
        },
        "role": {
          "anyOf": [
            {
              "enum": [
                "head",
                "body",
                "foot"
              ]
            },
            {
              "enum": [
                "footnote",
                "endnote",
                "margin",
                "sidebar"
              ]
            },
            {
              "enum": [
                "header",
                "footer",
                "margin"
              ]
            }
          ]
        },
        "rowspan": {
          "type": "integer",
          "minimum": 1
        },
        "scheme": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "subkind": {
          "anyOf": [
            {
              "enum": [
                "chart",
                "diagram",
                "photo",
                "logo",
                "map",
                "illustration",
                "screenshot",
                "qr",
                "barcode",
                "unknown"
              ]
            },
            {
              "enum": [
                "seal",
                "stamp",
                "signature",
                "initials",
                "digital-signature"
              ]
            }
          ]
        },
        "target": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "document"
              }
            },
            "required": [
