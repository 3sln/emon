      "const": "1.0"
    },
    "generator": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "format": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "pages": {
          "type": "integer",
          "minimum": 0
        },
        "tagged": {
