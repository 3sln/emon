              "kind"
            ]
          },
          "then": {
            "propertyNames": {
              "enum": [
                "id",
                "kind",
                "text",
                "inlines",
                "children",
                "at",
                "src",
                "conf",
                "flags",
                "level"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "heading"
              }
            },
            "required": [
