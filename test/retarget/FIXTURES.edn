;; The documents of the targeted-rounds gate (`kin/scripts/retarget`, P7.4, D347). Recorded LIVE by `bb retarget-record` (Tesseract, pdfium for :born), with pixels.
;;   :pdf     the document;  :kind :scan (the scan variants, fed as images) or :born (born-digital text, OCR'd and fused: the Engine's defaults since P7.S)
;;   :gold    the gold file's name under test/corpus/synth/gold (default: the PDF's name)
;;   :passes  the passes the evidence dump's `oruns` must name (`pass`)
;;   :leak    words of what is not the body (a watermark, a seal): the body holds no more of them with the targeted passes than without
;;   :miss    [x y] a pixel of the first decode bitmap to change: the replay must then be `transcript-miss` (nothing guessed)
{"ovl-stamp-seal"        {:pdf "test/corpus/synth/scan-ovl/stamp-seal.pdf" :gold "stamp-seal" :kind :scan
                          :passes ["first" "body-ink" "line" "cell"] :leak ["copy"] :miss [100 100]}
 "ovl-watermark-draft"   {:pdf "test/corpus/synth/scan-ovl/watermark-draft.pdf" :gold "watermark-draft" :kind :scan
                          :passes ["first" "body-ink" "cell"] :leak ["copy"] :miss [100 100]}
 "ovl-h-numbered"        {:pdf "test/corpus/synth/scan-ovl/h-numbered.pdf" :gold "h-numbered" :kind :scan
                          :passes ["first" "body-ink" "re-rotated"] :leak ["copy"] :miss [100 100]}
 "ovl-table-simple-ruled" {:pdf "test/corpus/synth/scan-ovl/table-simple-ruled.pdf" :gold "table-simple-ruled" :kind :scan
                          :passes ["first" "re-rotated"] :leak ["copy"] :miss [100 100]}
 ;; P12.3 (D564), made by tools/synth/raster_fixtures.clj: IMAGE inputs (they went through a unit of their own that never looked at OSD or the size of the text), and a
 ;; Flate image over a PDF page (read as `vector`, no OCR). The gold is the source page's, which these hold the first page of.
 "raster-rot90"          {:pdf "test/raster/h-plain-rot90.png" :gold "h-plain" :kind :scan
                          :passes ["first" "re-rotated"] :miss [100 100]}
 "raster-rot180"         {:pdf "test/raster/h-plain-rot180.png" :gold "h-plain" :kind :scan
                          :passes ["first" "re-rotated"] :miss [100 100]}
 "raster-72dpi"          {:pdf "test/raster/h-plain-72dpi.png" :gold "h-plain" :kind :scan
                          :passes ["upscaled"] :miss [100 100]}
 "raster-flate-render"   {:pdf "test/raster/flate-gray-72dpi.pdf" :gold "h-plain" :kind :born
                          :passes ["first"]}
 "born-wm-gray-behind"   {:pdf "test/corpus/synth/pdf/wm-gray-behind.pdf" :gold "wm-gray-behind" :kind :born
                          :passes ["first" "body-ink"] :miss [100 100]}
 ;; D520: ICDAR 2013 us-034 (a real table page; the PDF is kept here, 23 KB) crashed the Engine live: the tracer's `tr-measure` counted the pixels
 ;; `nm-layers` leaves unassigned (it finds no seed: K = 0) as layer 8 and read an `inks` row that is not there. Recorded live; nothing in it is a
 ;; body-ink pass (no `:miss`: no request of it names a kin-made view), so it holds only what the Engine must do: convert, identically on every host.
 ;; `:gold :none`: no body text to score.
 "born-icdar-us-034"     {:pdf "test/retarget/pdf/icdar-us-034.pdf" :gold :none :kind :born
                          :passes ["first"]}
 ;; D709: synthetic photo view and all-empty PSM11 rescue; historical accuracy populations stay fixed.
 "receipt-photo" {:pdf "test/raster/receipt-photo.png" :gold "h-plain" :kind :scan
                  :passes ["receipt"] :receipt-view "receipt-photo" :miss [100 100]}
 "receipt-empty" {:pdf "test/raster/receipt-empty.png" :gold :none :kind :scan
                  :passes ["receipt" "receipt-rescue"] :receipt-view "receipt-photo" :miss [100 100]}
}
